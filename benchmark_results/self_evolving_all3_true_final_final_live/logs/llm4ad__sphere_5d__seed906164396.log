def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 0.5
    mu = np.zeros(dim)
    cov = np.eye(dim) * sigma**2
    pc = np.eye(dim)
    dcov = np.zeros((dim, dim))

    for i in range(budget):
        z = np.random.randn(dim)
        x = mu + np.dot(np.sqrt(cov), z)

        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)

        fx = func(x)

        if i > 0:
            dcov = (1 / i) * np.outer(z, z) - cov
            pc = np.eye(dim) + dcov

            # Update covariance matrix and step size
            cov = np.dot(pc, cov)
            sigma *= expit(i / budget**2)

        # Update mean
        mu = x + sigma**2 * (np.dot(np.linalg.inv(cov), z))

    return mu
