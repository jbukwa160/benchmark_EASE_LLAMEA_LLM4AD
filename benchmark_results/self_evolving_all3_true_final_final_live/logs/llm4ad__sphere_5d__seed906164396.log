def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 1e3
    alpha = 0.99
    beta = 0.01

    for _ in range(budget):
        x_new = x + 0.5 * np.sin(np.pi * rng.rand(dim)) * (ub - lb)
        x_new = np.clip(x_new, lb, ub)

        f_x = func(x)
        f_x_new = func(x_new)

        if f_x_new < f_x:
            x = x_new
            T *= alpha

        elif rng.rand() < 0.9 * (1 - np.exp(-beta * (f_x_new - f_x) / T)):
            x = x_new

    return x
