def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)
    step_size = max(ub - lb, 0.01)

    for _ in range(budget):
        noise = np.random.normal(scale=step_size / rng, size=(1, dim))
        new_x = x + noise
        new_x = np.clip(new_x, lb, ub)
        
        new_f = func(new_x)
        
        if new_f < best_f:
            best_f = new_f
            best_x = new_x.copy()
            
        step_size *= 0.9
        
    return best_x[0]
