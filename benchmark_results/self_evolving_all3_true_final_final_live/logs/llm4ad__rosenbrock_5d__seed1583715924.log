def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    def differential_evolution(pop_size=50, tol=1e-3, cr=0.5, F=0.5):
        x = rng.rand(pop_size, dim)
        x = clip(x)
        for _ in range(budget // (2 * pop_size)):
            y = np.copy(x)
            ind_best = np.argmax([func(clip(xi)) for xi in x])
            y[ind_best] = clip(x[ind_best] + F * (x[np.random.choice(pop_size, size=3)] - x))
            z = np.copy(y)
            for i in range(pop_size):
                if rng.rand() < cr:
                    z[i] = clip(y[i] + F * (y[np.random.choice(pop_size, size=2)] - y[i]))
                else:
                    z[i] = y[i]
            x = 0.5 * (x + z)
        return x[ind_best]

    def simulated_annealing(t_max=10000, t_min=1e-3, alpha=0.95):
        x = rng.rand(dim)
        x = clip(x)
        T = t_max
        for _ in range(budget // 10):
            T *= alpha
            if rng.rand() < np.exp(-func(clip(x)) / T):
                x = clip(x + 0.1 * (rng.rand(dim) - 0.5))
        return x

    def DESA():
        pop_size = int(np.sqrt(budget // 20))
        tol = 1e-4
        cr = 0.7
        F = 0.8
        x = differential_evolution(pop_size, tol, cr, F)
        while True:
            y = simulated_annealing(t_max=10000, t_min=tol, alpha=0.99)
            if np.all(clip(x) == clip(y)) or rng.rand() < np.exp(-func(clip(y)) / func(clip(x))):
                x = clip(y)
            else:
                break
        return x

    return DESA()
