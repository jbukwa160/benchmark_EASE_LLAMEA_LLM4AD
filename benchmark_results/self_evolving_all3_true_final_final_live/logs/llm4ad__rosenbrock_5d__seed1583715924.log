def algorithm(func, dim, lb, ub, budget, rng):
    def wrapper(x):
        return func(x)

    res = differential_evolution(wrapper, [(lb[i], ub[i]) for i in range(dim)])
    best_x = res.x
    if res.fun < 0:
        # restart
        x0 = np.zeros(dim)
        step_size = (ub - lb) / rng.randint(1, 10)
        candidates = []
        for _ in range(budget):
            candidate = x0 + step_size * np.random.uniform(-1, 1, dim)
            clipped_candidate = np.clip(candidate, lb, ub)
            candidates.append(clipped_candidate)
        candidates = np.array(candidates)
        candidates_with_fitness = [(candidate, func(candidate)) for candidate in candidates]
        sorted_candidates = sorted(candidates_with_fitness, key=lambda x: x[1])
        best_x = sorted_candidates[0][0]

    return best_x
