def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        a = rng.choice(dim, size=3, replace=False)
        v = clip(best_x + rng.uniform(-1, 1, size=dim))

        for i in range(dim):
            if np.random.rand() < 0.5:
                v[i] = best_x[a[0]]
            elif np.random.rand() < 0.5:
                v[i] = best_x[a[1]]
            else:
                v[i] = best_x[a[2]]

        f = func(v)
        if f < best_f:
            best_f = f
            best_x = v

    return best_x
