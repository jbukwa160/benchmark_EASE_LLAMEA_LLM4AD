def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        dx = np.zeros(dim)
        for i in range(dim):
            if rng.rand() < 0.5:
                dx[i] = np.random.uniform(-1, 1)
        
        new_x = x + dx
        for i in range(dim):
            new_x[i] = max(lb, min(ub, new_x[i]))
        
        new_f = func(new_x)
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f
    
    return best_x
