def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 1.0
    mu = np.zeros(dim)
    lam = 20
    c_c = 1 / (4 + 3 * np.sqrt(2))
    c_1 = 1 / (4 + 2 * np.sqrt(2))
    c_m = 1 / (4 + np.sqrt(2))

    for i in range(budget):
        x = mu + sigma * rng.normal(size=(lam, dim))
        x = np.clip(x, lb, ub)

        y = func(x)
        f_best = func(mu)
        
        while True:
            x_new = mu + c_c * (x - mu) + rng.normal(size=dim)
            x_new = np.clip(x_new, lb, ub)
            
            y_new = func(np.array([x_new]))
            if y_new < y or rng.uniform() < np.exp(-(y_new - y) / sigma):
                y = y_new
                mu = (1 - c_c) * mu + c_c * x_new
            else:
                break

        sigma *= 1 + c_1 * (np.fabs(y_best - f_best)) / budget
        if rng.uniform() < np.exp(-(y - f_best) / sigma):
            mu = x[np.argmin(y)]

    return mu
