def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = np.copy(x)
    best_f = np.inf
    plateau_count = 0
    iteration = 0
    
    while iteration < budget:
        for i in range(dim):
            # Clip candidates to [lb, ub]
            new_x = np.clip(x + rng.uniform(-1.5, 1.5) * (ub - lb), lb, ub)
            
            f_new = func(new_x)
            f_best = func(best_x)
            
            if f_new < f_best:
                best_x = np.copy(new_x)
                best_f = f_new
                plateau_count = 0
            else:
                # Adjust cooling rate based on plateau count
                delta = f_new - f_best
                alpha = 1 / (iteration + plateau_count * dim)
                
                if rng.random() < np.exp(-delta * alpha):
                    x[i] = new_x[i]
                    
        iteration += 1
        
        # Update plateau count
        if best_f == func(best_x):
            plateau_count += 1
            
    return best_x
