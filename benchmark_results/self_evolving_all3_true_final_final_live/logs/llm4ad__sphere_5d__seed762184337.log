def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = np.zeros(dim)
    best_obj = float('inf')
    
    for i in range(budget):
        candidate = lb + (ub - lb) * rng.rand(dim)
        
        obj = func(candidate)
        
        if obj < best_obj:
            best_sol = candidate
            best_obj = obj
    
    return best_sol
