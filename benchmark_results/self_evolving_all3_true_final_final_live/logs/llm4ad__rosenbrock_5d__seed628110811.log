def algorithm(func, dim, lb, ub, budget, rng):
    def generate_individual():
        return np.clip(rng.uniform(size=dim)*2 - 1 + lb, a_min=lb, a_max=ub)

    def evaluate(individual):
        return func(individual)

    individual = generate_individual()
    current_best = individual.copy()

    cooling_rate = 0.99
    temperature = 100.0

    for _ in range(budget):
        new_individual = generate_individual()

        score_new = evaluate(new_individual)
        score_current = evaluate(current_best)

        if score_new < score_current:
            current_best = new_individual.copy()
            individual = new_individual.copy()
        else:
            acceptance_prob = np.exp((score_current - score_new) / temperature)
            if rng.random() < acceptance_prob:
                current_best = new_individual.copy()

        temperature *= cooling_rate

    return current_best
