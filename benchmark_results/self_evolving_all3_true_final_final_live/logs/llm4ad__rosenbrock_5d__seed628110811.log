def algorithm(func, dim, lb, ub, budget, rng):
    def clipped_candidate(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=(dim,))
    x_best = x.copy()
    best_value = func(x)
    for _ in range(budget):
        alpha = 0.99
        T = 1e10
        beta = 1.01
        K_max = 100

        # Simulated Annealing (SA) phase
        if rng.uniform(0, 1) < 0.5:
            for _ in range(K_max):
                x_new = clipped_candidate(x + np.random.normal(size=(dim,)))
                value_new = func(x_new)
                if value_new < best_value:
                    x_best = x_new.copy()
                    best_value = value_new
                delta_E = value_new - best_value
                if delta_E < 0 or rng.uniform(0, 1) < np.exp(-delta_E / T):
                    x = x_new
                    T *= beta

        # Pattern Search (PS) phase
        else:
            for _ in range(K_max):
                step_size = 0.5 * (ub - lb)
                direction = rng.choice([-1, 1], size=(dim,))
                x_new = clipped_candidate(x + direction * step_size)
                value_new = func(x_new)
                if value_new < best_value:
                    x_best = x_new.copy()
                    best_value = value_new
                elif np.random.uniform(0, 1) < (best_value - value_new) / T:
                    x = x_new

        # Cooling schedule
        T *= alpha

    return x_best
