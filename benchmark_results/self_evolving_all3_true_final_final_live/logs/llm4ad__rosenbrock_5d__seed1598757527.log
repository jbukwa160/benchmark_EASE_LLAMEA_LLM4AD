def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def generate_initial_population(dim, population_size):
        return rng.uniform(lb, ub, size=(population_size, dim))

    def evaluate_population(population, func):
        return [func(individual) for individual in population]

    def generate_new_candidate(parent1, parent2):
        child = 0.5 * (parent1 + parent2)
        mutation = rng.normal(size=dim, loc=0, scale=0.01)
        return clip(child + mutation)

    def sa_search(dim, lb, ub, budget, rng):
        current_solution = rng.uniform(lb, ub, size=dim)
        temperature = 100
        for _ in range(budget):
            new_solution = generate_new_candidate(current_solution, current_solution)
            energy_diff = func(new_solution) - func(current_solution)
            if energy_diff < 0:
                current_solution = new_solution
            else:
                probability = np.exp(-energy_diff / temperature)
                if rng.rand() < probability:
                    current_solution = new_solution
            temperature *= 0.99  # anneal the temperature
        return current_solution

    def nms_search(population, func):
        best_individual = population[np.argmin(evaluate_population(population, func))]
        while True:
            simplex = np.array([best_individual] + [generate_new_candidate(best_individual, individual) for individual in population])
            new_best_individual = simplex[np.argmin(evaluate_population(simplex, func))]
            if evaluate_population(new_best_individual, func) < evaluate_population(best_individual, func):
                best_individual = new_best_individual
            else:
                break
        return best_individual

    initial_population = generate_initial_population(dim, 100)
    population = sa_search(dim, lb, ub, budget // 2, rng)
    for _ in range(budget - budget // 2):
        new_candidate = generate_new_candidate(population, nms_search(initial_population, func))
        if evaluate_population(new_candidate, func) < evaluate_population(population, func):
            population = new_candidate
        initial_population = np.append(initial_population[1:], [new_candidate], axis=0)
    return population
