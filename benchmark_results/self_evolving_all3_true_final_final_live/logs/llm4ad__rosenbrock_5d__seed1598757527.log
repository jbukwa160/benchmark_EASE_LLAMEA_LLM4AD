def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return func(x)

    def clip(candidate, lb, ub):
        clipped_candidate = np.clip(candidate, lb, ub)
        if not np.all(np.isfinite(clipped_candidate)):
            raise ValueError("Candidate contains NaN or infinity")
        return clipped_candidate

    def generate_initial_population(rng, dim, size):
        return rng.uniform(lb, ub, (size, dim))

    def calculate_distance(x1, x2):
        return np.mean((x1 - x2) ** 2)

    def calculate_crowding_distance(population, f_values, d):
        distances = []
        for i in range(len(f_values)):
            sum_distances = 0
            for j in range(i + 1, len(f_values)):
                sum_distances += calculate_distance(population[i], population[j])
            distances.append(sum_distances / (len(f_values) - 1))
        return np.array(distances)

    def selection(population, f_values, k):
        _, indices = np.argsort(f_values)
        return population[indices[:k]], f_values[indices[:k]]

    def mutation(x, sigma):
        noise = rng.normal(0, 1, x.shape)
        return x + sigma * noise

    def crossover(parent1, parent2):
        child = (parent1 + parent2) / 2
        return child

    initial_population = generate_initial_population(rng=np.random.default_rng(), dim=dim, size=budget)
    f_values = np.array([Rosenbrock(x) for x in initial_population])
    best_solution = initial_population[np.argmin(f_values)]
    best_fitness = np.min(f_values)

    for _ in range(budget - 1):
        selected, selected_fitness = selection(initial_population, f_values, k=5)
        parents = []
        for i in range(5):
            parent1, _, _ = selection(selected, selected_fitness, k=1)
            parent2, _, _ = selection(selected, selected_fitness, k=1)
            child = crossover(parent1, parent2)
            parents.append(child)

        children = [mutation(x, 0.5) for x in parents]
        children = np.array([clip(x, lb, ub) for x in children])

        f_values_children = np.array([Rosenbrock(x) for x in children])
        _, indices = np.argsort(f_values_children)
        children = children[indices]

        initial_population = np.concatenate((initial_population, children))
        f_values = np.concatenate((f_values, f_values_children))

        fitness = Rosenbrock(initial_population[np.argmin(f_values)])
        if fitness < best_fitness:
            best_solution = initial_population[np.argmin(f_values)]
            best_fitness = fitness

    return best_solution
