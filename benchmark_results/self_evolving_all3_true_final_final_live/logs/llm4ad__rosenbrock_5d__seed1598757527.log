def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return func(x)

    def evaluate_fitness(population):
        fitness = []
        for individual in population:
            x = np.clip(individual, a_min=lb, a_max=ub)
            fitness.append(Rosenbrock(x))
        return np.array(fitness)

    def sample_population(mean, sigma):
        return mean + rng.normal(size=(20, dim)) * sigma

    def update_mean(mean, population):
        return np.mean(population, axis=0)

    def update_sigma(sigma, population, mean):
        cov = np.cov(np.transpose(population - mean), rowvar=False)
        eigenvalues, eigenvectors = np.linalg.eigh(cov)
        new_eigenvalues = np.maximum(eigenvalues + 1, 0.01)
        new_covariance = (np.outer(eigenvectors[:, 0], eigenvectors[:, 0]) * new_eigenvalues[0] +
                          np.eye(dim - 1) * np.mean(new_eigenvalues[1:]))
        return np.sqrt(np.prod(np.diag(new_covariance)))

    def restart_cmaes(budget):
        mean = rng.uniform(low=lb, high=ub, size=(dim,))
        sigma = 1.0
        iterations = 0

        while True:
            population = sample_population(mean, sigma)
            fitness = evaluate_fitness(population)
            best_individual = np.argmin(fitness)

            if fitness[best_individual] < 1e-6 or iterations >= budget / 10:
                return mean

            new_mean = update_mean(mean, population[[best_individual]])
            new_sigma = update_sigma(sigma, population[[best_individual]], mean)
            mean = (mean * 0.5 + new_mean) * 0.9
            sigma *= 0.99
            iterations += 1

    best_solution = None

    for _ in range(10):
        best_solution = restart_cmaes(budget)

    return best_solution
