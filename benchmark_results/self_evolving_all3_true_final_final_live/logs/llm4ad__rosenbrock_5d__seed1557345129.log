def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = x + 0.5 * (rng.rand(dim) - 0.5) * (ub - lb)
        z = clip(y)

        f1 = func(z)
        if f1 < best_f:
            best_x = z.copy()
            best_f = f1

        f2 = func(x + rng.uniform(-1, 1))
        if np.random.rand() < np.exp((best_f - f1) / (f1 + 1e-8)):
            x = clip(z)
        else:
            x = x + rng.uniform(-1, 1)

    return best_x
