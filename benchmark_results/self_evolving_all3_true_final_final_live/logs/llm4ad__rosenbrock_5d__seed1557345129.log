def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    sigma = 1.0
    mu = 1e-4
    c_c = 0.8
    c_m = 2 / (dim + 1.25)
    c_1 = 1 / (dim + 2)
    c_d = 1 / (dim + sqrt(dim) + 3)

    for _ in range(budget):
        y = func(x)
        lambda_ = int(np.floor(4 + np.log(dim)))
        x_old = x.copy()
        z = rng.normal(size=dim)
        v = z * sigma
        w = v / (1 + c_m) ** 0.5

        for _ in range(lambda_):
            y_new = func(x_old + w)
            if y_new < y:
                y = y_new
                x = x_old + w
            elif rng.uniform(0, 1) > exp(-mu * (y_new - y)):
                y = y_new
                x = x_old + w

        c_1 += 2 / ((dim + 1.25) ** 2)
        sigma *= 1 + c_d - c_c * (sigma / np.linalg.norm(w))
        mu /= 1 + c_m

    return np.clip(x, lb, ub)
