def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x), x

    def ga(pop_size, iter_num):
        pop = rng.uniform(lb, ub, (pop_size, dim))
        for _ in range(iter_num):
            scores = [evaluate(x)[0] for x in pop]
            parents = np.array([x for _, x in sorted(zip(scores, pop), reverse=True)][:int(pop_size/2)])
            offspring = rng.uniform(lb, ub, (pop_size, dim))
            offspring[::2] = 0.5*(parents[rng.randint(0, len(parents), size=(len(parents)//2, dim))] 
                                  + parents[rng.randint(0, len(parents), size=(len(parents)//2, dim))])
            pop = np.concatenate((parents, offspring))
        return evaluate(pop[np.argmax([evaluate(x)[0] for x in pop])])[1]

    def sa(init_x, iter_num):
        x = init_x
        T = 100.0
        a = 0.99
        for _ in range(iter_num):
            new_x = rng.uniform(lb, ub, dim)
            delta = func(new_x) - func(x)
            if delta < 0 or np.random.rand() < np.exp(-delta/T):
                x = new_x
            T *= a
        return evaluate(x)[1]

    best_x = ga(100, 10)
    for _ in range(budget-10):
        score, x = evaluate(best_x)
        if score > func(best_x):
            break
        if rng.rand() < 0.5:
            best_x = sa(best_x, 20)
        else:
            best_x = ga(100, 10)[np.argmax([evaluate(x)[0] for x in [ga(100, 10) for _ in range(10)]])]
    return best_x
