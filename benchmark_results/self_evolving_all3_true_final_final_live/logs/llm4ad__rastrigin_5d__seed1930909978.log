def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    mutation_factor = 0.1
    crossover_probability = 0.9
    temperature = 100.0
    cooling_rate = 0.99
    
    x_min = np.zeros(dim)
    x_best = np.zeros(dim)
    
    for _ in range(budget):
        # Initialize population
        pop = lb + (ub - lb) * rng.rand(pop_size, dim)
        
        # Evaluate population
        f_pop = np.array([func(x) for x in pop])
        
        # Selection and update of the best solution
        x_min = pop[np.argmin(f_pop)]
        f_min = func(x_min)
        
        # Differential Evolution
        for i in range(pop_size):
            r1, r2, r3 = rng.choice(pop_size, 3, replace=False)
            v = pop[r1] + mutation_factor * (pop[r2] - pop[r3])
            
            # Clip to bounds
            v = np.clip(v, lb, ub)
            
            u = pop[i] + crossover_probability * (v - pop[i])
            
            # Clip to bounds
            u = np.clip(u, lb, ub)
            
            f_u = func(u)
            
            if f_u < f_pop[i]:
                pop[i] = u
                f_pop[i] = f_u
                
        # Simulated Annealing
        for i in range(pop_size):
            v = x_min + (ub - x_min) * rng.rand(dim)
            
            # Clip to bounds
            v = np.clip(v, lb, ub)
            
            f_v = func(v)
            
            if f_v < f_pop[i]:
                pop[i] = v
                f_pop[i] = f_v
                
        if temperature > 1e-6:
            for i in range(pop_size):
                r = rng.uniform(0, 1)
                
                if r < np.exp(-(f_pop[i] - f_min) / temperature):
                    pop[i] = x_min
                    f_pop[i] = f_min
                    
            temperature *= cooling_rate
            
    return x_min
