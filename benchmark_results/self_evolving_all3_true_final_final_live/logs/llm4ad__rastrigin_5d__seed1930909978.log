def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = np.array([ub - lb] * dim)
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for i in range(budget):
        y1 = x_best + rng.normal(0, 0.5, size=dim) / D
        y2 = x_best + rng.normal(0, 0.5, size=dim) / D
        z = clip(y1 + (y2 - y1) * rng.uniform(0, 1))

        if func(z) < f_best:
            x_best = z
            f_best = func(x_best)

        p = rng.choice(dim)
        q = [i for i in range(dim) if i != p]
        r = rng.choice(q)
        s = rng.normal(0, 0.5, size=dim)
        s[p] = 1

        u = x_best + D[r] * s
        v = clip(u + (x_best - u) * rng.uniform(0, 1))

        if func(v) < f_best:
            x_best = v
            f_best = func(x_best)

    return x_best
