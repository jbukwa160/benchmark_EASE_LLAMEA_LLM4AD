def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    iter_limit = 1000
    
    x = np.random.uniform(lb, ub, size=(pop_size, dim))
    
    for _ in range(iter_limit):
        y = np.copy(x)
        
        for i in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size, size=3)
            
            while r1 == i or r2 == i or r3 == i:
                r1, r2, r3 = rng.randint(0, pop_size, size=3)
            
            v = y[r1] + 0.5 * (y[r2] - y[r3])
            
            if func(v) < func(y[i]):
                y[i] = v
        
        temp = np.copy(x)
        
        for i in range(pop_size):
            alpha = rng.uniform(0, 1)
            
            if alpha > 0.5:
                r1, r2, r3 = rng.randint(0, pop_size, size=3)
                
                while r1 == i or r2 == i or r3 == i:
                    r1, r2, r3 = rng.randint(0, pop_size, size=3)
                    
                v = y[r1] + alpha * (y[r2] - y[r3])
                
                if func(v) < func(y[i]):
                    x[i] = np.clip(v, lb, ub)
        
        temp = np.copy(x)
        
        for i in range(pop_size):
            v = temp[i]
            
            for j in range(dim):
                v[j] += rng.uniform(-1, 1) * 0.01
                
                if v[j] < lb:
                    v[j] = lb
                elif v[j] > ub:
                    v[j] = ub
            
            if func(v) < func(temp[i]):
                x[i] = np.clip(v, lb, ub)
    
    return np.argmin(func(x))
