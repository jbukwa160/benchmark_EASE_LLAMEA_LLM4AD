def algorithm(func, dim, lb, ub, budget, rng):
    x = 0.5 * (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        y = x + 0.1 * np.dot(rng.randn(dim), [1, 1] if dim == 2 else [[1, 0], [0, 1]])
        y = np.clip(y, lb, ub)
        fy = func(y)
        
        if fy < best_f:
            best_x = y.copy()
            best_f = fy
            
        sigma = 0.1 * rng.randn() + 1
        z = x + sigma * (y - x) + 0.01 * np.dot(rng.randn(dim), [1, 1] if dim == 2 else [[1, 0], [0, 1]])
        z = np.clip(z, lb, ub)
        fz = func(z)
        
        if fz < best_f:
            x = z.copy()
    
    return best_x
