def algorithm(func, dim, lb, ub, budget, rng):
    n_iter = 0
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    while n_iter < budget:
        # Local exploration
        for i in range(dim):
            x_try = x_best.copy()
            x_try[i] += rng.normal(0, 0.1)
            if lb <= x_try[i] <= ub and func(x_try) < f_best:
                x_best = x_try
                f_best = func(x_try)

        # Global exploration
        p = np.array([np.exp(-x**2/(2*0.5**2)) for x in rng.uniform(lb, ub, size=dim)])
        p /= np.sum(p)
        x_try = rng.choice(dim, size=1, replace=False, p=p)[0]
        delta = rng.normal(0, 1) * (ub - lb)
        x_new = x_best[x_try] + delta
        if lb <= x_new <= ub and func(np.array([x_new])) < f_best:
            x_best[x_try] = x_new
            f_best = func(x_best)

        n_iter += 1

    return x_best
