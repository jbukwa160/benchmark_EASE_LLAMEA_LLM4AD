def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x), x

    def generate_initial_population(size, dim, lb, ub):
        return clip(rng.uniform(lb, ub, (size, dim)))

    def differential_evolution(population, dim, lb, ub, budget):
        mutation_rate = 0.5
        population_size = len(population)
        for _ in range(budget // 2):
            # Select parents using tournament selection
            parents = np.array([population[rng.randint(0, population_size-1)] for _ in range(population_size)])
            for i in range(population_size):
                # Perform mutation and crossover
                mutated_parent = clip(parents[i] + mutation_rate * (parents[rng.randint(0, population_size-1)] - parents[rng.randint(0, population_size-1)]))
                crossed_over_child = 0.5 * (parents[i] + mutated_parent)
                # Replace the worst individual with the child
                population[i] = np.where(crossed_over_child < parents[i], crossed_over_child, parents[i])
        return population

    def simulated_annealing(population, dim, lb, ub, budget):
        temperature = 1.0
        for _ in range(budget // 2):
            # Select the worst individual
            worst_individual = np.argmin([evaluate(x)[0] for x in population])[0]
            # Generate a new solution using SA's Metropolis criterion
            new_solution = clip(worst_individual + temperature * (rng.uniform(lb, ub) - rng.uniform(lb, ub)))
            if evaluate(new_solution)[0] < evaluate(worst_individual)[0]:
                population[worst_individual] = new_solution
            else:
                # Apply SA's cooling schedule
                temperature *= 0.99

    initial_population = generate_initial_population(50, dim, lb, ub)
    best_candidate = np.array([np.inf])
    for _ in range(budget):
        if _ % 2 == 0:
            population = differential_evolution(initial_population, dim, lb, ub, budget // 4)
        else:
            population = simulated_annealing(population, dim, lb, ub, budget // 4)
        current_candidate = np.min([evaluate(x)[1] for x in population])
        if evaluate(current_candidate)[0] < evaluate(best_candidate)[0]:
            best_candidate = current_candidate
    return best_candidate
