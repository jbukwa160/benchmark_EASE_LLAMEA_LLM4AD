def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def f(x):
        x = clip(x, lb, ub)
        return func(x)

    D = dim
    pop_size = int(np.sqrt(budget))
    sigma0 = 1.0
    learning_rate = 0.01
    c1 = 2
    c2 = 0.5

    best_x = np.random.uniform(lb, ub, size=D)
    best_fval = f(best_x)

    pop = rng.normal(size=(pop_size, D))
    for i in range(pop_size):
        pop[i] *= sigma0
        pop[i] += best_x

    for _ in range(budget):
        # CMA-ES step
        mean = best_x
        cov = np.cov(pop, rowvar=False)
        x_new = rng.multivariate_normal(mean, cov * sigma0)

        # Nelder-Mead step
        fval_new = f(x_new)
        if fval_new < best_fval:
            best_x = x_new
            best_fval = fval_new

        pop[i] = x_new
        for j in range(pop_size - 1):
            x1 = pop[j]
            x2 = pop[j + 1]

            # Sort by function value
            if f(x1) > f(x2):
                pop[j], pop[j + 1] = pop[j + 1], pop[j]

        # Update learning rate and bounds
        sigma0 *= np.exp(learning_rate * (best_fval - f(pop[pop_size // 2])))

    return best_x
