def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(size=dim) * (ub - lb) + lb
    best_x = x.copy()
    best_f = func(x)
    step_size = 1.0

    for _ in range(budget):
        g = np.zeros(dim)
        for i in range(10): # approximate gradient using 10 random points
            dx = rng.uniform(size=dim) * (ub - lb)
            candidate = clip(x + dx)
            g += func(candidate) - best_f
        g /= 10

        step_size *= 0.9999  # decay the step size
        x -= step_size * g
        x = clip(x)

        if func(x) < best_f:
            best_x = x.copy()
            best_f = func(x)

    return best_x
