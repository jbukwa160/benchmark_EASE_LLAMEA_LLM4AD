def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def get_initial_population(dim, lb, ub, rng):
        population = []
        for _ in range(budget):
            candidate = rng.uniform(lb, ub, size=dim)
            population.append(candidate)
        return np.array(population)

    def differential_evolution(func, dim, lb, ub, budget, rng):
        population = get_initial_population(dim, lb, ub, rng)
        best_candidate = population[np.argmin([func(x) for x in population])]

        for _ in range(budget - 1):
            indices_to_mutate = np.random.choice(population.shape[0], size=3, replace=False)
            mutated_candidates = population[indices_to_mutate] + rng.uniform(-0.5, 0.5, size=(3, dim))
            clipped_mutated_candidates = clip(mutated_candidates, lb, ub)

            crossover_indices = np.random.choice(population.shape[0], size=clipped_mutated_candidates.shape[0])
            crossed_candidates = population[crossover_indices] + rng.uniform(0, 1, size=crossed_candidates.shape) * (clipped_mutated_candidates - population[crossover_indices])

            clipped_crossed_candidates = clip(crossed_candidates, lb, ub)

            best_candidate = np.minimum(best_candidate, clipped_crossed_candidates[np.argmin([func(x) for x in clipped_crossed_candidates])])

        return best_candidate

    best_candidate = differential_evolution(func, dim, lb, ub, budget, rng)
    return best_candidate
