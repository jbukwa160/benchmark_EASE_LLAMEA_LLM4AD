def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(rng, dim, lb, ub):
        population = rng.uniform(lb, ub, size=(budget, dim))
        return population

    def differential_evolution(population, func, dim, budget, rng):
        for _ in range(budget - 1):
            noise = rng.normal(size=dim)
            trial = np.add(np.add(population[0], noise), rng.uniform(lb, ub, size=dim))
            trial = clip(trial, lb, ub)
            f_trial = func(trial)
            f_best = func(population[0])
            if f_trial < f_best:
                population[0] = trial
        return population

    def simulated_annealing(population, budget):
        temperature = 1.0
        for _ in range(budget):
            noise = rng.normal(size=dim)
            trial = np.add(np.add(population[0], noise), rng.uniform(lb, ub, size=dim))
            trial = clip(trial, lb, ub)
            f_trial = func(trial)
            f_best = func(population[0])
            delta_f = f_trial - f_best
            if delta_f < 0:
                population[0] = trial
            else:
                probability = np.exp(-delta_f / temperature)
                if rng.random() < probability:
                    population[0] = trial
            temperature *= 0.99  # cooling schedule
        return population

    population = generate_initial_population(rng, dim, lb, ub)
    best_solution = differential_evolution(population, func, dim, budget // 2, rng)[0]
    best_solution = simulated_annealing(best_solution, budget - (budget // 2))[0]

    return best_solution
