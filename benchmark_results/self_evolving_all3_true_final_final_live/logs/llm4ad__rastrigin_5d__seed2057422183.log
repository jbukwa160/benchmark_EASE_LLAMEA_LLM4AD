def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        clipped = np.clip(candidate, lb, ub)
        return clipped

    def generate_population(pop_size):
        population = np.random.uniform(lb, ub, size=(pop_size, dim))
        return population

    def evaluate_candidates(candidates):
        evaluations = [func(candidate) for candidate in candidates]
        return np.array(evaluations)

    def genetic_search(population, num_generations):
        for _ in range(num_generations):
            fitnesses = -evaluate_candidates(population)
            parents = population[np.argsort(fitnesses)]
            offspring = rng.choice(parents, size=int(0.2 * len(parents)), replace=False)
            children = np.random.uniform(lb, ub, size=(len(offspring), dim))
            for i, child in enumerate(children):
                mu = np.mean(offspring[i])
                sigma = np.std(offspring[i])
                child[:] = mu + sigma * rng.randn(dim)
            population = np.concatenate((offspring, children))
        return population

    def local_search(population, num_iterations):
        for _ in range(num_iterations):
            candidate = np.random.choice(population)
            for i in range(dim):
                new_candidate = clip_candidate(candidate.copy())
                new_candidate[i] += 0.1 * rng.uniform(-1, 1)
                if func(new_candidate) < func(candidate):
                    candidate[:] = new_candidate
        return candidate

    population = generate_population(100)
    best_candidate = local_search(population, budget)

    return best_candidate
