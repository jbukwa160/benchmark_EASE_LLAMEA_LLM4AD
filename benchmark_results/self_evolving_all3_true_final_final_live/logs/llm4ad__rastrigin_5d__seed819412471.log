def algorithm(func, dim, lb, ub, budget, rng):
    X = np.random.uniform(lb, ub, (budget, dim))
    Y = np.zeros(budget)
    for i in range(budget):
        Yi = func(X[i])
        Y[i] = Yi
        if i > 0:
            mean, var = gp_model(X[:i+1], Y[:i+1], rng)
            Xnext = predict_next_point(X[:i+1], Y[:i+1], mean, var, dim, lb, ub)
            Xnew = np.clip(Xnext, a_min=lb, a_max=ub)
            Yi_new = func(Xnew)
            if Yi_new < min(Y):
                X[i] = Xnew
                Y[i] = Yi_new

    best_idx = np.argmin(Y)
    return X[best_idx]
