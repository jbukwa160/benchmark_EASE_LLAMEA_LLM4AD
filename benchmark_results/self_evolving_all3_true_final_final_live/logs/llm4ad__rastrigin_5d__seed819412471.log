def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_x = rng.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for _ in range(budget):
        x = clip(best_x + rng.normal(size=dim))
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x

    return best_x
