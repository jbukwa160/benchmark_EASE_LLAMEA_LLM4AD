def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(mu):
        return mu + rng.normal(size=(dim,), loc=0, scale=1)

    def step_size_adaptation(sigma, best_fit_diff):
        if best_fit_diff < 0:
            sigma *= np.exp(-best_fit_diff / (sigma ** 2))
        else:
            sigma *= np.exp(best_fit_diff / (sigma ** 2))
        return max(1e-10, sigma)

    def cma_es():
        mu = rng.normal(size=(dim,))
        sigma = 0.5
        archive = [(mu, func(mu))]

        for i in range(budget):
            candidates = [get_candidate(mu) for _ in range(4)]
            candidates = np.clip(candidates, lb, ub)
            fits = [func(candidate) for candidate in candidates]
            best_fit_diff = max(fits) - min(fits)

            mu = (mu + 1/5 * sum([candidate for _, candidate in zip(sorted(zip(fits, candidates), reverse=True)[:4], sorted(zip(fits, candidates), reverse=True)[:4])])) / 4
            sigma = step_size_adaptation(sigma, best_fit_diff)
            new_candidate = get_candidate(mu)

            new_candidate = np.clip(new_candidate, lb, ub)
            fit = func(new_candidate)

            archive.append((new_candidate, fit))

        return min(archive, key=lambda x: x[1])[0]

    return cma_es()
