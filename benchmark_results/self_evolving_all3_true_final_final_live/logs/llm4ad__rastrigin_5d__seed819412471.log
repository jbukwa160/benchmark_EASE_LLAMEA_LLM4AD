def algorithm(func, dim, lb, ub, budget, rng):
    D = 0.5 * (ub - lb)
    A = 1.0 + D / 3.0
    pop_size = int(budget ** (1 / dim))
    x_best = None
    f_best = np.inf

    for _ in range(pop_size):
        x = rng.uniform(lb, ub, size=dim)
        if func(x) < f_best:
            f_best = func(x)
            x_best = x

    for t in range(budget - pop_size):
        y = x_best + A * (rng.uniform(-1, 1, size=dim) * D + lb)

        # local search
        for _ in range(50):
            u = np.copy(y)
            v = rng.uniform(lb, ub, size=dim)
            w = u + v

            if func(w) < func(u):
                u = w
            else:
                break

        y = 0.5 * (y + x_best)

        if func(y) < f_best:
            f_best = func(y)
            x_best = y

    return x_best
