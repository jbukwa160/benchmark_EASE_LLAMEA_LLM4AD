def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for i in range(budget):
        x = np.clip(rng.uniform(lb, ub, size=dim), a_min=lb, a_max=ub)
        
        f = func(x)
        
        if f < best_f:
            best_x = x
            best_f = f
            
        # Local search
        for j in range(dim):
            step_size = 0.1 * (ub - lb) / budget
            x_try = np.copy(x)
            x_try[j] += rng.uniform(-step_size, step_size)
            x_try = np.clip(x_try, a_min=lb, a_max=ub)
            
            f_try = func(x_try)
            
            if f_try < best_f:
                best_x = x_try
                best_f = f_try
                
    return best_x
