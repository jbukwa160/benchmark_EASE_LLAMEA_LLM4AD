def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = np.copy(x)
    best_y = func(x)

    for _ in range(budget):
        y = func(np.clip(x + 0.01*rng.normal(size=dim), lb, ub))
        if y < best_y:
            best_x = np.copy(x)
            best_y = y
        elif rng.rand() < np.exp(-(y - best_y)/1e-3):
            x = np.copy(best_x)

    return best_x
