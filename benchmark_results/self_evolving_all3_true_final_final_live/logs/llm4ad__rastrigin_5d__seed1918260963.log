def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = 0.5 * (ub - lb) + lb + (ub - lb) * rng.rand(dim)
    x_best = x.copy()
    best_cost = func(x)

    for _ in range(budget):
        y = x.copy()
        idx = np.random.choice(dim, size=3, replace=False)
        v1 = 0.5 * (x[idx] + clip(rng.normal(size=(len(idx),)) * (ub - lb)))
        v2 = 0.5 * (clip(rng.normal(size=(len(idx),))) * (ub - lb) + ub)
        y[idx] = v1
        c = 0.3 * (v2 - x[idx])
        y[idx] += c

        cost = func(y)

        if cost < best_cost:
            best_cost = cost
            x_best = y.copy()

        x = clip(x_best + rng.normal(size=(dim,)) * 0.1)

    return x_best
