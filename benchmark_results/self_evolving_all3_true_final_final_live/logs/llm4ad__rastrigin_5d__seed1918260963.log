def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def generate_initial_population(dim, num_parents):
        return rng.uniform(lb, ub, (num_parents, dim))

    def compute_objective(x):
        return func(x), np.sum(np.abs(x))

    def select_parents(population, objective_values, num_parents):
        indices = np.argsort(objective_values)[:num_parents]
        return population[indices]

    def adapt_step_size(step_size, noise_scaling, best_value):
        new_step_size = step_size * np.exp((budget - best_value) / (budget * 2))
        new_noise_scaling = noise_scaling + (best_value - budget) / (budget * 2)
        return new_step_size, new_noise_scaling

    population = generate_initial_population(dim, 10)
    num_parents = int(0.1 * len(population))
    step_size = 5
    noise_scaling = 0
    best_x = None
    best_value = np.inf

    for _ in range(budget):
        objective_values, ranks = zip(*[compute_objective(x) for x in population])
        population = select_parents(population, objective_values, num_parents)
        step_size, noise_scaling = adapt_step_size(step_size, noise_scaling, budget - len(objective_values))
        new_population = [clip(x + rng.normal(0, step_size * (1 + 2 * np.exp(-r)), dim) for x in population)]
        new_objective_values, _ = zip(*[compute_objective(x) for x in new_population])
        if min(new_objective_values) < best_value:
            best_x = new_population[np.argmin(new_objective_values)][0]
            best_value = min(new_objective_values)
        population.extend(new_population)

    return best_x
