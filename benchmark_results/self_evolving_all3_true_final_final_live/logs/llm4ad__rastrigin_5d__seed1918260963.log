def algorithm(func, dim, lb, ub, budget, rng):
    def get_initial_population(rng):
        return 10 * (ub - lb) + (lb - rng.uniform(0, 1, size=dim))

    def evaluate(population, func):
        return [func(x) for x in population]

    def mutation(candidates, dimension, bounds):
        new_candidate = np.copy(candidates)
        for i in range(dimension):
            if rng.random() < 0.5:
                new_candidate[i] += rng.uniform(-1, 1) * (bounds[1] - bounds[0])
                new_candidate[i] = max(bounds[0], min(new_candidate[i], bounds[1]))
        return new_candidate

    def crossover(parents, dimension):
        children = np.copy(parents)
        for i in range(dimension):
            if rng.random() < 0.5:
                children[i] += (rng.uniform(-1, 1) * parents[i])
        return children

    population_size = int(np.ceil(budget / (2 * dim)))
    initial_population = get_initial_population(rng)
    current_best = None
    cooling_rate = 0.99
    sigma_min = 0.001
    sigma_max = 10.0
    T = 10000
    sigma = sigma_max

    for t in range(budget):
        population = [initial_population + mutation(initial_population, dim, (lb, ub)) for _ in range(population_size)]
        fitnesses = evaluate(population, func)

        for i in range(population_size):
            if current_best is None or fitnesses[i] < current_best:
                current_best = fitnesses[i]
                best_candidate = population[i]

        sigma *= cooling_rate

        if t % T == 0 and sigma > sigma_min:
            new_population = []
            for _ in range(int(population_size / 2)):
                parent1, parent2 = rng.choice(population_size, size=2, replace=False)
                child = crossover([population[parent1], population[parent2]], dim)
                new_population.append(child + mutation(child, dim, (lb, ub)))
            population += new_population
            fitnesses = evaluate(population, func)

        clipped_population = [max(min(x, ub), lb) for x in population]
        clipped_fitnesses = evaluate(clipped_population, func)

        idx = np.argmin(clipped_fitnesses)
        if clipped_fitnesses[idx] < current_best:
            current_best = clipped_fitnesses[idx]
            best_candidate = clipped_population[idx]

    return np.array(best_candidate)
