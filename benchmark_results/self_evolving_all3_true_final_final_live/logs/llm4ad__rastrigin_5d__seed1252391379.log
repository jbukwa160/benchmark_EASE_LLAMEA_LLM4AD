def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, (1, dim))
    sigma = 0.5 * (ub - lb)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Step 1: Generate new candidate solutions by perturbing the current solution
        delta = rng.normal(size=(1, dim)) * sigma
        x_new = x + delta

        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)

        # Step 2: Evaluate the objective function for the new candidate solutions
        f_new = func(x_new)

        # Step 3: Update the step size using a simple adaptation strategy
        if f_new < best_f:
            sigma *= 1.01
            x = x_new.copy()
            best_x = x.copy()
            best_f = f_new

        else:
            sigma /= 0.9

    return best_x[0]
