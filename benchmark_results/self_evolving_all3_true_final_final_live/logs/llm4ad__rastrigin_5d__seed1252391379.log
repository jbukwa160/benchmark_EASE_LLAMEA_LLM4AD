def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        x = np.clip(x, lb, ub)
        return func(x)

    def cma_es(x0, sigma0, budget):
        x_best = x0
        f_best = evaluate(x0)
        pop_size = 20 + int(np.sqrt(budget / (10 * dim)))
        mu = int(pop_size / 2)
        lambda_ = pop_size - mu
        D = np.eye(dim) if sigma0 == 1 else np.eye(dim) * sigma0 ** 2
        pc = np.zeros((dim,))
        for t in range(budget):
            y = np.random.multivariate_normal(pc, D)
            x = x_best + sigma0 * np.sqrt(D) @ y
            f = evaluate(x)
            if f < f_best:
                f_best = f
                x_best = x.copy()
            pc += (x - x_best) / sigma0 ** 2
        return x_best

    x0 = rng.uniform(lb, ub, size=(dim,))
    sigma0 = 1.5
    best_solution = cma_es(x0, sigma0, budget)
    return best_solution
