def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def func_eval(x):
        return func(clip(x))

    def cma_es(bounds, num_dims, num_parents, learning_rate, restart_threshold, max_budget):
        x = np.random.uniform(-5.0, 5.0, size=num_dims)
        lambda_ = num_parents
        mu = num_parents / 2
        sigma = 10.0
        cm = np.eye(num_dims) * (1 + rng.uniform(-1e-6, 1e-6))
        pc = np.zeros((num_dims,))
        damps = 1e-4

        for i in range(max_budget):
            y = func_eval(x)
            x_new = x + sigma * np.dot(cm, np.random.normal(size=num_dims))

            if rng.rand() < 0.5:
                pc = clip(pc - learning_rate * np.dot(cm, np.random.normal(size=num_dims)))

            cm = (1 - damps) * cm + damps * (np.outer(x_new - x, x_new - x) / lambda_)
            sigma *= np.exp(0.5 * rng.randn() ** 2)

            if i > max_budget // 3:
                if y < func_eval(x_new):
                    x = x_new

            if i % (max_budget // 10) == 0 and rng.rand() < 0.1:
                cm = np.eye(num_dims)
                pc = np.zeros((num_dims,))
                sigma = 10.0
                x = np.random.uniform(bounds[0], bounds[1], size=num_parents)

            if y < func_eval(x):
                x = x_new

        return x

    num_parents = int(budget ** 0.5)
    learning_rate = 2 / budget
    restart_threshold = 10000
    max_budget = int(np.ceil(budget))

    x_best = cma_es((lb, ub), dim, num_parents, learning_rate, restart_threshold, max_budget)

    return x_best
