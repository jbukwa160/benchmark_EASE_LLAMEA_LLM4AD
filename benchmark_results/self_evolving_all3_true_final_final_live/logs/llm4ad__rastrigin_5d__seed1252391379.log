def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    init = lambda: rng.uniform(lb, ub, size=(dim,))
    x_best = init()

    for i in range(budget):
        y1 = init()
        y2 = init()
        y3 = init()
        
        v1 = clip(0.5*y1 + 0.5*x_best)
        v2 = clip(y2 + rng.uniform(-1, 1)*(x_best - y1))
        v3 = clip(y3 + rng.uniform(-1, 1)*(x_best - y1))

        if func(v1) < func(x_best):
            x_best = v1
        elif func(v2) < func(x_best):
            x_best = v2
        elif func(v3) < func(x_best):
            x_best = v3

    return x_best
