def algorithm(func, dim, lb, ub, budget, rng):
    n = 0
    best_x = rng.uniform(size=dim) * (ub - lb) + lb
    best_y = func(best_x)
    
    while n < budget:
        x = rng.normal(size=dim, loc=best_x, scale=np.std(best_x))
        y = func(np.clip(x, a_min=lb, a_max=ub))
        
        if y < best_y:
            best_x = np.copy(x)
            best_y = y
        
        n += 1
    
    return best_x
