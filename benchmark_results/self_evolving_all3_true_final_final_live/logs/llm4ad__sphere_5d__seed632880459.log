def algorithm(func, dim, lb, ub, budget, rng):
    def sphere(x):
        return np.sum(np.square(x))

    D = dim
    mu = D * (ub - lb)
    sigma_init = 0.1 * (ub - lb)
    lambda_ = int(D * (D + 2))
    nu = D + 9

    x_best = lb + rng.random(dim) * (ub - lb)
    f_best = func(x_best)

    cum_sum = np.cumsum(rng.random(lambda_) * sigma_init)

    for i in range(budget):
        x = x_best + cum_sum / mu
        x = np.clip(x, lb, ub)
        f = func(x)

        if f < f_best:
            f_best = f
            x_best = x

        delta = (x - x_best) / sigma_init
        C = 1 + 2 * rng.random(lambda_) - 1
        cum_sum += C * delta

    return x_best
