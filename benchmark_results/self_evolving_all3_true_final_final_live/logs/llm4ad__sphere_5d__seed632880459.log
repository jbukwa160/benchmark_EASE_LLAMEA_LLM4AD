def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_y = func(clip(x))

    T = 1000
    cooling_rate = 0.99
    sigma = 10.0

    for _ in range(budget):
        v = clip(rng.normal(size=(dim,), loc=x, scale=sigma))
        y = func(clip(v))
        if rng.random() < np.exp((best_y - y) / T):
            x = v.copy()
            best_x = x.copy()
            best_y = y
        else:
            x = 0.5 * (x + v)
        
        T *= cooling_rate

    return best_x
