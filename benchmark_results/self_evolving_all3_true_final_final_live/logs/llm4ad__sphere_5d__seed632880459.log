def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    best_x = np.zeros(dim)
    best_f = float('inf')

    T = 1e2
    alpha = 0.99

    for _ in range(budget):
        x = clip(best_x + rng.normal(size=dim), lb, ub)
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
        
        delta = np.random.uniform(-1e-3, 1e-3, size=dim)
        new_x = clip(best_x + delta, lb, ub)

        delta_f = func(new_x) - f

        if delta_f <= 0 or np.exp(-(delta_f/T)) >= rng.uniform():
            best_x = new_x
            T *= alpha
        
    return best_x
