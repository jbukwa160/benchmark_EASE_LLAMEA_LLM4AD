def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = 0
    
    T = 10.0
    alpha = 0.99
    
    for i in range(budget):
        x = x_best + (ub - lb) * rng.uniform(-1, 1, size=dim)
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
        
        f = func(x)
        
        if f < f_best:
            f_best = f
            x_best = x
        
        if f > f_best:
            delta_f = f - f_best
            
            if delta_f <= 0 or rng.rand() * T > -delta_f / (T * np.exp(-i / budget)):
                x_best = x
                f_best = f
        
        T *= alpha
    
    return x_best
