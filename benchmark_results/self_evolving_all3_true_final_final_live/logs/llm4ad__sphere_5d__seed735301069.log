def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = np.copy(x)

    for _ in range(budget):
        dx = np.zeros(dim)
        for i in range(dim):
            if rng.rand() < 0.5:
                dx[i] = rng.choice([-1, 1]) * rng.uniform(10**-6, 10**-3)
            else:
                dx[i] = rng.normal(0, 10**-4)

        x_new = np.clip(x + dx, lb, ub)

        if func(x_new) < func(best_x):
            best_x = np.copy(x_new)

        x = np.random.uniform(lb, ub, size=dim)

    return best_x
