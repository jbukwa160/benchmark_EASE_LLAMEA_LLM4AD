def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    T = 1e6
    alpha = 0.99
    step_size = 2.0

    for _ in range(budget):
        x_new = x + rng.uniform(-step_size, step_size, size=dim)
        x_new = clip(x_new)

        delta = func(x_new) - func(x)
        if delta < 0 or (rng.rand() < np.exp(-delta / T)):
            x = x_new
            step_size *= alpha

        T *= alpha

    return x
