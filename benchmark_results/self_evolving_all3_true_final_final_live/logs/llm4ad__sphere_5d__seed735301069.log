def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 10
    sigma = 0.5
    mu = np.zeros(dim)
    cov = np.eye(dim) * sigma**2
    best_x = None
    best_f = float('inf')
    
    for i in range(budget):
        x = rng.normal(mu, cov.shape[0])
        x = lb + (ub - lb) * x
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
            
        z = rng.normal(0, 1, dim)
        delta = np.dot(cov, z)
        mu_new = mu + sigma**2 / (i+1) * delta
        
        cov_new = (i/(i+2)) * cov + (1/(i+2)) * np.outer(delta, delta)
        
        mu = mu_new
        cov = cov_new
    
    return best_x if best_f < float('inf') else None
