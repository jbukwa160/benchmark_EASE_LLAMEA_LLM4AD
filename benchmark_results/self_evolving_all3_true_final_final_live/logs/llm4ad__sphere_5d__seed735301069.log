def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_sol = np.zeros(dim)
    best_eval = float('inf')
    
    for _ in range(budget):
        candidate = best_sol + (ub - lb) * (rng.rand(dim) - 0.5) * 2
        candidate = clip(candidate)
        
        eval = func(candidate)
        if eval < best_eval:
            best_eval = eval
            best_sol = candidate
    
    return best_sol
