def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    D = 1e-6 * rng.rand(n)
    mu = (ub - lb) * rng.rand(n) + lb
    sigma = 0.5 * (ub - lb)

    for _ in range(budget):
        X = np.random.multivariate_normal(mu, np.eye(n) * sigma**2)
        X = np.clip(X, lb, ub)

        fX = func(X)
        if rng.rand() < 1 / (1 + np.exp(fX)):
            D = X - mu
            mu = X
            sigma = max(0.01, min(10, 0.1 * (sigma + abs(D).max() / n)))
    return mu
