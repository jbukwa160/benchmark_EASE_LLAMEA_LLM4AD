def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        step_size = 0.1 / (1 + np.linalg.norm(best_x))
        s = (ub - lb) * rng.randn(dim) + lb
        
        for i in range(dim):
            s[i] += step_size * (x[i] - best_x[i])
        
        s = np.clip(s, lb, ub)
        sf = func(s)
        
        if sf < best_f:
            best_f = sf
            best_x = s.copy()
        
        x = s.copy()
    
    return best_x
