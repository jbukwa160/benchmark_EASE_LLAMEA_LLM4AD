def algorithm(func, dim, lb, ub, budget, rng):
    def bounds(x):
        return np.clip(x, a_min=lb, a_max=ub)

    x = bounds(rng.uniform(size=(dim)))
    T0 = 10000
    alpha = 0.9
    beta = 1e-6

    for _ in range(budget):
        y = bounds(x + rng.normal(size=(dim)) / np.sqrt(np.sum(x**2) + 1))
        delta = func(y) - func(x)

        if delta < 0:
            x = y
        else:
            T = max(alpha * (T0 - _), beta)
            u = rng.uniform(0, 1)
            if np.exp(-delta / T) > u:
                x = y

    return bounds(x)
