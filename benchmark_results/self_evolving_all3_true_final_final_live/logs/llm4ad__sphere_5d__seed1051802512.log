def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    sigma = 1.0
    for _ in range(budget):
        v = rng.randn(dim)
        x_new = x + sigma * v
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)
        if f_new < func(x):
            x = x_new
    return x
