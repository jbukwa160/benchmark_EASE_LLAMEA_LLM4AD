def algorithm(func, dim, lb, ub, budget, rng):
    x = 5 * (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    best_f = func(x)
    
    for t in range(budget):
        g = 2 * x
        step_size = np.mean(np.abs(g)) / np.sqrt(t + 1)
        
        new_x = x - step_size * g
        new_x = np.clip(new_x, lb, ub)
        
        f_new = func(new_x)
        
        if f_new < best_f:
            best_f = f_new
            best_x = new_x.copy()
            
        x = new_x.copy()
    
    return best_x
