def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_x = rng.uniform(lb, ub, size=dim)
    best_f = func(best_x)
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        # Calculate the probability of selecting a new candidate
        p = np.exp(-func(x))
        if rng.random() < p:
            best_x = clip(x)
            best_f = func(best_x)
    
    return best_x
