def algorithm(func, dim, lb, ub, budget, rng):
    bounds = [(lb, ub) for _ in range(dim)]
    
    # Simulated Annealing
    def sim_anneal(bounds, func, rng):
        T = 1000.0
        t = 0
        x = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
        
        while True:
            y = func(x)
            
            # Create a new candidate by perturbing the current solution
            delta = rng.normal(size=dim) * 0.01
            x_new = x + delta
            
            # Clip to bounds
            x_new = np.clip(x_new, lb, ub)
            
            f_new = func(x_new)
            
            if f_new < y:
                x = x_new
                y = f_new
                
            else:
                prob = np.exp((y - f_new) / T)
                if rng.uniform(0, 1) < prob:
                    x = x_new
                    y = f_new
                    
            t += 1
            
            # Decrease temperature linearly with time
            T *= 0.9995
            
            # Stop when budget is reached or no improvement for a while
            if t > budget or y == func(x):
                break
                
        return x
    
    # Nelder Mead downhill simplex algorithm
    def nelder_mead(bounds, func, rng):
        res = differential_evolution(func, bounds)
        
        best_x = res.x
        
        return best_x
    
    # Run Simulated Annealing for a budget of 1000 iterations
    initial_solution = sim_anneal(bounds, func, rng)
    
    # Run Nelder Mead downhill simplex algorithm as a second stage optimization
    final_solution = nelder_mead(bounds, func, rng)
    
    return final_solution
