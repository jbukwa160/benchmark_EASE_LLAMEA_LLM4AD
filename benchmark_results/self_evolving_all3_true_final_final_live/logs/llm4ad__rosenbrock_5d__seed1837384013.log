def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        std_dev = 1.0
        if _ > budget // 2:
            std_dev /= np.sqrt(_ / (budget - 10))

        new_candidate = x_best + rng.randn(dim) * std_dev

        clipped_candidate = clip(new_candidate)
        f_new = func(clipped_candidate)

        if f_new < f_best:
            x_best = clipped_candidate
            f_best = f_new

    return x_best
