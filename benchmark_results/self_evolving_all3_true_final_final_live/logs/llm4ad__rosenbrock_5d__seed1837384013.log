def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        for i in range(dim):
            # Perturb along each dimension
            x_perturb = x_best.copy()
            x_perturb[i] += rng.uniform(-0.1, 0.1)

            # Clip to bounds
            x_perturb = np.clip(x_perturb, lb, ub)

            f_perturb = func(x_perturb)
            if f_perturb < f_best:
                x_best = x_perturb
                f_best = f_perturb

    return x_best
