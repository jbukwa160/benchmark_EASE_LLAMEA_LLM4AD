def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    cr = 0.9
    f = 0.5
    sigma = 0.1
    best_x = None
    best_y = np.inf
    
    for _ in range(budget):
        # Initialize population
        pop = np.random.uniform(lb, ub, (pop_size, dim))
        
        for _ in range(pop_size):
            # Selection
            idx1 = rng.randint(0, pop_size)
            idx2 = rng.randint(0, pop_size)
            idx3 = rng.randint(0, pop_size)
            
            # Crossover
            x = 0.5 * (pop[idx1] + pop[idx2])
            y = pop[idx3]
            for i in range(dim):
                if rng.random() < cr or i == dim-1:
                    r = rng.uniform(lb[i], ub[i])
                    x[i] = r
                else:
                    x[i] = 0.5 * (y[i] + pop[idx2][i])
            
            # Mutation
            x += sigma * (x - pop[idx1]) + f * (pop[idx3] - pop[idx2])
            
            # Clip to bounds
            x = np.clip(x, lb, ub)
            
            # Fitness evaluation
            y = func(x)
            
            # Update best solution
            if y < best_y:
                best_x = x
                best_y = y
                
    return best_x
