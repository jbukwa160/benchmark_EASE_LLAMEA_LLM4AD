def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        # Differential evolution
        y = x + rng(np.random.normal(size=(dim,))) * 0.1
        y = clip(y)
        
        if func(y) < best_f:
            best_x = y.copy()
            best_f = func(y)

        # Simulated annealing
        tau = 1 / (np.log(_ + 2))
        u = rng.uniform(0, 1, size=(dim,))
        
        for i in range(dim):
            if u[i] < tau * np.exp((best_f - func(clip(best_x + 0.1 * (y[i] - best_x[i])))) / 10):
                best_x[i] = y[i]
                break

    return clip(best_x)
