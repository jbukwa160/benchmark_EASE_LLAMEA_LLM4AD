def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        dx = rng.normal(size=(1, dim))
        for i in range(dim):
            temp_dx = np.zeros_like(dx)
            temp_dx[:, i] = dx[:, i]
            
            new_x = x + 0.1 * temp_dx
            new_x = np.clip(new_x, lb, ub)
            
            f_new = func(new_x)
            if f_new < best_f:
                best_f = f_new
                best_x = new_x.copy()
                
            dx[:, i] = -temp_dx[:, i]
            
            new_x = x + 0.1 * dx
            new_x = np.clip(new_x, lb, ub)
            
            f_new = func(new_x)
            if f_new < best_f:
                best_f = f_new
                best_x = new_x.copy()
                
    return best_x.flatten()
