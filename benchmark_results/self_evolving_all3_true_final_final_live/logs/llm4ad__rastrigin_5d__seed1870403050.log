def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    initial_simplex = rng.normal(loc=[(lb + ub) / 2] * dim, scale=1, size=(dim + 1, dim))
    simplex = initial_simplex.copy()

    for iteration in range(budget):
        centroid = np.mean(simplex[:-1], axis=0)
        worst = np.argmin([func(c) for c in simplex])
        
        if func(centroid) < func(simplex[worst]):
            simplex[-1] = centroid
        else:
            dir_ = rng.normal(loc=np.zeros(dim), scale=1, size=dim)
            
            # Differential Evolution part
            i, j = rng.choice(dim, 2, replace=False)
            mutant = simplex[rng.randint(0, dim + 1)] + 0.5 * (simplex[(j % (dim + 1))].copy() - simplex[i].copy()) + 0.5 * dir_
            crossed_over = clip(mutant + rng.normal(loc=np.zeros(dim), scale=0.01, size=dim))
            
            # Nelder-Mead part
            if func(crossed_over) < func(simplex[worst]):
                simplex[-1] = crossed_over
            else:
                simplex[rng.randint(0, dim + 1)] = centroid

    return np.argmin([func(c) for c in simplex[:-1]], axis=0)
