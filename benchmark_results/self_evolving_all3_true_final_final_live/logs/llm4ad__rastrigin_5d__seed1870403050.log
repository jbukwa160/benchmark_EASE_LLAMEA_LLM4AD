def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    pop_size = 50
    bounds = [(lb, ub) for _ in range(dim)]
    population = rng.uniform(lb, ub, size=(pop_size, dim))
    
    best = float('inf')
    x_best = None
    
    iteration = 0
    while iteration < budget:
        iteration += 1
        
        F = 0.5
        CR = 0.9
        children = []
        
        for i in range(pop_size):
            trial = clip(population[i] + rng.uniform(-F, F, size=dim))
            
            for j in range(dim):
                if rng.rand() < CR or rng.rand() < 1 / (iteration + 1):
                    trial[j] = population[i][j]
                    
            children.append(trial)
        
        f_values = [func(clip(child)) for child in children]
        
        for i in range(pop_size):
            if f_values[i] < best:
                best = f_values[i]
                x_best = clip(children[i])
                
        index = np.argmin(f_values)
        population[index] = clip(children[index])
    
    return x_best
