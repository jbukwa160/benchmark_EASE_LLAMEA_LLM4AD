def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for i in range(budget - 1):
        step_size = max(0.01, (ub - lb) / 2 ** i)
        x_new = x_best + step_size * rng.choice([-1, 1], size=dim)
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        
        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
