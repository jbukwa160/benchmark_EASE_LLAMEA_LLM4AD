def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    def get_cma(x, y):
        sigma = 1e-3 + 0.5 * (np.linalg.norm(x - y) / budget)
        mean_x = x
        mean_y = y
        cov = sigma**2 * np.outer(mean_x - mean_y, mean_x - mean_y) + 1e-8 * np.eye(dim)
        return sigma, mean_x, mean_y, cov

    def update_cma(sigma, mean_x, mean_y, cov):
        step_size = rng.uniform(-1, 1, size=dim)
        new_mean = mean_x + sigma * step_size
        new_cov = (1 - 0.05) * cov + 0.05 * np.outer(step_size, step_size)
        return sigma, new_mean, mean_y, new_cov

    def evolve_cma(sigma, mean_x, mean_y, cov):
        x_new = rng.multivariate_normal(mean_x, cov)
        f_new = func(clip(x_new))
        if f_new < f_min:
            f_min = f_new
            best_x = clip(x_new)
        sigma, new_mean, _, _ = update_cma(sigma, mean_x, mean_y, cov)
        return sigma, new_mean

    rng.seed(rng.randint(0, 2**32))
    f_min = np.inf
    best_x = None
    cma_count = 0
    while budget > 0:
        x = rng.uniform(lb, ub, size=dim)
        if cma_count < 100 or rng.random() < 0.1:
            sigma, mean_x, mean_y, cov = get_cma(x, np.zeros(dim))
            f_new = func(clip(mean_x))
            if f_new < f_min:
                f_min = f_new
                best_x = clip(mean_x)
        else:
            sigma, mean_x = evolve_cma(sigma, mean_x, mean_y, cov)
        budget -= 1
        cma_count += 1

    return np.array(best_x)
