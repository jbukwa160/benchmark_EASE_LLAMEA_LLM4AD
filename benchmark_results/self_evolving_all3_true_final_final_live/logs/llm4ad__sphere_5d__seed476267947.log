def algorithm(func, dim, lb, ub, budget, rng):
    T = 1000
    alpha = 0.99
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for t in range(budget):
        x = np.clip(best_x + rng.normal(size=dim), lb, ub)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
            
        if T > 1e-6:
            delta = f - best_f
            T *= alpha
            
            if delta < 0 or np.random.rand() < np.exp(-delta / T):
                best_x = x
                
    return best_x
