def algorithm(func, dim, lb, ub, budget, rng):
    x0 = [rng.uniform(lb, ub) for _ in range(dim)]
    gp_model = {'mean': 0, 'stddev': 1, 'hypers': [1.0]*dim}
    
    for i in range(budget):
        # Sample new candidate
        mean, stddev = gp_model['mean'], gp_model['stddev']
        x_new = np.array([norm.rvs(loc=mean[i], scale=stddev[i]) for i in range(dim)])
        x_new = [max(lb, min(ub, x)) for x in x_new]
        
        # Evaluate function
        f_new = func(x_new)
        
        # Update GP model
        y_new = np.array([x**2 for x in x_new])
        gp_model['mean'] += 0.1 * (y_new - gp_model['mean'])
        gp_model['stddev'] *= 0.9
        
        # Select next point
        mean, stddev = gp_model['mean'], gp_model['stddev']
        x_next = np.array([norm.rvs(loc=mean[i], scale=stddev[i]) for i in range(dim)])
        x_next = [max(lb, min(ub, x)) for x in x_next]
        
    return x_next
