def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    x_init = (ub - lb) * rng.random((1, dim)) + lb
    x_best = x_init.copy()
    y_best = func(x_best)

    for i in range(budget):
        x_temp = np.zeros((n, dim))
        for j in range(n):
            x_temp[j] = (ub - lb) * rng.random((1, dim)) + lb

        x_mut = x_temp + 0.5 * (x_temp - x_init)
        y_mut = func(x_mut)

        if y_mut < y_best:
            x_best = x_mut.copy()
            y_best = y_mut
        elif np.random.rand() < 0.1:
            x_best += 0.01 * rng.normal(size=dim) * (x_temp - x_init)
            if func(x_best) < y_best:
                y_best = func(x_best)

    return x_best[0]
