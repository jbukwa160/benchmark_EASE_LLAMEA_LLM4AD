def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = 50
    mutation_factor = 0.5
    crossover_rate = 0.7
    best_solution = None
    best_fitness = float('inf')

    for _ in range(budget):
        population = rng.uniform(lb, ub, (pop_size, dim))
        for i in range(pop_size):
            candidate = clip(population[i] + mutation_factor * (population[rng.randint(0, pop_size), :] - population[rng.randint(0, pop_size), :]) + 
                            mutation_factor * (population[rng.randint(0, pop_size), :] - population[rng.randint(0, pop_size), :]))
            if rng.uniform(0, 1) < crossover_rate:
                candidate = clip((population[i] + candidate) / 2)
            fitness = func(candidate)
            if fitness < best_fitness:
                best_solution = candidate
                best_fitness = fitness

    return best_solution
