def algorithm(func, dim, lb, ub, budget, rng):
    def rosenbrock(x):
        return func(x)

    n = len(x)
    X = np.zeros((budget, n))
    Y = np.zeros(budget)
    x0 = (ub + lb) / 2 * np.ones(n)
    X[0] = x0

    for i in range(1, budget):
        gp = GaussianProcess(X[:i], Y[:i])
        mu, var = gp.predict(np.array([[x0]]))
        acq = -mu + 1.96 * np.sqrt(var)  # Expected Improvement (EI)
        grad_acq = gradient(acq, x0)
        
        if np.linalg.norm(grad_acq) > 1e-3:  # Explore if acquisition function has a large gradient
            step_size = 0.5
            dirn = -grad_acq / np.linalg.norm(grad_acq)
            x_new = x0 + step_size * dirn
        else:
            x_new = acq_optimiser(acq, x0)  # Optimise the acquisition function
        
        X[i] = clip(x_new, lb, ub)
        Y[i] = rosenbrock(X[i])
    
    best_x = np.argmin(Y)
    return X[best_x]
