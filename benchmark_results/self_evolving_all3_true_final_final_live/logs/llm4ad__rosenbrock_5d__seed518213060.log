def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(mean, sigma):
        return mean + sigma * np.random.randn(dim)

    D = rng.uniform(lb, ub, size=(dim,))
    step_size = 0.5
    for _ in range(budget):
        candidates = [get_candidate(D, step_size) for _ in range(50)]
        candidate_fitnesses = [func(candidate) for candidate in candidates]
        best_idx = np.argmin(candidate_fitnesses)
        D = candidates[best_idx].copy()
        step_size *= 0.99 if max(candidate_fitnesses) - min(candidate_fitnesses) > 1e-6 else 0.9
    return D
