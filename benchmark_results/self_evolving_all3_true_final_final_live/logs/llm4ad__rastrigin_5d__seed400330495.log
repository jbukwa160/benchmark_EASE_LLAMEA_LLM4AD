def algorithm(func, dim, lb, ub, budget, rng):
    def get_next_candidate(x_best, lb, ub):
        sigma = 0.1
        n_samples = 1000
        x_new = np.zeros(dim)
        for i in range(dim):
            mean = x_best[i]
            std_dev = sigma * (ub - lb) / dim
            new_x_i = rng.normal(mean, std_dev)
            new_x_i = max(lb, min(ub, new_x_i))
            x_new[i] = new_x_i
        return x_new

    x_best = np.zeros(dim)
    for _ in range(budget):
        x_new = get_next_candidate(x_best, lb, ub)
        f_new = func(x_new)
        if f_new < func(x_best):
            x_best = x_new
    return x_best
