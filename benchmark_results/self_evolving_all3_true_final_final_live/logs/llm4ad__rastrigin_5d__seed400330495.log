def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    population = rng.uniform(lb, ub, size=(budget, dim))
    best = None
    for _ in range(budget):
        fitnesses = [func(clip(x)) for x in population]
        min_fitness = np.min(fitnesses)
        if best is None or min_fitness < func(best):
            best = population[np.argmin(fitnesses)]
        parents = []
        for i in range(budget // 3):
            parent1, parent2 = rng.choice(population, size=2, replace=False)
            mutation = rng.uniform(-0.5, 0.5, size=dim) * (ub - lb)
            child = parent1 + mutation + rng.uniform(lb, ub, size=dim)
            parents.append(child)
        population = np.array(parents)
        population = clip(population)
    return best
