def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidates(mean, cov, t):
        candidates = mean + np.random.multivariate_normal(np.zeros(dim), cov)
        candidates = clip(candidates)
        return candidates

    mean = np.random.uniform(lb, ub, size=dim)
    cov = np.eye(dim) * 1e-4
    lambda_ = int(0.25 * dim)

    for _ in range(budget):
        candidates = generate_candidates(mean, cov, rng.randint(2**31 - 1))
        fitnesses = [func(candidates[i]) for i in range(lambda_)]

        best_idx = np.argmin(fitnesses)
        best_candidate = candidates[best_idx]
        mean = (lambda_ * best_candidate + mean) / (lambda_ + 1)

        cov_add = 0.5 * np.outer((candidates - mean).T, (candidates - mean).T - np.eye(dim))
        cov += 2 / (lambda_ + 1) * cov_add

    return clip(mean)
