def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_candidate = None
    for _ in range(budget):
        if best_candidate is not None:
            candidate = best_candidate + rng.uniform(-1, 1) * (ub - lb)
        else:
            candidate = lb + rng.uniform(0, 1) * (ub - lb)
        candidate = clip(candidate)

        value = func(candidate)
        if best_candidate is None or value < func(best_candidate):
            best_candidate = candidate

    return best_candidate
