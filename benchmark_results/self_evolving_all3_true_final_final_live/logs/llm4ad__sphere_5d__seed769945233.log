def algorithm(func, dim, lb, ub, budget, rng):
    N = 2 * dim + 1
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_new = x_best.copy()
        i = rng.choice(dim)
        step_size = (ub - lb) / budget ** 0.5
        if rng.random() < 0.1:
            step_size *= rng.uniform(1, 10)
        delta = np.zeros(dim)
        delta[i] = rng.uniform(-step_size, step_size)
        x_new += delta

        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
