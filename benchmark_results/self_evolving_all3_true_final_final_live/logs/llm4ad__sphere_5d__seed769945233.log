def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_f = float('inf')
    
    for _ in range(budget):
        x = lb + (ub - lb) * rng.rand(dim)
        
        for t in range(20000):  # number of gradient descent iterations
            g = np.zeros(dim)
            for i in range(dim):
                dx = np.zeros(dim)
                dx[i] = 1e-5
                g[i] = (func(x + dx) - func(x)) / 1e-5
            
            alpha = 0.01
            x -= alpha * g
            
            # clip to bounds
            x = np.clip(x, lb, ub)
            
            if func(x) < best_f:
                best_x = x
                best_f = func(x)
    
    return best_x
