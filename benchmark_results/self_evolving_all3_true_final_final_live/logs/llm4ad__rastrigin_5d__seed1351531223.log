def algorithm(func, dim, lb, ub, budget, rng):
    def bounds(x):
        return np.clip(x, lb, ub)

    n = 0
    pop_size = 10 * dim
    mu = np.zeros(dim)
    sigma = 1.5
    lambda_ = pop_size // 2
    x_best = np.random.uniform(lb, ub, size=(lambda_, dim))
    y_best = np.full(lambda_, float('inf'))
    while n < budget:
        x_new = bounds(x_best + rng.normal(0, sigma, size=(lambda_, dim)))
        y_new = func(x_new)
        for i in range(lambda_):
            if y_new[i] < y_best[i]:
                y_best[i] = y_new[i]
                x_best[i] = x_new[i]
        n += 1
    return bounds(x_best[np.argmin(y_best)])
