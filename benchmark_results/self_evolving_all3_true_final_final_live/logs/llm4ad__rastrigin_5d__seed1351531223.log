def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x0 = rng.uniform(lb, ub, size=dim)
    best_x = clip(x0)
    best_f = func(clip(best_x))

    temp = 1.0
    T_max = 10.0
    alpha = 0.99

    for i in range(budget):
        x_new = clip(best_x + rng.uniform(-1, 1, size=dim))
        f_new = func(x_new)

        if f_new < best_f:
            best_x = x_new
            best_f = f_new

        delta = f_new - best_f
        if delta < 0 or np.random.rand() < np.exp(delta / temp):
            best_x = x_new
            best_f = f_new

        temp *= alpha
        if temp < T_max:
            x0 = rng.uniform(lb, ub, size=dim)
            best_x = clip(x0)
            best_f = func(clip(best_x))
            temp = 1.0

    return np.array(best_x)
