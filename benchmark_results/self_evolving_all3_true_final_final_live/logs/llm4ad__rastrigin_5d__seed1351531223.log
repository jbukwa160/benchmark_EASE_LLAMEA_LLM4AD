def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    sigma = 0.1
    alpha = 0.01
    T = 10000
    best_x = np.zeros(dim)
    best_f = float('inf')

    for _ in range(T):
        X = rng.uniform(lb, ub, size=(pop_size, dim))
        F = rng.uniform(0.5, 1.5, size=pop_size)

        for i in range(pop_size):
            Y = X[i] + sigma * np.random.randn(dim)
            Y = np.clip(Y, lb, ub)
            f = func(Y)
            if f < func(X[i]):
                X[i] = Y
                F[i] = rng.uniform(0.5, 1.5)

        for i in range(pop_size):
            j = rng.randint(0, pop_size - 1)
            k = rng.randint(0, dim - 1)
            X[i, k], X[j, k] = X[j, k], X[i, k]
            f = func(X[i])
            if f < func(best_x):
                best_x = X[i].copy()
                best_f = func(best_x)

        for i in range(pop_size):
            Y = best_x + alpha * np.random.randn(dim)
            Y = np.clip(Y, lb, ub)
            f = func(Y)
            if f <= best_f:
                best_x = Y.copy()

    return best_x
