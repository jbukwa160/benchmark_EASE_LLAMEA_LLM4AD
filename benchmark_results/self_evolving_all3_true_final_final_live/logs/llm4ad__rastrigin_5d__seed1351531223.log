def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        f = func(x)
        
        if f < best_f:
            best_x = x
            best_f = f
        
        # Exploration mechanism: 10% chance to jump to a random new location
        if rng.uniform(0, 1) < 0.1:
            x_new = rng.uniform(lb, ub, size=dim)
            f_new = func(x_new)
            
            # Probability-based selection strategy
            prob = np.exp(-f_new / best_f)
            if rng.uniform(0, 1) < prob:
                best_x = x_new
                best_f = f_new
    
    return best_x
