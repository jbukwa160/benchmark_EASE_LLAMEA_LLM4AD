def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    n = int(np.ceil(budget / (dim * 2)))
    x = rng.uniform(lb, ub, size=(n, dim))
    mu = np.mean(x, axis=0)
    sigma = np.std(x, axis=0)
    C = np.eye(dim) * np.var(sigma)

    for _ in range(n):
        y = clip(mu + rng.normal(0, 1e-5, size=dim) @ np.linalg.cholesky(C))
        y = func(y)
        if y < func(x):
            mu = x = y
        else:
            alpha = np.exp(-(y - func(x)) / (2 * sigma**2))
            u = rng.uniform(0, 1)
            if u < alpha:
                mu += 0.01 * (y - func(x))
                C *= 1 + 0.001 * (y - func(x))

    return clip(mu)
