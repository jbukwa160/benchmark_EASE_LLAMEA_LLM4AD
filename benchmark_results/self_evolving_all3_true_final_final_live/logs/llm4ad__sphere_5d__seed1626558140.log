def algorithm(func, dim, lb, ub, budget, rng):
    n = len(rng)
    mu = 1.0 / n * (ub + lb) * np.ones(dim)
    sigma = 1.0
    pc = 0.1
    lambda_ = int(n**2.1878)
    iteration = 0

    while iteration < budget:
        x = mu + sigma * rng[:, iteration % n]
        for i in range(len(x)):
            if lb[i] <= x[i] <= ub[i]:
                pass
            elif x[i] > ub[i]:
                x[i] = ub[i]
            else:
                x[i] = lb[i]

        f_x = func(x)
        
        if iteration % n == 0:
            mu += (1.0 / lambda_) * np.dot((x - mu).T, (func(x) - func(mu)))
        
        if iteration >= n and iteration < budget - n:
            cov = 1.0 / lambda_ * np.dot((x - mu).T, (x - mu))
            for i in range(dim):
                cov[i, i] += 1.0 / (lambda_*pc) + 2.0/lambda_
            
            sigma *= np.exp(1.0 / (4.0 + iteration/n)**0.5)
            D = np.linalg.inv(cov)
            rng[:, iteration % n] = mu + sigma * np.dot(D, np.random.randn(dim))
        
        iteration += 1

    return mu
