def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    best_f = float('inf')

    for _ in range(budget):
        candidate = rng.uniform(lb, ub, size=dim)
        new_f = func(candidate)

        if new_f < best_f:
            best_f = new_f
            best_x = candidate

        gradient = np.zeros(dim)
        step_size = 0.1

        for i in range(dim):
            x[i] += step_size
            x[i] = max(lb, min(ub, x[i]))
            new_f_plus_dx = func(x.copy())
            gradient[i] = (new_f_plus_dx - best_f) / step_size
            x[i] -= step_size

        for i in range(dim):
            if gradient[i] > 0:
                x[i] += 1e-6 * np.sign(gradient[i])
                x[i] = max(lb, min(ub, x[i]))

        new_f = func(x)

        if new_f < best_f:
            best_f = new_f
            best_x = x.copy()

    return best_x
