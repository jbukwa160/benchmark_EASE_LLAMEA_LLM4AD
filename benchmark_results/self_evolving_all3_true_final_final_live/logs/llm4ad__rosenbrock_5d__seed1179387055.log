def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(clip(x))

    for _ in range(budget):
        new_x = x + rng.normal(size=dim) * 0.1
        new_x = clip(new_x)
        
        new_f = func(new_x)
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f
            
        alpha = np.exp(-_ / (budget // 5))
        if rng.uniform(0, 1) > alpha and _ >= budget // 10:
            x = best_x.copy()

    return best_x
