def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x), x

    x0 = np.random.uniform(lb, ub, (dim,))
    best_x = x0.copy()
    best_f = float('inf')

    for t in range(budget):
        # Differential Evolution
        x1, _ = evaluate(np.array([x0[rng.randint(0, dim)] for r in rng.choice(dim, size=dim, replace=False)]))
        if x1 < best_f:
            best_x = x1.copy()
            best_f = x1

        # Simulated Annealing
        alpha = 0.99
        T = 100.0 * (1 - t / budget)
        x2 = clip(best_x + np.random.uniform(-T, T, size=dim))
        x2_f, _ = evaluate(x2)

        if x2_f < best_f:
            best_x = x2.copy()
            best_f = x2_f
        elif rng.rand() < np.exp((best_f - x2_f) / T):
            best_x = x2.copy()
            best_f = x2_f

    return best_x
