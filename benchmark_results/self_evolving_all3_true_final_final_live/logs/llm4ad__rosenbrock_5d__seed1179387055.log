def algorithm(func, dim, lb, ub, budget, rng):
    def mutation(pop, xbest, F, sigma):
        r1, r2 = rng.choice(dim, 2, replace=False)
        if rng.random() < 0.5:
            return pop + F * (xbest[r1] - pop) + np.sqrt(sigma) * (pop[r2] - pop[r1])
        else:
            return pop + F * (pop[r1] - xbest[r1]) + np.sqrt(sigma) * (pop[r2] - pop[r1])

    def crossover(pop, trial):
        if rng.random() < 0.5:
            return trial
        elif rng.random() < 0.3:
            return (trial + pop) / 2
        else:
            return pop

    N = 100  # population size
    sigma = 1  # initial standard deviation
    F = 0.8   # initial mutation factor
    xbest = np.random.uniform(lb, ub, dim)
    best_cost = func(xbest)

    for i in range(budget):
        pop = np.random.uniform(lb, ub, (N, dim))
        costs = [func(ind) for ind in pop]

        while max(costs) > best_cost:
            idx = costs.index(max(costs))
            pop[idx] = mutation(pop[idx], xbest, F, sigma)

        for j in range(N):
            trial = crossover(pop[j], np.random.uniform(lb, ub, dim))
            if func(trial) < costs[j]:
                costs[j] = func(trial)
                pop[j] = trial

        idx_best = costs.index(min(costs))
        xbest[idx_best] = pop[idx_best]
        best_cost = min(costs)

        # adaptive crossover probability
        if rng.random() < 0.5:
            F *= 1 - 0.01 * (i / budget)
            sigma *= 1 - 0.001 * (i / budget)

    return xbest
