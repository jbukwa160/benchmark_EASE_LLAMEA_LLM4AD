def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    N = int(np.ceil(budget / (2 * 5**dim)))
    w = 1 / (3 * dim)
    c_c = 0.8
    c_m = 2

    x_best = np.array([0] * dim)
    f_best = float('inf')

    for i in range(N):
        n = int(np.ceil(dim ** 0.5))
        mean = x_best.copy()
        sigma = max(1e-3, w / (i + 1) ** c_c)

        a = rng.normal(size=(n, dim), loc=mean, scale=sigma)
        b = np.random.choice([-1, 1], size=n)

        for j in range(n):
            x = mean + sigma * a[j] * b[j]
            f_val = f(np.clip(x, lb, ub))

            if f_val < f_best:
                f_best = f_val
                x_best = x

            if f_best == 0 or i >= budget // (2 * dim):
                break

        if f_best > 1e-3 and i >= budget // (dim ** 0.5):
            break

    return np.clip(x_best, lb, ub)
