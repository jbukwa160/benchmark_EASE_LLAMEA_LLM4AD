def algorithm(func, dim, lb, ub, budget, rng):
    best_x = rng.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for _ in range(budget - 1):
        x_new = best_x + rng.normal(size=dim) * (ub - lb) / 2
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        if f_new < best_f:
            best_f = f_new
            best_x = x_new

    return best_x
