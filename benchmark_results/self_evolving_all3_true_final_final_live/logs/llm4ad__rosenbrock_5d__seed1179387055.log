def algorithm(func, dim, lb, ub, budget, rng):
    def surrogate(x, gp, bounds):
        mu, sigma = gp.predict(np.atleast_2d(x), return_std=True)
        return mu[0]

    x = np.random.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)

    gp = None

    for i in range(budget):
        if gp is None:
            X = np.atleast_2d(x)
            Y = np.atleast_2d(func(X))
        else:
            X = np.vstack([gp.X, np.atleast_2d(x)])
            Y = np.hstack([gp.Y, np.atleast_2d(func(X))])

        gp = GaussianProcessRegressor(kernel=Matern(length_scale=1.0), alpha=1e-6)
        gp.fit(X, Y)

        f = surrogate(x, gp, (lb, ub))
        new_x = x + 0.5 * np.random.uniform(-1, 1, size=(dim,))

        # Clip to bounds
        new_x = np.clip(new_x, lb, ub)

        new_f = func(new_x)

        if new_f < f:
            x = new_x.copy()
            best_x = new_x.copy()

        if new_f < best_f:
            best_f = new_f

    return best_x
