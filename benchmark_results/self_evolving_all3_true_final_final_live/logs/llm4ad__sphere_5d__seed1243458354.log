def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_candidate = rng.uniform(lb, ub, size=dim)
    best_obj_value = func(clip(best_candidate))

    for _ in range(budget - 1):
        candidate = rng.uniform(lb, ub, size=dim)
        obj_value = func(clip(candidate))
        
        if obj_value < best_obj_value:
            best_candidate = clip(candidate)
            best_obj_value = obj_value

    return np.array(best_candidate)
