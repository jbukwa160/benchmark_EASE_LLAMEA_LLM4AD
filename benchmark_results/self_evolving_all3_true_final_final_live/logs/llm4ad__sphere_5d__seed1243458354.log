def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    T0 = 1e4
    alpha = 0.99
    cooling_rate = 1 / (dim * budget)
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        new_x = x.copy()
        idx = np.random.choice(dim, size=1)[0]
        new_x[idx] += (ub - lb) * rng.uniform(-1, 1)
        new_x = np.clip(new_x, lb, ub)
        
        delta_f = func(new_x) - best_f
        if delta_f < 0:
            x = new_x
            best_x = new_x
            best_f = func(best_x)
        else:
            T = T0 * (1 + cooling_rate * i) ** 2
            prob_accept = np.exp(-delta_f / T)
            if rng.rand() < prob_accept:
                x = new_x

    return best_x
