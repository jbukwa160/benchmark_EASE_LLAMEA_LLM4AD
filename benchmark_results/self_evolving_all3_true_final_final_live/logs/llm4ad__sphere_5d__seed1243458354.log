def algorithm(func, dim, lb, ub, budget, rng):
    best_solution = np.random.uniform(lb, ub, size=dim)
    best_value = func(best_solution)

    for _ in range(budget):
        # Generate a new candidate solution by perturbing the current best solution
        delta = np.zeros(dim)
        for i in range(dim):
            if rng.random() < 0.5:
                delta[i] = rng.uniform(-1, 1) * (ub - lb) / dim ** 2
            else:
                delta[i] = rng.uniform(-1, 1) * (ub - lb) / dim

        new_solution = best_solution + delta
        new_value = func(new_solution)

        # Update the best solution if the new candidate is better
        if new_value < best_value:
            best_solution = new_solution
            best_value = new_value

    return best_solution
