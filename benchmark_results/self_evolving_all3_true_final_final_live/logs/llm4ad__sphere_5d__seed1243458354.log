def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    best_value = float('inf')
    
    for _ in range(budget):
        x = np.clip(rng.uniform(lb, ub, size=dim), a_min=lb, a_max=ub)
        
        if func(x) < best_value:
            best_value = func(x)
            best = x.copy()
            
    return best
