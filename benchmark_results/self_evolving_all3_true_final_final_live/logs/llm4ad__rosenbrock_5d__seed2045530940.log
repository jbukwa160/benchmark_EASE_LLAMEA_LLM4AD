def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    x_best = 0.5 * (ub + lb) + 0.1 * rng.uniform(-1, 1, size=dim)
    cov_mat = np.eye(dim) * 10
    for _ in range(budget):
        candidates = x_best + rng.normal(size=(10000, dim))
        for i in range(dim):
            candidates[:, i] *= (ub[i] - lb[i]) / np.std(candidates[:, i])
            candidates[:, i] += lb[i]
        candidates = np.clip(candidates, a_min=lb, a_max=ub)
        scores = evaluate(candidates)
        idx_best = np.argmax(scores)
        if scores[idx_best] < evaluate(x_best):
            x_best = candidates[idx_best]
        scores -= np.max(scores)
        cov_mat = 0.1 * (np.eye(dim) - np.dot(np.dot(cov_mat, candidates.T), candidates)) + \
                  0.9 * np.dot(np.dot(cov_mat, candidates.T), candidates)
    return x_best
