def algorithm(func, dim, lb, ub, budget, rng):
    def sample_gp(gp, x, y, sigma):
        cov = gp.covariance(x.reshape(1, -1), x)
        mean = gp.mean(x)
        cov_inv = np.linalg.inv(cov + sigma ** 2 * np.eye(dim))
        return (y - mean) @ cov_inv

    def lip_trust_region(gp, x, y, lb, ub, sigma):
        cov = gp.covariance(x.reshape(1, -1), x)
        lip_const = 0.01
        return (x > lb).all() and (x < ub).all() and np.linalg.norm(sample_gp(gp, x, y, sigma)) <= lip_const * np.sqrt(dim)

    def optimize_gp(gp, dim, budget, rng):
        X = rng.uniform(lb, ub, size=(budget, dim))
        Y = func(X)
        gp.fit(X, Y)
        best_x = None
        best_y = float('inf')
        for i in range(budget):
            x = np.random.normal(gp.mean(np.array([X[i]])), gp.coviance(np.array([[0]]), X[i]))
            if lip_trust_region(gp, x, func(x), lb, ub, 1e-6) and func(x) < best_y:
                best_x = x
                best_y = func(x)
        return best_x

    def optimize_lip(dim, budget, rng):
        x = np.zeros((dim,))
        for _ in range(budget):
            sigma = 10 ** (np.random.uniform(-2, -1))
            gp = GaussianProcess(theta=1e-6, kernel='squared_exponential')
            gp.fit(x.reshape(1, -1), func(x))
            x += np.random.normal(gp.mean(np.array([x])), sigma * gp.coviance(np.array([[0]]), x))
        return x

    best_x = optimize_lip(dim, budget // 2, rng)
    best_gp = GaussianProcess(theta=1e-6, kernel='squared_exponential')
    best_gp.fit(best_x.reshape(1, -1), func(best_x))
    for _ in range(budget // 2):
        x = np.random.normal(best_gp.mean(np.array([best_x])), 10 ** (np.random.uniform(-2, -1)) * best_gp.coviance(np.array([[0]]), best_x))
        if lip_trust_region(best_gp, x, func(x), lb, ub, 1e-6) and func(x) < func(best_x):
            best_x = x
    return np.clip(best_x, lb, ub)
