def algorithm(func, dim, lb, ub, budget, rng):
    def eval(x):
        return func(x)

    pop_size = int(np.sqrt(budget))
    n_gen = int(budget / pop_size)
    population = np.random.uniform(lb, ub, (pop_size, dim))

    for gen in range(n_gen):
        fitness = [eval(x) for x in population]
        parents = np.argsort(fitness)[:int(pop_size/2)]
        
        new_population = np.zeros((pop_size, dim))
        for i in range(0, pop_size, 2):
            p1, p2 = population[parents[i]], population[parents[i+1]]
            if rng.random() < 0.5:
                child = p1
                for j in range(dim):
                    if rng.random() < 0.5:
                        child[j] = (p1[j] + p2[j]) / 2 + rng.uniform(-ub, ub)
                    else:
                        child[j] = p1[j]
            else:
                child = p2
                for j in range(dim):
                    if rng.random() < 0.5:
                        child[j] = (p1[j] + p2[j]) / 2 + rng.uniform(-ub, ub)
                    else:
                        child[j] = p2[j]
            new_population[i] = np.clip(child, lb, ub)
            if i+1 < pop_size:
                new_population[i+1] = population[parents[i+1]]
        
        # Mutation
        for i in range(pop_size):
            for j in range(dim):
                if rng.random() < 0.01:
                    new_population[i][j] += rng.uniform(-ub, ub)
        
        population = np.clip(new_population, lb, ub)

    best_x = population[np.argmin([eval(x) for x in population])]
    return best_x
