def algorithm(func, dim, lb, ub, budget, rng):
    def rand_01():
        return rng.uniform(0, 1)

    def clip(x, lb, ub):
        return np.maximum(np.minimum(x, ub), lb)

    population_size = int(budget * 0.2)
    pop = np.random.rand(population_size, dim) * (ub - lb) + lb
    pop_f = np.array([func(x) for x in pop])

    best = np.inf
    best_x = None

    for i in range(int(budget)):
        parents = np.argsort(pop_f)[:population_size // 2]
        offspring = []
        for j in range(population_size):
            if j % 2 == 0:
                u = np.random.choice(parents)
                v = np.random.choice(np.setdiff1d(range(population_size), u))
                x = clip(0.5 * pop[u] + 0.5 * pop[v] + rand_01() * (pop[v] - pop[u]), lb, ub)
            else:
                u = np.random.choice(parents)
                x = clip(pop[u] + rand_01() * (ub - lb), lb, ub)
            offspring.append(x)

        offspring_f = np.array([func(x) for x in np.array(offspring)])
        pop_f = np.minimum(offspring_f, pop_f)

        if i % 100 == 0:
            current_best = np.min(pop_f)
            if current_best < best:
                best = current_best
                best_x = pop[np.argmin(pop_f)]
            print(f"Iteration {i}, Best: {best}")

    return best_x
