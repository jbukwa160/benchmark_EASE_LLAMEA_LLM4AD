def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 0.5 * (ub - lb)
    mean = np.zeros(dim)
    cov = np.eye(dim) * sigma ** 2
    best_x = np.zeros(dim)
    best_y = float('inf')

    for _ in range(budget):
        x = rng.normal(mean, cov).clip(lb, ub)
        y = func(x)
        
        if y < best_y:
            best_y = y
            best_x = x
        
        sigma_new = 0.5 * (ub - lb) + 0.1 * np.sqrt(np.diag(cov))
        cov_new = cov * 0.9 + 0.1 * rng.normal(0, 1, size=(dim, dim))[:, None] @ rng.normal(0, 1, size=(1, dim))
        
        for i in range(dim):
            if np.diag(cov)[i] < sigma_new[i]:
                cov[i, i] = sigma_new[i]
    
    return best_x
