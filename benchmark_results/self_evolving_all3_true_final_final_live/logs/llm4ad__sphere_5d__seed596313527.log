def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    step_size = 1.0
    for _ in range(budget):
        new_x = best_x + step_size * rng.randn(dim)
        new_x = np.clip(new_x, lb, ub)
        if func(new_x) < func(best_x):
            best_x = new_x
        if budget % 10 == 0:
            step_size *= 0.9
    return best_x
