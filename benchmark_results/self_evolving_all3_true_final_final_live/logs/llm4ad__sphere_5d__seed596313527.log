def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    best_val = float('inf')
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        v = np.zeros(dim)
        for t in range(1000):
            g = func(x)
            if g < best_val:
                best_val = g
                best = x.copy()
            v = 0.9 * v - 0.1 * rng.uniform(-1, 1, size=dim) + rng.uniform(-1, 1, size=dim)
            x += v / np.sqrt(t + 1)
            for i in range(dim):
                if x[i] < lb:
                    x[i] = lb
                elif x[i] > ub:
                    x[i] = ub
    return best
