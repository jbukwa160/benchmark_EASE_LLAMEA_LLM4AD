def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 1.0
    best_sol = np.zeros(dim)
    best_val = float('inf')
    
    for i in range(budget):
        sol = best_sol + rng.normal(size=dim) * sigma
        sol = np.clip(sol, lb, ub)
        
        val = func(sol)
        if val < best_val:
            best_val = val
            best_sol = sol
            
        sigma *= 0.99  # decay the step size
    
    return best_sol
