def algorithm(func, dim, lb, ub, budget, rng):
    N = 100
    lambda_ = int(N ** (1 / 4))
    mu = lambda_ // 2
    sigma0 = 10.0
    x_best = np.zeros(dim)
    c = np.eye(dim) * sigma0 ** 2

    for i in range(budget):
        if rng.uniform(0, 1) < 0.5:
            x = x_best + np.random.normal(size=(N, dim))
            x /= np.linalg.norm(x, axis=1)[:, None]
        else:
            x = x_best + np.random.normal(size=(lambda_, dim)) * sigma0

        # Bound handling
        for j in range(dim):
            x[:, j] = np.clip(x[:, j], lb, ub)

        z = np.zeros((N, dim))
        for j in range(N - lambda_):
            z[j, :] = func(x[j, :])

        if N - lambda_ > 1:
            y = np.mean(z[:N - lambda_, :], axis=0)
        else:
            y = z[0]

        x_best_new = x_best
        for j in range(lambda_):
            x_j = func(x[j, :])
            if x_j < y:
                x_best_new = x[j]
                y = x_j

        # Covariance matrix adaptation
        d = x_best - x_best_new
        c += 1 / (N * (N - lambda_)) * np.outer(d, d) + 0.01 * sigma0 ** 2 * np.eye(dim)
        if rng.uniform(0, 1) < 0.5:
            sigma = np.sqrt(np.diag(c))
        else:
            sigma = sigma0

        x_best = x_best_new

    return x_best
