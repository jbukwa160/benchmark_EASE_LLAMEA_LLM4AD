def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_mutated = x_best + (ub - lb) * np.clip(rng.randn(dim), -1, 1)
        f_mutated = func(np.clip(x_mutated, lb, ub))

        if f_mutated < f_best:
            x_best = x_mutated
            f_best = f_mutated

    return x_best
