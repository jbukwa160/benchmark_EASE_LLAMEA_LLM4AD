def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(-5.0, 5.0, size=dim)
    learning_rate = 1.0 / (2 * rng ** 2)
    
    for _ in range(budget):
        candidate = clip(x + learning_rate * rng.randn(dim))
        
        if func(candidate) < func(clip(x)):
            x = candidate
            
    return clip(x)
