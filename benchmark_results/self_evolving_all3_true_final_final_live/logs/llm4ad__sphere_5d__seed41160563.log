def algorithm(func, dim, lb, ub, budget, rng):
    def sample(rng):
        return rng.randn(dim)

    def accept(x):
        x = np.clip(x, lb, ub)
        y = func(x)
        if y < best[1]:
            best = (x, y)
        return y

    best = ((np.zeros(dim), 0))
    accepted_count = 0
    total_count = 0

    for _ in range(budget):
        x = sample(rng)
        y = accept(x)
        accepted_count += int(y < best[1])
        total_count += 1
        if total_count > 1:
            acceptance_rate = accepted_count / (total_count - 1)
            step_size = np.sqrt(2 * np.log(total_count) / (dim * dim))
            rng.normal.loc += rng.randn() * step_size

    return best[0]
