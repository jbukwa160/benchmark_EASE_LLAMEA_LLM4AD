def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, (1, dim))
    f_best = func(x_best)
    step_size = 2 * (ub - lb) / np.sqrt(10 + dim)

    for i in range(budget):
        if i % 10 == 0:
            step_size /= 2

        x_candidate = x_best + rng.uniform(-step_size, step_size, (1, dim))
        f_candidate = func(np.clip(x_candidate, lb, ub))

        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate

    return np.clip(x_best, lb, ub)
