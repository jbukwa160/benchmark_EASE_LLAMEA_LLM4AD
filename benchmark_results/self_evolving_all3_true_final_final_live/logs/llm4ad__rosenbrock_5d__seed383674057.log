def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(np.clip(x, lb, ub))

    x = rng.uniform(lb, ub, size=dim)
    sigma = 0.5 * (ub - lb) / 2
    mu = np.zeros(dim)

    cm = np.eye(dim)
    pc = np.ones((1, dim))
    dc = 10**(-3)

    for _ in range(budget):
        z = rng.normal(size=dim)
        y = z + mu
        step_size = sigma * (pc[0] - 1) ** 2 / np.sqrt(np.sum(z ** 2))

        new_x = x + y * step_size

        new_f = f(new_x)

        if new_f < f(x):
            x = new_x
            cm = (1 - dc) * cm + dc * y @ z
            pc[0] *= 1 + 1 / dim
            mu += y * step_size
        else:
            cm = (1 - dc) * cm + dc * np.outer(z, z)
            pc[0] /= 1 + 1 / dim

    return x
