def algorithm(func, dim, lb, ub, budget, rng):
    def bounded_candidate(bounds, candidate):
        return np.clip(candidate, bounds[0], bounds[1])

    def objective(x):
        return func(x)

    population_size = 10 * dim
    candidates = np.random.uniform(lb, ub, (population_size, dim))
    best_solution = None

    for _ in range(budget):
        fitnesses = [objective(candidate) for candidate in candidates]
        sorted_indices = np.argsort(fitnesses)
        candidates = candidates[sorted_indices[:population_size]]

        if best_solution is None or objective(best_solution) > objective(candidates[-1]):
            best_solution = candidates[-1]

        parents = []
        for _ in range(population_size // 2):
            parent1, parent2 = rng.choice(candidates, 2, replace=False)
            child = (0.5 * parent1 + 0.3 * parent2) / np.linalg.norm(parent2 - parent1)
            candidates = np.append(candidates, bounded_candidate((lb, ub), child))

        fitnesses = [objective(candidate) for candidate in candidates]
        sorted_indices = np.argsort(fitnesses)
        candidates = candidates[sorted_indices[:population_size]]

    return best_solution
