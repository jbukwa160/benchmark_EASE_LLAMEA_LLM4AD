def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def cma_es(func, x0, dim, pop_size=50, max_iter=100, sigma=1.0):
        best_x = x0
        best_f = func(best_x)
        for i in range(max_iter):
            X = rng.normal(size=(pop_size, dim)) + x0
            f_X = func(clip(X, lb, ub))
            if np.all(f_X == 0):
                return clip(X[np.argmin(f_X)], lb, ub)
            best_i = np.argmin(f_X)
            if f_X[best_i] < best_f:
                best_x = X[best_i]
                best_f = f_X[best_i]
        return best_x

    def gradient_descent(func, x0, dim, max_iter=100, alpha=1e-4):
        best_x = x0
        for i in range(max_iter):
            g_x = np.array([2 * 200 * (x[i] - x[i-1]**2) * (x[i+1] - x[i-1]**2) + 2 * (x[i] - 1)
                            if i > 0 and i < dim else
                            2 * (x[i] - 1)
                            for i in range(dim)])
            x_new = clip(x0 - alpha * g_x, lb, ub)
            if func(x_new) < func(best_x):
                best_x = x_new
        return best_x

    x = cma_es(func, rng.uniform(size=dim), dim, pop_size=int(budget/10))
    x = gradient_descent(func, x, dim)
    return clip(x, lb, ub)
