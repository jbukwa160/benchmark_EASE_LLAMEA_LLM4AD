def algorithm(func, dim, lb, ub, budget, rng):
    def generate_neighbor(x, sigma):
        return x + np.random.normal(size=dim, loc=0, scale=sigma)

    def accept(new_x, new_cost, old_cost, temp):
        if new_cost < old_cost:
            return True
        else:
            return np.random.rand() < np.exp((old_cost - new_cost) / temp)

    best_x = rng.uniform(lb, ub, size=dim)
    best_cost = func(best_x)
    
    for i in range(budget):
        sigma = 0.1 + 2 * (i / budget)**(1/3)  # adaptively increase neighborhood size
        x = generate_neighbor(best_x, sigma)
        clipped_x = np.clip(x, lb, ub)
        
        cost = func(clipped_x)
        
        if cost < best_cost:
            best_x = clipped_x
            best_cost = cost
            
        temp = 0.01 * (1 + i / budget)  # adaptively decrease temperature
        if rng.rand() < np.exp((best_cost - cost) / temp):
            best_x = clipped_x
            best_cost = cost
            
    return best_x
