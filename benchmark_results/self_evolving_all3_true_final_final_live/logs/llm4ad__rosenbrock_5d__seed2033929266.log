def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_iterations = int(budget)
    
    # Initial design
    x_init = lb + (ub - lb) * rng.uniform(size=(D, n_iterations))
    
    # Surrogate model parameters
    nu = 2.0  # Nugget variance for the Gaussian process
    
    # Initialize arrays to store best solution and its objective value
    x_best = np.zeros((n_iterations,))
    f_best = np.full(n_iterations, np.inf)
    
    for i in range(1, n_iterations + 1):
        # Evaluate the objective function at some new points (exploration)
        x_new = lb + (ub - lb) * rng.uniform(size=(D, int(budget / D)))
        f_new = func(x_new)
        
        # Store the best solution found so far
        idx = np.argmin(f_best)
        if i == 1:
            x_best[idx] = x_init[idx]
            f_best[idx] = f_new[idx]
        else:
            if f_new.min() < f_best.min():
                min_idx = np.argmin(f_new)
                x_best[:i-1] = x_best[idx]
                f_best[:i-1] = f_best[idx]
                x_best[i-1] = x_new[min_idx]
                f_best[i-1] = f_new[min_idx]
        
        # Update the surrogate model
        alpha = 0.01  # Learning rate for the Gaussian process
        
        X = np.vstack((x_init, x_best[:i]))
        y = np.hstack((func(x_init), f_best[:i]))
        
        K = nu * np.eye(X.shape[0]) + alpha * np.exp(-np.sum((X[:, None] - X[None, :])**2, axis=2))
        L = np.linalg.cholesky(K)
        
        # Compute the acquisition function (clipped entropy search)
        mu = np.dot(np.dot(L.T, np.linalg.solve(L @ L.T, y)), L)
        sigma_sq = nu + alpha * np.exp(-np.sum((X[:, None] - X[None, :])**2, axis=2))
        
        f_acq = - (mu[i-1] + (erfinv(2*rng.uniform(size=i)) / np.sqrt(np.pi)) * np.sqrt(sigma_sq[i-1]))
        
        # Compute the clipped acquisition function
        x_clip = lb + (ub - lb) * rng.uniform(size=(D,))
        f_clip = func(x_clip)
        
        if f_acq > f_clip:
            x_best[i-1] = x_clip
            f_best[i-1] = f_clip
        else:
            # Sample from the surrogate model
            mu_sample = np.dot(np.dot(L.T, np.linalg.solve(L @ L.T, y)), L)
            sigma_sq_sample = nu + alpha * np.exp(-np.sum((X[:, None] - X[None, :])**2, axis=2))
            
            z = rng.normal(size=D)
            x_new = X[i-1] + mu_sample[i-1] / np.sqrt(sigma_sq_sample[i-1]) * z
            f_new = func(x_new)
            
            # Update the surrogate model and best solution
            idx = np.argmin(f_best)
            if f_new < f_best[idx]:
                x_best[idx] = x_new
                f_best[idx] = f_new
                
    return x_best[np.argmin(f_best)]
