def algorithm(func, dim, lb, ub, budget, rng):
    n = 0
    pop_size = 1
    sigma = 5.0
    lambda_ = int(np.ceil(4 * dim ** (1 + 1 / dim)))
    mu = 2
    c_1 = 0.8
    c_m = 2
    c_c = 0.8
    d = 1 + 1 / dim
    a_init = 0.5
    sigma_decay_rate = 0.9999

    best_x = rng.uniform(lb, ub, (dim,))
    best_f_x = func(best_x)
    f_x_values = [best_f_x]

    while n < budget:
        for _ in range(lambda_):
            x_new = np.clip(np.array(rng.normal(loc=best_x, scale=sigma, size=(dim,)), dtype=float) + best_x, lb, ub)
            f_x = func(x_new)

            if f_x < best_f_x:
                best_x = x_new
                best_f_x = f_x

        sigma *= (1 - sigma_decay_rate)
        pop_size += 1
        a = np.log(pop_size) + d * np.log(np.log(pop_size))
        a *= a_init
        if n % 100 == 0:
            print(f"n: {n}, best_f_x: {best_f_x}")
        n += 1

    return best_x
