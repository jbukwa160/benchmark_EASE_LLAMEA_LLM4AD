def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    for _ in range(budget):
        i = np.random.choice(dim, size=min(5, dim), replace=False)
        x_new = x.copy()
        for j in i:
            x_new[j] += 2 * (rng.rand() - 0.5)
        x_new = np.clip(x_new, lb, ub)
        if func(x_new) < func(x):
            x = x_new
    return x
