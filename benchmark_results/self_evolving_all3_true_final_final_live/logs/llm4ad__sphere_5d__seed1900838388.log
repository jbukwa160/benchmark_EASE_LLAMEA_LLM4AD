def algorithm(func, dim, lb, ub, budget, rng):
    def generate_population(budget):
        population = np.zeros((budget, dim))
        for i in range(budget):
            candidate = lb + (ub - lb) * rng.rand(dim)
            population[i] = candidate
        return population

    def differential_evolution(population, func, budget, dim, lb, ub):
        for _ in range(1000):  # Set a maximum number of generations
            for i in range(budget):
                r1, r2, r3 = rng.choice(range(budget), size=3, replace=False)
                mutant_vector = population[r1] + 0.5 * (population[r2] - population[r3])
                trial_candidate = mutant_vector + 0.5 * (population[i] - population[rng.choice(range(budget))])
                for j in range(dim):
                    if rng.rand() < 0.5:
                        trial_candidate[j] += 0.1 * (ub - lb) * rng.randn()
                        trial_candidate[j] = max(lb, min(ub, trial_candidate[j]))
                population[i] = np.where(trial_candidate < population[rng.choice(range(budget))], trial_candidate, population[i])
        return population

    def simplex_local_search(population, func, budget, dim):
        for i in range(budget):
            candidate = population[i]
            best_neighbor = candidate
            improvement = 0.1
            while improvement > 1e-6:
                r = rng.choice(range(budget), size=dim, replace=False)
                neighbor = candidate + improvement * (population[r].sum(axis=0) - candidate)
                for j in range(dim):
                    neighbor[j] = max(lb, min(ub, neighbor[j]))
                if func(neighbor) < func(candidate):
                    best_neighbor = neighbor
                    improvement *= 1.5
            population[i] = best_neighbor

    def clip_candidates(population, lb, ub):
        return np.clip(population, a_min=lb, a_max=ub)

    population = generate_population(budget)
    population = differential_evolution(population, func, budget, dim, lb, ub)
    simplex_local_search(population, func, budget, dim)
    best_candidate = clip_candidates(population, lb, ub)[np.argmin([func(candidate) for candidate in population])]
    return best_candidate
