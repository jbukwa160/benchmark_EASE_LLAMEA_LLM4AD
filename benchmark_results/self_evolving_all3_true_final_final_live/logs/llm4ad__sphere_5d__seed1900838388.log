def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(x):
        return np.minimum(np.maximum(x, lb), ub)

    n = len(lb)
    sigma = 0.5 * (ub - lb) / 2.0
    mu = np.zeros(n)
    p = 1.0 / n
    c1 = 0.5 + 1.9 * np.exp(-p * budget)
    c_mu = 2.0 - c1

    X = sigma * rng.normal(size=(n, budget))
    for _ in range(budget):
        x_old = mu
        X += sigma * rng.normal(size=(n, budget))[:, None]
        x_new = clip_candidate(mu + np.sum(X, axis=1) / (2.0 * budget))

        if func(x_new) < func(x_old):
            mu = x_new
        else:
            mu = c_mu * mu + c1 * x_old

    return mu
