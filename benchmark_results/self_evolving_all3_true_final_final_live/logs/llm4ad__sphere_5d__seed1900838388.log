def algorithm(func, dim, lb, ub, budget, rng):
    def func_wrap(x):
        if any(xi < lb or xi > ub for xi in x):
            return 1e10
        else:
            return func(x)

    best_x = None
    best_f = float('inf')
    population_size = int(budget / (dim * np.log(budget) + dim))

    for _ in range(population_size):
        x = rng.normal(size=dim)
        f = func_wrap(x)

        if f < best_f:
            best_f = f
            best_x = x

    return best_x
