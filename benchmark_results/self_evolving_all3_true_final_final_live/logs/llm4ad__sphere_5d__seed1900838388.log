def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_cand = x_best + np.random.normal(size=dim) * 0.1
        for i in range(dim):
            if x_cand[i] < lb:
                x_cand[i] = lb
            elif x_cand[i] > ub:
                x_cand[i] = ub

        f_cand = func(x_cand)
        if f_cand < f_best:
            x_best = x_cand
            f_best = f_cand

    return x_best
