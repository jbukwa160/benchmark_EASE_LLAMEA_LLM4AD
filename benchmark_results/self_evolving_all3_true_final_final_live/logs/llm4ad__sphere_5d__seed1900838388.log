def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_candidate = np.random.uniform(lb, ub, size=dim)
    current_solution = func(clip(best_candidate))
    current_best = current_solution
    temperature = 1.0

    for i in range(budget):
        new_candidate = clip(current_best + rng.normal(size=dim) * (ub - lb))
        new_solution = func(new_candidate)

        if new_solution < current_solution:
            current_solution = new_solution
            current_best = new_candidate
        else:
            delta = new_solution - current_solution
            accept_probability = np.exp(-delta / temperature)
            random_number = rng.uniform(0, 1)

            if random_number < accept_probability:
                current_solution = new_solution
                current_best = new_candidate

        temperature *= 0.99

    return clip(current_best)
