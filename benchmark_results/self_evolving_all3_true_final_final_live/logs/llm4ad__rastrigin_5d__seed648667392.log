def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    bounds = [(lb, ub) for _ in range(dim)]
    result_de = differential_evolution(objective, bounds)
    
    x0 = result_de.x
    res_ls = minimize(lambda x: -objective(x), x0, method="SLSQP", bounds=bounds, options={"eps": 1e-7})
    
    if res_ls.fun > budget:
        return np.zeros(dim)
    else:
        return res_ls.x
