def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(n, dim, lb, ub):
        return np.random.uniform(lb, ub, size=(n, dim))

    def compute_fitness(x, func):
        return func(x)

    def clip_candidates(candidates, lb, ub):
        return np.clip(candidates, a_min=lb, a_max=ub)

    def simulated_annealing(population, temperature, budget):
        for _ in range(budget):
            indices = rng.permutation(len(population))
            new_population = population[indices]
            for i in range(len(population)):
                new_individual = np.copy(new_population[i])
                noise = rng.uniform(-1, 1, size=dim)
                new_individual += temperature * noise
                new_individual = clip_candidates(new_individual, lb, ub)
                if compute_fitness(new_individual) < compute_fitness(population[i]):
                    population[i] = new_individual
            temperature *= 0.99

    def differential_evolution(population):
        for _ in range(budget):
            indices = rng.permutation(len(population))
            new_population = np.copy(population)
            for i in range(len(population)):
                noise1, noise2, noise3 = rng.uniform(-1, 1, size=dim), rng.uniform(-1, 1, size=dim), rng.uniform(-1, 1, size=dim)
                new_individual = population[i] + noise1 * (population[indices[i]] - population[(i-1) % len(population)]) + \
                                 noise2 * (population[indices[i]] - population[(i+1) % len(population)]) + \
                                 noise3 * (population[(i-2) % len(population)] - population[(i+2) % len(population)])
                new_individual = clip_candidates(new_individual, lb, ub)
                if compute_fitness(new_individual) < compute_fitness(population[i]):
                    population[i] = new_individual

    population = generate_initial_population(100, dim, lb, ub)
    temperature = 10.0
    simulated_annealing(population, temperature, budget // 2)

    differential_evolution(population)

    return population[np.argmin([compute_fitness(x) for x in population])]
