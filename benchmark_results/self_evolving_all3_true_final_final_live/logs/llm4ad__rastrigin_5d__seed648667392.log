def algorithm(func, dim, lb, ub, budget, rng):
    def rastrigin(x):
        return 10*dim + sum(i**2 - 10*np.cos(2*np.pi*i) for i in x)

    def clip(candidate):
        return [max(lb, min(ub, i)) for i in candidate]

    pop_size = int(budget ** (1 / dim))
    population = [[random.uniform(lb, ub) for _ in range(dim)] for _ in range(pop_size)]
    best_solution = None
    best_fitness = np.inf

    for generation in range(budget):
        fitnesses = [func(clip(x)) for x in population]
        fitness_dict = {x: f for (x, f) in zip(population, fitnesses)}

        # Select the best solution so far
        if min(fitnesses) < best_fitness:
            best_solution = population[fitnesses.index(min(fitnesses))]
            best_fitness = min(fitnesses)

        # Differential evolution
        new_population = []
        for _ in range(pop_size):
            idx1, idx2, idx3 = rng.sample(range(pop_size), 3)
            x1, x2, x3 = population[idx1], population[idx2], population[idx3]
            trial_solution = clip(np.array(x1) + 0.5 * (np.array(x2) - np.array(x3)) if random.random() > 0.5 else np.array(x1))

            # Mutation
            mutation_idx = rng.choice(dim)
            trial_solution[mutation_idx] += 0.05 * (rng.uniform(-ub, ub) - trial_solution[mutation_idx])

            new_population.append(trial_solution)

        population = new_population

    return best_solution
