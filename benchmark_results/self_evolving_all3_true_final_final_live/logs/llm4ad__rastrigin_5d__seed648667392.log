def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def generate_new_candidate(parent, sigma):
        return parent + rng.normal(size=dim) * sigma

    def evaluate_candidate(candidate):
        return func(candidate)

    population_size = 50
    initial_population = rng.uniform(lb, ub, size=(population_size, dim))
    population = [clip_candidate(individual, lb, ub) for individual in initial_population]
    best_individual = np.inf
    best_position = None

    for _ in range(budget):
        sigma = 0.1 / (2 + rng.uniform(0, 1))

        new_population = []
        for individual in population:
            candidate = generate_new_candidate(individual, sigma)
            new_population.append(clip_candidate(candidate, lb, ub))
            if evaluate_candidate(candidate) < best_individual:
                best_individual = evaluate_candidate(candidate)
                best_position = candidate

        population = new_population
        if rng.uniform(0, 1) > 0.9:
            for individual in population:
                sigma *= 1 + rng.uniform(-0.5, 0.5)

    return best_position
