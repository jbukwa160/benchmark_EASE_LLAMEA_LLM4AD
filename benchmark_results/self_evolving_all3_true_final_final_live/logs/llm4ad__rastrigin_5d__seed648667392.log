def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    pop_size = int(np.sqrt(budget))
    x = 5 * (ub - lb) * rng.rand(pop_size, dim) + lb
    y = func(x)
    best = np.min(y)

    for _ in range(budget):
        for i in range(pop_size):
            # Mutation
            v = x.copy()
            for j in range(dim):
                idx = (rng.randint(0, pop_size - 1), rng.randint(0, dim))
                if idx[0] == i or idx[1] == j:
                    continue
                v[i, j] += rng.uniform(-1, 1) * (v[idx[0], j] - x[i, j])

            # Selection
            v = clip(v)
            y_v = func(v)
            if np.min(y_v) < best:
                best = np.min(y_v)
                x[i] = v

    return x[np.argmin(func(x))]
