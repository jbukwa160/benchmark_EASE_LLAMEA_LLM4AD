def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    N = 10 + int(np.sqrt(budget))  # population size
    x = np.clip(rng.uniform(lb, ub, (N, D)), lb, ub)
    sigma = 1.0
    mean = np.zeros(D)

    for t in range(1, budget):
        f = func(x)
        fmin = np.min(f)
        argmin = np.argmin(f)
        x_min = x[argmin]

        if fmin < func(mean):
            mean = x_min

        cov = (np.outer((x - mean), (x - mean)) / N).astype(np.float64)
        H = np.linalg.cholesky(cov)

        for i in range(N):
            z = np.random.randn(D)
            y = mean + sigma * np.dot(H, z)
            y_clipped = np.clip(y, lb, ub)
            f_y = func(y_clipped)

            if f_y < fmin:
                x[i] = y_clipped
                f[i] = f_y

        x[argmin] = x_min

    return mean
