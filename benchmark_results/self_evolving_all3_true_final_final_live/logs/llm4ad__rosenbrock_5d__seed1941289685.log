    n = len(lb)
    x_best = np.zeros(n)
    best_func_value = 1e10
    D = 0.01 * (ub - lb)

    for i in range(budget):
        if i > 0:
            X = []
            Y = []
            for j in range(i):
                X.append(x_best[j])
                Y.append(func(X[-1]))
            gp = GaussianProcessRegression(X, Y)
            mu, var = gp.predict(np.array([x_best]).T)

        x_new = np.clip(x_best + 0.5 * D * rng.normal(size=n), lb, ub)
        x_new = np.clip(x_new + 0.2 * (ub - lb) * rng.uniform(size=n), lb, ub)

        f_x_new = func(x_new)

        if f_x_new < best_func_value:
            x_best[i] = x_new
            best_func_value = f_x_new

    return x_best
