def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lower, upper):
        return np.maximum(np.minimum(candidate, upper), lower)

    def init_population(npop, dim, lb, ub):
        population = np.random.rand(npop, dim)
        for i in range(npop):
            population[i] = clip(population[i], lb, ub)
        return population

    def momentum_update(momentum, temperature, cooling_rate):
        return max(0.1 * temperature, 0.9 * momentum + 0.1 * (temperature - cooling_rate))

    def sa_step(candidate, current_best, func, temperature, momentum, rng):
        noise = np.random.normal(size=candidate.shape)
        new_candidate = candidate + noise
        new_candidate = clip(new_candidate, lb, ub)
        new_cost = func(new_candidate)
        if new_cost < func(current_best):
            return new_candidate, new_cost
        else:
            acceptance_prob = np.exp((func(current_best) - new_cost) / temperature)
            if rng.random() < acceptance_prob:
                return new_candidate, new_cost
            else:
                return current_best, func(current_best)

    def de_step(population, best_individual, func, dim, lb, ub, rng):
        target = best_individual + 0.1 * np.random.normal(size=dim)
        target = clip(target, lb, ub)
        trial_population = population + 0.5 * (target - population) / np.linalg.norm(target - population, axis=1, keepdims=True)
        trial_population = clip(trial_population, lb, ub)
        new_best_individual = best_individual
        for individual in trial_population:
            if func(individual) < func(new_best_individual):
                new_best_individual = individual
        return new_best_individual

    npop = 100
    ngen = budget // (npop * dim)
    momentum = 0.5
    temperature = 10
    cooling_rate = 1
    population = init_population(npop, dim, lb, ub)

    for gen in range(ngen):
        for i in range(npop):
            current_best = population[i]
            new_individual, _ = sa_step(current_best, current_best, func, temperature, momentum, rng)
            population[i] = new_individual
            if func(new_individual) < func(current_best):
                current_best = new_individual

        best_individual = np.zeros(dim)
        for individual in population:
            if func(individual) < func(best_individual):
                best_individual = individual
        new_best_individual = de_step(population, best_individual, func, dim, lb, ub, rng)

        momentum = momentum_update(momentum, temperature, cooling_rate)

    return best_individual
