def algorithm(func, dim, lb, ub, budget, rng):
    def rosenbrock(x):
        return func(np.array([1 - x[0]**2, 100 * (x[1] - x[0]**2)**2]))

    def objective(x):
        return func(x)

    # Initialize CMA-ES
    mu = np.mean(rng.uniform(lb, ub, size=(dim,)))
    sigma = 10.0
    c_c = (1 + np.sqrt(5)) / 3
    sigma_history = [sigma]
    best_x = mu.copy()
    best_obj = objective(best_x)
    budget_used = 0

    for _ in range(budget):
        # CMA-ES update
        x, sigma = cma_es(mu, sigma, lb, ub)

        # Evaluate new candidate
        obj = objective(x)
        budget_used += 1

        if obj < best_obj:
            best_x = x.copy()
            best_obj = obj

        # Simulated Annealing phase to adapt to local optima
        temperature = 0.9 * np.mean(sigma_history) + 0.1 * (ub - lb)
        sigma = cma_es(mu, temperature, lb, ub)

        # Evaluate new candidate with SA temperature
        obj_sa = objective(x)
        budget_used += 1

        if obj_sa < best_obj:
            best_x = x.copy()
            best_obj = obj_sa

        # Update sigma history for CMA-ES adaptation
        sigma_history.append(sigma)

    return best_x
