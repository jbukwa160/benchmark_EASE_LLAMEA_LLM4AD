def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.ceil(dim * 2 + 1))
    pop = np.random.uniform(lb, ub, (pop_size, dim))

    for _ in range(budget):
        candidates = np.copy(pop)
        fit_values = func(candidates)

        idx_best = np.argmin(fit_values)
        best_candidate = candidates[idx_best]

        for i in range(pop_size):
            diff = rng.normal(0, 1, dim)
            candidate = pop[i] + 0.5 * diff
            candidate = np.clip(candidate, lb, ub)

            new_fit_value = func(candidate)
            if new_fit_value < fit_values[i]:
                candidates[i] = candidate
                fit_values[i] = new_fit_value

        pop = np.copy(candidates)

    idx_best = np.argmin(func(pop))
    return pop[idx_best]
