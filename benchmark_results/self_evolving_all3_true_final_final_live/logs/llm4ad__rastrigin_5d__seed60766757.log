def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def perturb(candidate):
        return candidate + 0.1 * (ub - lb) * (rng.uniform(size=dim) - 0.5)

    current_solution = rng.uniform(size=dim)
    current_fitness = func(current_solution)
    best_solution = clip(current_solution)
    best_fitness = func(best_solution)

    T_max = 100
    cooling_rate = 0.99

    for _ in range(budget):
        candidate = perturb(clip(current_solution))
        candidate_fitness = func(candidate)

        if candidate_fitness < current_fitness:
            current_solution = candidate
            current_fitness = candidate_fitness
            best_solution = clip(current_solution)
            best_fitness = func(best_solution)
        else:
            delta = current_fitness - candidate_fitness
            T = max(T_max - _ // 100, 1e-6)

            if rng.uniform() < np.exp(-delta / T):
                current_solution = candidate
                current_fitness = candidate_fitness

    return best_solution
