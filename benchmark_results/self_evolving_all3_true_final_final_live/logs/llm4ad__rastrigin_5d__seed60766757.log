def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    best_f = func(x)

    step_size = 1.0 / (func(best_x) ** 0.5)

    for _ in range(budget):
        new_x = np.clip(x + step_size * rng.randn(dim), lb, ub)
        new_f = func(new_x)
        
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f
            step_size *= 0.9
        
        x = np.random.choice([x, new_x], size=1)[0]

    return best_x
