def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    D = rng.uniform(0, 1)  # initial population size
    pop_size = int(D * dim)
    npop = 50  # number of populations for diversity preservation
    pbest = np.random.uniform(lb, ub, (pop_size, dim))
    gbest = np.zeros(dim)

    for _ in range(budget):
        x1 = rng.choice(pbest, pop_size, replace=False)  # select parent individuals
        v = np.zeros((pop_size, dim))  # initialize offspring population

        for i in range(pop_size):
            v[i] = clip(x1[i] + rng.uniform(-1, 1) * (x1[i] - pbest[rng.randint(0, pop_size), :]))
            f_v = func(v[i])

        if _ % npop == 0:
            # preserve diversity by updating the population
            pbest = x1.copy()
            gbest = clip(gbest + rng.uniform(-1, 1) * (gbest - v[rng.randint(0, pop_size)]))

        for i in range(pop_size):
            f_v_i = func(v[i])
            if f_v_i < func(pbest[i]):
                pbest[i] = v[i]
                gbest = clip(gbest + rng.uniform(-1, 1) * (gbest - pbest[i]))

    return clip(gbest)
