def algorithm(func, dim, lb, ub, budget, rng):
    D = 0.5 * (ub - lb)
    X = np.random.uniform(lb, ub, size=(budget, dim))
    F = rng.rand(budget) / 2 + 0.4
    CR = rng.rand(budget) / 2 + 0.1

    for i in range(1, budget):
        U = np.zeros((dim,))
        for j in range(dim):
            idx = (rng.randint(i - 1) + np.arange(i)) % i
            U[j] = F[i] * X[idx, j] + (1 - F[i]) * rng.normal(size=1)[0]

        for k in range(budget):
            if rng.rand() < CR[k]:
                X[k] = np.where(rng.rand(dim) < 0.5,
                    np.clip(U + rng.uniform(-D, D), lb, ub),
                    np.clip(X[i-1], lb, ub))

    return np.argmin(np.array([func(x) for x in X]), axis=0)
