def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = 2
    NP = int(np.floor(budget / (1 + D)))
    X = np.random.uniform(lb, ub, size=(NP, dim))
    Y = func(X)
    gbest = [np.inf] * dim
    t = 0

    while t < budget:
        for i in range(NP):
            idx = rng.choice(range(NP), replace=False, size=D-1)
            Xp = np.copy(X[i])
            for j in range(D-1):
                f = Y[idx[j]] + np.random.normal(0, 0.1)
                if f < Y[i]:
                    r = rng.uniform(0, 1)
                    Xp = clip(lb + r * (X[i] - lb) + (ub - lb) * rng.uniform(0, 1))
                    Yp = func(Xp)
                    if Yp < Y[i]:
                        X[i] = Xp
                        Y[i] = Yp
            if Y[i] < Y[gbest[0]]:
                gbest = clip(np.copy(X[i]))
        t += 1

    return np.array(gbest)
