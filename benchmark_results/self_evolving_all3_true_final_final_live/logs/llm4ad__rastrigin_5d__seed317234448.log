def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        v = x + 0.1 * rng.normal(size=dim)
        v = np.clip(v, lb, ub)
        f_v = func(v)

        if f_v < best_f:
            best_f = f_v
            best_x = v.copy()

        p = rng.uniform(0, 1)
        delta_f = f_v - best_f
        if (delta_f > 0 and p < np.exp(-delta_f / 10)) or delta_f <= 0:
            x = v

    return best_x
