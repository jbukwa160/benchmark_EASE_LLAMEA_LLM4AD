def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.array([0] * dim)
    best_x = x.copy()
    min_val = func(best_x)
    
    for _ in range(budget):
        perturb = 0.01 * rng.normal(size=dim)
        new_x = clip(x + perturb)
        
        delta = func(new_x) - func(x)
        if delta < 0 or (delta >= 0 and np.random.rand() < np.exp(-delta / min_val)):
            x = new_x
            best_x = new_x.copy()
            
    return best_x
