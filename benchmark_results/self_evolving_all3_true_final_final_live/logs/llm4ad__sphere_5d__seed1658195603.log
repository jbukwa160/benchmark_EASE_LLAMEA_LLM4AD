def algorithm(func, dim, lb, ub, budget, rng):
    best = np.full(dim, 0)
    best_f = float('inf')
    
    for _ in range(budget):
        x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best = x
            
        step_size = 0.5 * (ub - lb) / rng.randint(1, 10)
        noise = np.array([rng.uniform(-step_size, step_size) for _ in range(dim)])
        
        next_x = np.clip(best + noise, lb, ub)
        
        f = func(next_x)
        
        if f < best_f:
            best_f = f
            best = next_x
            
    return best
