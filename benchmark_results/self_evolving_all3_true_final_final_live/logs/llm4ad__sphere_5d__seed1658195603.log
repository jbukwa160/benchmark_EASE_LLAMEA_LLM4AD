def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    sigma = 1.0
    mu = np.zeros(dim)
    cov = np.eye(dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = np.random.multivariate_normal(mu, cov * (sigma ** 2), size=dim)
        z = clip(y + x, lb, ub)
        f_z = func(z)
        
        if f_z < best_f:
            best_x = z
            best_f = f_z
        
        delta = z - x
        numerator = np.dot(delta, (func(z) - func(x)) * delta)
        denominator = 1 + np.linalg.norm(delta) ** 2
        cov += numerator / denominator * np.outer(delta, delta)
        
        sigma *= 1.1 if func(z) < func(x) else 0.9

    return best_x
