def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    f_best = np.inf
    for i in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        f_x = func(x)
        if f_x < f_best:
            f_best = f_x
            x_best = x
        learning_rate = 1 / (i + 1) * np.exp(0.5 - (f_best + 1e-6))
        step_size = learning_rate * rng.uniform(-1, 1, size=dim)
        x_new = x_best + step_size
        x_new = np.clip(x_new, lb, ub)
        f_x_new = func(x_new)
        if f_x_new < f_best:
            f_best = f_x_new
            x_best = x_new
    return x_best
