def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    current_f = best_f
    T = 1.0

    for _ in range(budget):
        new_x = clip(best_x + rng.normal(0, 1e-3, size=dim))
        new_f = func(new_x)

        if new_f < current_f:
            current_f = new_f
            best_f = min(best_f, new_f)
            best_x = new_x

        elif np.exp(- (new_f - current_f) / T) > rng.random():
            current_f = new_f
            best_f = min(best_f, new_f)
            best_x = new_x

        T *= 0.9995  # adaptive cooling schedule

    return best_x
