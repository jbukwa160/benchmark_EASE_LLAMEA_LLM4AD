def algorithm(func, dim, lb, ub, budget, rng):
    def get_bounds():
        return [lb] * dim, [ub] * dim

    def clip(x):
        return np.clip(x, lb, ub)

    def func_wrapper(x):
        x = clip(x)
        return func(x), 0.0  # objective value and gradient are not used in this problem

    pop_size = int(np.ceil(1 + np.sqrt(dim)))
    n_gen = budget // pop_size
    mu = (ub - lb) * rng.rand(pop_size, dim)

    for _ in range(n_gen):
        _, cov = cmaes(func_wrapper, mu, get_bounds)
        mu = clip(cov @ np.random.normal(size=(1, dim)))

    return clip(mu)
