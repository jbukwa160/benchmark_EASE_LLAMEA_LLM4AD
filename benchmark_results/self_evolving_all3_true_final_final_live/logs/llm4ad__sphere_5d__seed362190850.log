def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    def objective(x):
        return func(clip(x))

    x_mean = np.zeros(dim)
    cov = 1.0 * np.eye(dim)
    lambda_ = int(rng.uniform(10, dim + 2))  # random population size
    mu = lambda_ / dim

    for i in range(budget):
        y = rng.randn(lambda_, dim) + x_mean
        x = clip(y)

        f_x = objective(x)
        f_y = np.zeros(lambda_)
        for j in range(lambda_):
            f_y[j] = objective(clip(y[j]))

        cov = (1 - 2 / (dim + 3)) * cov + mu * np.dot((x - x_mean).T, x - x_mean) / lambda_
        x_mean = x_mean + (f_x - np.mean(f_y)) * cov @ rng.randn(dim)

    return clip(x_mean)
