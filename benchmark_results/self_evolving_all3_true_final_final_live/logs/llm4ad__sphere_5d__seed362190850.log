def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.ceil(budget / (2 * dim + 1)))
    
    def generate_candidates(pop_size):
        candidates = np.random.uniform(lb, ub, size=(pop_size, dim))
        return candidates
    
    def fitness(x):
        return func(x)
    
    def mutate(x, rng):
        mutation_rate = 0.01
        for i in range(dim):
            if rng.random() < mutation_rate:
                x[i] += rng.uniform(-1, 1) * (ub - lb)
                x[i] = np.clip(x[i], lb, ub)
        return x
    
    def crossover(x1, x2):
        crossover_prob = 0.9
        child = x1.copy()
        if rng.random() < crossover_prob:
            for i in range(dim):
                if rng.random() < 0.5:
                    child[i] = x2[i]
        return child
    
    def evolve(population, population_fitness, rng):
        new_population = []
        new_population_fitness = []
        
        while len(new_population) < pop_size:
            parent1_idx = np.argmax(np.array(population_fitness))
            parent2_idx = np.random.choice([i for i in range(len(population)) if i != parent1_idx])
            
            child = crossover(population[parent1_idx], population[parent2_idx])
            mutated_child = mutate(child, rng)
            new_population.append(mutated_child)
            new_population_fitness.append(fitness(mutated_child))
        
        return np.array(new_population), np.array(new_population_fitness)
    
    best_candidate = None
    best_fitness = float('inf')
    
    candidates = generate_candidates(pop_size)
    population = candidates.copy()
    population_fitness = [fitness(x) for x in candidates]
    
    for _ in range(budget):
        new_population, new_population_fitness = evolve(population, population_fitness, rng)
        
        if np.min(new_population_fitness) < best_fitness:
            best_candidate = new_population[np.argmin(new_population_fitness)]
            best_fitness = np.min(new_population_fitness)
            
        population = new_population
        population_fitness = new_population_fitness
    
    return best_candidate
