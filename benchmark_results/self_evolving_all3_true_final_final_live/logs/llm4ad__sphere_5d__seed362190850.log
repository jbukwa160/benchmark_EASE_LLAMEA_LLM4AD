def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 1000
    sigma = 2.0
    mu = np.random.uniform(lb, ub, size=(pop_size, dim))
    best_sol = np.zeros(dim)
    best_val = float('inf')

    for _ in range(budget):
        scores = np.array([func(x) for x in mu])
        indices = np.argsort(scores)[:int(pop_size/2)]
        mu[:] = mu[indices]
        
        for i in range(pop_size):
            new_sol = mu[i] + rng.normal(size=dim, loc=0.0, scale=sigma)
            new_sol = np.clip(new_sol, lb, ub)
            scores_new = func(new_sol)
            
            if scores_new < best_val:
                best_sol[:] = new_sol
                best_val = scores_new
            
            if rng.random() < 1/pop_size:
                mu[i] = new_sol
    
    return best_sol
