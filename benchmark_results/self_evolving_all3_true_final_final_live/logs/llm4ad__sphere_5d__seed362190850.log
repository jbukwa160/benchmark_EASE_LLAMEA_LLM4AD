def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        if rng.uniform(0, 1) < 0.5:
            # Random Search
            step_size = (ub - lb) * rng.uniform(0, 1)
            new_x = x + np.random.normal(size=dim) * step_size
            new_x = np.clip(new_x, lb, ub)
        else:
            # Gradient Descent
            grad = func(np.insert(x, 0, 1))[:dim]
            alpha = (ub - lb) * rng.uniform(0, 1)
            new_x = x - alpha * grad

        new_f = func(new_x)
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f

    return best_x
