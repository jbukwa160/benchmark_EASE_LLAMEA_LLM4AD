def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_y = float('inf')
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        y = func(x)
        if y < best_y:
            best_x = x
            best_y = y
        alpha = 1 / (budget + 1) ** 0.5
        delta = np.clip(rng.normal(0, alpha), -alpha * 3, alpha * 3)
        new_x = best_x + delta
        new_x = np.clip(new_x, lb, ub)
        new_y = func(new_x)
        if new_y < best_y:
            best_x = new_x
            best_y = new_y
    return best_x
