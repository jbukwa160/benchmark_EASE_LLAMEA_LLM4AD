def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    def sample(pop_size):
        return np.array([clip(rng.uniform(lb, ub, size=dim)) for _ in range(pop_size)])

    def evaluate(candidates):
        return func(candidates)

    x = sample(1)
    y_best = float('inf')
    sigma = 5.0
    lambda_ = int(budget / dim) * 10
    mu = lambda_ // 2

    for _ in range(int(budget)):
        candidates = sample(lambda_)
        candidate_values = evaluate(candidates)
        if np.any(candidate_values < y_best):
            y_best = np.min(candidate_values)
            x = candidates[np.argmin(candidate_values)]

        cov = (1 / len(candidate_values)) * np.dot((candidates - x[:, None]).T, (candidates - x[:, None]))
        u = sample(1)[0]
        v = np.linalg.solve(cov + sigma ** 2 * np.eye(dim), u)
        c = np.log(lambda_ + 0.5) / np.sqrt(np.log(lambda_))
        d = np.sqrt((np.linalg.det(cov)) ** (1 / dim))
        y = x + v * c * np.sqrt(sigma ** 2 - d ** 2)

    return clip(y)
