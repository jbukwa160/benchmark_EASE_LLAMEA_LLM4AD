def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        # Climbing step
        dx = 0.1 * (func(best_x) - func(x))
        x += dx
        
        # Clip to bounds
        x = np.clip(x, lb, ub)
        
        # Evaluate new point
        f = func(x)
        
        # Update best solution if necessary
        if f < best_f:
            best_f = f
            best_x = x.copy()
            
        # Lévy Flight step
        if rng.random() < 0.1 and np.linalg.norm(best_x - x) > 0.01:
            # Generate a random direction
            v = rng.normal(size=dim)
            v /= np.linalg.norm(v)
            
            # Calculate the step size
            s = (ub - lb) * np.power(rng.uniform(0, 1), 2)
            
            # Update x with Lévy Flight step
            x += s * v
            
            # Clip to bounds
            x = np.clip(x, lb, ub)
            
    return best_x
