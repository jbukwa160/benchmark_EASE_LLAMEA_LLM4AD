def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    temperature = 1.0
    sigma = 0.5

    for _ in range(budget):
        v = rng.normal(size=dim)
        u = clip(best_x + sigma * v, lb, ub)

        f_u = func(u)
        if f_u < best_f:
            best_f = f_u
            best_x = u.copy()

        alpha = np.random.uniform(0.1, 5.0)
        new_x = clip(x - alpha * (u - x), lb, ub)
        f_new_x = func(new_x)

        if f_new_x < best_f:
            x = new_x
        else:
            probability = np.exp((best_f - f_new_x) / temperature)
            if rng.uniform(0, 1) < probability:
                x = new_x

        temperature *= 0.99  # decay temperature over time

    return best_x
