def algorithm(func, dim, lb, ub, budget, rng):
    pop = np.random.uniform(lb, ub, (budget, dim))
    best_sol = np.zeros(dim)
    
    for i in range(budget):
        # Evaluate fitness of current population
        fit_pop = func(pop)
        
        # Select the fittest solutions using differential evolution
        parents = select_parents(fit_pop, rng=rng)
        
        # Apply crossover to generate new offspring
        offspring = apply_crossover(parents, rng=rng)
        
        # Clip offspring to feasible region
        offspring = np.clip(offspring, lb, ub)
        
        # Evaluate fitness of generated offspring
        fit_offspring = func(offspring)
        
        # Select the fittest offspring and update best solution
        pop[i] = select_best(fit_offspring, pop[i], rng=rng)
        
        # Perform local search around current best solution using gradient descent
        if i > 0:
            grad = compute_gradient(func, pop[i-1])
            step_size = 0.01
            new_sol = pop[i-1] - step_size * grad
            new_fit = func(new_sol)
            if new_fit < fit_offspring:
                pop[i-1] = new_sol
    
    # Return the best solution found after all iterations
    return pop[-1]
