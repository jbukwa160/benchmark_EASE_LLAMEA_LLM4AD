def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    v = np.zeros(dim)

    for _ in range(budget):
        g = func(x)
        dv = -np.dot(g, v / (1 + np.linalg.norm(v)))
        v += 0.5 * dv
        dx = 0.01 * v

        x -= dx

        # clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)

    return x
