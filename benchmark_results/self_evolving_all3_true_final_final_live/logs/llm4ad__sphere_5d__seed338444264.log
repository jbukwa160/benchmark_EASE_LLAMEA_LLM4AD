def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, a_min=lb, a_max=ub)

    def logsumexp(alphas):
        m = len(alphas)
        amax = max(alphas)
        s = amax + np.log(np.sum(np.exp(alphas - amax)))
        return s

    def sample(mean, cov):
        eps = rng.randn(dim)
        x = mean + np.sqrt(cov) * eps
        x = clip(x, lb, ub)
        return x

    def update(mean, cov, x, f, weight):
        delta = x - mean
        cov += (weight - 1) * delta[:, None] * delta[None, :]
        mean += weight * delta
        return mean, cov

    mu = np.zeros(dim)
    sigma = 0.5 * rng.rand(dim)
    cov = np.eye(dim)

    best_x = None
    best_f = float('inf')

    for _ in range(budget):
        x = sample(mu, cov)
        f_val = func(x)

        if f_val < best_f:
            best_f = f_val
            best_x = x

        weight = 1 / (1 + np.exp(-f_val))
        mu, cov = update(mu, cov, x, f_val, weight)

    return best_x
