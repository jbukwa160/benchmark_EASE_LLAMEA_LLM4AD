def algorithm(func, dim, lb, ub, budget, rng):
    def sample_uniform_bounded(lower, upper, num_samples):
        return lower + rng.uniform(0, 1, size=num_samples) * (upper - lower)

    def gp_go(func, bounds, num_iterations, num_samples_per_iteration, rng):
        x = np.zeros((num_iterations, dim))
        y = np.zeros(num_iterations)
        for i in range(num_iterations):
            if i == 0:
                x[i] = sample_uniform_bounded(bounds[0], bounds[1], num_samples_per_iteration)
            else:
                # Get the GP posterior mean and covariance
                mu, cov = gp_posterior_mean_and_cov(x[:i], y[:i])
                # Sample from the posterior distribution
                new_x = np.random.multivariate_normal(mu, cov * 2.5 + 0.1 * np.eye(dim))
                # Clip to bounds
                new_x = np.clip(new_x, bounds[0], bounds[1])
                x[i] = new_x
            y[i] = func(new_x)
        return x[-1]

    def gp_posterior_mean_and_cov(x, y):
        K_xx = np.dot(x.T, x)
        k_XX = np.zeros((dim, dim))
        for i in range(dim):
            for j in range(i+1, dim):
                k_XX[i, j] = k_XX[j, i] = np.mean(np.multiply((x[:, i] - x[:, j])**2, y**2))
        L = np.linalg.cholesky(K_xx + 0.01 * np.eye(dim) + k_XX)
        return np.dot(L, x.T).T, np.dot(L.T, np.dot(k_XX, L))

    best_x = np.zeros(dim)
    best_y = float('inf')
    for i in range(budget):
        new_x = gp_go(func, [lb, ub], 1, int(0.8 * dim), rng)
        new_y = func(new_x)
        if new_y < best_y:
            best_y = new_y
            best_x = new_x

    return best_x
