def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 1e5
    alpha = 0.99
    t = 0
    best_x = x.copy()
    best_f = func(x)

    while t < budget:
        new_x = x + rng.normal(size=dim) * 0.01
        new_x = np.clip(new_x, lb, ub)
        new_f = func(new_x)

        if new_f <= best_f:
            x = new_x
            best_x = new_x.copy()
            best_f = new_f
        else:
            delta = new_f - best_f
            if rng.uniform(0, 1) < np.exp(-delta / T):
                x = new_x

        T *= alpha
        t += 1

    return best_x
