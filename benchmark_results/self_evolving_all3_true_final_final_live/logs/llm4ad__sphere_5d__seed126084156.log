def algorithm(func, dim, lb, ub, budget, rng):
    current_best = (np.random.uniform(lb, ub, size=dim) + 0.5 * (ub - lb)) / rng.randint(1, int((ub - lb) // 0.01) + 1)
    
    for _ in range(budget):
        candidate = np.clip(current_best + 2 * (np.random.uniform(lb, ub, size=dim) - current_best), lb, ub)
        
        if func(candidate) < func(current_best):
            current_best = candidate
    
    return current_best
