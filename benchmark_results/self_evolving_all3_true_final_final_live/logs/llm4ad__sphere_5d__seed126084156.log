def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    max_iter = int(budget / pop_size)
    
    for _ in range(max_iter):
        x = (ub - lb) * rng.rand(pop_size, dim) + lb
        
        fit = np.array([func(x_i) for x_i in x])
        
        best_idx = np.argmin(fit)
        
        if func(x[best_idx]) < func(lb * np.ones(dim)):
            lb *= 0.9
            ub *= 0.9
            
    return (ub - lb) * rng.rand(1, dim) + lb
