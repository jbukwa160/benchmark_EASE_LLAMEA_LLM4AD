def algorithm(func, dim, lb, ub, budget, rng):
    def wrapper(x):
        return func(x)

    bounds = [(lb, ub) for _ in range(dim)]
    result_de = differential_evolution(wrapper, bounds)
    best_x = result_de.x
    best_y = result_de.fun

    n_iter = 0
    while n_iter < budget:
        x_mean = np.mean(best_x)
        sigma = 1.0 + (ub - lb) / 2.0
        x_cand = best_x + rng.normal(0, sigma, size=(dim,))
        x_clipped = np.clip(x_cand, lb, ub)

        y_cand = wrapper(x_clipped)
        if y_cand < best_y:
            best_x = x_clipped
            best_y = y_cand

        n_iter += 1

    return best_x
