def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    sigma = 1.0
    
    x = np.random.uniform(lb, ub, (pop_size, dim))
    
    best_x = None
    best_f = float('inf')
    
    for _ in range(budget):
        f = func(x)
        
        if np.any(f < best_f):
            best_f = np.min(f)
            best_x = x[np.argmin(f)]
        
        sigma *= 0.99
        c = np.mean(np.linalg.norm(x, axis=1)) / dim
        
        step_size = rng.uniform(0.5 * sigma, 1.5 * sigma)
        std_dev = rng.normal(loc=c, scale=step_size, size=(pop_size, dim))
        
        x += std_dev
    
    # Clip candidates to [lb, ub]
    x = np.clip(x, lb, ub)
    
    return best_x
