def algorithm(func, dim, lb, ub, budget, rng):
    X = rng.uniform(lb, ub, (1, dim))
    gp = GP()
    gp.fit(X, func(X))

    for _ in range(budget - 1):
        mu, sigma = gp.predict(np.zeros((1, dim)), return_std=True)
        acquisition = norm.cdf(mu + 0.5 * sigma)

        X_new = rng.uniform(lb, ub, (1, dim))
        while func(X_new) < func(X[np.argmax(acquisition)]):
            X_new = rng.uniform(lb, ub, (1, dim))

        gp.fit(np.vstack((X, X_new)), np.append(func(X), func(X_new)))
        X = np.vstack((X, X_new))

    return X[np.argmin(func(X))]
