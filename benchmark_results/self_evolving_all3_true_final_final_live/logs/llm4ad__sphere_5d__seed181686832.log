def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = lb + (ub - lb) * rng.rand(dim)
    f_x_best = func(x_best)

    pop_size = 10
    step_size = (ub - lb) / 2.0

    for _ in range(budget):
        x = clip(lb + (ub - lb) * rng.randn(pop_size, dim))
        f_x = np.array([func(xi) for xi in x])

        f_x_best_new = np.min(f_x)

        if f_x_best_new < f_x_best:
            f_x_best = f_x_best_new
            x_best = x[np.argmin(f_x)]

    return clip(x_best)
