def algorithm(func, dim, lb, ub, budget, rng):
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    for i in range(budget):
        learning_rate = 1 / (i + 1)**0.5
        c1, c2 = 1.494, 1.494

        x_new = x_best + learning_rate * c1 * rng.randn(dim) + \
                learning_rate * c2 * rng.randn(dim)

        for j in range(dim):
            if x_new[j] < lb:
                x_new[j] = lb
            elif x_new[j] > ub:
                x_new[j] = ub

        f_new = func(x_new)
        
        if f_new < f_best:
            f_best = f_new
            x_best = x_new

    return x_best
