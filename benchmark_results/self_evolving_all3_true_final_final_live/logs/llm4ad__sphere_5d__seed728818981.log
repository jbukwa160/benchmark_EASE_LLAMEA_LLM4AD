def algorithm(func, dim, lb, ub, budget, rng):
    D = 1e-8
    x_best = -np.inf * np.ones(dim)
    best_candidate = np.zeros(dim)

    for _ in range(budget):
        candidate = (ub - lb) * rng.rand(dim) + lb
        value = func(candidate)

        if value < x_best:
            x_best = value
            best_candidate = candidate

        step_size = 0.1
        new_candidate = best_candidate + step_size * (candidate - best_candidate)
        new_value = func(new_candidate)

        if new_value < x_best:
            x_best = new_value
            best_candidate = new_candidate

    return best_candidate
