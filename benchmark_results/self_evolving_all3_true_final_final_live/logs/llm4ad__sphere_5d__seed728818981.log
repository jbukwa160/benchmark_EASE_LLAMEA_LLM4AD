def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    x_best = -np.ones(dim)
    f_best = float('inf')
    sigma = 0.5 * (ub - lb) / rng
    population_size = 10
    lambda_ = population_size

    for i in range(budget):
        x = clip(rng.normal(x_best, np.eye(dim) * sigma))
        f_x = func(x)

        if f_x < f_best:
            f_best = f_x
            x_best = x

        u = rng.normal(0, 1, (lambda_, dim))
        s = np.dot(u.T, u)
        s /= lambda_
        mu = x_best - sigma**2 * np.linalg.solve(s, rng.normal(0, 1, dim))

        for j in range(lambda_):
            z = clip(mu + sigma * rng.normal(0, 1, dim))
            f_z = func(z)

            if f_z < f_best:
                f_best = f_z
                x_best = z

    return x_best
