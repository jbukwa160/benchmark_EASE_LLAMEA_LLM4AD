def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.array(rng.uniform(lb, ub, size=dim))
    best_fx = func(best_x)

    for _ in range(budget):
        x = np.array(rng.uniform(lb, ub, size=dim))
        fx = func(x)
        
        if fx < best_fx:
            best_fx = fx
            best_x = x

        # Adaptive restarts
        if rng.random() < 0.1 and _ > budget // 10:
            best_x = np.array(rng.uniform(lb, ub, size=dim))
            best_fx = func(best_x)

        # Local search refinement
        if _ % 100 == 0 or rng.random() < 0.01:
            x = best_x + rng.normal(size=dim) * 1e-2
            x = np.clip(x, lb, ub)
            fx = func(x)
            if fx < best_fx:
                best_fx = fx
                best_x = x

    return best_x
