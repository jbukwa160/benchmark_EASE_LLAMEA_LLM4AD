def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    pop_size = 1
    sigma = 5.0
    mu = np.zeros(D)
    cov = np.eye(D)

    for _ in range(budget):
        while True:
            candidate = rng.normal(mu, scale=sigma)
            candidate = np.clip(candidate, lb, ub)
            fitness = func(candidate)

            if fitness < func(mu):
                mu = candidate

            cov = 0.1 * (np.outer((candidate - mu), (candidate - mu)) + cov)
            sigma *= 0.99
            pop_size += 1
            if pop_size >= 20 and np.linalg.det(cov) > 10:
                break

    return mu
