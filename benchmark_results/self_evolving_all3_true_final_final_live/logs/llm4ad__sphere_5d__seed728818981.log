def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget - 1):
        r = 2 / (1 + _ ** 0.5)  # adaptive radius
        x_new = x + r * rng.uniform(-1, 1, size=dim)
        x_new = np.clip(x_new, lb, ub)

        if func(x_new) < best_f:
            best_x = x_new.copy()
            best_f = func(x_new)

        for _ in range(dim):
            x_tmp = x + r * rng.uniform(-1, 1, size=dim)
            x_tmp = np.clip(x_tmp, lb, ub)

            if func(x_tmp) < best_f:
                best_x = x_tmp.copy()
                best_f = func(x_tmp)

    return best_x
