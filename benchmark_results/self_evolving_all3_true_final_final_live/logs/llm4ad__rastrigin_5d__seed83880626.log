def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    best_f = func(x)
    
    alpha = 0.05
    beta = 2.38
    
    for i in range(budget):
        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x.copy()
        
        delta_f = f - best_f
        
        if delta_f <= 0 or np.random.rand() < np.exp(-delta_f / (i + 1)):
            x = lb + (ub - lb) * rng.rand(dim)
        else:
            r = beta * np.sqrt(np.log(i + 1) / (i + 1))
            dir = (x - best_x) / np.linalg.norm(x - best_x)
            
            x = best_x + r * dir
            
    return best_x
