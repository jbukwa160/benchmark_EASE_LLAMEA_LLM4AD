def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        x_new = x + rng.normal(0, 1e-2, size=dim) * (ub - lb)
        x_new = clip_candidate(x_new)
        f_new = func(x_new)

        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new

        radius = np.std(x - best_x)
        if radius < 1e-3 or budget - _ <= 100:
            break

        step_size = 0.9 * (ub - lb) / (budget - _)**0.5
        x += rng.normal(0, step_size, size=dim)

    return best_x
