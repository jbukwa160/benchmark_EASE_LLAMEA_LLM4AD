def algorithm(func, dim, lb, ub, budget, rng):
    def clip(cand, lb, ub):
        return np.clip(cand, lb, ub)

    def init_population(dim, pop_size):
        return rng.uniform(-5, 5, size=(pop_size, dim))

    def evaluate(population):
        scores = [func(ind) for ind in population]
        return np.array(scores)

    def update_best(best, scores):
        if best is None or min(scores) < func(best):
            return argmin(scores)
        else:
            return best

    def selection(population, scores, pop_size):
        indices = np.argsort(scores)[:pop_size]
        selected = population[indices]
        return selected, scores[indices]

    def crossover(parent1, parent2, rng):
        child = 0.5 * (parent1 + parent2)
        return clip(child, lb, ub)

    def mutation(individual, pop_std):
        mutated = individual + rng.normal(0, pop_std, size=dim)
        return clip(mutated, lb, ub)

    best_individual = None
    population_size = 100
    lambda_val = 30

    for _ in range(budget):
        population = init_population(dim, population_size)
        scores = evaluate(population)
        best_individual = update_best(best_individual, scores)
        
        selected, scores = selection(population, scores, population_size)
        pop_mean = np.mean(selected, axis=0)
        pop_cov = np.cov(selected.T)
        pop_var = np.var(selected, axis=0)
        pop_std = np.sqrt(pop_var)

        for _ in range(lambda_val):
            parents = rng.choice(selected, size=lambda_val, replace=False)
            children = []
            for i in range(0, lambda_val, 2):
                parent1, parent2 = parents[i], parents[i+1]
                child = crossover(parent1, parent2, rng)
                mutated_child = mutation(child, pop_std)
                children.append(mutated_child)

            new_scores = evaluate(np.array(children))
            selected, scores = selection(np.concatenate((selected, np.array(children))), 
                                         np.concatenate((scores, new_scores)), population_size)

        best_individual = update_best(best_individual, scores)

    return best_individual
