def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 1e4
    alpha = 0.99
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = x + rng.normal(size=dim) * 0.5
        y = np.clip(y, lb, ub)
        fy = func(y)
        
        delta = fy - best_f

        if delta < 0 or (delta >= 0 and np.random.rand() < np.exp(-delta / T)):
            x = y.copy()
            best_x = x.copy()
            best_f = fy
        else:
            T *= alpha

    return best_x
