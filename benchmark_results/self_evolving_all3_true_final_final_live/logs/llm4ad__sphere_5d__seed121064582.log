def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for i in range(budget):
        noise = np.zeros(dim)
        for j in range(dim):
            noise[j] = rng.normal(0, 1) / (i + 2)**0.5

        x_new = x_best + noise * 0.1
        f_new = func(np.clip(x_new, lb, ub))

        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
