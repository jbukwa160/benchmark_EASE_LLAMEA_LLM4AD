def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    for _ in range(budget):
        if rng.uniform(0, 1) < 0.2: # 20% chance of gradient descent
            step_size = 0.01 * (ub - lb)
            g = func(np.clip(x + step_size * rng.normal(size=dim), lb, ub)) - func(x)
            x -= step_size * np.sign(g)
        else:
            new_x = np.clip(lb + rng.uniform(0, 1) * (ub - lb), lb, ub)
            if func(new_x) < func(x):
                x = new_x
    return x
