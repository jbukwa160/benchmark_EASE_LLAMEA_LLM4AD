def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    for i in range(budget):
        sigma = 5.0 / (i + 1) ** (1 / dim)
        
        # Sample candidate
        candidate = np.random.randn(dim)
        candidate *= sigma
        
        # Clip candidate to bounds
        candidate = np.clip(candidate, lb - x_best, ub - x_best)
        candidate += x_best
        
        # Evaluate function at candidate
        f_candidate = func(candidate)
        
        if f_candidate < f_best:
            f_best = f_candidate
            x_best = candidate
            
    return x_best
