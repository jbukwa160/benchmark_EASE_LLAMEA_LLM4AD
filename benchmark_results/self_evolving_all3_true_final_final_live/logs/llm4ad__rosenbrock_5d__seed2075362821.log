def algorithm(func, dim, lb, ub, budget, rng):
    def obj(x):
        return func(x)

    n = len(lb)
    x_best = np.zeros(n)
    f_best = float('inf')

    for i in range(budget):
        # Stage 1: Search
        sigma = 0.2 * (ub - lb) * rng.random() + 1
        z = rng.normal(size=n)
        y = x_best + sigma * np.exp(0.5 * z**2)

        # Clip candidates to [lb, ub]
        for j in range(n):
            y[j] = max(lb[j], min(y[j], ub[j]))

        f_y = obj(y)
        if f_y < f_best:
            x_best = y
            f_best = f_y

        # Stage 2: Local search around the current best solution
        sigma = 0.1 * (ub - lb) * rng.random() + 1
        z = rng.normal(size=n)
        for _ in range(10):
            y = x_best + sigma * np.exp(0.5 * z**2)

            # Clip candidates to [lb, ub]
            for j in range(n):
                y[j] = max(lb[j], min(y[j], ub[j]))

            f_y = obj(y)
            if f_y < f_best:
                x_best = y
                f_best = f_y

    return x_best
