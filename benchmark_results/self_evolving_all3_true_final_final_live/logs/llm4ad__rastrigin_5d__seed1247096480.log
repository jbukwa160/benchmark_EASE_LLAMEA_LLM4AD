def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    x_best = np.random.uniform(lb, ub, size=(dim,))
    f_best = objective(x_best)
    population_size = 50
    population = np.random.uniform(lb, ub, size=(population_size, dim))
    f_population = [objective(x) for x in population]

    for i in range(budget):
        f_worst = min(f_population)
        idx_worst = f_population.index(f_worst)
        F = 0.5
        Cr = np.random.uniform(0, 1)

        for j in range(population_size):
            if j != idx_worst:
                r1, r2, r3 = rng.randint(population_size), rng.randint(population_size), rng.randint(population_size)
                while [r1, r2, r3].count(j) > 0 or [r1, r2, r3].count(idx_worst) > 0:
                    r1, r2, r3 = rng.randint(population_size), rng.randint(population_size), rng.randint(population_size)
                v_j = population[j] + F * (population[r1] - population[r2]) + Cr * (population[r3] - population[idx_worst])
                v_j = np.clip(v_j, lb, ub)

                f_vj = objective(v_j)
                if f_vj < f_population[j]:
                    population[j] = v_j
                    f_population[j] = f_vj

        if f_best > min(f_population):
            x_best = population[f_population.index(min(f_population))]
            f_best = min(f_population)

    return np.array(x_best)
