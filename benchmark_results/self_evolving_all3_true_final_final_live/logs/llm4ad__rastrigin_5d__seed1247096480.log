def algorithm(func, dim, lb, ub, budget, rng):
    def rastrigin(x):
        return func(np.array([x]))[0]

    x = np.random.uniform(lb, ub, size=dim)
    T = 10000.0
    alpha = 0.95
    beta = 1e-6

    for t in range(budget):
        y = x + rng.normal(size=dim) * 0.01
        y = np.clip(y, lb, ub)

        delta = rastrigin(y) - rastrigin(x)
        if delta < 0:
            x = y
        else:
            p = np.exp(-delta / (T * beta))
            if rng.uniform(0, 1) < p:
                x = y

        T *= alpha

    return x
