def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def get_neighbor(x, sigma):
        noise = rng.normal(size=x.shape) * sigma
        return x + noise

    def evaluate(x):
        return func(clip(x))

    best_x = None
    best_f = float('inf')

    initial_temperature = 1000.0
    cooling_rate = 0.99

    for i in range(budget):
        temperature = max(initial_temperature * (cooling_rate ** i), 1e-6)

        # Simulated Annealing
        x_sa = np.zeros(dim)
        for j in range(2**dim):
            x_candidate = get_neighbor(x_sa, rng.uniform(0.5, 1.5))
            f_candidate = evaluate(x_candidate)

            if f_candidate < best_f:
                best_x = x_candidate
                best_f = f_candidate

            # Acceptance probability for SA
            prob_accept = np.exp(-(f_candidate - best_f) / temperature)
            accept = rng.random() < prob_accept
            if accept:
                x_sa = x_candidate

        # Differential Evolution
        x_de = np.copy(best_x)
        for j in range(dim):
            r1, r2 = rng.choice(range(budget), size=2, replace=False)
            f1, f2 = evaluate(x_de[r1]), evaluate(x_de[r2])
            delta = 0.5 * (x_de[r1] - x_de[r2])
            x_candidate = np.copy(x_de) + delta
            f_candidate = evaluate(x_candidate)

            if f_candidate < best_f:
                best_x = x_candidate
                best_f = f_candidate

    return best_x
