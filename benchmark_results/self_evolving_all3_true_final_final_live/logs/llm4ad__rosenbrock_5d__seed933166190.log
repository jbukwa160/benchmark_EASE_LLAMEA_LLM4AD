def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.full(dim, 5)
    f_best = func(x_best)

    for _ in range(budget):
        # Global exploration
        x_global = rng.uniform(lb, ub, size=dim)
        f_global = func(x_global)

        if f_global < f_best:
            x_best = x_global
            f_best = f_global

        # Local exploration around the current best candidate
        step_size = 0.1 * (ub - lb)
        for i in range(dim):
            x_local = x_best.copy()
            x_local[i] += rng.uniform(-step_size, step_size)
            x_local = np.clip(x_local, lb, ub)

            f_local = func(x_local)

            if f_local < f_best:
                x_best = x_local
                f_best = f_local

    return x_best
