def algorithm(func, dim, lb, ub, budget, rng):
    def grad(x):
        d = np.zeros(dim)
        for i in range(dim - 1):
            d[i + 1] -= 400 * (x[i + 1] - x[i]**2) * x[i]
            d[i] += 200 * (x[i + 1] - x[i]**2) + 2 * (1 - x[i])
        return d

    def accept(x):
        y = np.array(rng.uniform(lb, ub, size=dim))
        if func(y) < func(x):
            return y
        else:
            return x

    x = rng.uniform(lb, ub, size=dim)
    best = x.copy()
    for _ in range(budget):
        d = grad(x)
        s = np.sqrt(np.mean(d**2)) * 0.1 + (func(best) - func(x)) / np.linalg.norm(d)
        candidate = x + rng.uniform(-s, s, size=dim)
        candidate = np.clip(candidate, lb, ub)
        candidate = accept(candidate)
        if func(candidate) < func(best):
            best = candidate.copy()
        x = candidate
    return best
