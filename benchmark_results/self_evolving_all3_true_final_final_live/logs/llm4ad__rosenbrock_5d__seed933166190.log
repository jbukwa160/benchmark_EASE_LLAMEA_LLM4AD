def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    alpha = 1.0
    sigma = 10.0
    c_m = (np.eye(dim) + np.eye(dim)).astype(np.float64)
    d = (ub - lb) / 2

    for i in range(budget):
        z = rng.normal(size=dim)
        x_new = clip(x + alpha * sigma * c_m @ z)

        f_new = func(x_new)

        if f_new < best_f:
            best_x = x_new
            best_f = f_new

        if np.random.rand() < 0.1:
            sigma *= 0.9
            for j in range(dim):
                c_m[j, j] += (z[j]**2) * d**(-2)
            alpha /= 2

    return best_x
