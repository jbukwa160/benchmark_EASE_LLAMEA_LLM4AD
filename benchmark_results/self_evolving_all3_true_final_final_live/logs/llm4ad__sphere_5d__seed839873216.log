def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.array([lb + (ub - lb) * rng.rand(dim)])
    f_best = func(x_best)
    
    for _ in range(budget):
        for i in range(dim):
            new_x_i = x_best[i] + 0.1 * (x_best[i] if rng.rand() < 0.5 else ub - x_best[i])
            if new_x_i > lb and new_x_i <= ub:
                x_new = np.copy(x_best)
                x_new[i] = new_x_i
                f_new = func(x_new)
                
                if f_new < f_best:
                    x_best = x_new
                    f_best = f_new
                
    return x_best
