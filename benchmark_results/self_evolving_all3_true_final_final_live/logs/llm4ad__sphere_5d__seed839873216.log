def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    for i in range(budget):
        new_x = x + 0.1 * (ub - lb) * rng.normal(size=dim)
        new_x = clip(new_x)
        if func(new_x) < func(best_x):
            best_x = new_x
        alpha = 0.95 if np.random.rand() > 0.5 else 0.9
        x = alpha * x + (1 - alpha) * best_x

    return best_x
