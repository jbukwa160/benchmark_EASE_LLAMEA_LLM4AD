def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    n = 0
    x_best = np.zeros(dim)
    f_best = float('inf')
    sigma = 1.0
    while n < budget:
        x_candidate = x_best + rng.randn(dim) * sigma
        x_candidate = clip(x_candidate)
        f_candidate = func(x_candidate)
        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate
        sigma *= np.exp(0.01 * (f_best - f_candidate))
        n += 1
    return x_best
