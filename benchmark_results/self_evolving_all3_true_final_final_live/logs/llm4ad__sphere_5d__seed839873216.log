def algorithm(func, dim, lb, ub, budget, rng):
    candidates = np.random.uniform(lb, ub, (budget, dim))
    
    for i in range(budget - 1):
        new_candidate = np.clip(candidates[i], a_min=lb, a_max=ub)
        
        if func(new_candidate) < func(candidates[i + 1]):
            candidates[i + 1] = new_candidate
            
    best_candidate = np.clip(candidates[-1], a_min=lb, a_max=ub)
    
    return best_candidate
