def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    N = 50  # population size
    F = 0.5  # differential evolution factor
    CR = 0.9  # crossover rate
    X = rng.uniform(lb, ub, (N, D))  # initialize population
    best = np.inf

    for i in range(budget):
        Y = X.copy()
        for j in range(N):
            r1, r2, r3 = rng.randint(0, N, 3)
            while r1 == j or r2 == j or r3 == j:
                r1, r2, r3 = rng.randint(0, N, 3)

            u = np.zeros(D)
            for k in range(D):
                if rng.rand() < CR or X[j, k] != Y[r1, k]:
                    u[k] = Y[r1, k] + F * (Y[r2, k] - Y[r3, k])

            Y[j] = 0.5 * (X[j] + u)
        Y = np.clip(Y, lb, ub)

        f_Y = func(Y)  # evaluate new population
        f_X = func(X)  # evaluate current population

        for j in range(N):
            if f_Y[j] < best:
                best = f_Y[j]
                X_best = Y[j]

        X = Y.copy()  # replace old population with the new one
    return np.array(X_best)
