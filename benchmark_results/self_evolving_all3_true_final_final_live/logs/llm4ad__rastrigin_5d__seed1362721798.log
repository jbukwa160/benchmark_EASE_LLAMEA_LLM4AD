def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    T = 10 * (ub - lb) ** 2
    cooling_rate = 0.99
    
    for _ in range(budget):
        candidate = clip(x + rng.normal(size=dim) * (ub - lb))
        
        if func(candidate) < best_f:
            best_x = candidate.copy()
            best_f = func(candidate)
            
        delta = func(candidate) - best_f
        
        if delta <= 0 or np.random.rand() < np.exp(-delta / T):
            x = candidate
            
        T *= cooling_rate
    
    return best_x
