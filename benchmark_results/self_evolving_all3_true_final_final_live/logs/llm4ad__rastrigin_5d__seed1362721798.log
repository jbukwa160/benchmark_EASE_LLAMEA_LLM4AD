def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x_best = clip(rng.uniform(lb, ub, size=dim), lb, ub)
    f_best = func(x_best)

    for _ in range(budget - 1):
        n = len(x_best)
        F = rng.uniform(0.5, 1.5) / np.sqrt(n)
        Cr = 1 / n
        trial = x_best.copy()

        for i in range(n):
            r1 = (np.random.choice(n) + np.random.choice(n)) % n
            r2 = (np.random.choice(n) + np.random.choice(n)) % n

            if rng.uniform(0, 1) < Cr or i == r1:
                trial[i] = x_best[r2] + F * (x_best[r1] - x_best[r2]) + rng.uniform(-1, 1)

        trial = clip(trial, lb, ub)
        f_trial = func(trial)

        if f_trial < f_best:
            x_best = trial
            f_best = f_trial

    return x_best
