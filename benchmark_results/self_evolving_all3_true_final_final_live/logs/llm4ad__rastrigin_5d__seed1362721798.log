def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    best_y = func(x)

    for _ in range(budget):
        for i in range(dim):
            xi = x[i]
            delta = 0.1 * (ub - lb)
            try_xi_plus_delta = np.clip(xi + delta, lb, ub)
            try_xi_minus_delta = np.clip(xi - delta, lb, ub)

            y_plus = func(try_xi_plus_delta)
            y_minus = func(try_xi_minus_delta)
            y_original = func(x)

            if y_plus < y_original:
                x[i] = try_xi_plus_delta
            elif y_minus < y_original:
                x[i] = try_xi_minus_delta

        y_new = func(x)
        if y_new < best_y:
            best_x = x.copy()
            best_y = y_new

    return best_x
