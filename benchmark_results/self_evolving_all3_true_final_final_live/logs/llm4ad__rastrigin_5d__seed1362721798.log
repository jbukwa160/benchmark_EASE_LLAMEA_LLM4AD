def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x) + 1e10 * (x > 5).sum()

    population_size = int(np.sqrt(budget))
    particles = rng.uniform(lb, ub, size=(population_size, dim))

    for _ in range(budget):
        velocities = np.zeros_like(particles)
        for i in range(population_size):
            best_particle = particles[np.argmin([evaluate(x) for x in particles])]
            velocities[i] += 0.5 * rng.uniform(-1, 1, size=dim)
            particles[i] += velocities[i]
            if evaluate(particles[i]) < evaluate(best_particle):
                best_particle = particles[i]

        particles[:] = clip_candidate(particles)

    return np.argmin([evaluate(x) for x in particles])
