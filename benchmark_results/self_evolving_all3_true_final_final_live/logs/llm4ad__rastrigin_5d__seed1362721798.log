def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def rastrigin(x):
        return func(10 * dim + sum(xi**2 - 10 * np.cos(2 * np.pi * xi) for xi in x))

    pop_size = int(budget ** (1 / 4))
    population = rng.uniform(lb, ub, size=(pop_size, dim))
    best_solution = population[np.argmin([rastrigin(x) for x in population])]

    for _ in range(1, budget):
        mutated_pop = np.zeros(pop_size, dtype=population.dtype)
        for i in range(pop_size):
            p1, p2, p3 = rng.choice(pop_size, size=3, replace=False)
            v = 0.5 * (best_solution + population[p1]) - 0.5 * (population[p2] + population[p3])
            mutated_pop[i] = clip(best_solution + 0.9 * v)

        crossover_pop = np.where(rng.uniform(size=(pop_size, dim)) < 0.5, mutated_pop, population)
        rastrigin_values = [rastrigin(x) for x in crossover_pop]
        best_index = np.argmin(rastrigin_values)
        best_solution = clip(crossover_pop[best_index])

    return best_solution
