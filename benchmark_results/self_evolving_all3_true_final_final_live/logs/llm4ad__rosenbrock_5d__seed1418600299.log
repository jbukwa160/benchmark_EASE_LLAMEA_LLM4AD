def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.minimum(np.maximum(candidate, lb), ub)

    x = 0.5 * (ub - lb) + lb
    y = np.zeros(budget)
    z = np.zeros(dim)
    
    for i in range(1, budget + 1):
        f_val_x = func(x)
        
        for j in range(i):
            z = rng.normal(loc=x, scale=0.1, size=dim)
            z = clip(z)
            f_val_y = func(z)
            
            if np.random.rand() < 0.01: # probability of accepting worse solution
                if f_val_y < f_val_x:
                    x = z
                    y[i] = f_val_x
                else:
                    alpha = rng.uniform(0, 1)
                    x = alpha * x + (1 - alpha) * z
            else:
                if f_val_y <= f_val_x:
                    x = z
                    y[i] = f_val_x
        
        # SA schedule: temperature decreases exponentially with time steps
        T = np.exp(-0.1 * i)
        
        for j in range(i):
            z = rng.normal(loc=x, scale=T, size=dim)
            z = clip(z)
            f_val_y = func(z)
            
            if np.random.rand() < 0.01: # probability of accepting worse solution
                if f_val_y < y[j]:
                    x = z
                    y[i] = f_val_x
                else:
                    alpha = rng.uniform(0, 1)
                    x = alpha * x + (1 - alpha) * z
    
    return clip(x)
