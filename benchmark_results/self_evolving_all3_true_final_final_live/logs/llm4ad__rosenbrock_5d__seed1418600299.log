def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    x = np.random.uniform(lb, ub, size=n)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget - 1):
        f = func(x)
        if f < best_f:
            best_x = x.copy()
            best_f = f

        dx = np.zeros(n)
        step_size = (ub - lb) * rng.rand(n)
        for i in range(n):
            d = (func(np.clip(x + 0.1 * step_size, lb, ub)) 
                 - func(np.clip(x - 0.1 * step_size, lb, ub))) / (2 * 0.1 * step_size[i])
            dx[i] += max(0, d)

        x += 0.01 * dx
        x = np.clip(x, lb, ub)

    return best_x
