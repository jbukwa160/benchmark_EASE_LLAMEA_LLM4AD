def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    sigma = 0.5 * (ub - lb) / 2
    p_mean = np.mean(x)
    cov = np.eye(dim) * sigma ** 2

    for _ in range(budget):
        candidates = clip(p_mean + cov @ rng.normal(size=(1, dim)))
        scores = func(candidates)

        if len(scores.shape) > 1:
            scores = scores[0]

        indices = np.argsort(scores)[:min(int(4 * (budget - _)), int(dim / 2))]
        new_x = candidates[np.arange(min(int(4 * (budget - _)), int(dim / 2)))[:, None], indices].mean(axis=1)
        cov = 3/4 * cov + 1/4 * np.outer(new_x - p_mean, new_x - p_mean)

        if len(indices) == dim:
            p_mean = new_x

    return clip(p_mean)
