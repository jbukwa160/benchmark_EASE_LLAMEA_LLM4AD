def algorithm(func, dim, lb, ub, budget, rng):
    def fitness(x):
        return func(x)

    x = rng.uniform(lb, ub, size=dim)
    p_c = 1 / (4 * dim + 2)
    c_cov = np.eye(dim) * p_c
    lambda_ = int(1.2 * dim**0.5)
    mu = np.zeros(dim)
    sigma = 1

    for _ in range(budget):
        samples = x + rng.normal(size=(lambda_, dim)) * sigma
        samples = np.clip(samples, lb, ub)
        fitness_values = [fitness(sample) for sample in samples]
        sorted_samples = np.array(samples)[np.argsort(fitness_values)]
        mu = (1 - p_c) * mu + p_c * sorted_samples[0]
        cov = [(1 - c_cov) * C + c_cov * np.outer(sorted_sample, sorted_sample)
              for C, sorted_sample in zip(cov, sorted_samples[:lambda_])]
        sigma = 1 / np.sqrt(np.mean([np.diag(C)[0] for C in cov]))
        x = mu

    return x
