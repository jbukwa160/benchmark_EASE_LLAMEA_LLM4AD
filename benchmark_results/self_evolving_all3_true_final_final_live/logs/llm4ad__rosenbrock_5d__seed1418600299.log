def algorithm(func, dim, lb, ub, budget, rng):
    x_best = 0.5 * (ub + lb) + rng.normal(size=dim) * (ub - lb)
    best_fitness = func(x_best)

    for _ in range(budget):
        distribution = np.clip(rng.normal(loc=x_best, scale=np.sqrt(np.abs(best_fitness)) / dim, size=(1 << 16, dim)), lb, ub)
        fitness_values = np.array([func(d) for d in distribution])

        if budget - _ < (1 << 15):
            indices = np.argsort(fitness_values)[:int((budget - _) / (1 << 15))]
            x_new = np.mean(np.clip(distribution[indices], lb, ub), axis=0)
        else:
            index = np.argmin(fitness_values)
            x_new = distribution[index]

        if func(x_new) < best_fitness:
            best_fitness = func(x_new)
            x_best = x_new

    return x_best
