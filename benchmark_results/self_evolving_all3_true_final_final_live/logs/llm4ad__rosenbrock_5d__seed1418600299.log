def algorithm(func, dim, lb, ub, budget, rng):
    X = rng.uniform(lb, ub, (1, dim))
    Y = func(X)
    best_X = X.copy()
    best_Y = Y.copy()

    for _ in range(budget - 1):
        gp_mean, gp_var = norm.fit(Y)  # approximate posterior of the GP
        x_new = np.clip(lb + rng.uniform(0, ub - lb), a_min=lb, a_max=ub)
        for i in range(dim):
            if rng.rand() < 0.5:  # hill climbing step
                x_new[i] = np.clip(best_X[0, i] + rng.uniform(-1e-6, 1e-6),
                                  a_min=lb, a_max=ub)
        Y_new = func(x_new.reshape(1, -1))
        if Y_new < best_Y:
            best_X = x_new
            best_Y = Y_new
        gp_mean += rng.normal(0, np.sqrt(gp_var))  # simulate GP noise
        X = np.vstack((X, x_new))
        Y = np.append(Y, Y_new)

    return best_X
