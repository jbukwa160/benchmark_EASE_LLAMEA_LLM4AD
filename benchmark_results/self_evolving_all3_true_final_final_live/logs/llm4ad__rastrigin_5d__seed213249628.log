def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # DE step
        v = x + 0.1 * (np.random.normal(size=x.shape) - np.random.normal(size=x.shape))
        v = np.clip(v, lb, ub)

        f_v = func(v)
        if f_v < best_f:
            best_x = v.copy()
            best_f = f_v

        # SA step
        alpha = 0.1 * rng.uniform()
        sa_x = best_x + alpha * (np.random.normal(size=x.shape) - np.random.normal(size=x.shape))
        sa_x = np.clip(sa_x, lb, ub)

        sa_f = func(sa_x)
        if sa_f < best_f:
            best_x = sa_x.copy()
            best_f = sa_f

    return best_x
