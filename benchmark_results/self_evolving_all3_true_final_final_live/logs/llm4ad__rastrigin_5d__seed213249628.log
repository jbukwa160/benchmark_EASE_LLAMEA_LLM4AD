def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def f(x):
        x = np.atleast_1d(x)
        if len(x.shape) > 1:
            x = x.flatten()
        return func(x)

    best = -np.inf
    mu = int(np.sqrt(budget))
    sigma = 0.5 * (ub - lb)
    n_restart = int(np.ceil(budget / mu))

    for _ in range(n_restart):
        lambda_ = min(mu, budget // n_restart)
        mean = np.zeros(dim)
        cov = sigma ** 2 * np.eye(dim)

        for _ in range(lambda_):
            z = rng.randn(dim)
            x_new = mean + z @ np.linalg.cholesky(cov)
            x_new = clip(x_new)

            if f(x_new) > best:
                best_x = x_new
                best = f(best_x)

        cov = 0.5 * (cov + cov.T) + sigma ** 2 / lambda_ * np.eye(dim)
        mean = mean + 1 / lambda_ * sum(z @ np.linalg.cholesky(cov) for z in rng.randn(lambda_, dim))

    return best_x
