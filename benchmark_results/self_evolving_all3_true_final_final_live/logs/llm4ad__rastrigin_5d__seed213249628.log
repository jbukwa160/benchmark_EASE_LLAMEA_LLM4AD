def algorithm(func, dim, lb, ub, budget, rng):
    def generate_init_population(n_particles, dim, lb, ub):
        return (ub - lb) * rng.rand(n_particles, dim) + lb

    def compute_fitness(x, func):
        return func(np.array(x))

    def clip_candidates(candidates, lb, ub):
        for i in range(len(candidates)):
            candidates[i] = np.clip(candidates[i], lb, ub)
        return candidates

    n_particles = 50
    init_population = generate_init_population(n_particles, dim, lb, ub)

    for _ in range(budget):
        global_best = np.inf
        for i in range(n_particles):
            x = init_population[i]
            f_x = compute_fitness(x, func)
            if f_x < global_best:
                global_best = f_x
                best_solution = x

        # DE-based exploration phase
        candidates = [best_solution + 0.5 * (rng.rand(dim) - 0.5)]
        for _ in range(n_particles - 1):
            candidate = best_solution + rng.normal(0, 0.3, size=dim)
            candidates.append(candidate)

        candidates = clip_candidates(candidates, lb, ub)

        # Evaluate fitness of new candidates
        for i in range(len(candidates)):
            f_candidate = compute_fitness(candidates[i], func)
            if f_candidate < global_best:
                global_best = f_candidate
                best_solution = candidates[i]

    return best_solution
