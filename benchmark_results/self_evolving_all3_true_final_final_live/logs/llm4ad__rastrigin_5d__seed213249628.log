def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        return func(x)

    n_pop = 1
    while True:
        pop_size = min(n_pop * (budget // (n_pop + 1))**2, budget)
        population = rng.uniform(lb, ub, size=(pop_size, dim))
        
        fitness = np.array([evaluate(clip(x)) for x in population])
        
        best_idx = np.argmin(fitness)
        best_x = clip(population[best_idx])
        
        if evaluate(best_x) == 0:
            return best_x
        
        n_pop *= 2
        for _ in range(pop_size // 10):
            mutant = population[rng.choice(pop_size, size=dim)]
            offspring = (mutant + rng.uniform(-1, 1, size=dim)) / rng.uniform(0.5, 2, size=dim)
            fitness_offspring = evaluate(clip(offspring))
            if fitness_offspring < fitness[best_idx]:
                population[rng.choice(pop_size)] = offspring
                fitness[rng.choice(pop_size)] = fitness_offspring
