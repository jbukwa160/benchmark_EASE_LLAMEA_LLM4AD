def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        if np.any(x < lb) or np.any(x > ub):
            return np.inf
        return func(x)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = evaluate(x)

    for _ in range(budget):
        f = evaluate(x)
        if f < best_f:
            best_f = f
            best_x = x.copy()

        lambda_ = int(np.sqrt(4 * dim))
        y = rng.normal(size=lambda_)
        cov = np.eye(lambda_) + 0.1 * np.outer(y, y)

        for _ in range(lambda_):
            z = rng.normal(size=dim)
            v = np.dot(cov, z)
            u = np.maximum(np.minimum(v + x, ub), lb) - x
            w = np.sqrt(u / (1 + np.sum(u)))
            x += w

    return best_x
