def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    best_x = np.zeros(dim)
    best_f = float('inf')
    n_iter = 0

    for _ in range(budget):
        pop_size = min(100, budget - n_iter)
        x = rng.uniform(lb, ub, size=(pop_size, dim))
        f = np.array([evaluate(xi) for xi in x])

        if np.min(f) < best_f:
            best_x = clip(x[np.argmin(f)])
            best_f = np.min(f)

        sigma = 0.5 / pop_size
        cov = (np.eye(dim) + rng.normal(size=(dim, dim)) * sigma) / pop_size
        mean = x[np.argmin(f)]

        for _ in range(10):
            z = rng.normal(size=dim)
            step = np.dot(np.linalg.cholesky(cov), z)
            new_x = mean + step

            if evaluate(new_x) < best_f:
                mean = clip(new_x)
                cov = (np.eye(dim) + rng.normal(size=(dim, dim)) * sigma) / pop_size
                best_x = clip(mean)
                best_f = evaluate(best_x)

        n_iter += 1
        if np.isinf(best_f):
            break

    return best_x
