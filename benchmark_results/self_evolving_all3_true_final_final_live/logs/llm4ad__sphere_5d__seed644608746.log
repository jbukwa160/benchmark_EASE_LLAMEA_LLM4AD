def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    x_best = 5 * np.ones(n)
    f_best = func(x_best)
    
    T = 1000.
    alpha = 1e-4
    
    for i in range(budget):
        sigma = 1 / (T + i) ** (1/3)
        
        def sample():
            while True:
                x_cand = np.clip(rng.normal(size=n, loc=x_best, scale=sigma), lb, ub)
                yield x_cand
        
        sample_iter = sample()
        for _ in range(dim):
            x_cand = next(sample_iter)
            f_cand = func(x_cand)
            
            if f_cand < f_best:
                f_best = f_cand
                x_best = x_cand
            
            if rng.rand() < np.exp((f_best - f_cand) / T):
                x_best = 0.5 * (x_best + x_cand)
        
        T *= (1 - alpha)
    
    return x_best
