def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(mean, sigma):
        candidate = mean + sigma * rng.normal(size=(dim,))
        return clip(candidate)

    x_best = np.zeros(dim)
    f_best = float('inf')

    for _ in range(budget):
        mean = (ub + lb) / 2
        step_size = ub - lb

        for i in range(10): # number of restarts
            sigma = step_size * rng.uniform(0.1, 1)
            candidate = generate_candidate(mean, sigma)

            f_candidate = func(candidate)
            if f_candidate < f_best:
                x_best = candidate.copy()
                f_best = f_candidate

        mean = (ub + lb) / 2
        step_size /= 2 # reduce the step size after each restart

    return x_best
