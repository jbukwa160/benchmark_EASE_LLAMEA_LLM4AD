def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    pop_size = int(np.sqrt(budget))
    x0 = (ub - lb) * rng.rand(pop_size, dim) + lb
    pbest_x = x0.copy()
    gbest_x = x0[0]
    fbest = func(gbest_x)

    for _ in range(1, budget):
        r1, r2, r3 = rng.choice(pop_size, 3, replace=False)
        v1 = clip(pbest_x[r1] + (pbest_x[r2] - pbest_x[r3]), lb, ub)
        v2 = clip(pbest_x[r1] + (gbest_x - pbest_x[r3]), lb, ub)

        for i in range(dim):
            cr = rng.uniform(0, 1) < 0.5
            if cr:
                x1 = v1[i]
            else:
                x1 = v2[i]

            cr_mut = rng.uniform(0, 1) < (0.9 + 0.05 * (budget - _)) / budget
            if cr_mut:
                x1 += (rng.uniform(-1, 1) * (ub - lb))

        f1 = func(x1)
        fbest = min(fbest, f1)

        if f1 < func(pbest_x[r1]):
            pbest_x[r1] = x1

        if f1 < func(gbest_x):
            gbest_x = x1
            pbest_x[r1] = x1

    return gbest_x
