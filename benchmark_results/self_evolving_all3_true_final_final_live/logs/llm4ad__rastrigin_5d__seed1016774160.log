    x = clip(np.random.rand(dim))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget - 1):
        sigma = 0.5 / (1 + np.linalg.norm(best_x - x) * rng.uniform(0.01, 0.1))
        new_x = x + sigma * rng.normal(size=dim)
        new_x = clip(new_x)
        
        f_new = func(new_x)
        if f_new < best_f:
            best_f = f_new
            best_x = new_x
            
        for _ in range(10):
            delta = 0.1 * (rng.normal(size=dim) + rng.uniform(-1, 1, size=dim))
            new_x = x + delta
            new_x = clip(new_x)
            
            f_new = func(new_x)
            if f_new < best_f:
                best_f = f_new
                best_x = new_x
                
    return best_x
