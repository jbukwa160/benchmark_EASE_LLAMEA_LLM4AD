def algorithm(func, dim, lb, ub, budget, rng):
    mean = rng.uniform(lb, ub, size=dim)
    sigma = 0.1 * (ub - lb) / np.sqrt(dim)
    lambda_ = int(np.ceil(1 + ln(NORM_CONSTANT * dim)))
    iteration = 0
    while iteration < budget:
        iteration += 1
        distribution = np.random.randn(lambda_, dim) * sigma + mean[:, np.newaxis]
        clipped_distribution = np.clip(distribution, lb, ub)
        fitness = func(clipped_distribution)
        parents = clipped_distribution[np.argsort(fitness)]
        mean[:] = (parents[0] + np.sum(parents[1:], axis=0)) / lambda_
