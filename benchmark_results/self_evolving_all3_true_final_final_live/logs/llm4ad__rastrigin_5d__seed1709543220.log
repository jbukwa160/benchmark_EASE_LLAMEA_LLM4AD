def algorithm(func, dim, lb, ub, budget, rng):
    n_restart = int(np.ceil(budget / 1000))
    best_point = None
    num_no_improve = 0
    
    for _ in range(n_restart):
        for _ in range(1000):
            x = np.zeros(dim)
            for i in range(dim):
                x[i] = rng.uniform(lb, ub)
            
            f_x = func(x)
            if best_point is None or f_x < func(best_point):
                best_point = x
                num_no_improve = 0
            else:
                num_no_improve += 1
            
            if num_no_improve > budget // (n_restart * 1000):
                break
        
        if best_point is not None and len(best_point) == dim:
            yield best_point
            
    if best_point is not None:
        return best_point
    else:
        return np.zeros(dim)
