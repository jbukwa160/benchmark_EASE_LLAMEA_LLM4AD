def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def init_simplex(n):
        simplex = np.zeros((n+1, dim))
        for i in range(1, n+1):
            simplex[i] = rng.uniform(lb, ub)
        return simplex

    def f(x):
        return func(x)

    n = 10
    simplex = init_simplex(n)

    while budget > 0:
        budget -= 1
        y = np.argsort(f(simplex))[0]
        x = simplex[y]

        # Reflection step
        r = 2 * x - simplex[0] + rng.uniform(-0.5, 0.5)
        r = clip(r, lb, ub)

        if f(r) < f(x):
            # Expansion step
            e = 2 * r - simplex[0] + rng.uniform(-1, 1)
            e = clip(e, lb, ub)
            if f(e) < f(r):
                simplex[y] = e
            else:
                simplex[y] = r

        elif rng.random() > 0.5:
            # Contraction step
            c = simplex[0] + rng.uniform(-1, 1)
            c = clip(c, lb, ub)
            if f(c) < f(x):
                simplex[y] = c

        else:
            # Shrink operation
            for i in range(1, n+1):
                simplex[i] = (simplex[0] + rng.uniform(-1, 1)) / 2.0
                simplex[i] = clip(simplex[i], lb, ub)

    best_x = np.argmin(f(simplex))
    return simplex[best_x]
