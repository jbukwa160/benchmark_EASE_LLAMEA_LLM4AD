def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(x):
        return np.clip(np.array(x), lb, ub)

    x_best = np.zeros(dim)
    f_best = func(x_best)
    pop_size = 100
    step_size = 0.5
    perturb_prob = 0.1

    for _ in range(budget):
        population = rng.uniform(lb, ub, (pop_size, dim))
        fitness = [func(get_candidate(x)) for x in population]
        
        f_avg = np.mean(fitness)
        if f_best > f_avg:
            f_best = f_avg
            x_best = get_candidate(population[np.argmin(fitness)])

        # DE mutation
        mutant = get_candidate(population[rng.randint(0, pop_size), :] + 
                              rng.uniform(-step_size, step_size, dim))

        # Check for perturbation
        if rng.rand() < perturb_prob:
            mutant += 2 * rng.uniform(lb, ub, dim)

        # Local search
        x_candidate = get_candidate(mutant)
        f_candidate = func(x_candidate)
        
        if f_best > f_candidate:
            f_best = f_candidate
            x_best = x_candidate

    return x_best
