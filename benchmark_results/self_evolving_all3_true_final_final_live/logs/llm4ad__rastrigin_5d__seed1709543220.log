def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(lb, ub, dim):
        return lb + (ub - lb) * rng.rand(dim)

    candidates = []
    for _ in range(budget // 5):
        candidate = generate_candidate(lb, ub, dim)
        candidate = np.clip(candidate, lb, ub)
        candidates.append(candidate)

    best_solution = None
    for _ in range(budget - (budget // 5) * 5):
        parents = np.array(candidates)[rng.choice(len(candidates), size=2, replace=False)]
        child = (parents[0] + parents[1]) / 2.0
        child = np.clip(child, lb, ub)
        candidates.append(child)

        f_child = func(child)
        if best_solution is None or f_child < func(best_solution):
            best_solution = child

    return best_solution
