def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    lambda_ = 10 * dim
    mu = lambda_ / 2
    weights = np.log(mu + 0.5) - np.log(1 + np.arange(lambda_))
    weights /= np.sum(weights)
    sigma = 0.1 + (ub - lb) / 3.0
    c_sigma = 0.8
    c_cov = 2 / (dim + 1.25)
    D = lambda_ * dim
    cov = np.eye(dim)
    cumulation_step = 1

    for _ in range(budget):
        if rng.rand() < 0.01:
            sigma *= 0.9
            cumulation_step = 1
        y = func(x) + np.random.normal(scale=sigma, size=dim)

        f_x = func(x)
        f_y = func(y)

        if f_y < f_x:
            x = y

        elif rng.rand() < 0.5 * sigma / (ub - lb):
            z = np.clip(x + np.random.normal(scale=sigma, size=dim), lb, ub)
            if func(z) < f_x:
                x = z
                y = z

        if _ % D == 0:
            cov = c_cov * cov + x.reshape(-1, 1) @ x[:, None]

        weights *= np.exp(rng.normal(loc=-cumulation_step / (1 + _), scale=1))
        weights /= np.sum(weights)

        cumulation_step += 1

    return np.clip(x, lb, ub)
