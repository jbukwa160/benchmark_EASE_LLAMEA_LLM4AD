def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
            
        u = rng.uniform(0, 1, size=dim)
        s = rng.uniform(-5, 5, size=dim)
        
        for i in range(dim):
            if u[i] > 0.5:
                x[i] += np.random.choice([-s[i], s[i]])
                
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
            
    return best_x
