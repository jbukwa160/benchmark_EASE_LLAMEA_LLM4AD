def algorithm(func, dim, lb, ub, budget, rng):
    population_size = 100
    num_generations = int(budget / (population_size * dim))
    
    def clip(candidate):
        return np.clip(candidate, lb, ub)
    
    def fitness(x):
        return func(x) + abs(rng.uniform(0, 1))
    
    def generate_initial_population():
        population = rng.uniform(lb, ub, size=(population_size, dim))
        return population
    
    def selection(population):
        indices = np.argsort([fitness(x) for x in population])[:int(population_size / 2)]
        return population[indices]
    
    def crossover(parent1, parent2):
        child = (parent1 + parent2) / 2
        return clip(child)
    
    def mutation(candidate):
        mutation_step = 0.5 * (ub - lb)
        for i in range(dim):
            if rng.uniform(0, 1) < 0.01:
                candidate[i] += rng.choice([-mutation_step, mutation_step])
        return clip(candidate)
    
    population = generate_initial_population()
    for _ in range(num_generations):
        population = selection(population)
        new_population = []
        while len(new_population) < population_size:
            parent1, parent2 = np.random.choice(population, size=2, replace=False)
            child = crossover(parent1, parent2)
            child = mutation(child)
            new_population.append(child)
        population = np.array(new_population)
    
    return clip(selection(population)[0])
