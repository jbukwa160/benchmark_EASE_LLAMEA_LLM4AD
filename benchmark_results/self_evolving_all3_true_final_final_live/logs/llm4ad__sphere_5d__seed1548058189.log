def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    best_candidate = rng.uniform(low=-5.0, high=5.0, size=(dim,))
    best_fitness = func(best_candidate)
    
    for i in range(budget):
        candidate = clip(rng.normal(loc=best_candidate, scale=1.0))
        
        # Perform a few random perturbations to the current best
        for _ in range(10):
            perturbed_candidate = candidate + rng.uniform(low=-1.0, high=1.0, size=(dim,))
            perturbed_candidate = clip(perturbed_candidate)
            perturbed_fitness = func(perturbed_candidate)
            
            if perturbed_fitness < best_fitness:
                best_candidate = perturbed_candidate
                best_fitness = perturbed_fitness
                
        # Randomly sample a new candidate
        candidate = clip(rng.uniform(low=lb, high=ub, size=(dim,)))
        
        fitness = func(candidate)
        
        if fitness < best_fitness:
            best_candidate = candidate
            best_fitness = fitness
            
    return best_candidate
