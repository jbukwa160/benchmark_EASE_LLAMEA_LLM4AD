def algorithm(func, dim, lb, ub, budget, rng):
    def kl_divergence(p1, p2):
        return np.sum(p1 * np.log(p1 / p2))

    x_best = np.zeros(dim)
    f_best = float('inf')
    T = 1000.0
    alpha = 0.9

    for _ in range(budget):
        p = rng.uniform(0, 1)
        sigma = 0.1 * (ub - lb)

        while p > np.exp(-T / f_best) and sigma < ub:
            x_new = x_best + rng.normal(size=dim) * sigma
            x_new = np.clip(x_new, lb, ub)

            f_new = func(x_new)
            if f_new < f_best:
                x_best = x_new
                f_best = f_new

            delta_f = f_new - f_best
            KL = kl_divergence(np.exp(-delta_f / T), np.exp(0))

            sigma *= alpha
            p -= KL

        T *= 0.99

    return x_best
