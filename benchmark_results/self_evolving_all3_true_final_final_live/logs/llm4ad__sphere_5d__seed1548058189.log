def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.ceil(budget / (dim + 1)))
    
    # Initialize population
    X = rng.uniform(lb, ub, size=(pop_size, dim))
    
    for _ in range(budget):
        F = 0.5  # Scaling factor
        CR = 0.9  # Crossover probability
        
        # Selection
        Y = np.copy(X)
        
        # Mutation
        for i in range(pop_size):
            r1, r2, r3 = rng.choice(pop_size, size=3, replace=False)
            if rng.uniform(0, 1) < CR or func(Y[r1]) > func(Y[i]):
                Y[i] = X[r1] + F * (X[r2] - X[r3])
        
        # Crossover
        for i in range(pop_size):
            r1 = rng.choice(pop_size)
            if rng.uniform(0, 1) < CR or func(Y[r1]) > func(Y[i]):
                Y[i] = np.where(rng.uniform(0, 1, size=dim) < 0.5, X[i], Y[r1])
        
        # Evaluation and update
        f_X = func(X)
        f_Y = func(Y)
        if all(f_Y <= f_X):
            X = Y.copy()
    
    return np.min(X, axis=0)
