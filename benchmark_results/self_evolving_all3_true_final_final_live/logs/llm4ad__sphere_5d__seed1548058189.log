def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        i = rng.choice(dim)
        step_size = 1e-3 * (ub - lb) * (rng.random() + 0.5)
        new_x = x.copy()
        new_x[i] += np.sign(new_x[i]) * step_size
        new_x = np.clip(new_x, lb, ub)

        f = func(new_x)
        if f < best_f:
            best_f = f
            best_x = new_x

    return best_x
