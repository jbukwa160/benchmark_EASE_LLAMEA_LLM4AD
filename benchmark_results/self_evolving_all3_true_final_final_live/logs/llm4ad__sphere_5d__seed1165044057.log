def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_fx = float('inf')
    
    for i in range(budget):
        if rng.random() < 1 / (i + 1):
            x = np.zeros(dim)
        else:
            x = rng.uniform(lb, ub, size=dim)
            x += rng.normal(0, 0.5, size=dim)
        
        fx = func(x)
        
        if fx < best_fx:
            best_fx = fx
            best_x = x
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
        
    return best_x
