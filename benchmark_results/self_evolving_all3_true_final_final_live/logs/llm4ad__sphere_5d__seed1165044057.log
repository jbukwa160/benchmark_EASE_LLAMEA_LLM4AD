def algorithm(func, dim, lb, ub, budget, rng):
    best = lb + (ub - lb) * rng.rand(dim)
    for _ in range(budget):
        candidate = lb + (ub - lb) * rng.rand(dim)
        new_cost = func(candidate)
        old_cost = func(best)
        if new_cost < old_cost:
            best = candidate
    return best
