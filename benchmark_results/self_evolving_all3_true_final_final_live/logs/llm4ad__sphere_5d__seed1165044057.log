def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.maximum(np.minimum(candidate, ub), lb)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    for _ in range(budget):
        new_x = rng.normal(size=dim)
        new_x += x
        new_x = clip(new_x)
        if func(new_x) < func(best_x):
            best_x = new_x
        elif rng.rand() < np.exp((func(x) - func(best_x)) / 1000):
            x = new_x
    return best_x
