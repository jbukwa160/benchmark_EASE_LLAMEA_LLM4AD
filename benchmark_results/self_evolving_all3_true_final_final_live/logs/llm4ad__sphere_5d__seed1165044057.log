def algorithm(func, dim, lb, ub, budget, rng):
    mu = 0.5 * (lb + ub)
    sigma = 1.1 * (ub - lb) / 2
    x_best = mu * np.ones(dim)
    f_best = func(x_best)

    for i in range(budget):
        lambda_ = int(4 + 3 * rng.rand())
        x_new = x_best + sigma * rng.randn(dim)
        
        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        if f_new < f_best:
            f_best = f_new
            x_best = x_new

    return x_best
