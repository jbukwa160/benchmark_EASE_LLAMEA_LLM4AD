def algorithm(func, dim, lb, ub, budget, rng):
    n = len(rng)
    x = [np.random.uniform(lb, ub) for _ in range(dim)]
    T = 1000.0
    alpha = 1e-3
    beta = 0.99
    learning_rate = 0.01

    for i in range(budget):
        prev_x = np.array(x)
        f_prev = func(prev_x)

        # Simulated Annealing
        dx = rng[i % n]
        x_i = x[dim-1] + dx
        if x_i < ub and x_i > lb:
            x[dim-1] = x_i

        f_curr = func(np.array(x))
        dE = f_prev - f_curr

        # Gradient Descent
        grad = [0.0]*dim
        for j in range(dim):
            grad[j] = (func(prev_x[:j+1]) - f_prev) / learning_rate
            x[j] -= learning_rate * grad[j]

        if dE < 0:
            T *= beta

        # Adaptive learning rate
        learning_rate = max(1e-6, alpha * np.exp(-dE/T))

        # Clip candidates to [lb, ub]
        for j in range(dim):
            x[j] = max(lb, min(x[j], ub))

    return np.array(x)
