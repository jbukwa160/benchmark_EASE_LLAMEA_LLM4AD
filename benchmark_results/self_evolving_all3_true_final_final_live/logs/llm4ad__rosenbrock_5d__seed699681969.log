def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def func_eval(x):
        return func(x)

    x = rng.uniform(size=dim)
    x_best = x.copy()
    func_best = func_eval(clip(x))
    cov_matrix = np.eye(dim) * 0.5
    sigma = 1

    for _ in range(budget):
        candidates = clip(rng.multivariate_normal(np.zeros(dim), cov_matrix, size=10**dim))

        # CMA-ES part
        scores = [func_eval(candidate) for candidate in candidates]
        i = np.argmin(scores)
        x_new = candidates[i].copy()
        score_new = scores[i]

        if score_new < func_best:
            func_best = score_new
            x_best = x_new.copy()

        # Update covariance matrix and step size
        cov_matrix, sigma = update_cov_matrix(cov_matrix, sigma, x, x_new)

        x = x_new

    return clip(x_best)
