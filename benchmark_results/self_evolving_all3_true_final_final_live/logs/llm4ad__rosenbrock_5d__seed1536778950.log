def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    T = 1000
    alpha = 1 / (T ** 2)

    for _ in range(budget):
        y = x.copy()
        i = rng.choice(dim, size=1)[0]
        dy = rng.uniform(-1, 1)
        y[i] += dy

        y[clip(y)] = lb + (ub - lb) * y[clip(y)]
        
        if func(y).sum() < func(x).sum():
            x = y
        else:
            p = np.exp(-(func(y).sum() - func(x).sum()) / T)
            u = rng.uniform(0, 1)
            if u < p:
                x = y

        T *= alpha

    return clip(x)
