def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=dim)
    best_fitness = func(x_best)

    for _ in range(budget):
        x_candidate = x_best.copy()

        # Gaussian process-based exploration
        mu, sigma = gaussian_process(x_candidate, rng)
        noise = np.random.normal(0, 1e-6, size=dim) * sigma + 1e-6

        # Probabilistic hill-climbing search
        for i in range(dim):
            x_candidate[i] += noise[i]
            if not (lb <= x_candidate[i] <= ub):
                x_candidate[i] = np.clip(x_candidate[i], lb, ub)
            fitness = func(x_candidate)

            if fitness < best_fitness:
                best_fitness = fitness
                x_best = x_candidate.copy()

        # Gaussian process update
        gaussian_process_update(x_candidate, mu, sigma, rng)

    return x_best
