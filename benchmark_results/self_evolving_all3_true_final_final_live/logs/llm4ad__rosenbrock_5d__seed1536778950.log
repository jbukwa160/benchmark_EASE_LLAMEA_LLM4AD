def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def gradient(x):
        x = clip(x, lb, ub)
        g = np.zeros(dim)
        for i in range(dim-1):
            gi = 400 * (x[i+1] - x[i]**2) * (2*x[i+1] - 2*x[i]**3)
            g[i] += gi
            g[i+1] -= 200 * (x[i+1] - x[i]**2)
        return g

    def local_search(x, budget):
        for _ in range(budget):
            x_new = x + 0.01 * rng.normal(size=dim)
            f_new = func(clip(x_new, lb, ub))
            if f_new < func(clip(x, lb, ub)):
                x = x_new
        return x

    dim_half = int(dim / 2) - 1
    sigma = 0.5 * (ub - lb)
    mu = np.zeros(dim)
    cov = np.eye(dim)

    for _ in range(budget):
        samples = rng.normal(size=(dim, budget))
        samples *= sigma
        for i in range(budget):
            samples[:, i] += mu

        samples = clip(samples, lb, ub)
        samples = samples.T

        f_values = func(samples)
        indices = np.argsort(f_values)

        best_sample = samples[indices[:1], :]

        if budget > 50:
            for j in range(1, dim_half + 1):
                cov[j, :] *= (j / (j + 1)) ** 0.5
                cov[:, j] *= (j / (j + 1)) ** 0.5

        mu = np.sum(best_sample, axis=1) / budget
        cov = (budget - 2) / (budget + 1) * cov + (best_sample - mu[:, None]) @ (best_sample - mu[:, None]).T / budget

    best_x = clip(mu, lb, ub)
    return local_search(best_x, 100)
