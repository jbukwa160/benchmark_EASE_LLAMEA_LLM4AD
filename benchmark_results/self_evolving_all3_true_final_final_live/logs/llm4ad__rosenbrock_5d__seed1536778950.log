def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(num_particles, dimension):
        return rng.uniform(lb, ub, (num_particles, dimension))

    def evaluate_fitness(population):
        fitness = np.zeros(population.shape[0])
        for i in range(population.shape[0]):
            x = clip(population[i])
            fitness[i] = func(x)
        return fitness

    num_particles = 50
    population = generate_initial_population(num_particles, dim)
    velocity = rng.uniform(-1, 1, (num_particles, dim))

    for _ in range(budget):
        fitness = evaluate_fitness(population)

        best_particle_index = np.argmin(fitness)
        best_particle = clip(population[best_particle_index])

        for i in range(num_particles):
            r1, r2, r3 = rng.uniform(0, 1, 3)
            v_new = velocity[i] + r1 * (best_particle - population[i]) + \
                    r2 * (population[np.random.choice(num_particles, p=fitness/np.sum(fitness))]-population[i]) + \
                    r3 * (population[np.random.choice(num_particles, p=fitness/np.sum(fitness))]-population[i])
            velocity[i] = 0.5 * velocity[i] + 0.5 * v_new
            population[i] += velocity[i]

    best_particle_index = np.argmin(evaluate_fitness(population))
    return clip(population[best_particle_index])
