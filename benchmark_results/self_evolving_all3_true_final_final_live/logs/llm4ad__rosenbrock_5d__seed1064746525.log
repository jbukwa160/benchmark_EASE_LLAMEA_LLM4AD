def algorithm(func, dim, lb, ub, budget, rng):
    def clipped_bounds(x):
        return np.clip(x, a_min=lb, a_max=ub)

    bounds = [(lb, ub) for _ in range(dim)]
    res_diffev = differential_evolution(func, bounds=bounds)
    x_best = clipped_bounds(res_diffev.x)

    for i in range(budget - 1):
        step_size = (ub - lb) * rng.uniform(0.01, 0.1)
        dir = np.array(rng.standard_normal(dim)) * step_size
        trial_x = clipped_bounds(x_best + dir)

        if func(trial_x) < func(x_best):
            x_best = trial_x

    return x_best
