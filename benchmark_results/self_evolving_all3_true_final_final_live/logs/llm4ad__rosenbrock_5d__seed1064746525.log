def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    best_x = rng.uniform(lb, ub)
    best_f = evaluate(best_x)

    grid_size = 10
    step_size = (ub - lb) / grid_size
    candidates = []
    for i in range(grid_size):
        x = np.zeros(dim)
        x[0] = lb + i * step_size
        candidates.append(x)

    for _ in range(budget):
        new_candidates = []
        for candidate in candidates:
            x = np.clip(candidate, lb, ub)
            f = evaluate(x)
            if f < best_f:
                best_x = x
                best_f = f
            new_candidates.append(np.array([candidate[0] + 0.1 * rng.uniform(-1, 1), candidate[1]]))
        candidates = new_candidates

    return np.clip(best_x, lb, ub)
