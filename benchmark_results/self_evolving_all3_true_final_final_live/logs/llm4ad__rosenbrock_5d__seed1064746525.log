def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_x = None
    best_y = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        while True:
            y = func(x)
            
            if y < best_y:
                best_y = y
                best_x = clip(x)
                
            v = np.random.choice(dim, 3, replace=False) + np.random.randint(-1, 2, size=3)
            x_new = x.copy()
            for i in range(dim):
                if rng.uniform(0, 1) < 0.5:
                    x_new[i] += (ub - lb) * rng.uniform(-1, 1) / 10
                else:
                    u = rng.uniform(lb, ub)
                    x_new[v[i]] = clip(u + 0.2*(x[v[i]] - u))
            
            if rng.uniform(0, 1) < 0.5:
                p = np.random.choice([True, False], size=dim)
                for i in range(dim):
                    if p[i]:
                        x_new[i] = clip(x_new[i])
            
            y_new = func(clip(x_new))
            
            if y_new < best_y:
                break
        
        if rng.uniform(0, 1) > 0.9:
            x = best_x.copy()
    
    return best_x
