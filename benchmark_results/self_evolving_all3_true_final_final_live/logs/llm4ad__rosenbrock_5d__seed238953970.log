def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return func(x)

    x = rng.uniform(-5.0, 5.0, size=dim)
    T = 10000
    alpha = 0.9
    min_alpha = 1e-6

    for _ in range(budget):
        f_val = Rosenbrock(x)
        
        # Generate a new candidate by perturbing the current solution
        x_new = x + rng.uniform(-5, 5, size=dim) / T
        
        # Clip the new candidate to the valid interval [lb, ub]
        x_new = np.clip(x_new, lb, ub)
        
        f_val_new = Rosenbrock(x_new)
        
        if f_val_new < f_val:
            x = x_new
        else:
            beta = 1 / (1 + np.exp(-(f_val_new - f_val) / T))
            if rng.random() < beta and not np.isclose(beta, 0):
                x = x_new
        
        # Update the temperature
        T *= alpha
        if T < min_alpha:
            break
    
    return x
