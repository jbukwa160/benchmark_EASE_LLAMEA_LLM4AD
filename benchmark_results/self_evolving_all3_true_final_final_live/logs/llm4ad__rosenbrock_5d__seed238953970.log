def algorithm(func, dim, lb, ub, budget, rng):
    def simplex_init(dim, lb, ub):
        x = np.zeros((5, dim))
        for i in range(5):
            for j in range(dim):
                x[i, j] = (ub - lb) * rng.rand() + lb
        return x

    def simplex_func(x):
        return func(np.array([x]).T)

    def simplex_fitness(x):
        return np.sum(simplex_func(x))

    def reflection(x, centroid, a):
        return 2 * centroid - x + a * (centroid - x)

    def expansion(x, centroid, a):
        return 2 * centroid + a * (centroid - x)

    def contraction(x, centroid, a):
        return centroid + a * (centroid - x)

    def shrinkage(x, centroid, a):
        new_x = np.zeros((5, dim))
        for i in range(5):
            new_x[i] = centroid + a * (x[i] - centroid)
        return new_x

    def simplex_step(x, f_best, c_best, rho, a):
        centroid = np.mean(c_best, axis=0)
        x_reflection = reflection(x[0], centroid, a)
        if simplex_fitness(x_reflection) < f_best:
            for i in range(5):
                x[i] = x_reflection
            return x, simplex_fitness(x_reflection)
        else:
            x_expansion = expansion(x[0], centroid, a)
            if simplex_fitness(x_expansion) < f_best:
                for i in range(5):
                    x[i] = x_expansion
                return x, simplex_fitness(x_expansion)
            else:
                x_contraction = contraction(x[0], centroid, rho * a)
                if simplex_fitness(x_contraction) < f_best:
                    for i in range(5):
                        x[i] = x_contraction
                    return x, simplex_fitness(x_contraction)
                else:
                    x_shrinkage = shrinkage(x[0], centroid, rho * a)
                    for i in range(1, 5):
                        x[i] = x_shrinkage
                    return x, simplex_fitness(x_shrinkage)

    def de_step(population, f_best):
        new_population = np.zeros((population.shape))
        for i in range(population.shape[0]):
            r1 = rng.choice(population.shape[0], 3, replace=False)
            u = population[r1] + (ub - lb) * rng.rand(3, dim) + lb
            v = u[(r1[0] == np.argmax(np.sum((u - population)**2, axis=1)))][0]
            new_population[i] = (v + 0.5 * (population[i] - v)) / 2
        return new_population

    best_x = simplex_init(dim, lb, ub)
    f_best = simplex_func(best_x)

    for i in range(budget):
        new_population = de_step(best_x, f_best)
        for x in new_population:
            clipped_x = np.clip(x, a_min=lb, a_max=ub)
            fx = func(clipped_x)
            if fx < f_best:
                best_x = clipped_x
                f_best = fx

    return best_x
