def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    T = 1e6
    alpha = 0.99

    for _ in range(budget):
        f_x = func(x)
        new_x = clip(x + rng.normal(size=x.shape) * 0.01, lb, ub)
        f_new_x = func(new_x)

        if f_new_x < f_x:
            x = new_x
        else:
            delta = f_new_x - f_x
            prob = np.exp(-delta / T)
            if rng.random() < prob:
                x = new_x

        T *= alpha

    return x
