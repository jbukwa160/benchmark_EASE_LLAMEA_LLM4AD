def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    lr = 0.1
    mu = 0.5
    sigma = 1.0
    noise_type = 'zero_mean'
    
    for i in range(budget):
        gradient = np.zeros(dim)
        
        for j in range(dim-1):
            if noise_type == 'zero_mean':
                noise = rng.normal(0, sigma, size=dim)
            elif noise_type == 'gaussian':
                noise = rng.normal(mu, sigma, size=dim)
            
            x_candidate = x + 0.01 * gradient
            x_candidate[j+1] += np.random.choice([-5, 5])
            x_candidate = np.clip(x_candidate, lb, ub)
            
            gradient[j] -= 200 * (x_candidate[j+1] - x_candidate[j]**2) * (x_candidate[j+1] - x_candidate[j]**2)
            gradient[j] -= 2 * (1 - x_candidate[j]) * (1 - x_candidate[j])
        
        if noise_type == 'zero_mean':
            noise = rng.normal(0, sigma, size=dim)
        elif noise_type == 'gaussian':
            noise = rng.normal(mu, sigma, size=dim)
            
        x = x + lr * gradient + np.clip(noise, -sigma, sigma)
    
    return np.clip(x, lb, ub)
