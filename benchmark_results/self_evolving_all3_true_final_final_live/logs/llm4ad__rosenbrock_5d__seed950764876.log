def algorithm(func, dim, lb, ub, budget, rng):
    def cma_es_step(x, sigma, t, budget):
        y = func(x)
        if y < y_best:
            x_best = x.copy()
            y_best = y
        else:
            alpha = 1 + (y - y_best) / (2 * t)
            if rng.rand() < np.exp(alpha):
                x = x + sigma * np.random.randn(dim)
                if func(x) < y_best:
                    x_best = x.copy()
                    y_best = func(x)
        return x_best, y_best

    def simulated_annealing_step(x, sigma, t, budget):
        T = 10 ** rng.uniform(-4, -1)
        while True:
            new_x = x + sigma * np.random.randn(dim)
            if new_x.min() >= lb and new_x.max() <= ub:
                delta_f = func(new_x) - func(x)
                if delta_f < 0 or rng.rand() < np.exp(-delta_f / T):
                    x = new_x
                else:
                    break
            else:
                break
        return x

    x_best = lb + (ub - lb) * rng.uniform(size=dim)
    y_best = func(x_best)

    sigma = 0.1
    t = budget // 10
    for i in range(budget):
        if i % t == 0:
            sigma *= np.exp(rng.randn() / 2)
            t //= 2
        x_best, y_best = cma_es_step(x_best, sigma, t, budget - i)

        # SA step to escape local minima
        if rng.rand() < 0.1 and func(x_best) >= y_best:
            x_best = simulated_annealing_step(x_best, sigma, t, budget)
            y_best = func(x_best)

    return x_best
