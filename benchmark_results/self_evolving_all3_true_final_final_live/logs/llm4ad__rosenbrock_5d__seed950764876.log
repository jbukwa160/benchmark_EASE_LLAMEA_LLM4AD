def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(np.array(x))

    x = [rng.uniform(lb, ub) for _ in range(dim)]
    T = 1000
    a = 0.9
    b = 0.1

    while budget > 0:
        y = np.copy(x)
        for i in range(dim):
            dy = rng.normal(0, 5)
            y[i] += dy * (x[i+1] - x[i]**2) / np.sqrt(f(x))
            y[i] = max(lb, min(y[i], ub))

        delta_f = f(y) - f(x)

        if delta_f < 0 or rng.random() < np.exp(-delta_f / T):
            x = y

        budget -= 1
        T *= a

    return np.array(x)
