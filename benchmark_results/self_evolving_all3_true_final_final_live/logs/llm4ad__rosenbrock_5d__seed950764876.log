def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, (dim,))
    y = func(x)
    best_x = x.copy()
    best_y = y

    mu = 1.0
    sigma = 0.5 * (ub - lb) / rng
    for i in range(budget):
        if i % int(2/3*budget) == 0:
            sigma *= 0.95

        x_new = x + np.random.normal(size=(dim,), loc=0, scale=sigma)
        x_new = clip(x_new, lb, ub)

        y_new = func(x_new)
        if y_new < best_y:
            best_x = x_new
            best_y = y_new

        x_new2 = x + (x_new - x) * np.random.uniform(size=(dim,))
        x_new2 = clip(x_new2, lb, ub)

        y_new2 = func(x_new2)
        if y_new2 < best_y:
            best_x = x_new2
            best_y = y_new2

    return best_x
