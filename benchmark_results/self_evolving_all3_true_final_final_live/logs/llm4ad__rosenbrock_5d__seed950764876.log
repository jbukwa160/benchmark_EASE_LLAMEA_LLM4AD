def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    D = 1.0 / (dim + 5.0) * np.eye(dim)
    mu = np.zeros((n,))
    sigma = np.sqrt(np.mean(D))
    
    for _ in range(budget):
        x = mu + rng.normal(size=(1, n)) * sigma
        for i in range(n):
            x[0, i] = np.clip(x[0, i], lb[i], ub[i])
        
        fx = func(x)
        if fx < func(mu):
            mu = x.copy()
    
    return mu
