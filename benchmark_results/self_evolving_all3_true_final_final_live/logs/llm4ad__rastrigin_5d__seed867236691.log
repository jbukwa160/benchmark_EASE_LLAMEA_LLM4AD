def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = x + 0.1 * (ub - lb) * np.random.normal(size=dim)
        y = np.clip(y, lb, ub)
        f_y = func(y)
        
        if f_y < best_f:
            best_x = y.copy()
            best_f = f_y

        r = rng.uniform(0, 1)
        if r > 0.9 and _ >= budget // 10:
            x = np.clip(best_x + 0.5 * (ub - lb) * np.random.normal(size=dim), lb, ub)

    return best_x
