def algorithm(func, dim, lb, ub, budget, rng):
    def obj(x):
        return func(x)

    x_best = -np.ones(dim)
    f_best = np.inf

    for _ in range(budget):
        # Generate a new candidate point
        x_new = x_best + 0.1 * (ub - lb) * np.random.rand(dim)

        # Clip the candidate to the bounds
        x_new = np.clip(x_new, lb, ub)

        # Evaluate the function at the new candidate
        f_new = obj(x_new)

        # Check if this is a better solution
        if f_new < f_best:
            f_best = f_new
            x_best = x_new

    return x_best
