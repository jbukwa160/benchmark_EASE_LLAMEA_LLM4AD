def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def acceptance_probability(current_fitness, new_fitness, T):
        return np.exp((current_fitness - new_fitness) / T)

    T = 1.0
    best_solution = None
    best_fitness = np.inf

    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        f_x = func(x)
        
        if f_x < best_fitness:
            best_fitness = f_x
            best_solution = clip(x, lb, ub)

        while True:
            y = clip(x + rng.normal(0, 1e-2, size=dim), lb, ub)
            
            y_f_y = func(y)
            
            if rng.random() < acceptance_probability(best_fitness, y_f_y, T):
                x = y
                f_x = y_f_y
                
                if f_x < best_fitness:
                    best_fitness = f_x
                    best_solution = clip(x, lb, ub)
                    
            T *= 0.99  # adaptive cooling schedule

            if rng.random() > 0.9 or _ >= budget * 0.8:
                break

    return best_solution
