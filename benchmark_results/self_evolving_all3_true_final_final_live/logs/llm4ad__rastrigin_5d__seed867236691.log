def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    D = 10 * n + sum((ub - lb)**2)
    p = 0.01
    B = int(budget / (n + 1))
    
    def evaluate(x):
        return func(x) / D
    
    x_best = np.random.uniform(lb, ub, size=n)
    f_best = evaluate(x_best)
    
    x_cand = np.random.uniform(lb, ub, size=(B, n))
    
    for _ in range(budget - 1):
        for i in range(n):
            y = np.copy(x_best)
            y[i] = np.random.uniform(lb, ub)
            f_y = evaluate(y)
            
            if rng.uniform(0, 1) < p:
                x_cand[i % B] = y
            
            f_new = max(f_best, evaluate(np.copy(x_best)))
            if f_y < f_new:
                x_best = np.copy(y)
                f_best = f_y
                
        for i in range(n):
            y = np.copy(x_best)
            j = rng.randint(0, n - 1)
            while j == i:
                j = rng.randint(0, n - 1)
            y[i] = x_cand[j % B][i]
            
            f_y = evaluate(y)
            if f_y < f_best:
                x_best = np.copy(y)
                f_best = f_y
                
    return x_best
