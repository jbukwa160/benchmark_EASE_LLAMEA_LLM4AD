def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(best_x)
    
    for _ in range(budget):
        x_new = np.random.uniform(lb, ub, size=dim)
        
        # Calculate the probability of mutation based on the distance to the best candidate
        prob_mutate = 1 - np.mean(np.abs(x_new - best_x))
        
        if rng.random() < prob_mutate:
            x_new = clip(x_new + rng.uniform(-0.5, 0.5, size=dim), lb, ub)
        
        f_new = func(x_new)
        
        # Update the best candidate
        if f_new < best_f:
            best_x = x_new
            best_f = f_new
    
    return best_x
