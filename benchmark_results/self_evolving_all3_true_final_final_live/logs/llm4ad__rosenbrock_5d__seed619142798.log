def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    c = 1.0 / (dim + 1.4)
    weights = 2.38 * (np.random.rand(dim) - 0.5)
    p_mean = np.zeros(dim)
    p_cov = np.eye(dim)
    best_x = None
    best_y = float('inf')

    for _ in range(budget):
        x = clip(p_mean + rng.randn(dim))
        y = func(x)
        if y < best_y:
            best_x = x
            best_y = y

        w = weights * (np.exp(2 - np.dot(weights, x) ** 2) - 1)
        p_cov = c * np.outer(w, w) + p_cov
        u = rng.randn(dim)
        v = rng.randn(dim)
        e = np.einsum('...,...->...', w, u) / np.linalg.norm(np.einsum('...,...->...', w, u))
        x_new = p_mean + np.sqrt(p_cov).dot(e)
        x_new = clip(x_new)

        weights *= 0.5
        p_mean += (x - x_new) * np.sqrt(p_cov).dot(v)
        p_cov -= np.outer((x - x_new), (x - x_new)) * c

    return best_x
