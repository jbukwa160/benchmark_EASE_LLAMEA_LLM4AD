def algorithm(func, dim, lb, ub, budget, rng):
    def bounded_simplex(x):
        return np.minimum(np.maximum(x, lb), ub)

    x0 = 1 + (ub - 1) * rng.rand(dim)
    best_x = x0.copy()
    best_f = func(bounded_simplex(best_x))

    for _ in range(budget // dim):
        bounds = [(lb, ub)] * dim
        res = differential_evolution(func, bounds=bounds, x0=x0, maxiter=50)
        x_new = res.x

        if rng.rand() < 0.1: # 10% chance to accept new solution regardless of improvement
            best_x = bounded_simplex(x_new.copy())
            best_f = func(best_x)
        elif func(bounded_simplex(x_new)) < best_f:
            best_x = bounded_simplex(x_new.copy())
            best_f = func(best_x)

    return best_x
