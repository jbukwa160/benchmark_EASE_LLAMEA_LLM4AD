def algorithm(func, dim, lb, ub, budget, rng):
    population_size = 100
    elite_size = int(population_size * 0.2)
    mutation_rate = 0.01
    crossover_probability = 0.8

    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(rng, dim, bounds):
        population = rng.uniform(bounds[0], bounds[1], (population_size, dim))
        return population

    def fitness(individual):
        return func(individual)

    def mutate(individual, mutation_rate, lb, ub):
        mutated_individual = individual + rng.normal(0, 1, size=dim) * mutation_rate
        return clip(mutated_individual)

    def crossover(parent1, parent2, rng, crossover_probability):
        if rng.random() < crossover_probability:
            child = (parent1 + parent2) / 2.0
            return child
        else:
            return parent1

    population = generate_initial_population(rng, dim, (lb, ub))
    for _ in range(budget):
        fitnesses = [fitness(individual) for individual in population]
        sorted_indices = np.argsort(fitnesses)
        elite = population[sorted_indices[:elite_size]]
        new_population = []
        for i in range(population_size - elite_size):
            parent1, parent2 = elite[rng.randint(0, elite_size), :], elite[rng.randint(0, elite_size), :]
            child = crossover(parent1, parent2, rng, crossover_probability)
            child = mutate(child, mutation_rate, lb, ub)
            new_population.append(child)
        population = np.array(elite + new_population)

    fitnesses = [fitness(individual) for individual in population]
    best_index = np.argmin(fitnesses)
    return population[best_index]
