def algorithm(func, dim, lb, ub, budget, rng):
    def get_center():
        return 1 + (ub - 1) * rng.uniform(0, 1)

    def get_step_size():
        return (ub - 1) * rng.uniform(0.01, 1)

    center = np.array([get_center() for _ in range(dim)])
    step_size = get_step_size()

    best_solution = np.array([-np.inf])
    best_fitness = np.inf

    for _ in range(budget):
        offspring_population = np.clip(center + rng.normal(0, step_size, size=(2**dim, dim)), lb, ub)
        fitnesses = [func(offspring) for offspring in offspring_population]
        
        new_center = (offspring_population[np.argmin(fitnesses)] * 1.2 + center * 0.8) / 1.2
        step_size *= 1 + rng.uniform(-0.01, 0.01)

        if np.min(np.array(fitnesses)) < best_fitness:
            best_solution = offspring_population[np.argmin(fitnesses)]
            best_fitness = np.min(np.array(fitnesses))

    return best_solution
