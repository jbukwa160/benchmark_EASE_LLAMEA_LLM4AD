def algorithm(func, dim, lb, ub, budget, rng):
    def wrapper(x):
        return func(x)

    bounds = [(lb[i], ub[i]) for i in range(dim)]
    res_de = differential_evolution(wrapper, bounds, x0=rng.rand(dim), strategy='best1exp', maxiter=budget)
    x_best = res_de.x
    for _ in range(budget // 2):
        pso_xmin = -5.0 + rng.rand(dim) * (10.0 - (-5.0))
        pso_xmax = -5.0 + rng.rand(dim) * (10.0 - (-5.0))
        pso_bounds = [(lb[i], ub[i]) for i in range(dim)]
        res_pso = differential_evolution(wrapper, pso_bounds, x0=pso_xmin, strategy='rand1exp', maxiter=budget // 2)
        if wrapper(res_pso.x) < wrapper(x_best):
            x_best = res_pso.x
    return np.clip(x_best, lb, ub)
