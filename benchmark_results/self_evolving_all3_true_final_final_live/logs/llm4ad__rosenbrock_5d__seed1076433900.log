def algorithm(func, dim, lb, ub, budget, rng):
    n = len(rng)
    x = np.random.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        f_x = func(x)
        if f_x < best_f:
            best_f = f_x
            best_x = x.copy()

        grad = np.zeros(dim)
        h = 1e-6 * rng
        for i in range(n):
            dx = np.zeros(dim)
            dx[i] = h
            grad_i = (func(x + dx) - func(x - dx)) / (2.0 * h)

            grad += grad_i

        gamma = 10 ** rng[0]
        step = gamma * np.exp(-np.mean(grad**2))

        x_new = x + step * grad / np.linalg.norm(grad)
        x_new = np.clip(x_new, lb, ub)

        x = x_new.copy()

    return best_x
