def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x, lb, ub)
        return func(x)

    pop_size = 10
    temp = 1000.0
    n_iter = int(budget / (dim * pop_size))
    sigma = 1.0

    population = rng.uniform(lb, ub, (pop_size, dim))

    for _ in range(n_iter):
        for i in range(pop_size):
            delta = rng.normal(0, sigma, dim)
            candidate = population[i] + delta
            candidate = clip(candidate, lb, ub)

            if evaluate(candidate) < evaluate(population[i]):
                population[i] = candidate

            temp *= 0.9999
            if np.random.rand() < np.exp((evaluate(population[i]) - evaluate(candidate)) / temp):
                population[i] = candidate

    best_candidate = population[np.argmin([evaluate(x) for x in population])]
    return best_candidate
