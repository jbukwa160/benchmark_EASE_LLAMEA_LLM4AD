def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.array([ub + rng.rand() * (lb - ub) for _ in range(dim)])
    best_f = float('inf')

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    for _ in range(budget):
        learning_rate = 1.0 / (_ + 1)
        x = best_x.copy()
        
        for i in range(dim - 1):
            grad = (200 * (x[i+1] - x[i]**2) * (2*x[i]**4 + 2*x[i]**2 - x[i+1]) - 2*(x[i] - 1)) 
            x[i+1] -= learning_rate * grad
            x = clip(x, lb, ub)
        
        f = func(x)
        
        if f < best_f:
            best_x = x.copy()
            best_f = f
    
    return best_x
