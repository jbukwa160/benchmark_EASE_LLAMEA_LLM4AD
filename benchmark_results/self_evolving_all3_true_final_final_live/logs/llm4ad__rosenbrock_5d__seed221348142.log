def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def sample(rng):
        x = rng.normal(size=dim)
        return clip(5 * x)

    def evaluate(x):
        return func(x), None  # No gradient needed

    cma = []
    for i in range(budget):
        pop = [sample(rng) for _ in range(dim)]
        f, _ = zip(*[evaluate(x) for x in pop])
        cma.append(np.mean(f))
        if len(cma) > 10 and np.std(cma[-10:]) < 1e-2:
            break
    else:
        # In case of early termination
        pass

    best_x = max(pop, key=func)
    return clip(best_x)
