def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    x = np.random.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = f(best_x)
    current_f = f(x)
    temp = 100
    for _ in range(budget):
        new_x = x + rng.normal(size=x.shape)
        new_x = np.clip(new_x, lb, ub)
        new_f = f(new_x)

        if new_f < current_f:
            x = new_x.copy()
            current_f = new_f

        if new_f < best_f or rng.uniform(0, 1) < np.exp((best_f - new_f) / temp):
            x = new_x.copy()
            best_x = new_x.copy()
            best_f = new_f
            current_f = new_f

        temp *= 0.99  # Time-based adaptive cooling schedule

    return best_x
