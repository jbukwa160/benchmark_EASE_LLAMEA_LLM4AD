def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=(dim,))
    f_best = func(x_best)
    
    for _ in range(budget):
        x_rand = np.random.uniform(lb, ub, size=(dim,))
        
        if rng.rand() < 0.1: # 10% chance of mutation
            idx = rng.choice(dim)
            x_rand[idx] += rng.normal(0, 0.5) # mutate with a small step
        
        f_rand = func(x_rand)
        
        if f_rand < f_best:
            f_best = f_rand
            x_best = x_rand
    
    return x_best
