def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 20 * dim
    mu = int(pop_size / 2)
    sigma = 0.1
    best_sol = None
    best_val = float('inf')
    
    for _ in range(budget):
        X = np.random.uniform(lb, ub, (pop_size, dim))
        
        if rng is not None:
            X = rng.poisson(np.exp(X), size=(pop_size, dim)) / 100.0 + lb
        
        F = func(X)
        idx = np.argsort(F)[:mu]
        X_new = X[idx]
        
        sigma_new = (1 - 1/(2*budget+dim)) * sigma
        X_new += rng.normal(0, sigma_new, size=(mu, dim))
        
        for i in range(pop_size):
            if i < mu:
                X[i] = np.clip(X_new[i], lb, ub)
            else:
                X[i] = np.clip(rng.uniform(lb, ub, size=dim), lb, ub)
        
        F_new = func(X)
        
        idx = np.argsort(F_new)[:mu]
        X_new = X[idx]
        sigma_new = (1 - 1/(2*budget+dim)) * sigma
        
        for i in range(pop_size):
            if i < mu:
                X[i] = np.clip(X_new[i], lb, ub)
        
        F = func(X)
        idx = np.argsort(F)[:mu]
        best_sol = X[idx][-1]
        best_val = F[-1]
    
    return best_sol
