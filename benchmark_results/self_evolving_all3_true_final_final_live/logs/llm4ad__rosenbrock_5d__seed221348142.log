def algorithm(func, dim, lb, ub, budget, rng):
    def log(x):
        return 1e-12 + np.sum(np.log(1 + x))

    mu = 10 * np.ones(dim)
    sigma = 10 * np.ones(dim)
    c = 0.8
    cmu = 1 / (dim * c)
    csigma = 1 / c

    pbest = np.zeros(dim)
    best = np.inf
    w = rng.uniform(-5, 5, size=dim)

    for _ in range(budget):
        y = func(w) + log(rng.uniform(0.01, 1, size=1))

        if y < best:
            best = y
            pbest[:] = w

        z = np.zeros(dim)
        for i in range(dim):
            z[i] = (w[i] - mu[i]) / sigma[i]
            z[i] += cmu * rng.uniform(-1, 1, size=1)

        v = np.zeros(dim)
        for i in range(dim):
            v[i] = (z[i] * sigma[i]) + mu[i]

        w[:] = v

    return pbest
