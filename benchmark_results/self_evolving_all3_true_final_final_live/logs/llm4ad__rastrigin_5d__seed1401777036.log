def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def sample():
        return rng.uniform(lb, ub, size=dim)

    def eval(x):
        x = clip(x)
        return func(x), x

    n_evals = 0
    x_best = None
    f_best = np.inf

    for _ in range(budget // dim):
        x = sample()
        f, x = eval(x)

        if f < f_best:
            f_best = f
            x_best = x

        # Update learning rate and early termination
        std_dev = 1.0 / (np.sqrt(2 * n_evals) + 1e-6)
        if np.random.rand() < 0.5:
            std_dev *= 2
        elif n_evals > budget // dim * 4 and f_best >= func(np.zeros(dim)):
            break

        for i in range(dim):
            x[i] += rng.normal(0, std_dev)

            # Clip to bounds
            x[i] = clip(x[i])

            f, x = eval(x)
            n_evals += 1

            if f < f_best:
                f_best = f
                x_best = x

    return x_best
