def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best = np.array([0.5 * (lb + ub) for _ in range(dim)])
    best_fitness = func(best)
    
    for _ in range(budget):
        population_size = 10
        population = np.random.uniform(lb, ub, size=(population_size, dim))
        
        while True:
            trial_population = population.copy()
            
            for i in range(population_size):
                idxs = np.random.choice(population_size, size=3, replace=False)
                
                u = rng.uniform(-1, 0.5)
                v = rng.uniform(0, 1)
                w = rng.uniform(0, 1)
                c1, c2, c3 = population[idxs]
                
                trial_population[i] = clip(c1 + u * (c2 - c3) + v * (ub - lb))
            
            fitnesses = np.array([func(individual) for individual in trial_population])
            
            if _ == budget // 2:
                best_trial = trial_population[np.argmin(fitnesses)]
                best_fitness_new = np.min(fitnesses)
                
                if best_fitness_new < best_fitness:
                    best = best_trial
                    best_fitness = best_fitness_new
                    
            population = trial_population.copy()
            
            if np.all(np.isclose(trial_population, population)):
                break
                
    return best
