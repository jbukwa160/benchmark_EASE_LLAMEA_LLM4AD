def algorithm(func, dim, lb, ub, budget, rng):
    D = len(dim)
    pop_size = 50
    F = 0.5
    CR = 0.9
    mutpb = 1 / D
    
    x = np.random.uniform(lb, ub, (pop_size, D))
    
    for _ in range(budget):
        f_x = func(x)
        
        idx_best = np.argmin(f_x)
        best = x[idx_best]
        best_f = f_x[idx_best]
        
        for i in range(pop_size):
            v1, v2, v3 = rng.choice(pop_size, 3, replace=False), rng.choice(pop_size, 3, replace=False)
            u = np.where(rng.rand(D) < CR, x[v1, :], best)
            
            for j in range(D):
                if rng.rand() < mutpb:
                    sigma = (ub - lb) / 2
                    nu = best[j] + sigma * rng.randn()
                    nu = max(lb, min(nu, ub))
                    u[j] = nu
            
            f_u = func(u)
            
            if f_u < f_x[i]:
                x[i] = u
                
        pop_size *= 0.9
        
    return best
