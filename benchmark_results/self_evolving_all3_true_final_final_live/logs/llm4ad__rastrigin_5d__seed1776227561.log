def algorithm(func, dim, lb, ub, budget, rng):
    def get_bounds():
        return (np.array(lb) + np.zeros(dim), np.array(ub) + np.zeros(dim))

    def uniform_mutant(x_best, bounds):
        for i in range(dim):
            a = 0 if rng.uniform(0, 1) < 0.5 else rng.uniform(0, 1)
            x_best[i] += a * (bounds[1][i] - bounds[0][i]) * rng.uniform(bounds[0][i], bounds[1][i])
        return x_best

    def differential_mutant(x_best, x_i, bounds):
        for i in range(dim):
            x_best[i] = x_i[i] + 0.5 * (x_best[i] - x_i[i]) + rng.uniform(-1, 1) * (bounds[1][i] - bounds[0][i])
        return x_best

    def clip(candidate, bounds):
        for i in range(dim):
            candidate[i] = max(bounds[0][i], min(bounds[1][i], candidate[i]))
        return candidate

    bounds = get_bounds()
    population_size = 50
    x_best = np.array([rng.uniform(bounds[0][i], bounds[1][i]) for i in range(dim)])

    for _ in range(budget):
        population = [clip(np.array([rng.uniform(bounds[0][i], bounds[1][i]) for i in range(dim)]) + 0.5 * (x_best - np.array([rng.uniform(bounds[0][i], bounds[1][i]) for i in range(dim)])), bounds) for _ in range(population_size)]
        f_values = [func(x) for x in population]

        for i, x_i in enumerate(population):
            mutant_x = uniform_mutant(np.array([f_values[j] + func(np.array(population[j]) - np.array(population[i])) for j in range(population_size)]) / population_size, bounds)
            if rng.uniform(0, 1) < 0.5:
                x_best = differential_mutant(mutant_x, x_i, bounds)

        x_best = clip(x_best, bounds)

    return x_best
