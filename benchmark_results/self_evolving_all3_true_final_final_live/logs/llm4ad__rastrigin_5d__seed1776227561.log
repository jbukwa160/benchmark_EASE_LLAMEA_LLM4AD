def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lower_bound, upper_bound):
        return np.clip(candidate, lower_bound, upper_bound)

    def evaluate(x):
        return func(x) / (10**dim + 1e-6)

    n_candidates = int(np.sqrt(budget))
    population_size = dim * n_candidates
    best = np.zeros(dim)
    best_fitness = float('inf')

    for _ in range(100):  # number of restarts
        current_population = rng.uniform(lb, ub, (population_size, dim))
        for i in range(population_size):
            candidate = current_population[i]
            clipped_candidate = clip(candidate, lb, ub)
            current_population[i] = clipped_candidate

        for generation in range(budget // population_size):
            for i in range(population_size):
                # DE mutation
                a = rng.randint(0, population_size - 1)
                b = rng.randint(0, population_size - 1)
                c = rng.randint(0, population_size - 1)

                mutant = current_population[a] + rng.uniform(-1, 1) * (current_population[b] - current_population[c])
                clipped_mutant = clip(mutant, lb, ub)
                mutant_fitness = evaluate(clipped_mutant)

                # Adaptive mutation
                if rng.random() < 0.5:
                    mutant += rng.uniform(0, 1e-6) * rng.choice(current_population[:, i])

                current_population[i] = clipped_mutant

            current_best_fitness = float('inf')
            for candidate in current_population:
                candidate_fitness = evaluate(candidate)
                if candidate_fitness < current_best_fitness:
                    current_best_fitness = candidate_fitness
                    best_candidate = candidate

            if current_best_fitness < best_fitness:
                best_fitness = current_best_fitness
                best = best_candidate

    return best
