def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    x_best = np.zeros(n)
    f_best = float('inf')
    sigma = 1
    for _ in range(budget):
        y = np.random.uniform(lb, ub, size=n)
        z = x_best + sigma * rng.randn(n)
        clipped_z = np.clip(z, lb, ub)
        candidate = func(clipped_z)
        if candidate < f_best:
            f_best = candidate
            x_best = clipped_z
        stepsize = 0.1
        if _ > budget // 2:
            stepsize = 0.01
        sigma *= np.exp(stepsize * (f_best - func(x_best)))
    return x_best
