def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget - 1):
        mutation_type = rng.choice(['u', 'n'])
        
        if mutation_type == 'u':
            d = np.random.uniform(0, 1, size=dim)
        else:
            d = rng.normal(size=(1, dim))
            
        y = best_x + d
        
        for i in range(dim):
            if rng.random() < 0.5 and rng.random() < 0.5:
                y[0, i] = lb + (ub - lb) * y[0, i]
        
        y_f = func(y)
        
        if y_f < best_f:
            best_x = y
            best_f = y_f
    
    return best_x
