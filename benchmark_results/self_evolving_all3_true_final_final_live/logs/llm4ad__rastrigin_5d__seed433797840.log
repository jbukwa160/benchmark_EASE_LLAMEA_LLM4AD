def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = int(np.sqrt(budget))
    x = rng.uniform(lb, ub, size=(pop_size, dim))

    for _ in range(budget - 1):
        y = np.copy(x)
        for i in range(pop_size):
            v = rng.normal(size=dim)
            mu = (lb + ub) / 2
            y[i] += v * 0.5 * (ub - lb) * (rng.uniform(0, 1) ** 3 - 1)
            y[i] = clip(y[i])
        f_x = func(x)
        f_y = func(clip(y))
        if np.any(f_y < f_x):
            x = y
        else:
            sigma = 0.5 * (ub - lb) / np.sqrt(np.log(pop_size + 1))
            cov = np.eye(dim) * sigma**2
            for i in range(pop_size):
                e = rng.normal(size=dim)
                z = x[i] + e @ cov @ np.linalg.inv(cov).T
                f_z = func(clip(z))
                if f_z < f_x[i]:
                    x[i] = z

    best_idx = np.argmin(func(x))
    return x[best_idx]
