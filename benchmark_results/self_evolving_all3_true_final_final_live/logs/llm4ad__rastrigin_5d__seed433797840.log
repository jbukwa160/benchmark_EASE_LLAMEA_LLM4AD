def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def sample(bounds):
        return [rng.uniform(bounds[0], bounds[1]) for _ in range(dim)]

    def evaluate(individual):
        candidate = clip(np.array(individual))
        return func(candidate)

    population_size = 50
    pop = [sample([lb, ub]) for _ in range(population_size)]
    best_individual = min(pop, key=evaluate)

    for _ in range(budget - population_size):
        differences = []
        for i in range(population_size):
            other1 = pop[np.random.choice(range(population_size), replace=False)]
            other2 = pop[np.random.choice(range(population_size), replace=False)]
            if other1 != other2:
                difference = other2 - other1
            else:
                difference = [rng.uniform(-ub, ub) for _ in range(dim)]
            differences.append(difference)

        offspring = []
        for i in range(population_size):
            weights = rng.uniform(0.5, 1.5, size=dim)
            weighted_sum = np.sum([weights[j] * differences[i][j] for j in range(dim)], axis=0)
            new_individual = pop[i] + 0.8 * weighted_sum
            offspring.append(new_individual)

        pop = [clip(individual) if evaluate(individual) < evaluate(best_individual) else best_individual for individual in pop + offspring]

    return np.array(best_individual)
