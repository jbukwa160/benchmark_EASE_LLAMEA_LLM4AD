def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    best_cost = float('inf')

    for _ in range(budget):
        x = np.clip(rng.uniform(lb, ub, size=dim), lb, ub)

        # Initial random search
        cost = func(x)
        if cost < best_cost:
            best_cost = cost
            best = x

        # Local refinement phase with gradient-free optimization using the L-BFGS-B algorithm
        from scipy.optimize import minimize
        res = minimize(lambda x: func(np.clip(x, lb, ub)), best, method='L-BFGS-B', bounds=[(lb, ub) for _ in range(dim)])

        cost = res.fun
        if cost < best_cost:
            best_cost = cost
            best = res.x

    return best
