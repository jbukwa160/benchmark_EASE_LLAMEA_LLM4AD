def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def objective(x):
        return func(x) / 10**dim

    population = rng.uniform(lb, ub, (budget, dim))
    for i in range(budget - 1):
        fitness = [objective(clip(candidate)) for candidate in population]
        best_idx = np.argmax(fitness)
        if fitness[best_idx] > objective(population[i]):
            population[i] = population[best_idx]
        
        r1, r2, r3 = rng.randint(budget), rng.randint(budget), rng.randint(budget)
        while r1 == i or r2 == i or r3 == i:
            r1, r2, r3 = rng.randint(budget), rng.randint(budget), rng.randint(budget)

        a = population[r1] + 0.5 * (population[best_idx] - population[i])
        b = population[r2]
        c = population[r3]

        for j in range(dim):
            candidate = clip(a[j] + rng.uniform(-1, 1) * (b[j] - a[j]) + rng.uniform(-1, 1) * (c[j] - a[j]))
            population[i][j] = candidate

    fitness = [objective(clip(candidate)) for candidate in population]
    best_idx = np.argmax(fitness)
    
    return clip(population[best_idx])
