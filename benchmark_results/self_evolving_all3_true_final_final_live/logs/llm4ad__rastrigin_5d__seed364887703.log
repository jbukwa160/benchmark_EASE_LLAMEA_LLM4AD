def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(mean, cov):
        candidate = np.random.multivariate_normal(mean, cov)
        return clip(candidate)

    best_x = np.zeros(dim)
    best_fx = float('inf')

    for i in range(budget):
        mean = rng.normal(size=dim)
        cov = 10 * np.eye(dim) + 0.1 * np.outer(rng.normal(size=(dim,)), rng.normal(size=(dim,)))
        candidate = generate_candidate(mean, cov)

        fx = func(candidate)

        if fx < best_fx:
            best_x = candidate
            best_fx = fx

    return best_x
