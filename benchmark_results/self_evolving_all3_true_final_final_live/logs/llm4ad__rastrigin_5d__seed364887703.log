def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_solution(dim, lb, ub):
        return rng.uniform(lb, ub, size=dim)

    def evaluate(individual):
        x = clip(individual)
        return func(x), x

    current_best = None
    temperature = 1.0
    cooling_rate = 0.99

    for _ in range(budget):
        # Simulated Annealing (SA) phase
        individual = generate_initial_solution(dim, lb, ub)
        score, best_individual = evaluate(individual)

        if current_best is None or score < func(current_best[1]):
            current_best = (score, best_individual)

        temperature *= cooling_rate

        # Differential Evolution (DE) phase
        noise = rng.uniform(-1, 1, size=dim)
        offspring = clip(best_individual + noise)
        score, _ = evaluate(offspring)

        if score < func(current_best[1]):
            current_best = (score, offspring)

    return current_best[1]
