def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    current_best = np.array([0] * dim)
    current_best_fitness = float('inf')
    temperature = 1.0
    for i in range(budget):
        new_solution = rng.uniform(lb, ub, size=dim)
        new_solution = clip(new_solution)
        new_fitness = func(new_solution)
        
        if new_fitness < current_best_fitness:
            current_best = new_solution
            current_best_fitness = new_fitness
        
        delta = current_best_fitness - new_fitness
        if delta > 0 or rng.uniform(0, 1) < np.exp(-delta / temperature):
            current_best = new_solution
            current_best_fitness = new_fitness
        
        temperature *= 0.9999  # Slowly decrease the temperature

    return clip(current_best)
