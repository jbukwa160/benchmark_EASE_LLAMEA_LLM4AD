def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    for i in range(1, budget+1):
        x_temp = x_best + 0.01 * rng.normal(size=dim)
        x_temp = np.clip(x_temp, lb, ub)
        
        f_temp = func(x_temp)
        
        if f_temp < f_best:
            x_best = x_temp
            f_best = f_temp
        
        for j in range(dim):
            x_temp_j = x_best.copy()
            x_temp_j[j] += 0.5 * rng.normal()
            x_temp_j = np.clip(x_temp_j, lb, ub)
            
            f_temp_j = func(x_temp_j)
            
            if f_temp_j < f_best:
                x_best = x_temp_j
                f_best = f_temp_j
    
    return x_best
