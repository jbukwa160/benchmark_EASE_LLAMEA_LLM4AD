def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return func(x)

    def clip(candidate):
        clipped_candidate = np.clip(candidate, lb, ub)
        return clipped_candidate

    def differential_evolution(population, bounds, cost_func, max_iter, seed):
        population_size = len(population)
        for _ in range(max_iter):
            for i in range(population_size):
                j = rng.randint(0, population_size-1)
                while j == i:
                    j = rng.randint(0, population_size-1)

                mutant = 2*rng.rand(dim) - 1
                trial = population[i] + mutant * (population[j] - population[i])
                trial = clip(trial)

                if cost_func(trial) < cost_func(population[i]):
                    population[i] = trial

        return population

    def simulated_annealing(initial_solution, bounds, cost_func, budget):
        T = 1000
        alpha = 0.99
        solution = initial_solution
        for _ in range(budget):
            T *= alpha
            trial = solution + (2*rng.rand(dim) - 1)
            trial = clip(trial)

            delta_cost = cost_func(trial) - cost_func(solution)
            if delta_cost < 0 or rng.rand() < np.exp(-delta_cost/T):
                solution = trial

        return solution

    population = np.random.uniform(lb, ub, (100, dim))
    best_solution = clip(population[0])
    best_cost = Rosenbrock(best_solution)

    for _ in range(budget-1):
        differential_evolution(population.tolist(), [(lb,ub)]*dim, Rosenbrock, 10, rng)
        population.sort(key=Rosenbrock)
        if Rosenbrock(clip(population[0])) < best_cost:
            best_solution = clip(population[0])
            best_cost = Rosenbrock(best_solution)

    solution = simulated_annealing(best_solution, [(lb,ub)]*dim, Rosenbrock, budget-99)
    return np.array(solution)
