def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lower, upper):
        return np.clip(x, lower, upper)

    def evaluate(x):
        return func(x)

    population_size = 100
    learning_rate = 1.0
    sigma = 2.0
    max_iter_without_improvement = 10

    x_best = np.array([random.uniform(lb, ub) for _ in range(dim)])
    f_best = evaluate(clip(x_best, lb, ub))

    iter_count = 0
    without_improvement_count = 0

    while True:
        if iter_count >= budget or without_improvement_count > max_iter_without_improvement * (budget // population_size):
            break

        x_candidates = np.array([clip(np.add(x_best, rng.normal(0, sigma)), lb, ub) for _ in range(population_size)])

        f_candidates = np.array([evaluate(x) for x in x_candidates])

        new_x_best = x_candidates[np.argmin(f_candidates)]
        new_f_best = np.min(f_candidates)

        if new_f_best < f_best:
            without_improvement_count = 0
            f_best = new_f_best
            x_best = clip(new_x_best, lb, ub)
        else:
            without_improvement_count += 1

        sigma *= (f_best / np.mean(f_candidates)) ** learning_rate if learning_rate != 0 else 1

        iter_count += 1

    return clip(x_best, lb, ub)
