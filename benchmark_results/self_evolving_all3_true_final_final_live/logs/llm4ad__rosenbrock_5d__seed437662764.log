def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    n = len(lb)
    assert n == dim
    assert n == len(ub)

    x_best = np.array([0.5 * (lb[i] + ub[i]) for i in range(n)])
    f_best = float('inf')

    best_pop = [np.copy(x_best) for _ in range(budget)]

    def clip(x):
        return np.clip(x, lb, ub)

    for i in range(1, budget):
        pop = [clip(np.array([rng.uniform(lb[j], ub[j]) for j in range(n)])) for _ in range(i)]
        pop.append(best_pop[i-1])

        def fitness(x):
            y = evaluate(x)
            return (y - f_best) / abs(f_best)

        pop = sorted(pop, key=fitness)
        new_pop = []

        for x in pop[:int(0.2*i)]:
            new_x = np.array([rng.uniform(lb[j], ub[j]) for j in range(n)])
            new_x += 0.5 * (x - best_pop[i-1])
            new_pop.append(clip(new_x))

        for _ in range(int((i-1)*0.2)):
            x, y = pop[_], pop[_+1]
            c1, c2 = rng.uniform(), rng.uniform()
            new_x = np.array([x[j] + c1 * (y[j] - x[j]) for j in range(n)])
            new_pop.append(clip(new_x))

        pop.extend(new_pop)
        pop.sort(key=fitness)

        f_new = evaluate(pop[-1])
        if f_new < f_best:
            f_best = f_new
            best_pop[i] = np.copy(pop[-1])

    return best_pop[-1]
