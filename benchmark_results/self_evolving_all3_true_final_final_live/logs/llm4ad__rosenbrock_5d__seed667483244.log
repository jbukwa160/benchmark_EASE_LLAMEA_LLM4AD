def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(current_x):
        # Generate a new candidate by sampling from a mixture of Gaussians
        means = np.array([np.random.uniform(lb[i], ub[i]) for i in range(dim)])
        covariances = np.eye(dim) * 0.1 + 0.01 * np.eye(dim)
        
        distribution = multivariate_normal(mean=means, cov=covariances)
        new_x = distribution.rvs()
        
        # Clip the candidate to the bounds
        return np.clip(new_x, lb, ub)

    def evaluate_candidate(x):
        return func(x), x

    current_x = rng.uniform(lb, ub)
    best_x = current_x.copy()
    current_min = float('inf')
    
    for i in range(budget):
        candidate_x = generate_candidate(current_x)
        
        # Evaluate the candidate
        current_val, candidate_x = evaluate_candidate(candidate_x)
        
        if current_val < current_min:
            current_min = current_val
            best_x = candidate_x
        
        # Adaptive cooling schedule: decrease temperature by 1e-5 with each iteration
        T = max(0.001, 0.995 ** i)
        
        # Accept new candidate with probability based on temperature and difference in fitness values
        delta = current_min - current_val
        if delta < 0 or rng.uniform(0, 1) < np.exp(-delta / T):
            current_x = candidate_x
            current_min = current_val
    
    return best_x
