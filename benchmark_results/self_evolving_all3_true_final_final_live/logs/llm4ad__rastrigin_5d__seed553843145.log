def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def generate_candidate(params, sigma, t):
        x = params + rng.normal(size=(dim,), loc=0., scale=sigma)
        return clip(x, lb, ub)

    def sa_step(func, current_x, current_y, new_x, temperature):
        delta = func(new_x) - current_y
        if delta < 0:
            return new_x, current_y + delta
        else:
            prob = np.exp(-delta / temperature)
            if rng.uniform(0., 1.) < prob:
                return new_x, current_y + delta
            else:
                return current_x, current_y

    params = rng.uniform(size=(dim,), loc=lb, scale=ub - lb)
    best_x = params.copy()
    best_y = func(params)

    for t in range(budget):
        sigma = 1. / np.sqrt(t + 1)
        candidate_x = generate_candidate(params, sigma, t)
        candidate_y = func(candidate_x)
        if candidate_y < best_y:
            best_x = candidate_x
            best_y = candidate_y

        new_x, new_y = sa_step(func, best_x, best_y, generate_candidate(best_x, sigma * 2., t), np.exp(-t / budget))
        if new_y < best_y:
            best_x = new_x
            best_y = new_y

    return best_x
