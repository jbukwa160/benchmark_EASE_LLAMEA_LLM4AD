def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_process(X, Y, n_restarts=10):
        mean = 0.
        var = 1.
        return mean + var * rng.normal(size=X.shape)

    X_best = None
    f_best = float('inf')
    
    for _ in range(budget):
        if np.random.rand() < 0.5:
            X_new = rng.uniform(lb, ub, size=(dim,))
        else:
            mu, cov = gaussian_process(X[:budget], Y[:budget])
            sigma = np.sqrt(np.diag(cov))
            idx = np.argmax(sigma)
            X_new = X[idx] + rng.normal(size=(dim,))
        
        f_new = func(X_new)
        
        if f_new < f_best:
            f_best = f_new
            X_best = X_new
        
        X = np.vstack((X, X_new)) if len(X) < budget else X
        Y = np.append(Y, f_new)
    
    return X_best
