def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def gradient_descent(x0, func, step_size=1e-4, max_iter=100):
        x = x0.copy()
        for _ in range(max_iter):
            gradient = np.zeros(dim)
            for i in range(dim):
                x_try = clip(x + np.eye(dim)[i] * step_size)
                gradient[i] = func(x_try) - func(x)
            x -= 0.5 * step_size ** 2 * gradient
        return x

    def differential_evolution(func, dim, lb, ub, budget):
        population_size = int(np.sqrt(budget))
        pop = rng.uniform(lb, ub, (population_size, dim))
        for _ in range(budget - population_size):
            new_pop = np.zeros((population_size, dim))
            for i in range(population_size):
                other_idx = rng.choice(population_size, size=3)
                x1 = pop[other_idx[0]]
                x2 = pop[other_idx[1]]
                x3 = pop[other_idx[2]]
                new_pop[i] = clip(x1 + 0.5 * (x2 - x3))
            pop = np.concatenate((pop, new_pop), axis=0)
        return gradient_descent(np.mean(pop, axis=0), func)

    best_x = differential_evolution(func, dim, lb, ub, budget)
    return best_x
