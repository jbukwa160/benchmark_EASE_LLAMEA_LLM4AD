def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    mu = 0.5 * (lb + ub)
    s = 2.38 / (D ** 0.5) * (ub - lb)
    x = mu + s * rng.randn(D)
    y_best = func(x)

    for i in range(budget):
        lambda_ = int(4 + 3 * D ** 0.5)
        z = x + np.dot(rng.randn(D, lambda_), np.linalg.cholesky(np.cov(x) + np.eye(D))) / (2 ** 0.5)
        clipped_z = np.clip(z, lb, ub)
        y_new = func(clipped_z)

        if y_new < y_best:
            x = clipped_z
            y_best = y_new

    return x
