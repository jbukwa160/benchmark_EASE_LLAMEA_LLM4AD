def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x) + 1e-6 * np.sum(np.abs(x))  # Adding a small penalty for non-zero values

    best = None
    for _ in range(budget):
        x = np.zeros(dim)
        while True:
            y = x + rng.uniform(-5, 5, size=dim)  # DE-like perturbation
            if evaluate(y) < evaluate(x):
                x = y
            elif rng.rand() < 0.1:  # SA-like acceptance probability
                x = y
            else:
                break

        if best is None or evaluate(x) < evaluate(best):
            best = x.copy()

    return np.clip(best, lb, ub)
