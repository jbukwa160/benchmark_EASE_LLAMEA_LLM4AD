def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best = None
    for _ in range(budget):
        x = clip(rng.uniform(lb, ub, size=dim))
        f_x = func(x)
        
        if best is None or f_x < func(best):
            best = x

        grad = np.zeros(dim)
        eps = 1e-3
        for i in range(dim):
            x_plus_eps = clip(x + eps * np.eye(dim, k=i))
            f_x_plus_eps = func(x_plus_eps)
            grad[i] = (f_x_plus_eps - f_x) / eps

        step_size = 0.01
        x_new = clip(best - step_size * grad)

        if func(x_new) < func(best):
            best = x_new

    return best
