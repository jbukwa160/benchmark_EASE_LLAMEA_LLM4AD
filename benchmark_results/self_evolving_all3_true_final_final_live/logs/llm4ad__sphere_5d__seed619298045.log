def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    pop_size = int(np.ceil(budget ** (1 / 3)))
    sigma = 0.5
    mean = np.zeros(dim)
    best_x = mean.copy()
    best_y = float('inf')
    x_best = mean.copy()

    for i in range(pop_size):
        z = rng.normal(size=dim)
        x = mean + sigma * z
        y = evaluate(x)

        if y < best_y:
            best_y = y
            x_best = x

    for _ in range(budget - pop_size):
        z = rng.normal(size=pop_size, loc=0, scale=sigma)
        x_new = mean[:, None] + sigma * np.column_stack((z, np.zeros((1, dim))))
        y_new = evaluate(x_new)

        best_idx = np.argmin(y_new)
        if y_new[best_idx] < best_y:
            best_y = y_new[best_idx]
            x_best = x_new[best_idx]

        mean = (mean * pop_size + sigma**2 * z) / (pop_size + 1)

    return clip(x_best)
