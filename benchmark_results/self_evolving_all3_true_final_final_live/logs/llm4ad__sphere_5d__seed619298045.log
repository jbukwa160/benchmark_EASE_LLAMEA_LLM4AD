def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_y = float('inf')
    
    for _ in range(budget):
        x0 = np.array([rng.uniform(lb, ub) for _ in range(dim)])
        
        res = minimize(lambda x: func(x), x0, method='Nelder-Mead', bounds=[(lb, ub)]*dim)
        
        if res.fun < best_y:
            best_x = res.x
            best_y = res.fun
    
    return np.clip(best_x, lb, ub)
