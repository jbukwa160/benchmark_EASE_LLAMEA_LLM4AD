def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    x = lb + (ub - lb) * rng.rand(dim)
    f = func(x)
    
    for _ in range(budget):
        if f < best_f:
            best_x = x
            best_f = f
        
        # Self-adaptive sampling strategy: bias exploration towards unexplored areas
        if np.all(x == (lb + ub) / 2):
            x += 0.1 * rng.uniform(-1, 1, size=dim)
        else:
            x += 0.01 * rng.uniform(-1, 1, size=dim)
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
        
        f = func(x)
    
    return best_x
