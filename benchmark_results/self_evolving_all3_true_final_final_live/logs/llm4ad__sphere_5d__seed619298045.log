def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    sigma = 1.0
    best_x = x.copy()
    best_f = func(x)
    best_f_history = [best_f]

    for _ in range(budget - 1):
        z = clip(best_x + rng.normal(0, sigma, size=dim))
        f_z = func(z)
        if f_z < best_f:
            best_x = z
            best_f = f_z
        else:
            sigma *= np.exp(rng.uniform(-1, 0))

        best_f_history.append(best_f)

    return clip(best_x)
