def algorithm(func, dim, lb, ub, budget, rng):
    population_size = 100
    elite_size = int(population_size * 0.2)
    mutation_rate = 1 / (dim * 10)

    def generate_initial_population():
        return rng.uniform(lb, ub, size=(population_size, dim))

    def evaluate_candidates(candidates):
        return np.array([func(candidate) for candidate in candidates])

    population = generate_initial_population()

    for _ in range(budget):
        fitnesses = evaluate_candidates(population)
        best_candidate = population[np.argmin(fitnesses)]
        elite_candidates = population[:elite_size]
        new_candidates = []

        for i in range(elite_size, population_size):
            parent1, parent2 = rng.choice(elite_candidates, size=2, replace=False)
            child = (parent1 + parent2) / 2
            if rng.rand() < mutation_rate:
                child += rng.uniform(-1, 1, size=dim)
            new_candidates.append(child)

        population = np.concatenate((elite_candidates, new_candidates))
        population = np.clip(population, lb, ub)

    return best_candidate
