def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidates(mu, sigma):
        candidates = mu + sigma * (rng.normal(size=(budget, dim)) - 0.5)
        return clip(candidates)

    def evaluate(candidates):
        values = func(candidates)
        best_idx = np.argmin(values)
        best_value = values[best_idx]
        best_candidate = candidates[best_idx]
        return best_value, best_candidate

    mu = rng.uniform(low=lb, high=ub, size=dim)
    sigma = 1.0
    sigma_history = [sigma]

    for _ in range(budget):
        candidates = generate_candidates(mu, sigma)
        values, best_candidate = evaluate(candidates)
        if values < func(mu):
            mu = best_candidate
        sigma = min(5 * np.mean(np.abs(best_candidate - mu)), 10.0)
        sigma_history.append(sigma)

    return mu
