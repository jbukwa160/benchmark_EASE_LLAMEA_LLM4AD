def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    x = np.random.uniform(lb, ub, size=(dim,))
    T = (ub - lb) / 2.0
    for _ in range(budget):
        y = clip(x + rng.normal(size=x.shape))
        if func(y) < func(x):
            x = y
        else:
            delta = func(y) - func(x)
            T *= np.exp(-delta / (func(x) + 1e-8)) ** 0.95
    return x
