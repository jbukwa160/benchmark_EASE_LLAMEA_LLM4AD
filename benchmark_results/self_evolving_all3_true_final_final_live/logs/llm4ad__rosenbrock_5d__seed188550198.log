def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    x = np.random.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = evaluate(best_x)
    for _ in range(budget):
        for i in range(dim):
            v = best_x.copy()
            idxs = [j for j in range(dim) if j != i]
            np.random.shuffle(idxs)
            for j in idxs:
                v[j] = rng.uniform(lb, ub)
            f = evaluate(v)
            if f < best_f:
                best_f = f
                best_x = v.copy()
        x += 0.1 * (best_x - x) + 0.01 * np.random.normal(size=(1, dim))
        x = np.clip(x, lb, ub)
    return best_x
