def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        d = (ub - lb) * rng.randn(dim)
        while True:
            step_size = 0.1 * (ub - lb)
            x_new = x + step_size * d
            x_new = np.clip(x_new, lb, ub)
            
            f_new = func(x_new)
            if f_new < best_f:
                best_x = x_new.copy()
                best_f = f_new
                
            if rng.rand() > 0.1:  # accept new solution with probability 0.9
                x = x_new
            
            if np.linalg.norm(d) > 10 * step_size or rng.rand() < 0.5:
                break
    
    return best_x
