def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def sa_search(func, dim, lb, ub, max_steps, rng):
        T = 1e6
        alpha = 0.99
        best_x = rng.uniform(lb, ub, size=dim)
        best_y = func(best_x)
        for _ in range(max_steps):
            new_x = clip(rng.normal(best_x, scale=np.sqrt(T), size=dim))
            new_y = func(new_x)
            if new_y < best_y:
                best_x = new_x
                best_y = new_y
            elif rng.uniform(0, 1) < np.exp((best_y - new_y) / T):
                best_x = new_x
                best_y = new_y
            T *= alpha
        return best_x

    def cma_es_search(func, dim, lb, ub, budget, x0, sigma):
        n_samples = int(budget ** (1 / 4))
        pop_size = max(1, int(n_samples ** (1 / 3)))
        mu = np.zeros(dim)
        cmu = np.eye(dim) * sigma
        for _ in range(int(n_samples)):
            x_new = clip(mu + rng.normal(size=dim))
            y_new = func(x_new)
            if y_new < func(clip(mu)):
                mu, cmu = x_new, cmu * (1 - 0.1 / (n_samples + 1)) + np.outer(x_new - mu, x_new - mu) * (0.1 / (n_samples + 1))
        return clip(mu)

    def main_search(func, dim, lb, ub, budget, rng):
        x0 = rng.uniform(lb, ub, size=dim)
        sa_best_x = sa_search(func, dim, lb, ub, int(budget ** (2 / 3)), rng)
        cma_es_best_x = cma_es_search(func, dim, lb, ub, budget - int(budget ** (2 / 3)) * 1.5, x0, np.sqrt(ub - lb))
        return clip(np.array([func(sa_best_x), func(cma_es_best_x)]).argmin())

    return main_search(func, dim, lb, ub, budget, rng)
