def algorithm(func, dim, lb, ub, budget, rng):
    X = rng.uniform(lb, ub, size=(budget, dim))
    
    for i in range(budget - 1):
        x_best = X[i]
        f_best = func(x_best)
        
        for j in range(i + 1, budget):
            x_candidate = np.clip(X[j] + 0.5 * (X[j] - x_best), lb, ub)
            if func(x_candidate) < f_best:
                x_best = x_candidate
                f_best = func(x_candidate)
        
        X[i + 1] = x_best
    
    return X[-1]
