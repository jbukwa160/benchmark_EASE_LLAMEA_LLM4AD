def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    T = 1000.0
    cooling_rate = 0.99

    for _ in range(budget):
        v = np.random.uniform(-1, 1, size=dim) * rng + x
        v = clip(v)

        f_v = func(v)
        f_best_x = func(best_x)

        if f_v < f_best_x:
            best_x = v

        delta_E = f_v - f_best_x

        if delta_E <= 0 or np.random.rand() < np.exp(-delta_E / T):
            x = v
        else:
            alpha = rng.uniform()
            u = x + alpha * (v - x)
            u = clip(u)

            f_u = func(u)
            f_best_x = func(best_x)

            if f_u < f_best_x and np.random.rand() < np.exp(-delta_E / T):
                best_x = u

        T *= cooling_rate

    return best_x
