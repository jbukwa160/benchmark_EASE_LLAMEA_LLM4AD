def algorithm(func, dim, lb, ub, budget, rng):
    best_candidate = np.zeros(dim)
    best_fitness = float('inf')
    
    for _ in range(budget):
        candidate = (ub - lb) * rng.rand(dim) + lb
        
        # Clip the candidate to bounds
        clipped_candidate = np.clip(candidate, a_min=lb, a_max=ub)
        
        fitness = func(clipped_candidate)
        
        if fitness < best_fitness:
            best_candidate = clipped_candidate
            best_fitness = fitness
    
    return best_candidate
