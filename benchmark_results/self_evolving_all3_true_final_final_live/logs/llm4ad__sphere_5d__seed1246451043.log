def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    sigma = 1.0
    c1 = 1.0
    c_mu = 1.0

    for _ in range(budget):
        y = clip(x + rng.normal(0, sigma, size=dim))
        f_y = func(y)

        if f_y < func(best_x):
            best_x = y.copy()

        c1 *= 2 / (dim + np.sqrt(2 * dim) + 1)
        sigma *= np.exp(c_mu * (np.sqrt(np.finfo(float).eps) ** 3))
        x += rng.normal(0, sigma, size=dim)

    return best_x
