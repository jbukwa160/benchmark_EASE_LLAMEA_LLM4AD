def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        f = func(x)
        if f < best_f:
            best_x = x.copy()
            best_f = f

        H = np.eye(dim) * 1e-3
        A = np.diag(np.ones(dim))
        b = np.zeros(dim)
        c = np.zeros(dim)

        for i in range(dim):
            lbd = (ub[i] - lb[i]) / rng.uniform(0, 2)
            x_new = x.copy()
            x_new[i] -= lbd
            f_new = func(x_new)
            if f_new < f:
                H[i, i] += 1e-3

        q, r = np.linalg.qr(np.eye(dim) + np.sqrt(H))
        d = -np.dot(q.T, np.dot(r, x))
        alpha = np.inf
        for i in range(budget // dim):
            f_new = func(x + d * (1 / (i + 1)))
            if f_new < best_f:
                best_x = x + d * (1 / (i + 1)).copy()
                best_f = f_new
            alpha = min(alpha, i / (i + 2))

        x = best_x.copy() if np.random.rand() > rng.uniform(0, 1) else x - alpha * d

    return best_x
