def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        if any(i < lb or i > ub for i in x):
            return float('inf')
        return func(x)

    def step_mean(x):
        return (np.sum(x) / len(x)) * np.ones_like(x)

    def cma_step(x0, mu, sigma, lambda_, budget):
        n = len(x0)
        y = [x0 + sigma * np.random.randn(n)]
        for _ in range(lambda_ - 1):
            next_y = []
            for x in y:
                p = step_mean(x)
                z = x - 2 * mu / (n + 1) * (x - p)
                w = np.linalg.cholesky(np.eye(n) + 2 * sigma**2 * n / (n + 1) * np.outer(x - p, x - p))
                next_y.append(z + sigma * np.dot(w, np.random.randn(n)))
            y = next_y
        y.sort(key=evaluate)
        return y[-1], evaluate(y[-1])

    x0 = rng.uniform(lb, ub, dim)
    mu, sigma = 1.0, 1.0
    for _ in range(budget):
        x, f = cma_step(x0, mu, sigma, 10, budget - _)
        if f < evaluate(x0):
            x0 = x
        mu += 2 * (evaluate(x) - evaluate(x0)) / (budget + 1)**2
        sigma *= np.exp(2.38**2 / (4 * budget + len(x0)))
    return x0
