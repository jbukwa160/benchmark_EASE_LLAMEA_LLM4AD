def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    sigma = 0.5 * (ub - lb)
    mu = np.zeros(dim)
    cov = np.eye(dim) * sigma ** 2
    best_x = None
    best_f = np.inf

    for _ in range(budget):
        x = rng.multivariate_normal(mu, cov)
        x = np.clip(x, lb, ub)

        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x

        # CMA-ES update rules
        delta = x - mu
        z = np.dot(np.linalg.cholesky(cov), rng.randn(dim))
        cov += 0.1 * np.outer(delta, delta)
        mu += sigma ** 2 * delta / np.sum(z ** 2)

    return best_x
