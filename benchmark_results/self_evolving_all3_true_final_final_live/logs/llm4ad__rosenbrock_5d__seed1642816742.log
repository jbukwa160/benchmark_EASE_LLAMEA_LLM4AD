def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def fitness(x):
        return func(x)

    pop_size = int(budget ** 0.5)
    npop = pop_size // 2
    bounds = [(lb, ub) for _ in range(dim)]
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = fitness(clip(x_best))

    for i in range(pop_size):
        if i < npop:
            trial = clip(rng.normal(x_best, 1e-3, size=dim))
        else:
            trial = clip(rng.uniform(lb, ub, size=dim))

        f_trial = fitness(trial)
        if f_trial < f_best:
            x_best = trial
            f_best = f_trial

    return x_best
