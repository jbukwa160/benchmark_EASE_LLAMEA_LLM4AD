def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(size, bounds):
        return (bounds[1] - bounds[0]) * rng.uniform(size=(size, dim)) + bounds[0]

    def clip_candidates(candidates, lower, upper):
        return np.clip(candidates, a_min=lower, a_max=upper)

    def evaluate_individual(individual, func):
        return func(individual)

    def update_population(population, children, func):
        scores = [evaluate_individual(individual, func) for individual in population]
        scores.extend([evaluate_individual(individual, func) for individual in children])
        indices = np.argsort(scores)
        return [population[i] for i in indices[:len(population)]], \
               [children[i] for i in indices[len(population):]]

    def adapt_strategy(population):
        mean = np.mean(population, axis=0)
        cov = np.cov(population, rowvar=False)
        return mean, cov

    population_size = 10 * dim
    initial_population = generate_initial_population(population_size, (lb, ub))
    best_individual = None

    for i in range(budget):
        children = []
        for _ in range(int(0.2 * population_size)):
            mean, cov = adapt_strategy(initial_population)
            candidate = rng.multivariate_normal(mean, cov)
            clipped_candidate = clip_candidates(candidate, lb, ub)
            children.append(clipped_candidate)

        initial_population, children = update_population(initial_population, children, func)
        score = evaluate_individual(np.mean(initial_population, axis=0), func)
        if best_individual is None or score < best_individual[1]:
            best_individual = (np.mean(initial_population, axis=0), score)

    return np.array(best_individual[0])
