def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(np.clip(x, lb, ub))

    x = np.random.uniform(lb, ub, size=(1, dim))
    best_x = x.copy()
    best_f = float('inf')

    for _ in range(budget):
        y = x.copy()
        for i in range(dim):
            z = y.copy()
            idx = rng.choice(np.delete(range(dim), i))
            z[i] = x[idx] + 0.5 * (x[idx] - x[i]) + rng.uniform(-1, 1) / np.sqrt(i+1)
            y[i] = evaluate(z)
        if y < best_f:
            best_x = y.copy()
            best_f = y
        idx = rng.choice(np.delete(range(budget), 0))
        x = best_x + rng.uniform(-1, 1)

    return best_x
