def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    bounds = [(lb, ub) for _ in range(dim)]
    pop_size = 50
    temp = 10.0
    cooling_rate = 0.99

    x = np.array([rng.uniform(lb, ub) for _ in range(pop_size * dim)]).reshape((pop_size, dim))

    for _ in range(budget):
        f_x = func(x)
        y = np.zeros_like(x)

        for i in range(pop_size):
            mutant = clip(x[i] + rng.normal(size=dim) * 0.1)
            difference = x - mutant
            trial = np.where(rng.randint(0, dim+1, size=dim) == 0, mutant, clip(mutant + difference[rng.randint(0, pop_size-1), :]))

            y[i] = func(trial)

        best_i = np.argmin(y)
        if f_x[best_i] < temp * f_x[np.argmin(f_x)]:
            x[best_i] = trial[best_i]

        temp *= cooling_rate

    return clip(x[np.argmin(func(x))])
