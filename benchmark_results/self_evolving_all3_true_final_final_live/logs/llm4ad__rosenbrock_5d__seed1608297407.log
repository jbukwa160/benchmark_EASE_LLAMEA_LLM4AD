def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    bounds = [(lb, ub) for _ in range(dim)]

    def wrapper(args):
        candidate = [arg for arg in args]
        candidate = clip(np.array(candidate))
        return func(candidate), None

    result = differential_evolution(wrapper, bounds=bounds, maxiter=budget, strategy='best1exp', population_size=10)

    best_candidate = result.x
    best_fitness = result.fun

    for _ in range(rng):
        new_result = differential_evolution(wrapper, bounds=bounds, maxiter=int(budget / rng), strategy='best1exp', population_size=10)
        if new_result.fun < best_fitness:
            best_candidate = new_result.x
            best_fitness = new_result.fun

    return best_candidate
