def algorithm(func, dim, lb, ub, budget, rng):
    def get_sample(x):
        return func(x) + rng.uniform(0, 1)

    def get_ucb(x, t):
        return func(x) - (ub - lb)**2 / (t**2 * dim)

    def local_search(x_best, t):
        x = np.copy(x_best)
        dx = (ub - lb) / dim
        for i in range(dim):
            old_func_val = get_sample(x)
            x[i] += rng.uniform(-dx/10, dx/10)
            new_func_val = get_sample(x)
            if new_func_val < old_func_val:
                x_best = np.copy(x)
                func_vals[t] = new_func_val
        return x_best

    num_starts = int(np.sqrt(budget))
    t = 0
    best_x = np.zeros(dim)
    func_vals = np.zeros(num_starts)

    for _ in range(num_starts):
        x = lb + (ub - lb) * rng.random((dim,))
        while get_sample(x) > func_vals[rng.randint(0, num_starts)]:
            x_best = local_search(x, t)
            if get_ucb(x_best, t) > func_vals[rng.randint(0, num_starts)]:
                x = np.copy(x_best)
            else:
                break
        for i in range(t, budget):
            best_x = local_search(best_x, i+1)
            func_vals[i%num_starts] = get_sample(best_x)
            t += 1

    return best_x
