def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    learning_rate = 0.1
    
    for _ in range(budget):
        gx = func(x)
        d = np.zeros(dim)
        
        for i in range(dim):
            xi = x[i]
            if rng.random() < 0.5:
                xi += 0.001
            else:
                xi -= 0.001
            
            clipped_xi = max(lb, min(ub, xi))
            d[i] = func(clipped_xi) - gx
        
        learning_rate *= np.exp(-np.mean(np.abs(d)))
        
        x -= learning_rate * d
        
        if func(x) < func(best_x):
            best_x = x.copy()
    
    return best_x
