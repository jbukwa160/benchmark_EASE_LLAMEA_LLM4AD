def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def discrete_search(dim, lb, ub, budget):
        points = []
        for i in range(budget):
            point = [rng.uniform(lb, ub) for _ in range(dim)]
            points.append(clip(point))
        return points

    def gradient_update(points, dim, func):
        new_points = []
        for point in points:
            gradient_dir = np.random.choice([-1, 1], size=dim)
            new_point = [max(lb, min(ub, p + 0.01 * d)) for p, d in zip(point, gradient_dir)]
            new_points.append(new_point)
        return new_points

    points = discrete_search(dim, lb, ub, int(budget / 2))
    best_point = clip(np.array(points[np.argmin([func(p) for p in points])]))
    
    for _ in range(int(budget / 2)):
        points = gradient_update(points, dim, func)
        new_best_point = clip(np.array(points[np.argmin([func(p) for p in points])]))
        if func(new_best_point) < func(best_point):
            best_point = new_best_point
    return best_point
