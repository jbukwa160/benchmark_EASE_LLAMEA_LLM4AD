def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(mean, sigma):
        return mean + sigma * (rng.standard_normal(dim) - 0.5)

    x = np.zeros((1, dim))  # initial guess
    mean = np.mean(x)
    sigma = 0.25

    for _ in range(budget):
        candidate = generate_candidate(mean, sigma)
        clipped_candidate = np.clip(candidate, lb, ub)
        
        fx = func(clipped_candidate)

        if fx < func(x):
            x = clipped_candidate
            mean = np.mean(x)
    
    return x
