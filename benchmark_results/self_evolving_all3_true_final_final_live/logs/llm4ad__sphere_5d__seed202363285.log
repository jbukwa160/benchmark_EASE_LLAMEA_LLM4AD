def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(size=dim)
    best_x = x.copy()
    best_y = func(x)
    T = 1.0
    step_size = 1e-5

    for _ in range(budget):
        y = func(clip(x + rng.normal(scale=step_size, size=dim)))
        if y < best_y:
            best_x = x.copy()
            best_y = y
        T *= (budget - _) / budget * 0.9999
        step_size *= np.exp(-1/T)

        if rng.uniform() < np.exp((best_y - y) / T):
            x = clip(x)
        else:
            x += rng.normal(scale=step_size, size=dim)

    return best_x
