def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = func(x)
    
    T = 1.0
    alpha = 0.99
    
    for _ in range(budget):
        delta = 2 * rng.randn(dim) - 1
        x_new = x + delta
        
        # Clip to bounds
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new
        
        if rng.rand() < np.exp(-(f_new - best_f) / T):
            x = x_new
            
        # Simulated annealing cooling schedule
        T *= alpha
    
    return best_x
