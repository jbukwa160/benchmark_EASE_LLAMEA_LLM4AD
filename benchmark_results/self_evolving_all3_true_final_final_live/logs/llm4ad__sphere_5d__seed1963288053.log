def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    f_best = func(x_best)
    
    step_size = 0.1
    
    for _ in range(budget):
        # Compute gradient using finite differences
        grad = np.zeros(dim)
        for i in range(dim):
            eps = 1e-6
            x_plus = x_best.copy()
            x_minus = x_best.copy()
            x_plus[i] += eps
            x_minus[i] -= eps
            
            f_plus = func(x_plus)
            f_minus = func(x_minus)
            
            grad[i] = (f_plus - f_minus) / (2 * eps)
        
        # Perturb in the direction of the gradient
        perturbation = np.sign(grad) * step_size
        
        x_candidate = x_best + perturbation
        
        # Clip candidate to bounds
        for i in range(dim):
            x_candidate[i] = min(max(x_candidate[i], lb), ub)
        
        f_candidate = func(x_candidate)
        
        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate
    
    return x_best
