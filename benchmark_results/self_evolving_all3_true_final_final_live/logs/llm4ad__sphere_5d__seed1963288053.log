def algorithm(func, dim, lb, ub, budget, rng):
    n = int(np.ceil(budget / (ub - lb)**dim))
    grid_size = int(round((ub - lb) / n)) + 1
    best_candidate = None
    best_value = float('inf')
    
    for i in np.random.choice(range(n), replace=False, size=n):
        candidate = rng.uniform(lb, ub, dim)
        
        if budget > 0:
            value = func(candidate)
            
            if value < best_value and (ub - lb)**dim * n < budget:
                best_candidate = candidate
                best_value = value
                
            budget -= (ub - lb)**dim
    
    return np.clip(best_candidate, a_min=lb, a_max=ub)
