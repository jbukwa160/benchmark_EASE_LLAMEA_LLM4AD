def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget - 1):
        x_new = x_best + rng.uniform(-0.1, 0.1, size=dim)
        f_new = func(np.clip(x_new, lb, ub))

        if f_new < f_best:
            f_best = f_new
            x_best = x_new

    return np.array([np.min(x_best)])
