def algorithm(func, dim, lb, ub, budget, rng):
    n = int(np.ceil(np.log(budget)))
    x = np.zeros(dim)
    sigma_init = 1.0
    sigma = sigma_init
    mean_x = np.zeros(dim)
    covariances = np.eye(dim) * sigma_init**2

    for i in range(n):
        y = np.random.multivariate_normal(mean_x, covariances)
        x_new = lb + (ub - lb) * rng.uniform(size=dim)
        x_new = x_new + y
        x_new = np.clip(x_new, lb, ub)

        f_x = func(x_new)
        f_x_best = func(x)

        if f_x < f_x_best:
            x = x_new

        sigma *= 0.9 ** (1 / (i+2))
        covariances *= 0.9 ** (1 / (i+2))

    return x
