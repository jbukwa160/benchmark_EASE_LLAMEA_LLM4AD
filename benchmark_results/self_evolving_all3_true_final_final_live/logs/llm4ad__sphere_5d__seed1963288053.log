def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    for i in range(budget):
        x_new = lb + (ub - lb) * rng.rand(dim)
        f_new = func(x_new)
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
        gradient_step_size = 1e-5
        for j in range(dim):
            eps = np.zeros(dim)
            eps[j] = gradient_step_size
            x_candidate = x_best + eps
            if all(lb <= c <= ub for c in x_candidate):
                f_candidate = func(x_candidate)
                if f_candidate < f_best:
                    f_best = f_candidate
                    x_best = x_candidate
    return np.clip(x_best, lb, ub)
