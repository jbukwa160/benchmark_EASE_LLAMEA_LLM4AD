def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(x):
        return x + rng.uniform(-1, 1) * (ub - lb)

    current = rng.uniform(lb, ub, size=dim)
    best = current.copy()
    for _ in range(budget):
        candidate = generate_candidate(current)
        clipped_candidate = np.clip(candidate, lb, ub)
        if func(clipped_candidate) < func(best):
            best = clipped_candidate
        delta = func(clipped_candidate) - func(current)
        if delta < 0:
            current = clipped_candidate
        else:
            probability = np.exp(-delta / rng.uniform(1e-3, 1))
            if rng.random() < probability:
                current = clipped_candidate
    return best
