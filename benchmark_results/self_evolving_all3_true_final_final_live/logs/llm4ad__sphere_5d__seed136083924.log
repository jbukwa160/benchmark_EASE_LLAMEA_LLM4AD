def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    n_particles = 20
    w = 0.7298  # inertia coefficient
    c1 = 1.49618  # cognitive coefficient
    c2 = 1.49618  # social coefficient
    lr = 0.5  # initial learning rate

    particles = rng.uniform(lb, ub, (n_particles, dim))
    velocities = np.zeros((n_particles, dim))
    personal_best = np.copy(particles)
    global_best = np.inf

    for _ in range(budget):
        for i in range(n_particles):
            velocities[i] = w * velocities[i] + c1 * rng.uniform(0, 1) * (personal_best[i] - particles[i]) + \
                            c2 * rng.uniform(0, 1) * (global_best - particles[i])

            new_particle = clip(particles[i] + velocities[i])
            f_new = func(new_particle)
            if f_new < func(particles[i]):
                personal_best[i] = new_particle
                global_best = min(global_best, f_new)

        # adaptive learning rate
        lr = max(lr * 0.99, 0.01)

        # reinitialize particles with high fitness
        for i in range(n_particles):
            if func(particles[i]) > 1e-3:
                particles[i] = rng.uniform(lb, ub)
                velocities[i] = np.zeros(dim)

    return clip(global_best)
