def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(clip(x))

    for _ in range(budget - 1):
        x = clip(np.array(rng.uniform(lb, ub, size=dim)))
        f = func(x)

        if f < best_f:
            best_f = f
            best_x = x

        alpha = max(0.01, (best_f / f) ** 0.5)
        step_size = 1e-6 * np.exp(alpha - _ / budget)
        x += rng.normal(size=dim) * step_size

    return clip(best_x)
