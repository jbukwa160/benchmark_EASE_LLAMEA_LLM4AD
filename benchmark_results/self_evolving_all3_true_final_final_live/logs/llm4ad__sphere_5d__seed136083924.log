def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(mean, cov):
        return mean + cov @ rng.standard_normal((dim,))

    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    best = lb + (ub - lb) * rng.uniform(size=(dim,))
    best_fitness = func(best)
    
    for _ in range(budget):
        mean = best.copy()
        cov = 0.1 * np.eye(dim)
        
        while True:
            candidate = get_candidate(mean, cov)
            candidate = clip(candidate)
            
            fitness = func(candidate)
            
            if fitness < best_fitness:
                best = candidate
                best_fitness = fitness
                
            if rng.uniform() < 0.5:
                break
            
            # Adapt covariance matrix based on success/failure history
            alpha_c = 1 / (2 + np.log(1 - rng.uniform()))
            cov = (1 - alpha_c) * cov + alpha_c * candidate[:, None].T @ candidate[None, :]
    
    return best
