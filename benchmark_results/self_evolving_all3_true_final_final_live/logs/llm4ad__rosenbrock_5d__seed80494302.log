def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    D = np.eye(n)
    mu = np.zeros(n)
    sigma = 0.1
    N = int(budget / n) + 1
    
    for i in range(N):
        y = rng.normal(size=n)
        x = mu + sigma * np.dot(D, y)
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
        
        fx = func(x)
        
        if i == 0 or fx < func(mu):
            mu = x
            D = (1 - 2 * rng.uniform(0, 1, size=n**2).reshape(n, n)) * D
        
        sigma *= 1 + 1 / (n * (i + 1))
        
    return mu
