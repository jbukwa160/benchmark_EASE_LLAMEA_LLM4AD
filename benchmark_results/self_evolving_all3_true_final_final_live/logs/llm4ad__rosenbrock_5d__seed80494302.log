def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    x = np.random.uniform(lb, ub, (dim,))
    sigma = 1.0
    lambda_ = int(np.sqrt(budget))
    mu = 1/lambda_
    cm = np.eye(dim)
    best = x.copy()
    budget_left = budget

    while budget_left > 0:
        z = rng.normal(size=(lambda_, dim))
        y = x + sigma * np.dot(z, np.linalg.cholesky(cm))
        y = np.clip(y, lb, ub)
        
        fitness = objective(y)
        budget_left -= lambda_

        if fitness < objective(best):
            best = y.copy()
            cm *= 1 + (fitness - objective(best)) / mu
        
        if budget_left == 0:
            break

    return best
