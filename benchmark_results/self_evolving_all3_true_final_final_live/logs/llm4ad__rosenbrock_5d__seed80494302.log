def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x = (ub + ub) / 2 * np.ones(dim)
    T = 1000.0
    best_x = x.copy()
    f_best = func(best_x)

    for _ in range(budget):
        i = rng.choice(dim)
        y = x.copy()
        delta = rng.normal(0, 1e-4, size=dim) if rng.random() < 0.5 else rng.uniform(-1e-3, 1e-3, size=dim)
        delta[i] = 0
        y[i] += delta[i]
        y = clip(y, lb, ub)

        f_y = func(y)
        if f_y <= f_best or np.exp((f_best - f_y) / T) > rng.random():
            x = y.copy()
            f_best = f_y

        if rng.random() < 0.1:
            j = rng.choice(dim)
            z = best_x + rng.uniform(0, 1e-3, size=dim)
            z[j] += rng.normal(-1e-2, 1e-2) if rng.random() < 0.5 else rng.uniform(-1e-2, 1e-2)
            z = clip(z, lb, ub)

            f_z = func(z)
            if f_z <= f_best:
                x = z.copy()
                best_x = z.copy()

        T *= 0.99

    return best_x
