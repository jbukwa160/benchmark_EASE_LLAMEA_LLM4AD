def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(pop_size, dim, lb, ub):
        return (ub - lb) * rng.random((pop_size, dim)) + lb
    
    def calculate_fitness(population, func):
        fitness = np.zeros(len(population))
        for i in range(len(population)):
            fitness[i] = func(population[i])
        return fitness
    
    def selection(population, fitness, pop_size):
        idx = np.argsort(fitness)[:pop_size]
        selected_population = population[idx]
        return selected_population
    
    def crossover(parent1, parent2):
        child = (parent1 + parent2) / 2
        return child
    
    def mutation(individual, lb, ub, rng):
        for i in range(len(individual)):
            if rng.random() < 0.01:
                individual[i] += np.random.uniform(-1, 1)
                if individual[i] < lb:
                    individual[i] = lb
                elif individual[i] > ub:
                    individual[i] = ub
        return individual
    
    def simulated_annealing(individual, func):
        T = 1000.0
        alpha = 0.9
        while T > 1e-6:
            delta = np.random.uniform(-10, 10)
            new_individual = individual + delta
            new_fitness = func(new_individual)
            if new_fitness < func(individual):
                individual = new_individual
            else:
                probability = np.exp((func(individual) - new_fitness) / T)
                if rng.random() < probability:
                    individual = new_individual
            T *= alpha
        return individual
    
    population = generate_initial_population(budget, dim, lb, ub)
    fitness = calculate_fitness(population, func)
    
    for _ in range(1000):
        selected_population = selection(population, fitness, budget // 2)
        
        for i in range(len(selected_population)):
            parent1 = selected_population[i]
            parent2 = np.random.choice(selected_population)
            child = crossover(parent1, parent2)
            mutated_child = mutation(child, lb, ub, rng)
            
            population[i] = mutated_child
            population[i + budget // 2] = simulated_annealing(mutated_child, func)
        
        fitness = calculate_fitness(population, func)
    
    idx = np.argmin(fitness)
    return population[idx]
