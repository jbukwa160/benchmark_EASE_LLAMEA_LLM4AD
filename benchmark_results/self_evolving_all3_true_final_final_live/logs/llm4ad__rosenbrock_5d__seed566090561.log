def algorithm(func, dim, lb, ub, budget, rng):
    def bounded(x):
        return np.minimum(np.maximum(x, lb), ub)

    pop_size = 10 * (dim + 1)
    sigma_init = 0.5
    mu = rng.normal(0, sigma_init, dim)
    p_w = rng.uniform(0, 1, size=(pop_size, dim))
    f_w = rng.uniform(-1, 1, size=dim)

    for _ in range(budget):
        w = np.zeros(dim)
        for i in range(pop_size):
            x = bounded(mu + sigma_init * (p_w[i] @ f_w))
            w += func(x)
        
        w /= pop_size
        mu = mu - 1 / (pop_size + 1) * rng.normal(0, sigma_init, size=dim)

    return bounded(mu)
