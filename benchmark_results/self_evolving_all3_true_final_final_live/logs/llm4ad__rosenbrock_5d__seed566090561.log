def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def gp_ei(x):
        mean = 0
        for i in range(dim):
            mean += (x[i+1] - x[i]**2)**2 + x[i]**2
        std = 10**(-3) + np.exp(0.5 - rng.uniform(0, 1))
        return mean + 4*std*rng.gauss(0, 1), std

    best_x = lb + (ub - lb)*rng.uniform(0, 1, dim)
    for i in range(budget):
        x_gp_mean, x_gp_std = gp_ei(best_x)
        x_gp_var = x_gp_std**2
        x_gp_uncertainty = 4*np.sqrt(x_gp_var)

        if rng.gauss(0, 1) < -x_gp_mean/x_gp_uncertainty:
            best_x = clip(best_x + x_gp_uncertainty*rng.gauss(0, 1))
        else:
            step_size = (ub - lb)*rng.uniform(0, 1)
            gradient = np.zeros(dim)
            for j in range(dim):
                dx = np.zeros(dim)
                dx[j] = step_size
                gradient[j] = func(clip(best_x + dx)) - func(clip(best_x))
            best_x = clip(best_x + 2*step_size*(0.1 + rng.gauss(0, 1))*gradient)

    return best_x
