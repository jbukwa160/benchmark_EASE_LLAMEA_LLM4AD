def algorithm(func, dim, lb, ub, budget, rng):
    n_dim = len(lb)
    n_parents = max(1, int(budget / (n_dim * 5)))
    mean = rng.uniform(lb, ub, size=dim)
    sigma = rng.uniform(0.01, 0.1)
    cov = np.eye(dim) * sigma
    for i in range(n_parents):
        candidate = np.random.multivariate_normal(mean, cov)
        candidate = np.clip(candidate, lb, ub)
        value = func(candidate)
        if i == 0 or value < best_value:
            best_candidate = candidate.copy()
            best_value = value
    mean += rng.normal(0, sigma, size=dim)
    mean = np.clip(mean, lb, ub)
    cov += np.outer(rng.normal(0, sigma, size=n_dim), rng.normal(0, sigma, size=n_dim))
    for _ in range(n_parents - 1):
        candidate = np.random.multivariate_normal(mean, cov)
        candidate = np.clip(candidate, lb, ub)
        value = func(candidate)
        if value < best_value:
            best_candidate = candidate.copy()
            best_value = value
    return best_candidate
