def algorithm(func, dim, lb, ub, budget, rng):
    def sample(bounds):
        return [np.random.uniform(lb[i], ub[i]) for i in range(dim)]

    def evaluate(x, func):
        return func(np.array(x))

    bounds = [(lb[i], ub[i]) for i in range(dim)]
    best_x = None
    best_y = np.inf

    acquisition_func = lambda x: -evaluate(x, func)
    initial_sample = sample(bounds)

    for t in range(budget):
        x_current = np.array(initial_sample)
        
        # Simulated Annealing step
        T = 10.0
        alpha = 0.95
        while True:
            x_new = x_current + rng.uniform(-1, 1, size=dim) * (ub - lb)
            for i in range(dim):
                x_new[i] = np.clip(x_new[i], lb[i], ub[i])
            
            y_new = evaluate(x_new, func)
            
            if acquisition_func(x_new) > acquisition_func(x_current):
                T *= alpha
                x_current = x_new
                if y_new < best_y:
                    best_x = x_current.copy()
                    best_y = y_new
            else:
                if np.random.rand() < np.exp((acquisition_func(x_new) - acquisition_func(x_current)) / T):
                    x_current = x_new
                    if y_new < best_y:
                        best_x = x_current.copy()
                        best_y = y_new
        
        initial_sample = sample(bounds)

    return best_x
