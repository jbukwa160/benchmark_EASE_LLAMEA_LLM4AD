def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def objective(x):
        return func(x) / 1e6 + np.random.normal(0, 1e-3, size=dim)
    
    best = np.full(dim, (ub - lb) / 2.0)
    best_fitness = objective(best)

    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        x_new = clip(x + np.random.normal(0, 1e-3, size=dim), lb, ub)
        new_fitness = objective(x_new)
        
        if new_fitness < best_fitness:
            best = x_new
            best_fitness = new_fitness

    return best
