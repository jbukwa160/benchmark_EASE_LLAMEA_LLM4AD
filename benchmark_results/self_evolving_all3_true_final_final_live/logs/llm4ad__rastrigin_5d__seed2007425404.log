def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_pop = 50
    f = func
    pop_size = 100
    F = 0.5
    CR = 0.9
    best = None

    for _ in range(budget):
        X = np.random.uniform(lb, ub, (pop_size, D))
        for i in range(pop_size):
            if best is None or f(X[i]) < f(best):
                best = X[i]
        V = np.zeros((n_pop, D))
        for i in range(n_pop):
            idx = rng.choice(pop_size, size=D, replace=False)
            V[i] = X[idx, :]
        U = np.copy(V)
        for i in range(pop_size):
            r1, r2, r3 = rng.randint(0, n_pop, size=3)
            while r1 == r2 or r1 == r3 or r2 == r3:
                r1, r2, r3 = rng.randint(0, n_pop, size=3)
            U[i] = V[r1] + F * (V[r2] - V[r3])
            for j in range(D):
                if rng.random() < CR or U[i, j] > X[i, j]:
                    U[i, j] = np.clip(X[i, j] + np.random.uniform(-1, 1), lb, ub)
        X = np.copy(U)

    return best
