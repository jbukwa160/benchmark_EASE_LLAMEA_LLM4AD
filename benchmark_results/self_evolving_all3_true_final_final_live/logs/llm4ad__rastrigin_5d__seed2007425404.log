def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def rastrigin(x):
        return func(x) + 10 * len(x)

    best_solution = np.array([0.5] * dim)
    best_fitness = float('inf')

    for _ in range(budget):
        # Differential Evolution mutation
        mutation_factor = rng.uniform(0, 1)
        trial_solution = best_solution + mutation_factor * (rng.normal(size=dim) * 2 - 1)

        # Clip the candidate solution to bounds
        trial_solution = clip(trial_solution)

        # Simulated Annealing acceptance probability
        temperature = max(1e-3, 0.99 ** _)
        accept_prob = np.exp((rastrigin(best_solution) - rastrigin(trial_solution)) / temperature)

        if rng.random() < accept_prob:
            best_solution = trial_solution
            best_fitness = rastrigin(best_solution)

    return best_solution
