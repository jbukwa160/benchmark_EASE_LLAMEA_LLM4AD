def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)
    learning_rate = 0.1
    for _ in range(budget):
        x_new = x_best + rng.normal(0, learning_rate, size=dim)
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
        else:
            learning_rate /= 1.01
    return x_best
