def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_candidate = rng.uniform(lb, ub, size=dim)
    best_value = func(clip(best_candidate))

    for _ in range(budget - 1):
        midpoint = (lb + ub) / 2
        candidate = np.zeros(dim)
        for i in range(dim):
            if rng.random() < 0.5:
                candidate[i] = lb + (ub - lb) * rng.uniform(0, 1)
            else:
                candidate[i] = midpoint + (ub - lb) / 2 * rng.uniform(-1, 1)

        candidate = clip(candidate)
        value = func(candidate)

        if value < best_value:
            best_candidate = candidate
            best_value = value

    return best_candidate
