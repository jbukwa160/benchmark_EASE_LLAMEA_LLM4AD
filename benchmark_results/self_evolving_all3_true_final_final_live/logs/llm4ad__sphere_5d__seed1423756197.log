def algorithm(func, dim, lb, ub, budget, rng):
    simplex = np.array([(0, ) * dim + i for i in range(budget)])
    best_x = np.copy(simplex[0])
    best_f = func(best_x)

    for _ in range(1, budget):
        for i in range(budget):
            new_x = simplex[i] - 2 * (simplex[i] - simplex[np.argmin(func(simplex))]) / rng
            if lb <= new_x <= ub:
                new_f = func(new_x)
                if new_f < best_f:
                    best_f, best_x = new_f, new_x
                    simplex[i] = new_x
                else:
                    simplex[i] = np.copy(best_x)

    return best_x
