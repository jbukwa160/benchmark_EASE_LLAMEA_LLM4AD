def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(-5.0, 5.0, size=dim)
    sigma = (ub - lb) / 2.0
    iter_count = 0
    while iter_count < budget:
        num_candidates = 10 * dim
        candidates = np.clip(rng.normal(x_best, sigma, size=(num_candidates, dim)), lb, ub)
        f_values = [func(candidate) for candidate in candidates]
        indices = np.argsort(f_values)[:10]
        candidates = candidates[indices]
        f_values = f_values[indices]
        
        if np.mean(f_values) < func(x_best):
            x_best = np.mean(candidates, axis=0)
            
        sigma *= 1.01 - (iter_count / budget)**2
        iter_count += 1
    
    return x_best
