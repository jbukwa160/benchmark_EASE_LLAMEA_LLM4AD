def algorithm(func, dim, lb, ub, budget, rng):
    num_particles = 50
    num_iterations = int(budget / num_particles)
    particles = np.random.uniform(lb, ub, (num_particles, dim))
    velocities = np.zeros((num_particles, dim))

    for _ in range(num_iterations):
        fitnesses = np.array([func(p) for p in particles])
        best_particle_idx = np.argmin(fitnesses)
        best_particle = particles[best_particle_idx]
        global_best = best_particle

        for i in range(num_particles):
            r1 = rng.uniform(0, 1)
            r2 = rng.uniform(0, 1)

            if r1 < 0.5:
                velocities[i] += 0.5 * (particles[i] - global_best) + 0.3 * (particles[i] - best_particle)
            else:
                velocities[i] += 0.5 * (particles[i] - global_best) + 0.2 * np.cos(2 * np.pi * rng.uniform(lb, ub))

        particles += velocities

        for i in range(num_particles):
            for j in range(dim):
                if particles[i, j] < lb:
                    particles[i, j] = lb
                elif particles[i, j] > ub:
                    particles[i, j] = ub

    fitnesses = np.array([func(p) for p in particles])
    best_particle_idx = np.argmin(fitnesses)
    return particles[best_particle_idx]
