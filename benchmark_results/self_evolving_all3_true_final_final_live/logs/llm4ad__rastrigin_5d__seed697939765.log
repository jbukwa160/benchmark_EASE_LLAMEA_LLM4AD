def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    sigma = 0.5
    x_best = np.random.uniform(lb, ub, (pop_size, dim))
    f_best = np.inf

    for i in range(budget):
        y = np.zeros((pop_size, dim))

        for j in range(pop_size):
            idx1 = np.random.randint(0, pop_size)
            idx2 = np.random.randint(0, pop_size)

            x1 = x_best[idx1]
            x2 = x_best[idx2]

            z = 0.5 * (x1 + x2)

            for k in range(dim):
                if rng.rand() < 0.5:
                    z[k] += sigma * (x1[k] - x2[k])
                else:
                    z[k] -= sigma * (x1[k] - x2[k])

            y[j] = np.clip(z, lb, ub)

        f_y = func(y)
        f_x_best = func(x_best)

        idx = np.argsort(f_y)[0]

        if f_y[idx] < f_best:
            x_best = y[idx]
            f_best = f_y[idx]

    return x_best
