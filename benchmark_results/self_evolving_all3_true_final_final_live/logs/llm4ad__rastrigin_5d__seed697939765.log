def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        delta = (ub - lb) * rng.randn(dim)
        x_new = x + 0.1 * delta

        # clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)

        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new

        # accept worse solution with probability 0.1
        if rng.rand() < 0.1 and f_new > best_f:
            x = x_new.copy()

    return best_x
