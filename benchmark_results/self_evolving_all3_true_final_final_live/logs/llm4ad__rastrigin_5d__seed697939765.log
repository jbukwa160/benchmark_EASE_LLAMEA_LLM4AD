def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(best_x, rng):
        return best_x + (ub - lb) * rng.uniform(-1, 1, size=dim)

    def evaluate(x):
        x = np.clip(x, lb, ub)
        return func(x), x

    def accept(new_solution, current_solution, temperature):
        if new_solution < current_solution:
            return True
        else:
            return np.random.rand() < np.exp((current_solution - new_solution) / temperature)

    best_x = np.zeros(dim)
    current_best_value = float('inf')
    for t in range(budget):
        candidate = generate_candidate(best_x, rng)
        value, x = evaluate(candidate)
        if value < current_best_value:
            current_best_value = value
            best_x = x
        temperature = 10 / (t + 1)  # adaptive cooling schedule

        if t % budget // 5 == 0:  # restart strategy every 20% of the iterations
            best_x = np.zeros(dim)

        if accept(value, current_best_value, temperature):
            current_best_value = value
    return best_x
