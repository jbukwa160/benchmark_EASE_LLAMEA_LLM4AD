def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(current_solution, best_solution, rng):
        if rng.random() < 0.1:
            # Random search: randomly choose a dimension to change
            i = rng.randint(dim)
            current_solution[i] += (rng.uniform(-5, 5) * 2 - 1) / np.sqrt(i + 1)
            current_solution = clip(current_solution)
        else:
            # Simulated annealing: perturb the current solution based on temperature
            temperature = max(0.01, 10 / (budget + i))
            noise = rng.uniform(-temperature, temperature)
            current_solution += noise
            current_solution = clip(current_solution)

        return current_solution

    def evaluate_candidate(candidate):
        return func(candidate)

    current_solution = np.zeros(dim)
    best_solution = current_solution.copy()
    best_fitness = float('inf')

    for i in range(budget):
        candidate = generate_candidate(current_solution, best_solution, rng)
        candidate_fitness = evaluate_candidate(candidate)

        if candidate_fitness < best_fitness:
            best_solution = candidate
            best_fitness = candidate_fitness

        current_solution = best_solution.copy()

    return best_solution
