def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        delta = 0.1 * (ub - lb) * np.ones(dim)
        noise = rng.uniform(-delta, delta, size=dim)
        new_x = np.clip(x + noise, lb, ub)

        f_new = func(new_x)
        if f_new < best_f:
            best_x = new_x.copy()
            best_f = f_new

        x = new_x.copy()

    return best_x
