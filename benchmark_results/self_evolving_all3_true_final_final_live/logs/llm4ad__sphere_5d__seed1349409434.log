def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    learning_rate = 1e-6
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Sample a direction
        d = rng.uniform(-1, 1, size=dim)

        # Clip the direction to bounds
        d = np.clip(d, -1, 1)

        # Calculate step size
        step_size = 1 / (func(x) + 1e-8)

        # Update x
        x = x + step_size * d

        # Clip x to bounds
        x = np.clip(x, lb, ub)

        # Evaluate function at new x
        f = func(x)

        # Update best solution if necessary
        if f < best_f:
            best_x = x.copy()
            best_f = f

    return best_x
