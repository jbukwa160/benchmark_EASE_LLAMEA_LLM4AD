def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    num_parents = int(pop_size * 0.2)
    F = 1.5
    CR = 0.9
    mu = 20
    
    # Initialize the population
    x = np.random.uniform(lb, ub, (pop_size, dim))
    
    for _ in range(budget):
        # Evaluate the function at the current population
        f_x = func(x)
        
        # Find the parents
        idx = np.argsort(f_x)[:num_parents]
        x_parents = x[idx]
        
        # Create offspring using DE/rand/1/bin strategy
        y = np.zeros((pop_size, dim))
        for i in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size, 3)
            if rng.random() < CR or rng.random() < 1/pop_size:
                y[i] = x_parents[rng.randint(num_parents), :] + F * (x[r1, :] - x[r2, :]) + rng.uniform(-1, 1) * (x[r3, :] - x_parents[rng.randint(num_parents), :])
        
        # Clip the offspring to the bounds
        y = np.clip(y, lb, ub)
        
        # Evaluate the function at the new population
        f_y = func(y)
        
        # Apply polynomial mutation
        for i in range(pop_size):
            if rng.random() < 1/pop_size:
                idx_mutated = rng.randint(0, dim-1)
                mu_val = rng.uniform(lb, ub) + (ub-lb)*np.power(rng.uniform(0, 1), 1/mu)*(y[i, idx_mutated] - lb)
                y[i, idx_mutated] = np.clip(mu_val, lb, ub)
        
        # Replace the population with the new one
        x = y
        
    # Return the best individual found so far
    f_x = func(x)
    idx_best = np.argmin(f_x)
    return x[idx_best]
