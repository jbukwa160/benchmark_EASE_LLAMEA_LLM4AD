def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    D = 10 * dim + sum([np.sin(2 * np.pi * x_i) for x_i in x])
    return D

    n_gen = int(budget)
    pop_size = 100
    N = int(pop_size / 2)
    F = 0.5
    CR = 0.9

    # Initial population
    X = rng.uniform(lb, ub, (pop_size, dim))
    fit = np.array([objective(x) for x in X])

    best = np.argmin(fit)
    best_sol = X[best]

    for gen in range(n_gen):
        idx1, idx2, idx3 = rng.randint(pop_size, size=3)
        while idx1 == idx2 or idx1 == idx3 or idx2 == idx3:
            idx1, idx2, idx3 = rng.randint(pop_size, size=3)

        # Differential Evolution
        mutant = X[idx1] + F * (X[idx2] - X[idx3])
        cross_idx = np.random.rand(dim) < CR

        # Crossover
        trial = mutant.copy()
        trial[cross_idx] = X[idx1][cross_idx]

        # Selection
        fit_trial = objective(trial)
        if fit_trial < fit[idx1]:
            X[idx1] = trial
            fit[idx1] = fit_trial

        # Simulated Annealing
        p = 0.01
        if np.random.rand() < p:
            idx4, idx5 = rng.randint(pop_size, size=2)
            while idx4 == idx5 or idx4 == idx1 or idx5 == idx1:
                idx4, idx5 = rng.randint(pop_size, size=2)

            mutant_sa = X[idx4] + 0.1 * (X[idx5] - X[idx1])
            cross_idx_sa = np.random.rand(dim) < CR

            trial_sa = mutant_sa.copy()
            trial_sa[cross_idx_sa] = X[idx4][cross_idx_sa]

            fit_trial_sa = objective(trial_sa)
            if fit_trial_sa < fit[idx1]:
                X[idx1] = trial_sa
                fit[idx1] = fit_trial_sa

        # Update best solution
        new_best = np.argmin(fit)
        if fit[new_best] < fit[best]:
            best = new_best
            best_sol = X[best]

    return best_sol
