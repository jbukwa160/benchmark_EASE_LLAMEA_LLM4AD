def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, a_min=lb, a_max=ub)

    def initial_candidate(rng, dim):
        return rng.uniform(size=(dim))

    def evaluate(candidate):
        clipped_candidate = clip(candidate, lb, ub)
        return func(clipped_candidate)

    current_best = np.inf
    temperature = 1.0

    for _ in range(budget):
        candidate = initial_candidate(rng, dim)
        value = evaluate(candidate)

        if value < current_best:
            current_best = value
            best_candidate = clip(candidate, lb, ub)

        alpha = rng.uniform(0, 1)
        delta = rng.normal(loc=0, scale=temperature)
        new_candidate = clip(best_candidate + delta, lb, ub)

        new_value = evaluate(new_candidate)

        if new_value < current_best:
            best_candidate = new_candidate
            current_best = new_value

        if alpha > np.exp(- (new_value - current_best) / temperature):
            current_best = new_value
            best_candidate = new_candidate

        temperature *= 0.9999  # Adaptive cooling schedule

    return best_candidate
