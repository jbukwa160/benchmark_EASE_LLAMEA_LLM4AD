def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return func(x)

    best_solution = np.random.uniform(lb, ub, size=dim)
    current_solution = best_solution.copy()
    temperature = 1.0
    accepted_solutions = 0

    for _ in range(budget):
        new_solution = current_solution + rng.normal(size=dim) * 0.01
        new_solution = np.clip(new_solution, lb, ub)

        delta = Rosenbrock(new_solution) - Rosenbrock(current_solution)
        if delta < 0:
            accepted_solutions += 1
            current_solution = new_solution
            best_solution = new_solution if Rosenbrock(best_solution) > Rosenbrock(current_solution) else best_solution

        elif np.exp(-delta / temperature) > rng.random():
            accepted_solutions += 1
            current_solution = new_solution

        if accepted_solutions >= int(0.9 * budget):
            temperature *= 0.99

    return best_solution
