def algorithm(func, dim, lb, ub, budget, rng):
    def surrogate(x):
        return func(x)

    bounds = [(lb[i], ub[i]) for i in range(dim)]
    
    # Initialize GP model with initial points from a uniform distribution within the bounds
    X_init = np.random.uniform(lb, ub, (10, dim))
    y_init = surrogate(X_init)
    
    # Define kernel and Gaussian process model
    from scipy.stats import norm
    def kernel(x1, x2):
        sqdist = np.sum((x1[:, None] - x2[None, :])**2, axis=2)
        return np.exp(-0.5 * sqdist / 1**2)

    gp_model = {'kernel': kernel, 'X': X_init, 'y': y_init}

    # Acquisition function: expected improvement
    def acquisition(X, gp):
        mu, _ = gp.predict(X)
        sigma = np.sqrt(gp.predict_var(X))
        return (np.max(mu) - mu).ravel()

    # Local search strategy: gradient descent with backtracking line search
    def local_search(x, gp):
        def rosenbrock(params):
            return func(np.array(params))

        x0 = np.array(x)
        n_iter = 100

        for _ in range(n_iter):
            g = np.zeros(dim)
            for i in range(dim):
                eps = np.finfo(float).eps
                deriv = (rosenbrock([x0[i] + eps, ]*dim) - rosenbrock(x0)) / eps
                g[i] = deriv

            step_size = 0.1
            x0_new = x0 - step_size * g

            # Backtracking line search
            for _ in range(100):
                f_new = rosenbrock(x0_new)
                if f_new < func(np.array(x)):
                    x0 = x0_new
                    break
                else:
                    x0_new -= 0.1 * step_size * g

        return x0

    # Main loop
    for _ in range(budget):
        # Sample new points with the acquisition function and update GP model
        X_new = np.random.uniform(lb, ub, (10, dim))
        y_new = surrogate(X_new)
        gp_model['X'] = np.vstack((gp_model['X'], X_new))
        gp_model['y'] = np.hstack((gp_model['y'], y_new))

        # Get the next point by sampling from the acquisition function
        x_best = local_search(np.random.uniform(lb, ub, dim), gp_model)

    return x_best
