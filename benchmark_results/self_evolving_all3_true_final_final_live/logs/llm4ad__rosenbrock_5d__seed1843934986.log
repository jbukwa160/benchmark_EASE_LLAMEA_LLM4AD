def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    T = 1000
    alpha = 1 / (1 + np.log(budget))
    
    for _ in range(budget):
        f_x = func(clip(x))
        
        for i in range(dim):
            y = clip(np.copy(x))
            y[i] += rng.uniform(-ub, ub)
            f_y = func(y)
            
            if f_y < f_x:
                x = y
                f_x = f_y
            elif np.random.rand() < np.exp((f_x - f_y) / T):
                x = y
                f_x = f_y
        
        T *= alpha
    
    return clip(x)
