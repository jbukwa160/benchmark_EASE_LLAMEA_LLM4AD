def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidates):
        return np.clip(candidates, a_min=lb, a_max=ub)

    population = rng.uniform(lb, ub, (budget, dim))
    
    for _ in range(budget):
        scores = func(clip(population))
        
        # Differential evolution step
        diffs = np.abs(population[:, None] - population)
        targets = population + 0.5 * rng.uniform(-1, 1, size=(budget, dim)) * diffs
        
        new_scores = func(clip(targets))
        
        if np.any(new_scores < scores):
            population[np.argmin(new_scores)] = clip(targets[np.argmin(new_scores)])
    
    # Gradient-based optimization step
    for _ in range(budget // 2):
        scores = func(clip(population))
        gradients = np.zeros_like(population)
        
        for i in range(population.shape[0]):
            perturbed = population[i] + rng.uniform(-1, 1, size=dim) * 0.01
            score = func(clip(perturbed))
            
            gradients[i] += (score - scores[i]) / 0.02 * np.sign(np.array(perturbed) - np.array(population[i]))
        
        population -= 0.001 * gradients
        
    return np.argmin(func(clip(population)))
