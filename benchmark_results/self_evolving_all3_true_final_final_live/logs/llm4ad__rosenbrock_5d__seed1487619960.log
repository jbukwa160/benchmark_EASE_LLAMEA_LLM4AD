def algorithm(func, dim, lb, ub, budget, rng):
    n_samples = 10 * dim
    n_candidates = 1000
    num_evals = 0
    x_best = np.array([ub + lb] * dim)
    f_best = float('inf')

    while num_evals < budget:
        # Bayesian optimization to select promising regions
        mu, sigma = 1.0, 0.5  # Initialize mean and standard deviation
        samples = rng.uniform(lb, ub, (n_samples, dim))
        f_samples = np.array([func(x) for x in samples])
        weights = norm.pdf((f_samples - func(x_best)) / sigma)
        weights /= np.sum(weights)

        # Select next candidate based on weighted importance sampling
        new_x = rng.choice(samples, p=weights, size=1)[0]

        # Differential evolution to explore promising regions
        candidates = np.clip(new_x + rng.normal(0, 1.5, (n_candidates, dim)), lb, ub)
        f_candidates = np.array([func(x) for x in candidates])
        idx_best_candidate = np.argmin(f_candidates)

        # Update best solution and number of evaluations
        if f_candidates[idx_best_candidate] < func(new_x):
            new_x = candidates[idx_best_candidate]
            num_evals += n_candidates

        # Update best solution found so far
        if func(new_x) < f_best:
            x_best, f_best = new_x, func(new_x)
            num_evals += 1

    return x_best
