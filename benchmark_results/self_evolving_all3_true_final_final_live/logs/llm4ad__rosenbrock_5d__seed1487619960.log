def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def objective(x):
        return func(x)

    def generate_initial_population(budget):
        population = rng.uniform(lb, ub, (budget, dim))
        return population

    def calculate_fitness(population):
        fitness = [objective(clip(x)) for x in population]
        return np.array(fitness)

    def differential_evolution(population, budget, lb, ub):
        mutation_rate = 0.5
        crossover_rate = 0.9
        for i in range(budget-1):
            idx = rng.choice(population.shape[0], size=3, replace=False)
            x_best = population[idx[np.argmin(calculate_fitness(population[idx]))]]
            trial = clip(x_best + mutation_rate * (population[rng.randint(0, population.shape[0]), :] - x_best))
            if objective(trial) < objective(population[i]):
                population[i] = trial
        return population

    def adapt_crossover_mutation_rate(population):
        best_fitness = np.min(calculate_fitness(population))
        mutation_rate = 1 / (best_fitness + 1)
        crossover_rate = 0.5 + (np.max(calculate_fitness(population)) - best_fitness) / (np.max(calculate_fitness(population)) + 1)
        return mutation_rate, crossover_rate

    population = generate_initial_population(budget)
    for _ in range(100):
        mutation_rate, crossover_rate = adapt_crossover_mutation_rate(population)
        population = differential_evolution(population, budget, lb, ub)

    best_individual = np.argmin(calculate_fitness(population))
    return clip(population[best_individual])
