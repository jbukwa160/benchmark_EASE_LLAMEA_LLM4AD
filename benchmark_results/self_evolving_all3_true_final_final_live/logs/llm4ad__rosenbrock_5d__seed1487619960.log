def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def fitness(x):
        x = clip(x)
        return func(x)

    def cma_es(bounds, budget, population_size=50, step_size=0.1, noise=None, max_std_dev=10, min_std_dev=1e-8):
        n = len(bounds)
        mean = np.array([np.mean(b) for b in bounds])
        sigma = 1
        step_size_factor = 0.01

        population = rng.uniform(lb, ub, (population_size, n))

        for _ in range(budget):
            x = population + noise * sigma if noise else population
            fx = np.array([fitness(x_i) for x_i in x])

            idx = np.argsort(fx)
            population[idx[:population_size]] = x[idx[:population_size]]
            mean = np.mean(population, axis=0)

            if _ % 10 == 0:
                sigma *= np.exp(np.random.normal(0, 0.1) * step_size_factor)
                sigma = max(min(sigma, max_std_dev), min_std_dev)

        return mean

    best_x = cma_es([(lb, ub)]*dim, budget // 100, rng=rng)
    for _ in range(budget - (budget // 100)):
        best_x = cma_es([(lb, ub)]*dim, 1, population_size=10, step_size=0.01, max_std_dev=2, min_std_dev=1e-8, noise=np.random.normal(0, 0.01, size=(10, dim)), rng=rng)

    return clip(best_x)
