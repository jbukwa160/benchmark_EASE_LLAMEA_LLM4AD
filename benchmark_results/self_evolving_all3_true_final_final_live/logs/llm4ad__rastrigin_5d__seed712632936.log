def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(candidate):
        candidate = np.clip(candidate, lb, ub)
        return func(candidate)

    pop_size = int(budget ** (1 / dim))
    sigma = 0.5 * (ub - lb)
    learning_rate = 10 ** (-3)
    population = rng.uniform(lb, ub, size=(pop_size, dim))

    for _ in range(pop_size):
        x_i = np.random.normal(0, sigma, size=dim)
        candidate = population[_] + x_i
        evaluate(candidate)

    iteration = 0
    while iteration < budget:
        iteration += 1

        means = np.mean(population, axis=0)
        covariances = np.cov(population, rowvar=False)

        eigenvalues, eigenvectors = np.linalg.eig(covariances)
        sorted_indices = np.argsort(eigenvalues)[::-1]
        sorted_eigenvectors = eigenvectors[:, sorted_indices]

        new_population = population + means[None, :]
        for i in range(pop_size):
            x_i = np.zeros(dim)
            for j in range(dim):
                if np.random.rand() < 0.5:
                    x_i[j] = (np.sqrt(1 - learning_rate * iteration) * sorted_eigenvectors[j, i]) + means[j]
                else:
                    x_i[j] = (-np.sqrt(1 - learning_rate * iteration) * sorted_eigenvectors[j, i]) + means[j]

            new_population[i] = np.clip(x_i, lb, ub)

        population = new_population

    return np.mean(population, axis=0)
