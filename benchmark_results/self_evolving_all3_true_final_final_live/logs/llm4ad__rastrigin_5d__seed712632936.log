def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(np.clip(x, a_min=lb, a_max=ub))

    x_best = -np.ones(dim)
    f_best = float('inf')

    T = 1000.0
    cooling_rate = 0.99
    N = int(0.1 * budget)

    for _ in range(budget):
        if rng.random() < 0.5:
            # Simulated Annealing
            x_new = np.copy(x_best)
            for i in range(dim):
                delta = rng.uniform(-1, 1) * T
                x_new[i] += delta
                f_new = f(x_new)

                if f_new <= f(x_best):
                    x_best = x_new
                    f_best = f_new

                elif np.exp(-(f_new - f_best) / T) > rng.random():
                    x_best = x_new
                    f_best = f_new

            T *= cooling_rate
        else:
            # Differential Evolution
            x1, f1 = x_best + rng.uniform(-1, 1) * (ub - lb), f(x_best)
            for i in range(N):
                x2, f2 = np.copy(x_best) + rng.uniform(-1, 1) * (ub - lb), f(np.copy(x_best))
                if f2 < f1:
                    x1, f1 = x2, f2
            x_new = np.copy(x1)
            for i in range(dim):
                delta = 0.5 * rng.uniform(-1, 1) * (x1[i] - x_best[i]) + 0.5 * rng.uniform(-1, 1) * (ub - lb)
                x_new[i] += delta
                f_new = f(x_new)

                if f_new < f1:
                    x1, f1 = x_new, f_new

            if f1 < f_best:
                x_best = x1
                f_best = f1

    return x_best
