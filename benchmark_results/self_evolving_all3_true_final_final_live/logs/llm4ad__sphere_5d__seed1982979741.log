def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.random(dim) + lb
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        f = func(x)
        
        if f < best_f:
            best_x = x.copy()
            best_f = f
        
        # probabilistic mutation
        if rng.rand() < 0.1:
            idx = rng.choice(dim, p=rng.rand(dim) > 0.5)
            x[idx] += (ub - lb) * rng.randn(len(idx))
        
        # gradient-based local search
        grad = np.zeros_like(x)
        eps = 1e-6
        for i in range(dim):
            x_try = x.copy()
            x_try[i] += eps
            if func(x_try) < f:
                grad[i] = (func(x_try) - f) / eps
        
        # update position with gradient direction
        step_size = 0.1 * (ub - lb)
        x -= step_size * np.sign(grad)
        
        # clip to bounds
        x = np.clip(x, lb, ub)
    
    return best_x
