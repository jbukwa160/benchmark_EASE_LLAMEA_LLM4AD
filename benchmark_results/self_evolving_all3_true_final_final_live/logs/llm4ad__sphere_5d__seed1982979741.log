def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_y = func(x)

    for i in range(budget):
        if i % 100 == 0:
            # Simulated Annealing (SA) phase
            t = 1 / np.log(i / 10 + 2)
            new_x = clip(best_x + rng.normal(0, 0.01 * (ub - lb), size=dim))
            new_y = func(new_x)
            if new_y < best_y:
                best_x = new_x
                best_y = new_y

        # Differential Evolution (DE) phase
        v = x.copy()
        for j in range(dim):
            r1, r2, r3 = rng.choice(range(i + 1), size=3, replace=False)
            if r1 == i:
                v[j] = best_x[j]
            else:
                v[j] = x[r1] + rng.uniform(-1, 1) * (x[r2] - x[r3])
        v = clip(v)
        y = func(v)

        if y < best_y:
            x = v
            best_x = x.copy()
            best_y = y

    return best_x
