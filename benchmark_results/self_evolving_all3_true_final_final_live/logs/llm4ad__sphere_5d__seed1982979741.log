def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.ceil(budget / 2))
    x_best = np.random.uniform(lb, ub, (pop_size, dim))

    for i in range(budget - 1):
        y_best = x_best[np.argmin([func(x) for x in x_best])]
        x_new = x_best.copy()
        
        for j in range(pop_size):
            v = rng.rand(dim)
            u = rng.uniform(0, 1, dim)
            while np.any(u < lb) or np.any(u > ub):
                u = rng.uniform(0, 1, dim)

            x_new[j] = y_best + 0.5 * (ub - lb) * v + (lb + ub - y_best) * u
        
        for j in range(pop_size):
            f_new = func(x_new[j])
            if f_new < func(y_best):
                y_best = x_new[j]

        x_best = np.clip(x_best, lb, ub)
        x_best[np.argmin([func(x) for x in x_best])] = y_best

    return np.clip(y_best, lb, ub)
