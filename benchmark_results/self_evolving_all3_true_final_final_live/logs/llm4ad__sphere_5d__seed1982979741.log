def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.zeros(dim)
    f_best = float('inf')
    
    for _ in range(budget):
        # Sample a new candidate based on the current best solution
        sigma = (ub - lb) / 2.0
        x_new = clip(np.array(rng.normal(x_best, sigma, size=dim)))
        
        # Evaluate the objective function
        f_new = func(x_new)
        
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
        
        # Refine the vicinity of the current best solution using a grid search
        delta = (ub - lb) / 10.0
        for i in range(dim):
            for j in np.linspace(lb + delta, ub - delta, 11):
                x_grid = clip(x_best.copy())
                x_grid[i] = j
                f_grid = func(x_grid)
                
                if f_grid < f_best:
                    f_best = f_grid
                    x_best = x_grid
                    
    return x_best
