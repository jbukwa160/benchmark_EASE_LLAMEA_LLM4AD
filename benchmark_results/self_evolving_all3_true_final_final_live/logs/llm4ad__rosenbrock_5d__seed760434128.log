def algorithm(func, dim, lb, ub, budget, rng):
    def sample(bounds, rng):
        return [np.clip(rng.uniform(lb[i], ub[i]), lb[i], ub[i]) for i in range(dim)]

    def acquisition(Xi, Xbest, gp_model, rng):
        mean, std = gp_model.predict(np.array([Xi]).T)
        with np.errstate(divide='ignore', invalid='ignore'):
            ucb = mean + 1.96 * std
        return -ucb

    def optimize(gp_model, budget, rng):
        Xbest = None
        Xprevious = []
        for _ in range(budget):
            Xi = sample([(-5, 5)]*dim, rng)
            yi = func(Xi)
            if Xbest is not None and np.mean(yi) < np.mean(func(Xbest)):
                Xbest = Xi
            gp_model.update(np.array([Xi]).T, np.array([yi]))
            Xprevious.append(Xi)
        return Xbest

    def clip(candidate):
        clipped_candidate = []
        for i in range(dim):
            if candidate[i] > ub[i]:
                clipped_candidate.append(ub[i])
            elif candidate[i] < lb[i]:
                clipped_candidate.append(lb[i])
            else:
                clipped_candidate.append(candidate[i])
        return clipped_candidate

    Xbest = None
    gp_model = 'GP'
    for _ in range(budget):
        Xi = sample([(-5, 5)]*dim, rng)
        yi = func(Xi)
        if Xbest is not None and np.mean(yi) < np.mean(func(Xbest)):
            Xbest = Xi
        if gp_model == 'GP':
            gp_model.update(np.array([Xi]).T, np.array([yi]))
        acquisition_value = acquisition(clip(Xi), clip(Xbest), gp_model, rng)
        new_Xi = sample([(-5, 5)]*dim, rng)
        while acquisition(clip(new_Xi), clip(Xbest), gp_model, rng) < acquisition_value:
            new_Xi = sample([(-5, 5)]*dim, rng)
        yi = func(new_Xi)
        if Xbest is not None and np.mean(yi) < np.mean(func(Xbest)):
            Xbest = new_Xi
    return clip(np.array(Xbest))
