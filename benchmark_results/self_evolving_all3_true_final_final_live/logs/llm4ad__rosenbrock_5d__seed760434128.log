def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_stepsize(mean, std_dev):
        return mean + rng.normal(0, std_dev)

    def clip(x, lower, upper):
        return np.clip(x, lower, upper)

    def compute_objective(candidate):
        return func(candidate)

    initial_mean = (lb + ub) / 2 * np.ones(dim)
    stepsize = 1.0
    variance = 1e-4 * np.eye(dim)
    lambda_val = dim

    for _ in range(budget):
        # Sample from multivariate normal distribution with given mean and covariance matrix
        candidate = initial_mean + rng.multivariate_normal(np.zeros(dim), variance)

        # Clip candidates to [lb, ub]
        candidate = clip(candidate, lb, ub)

        # Compute objective function at sampled point
        f_x = compute_objective(candidate)

        # Update stepsize using Rank-1 update rule of CMA-ES
        diff = (candidate - initial_mean) / np.sqrt(variance.diagonal())
        variance += lambda_val * diff @ diff.T

        # Check if the new solution is better than the current best
        if f_x < compute_objective(initial_mean):
            initial_mean = candidate
            stepsize *= 0.1 + (100 - f_x) / 10000  # Update stepsize using a simple adaptive rule

    return initial_mean
