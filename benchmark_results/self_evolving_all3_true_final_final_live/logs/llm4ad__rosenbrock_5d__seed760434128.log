    def negative_func(x):
        return -func(x)

    x_best = np.random.uniform(lb, ub, size=dim)
    best_value = func(x_best)

    for t in range(budget):
        X = np.array([x_best])
        y = np.array([best_value])

        if len(X) < 2:
            sigma = 1
        else:
            gp = GaussianProcessRegressor(kernel=Matern(),
                                          n_restarts_acquisition_process=5,
                                          random_state=rng)
            gp.fit(X, y)

            mu, sigma = gp.predict(np.array([[np.min(lb + (ub - lb) * rng.uniform(size=dim)) for dim in range(dim)]])).ravel()
            sigma[sigma < 1e-6] = 1e-6

        x_next = np.clip(lb + (ub - lb) * rng.normal(loc=np.mean(X, axis=0), scale=sigma), lb, ub)

        X_next = np.vstack((X, [x_next]))
        y_next = np.hstack((y, func(x_next)))

        gp.fit(X_next, y_next)

        mu, sigma = gp.predict(np.array([[np.min(lb + (ub - lb) * rng.uniform(size=dim)) for dim in range(dim)]])).ravel()
        sigma[sigma < 1e-6] = 1e-6

        x_next = np.clip(lb + (ub - lb) * rng.normal(loc=np.mean(X, axis=0), scale=sigma), lb, ub)

        if func(x_next) < best_value:
            x_best = x_next
            best_value = func(x_best)

    return x_best
