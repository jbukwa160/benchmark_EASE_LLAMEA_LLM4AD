def algorithm(func, dim, lb, ub, budget, rng):
    def posterior(mean, cov, x_new):
        return mean + np.linalg.solve(cov, x_new - mean)

    def ei(mean, cov, x_new):
        return (x_new - mean).dot(np.linalg.solve(cov, x_new - mean)) - np.log(np.linalg.det(cov))

    def pi(mean, sigma, x_new):
        return np.max([0, func(x_new) - mean + 1.96 * sigma])

    best_x = rng.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    cov = 1e-4 * np.eye(dim)
    acquisition = 'ei'
    for _ in range(budget):
        x_new = posterior(np.zeros(dim), cov, rng.uniform(lb, ub, size=dim))
        
        if acquisition == 'ei':
            delta_f = ei(func(x_new), cov, x_new)
        else:
            delta_f = pi(func(x_new), np.sqrt(np.diag(cov)), x_new)

        if delta_f > 0 or np.random.rand() < 1e-4: # random exploration
            acquisition = 'ei' if np.random.rand() < 0.5 else 'pi'
            
            cov += 1e-6 * (x_new - posterior(np.zeros(dim), cov, x_new)).dot((x_new - posterior(np.zeros(dim), cov, x_new)).T)
        
        if func(x_new) < best_f:
            best_x = x_new
            best_f = func(x_new)

    return np.clip(best_x, lb, ub)
