def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def generate_initial_population(budget, rng, lower_bound, upper_bound):
        population_size = min(10 * dim + 1, budget)
        population = np.random.uniform(lower_bound, upper_bound, size=(population_size, dim))
        return population

    def differential_evolution(population, func, bounds, budget):
        # Differential evolution parameters
        mutation_strategy = 'rand1exp'
        crossover_probability = 0.5
        mutation_factor = 0.2
        population_size = len(population)

        for _ in range(budget // (10 * dim)):
            # Select parents
            parents = np.random.choice(population, size=population_size, replace=False)
            
            # Mutation and crossover
            mutated_population = np.zeros((population_size, dim))
            for i in range(population_size):
                parent1_idx = np.random.randint(0, population_size)
                parent2_idx = np.random.randint(0, population_size)
                while parent2_idx == parent1_idx:
                    parent2_idx = np.random.randint(0, population_size)

                mutated_population[i] = parents[parent1_idx] + mutation_factor * (parents[parent2_idx] - parents[np.random.choice(population_size)])
                
                if rng.rand() < crossover_probability:
                    mutated_population[i] = 0.5 * (parents[parent1_idx] + parents[parent2_idx]) + mutation_factor * (parents[parent1_idx] - parents[parent2_idx])

            # Selection
            for i in range(population_size):
                if func(mutated_population[i]) <= func(parents[i]):
                    population[i] = mutated_population[i]
        return population

    def simulated_annealing(population, func, bounds, budget):
        temperature = 1000
        cooling_rate = 0.9995
        
        for _ in range(budget // (10 * dim)):
            # Select current solution
            current_solution = np.random.choice(population)
            
            # Generate neighbor solutions
            neighbors = np.random.uniform(bounds[0], bounds[1], size=(len(population), dim))
            neighbors = clip(neighbors)

            # Evaluate neighbor solutions and select new current solution using simulated annealing
            for i in range(len(neighbors)):
                if func(neighbors[i]) < func(current_solution):
                    current_solution = neighbors[i]
                elif rng.rand() < np.exp((func(current_solution) - func(neighbors[i])) / temperature):
                    current_solution = neighbors[i]

            # Update temperature and cooling rate
            temperature *= cooling_rate

        return [current_solution]

    population = generate_initial_population(budget, rng, lb, ub)
    population = differential_evolution(population, func, (lb, ub), budget // (10 * dim))
    population = simulated_annealing(population, func, (lb, ub), budget - (budget // (10 * dim)))

    # Return the best solution found
    return clip(np.min(population, axis=0))
