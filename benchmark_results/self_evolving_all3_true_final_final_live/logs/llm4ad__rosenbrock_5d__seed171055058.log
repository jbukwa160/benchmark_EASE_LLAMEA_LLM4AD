def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_candidate = np.random.uniform(lb, ub, size=dim)
    best_fitness = func(best_candidate)

    for _ in range(budget):
        while True:
            candidate1 = clip(np.array(rng.normal(size=dim)))
            candidate2 = clip(np.array(rng.normal(size=dim)))
            candidate3 = clip(np.array(rng.normal(size=dim)))

            if np.all(candidate1 != candidate2) and np.all(candidate2 != candidate3) and np.all(candidate1 != candidate3):
                break

        alpha = np.random.uniform(0, 1)
        beta = np.random.uniform(0, 1)

        new_candidate = alpha * candidate1 + (1 - alpha) * candidate2
        for i in range(dim):
            if rng.rand() < 0.5:
                new_candidate[i] = np.random.uniform(lb, ub)
            elif np.random.rand() < beta:
                new_candidate[i] += rng.normal()

        new_fitness = func(clip(new_candidate))

        if new_fitness < best_fitness:
            best_candidate = clip(new_candidate)
            best_fitness = new_fitness

    return best_candidate
