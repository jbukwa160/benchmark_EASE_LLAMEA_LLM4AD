def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_x = rng.uniform(lb, ub, size=dim)
    best_f = func(best_x)
    
    for _ in range(budget):
        x = clip(rng.uniform(lb, ub, size=dim))
        
        y = np.array(x) + rng.normal(size=dim) * 0.1
        y = clip(y)
        
        z = np.array(x) + np.array([rng.choice([-1, 1]) for _ in range(dim)]) * 0.5
        z = clip(z)
        
        if np.random.rand() < 0.3:
            x = (x + y) / 2.0
        else:
            x = (x + z) / 2.0
        
        f = func(x)
        
        if f < best_f:
            best_x, best_f = x, f
    
    return best_x
