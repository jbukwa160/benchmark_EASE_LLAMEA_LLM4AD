def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = clip(rng.uniform(lb, ub, size=(dim,)))
    best_x = clip(x)
    best_f = func(best_x)
    for _ in range(budget-1):
        delta = 0.1 * rng.normal(size=dim)
        new_x = x + delta
        new_x = clip(new_x)
        new_f = func(new_x)
        if new_f < best_f:
            best_x, best_f = new_x, new_f
        alpha = 0.01 * rng.normal()
        delta *= (1 + alpha) ** 2
        x += delta
    return best_x
