def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    pop_size = 50
    weights = [0.5, 1.0]
    mutation_strategies = ['rand/1/bin', 'best/1/exp']
    crossover_types = ['bin']

    x_best = np.random.uniform(lb, ub, (pop_size, dim))
    f_best = np.array([f(x) for x in x_best])

    for i in range(budget):
        for strategy in mutation_strategies:
            for c_type in crossover_types:
                w = weights[rng.randint(0, 2)]
                r1 = rng.uniform(lb, ub)
                r2 = rng.uniform(lb, ub)
                m = np.zeros(dim)
                for j in range(dim):
                    if strategy == 'rand/1/bin':
                        m[j] = r1 + w * (x_best[rng.randint(0, pop_size-1), j] - x_best[rng.randint(0, pop_size-1), j])
                    elif strategy == 'best/1/exp':
                        m[j] = r2 + np.exp(w) * (x_best[np.argmax(f_best), j] - x_best[rng.randint(0, pop_size-1), j])
                for c in crossover_types:
                    if c_type == 'bin':
                        u = rng.uniform(lb, ub)
                        x_new = w * m + (1-w) * x_best[rng.randint(0, pop_size-1)]
                        f_new = f(np.clip(x_new, lb, ub))
                        if f_new < f_best[rng.randint(0, pop_size-1)]:
                            f_best[rng.randint(0, pop_size-1)] = f_new
                            x_best[rng.randint(0, pop_size-1)] = np.clip(x_new, lb, ub)

        idx = rng.randint(0, pop_size)
        x_best[idx] = np.clip(np.array([f_best.argmin()]), lb, ub)
        f_best[idx] = np.min(f_best)

    return x_best[np.argmin(f_best)]
