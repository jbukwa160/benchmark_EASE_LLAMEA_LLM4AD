def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=(1, dim))
    y = func(x)
    best_x = x.copy()
    best_y = y

    cooling_rate = 0.99
    temperature = 10.0
    iterations = int(budget / (dim * 100))

    for iteration in range(1, iterations + 1):
        new_x = clip(x + np.random.uniform(-1, 1, size=(1, dim)))
        new_y = func(new_x)
        if new_y < y:
            x = new_x
            y = new_y
            if new_y < best_y:
                best_x = new_x.copy()
                best_y = new_y
        elif np.random.rand() < np.exp((y - new_y) / temperature):
            x = new_x
            y = new_y

        temperature *= cooling_rate

    return clip(best_x)
