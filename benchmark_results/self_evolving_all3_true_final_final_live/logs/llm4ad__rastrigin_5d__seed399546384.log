def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    F = 0.5
    CR = 1.0
    x_best = np.random.uniform(lb, ub, (pop_size, dim))
    f_best = np.inf
    local_search_iter = 10

    for i in range(budget):
        y = np.zeros((pop_size, dim))
        for j in range(pop_size):
            v = rng.uniform(lb, ub)
            u_idx = rng.choice(pop_size, p=[1.0/(j+1) for j in range(pop_size)])
            r = rng.uniform(0, 1)

            if rng.random() < CR or func(x_best[u_idx], dim) < func(x_best[j], dim):
                y[j] = x_best[u_idx] + F*(x_best[j]-x_best[u_idx]) + v*r
            else:
                y[j] = x_best[j]

        for j in range(pop_size):
            if rng.random() < 0.1:
                local_search_iter -= 1
                for k in range(local_search_iter):
                    r = rng.uniform(0, 1)
                    s_idx = rng.choice(dim)
                    y[j,s_idx] += r*0.01*(ub[s_idx]-lb[s_idx])*rng.choice([-1,1])

        y = np.clip(y, lb, ub)

        for j in range(pop_size):
            if func(y[j], dim) < f_best:
                x_best[j] = y[j]
                f_best = func(x_best[j], dim)
    return x_best[np.argmin([func(x, dim) for x in x_best])]
