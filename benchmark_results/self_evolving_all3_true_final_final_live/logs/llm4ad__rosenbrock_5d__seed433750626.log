def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    learning_rate = 1.0
    step_size = 1.0
    
    for _ in range(budget-1):
        grad = np.zeros(dim)
        for i in range(dim):
            xp = x.copy()
            xp[i] += 1e-5
            grad[i] = (func(xp) - best_f) / 1e-5
            
        learning_rate *= 0.9
        step_size *= 0.999
        
        if np.linalg.norm(grad) < 1e-3:
            break
        
        s = rng.uniform(-step_size, step_size, size=dim)
        x += learning_rate * grad + s
        
        x = np.clip(x, lb, ub)
        
        f = func(x)
        
        if f < best_f:
            best_x = x
            best_f = f
    
    return best_x
