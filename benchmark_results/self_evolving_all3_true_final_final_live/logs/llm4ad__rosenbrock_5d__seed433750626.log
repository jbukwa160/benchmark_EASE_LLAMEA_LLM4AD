def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    temp = 1.0
    alpha = 0.99
    beta = 2.0
    for t in range(budget):
        new_x = x + np.array([random.choice([-1, 1]) if rng.random() < 0.5 else 0 for _ in range(dim)])
        new_x = np.clip(new_x, lb, ub)
        new_x_eval = func(new_x)
        x_eval = func(x)
        
        if new_x_eval <= x_eval:
            x = new_x.copy()
            best_x = new_x.copy()
        elif rng.random() < np.exp((x_eval - new_x_eval) / temp):
            x = new_x.copy()
        
        temp *= alpha
        for i in range(dim):
            if rng.random() < beta * (ub - lb) / dim:
                new_x[i] = rng.uniform(lb, ub)
                new_x_eval = func(new_x)
                if new_x_eval <= x_eval:
                    x = new_x.copy()
                    best_x = new_x.copy()
                elif rng.random() < np.exp((x_eval - new_x_eval) / temp):
                    x = new_x.copy()
    
    return best_x
