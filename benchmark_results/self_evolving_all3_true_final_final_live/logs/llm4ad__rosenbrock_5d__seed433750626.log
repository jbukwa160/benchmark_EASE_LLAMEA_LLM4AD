def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 1e3  # initial temperature
    alpha = 0.99  # cooling factor
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        f_new = func(x + rng.normal(0, 0.2, size=dim))
        if f_new < best_f:
            best_f = f_new
            best_x = x.copy()

        delta = f_new - best_f
        p = np.exp(-delta / T)
        if delta <= 0 or np.random.rand() < p:
            x = x + rng.normal(0, 0.2, size=dim)

        # bounds handling and clipping
        x = np.clip(x, lb, ub)

        T *= alpha

    return best_x
