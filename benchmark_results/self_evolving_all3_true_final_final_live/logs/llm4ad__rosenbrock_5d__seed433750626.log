def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, (1, dim))
    T = 1.0
    best_x = x.copy()
    best_f = func(bound(x))

    for _ in range(budget):
        for i in range(dim):
            y = bound(x + rng.normal(0, 0.1, size=dim))
            f_y = func(y)
            alpha = np.exp((best_f - f_y) / (T * rng.uniform(0, 1)))
            if f_y < best_f or np.random.rand() < alpha:
                x = y
                best_x = y.copy()
                best_f = f_y

        T *= 0.9995

    return bound(best_x)
