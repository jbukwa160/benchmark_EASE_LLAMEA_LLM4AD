def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x, lb, ub)
        return func(x)

    population_size = 10
    lambda_ = population_size
    mu = int(0.1 * lambda_)
    sigma = 5.0
    step_size = np.ones(dim) * sigma / np.sqrt(lambda_)
    weights = np.ones(lambda_) / lambda_
    mean = rng.uniform(lb, ub, size=dim)
    best_x = mean.copy()

    for _ in range(budget):
        offspring = mean + np.random.randn(lambda_, dim)[:, None] @ step_size
        fitness = evaluate(offspring)
        order = np.argsort(fitness)[:mu]
        weights = weights[order] * (1 - 0.01 / (budget + 1)) ** mu

        for i in range(lambda_):
            weights[i] += 0.5 if i < mu else -0.5
        weights /= np.sum(weights)

        mean = np.dot(offspring[order].T, weights)[:, None]
        step_size = np.sqrt(np.mean((offspring[order] - mean) ** 2, axis=0))

    return best_x.copy()
