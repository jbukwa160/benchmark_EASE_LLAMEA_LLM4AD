def algorithm(func, dim, lb, ub, budget, rng):
    def init_population(pop_size):
        return (ub - lb) * rng.rand(pop_size, dim) + lb

    def differential_evolution(population, func, dim, lb, ub, f_count):
        n_pop, _ = population.shape
        diff = np.zeros((n_pop, dim))
        for i in range(n_pop):
            idxs = [j for j in range(n_pop) if j != i]
            r1, r2, r3 = rng.choice(idxs, 3, replace=False)
            diff[i] = population[r1] + 0.5 * (population[r2] - population[r3])
        return np.fmin(func(population), func(diff))

    def polynomial_mutation(candidate, sigma):
        mutation = (rng.rand(dim) - 0.5) * 2
        mutated_candidate = candidate + sigma * np.fabs(mutation)
        return np.clip(mutated_candidate, lb, ub)

    population = init_population(budget)
    f_count = 0
    best_candidate = None

    while f_count < budget:
        next_population = differential_evolution(population, func, dim, lb, ub, f_count)
        sigma = (ub - lb) * rng.rand()
        mutated_next_population = np.array([polynomial_mutation(candidate, sigma) for candidate in next_population])
        population = np.fmin(next_population, mutated_next_population)
        best_candidate = np.min(population, axis=0)
        if func(best_candidate) < func(np.mean(population, axis=0)):
            f_count += 1
        else:
            f_count -= 1

    return best_candidate
