def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_population(size, rng):
        return rng.uniform(lb, ub, size=(size, dim))

    def perturb(candidate, rng):
        perturbation = rng.uniform(-1, 1, size=dim)
        return candidate + perturbation

    population = generate_population(10, rng)
    for _ in range(budget):
        new_population = [perturb(individual, rng) for individual in population]
        new_population = clip(new_population)
        population = np.array([individual if func(individual) < func(individual_) else individual_ 
                              for i, individual in enumerate(population) 
                              for individual_ in new_population[i:]])
    best_candidate = np.argmin(func(population))
    return clip(population[best_candidate])
