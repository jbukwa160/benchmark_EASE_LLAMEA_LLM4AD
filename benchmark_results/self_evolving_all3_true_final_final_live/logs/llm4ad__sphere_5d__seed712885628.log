def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_population(size):
        return np.random.uniform(lb, ub, (size, dim))

    def evaluate(population):
        return func(clip(population))

    def adaptive_radius(population, best):
        mean = np.mean(np.linalg.norm(population - best, axis=1))
        return 0.5 * mean

    def differential_evolution(population, budget):
        for _ in range(budget // dim):
            new_population = population + rng.uniform(-adaptive_radius(population, population[np.argmin(evaluate(population))]), 
                                                      adaptive_radius(population, population[np.argmin(evaluate(population))]), (population.shape[0], dim))
            new_population = clip(new_population)
            if evaluate(new_population) < evaluate(population):
                population = new_population
        return population

    def simulated_annealing(population, budget):
        T = 1.0
        for _ in range(budget // 10000):
            idx = rng.choice(population.shape[0], p=np.exp(-(evaluate(clip(np.array([population[np.argmin(evaluate(population)), 
                                                                                                       rng.randint(0, population.shape[0])]]))) - evaluate(population)) / T))
            if evaluate(clip(population[idx])) < evaluate(population):
                population = np.array([population[np.argmin(evaluate(population))], population[idx]])
                T *= 0.999
        return population

    population = generate_population(100)
    best = np.argmin(evaluate(population))
    for _ in range(budget // (dim * 2)):
        new_population = differential_evolution(population, budget // 10)
        if evaluate(new_population[np.argmin(evaluate(new_population))]) < evaluate(population[best]):
            population = new_population
            best = np.argmin(evaluate(population))
        else:
            population = simulated_annealing(population, budget // 1000)

    return clip(population[best])
