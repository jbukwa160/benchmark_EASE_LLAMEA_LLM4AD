def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    n_iter = 0
    T = 100.0
    cooling_rate = 0.99

    while n_iter < budget:
        y = x + rng.normal(0, 1e-2, size=dim)
        y = np.clip(y, lb, ub)

        delta_f = func(y) - best_f

        if delta_f < 0 or (delta_f >= 0 and np.random.rand() < np.exp(-delta_f / T)):
            x = y
            if func(x) < best_f:
                best_x = x.copy()
                best_f = func(x)

        T *= cooling_rate
        n_iter += 1

    return best_x
