def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    for _ in range(budget):
        x_rand = np.clip(lb + (ub - lb) * rng.uniform(size=dim), a_min=lb, a_max=ub)
        sigma = 1 / np.sqrt(1 + np.sum(x_best**2))
        x_new = x_rand + sigma * rng.normal(size=dim)
        f_new = func(x_new)
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
    return x_best
