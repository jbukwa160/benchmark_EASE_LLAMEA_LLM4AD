def algorithm(func, dim, lb, ub, budget, rng):
    def sphere(x):
        return sum(i**2 for i in x)

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    best_solution = np.array([0.0] * dim)
    radius = 5.0
    n_restart = int(budget / (dim + 1))

    for _ in range(n_restart):
        solution = rng.uniform(lb, ub, size=dim)
        candidate = clip(solution, lb, ub)

        if func(candidate) < sphere(best_solution):
            best_solution = candidate

        radius /= 2.0
        new_candidate = [lb + (ub - lb) * rng.uniform(0, 1)]
        for i in range(dim - 1):
            new_candidate.append(lb + (ub - lb) * np.random.choice([-1, 1]))
        new_candidate = clip(new_candidate, lb, ub)
        new_candidate = [c for c in new_candidate if func(c) < sphere(best_solution)]

        if new_candidate:
            solution = np.array(new_candidate[np.argmin([sphere(x) for x in new_candidate])])
            candidate = clip(solution, lb, ub)

            if func(candidate) < sphere(best_solution):
                best_solution = candidate

    return best_solution
