def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = bound(x)
        return func(x)

    strategy = "rand/1/bin"
    population_size = 50
    mutation_rate = 0.7
    crossover_probability = 0.9

    population = rng.uniform(lb, ub, (population_size, dim))
    for _ in range(budget):
        differential_vector = population[rng.randint(population_size), :] - population[rng.randint(population_size), :]
        differential_vector += rng.uniform(-1, 1, dim) * lb
        differential_vector /= np.linalg.norm(differential_vector)
        
        new_population = population + mutation_rate * differential_vector[:, None] + crossover_probability * (population - bound(population))
        
        scores = evaluate(new_population)
        best_idx = np.argmax(scores)
        if rng.random() < 0.5:
            population[best_idx] = new_population[best_idx]
    
    return population[np.argmax([evaluate(x) for x in population])]
