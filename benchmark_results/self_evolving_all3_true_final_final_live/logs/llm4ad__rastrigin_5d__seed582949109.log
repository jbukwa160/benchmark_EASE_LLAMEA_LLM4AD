def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.ceil(dim * 1.2)) # population size
    D = [np.random.uniform(lb, ub, dim) for _ in range(pop_size)] # initialize population
    best = np.inf

    for i in range(budget):
        if rng.rand() < 0.5:
            idx1, idx2, idx3 = rng.choice(range(pop_size), size=3, replace=False)
            D[idx3] += rng.uniform(-1, 1) * (D[idx1] - D[idx2])
        else:
            idx1, idx2, idx3 = rng.choice(range(pop_size), size=3, replace=False)
            D[idx3] = rng.uniform(lb, ub)

        for j in range(pop_size):
            if func(D[j]) < best:
                best = func(D[j])

        for j in range(pop_size):
            D[j] = np.clip(D[j], lb, ub) # clip candidates to [lb, ub]

    return np.array([best])
