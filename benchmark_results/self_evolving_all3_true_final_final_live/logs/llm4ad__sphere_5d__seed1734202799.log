def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    pop_size = 1
    generation = 0

    while True:
        if budget <= 0 or np.linalg.norm(func(best_x)) < 1e-6:
            break
        
        for _ in range(pop_size):
            offspring = clip(x + rng.normal(0, 0.5, size=dim))
        
        y = func(offspring)
        if y < func(best_x):
            best_x = offspring
            budget -= pop_size

        x = best_x.copy()
        generation += 1

    return best_x
