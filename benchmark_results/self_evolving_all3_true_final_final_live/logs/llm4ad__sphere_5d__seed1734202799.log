def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    best_f = float('inf')

    for _ in range(budget):
        # Random Search: sample a new candidate
        x_new = rng.uniform(lb, ub, size=dim)

        # Evaluate the function at the new candidate
        f_new = func(x_new)

        # Update the best solution if necessary
        if f_new < best_f:
            best_f = f_new
            best_x = x_new.copy()

        # Coordinate Descent: optimize one dimension at a time
        for i in range(dim):
            # Clip candidates to [lb, ub]
            x_new[i] = rng.uniform(lb, ub)
            f_new = func(x_new)

            # Update the best solution if necessary
            if f_new < best_f:
                best_f = f_new
                best_x = x_new.copy()

    return best_x
