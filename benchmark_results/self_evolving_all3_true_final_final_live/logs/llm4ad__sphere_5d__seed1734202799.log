def algorithm(func, dim, lb, ub, budget, rng):
    best = np.full(dim, 0)
    min_val = float('inf')
    
    for i in range(budget):
        sigma = max(1e-6, (ub - lb) / 2.5 * 3 ** -(i + 1))
        
        candidate = best + rng.normal(size=dim) * sigma
        candidate = np.clip(candidate, lb, ub)
        
        value = func(candidate)
        if value < min_val:
            min_val = value
            best = candidate
            
    return best
