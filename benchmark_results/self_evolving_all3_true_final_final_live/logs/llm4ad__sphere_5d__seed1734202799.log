def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_y = float('inf')
    
    for _ in range(budget):
        x = (ub - lb) * rng.rand(dim) + lb
        y = func(x)
        
        if y < best_y:
            best_y = y
            best_x = x
        
        alpha = 0.1  # learning rate
        grad = np.zeros(dim)
        for i in range(dim):
            x_plus_alpha = np.copy(x)
            x_plus_alpha[i] += alpha
            grad[i] = (func(x_plus_alpha) - y) / alpha
            
        x -= alpha * grad
        
        x = np.clip(x, lb, ub)
        
    return best_x
