def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget - 1):
        # Generate new candidate by perturbing the current best solution
        sigma = 0.1 * (ub - lb)
        e = rng.normal(size=dim, loc=0, scale=sigma)
        new_x = best_x + e

        # Clip to bounds and evaluate function value
        new_x = np.clip(new_x, lb, ub)
        new_f = func(new_x)

        # Update best solution if new candidate is better
        if new_f < best_f:
            best_x = new_x
            best_f = new_f

    return best_x
