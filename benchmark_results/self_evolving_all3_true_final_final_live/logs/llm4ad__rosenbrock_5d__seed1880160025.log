def algorithm(func, dim, lb, ub, budget, rng):
    def simulated_annealing(temp_schedule, x0, lb, ub, budget):
        T = temp_schedule[0]
        t = 1
        x = x0.copy()
        best_x = x.copy()
        while t < budget and T > 1e-6:
            for _ in range(int(budget / (t + 1))):
                y = x + rng.normal(size=dim, loc=0, scale=T)
                y = np.clip(y, lb, ub)
                if func(y) < func(x):
                    x = y
                    best_x = y
                elif rng.random() < np.exp((func(x) - func(y)) / T):
                    x = y
            T *= temp_schedule[t]
            t += 1
        return best_x

    def differential_evolution(pop_size, lb, ub, budget, rng):
        pop = rng.uniform(size=(pop_size, dim), low=lb, high=ub)
        for _ in range(budget // pop_size):
            new_pop = []
            for i in range(pop_size):
                x1, x2, x3 = rng.choice(pop_size, size=3, replace=False)
                y = pop[x1] + rng.uniform(size=dim) * (pop[x2] - pop[x3])
                y = np.clip(y, lb, ub)
                new_pop.append(y)
            pop = np.array(new_pop)
        return pop[np.argmin([func(x) for x in pop])]

    temp_schedule = [10.0, 5.0, 1.0]
    pop_size = 100
    while True:
        best_x_sa = simulated_annealing(temp_schedule, rng.uniform(size=dim, low=lb, high=ub), lb, ub, budget // 2)
        best_x_de = differential_evolution(pop_size, lb, ub, budget // 2, rng)
        if func(best_x_sa) < func(best_x_de):
            return best_x_sa
        else:
            return best_x_de
