def algorithm(func, dim, lb, ub, budget, rng):
    def surrogate(x):
        return func(np.clip(x, lb, ub))

    D = 0.01 * rng.randn(dim)
    v = np.zeros(dim)

    for _ in range(budget):
        x = np.clip(v + D, lb, ub)
        
        if surrogate(x) < 1e+20:
            loss = surrogate(x)
            
            if rng.uniform(0, 1) > 0.5:
                alpha = 1 / (budget - _)
                v += alpha * D
                D *= np.sqrt(alpha)
            else:
                sigma_sq = 10 ** (-np.exp(rng.uniform(-3, 2)))
                D *= np.sqrt(sigma_sq)

    return x
