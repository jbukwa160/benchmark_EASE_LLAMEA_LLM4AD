def algorithm(func, dim, lb, ub, budget, rng):
    def wrapper(x):
        return func(x)

    def clip(x):
        return np.clip(x, lb, ub)

    x0 = (ub + lb) / 2 * np.ones(dim)
    res = minimize(wrapper, x0, method="SLSQP", bounds=[(lb, ub)]*dim, constraints=())

    if wrapper(res.x) < budget:
        return clip(res.x)

    def gradient(x):
        eps = rng.rand(dim)*1e-3
        grad = np.zeros_like(x)
        for i in range(dim):
            x_eps = x + eps[i]
            grad[i] = (wrapper(x_eps) - wrapper(x)) / eps[i]
        return grad

    temp = 10.0
    cooling_rate = 0.99
    best_x = x0
    for _ in range(budget):
        if wrapper(res.x) < budget:
            break

        new_x = res.x + gradient(res.x) * rng.uniform(-1, 1)
        new_x = clip(new_x)

        p = np.exp((wrapper(new_x) - wrapper(best_x)) / temp)
        if rng.rand() < p and wrapper(new_x) < wrapper(best_x):
            best_x = new_x
            res.x = new_x

        temp *= cooling_rate

    return best_x
