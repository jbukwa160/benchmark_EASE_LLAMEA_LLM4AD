def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_crossover(x1, x2):
        return 0.5 * (x1 + x2 + rng.randn(dim))

    def evaluate(x):
        return func(np.clip(x, lb, ub))

    def generate_candidates(mu, sigma):
        candidates = []
        for _ in range(2 * dim):
            candidate = mu + sigma * rng.randn(dim)
            candidates.append(candidate)
        return np.array(candidates)

    x_best = np.random.uniform(lb, ub, dim)
    f_best = evaluate(x_best)
    budget_used = 1

    while budget_used < budget:
        sigma = 0.5 / (budget_used ** 0.2) + 0.01
        mu = x_best.copy()
        candidates = generate_candidates(mu, sigma)

        # Gaussian crossover
        for i in range(len(candidates)):
            candidates[i] = gaussian_crossover(candidates[i], mu)

        # Selection
        new_x_best, f_new = None, np.inf
        for candidate in candidates:
            f_candidate = evaluate(candidate)
            if f_candidate < f_new:
                new_x_best, f_new = candidate, f_candidate

        x_best, f_best = new_x_best, min(f_best, f_new)

        budget_used += 1

    return x_best
