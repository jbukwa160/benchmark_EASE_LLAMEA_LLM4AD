def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = f(best_x)
    
    learning_rate = 1.0
    for _ in range(budget):
        y = x + learning_rate * rng.normal(size=dim)
        y = np.clip(y, lb, ub)
        
        if f(y) < best_f:
            best_x = y.copy()
            best_f = f(best_x)
            
        r1 = rng.uniform(lb, ub)
        r2 = rng.uniform(lb, ub)
        r3 = rng.uniform(lb, ub)
        
        z = 2 * best_x - x + learning_rate * (r1 * (best_x - y) + r2 * (y - x) + r3 * (x - best_x))
        z = np.clip(z, lb, ub)

        if f(z) < best_f:
            x = best_x.copy()
            x[(f(y) > f(z)) & (f(x) > f(z))] += learning_rate * rng.normal(size=sum((f(y) > f(z)) & (f(x) > f(z))))
            x = np.clip(x, lb, ub)
            
        if _ % 100 == 0:
            learning_rate *= 0.9
            
    return best_x
