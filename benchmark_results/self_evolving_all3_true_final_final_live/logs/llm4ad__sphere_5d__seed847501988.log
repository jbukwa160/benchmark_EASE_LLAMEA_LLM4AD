def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_candidate(current):
        radius = 1.0
        while True:
            perturbation = rng.uniform(-radius, radius, size=dim)
            new_candidate = current + perturbation
            if np.all(clip(new_candidate) == clip(current)):
                continue
            return clip(new_candidate)

    def acceptance_probability(old_fitness, new_fitness, temperature):
        return np.exp((old_fitness - new_fitness) / temperature)

    def simulated_annealing(func, dim, lb, ub, budget, rng):
        current = np.zeros(dim)
        best = np.copy(current)
        temperature = 1.0
        for i in range(budget):
            candidate = generate_candidate(current)
            old_fitness = func(candidate)
            new_fitness = func(best)
            if old_fitness < new_fitness:
                current = candidate
                if old_fitness < new_fitness:
                    best = np.copy(candidate)
            elif rng.rand() < acceptance_probability(new_fitness, old_fitness, temperature):
                current = candidate
            temperature *= 0.99

        return best

    return simulated_annealing(func, dim, lb, ub, budget, rng)
