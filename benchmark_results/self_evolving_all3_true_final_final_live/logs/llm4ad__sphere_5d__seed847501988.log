def algorithm(func, dim, lb, ub, budget, rng):
    n_dims = len(dim)
    best_x = np.zeros(n_dims)
    best_y = float('inf')

    for i in range(budget):
        projections = [rng.uniform(lb[j], ub[j]) for j in range(n_dims)]
        x = [0] * n_dims
        y = 0

        for j in range(n_dims):
            x[j] = projections[j]
            y += func(x[:j+1])

        if y < best_y:
            best_x = x[:]
            best_y = y

    return np.array(best_x)
