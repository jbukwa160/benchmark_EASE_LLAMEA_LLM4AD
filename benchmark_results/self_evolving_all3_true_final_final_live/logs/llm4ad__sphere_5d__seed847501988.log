def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        g = 2 * (func(best_x) - func(x))
        x += 0.5 / (rng.rand(dim) + 1e-8) * g

        # clip to bounds
        x = np.clip(x, lb, ub)

        f = func(x)
        if f < best_f:
            best_x = x.copy()
            best_f = f

    return best_x
