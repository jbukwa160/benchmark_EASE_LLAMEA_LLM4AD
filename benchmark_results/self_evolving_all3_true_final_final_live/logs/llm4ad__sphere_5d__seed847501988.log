def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    for i in range(budget):
        x_candidate = lb + (ub - lb) * rng.rand(dim)
        f_candidate = func(x_candidate)
        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate
        gradient = np.zeros(dim)
        step_size = 1e-4
        for j in range(10):
            x_trial = x_best + step_size * gradient
            x_trial = np.clip(x_trial, lb, ub)
            f_trial = func(x_trial)
            if f_trial < f_best:
                x_best = x_trial
                f_best = f_trial
            gradient += 0.1 * (x_trial - x_best) / np.linalg.norm(x_trial - x_best)**2
    return x_best
