def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        gp_model = GaussianProcessRegressor(kernel=np.sqrt(10.0)*RBF(length_scale=[1.0]*dim),
                                            alpha=np.zeros(dim))
        gp_model.fit(rng.uniform(lb, ub, size=(100, dim)), func(rng.uniform(lb, ub, size=(100, dim))))

        x_new = rng.normal(loc=x_best, scale=0.5*np.ones(dim), size=dim)
        x_new = np.clip(x_new, lb, ub)

        f_new = gp_model.predict(np.atleast_2d(x_new))[0]

        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
