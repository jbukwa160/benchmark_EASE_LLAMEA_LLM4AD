def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    population_size = 50
    initial_population = np.random.uniform(lb, ub, (population_size, dim))
    best_solution = None

    for _ in range(budget):
        differences = np.zeros((population_size, dim))
        for i in range(population_size):
            differences[i] = initial_population[(i - 1) % population_size]

        mutations = clip(initial_population + 0.5 * (differences - initial_population))

        fitnesses = [func(mutations[i]) for i in range(population_size)]
        best_fitness = min(fitnesses)
        best_index = np.argmin(fitnesses)

        if best_solution is None or best_fitness < func(best_solution):
            best_solution = mutations[best_index]

        initial_population = clip(mutations + 0.5 * (np.random.normal(size=(population_size, dim)) * rng))

    return best_solution
