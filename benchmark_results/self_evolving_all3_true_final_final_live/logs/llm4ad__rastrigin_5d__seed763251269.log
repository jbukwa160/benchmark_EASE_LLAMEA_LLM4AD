def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 1.0
    alpha = 0.98
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        for i in range(dim):
            new_x = x.copy()
            new_x[i] += np.random.uniform(-1, 1) * 0.5

            # Clip to bounds
            new_x = np.clip(new_x, lb, ub)

            # Compute function value
            new_f = func(new_x)

            # Metropolis acceptance criterion
            if new_f < best_f:
                x = new_x.copy()
                best_f = new_f
                best_x = new_x.copy()

            elif rng.rand() < np.exp((best_f - new_f) / T):
                x = new_x.copy()

        # Simulated Annealing cooling schedule
        T *= alpha

    return best_x
