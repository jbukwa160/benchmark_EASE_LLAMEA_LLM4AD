def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def rastrigin(x):
        return func(x) + np.sum(10 * (x**2 - 10 * np.cos(2 * np.pi * x)))

    pop_size = int(budget ** 0.5)
    init_x = rng.uniform(lb, ub, size=(pop_size, dim))
    
    best_x = None
    best_fval = np.inf
    
    for _ in range(budget):
        fvals = [rastrigin(x) for x in init_x]
        
        idx_best = np.argmin(fvals)
        if fvals[idx_best] < best_fval:
            best_fval = fvals[idx_best]
            best_x = init_x[idx_best]
        
        F = 0.5
        K = int(pop_size ** 0.8)
        
        for i in range(pop_size):
            idx1, idx2, idx3 = np.random.choice(range(pop_size), size=3, replace=False)
            
            if idx1 == idx2 or idx1 == idx3 or idx2 == idx3:
                continue
            
            x_new = init_x[idx1] + F * (init_x[idx2] - 2 * init_x[idx3]) + rng.uniform(-1, 1, size=dim) / budget
        
        init_x = np.array([clip(x, lb, ub) for x in init_x])
        
    return best_x
