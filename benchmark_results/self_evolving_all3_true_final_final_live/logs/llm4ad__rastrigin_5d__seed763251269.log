def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    max_iter = int(budget / pop_size)
    D = [np.random.uniform(lb, ub) for _ in range(pop_size)]
    F = 0.5
    CR = 0.9

    for _ in range(max_iter):
        for i in range(pop_size):
            r1, r2, r3 = np.random.choice(range(pop_size), replace=False, size=3)
            while r1 == i or r2 == i or r3 == i:
                r1, r2, r3 = np.random.choice(range(pop_size), replace=False, size=3)

            u = D[r1] + F * (D[r2] - D[r3])
            v = np.clip([u[j] + CR * (D[i][j] - u[j]) for j in range(dim)], lb, ub)
            w = func(v)
            if w < func(D[i]):
                D[i] = v

    return min(D, key=func)
