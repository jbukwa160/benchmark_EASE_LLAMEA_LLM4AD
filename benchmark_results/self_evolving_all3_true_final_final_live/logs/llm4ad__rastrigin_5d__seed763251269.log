def algorithm(func, dim, lb, ub, budget, rng):
    n = len(dim)
    x0 = [rng.uniform(lb[i], ub[i]) for i in range(n)]
    x_best = x0[:]
    f_best = func(x_best)

    c1 = 1.0
    c2 = 1.0

    sigma = np.sqrt(ub[0] - lb[0])
    mu = (ub[0] + lb[0]) / 2.0
    C = np.eye(n) * sigma**2
    D = np.zeros((n, n))
    H = np.linalg.inv(C)

    for i in range(budget):
        for j in range(n):
            y = [x_best[k] for k in range(n)]
            z1, z2, z3 = x_best + np.random.uniform(-c1, c1, n), \
                         x_best + np.random.uniform(-c2, c2, n), \
                         x_best + np.random.uniform(-c2, c2, n)
            y[j] = z1[j]
            f_y = func(y)
            if f_y < f_best:
                x_best = y
                f_best = f_y

            y = [x_best[k] for k in range(n)]
            y[j] = z2[j]
            f_y = func(y)
            if f_y < f_best:
                x_best = y
                f_best = f_y

            y = [x_best[k] for k in range(n)]
            y[j] = z3[j]
            f_y = func(y)
            if f_y < f_best:
                x_best = y
                f_best = f_y

        D = np.dot(C, H)
        C += 0.1 * (np.eye(n) - np.dot(D.T, D))
        mu = np.mean(x_best)

        for j in range(n):
            fj = func([x_best[k] + rng.uniform(-sigma, sigma) for k in range(n)])
            if fj < f_best:
                x_best[j] += rng.uniform(-sigma, sigma)
                f_best = fj

        C *= (1.0 - 2.0 / (i + 1))
        H = np.linalg.inv(C)

    return np.array(x_best)
