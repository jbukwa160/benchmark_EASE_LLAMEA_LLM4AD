def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Exploration
        s = 1.0 / (1 + _ / budget) * rng.truncated('norm', loc=_/budget, scale=1).rvs(dim)
        new_x = np.clip(best_x + s, lb, ub)

        # Exploitation
        f_new = func(new_x)
        if f_new < best_f:
            best_f = f_new
            best_x = new_x

    return best_x
