def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def mutate(x):
        sigma = 0.1 * (ub - lb)
        eps = rng.normal(size=x.shape) * sigma
        x_mutated = x + eps
        return clip(x_mutated)

    n_parents = int(np.sqrt(budget))
    parents = np.random.uniform(lb, ub, size=(n_parents, dim))

    for i in range(1, budget):
        children = np.zeros((n_parents, dim))
        for j in range(n_parents):
            child = mutate(parents[j])
            children[j] = child

        fitness = func(children)
        parent_fitness = func(parents)

        parents[np.argsort(fitness)[:, None] < n_parents - 1] = children[np.argsort(fitness)[np.argsort(fitness)[:, None] < n_parents - 1]]
    return np.min(parents, axis=0)
