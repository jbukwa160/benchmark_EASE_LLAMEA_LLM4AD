def algorithm(func, dim, lb, ub, budget, rng):
    def gp_model(x, X_train, y_train, kappa):
        K = np.zeros((len(X_train), len(X_train)))
        for i in range(len(X_train)):
            for j in range(len(X_train)):
                if i == j:
                    K[i, j] = 1 + np.exp(-0.5 * ((X_train[i] - X_train[j]) ** 2).sum(axis=1))
                else:
                    K[i, j] = np.exp(-np.linalg.norm(X_train[i] - X_train[j]))
        k = kappa * np.exp(-np.linalg.norm(x - X_train[0]))
        mu = y_train + np.dot(k, (K / (1 + np.diag(K))).dot(y_train - np.dot(K, y_train) / (1 + np.diag(K))))
        sigma = 1 / (1 + np.exp(-k))
        return mu, sigma

    def expected_improvement(x, X_train, y_train, gp_mean, gp_std):
        pred, _ = gp_model(x, X_train, y_train, 0.5)
        std = gp_std
        if std == 0:
            return np.inf
        ei = (pred - y_train[-1]) / std * norm.cdf((pred - y_train[-1]) / std) + std * norm.pdf((pred - y_train[-1]) / std)
        return -ei

    X_train = rng.uniform(lb, ub, size=(budget, dim))
    y_train = np.array([func(x) for x in X_train])
    best_x = X_train[np.argmin(y_train)]
    best_y = np.min(y_train)

    for _ in range(10 * budget):
        new_x = rng.uniform(lb, ub, size=dim)
        gp_mean, gp_std = gp_model(new_x, X_train, y_train, 0.5)
        if np.random.rand() < 0.1:
            ei = expected_improvement(new_x, X_train, y_train, gp_mean, gp_std)
            if ei > -best_y * 10:
                new_x = rng.uniform(lb, ub, size=dim)
        elif np.linalg.norm(new_x - best_x) < (ub - lb) / 2:
            new_x = best_x + rng.normal(size=dim) * (ub - lb) / 4
        X_train = np.vstack([X_train, new_x])
        y_train = np.append(y_train, func(new_x))
        idx = np.argsort(y_train)[:budget]
        X_train = X_train[idx]
        y_train = y_train[idx]

    return best_x
