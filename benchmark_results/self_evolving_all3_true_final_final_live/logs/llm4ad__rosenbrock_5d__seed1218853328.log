def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def fitness(x):
        x = clip(x)
        return func(x)

    best_x = None
    best_f = float('inf')

    for i in range(budget):
        N = 10 + int(0.1 * budget)  # Population size increases with the number of iterations
        mu, sigma = 0.5, 0.5  # Initial mean and standard deviation
        weights = np.ones(N) / N

        for _ in range(int(budget / N)):
            X = rng.normal(mu, sigma, (N, dim))

            F = np.array([fitness(X[i]) for i in range(N)])

            new_mu = np.dot(weights, X)
            new_sigma = np.sqrt(np.sum(weights * (X - new_mu) ** 2))

            mu, sigma = new_mu, new_sigma

            idx_best = np.argmax(F)

            if F[idx_best] < best_f:
                best_x = clip(X[idx_best])
                best_f = F[idx_best]

    return best_x
