def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    temperature = 1.0
    step_size = 2.0 * (ub - lb) / dim
    
    for _ in range(budget):
        x_new = x_best + rng.normal(size=dim) * step_size
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        if f_new < f_best:
            x_best = x_new
            f_best = f_new
        
        delta = f_new - f_best
        if delta < 0 or rng.rand() < np.exp(-delta / temperature):
            temperature *= 0.9999
            
    return x_best
