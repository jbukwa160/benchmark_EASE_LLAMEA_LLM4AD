def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    T = 10 * (ub - lb)
    alpha = 0.9
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(budget):
        new_x = clip(x + rng.uniform(-1, 1, size=dim) * (ub - lb))
        new_f = func(new_x)
        
        if new_f < best_f:
            best_f = new_f
            best_x = new_x.copy()
        
        delta_f = new_f - best_f
        
        if delta_f > 0 or np.random.rand() < np.exp(-delta_f / T):
            x = new_x
            
        T *= alpha
    
    return best_x
