def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([np.random.uniform(lb[i], ub[i]) for i in range(dim)])
    
    for _ in range(budget):
        y = func(x)
        
        for i in range(dim):
            dx = np.random.uniform(-1, 1)
            dy = func(np.clip(x.copy() + dx * (x[i] - lb[i]), lb, ub)) - y
            
            if dy < 0:
                x[i] += 0.01 * dx
                y = func(x)
        
        print(f'Iteration {_}, best solution: {np.round(x, 2)}, function value: {y}')
    
    return np.clip(x, lb, ub)
