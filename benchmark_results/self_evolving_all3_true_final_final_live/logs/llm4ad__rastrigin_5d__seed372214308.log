def algorithm(func, dim, lb, ub, budget, rng):
    def sample(rng, lb, ub, dim):
        return rng.uniform(lb, ub, size=dim)

    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def rastrigin(x):
        n = len(x)
        return 10 * n + sum(i**2 - 10 * np.cos(2 * np.pi * i) for i in x)

    current_best = sample(rng, lb, ub, dim)
    current_best_fitness = rastrigin(current_best)
    
    temperature = 1.0
    budget_used = 0
    
    while budget_used < budget:
        new_candidate = sample(rng, lb, ub, dim)
        
        new_candidate_fitness = rastrigin(new_candidate)
        
        if new_candidate_fitness < current_best_fitness:
            current_best_fitness = new_candidate_fitness
            current_best = clip(new_candidate, lb, ub)
            
        temperature *= 0.99
        
        probability = np.exp((current_best_fitness - new_candidate_fitness) / temperature)
        
        if rng.uniform(0, 1) < probability or (new_candidate_fitness < current_best_fitness and rng.uniform(0, 1) > 0.5):
            current_best_fitness = new_candidate_fitness
            current_best = clip(new_candidate, lb, ub)
            
        budget_used += 1
    
    return current_best
