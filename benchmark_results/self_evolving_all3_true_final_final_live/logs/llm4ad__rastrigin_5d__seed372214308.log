def algorithm(func, dim, lb, ub, budget, rng):
    def gp_model(x, y):
        X = np.vstack((X_gp, x))
        Y = np.hstack((Y_gp, y))
        sigma2 = 1e-9 + np.var(Y)
        k = np.sum(X**2, axis=1).reshape(-1, 1) - 2 * np.dot(X, x) + x**2
        L = np.linalg.cholesky(np.eye(dim) + (k / sigma2))
        alpha = Y - np.dot(L, np.linalg.solve(L.T @ L, y))
        return L, alpha

    def predict(x):
        k = np.sum(X_gp**2, axis=1).reshape(-1, 1) - 2 * np.dot(X_gp, x) + x**2
        sigma2 = 1e-9 + np.var(Y_gp)
        m = Y_gp + np.dot(np.linalg.solve(L.T @ L, k / (sigma2 + k)), alpha)
        return m

    X_gp = rng.uniform(lb, ub, size=(10, dim))
    Y_gp = func(X_gp)

    best_x = None
    best_y = np.inf
    for _ in range(budget):
        x = predict(rng.uniform(lb, ub, size=dim))
        y = func(x)
        if y < best_y:
            best_y = y
            best_x = x

        L, alpha = gp_model(x, y)
        X_gp = np.vstack((X_gp, x))
        Y_gp = np.hstack((Y_gp, y))

    return best_x
