def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_sol = None
    best_eval = float('inf')

    for _ in range(budget // (dim + 1)):
        x0 = rng.uniform(lb, ub, size=dim)
        local_best = x0.copy()
        local_best_eval = func(x0)

        for _ in range(dim * 10):
            dx = rng.normal(size=dim) / np.sqrt(2.0)
            x_new = clip(local_best + 1e-6 * dx)
            new_eval = func(x_new)

            if new_eval < local_best_eval:
                local_best = x_new
                local_best_eval = new_eval

        new_eval = func(clip(local_best))
        if new_eval < best_eval:
            best_sol = local_best.copy()
            best_eval = new_eval

    return best_sol
