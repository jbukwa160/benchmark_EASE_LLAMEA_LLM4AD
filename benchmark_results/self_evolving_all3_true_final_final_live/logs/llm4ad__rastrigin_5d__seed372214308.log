def algorithm(func, dim, lb, ub, budget, rng):
    mu = np.zeros(dim)
    sigma = 0.1 * (ub - lb)

    for _ in range(budget):
        candidates = mu + rng.normal(size=(dim,)) * sigma
        candidates = np.clip(candidates, lb, ub)

        fitness = func(candidates)
        if fitness < func(mu):
            mu = candidates

    return mu
