def algorithm(func, dim, lb, ub, budget, rng):
    n = int(np.sqrt(budget)) + 1
    pop_size = n ** 2
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    for _ in range(n):
        population = rng.uniform(lb, ub, size=(pop_size, dim))
        for i in range(pop_size):
            y_i = population[i]
            if func(y_i) < f_best:
                x_best = y_i
                f_best = func(y_i)
        
        F = 0.5
        CR = 1 / (2 * dim + 1)
        for _ in range(int(budget / n)):
            mutated_population = np.copy(population)
            for i in range(pop_size):
                r1, r2, r3 = rng.choice(pop_size, size=3, replace=False), rng.choice(pop_size, size=3, replace=False)
                u_i = population[r1] + F * (population[r2] - population[r3])
                mutated_population[i] = np.where(rng.uniform(size=dim) < CR,
                                                  u_i,
                                                  population[i])
            
            for i in range(pop_size):
                y_i = mutated_population[i]
                if func(y_i) < f_best:
                    x_best = y_i
                    f_best = func(y_i)
        
        clipped_x_best = np.clip(x_best, lb, ub)
        population = rng.uniform(lb, ub, size=(pop_size, dim))
        for i in range(pop_size):
            if func(np.clip(population[i], lb, ub)) < func(clipped_x_best):
                x_best = population[i]
        
    return np.array([x_best])
