def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        return func(x) / 1000  # scale the function for better convergence

    n = int(budget ** (1. / dim))
    x = rng.uniform(lb, ub, size=dim)
    best_x = clip(x.copy())
    best_f = evaluate(best_x)

    for _ in range(n):
        y = x + rng.normal(size=dim) * 0.5
        f_y = evaluate(clip(y))

        if rng.random() < np.exp((best_f - f_y) / (evaluate(best_x) + 1e-6)):
            best_x, best_f = y, f_y

        for i in range(dim):
            z = x.copy()
            z[i] += rng.normal(size=1) * 0.05
            f_z = evaluate(clip(z))
            if f_z < best_f:
                best_x, best_f = z, f_z

    return best_x
