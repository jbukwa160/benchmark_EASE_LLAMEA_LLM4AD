def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=dim)
    best_fit = func(x_best)
    temp = 1000.0
    alpha = 0.995  # cooling rate

    for _ in range(budget):
        x_new = x_best + rng.uniform(-1, 1, size=dim) * (ub - lb)
        x_new = np.clip(x_new, lb, ub)

        fit_new = func(x_new)
        if fit_new < best_fit:
            x_best = x_new
            best_fit = fit_new

        delta_fit = fit_new - best_fit
        prob_accept = np.exp(-delta_fit / temp)
        r = rng.uniform(0, 1)
        if r < prob_accept or delta_fit <= 0:
            pass
        else:
            temp *= alpha

    return x_best
