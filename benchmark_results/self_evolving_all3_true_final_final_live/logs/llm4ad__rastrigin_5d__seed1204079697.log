def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def rastrigin(x):
        return func(x) + 10*dim

    def objective(x):
        x = clip(x)
        return rastrigin(x)

    def cmaes(n_evals, dim, lb, ub, rng):
        weights = np.array([1.0/dim]*dim)
        mean = np.zeros(dim)
        cov = np.eye(dim)*5
        best_x = None
        best_f = float('inf')

        for _ in range(n_evals):
            x = np.random.multivariate_normal(mean, cov, 1)[0]
            f = objective(x)

            if f < best_f:
                best_f = f
                best_x = x

            weights[weights < 1e-8] = 1e-8  # numerical stability
            weights /= sum(weights)
            cov = np.eye(dim) + (np.outer(x - mean, x - mean) * weights)

            weights *= 0.5**(1/dim)  # learning rate adaptation

        return best_x, best_f

    budget //= dim  # reduce budget for each dimension
    restarts = [budget]

    for _ in range(3):  # three restarts
        x, f = cmaes(restarts.pop(), dim, lb, ub, rng)
        if f < objective(x):
            return x

    return np.zeros(dim)
