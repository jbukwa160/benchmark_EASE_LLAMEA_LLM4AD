def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        x_new = x + rng * (ub - lb) * np.random.randn(dim)
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        
        if f_new < best_f:
            best_x = x_new
            best_f = f_new
        
        alpha = 0.95 ** rng
        beta = 1 - (ub - lb) * rng
        delta = func(best_x) - f_new
        
        if delta > 0 and np.random.rand() < np.exp(-delta / beta):
            x = x_new
    
    return best_x
