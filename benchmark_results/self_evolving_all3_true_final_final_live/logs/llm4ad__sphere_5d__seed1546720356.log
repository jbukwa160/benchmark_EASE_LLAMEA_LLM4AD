def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    best_f = func(x)

    step_size = 1.0
    for _ in range(budget):
        new_x = x + np.multiply((ub - lb) * rng.randn(dim), step_size)
        new_x = np.clip(new_x, lb, ub)
        
        new_f = func(new_x)
        
        if new_f < best_f:
            best_f = new_f
            best_x = new_x.copy()
            
        # adapt step size
        step_size *= 0.9 + (1 / (np.sqrt(_ + 2) * (1 + _ / budget)))
        
        x = new_x
        
    return best_x
