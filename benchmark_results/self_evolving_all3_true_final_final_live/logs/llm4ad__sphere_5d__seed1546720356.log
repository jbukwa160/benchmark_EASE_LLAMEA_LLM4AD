def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_candidate = rng.uniform(lb, ub, size=dim)
    current_cost = func(clip(best_candidate))

    for _ in range(budget - 1):
        new_candidate = np.copy(best_candidate)
        new_candidate += rng.uniform(-0.5, 0.5, size=dim)

        # Clip to bounds
        new_candidate = clip(new_candidate)

        new_cost = func(clip(new_candidate))
        
        if new_cost < current_cost:
            best_candidate = new_candidate
            current_cost = new_cost
        else:
            # Acceptance probability based on temperature (cost)
            alpha = 0.9 ** (1 + np.abs(current_cost - new_cost))  # Temperature update rule
            accept = np.random.rand() < alpha

            if accept:
                best_candidate = new_candidate
                current_cost = new_cost

    return clip(best_candidate)
