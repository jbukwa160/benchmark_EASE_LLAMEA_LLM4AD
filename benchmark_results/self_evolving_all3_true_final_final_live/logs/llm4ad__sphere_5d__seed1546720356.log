def algorithm(func, dim, lb, ub, budget, rng):
    n_points = int(np.ceil(budget / 10))
    n_restarts = int(np.floor(budget / (n_points * 100)))
    
    for _ in range(n_restarts + 1):
        x_best = None
        f_best = float('inf')
        
        for _ in range(n_points):
            x = rng.uniform(lb, ub, size=dim)
            f = func(x)
            
            if f < f_best:
                f_best = f
                x_best = x
                
    return np.clip(np.array(x_best), lb, ub)
