def algorithm(func, dim, lb, ub, budget, rng):
    def bounded_candidate(dim, lb, ub, rng):
        candidate = rng.uniform(lb, ub, size=dim)
        return np.clip(candidate, a_min=lb, a_max=ub)

    current_solution = np.zeros(dim)
    best_solution = current_solution
    best_value = func(current_solution)

    for _ in range(budget):
        # Random Search
        candidate = bounded_candidate(dim, lb, ub, rng)
        value = func(candidate)

        if value < best_value:
            best_solution = candidate
            best_value = value

        # Simulated Annealing
        alpha = 0.99  # cooling factor
        delta = value - best_value
        temperature = _temperature(alpha, budget, _)

        if rng.uniform(0, 1) < np.exp(-delta / temperature):
            current_solution = candidate
            if value < best_value:
                best_solution = candidate
                best_value = value

    return best_solution
