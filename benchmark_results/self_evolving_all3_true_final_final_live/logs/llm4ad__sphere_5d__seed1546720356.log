def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_obj = objective(best_x)
    current_obj = best_obj

    T = 1.0
    alpha = 0.99
    beta = 2.0 / (dim + 1)

    for i in range(budget):
        new_x = np.clip(x + rng.normal(0, 1, size=dim), lb, ub)
        new_obj = objective(new_x)

        if new_obj < current_obj:
            current_obj = new_obj
            x = new_x

            if new_obj < best_obj:
                best_obj = new_obj
                best_x = new_x
        else:
            prob = np.exp((current_obj - new_obj) / T)
            if rng.uniform(0, 1) < prob:
                current_obj = new_obj
                x = new_x

        T *= alpha
        if i % (budget // 10) == 0:
            T *= beta

    return best_x
