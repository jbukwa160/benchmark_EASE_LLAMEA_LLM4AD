def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=dim)
    best_val = func(x_best)

    for _ in range(budget):
        alpha = 1 / (1 + _)
        sigma = np.maximum(0.01, 0.9 * rng.uniform(0, 1))
        x_new = x_best + alpha * sigma * (ub - lb) * rng.normal(size=dim)

        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)

        val_new = func(x_new)
        if val_new < best_val:
            x_best = x_new
            best_val = val_new

    return x_best
