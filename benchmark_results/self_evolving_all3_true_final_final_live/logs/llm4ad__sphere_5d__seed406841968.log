def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 10 * dim
    sigma = 0.5
    mu = np.zeros(dim)
    c_c = 1 / (dim + 2)
    c_cov = 2 / (dim + 3)

    for _ in range(budget):
        x = np.clip(rng.normal(mu, sigma), lb, ub).reshape(-1, dim)

        f_x = np.array([func(xi) for xi in x])

        best_idx = np.argmin(f_x)
        if f_x[best_idx] < func(mu):
            mu = x[best_idx]

    return mu
