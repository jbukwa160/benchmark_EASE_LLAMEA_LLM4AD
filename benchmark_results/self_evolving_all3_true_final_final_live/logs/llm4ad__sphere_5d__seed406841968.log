def algorithm(func, dim, lb, ub, budget, rng):
    population_size = 100
    temp_schedule = lambda t: 1 - (t / budget) ** 2
    mutation_rate = 0.01
    elite_count = int(population_size * 0.2)

    def generate_initial_population(size):
        return np.clip(rng.uniform(lb, ub, size=(size, dim)), lb, ub)

    def evaluate_individual(x):
        return func(x), x

    def mutate(individual):
        mutated = individual + rng.normal(0, mutation_rate, size=individual.shape)
        return np.clip(mutated, lb, ub)

    population = generate_initial_population(population_size)
    best_solution = None
    best_value = float('inf')

    for t in range(budget):
        fitness_values, individuals = zip(*[evaluate_individual(x) for x in population])
        sorted_indices = np.argsort(fitness_values)[:elite_count]
        elite_individuals = [population[i] for i in sorted_indices]

        new_population = []
        for _ in range(population_size - elite_count):
            parent1, parent2 = random.sample(elite_individuals, 2)
            child = (parent1 + parent2) / 2
            mutated_child = mutate(child)
            new_population.append(mutated_child)

        population = np.array(new_population + elite_individuals)

        temp = temp_schedule(t)
        for i in range(population_size):
            if rng.random() < temp:
                individual = population[i]
                mutated = mutate(individual)
                fitness, _ = evaluate_individual(mutated)
                if fitness < fitness_values[i]:
                    population[i] = mutated

        current_best_value, current_best_solution = min(zip(fitness_values, individuals), key=lambda x: x[0])
        if current_best_value < best_value:
            best_value = current_best_value
            best_solution = current_best_solution

    return best_solution
