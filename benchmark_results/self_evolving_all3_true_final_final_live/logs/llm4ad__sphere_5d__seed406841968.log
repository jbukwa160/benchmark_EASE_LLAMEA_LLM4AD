def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def sample():
        x = rng.normal(size=dim)
        while not (lb <= x <= ub).all():
            x = rng.normal(size=dim)
        return x

    def evaluate(x):
        x = clip(x)
        return func(x), x

    best_x = np.zeros(dim)
    best_f = float('inf')

    for t in range(budget):
        sigma = 1 / (t + 2) ** 0.5
        pop_size = int((budget - t) * rng.uniform(1, 10))
        X = [sample() for _ in range(pop_size)]

        F, x = evaluate(np.mean(X, axis=0))

        if F < best_f:
            best_x = x
            best_f = F

        for i in range(pop_size):
            delta = np.array(X[i]) - best_x
            alpha = rng.normal(size=dim)
            new_x = best_x + sigma * (1 + 2 * delta.T @ delta / (dim + 1)) ** 0.5 * alpha
            F, x = evaluate(new_x)

            if F < best_f:
                best_x = x
                best_f = F

        for i in range(pop_size):
            X[i] = new_x

    return best_x
