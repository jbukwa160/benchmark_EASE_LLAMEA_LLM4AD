def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 1e4
    t = 0
    while t < budget:
        new_x = x + np.random.normal(size=dim)
        new_x = np.clip(new_x, lb, ub)
        delta = func(new_x) - func(x)
        if delta <= 0 or rng.uniform(0, 1) < np.exp(-delta / T):
            x = new_x
        T *= 0.9999
        t += 1
    return x
