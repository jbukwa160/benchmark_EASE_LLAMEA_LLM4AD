def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    best_x = rng.uniform(lb, ub, size=dim)
    best_f = f(best_x)

    for _ in range(budget):
        z = np.clip(rng.normal(size=dim), a_min=lb, a_max=ub)
        x = z + 0.5 * (best_x - np.clip(np.random.uniform(-1, 1, size=dim) * best_x + rng.uniform(lb, ub, size=dim), a_min=lb, a_max=ub))
        
        fx = f(x)
        if fx < best_f:
            best_f = fx
            best_x = x

    return best_x
