def algorithm(func, dim, lb, ub, budget, rng):
    def rosen(x):
        return func(x)

    D = dim
    pop_size = int(np.sqrt(budget))
    sigma = 0.1
    x_best = np.random.uniform(lb, ub, (pop_size, D))
    f_best = np.inf

    for _ in range(pop_size):
        y = rosen(x_best[_])
        if y < f_best:
            f_best = y
            x_best_best = x_best[_]
    
    cma = {'mu': 0.8, 'sigma': sigma, 'popsize': pop_size}
    m = len(x_best)

    for iteration in range(budget):
        # Sample from the normal distribution with mean and covariance matrix adapted based on previous solutions
        z = np.random.normal(0, cma['sigma'], (m, D))
        
        x_candidate = x_best + cma['mu'] * cma['sigma'] * z
        
        # Clip candidates to [lb, ub]
        for i in range(m):
            for j in range(D):
                if x_candidate[i, j] < lb:
                    x_candidate[i, j] = lb
                elif x_candidate[i, j] > ub:
                    x_candidate[i, j] = ub
        
        # Evaluate the objective function and update best solution and covariance matrix
        f_candidate = np.array([rosen(x) for x in x_candidate])
        
        if iteration % (budget // 10) == 0 or budget < 100:
            print(f'Iteration {iteration+1}, Best objective: {np.min(f_candidate)}')
        
        # Update the best solution
        idx_best = np.argmin(f_candidate)
        if f_candidate[idx_best] < f_best:
            x_best_best = x_candidate[idx_best]
            f_best = f_candidate[idx_best]

    return x_best_best
