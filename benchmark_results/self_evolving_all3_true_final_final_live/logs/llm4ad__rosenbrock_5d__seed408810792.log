def algorithm(func, dim, lb, ub, budget, rng):
    def func_wrapper(x):
        return func(np.clip(x, lb, ub))

    def polynomial_mutation(x, sigma, F):
        z = np.random.normal(0, 1, x.shape)
        y = (x + sigma * F * np.power((1 - F) + F * np.abs(z), 2.4)) / (1 + F)
        return np.clip(y, lb, ub)

    def cma_es(x0, budget):
        mu = np.array(x0)
        cov_matrix = np.eye(len(x0))
        sigma = 10
        step_size = 100

        for _ in range(budget):
            y = func_wrapper(mu)
            if rng.uniform(0, 1) < 0.5:
                mu += np.random.normal(0, sigma, x0.shape)

            if rng.uniform(0, 1) < 0.05:
                sigma *= rng.uniform(0.8, 1.2)

            if rng.uniform(0, 1) < 0.01:
                F = rng.uniform(-5, 5)
                mu = polynomial_mutation(mu, sigma, F)

            cov_matrix += np.outer(np.random.normal(0, 1, x0.shape), np.random.normal(0, 1, x0.shape))
            cov_matrix /= len(cov_matrix) * (len(cov_matrix) - 1)
            z = rng.normal(0, 1, x0.shape)

            mu += step_size * np.dot(np.linalg.cholesky(cov_matrix).T, z)

        return mu

    return cma_es([np.random.uniform(lb, ub) for _ in range(dim)], budget)
