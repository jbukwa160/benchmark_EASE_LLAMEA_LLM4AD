def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    f_x = func(x)
    for _ in range(budget):
        y = x + 0.1 * (ub - lb) * rng.randn(dim)
        y = np.clip(y, lb, ub)
        f_y = func(y)
        if f_y < f_x:
            x = y
            f_x = f_y
    return x
