def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (1, dim))
    T = 1000.0
    alpha = 0.99
    gamma = 10.0
    beta = 0.01

    for _ in range(budget):
        g = np.zeros((1, dim))
        f_x = func(x)

        for i in range(dim):
            x_i = x[0, i] + 1e-8
            x[-1, i] = x_i
            g[-1, i] = (func(x) - f_x) / (x_i - x[0, i])
            x[-1, i] = x[0, i]

        if np.linalg.norm(g) < 1e-6:
            break

        T *= alpha
        r = rng.uniform(0, 1)
        s = np.zeros((1, dim))
        for i in range(dim):
            s[-1, i] = g[-1, i] * (T / np.linalg.norm(g)) ** beta + (ub - lb) * rng.uniform(-1, 1)

        x -= (s - g) / np.linalg.norm(s - g)
        x = np.clip(x, lb, ub)

    return x
