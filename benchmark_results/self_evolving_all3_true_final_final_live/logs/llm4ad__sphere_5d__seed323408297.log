def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    def gp_model(x, X, y, sigma_f, l, sig_sq):
        K = np.exp(-np.sum((X[:, None] - x[None, :])**2, axis=2) / (2 * l**2)) + sig_sq * np.eye(dim)
        return np.dot(K, y)

    def gp_lml(X, y, sigma_f, l, sig_sq):
        K = np.exp(-np.sum((X[:, None] - X[None, :])**2, axis=2) / (2 * l**2)) + sig_sq * np.eye(dim)
        return 0.5 * dim * np.log(2 * np.pi) + 0.5 * np.log(np.linalg.det(K)) + 0.5 * np.dot(y.T, np.linalg.solve(K, y))

    def cma_es_step(x, X, y, sigma_f, l, sig_sq):
        return x + rng.normal(size=x.shape) * sigma_f

    best_x = None
    best_y = float('inf')
    N = 10
    for i in range(budget // (2*N)):
        x = clip(cma_es_step(np.zeros(dim), X[-N:], y[-N:], np.exp(rng.uniform(-3, -1)), l=rng.uniform(0.1, 1), sig_sq=1e-6))
        y = func(x)
        if y < best_y:
            best_x = x
            best_y = y
        X.append(x)
        y.append(y)

    return clip(best_x)
