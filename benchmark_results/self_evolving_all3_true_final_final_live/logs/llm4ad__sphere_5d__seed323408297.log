def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.array(rng.uniform(lb, ub, size=dim))
    best_fx = func(best_x)
    
    for _ in range(budget):
        r = np.mean(np.abs(ub - lb)) / 2
        s = rng.normal(size=dim) * r + best_x
        s = np.clip(s, lb, ub)
        
        fx = func(s)
        if fx < best_fx:
            best_x = s
            best_fx = fx
            
    return best_x
