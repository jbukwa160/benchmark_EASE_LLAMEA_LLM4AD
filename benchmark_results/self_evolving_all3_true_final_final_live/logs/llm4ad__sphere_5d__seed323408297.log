def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    s = 1.0 / (budget ** 0.5)

    for i in range(budget):
        x_cand = x_best + rng.normal(0, s, size=dim)
        x_cand = np.clip(x_cand, lb, ub)

        f_cand = func(x_cand)

        if f_cand < f_best:
            x_best = x_cand
            f_best = f_cand

        s *= 0.9  # decay the step size

    return x_best
