def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.minimum(np.maximum(x, lb), ub)

    pop_size = 50
    x_best = None
    f_best = float('inf')

    for _ in range(budget):
        # Initialize population
        x = rng.uniform(lb, ub, (pop_size, dim))

        # Evaluate function at all points in the population
        f = func(x)

        # Identify current best point(s)
        idx = np.argwhere(f == np.min(f))
        if len(idx) > 0:
            x_best = clip(x[idx][0], lb, ub)
            f_best = np.min(f)

        # Differential Evolution step
        for i in range(pop_size):
            p1, p2, p3 = rng.choice(pop_size, 3, replace=False)
            v_i = clip(0.5 * (x[p1] + x[p2]) + 0.5 * rng.uniform(-ub, ub, dim), lb, ub)

        # Adaptive crossover and mutation
        for i in range(pop_size):
            if f[i] < f_best:
                r = rng.uniform(0, 1)
                if r > 0.5:
                    x[i] = clip(0.9 * x[i] + 0.1 * v_i, lb, ub)
                else:
                    x[i] = clip(v_i + 0.01 * rng.normal(0, 1, dim), lb, ub)

    return x_best
