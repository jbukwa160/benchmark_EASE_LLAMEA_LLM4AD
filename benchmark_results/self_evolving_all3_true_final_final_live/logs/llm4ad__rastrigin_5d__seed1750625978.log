def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for i in range(budget):
        n1 = rng.choice(dim, size=3, replace=False)
        u = rng.uniform(0, 1, size=dim)
        v = rng.uniform(-1, 1, size=dim)
        x_new = x_best + u * (x_best - x_best[n1]) + v * ub

        # clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)

        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
