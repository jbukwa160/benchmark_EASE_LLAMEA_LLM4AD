def algorithm(func, dim, lb, ub, budget, rng):
    def sample():
        return rng.uniform(lb, ub, size=dim)

    def evaluate(x):
        return func(x) + 1e-20  # Avoid log of zero

    def mutate(x, sigma):
        noise = np.random.randn(dim)
        return x + sigma * noise

    def clip(x):
        return np.clip(x, lb, ub)

    cma = {'mu': sample(), 'sigma': 0.5, 'step_size': 1e-4, 'cov': np.eye(dim) / (dim - 2)}
    best_x = clip(cma['mu'])
    best_f = evaluate(best_x)
    budget_used = 1

    for i in range(1, budget):
        new_sigma = cma['sigma'] + cma['step_size']
        candidates = [clip(mutate(cma['mu'], new_sigma)) for _ in range(dim * 10)]
        candidate_f = np.array([evaluate(candidate) for candidate in candidates])

        if np.all(np.isclose(candidate_f, best_f)):
            break

        indices = np.argsort(candidate_f)[:dim]
        cma['mu'] = clip(candidates[indices])
        cma['sigma'] = new_sigma
        cma['cov'] = (1 - 2 / (i + 10)) * cma['cov'] + 1 / (i + 10) * np.outer(candidates[indices].mean(axis=0) - cma['mu'], candidates[indices].mean(axis=0) - cma['mu'])

        best_x = clip(cma['mu'])
        best_f = evaluate(best_x)
        budget_used += dim

    return best_x
