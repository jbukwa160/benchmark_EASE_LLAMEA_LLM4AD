def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(dim, lb, ub):
        candidate = np.zeros(dim)
        for i in range(dim):
            candidate[i] = (ub - lb) * rng.uniform(0, 1) + lb
        return candidate

    n_candidates = int(np.ceil(budget ** (1 / dim)))
    best_x = get_candidate(dim, lb, ub)
    best_f = func(best_x)

    grid_size = [int(np.sqrt(n_candidates)) for _ in range(dim)]
    candidates = np.zeros((n_candidates, dim))
    for i in range(n_candidates):
        x = get_candidate(dim, lb, ub)
        candidates[i] = x

    for _ in range(budget - n_candidates):
        new_candidates = []
        for i in range(grid_size[0]):
            for j in range(grid_size[1]):
                for k in range(grid_size[2]):
                    for l in range(grid_size[3]):
                        for m in range(grid_size[4]):
                            x = np.zeros(dim)
                            x[0] = (i + rng.uniform(0, 1)) / grid_size[0] * (ub - lb) + lb
                            x[1] = (j + rng.uniform(0, 1)) / grid_size[1] * (ub - lb) + lb
                            x[2] = (k + rng.uniform(0, 1)) / grid_size[2] * (ub - lb) + lb
                            x[3] = (l + rng.uniform(0, 1)) / grid_size[3] * (ub - lb) + lb
                            x[4] = (m + rng.uniform(0, 1)) / grid_size[4] * (ub - lb) + lb
                            new_candidates.append(x)

        for x in new_candidates:
            if func(x) < best_f:
                best_x = x
                best_f = func(x)
            candidates.append(x)

    return best_x
