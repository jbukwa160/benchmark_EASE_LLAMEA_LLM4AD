def algorithm(func, dim, lb, ub, budget, rng):
    def latin_hypercube_sampling(dim, bounds):
        samples = []
        for i in range(dim):
            sample_i = rng.uniform(bounds[0], bounds[1])
            samples.append(sample_i)
        return samples

    def perturb(solution, sigma):
        new_solution = solution + rng.normal(0, sigma, size=dim)
        new_solution = np.clip(new_solution, lb, ub)
        return new_solution

    def acceptance_probability(current_fitness, new_fitness, T):
        if new_fitness < current_fitness:
            return 1.0
        else:
            return np.exp((current_fitness - new_fitness) / T)

    best_solution = latin_hypercube_sampling(dim, (lb, ub))
    best_fitness = func(best_solution)
    current_temperature = budget * 10

    for _ in range(budget):
        sigma = rng.uniform(0.1, 1.0)
        new_solution = perturb(best_solution, sigma)
        new_fitness = func(new_solution)

        if new_fitness < best_fitness:
            best_solution = new_solution
            best_fitness = new_fitness

        alpha = acceptance_probability(best_fitness, new_fitness, current_temperature)
        if rng.uniform(0, 1) > alpha:
            best_solution = new_solution
            best_fitness = new_fitness

        current_temperature *= 0.9999
    return best_solution
