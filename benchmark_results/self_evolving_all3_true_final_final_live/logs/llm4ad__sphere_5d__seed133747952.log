def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    current_best = np.array([lb + (ub - lb) * rng.rand(dim)])
    temperature = 1.0

    for _ in range(budget):
        candidate = current_best + rng.normal(size=(dim,))
        candidate = clip(candidate)

        delta = evaluate(candidate) - evaluate(current_best)
        if delta < 0:
            current_best = candidate
        else:
            prob = np.exp(-delta / temperature)
            if rng.rand() < prob:
                current_best = candidate

        temperature *= 0.99999  # adaptive cooling schedule

    return current_best
