def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    T = 10.0
    alpha = 0.95

    for i in range(budget):
        while True:
            y_temp = clip(x_best + rng.randn(dim))
            if rng.rand() < np.exp((f_best - func(y_temp)) / T):
                x_best, f_best = y_temp, func(y_temp)
                break
            elif rng.rand() < 0.1 and i > budget * 0.9:
                x_best = clip(x_best + rng.randn(dim) * (ub - lb))
        T *= alpha

    return x_best
