def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    learning_rate = 0.01
    
    for _ in range(budget):
        g = np.zeros(dim)
        
        for i in range(dim):
            x_try = x + learning_rate * g
            x_try = np.clip(x_try, lb, ub).reshape(1, -1)
            
            f_try = func(x_try)
            f_best_try = min(best_f, f_try)
            
            if f_best_try < best_f:
                best_x = x_try.copy()
                best_f = f_best_try
            
            g[i] = (func(x + 0.01 * np.eye(dim)[i]) - func(x)) / 0.01
        
        x = best_x.copy()
    
    return best_x
