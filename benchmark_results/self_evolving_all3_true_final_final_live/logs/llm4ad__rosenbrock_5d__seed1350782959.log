def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = objective(x_best)

    for _ in range(budget):
        x_temp = x_best.copy()
        for i in range(dim):
            r1, r2 = np.random.choice(range(dim), 2, replace=False)
            while r1 == i:
                r1 = np.random.choice(range(dim), replace=False)
            while r2 == i or r2 == r1:
                r2 = np.random.choice(range(dim), replace=False)

            m = x_temp[r1] + 0.5 * (x_temp[r2] - x_temp[r1]) * rng.rand()
            if rng.rand() < 0.5 and abs(m) > lb:
                m = max(lb, min(ub, m))
            x_temp[i] = m

        f_temp = objective(x_temp)

        if f_temp < f_best:
            x_best = x_temp.copy()
            f_best = f_temp

    return x_best
