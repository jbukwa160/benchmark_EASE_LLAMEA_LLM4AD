def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    current_best = np.array([0.5] * dim)
    best_fitness = func(current_best)

    for _ in range(budget):
        # Randomly restart the optimization process with probability 0.1
        if rng.rand() < 0.1:
            current_best = clip(rng.uniform(lb, ub, size=dim))

        # Calculate the gradient of the function at the current best solution
        grad = np.zeros(dim)
        for i in range(dim):
            epsilon = 1e-4 * (ub - lb) / 2
            x_plus_epsilon = clip(current_best.copy() + epsilon * rng.uniform(-1, 1, size=dim))
            x_minus_epsilon = clip(current_best.copy() - epsilon * rng.uniform(-1, 1, size=dim))

            grad[i] = (func(x_plus_epsilon) - func(x_minus_epsilon)) / (2.0 * epsilon)

        # Update the current best solution using gradient descent with adaptive step size
        alpha = 0.01
        gamma = 0.9
        beta = 0.1

        for i in range(dim):
            alpha_i = alpha * np.exp(-beta * grad[i]**2)
            current_best[i] -= alpha_i * grad[i]

        # Evaluate the fitness of the new solution and update the best solution if necessary
        current_fitness = func(current_best)

        if current_fitness < best_fitness:
            best_fitness = current_fitness

    return clip(current_best)
