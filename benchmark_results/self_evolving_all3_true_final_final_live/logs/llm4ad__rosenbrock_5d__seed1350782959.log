def algorithm(func, dim, lb, ub, budget, rng):
    def rosenbrock(x):
        return sum(100*(x[i+1]-x[i]**2)**2 + (1-x[i])**2 for i in range(dim-1)) + sum((1-x[-1])**2)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)
    cma = []
    pso = []

    for _ in range(budget):
        # CMA-ES
        if rng.rand() < 0.5:
            mu, sigma = 1.0, 0.1
            mean = np.copy(x_best)
            cov = np.eye(dim) * (sigma ** 2)

            for i in range(dim):
                cov[i, i] = max(cov[i, i], 0.01)
                z = rng.randn(dim)
                x_new = np.exp(0.5 * sigma**2) * z + mean
                f_new = func(x_new)
                if f_new < f_best:
                    x_best = x_new
                    f_best = f_new

        # PSO
        else:
            w, c1, c2 = 0.7298, 1.49618, 1.49618
            x_pso = np.copy(x_best)
            v_pso = rng.uniform(lb, ub, size=dim)

            for i in range(dim):
                r1, r2 = rng.rand(), rng.rand()
                a1, a2 = c1 * r1, c2 * r2
                x_new = w * v_pso[i] + a1 * x_pso[i] + a2 * (ub - lb) * rng.randn()

                if 0 <= x_new <= ub:
                    f_new = func(x_new)
                    if f_new < f_best:
                        x_best = x_new
                        f_best = f_new

    return x_best
