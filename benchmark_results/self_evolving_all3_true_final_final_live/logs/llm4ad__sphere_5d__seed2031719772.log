def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget - 1):
        x_new = x_best + rng.uniform(-1, 1, size=dim) * (ub - lb) / 2
        f_new = func(np.clip(x_new, lb, ub))
        
        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return np.array([x_best])
