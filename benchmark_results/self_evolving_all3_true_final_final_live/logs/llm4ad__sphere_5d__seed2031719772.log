def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    for _ in range(budget):
        candidate = np.clip(rng.uniform(lb, ub, size=dim), lb, ub)
        value = func(candidate)
        if value < func(best):
            best = candidate
    return best
