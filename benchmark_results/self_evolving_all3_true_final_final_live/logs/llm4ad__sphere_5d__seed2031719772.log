def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    best = np.random.uniform(lb, ub, size=dim)
    best_fitness = func(clip(best))

    for _ in range(budget - 1):
        mutated = best + rng.uniform(-1, 1, size=dim) * (ub - lb)
        crossed_over = clip(np.where(rng.uniform(size=dim) < 0.5, mutated, best))
        candidate_fitness = func(crossed_over)

        if candidate_fitness < best_fitness:
            best_fitness = candidate_fitness
            best = crossed_over

    return best
