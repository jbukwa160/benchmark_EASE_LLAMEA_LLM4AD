def algorithm(func, dim, lb, ub, budget, rng):
    best_x = -np.ones(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        for i in range(int(1e4)):
            x_new = x + 0.01 * rng.normal(size=dim)
            x_new = np.clip(x_new, lb, ub)
            f = func(x_new)
            if f < best_f:
                best_x = x_new
                best_f = f
            alpha = 0.1 / (i ** 0.6 + 1)
            x += alpha * rng.normal(size=dim)
            x = np.clip(x, lb, ub)
    
    return best_x
