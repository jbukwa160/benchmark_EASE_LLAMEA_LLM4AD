def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def polynomial_mutation(x, sigma):
        n = len(x)
        for i in range(n):
            if rng.random() < 0.1:
                x[i] += rng.uniform(-sigma, sigma)
                if abs(x[i]) > 5:
                    x[i] = np.sign(x[i]) * 5
        return clip(x)

    def cma_es(x, budget):
        n = len(x)
        mu = 1 + 0.01 * n
        sigma = 10 / (1 + np.sqrt(2 * n))
        for _ in range(budget):
            y = polynomial_mutation(x.copy(), sigma)
            if func(y) < func(x):
                x = y
        return x

    x = rng.uniform(lb, ub, dim)
    best_x = cma_es(x, budget)
    return best_x
