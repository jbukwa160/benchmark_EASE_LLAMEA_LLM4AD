def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(x):
        return x + rng.normal(0, 1, size=dim)

    current = np.array([ub] * dim)
    best_so_far = np.copy(current)
    adaptation_rate = 1
    cooling_rate = 0.9

    for _ in range(budget):
        candidate = generate_candidate(current)
        clipped_candidate = np.clip(candidate, lb, ub)
        
        f_current = func(current)
        f_candidate = func(clipped_candidate)

        if f_candidate < f_current:
            current = clipped_candidate
            adaptation_rate *= cooling_rate

            if f_candidate < func(best_so_far):
                best_so_far = np.copy(clipped_candidate)
        elif rng.random() < 1 / (1 + np.exp(-adaptation_rate * (f_candidate - f_current))):
            current = clipped_candidate
        
        if _ % int(budget * 0.1) == 0:
            adaptation_rate *= cooling_rate

    return best_so_far
