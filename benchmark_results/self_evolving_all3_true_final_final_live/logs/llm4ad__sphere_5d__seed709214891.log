def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(mean, cov):
        candidate = mean + np.random.multivariate_normal(np.zeros(dim), cov)
        return clip(candidate)

    def update_covariance(cov, step_size):
        for _ in range(budget):
            mean = np.array([0.]*dim)  # initialisation
            cov = np.eye(dim) * 10  # initialisation

            for _ in range(5):  # 5 iterations of CMA-ES
                candidate = generate_candidate(mean, cov)
                y = func(candidate) - func(mean)
                cov += step_size * (candidate - mean).reshape(-1, 1) @ (candidate - mean).reshape(1, -1) + np.eye(dim)
                mean += step_size * (y / np.linalg.norm(y))[:dim]
            return mean

    best_candidate = np.array([5.0]*dim)
    best_func_value = func(best_candidate)

    for _ in range(budget):
        mean = update_covariance(np.zeros((1, dim)), 0.1)
        candidate = generate_candidate(mean, np.eye(dim))
        func_value = func(candidate)

        if func_value < best_func_value:
            best_candidate = candidate
            best_func_value = func_value

    return best_candidate
