def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    for _ in range(budget):
        x_current = x_best + rng.normal(size=dim) / 10
        x_current = np.clip(x_current, lb, ub)
        f_current = func(x_current)
        if f_current < x_best[-1]:
            x_best = x_current
    return x_best
