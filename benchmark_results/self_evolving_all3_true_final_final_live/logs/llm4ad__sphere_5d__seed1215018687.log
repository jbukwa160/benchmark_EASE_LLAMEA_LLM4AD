def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_y = float('inf')
    
    x = lb + (ub - lb) * rng.rand(dim)
    r = 1
    
    for _ in range(budget):
        y = func(x)
        
        if y < best_y:
            best_x = x
            best_y = y
        
        if best_y == 0 or best_y <= 1e-6:  # convergence criterion
            break
        
        r *= (ub - lb) ** (1 / dim)
        
        for _ in range(10):  # number of sampling iterations
            s = lb + (ub - lb) * rng.rand(dim)
            
            if np.linalg.norm(s - x) < r:
                y_s = func(s)
                
                if y_s < best_y:
                    x = s
                    best_x = s
                    best_y = y_s
                    
        x = best_x  # greedy update
        
    return best_x
