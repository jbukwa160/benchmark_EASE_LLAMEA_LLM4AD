def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=dim)
    sigma = 1.0

    for _ in range(budget):
        x_new = x_best + rng.normal(size=dim) * sigma
        x_new = np.clip(x_new, lb, ub)

        f_x_new = func(x_new)
        f_x_best = func(x_best)

        if f_x_new < f_x_best:
            x_best = x_new

    return x_best
