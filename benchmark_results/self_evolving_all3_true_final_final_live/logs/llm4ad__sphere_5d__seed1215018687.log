def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        s = 0.1 * (ub - lb)
        while s <= 0:
            s *= 2

        delta = np.array([np.random.uniform(-s, s) for _ in range(dim)])
        x_new = x + delta
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new

        # reduce step size for next iteration
        s *= 0.9

        # perturb the current solution with some probability
        if rng.rand() < 0.1:
            x += np.array([np.random.uniform(-s, s) for _ in range(dim)])
            x = np.clip(x, lb, ub)

    return best_x
