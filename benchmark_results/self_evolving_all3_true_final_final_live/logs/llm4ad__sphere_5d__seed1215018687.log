def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, (1, dim))
    pop_size = 10
    while pop_size <= budget:
        next_pop = []
        for _ in range(pop_size):
            new_x = x + rng.normal(0, 0.5, (1, dim))
            new_x = clip(new_x)
            next_pop.append(new_x)
        x = np.array(next_pop)
        next_pop.sort(key=func, reverse=True)
        x = next_pop[:budget//pop_size]
        pop_size *= 2

    x = clip(x)
    return np.min(x, axis=0)
