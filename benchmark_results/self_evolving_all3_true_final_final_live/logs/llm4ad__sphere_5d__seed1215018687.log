def algorithm(func, dim, lb, ub, budget, rng):
    def grad(x):
        return 2 * x
    
    def clip(x):
        return np.clip(x, lb, ub)
    
    x = np.zeros(dim)
    best_x = np.copy(x)
    best_f = func(clip(best_x))
    
    for _ in range(budget):
        g = grad(clip(x))
        step_size = 1e-3
        x += -step_size * g
        
        f = func(clip(x))
        
        if f < best_f:
            best_f = f
            best_x = np.copy(x)
    
    return best_x
