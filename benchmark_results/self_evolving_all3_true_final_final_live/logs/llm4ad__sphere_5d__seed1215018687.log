def algorithm(func, dim, lb, ub, budget, rng):
    def clipped_candidate(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    initial_solution = np.random.uniform(lb, ub, size=(dim,))
    current_solution = initial_solution.copy()
    best_solution = current_solution
    temperature = 1.0

    for _ in range(budget):
        new_solution = clipped_candidate(current_solution + rng.normal(size=current_solution.shape))
        delta = func(new_solution) - func(current_solution)

        if delta < 0:
            current_solution = new_solution
            best_solution = np.where(np.abs(best_solution) > np.abs(new_solution), new_solution, best_solution)
        else:
            prob_acceptance = np.exp(-delta / temperature)
            if rng.random() < prob_acceptance:
                current_solution = new_solution

        temperature *= 0.9999  # cooling schedule: exponential decrease

    return best_solution
