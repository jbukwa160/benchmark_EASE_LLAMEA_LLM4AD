def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    def generate_init_population(num_populations, dim, rng):
        return rng.uniform(lb, ub, (num_populations, dim))

    def evaluate(candidate, func):
        return func(candidate)

    def crossover(u, v, F, rng):
        idx = rng.choice(dim)
        return u.copy()
        for i in range(dim):
            if i != idx:
                u[i] = v[i]

    def mutation(u, v, w, CR, F, rng):
        for i in range(dim):
            if rng.uniform(0, 1) < CR or i == 0:
                u[i] = clip(v[i] + F * (w[i] - v[i]))

    num_populations = 10
    population_size = 50
    init_population = generate_init_population(num_populations, dim, rng)
    best_solution = np.zeros(dim)
    for _ in range(budget):
        for i in range(population_size):
            u = crossover(init_population[(i-1)%num_populations], init_population[i%num_populations], 0.5, rng)
            v = crossover(init_population[(i+1)%num_populations], init_population[i%num_populations], 0.5, rng)
            w = crossover(u, v, 0.5, rng)
            mutation(u, v, w, 0.9, 0.2, rng)
            if evaluate(clip(u), func) < evaluate(clip(best_solution), func):
                best_solution = u.copy()
        init_population = np.roll(init_population, -1, axis=0)

    return clip(best_solution)
