def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = 50
    step_size = (ub - lb) / 10.0
    mean = rng.uniform(lb, ub, size=dim)
    sigma = 1.0

    best_x = None
    best_y = float('inf')

    for _ in range(budget):
        x = np.clip(mean + rng.normal(0, sigma, size=dim), lb, ub)

        y = func(x)
        if y < best_y:
            best_y = y
            best_x = x

        if rng.random() < 1 / (budget ** 2):
            mean += rng.normal(0, step_size, size=dim)

        for _ in range(pop_size - 1):
            x = np.clip(mean + rng.normal(0, sigma, size=dim), lb, ub)
            y = func(x)

            if y < best_y:
                best_y = y
                best_x = x

            mean += (x - mean) / pop_size

        sigma *= 1.01 ** (rng.random() * 2 - 1)

    return clip(best_x)
