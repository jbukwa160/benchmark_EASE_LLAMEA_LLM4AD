def algorithm(func, dim, lb, ub, budget, rng):
    x_init = lb + (ub - lb) * rng.rand(dim)
    X = [x_init]
    Y = [func(x_init)]

    for i in range(1, budget):
        gp = GaussianProcess(X, Y)
        mu, sigma = gp.predict(np.array([[0.5*(lb+ub)]*dim]))
        
        def acquisition_function(x):
            return func(x) - (mu + np.sqrt(sigma))
        
        x_next = optimize_acquisition(acquisition_function, dim, lb, ub)
        X.append(x_next)
        Y.append(func(x_next))

    best_x = min(X, key=lambda x: Y[X.index(x)])
    return best_x
