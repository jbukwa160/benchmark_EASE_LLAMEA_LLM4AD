def algorithm(func, dim, lb, ub, budget, rng):
    def rand_var(lb, ub):
        return rng.uniform(lb, ub)

    x = np.array([ub + rng.gauss(0, 1) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(budget):
        if i % 100 == 0:
            # global exploration
            n = rng.normal(size=dim)
            step_size = 5. / np.sqrt(i + 1)  # adaptive step size
            x += step_size * n
            x = np.clip(x, lb, ub)
            f = func(x)
            if f < best_f:
                best_x = x.copy()
                best_f = f
        
        # local exploration
        for j in range(dim):
            x_j = rand_var(lb, ub)
            x_other = x.copy()
            x_other[j] = x_j
            x_other = np.clip(x_other, lb, ub)
            f_other = func(x_other)
            if f_other < best_f:
                best_x = x_other.copy()
                best_f = f_other
        
        # gradient-based update (approximated using finite differences)
        grad = np.zeros(dim)
        eps = 1e-4
        for j in range(dim):
            x_j_plus_eps = x.copy()
            x_j_minus_eps = x.copy()
            x_j_plus_eps[j] += eps
            x_j_minus_eps[j] -= eps
            f_plus_eps = func(x_j_plus_eps)
            f_minus_eps = func(x_j_minus_eps)
            grad[j] = (f_plus_eps - f_minus_eps) / (2 * eps)
        x -= 0.1 * grad  # learning rate of 0.1
        
        x = np.clip(x, lb, ub)
    
    return best_x
