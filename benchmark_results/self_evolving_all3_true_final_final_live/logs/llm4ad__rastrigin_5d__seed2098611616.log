def algorithm(func, dim, lb, ub, budget, rng):
    n = len(rng)
    sigma = 1.0
    lambda_ = int(budget / (n * 2))
    mu = lambda_ // 2
    weights = np.log(np.arange(1, mu+1)) + 0.5
    weights /= np.sum(weights)
    mean = np.zeros(dim)
    cov = np.eye(dim) * sigma ** 2

    for _ in range(budget):
        offspring = np.random.multivariate_normal(mean, cov, lambda_)
        clipped_offspring = np.clip(offspring, lb, ub)
        fitness = func(clipped_offspring)
        best_idx = np.argmin(fitness)
        new_mean = mean + (clipped_offspring[best_idx] - mean) / mu
        cov_new = 0.5 * (cov + np.outer(new_mean - mean, new_mean - mean)) + 1e-8 * np.eye(dim)

        weights *= 0.9
        for _ in range(lambda_ - 1):
            idx = np.random.choice(n, p=weights)
            offspring = np.random.multivariate_normal(mean, cov_new, lambda_)
            clipped_offspring = np.clip(offspring, lb, ub)
            fitness = func(clipped_offspring)
            best_idx = np.argmin(fitness)
            weights[idx] *= 1.1 ** (fitness[best_idx] - fitness[new_best_idx])
            new_mean += (clipped_offspring[best_idx] - mean) / mu
            cov_new = 0.5 * (cov + np.outer(new_mean - mean, new_mean - mean)) + 1e-8 * np.eye(dim)

        mean, cov, new_best_idx = new_mean, cov_new, best_idx

    return clipped_offspring[new_best_idx]
