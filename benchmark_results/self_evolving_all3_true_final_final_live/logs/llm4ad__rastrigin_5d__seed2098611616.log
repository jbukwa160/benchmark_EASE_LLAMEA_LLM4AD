def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(dim, lb, ub, rng):
        return np.clip(rng.uniform(lb, ub, size=(dim, 10)), a_min=lb, a_max=ub)

    population = generate_initial_population(dim, lb, ub, rng)
    best = func(population[0])

    for _ in range(budget - 1):
        mutant = population + rng.normal(size=(dim, 10)) * 0.5
        mutant = np.clip(mutant, a_min=lb, a_max=ub)

        crossover = (mutant + population) / 2

        candidate = func(np.array(crossover))
        if candidate < best:
            best = candidate
            population[0] = crossover

    return population[0]
