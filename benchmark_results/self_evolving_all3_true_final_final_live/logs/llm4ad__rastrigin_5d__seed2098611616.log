def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    n = 50
    D = np.zeros((n, dim))
    V = np.random.uniform(lb, ub, (n, dim))

    for i in range(dim):
        D[:, i] += i

    pbest = np.inf * np.ones(n)
    gbest = np.inf

    for _ in range(budget):
        for i in range(n):
            x = clip(D[i] + V[i])
            f_x = func(x)
            if f_x < pbest[i]:
                pbest[i] = f_x
                D[i] = x

            if f_x < gbest:
                gbest = f_x
                best_i = i

        for i in range(n):
            if rng.random() > 0.5:
                u, v, w = np.random.choice(range(n), size=3, replace=False)
                a, b, c = D[u] + V[u], D[v] + V[v], D[w] + V[w]
                a, b, c = clip(a), clip(b), clip(c)

                f_a, f_b, f_c = func(a), func(b), func(c)
                if rng.random() < 0.5:
                    x = a + 0.5 * (b - c) + np.random.uniform(-1, 1, dim)
                else:
                    x = b + 0.5 * (a - c) + np.random.uniform(-1, 1, dim)

                f_x = func(clip(x))
                if f_x < pbest[i]:
                    pbest[i] = f_x
                    D[i] = x

    return D[best_i]
