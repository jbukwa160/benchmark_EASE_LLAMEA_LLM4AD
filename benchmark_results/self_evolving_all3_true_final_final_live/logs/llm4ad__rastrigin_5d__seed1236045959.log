def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = dim
    N = 25
    pa = 0.25
    pc = 0.25
    alpha = 1.0
    x_best = np.zeros(D)
    f_best = float('inf')

    for i in range(budget):
        A = rng.uniform(lb, ub, (N, D))
        A = clip(A)

        f_list = [func(x) for x in A]
        idx = np.argsort(f_list)[:5]

        x_t = A[idx[0]]
        x_best_t = x_best.copy()
        f_best_t = f_best

        if rng.rand() < pa:
            for j in range(D):
                alpha_j = rng.uniform(1, 10)
                x_t[j] += alpha_j * (x_best_t[j] - x_t[j]) + rng.uniform(-5.0, 5.0)

        if rng.rand() < pc:
            for _ in range(D):
                i_, j_ = rng.choice(range(D), 2, replace=False)
                x_t[i_] = 0.5 * (x_best_t[i_] + x_t[j_])

        f_t = func(x_t)
        if f_t < f_best:
            x_best = x_t
            f_best = f_t

    return clip(x_best)
