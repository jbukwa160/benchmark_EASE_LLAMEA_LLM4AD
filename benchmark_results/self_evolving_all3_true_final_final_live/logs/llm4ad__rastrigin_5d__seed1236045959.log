def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_sampler(dim, mean, std_dev, lower_bound, upper_bound):
        return lower_bound + (upper_bound - lower_bound) * np.random.normal(mean, std_dev)

    current_best = np.zeros(dim)
    current_best_fitness = float('inf')

    current_std_dev = 0.1
    num_generations = 0

    while True:
        if budget <= 0:
            break

        candidate_solution = gaussian_sampler(dim, 0, current_std_dev, lb, ub)

        candidate_solution = np.clip(candidate_solution, a_min=lb, a_max=ub)
        candidate_fitness = func(candidate_solution)

        if candidate_fitness < current_best_fitness:
            current_best = candidate_solution
            current_best_fitness = candidate_fitness

        num_generations += 1
        budget -= 1

        # Adapt standard deviation based on the history of solutions and their function values
        if num_generations % 10 == 0:
            if current_best_fitness < func(current_best - current_std_dev * rng.randn(dim)):
                current_std_dev *= 1.1
            elif current_best_fitness < func(current_best + current_std_dev * rng.randn(dim)):
                current_std_dev /= 1.1

        # Limit the standard deviation to avoid divergence
        if current_std_dev > 5 or current_std_dev < 0.01:
            current_std_dev = np.clip(current_std_dev, a_min=0.01, a_max=5)

    return current_best
