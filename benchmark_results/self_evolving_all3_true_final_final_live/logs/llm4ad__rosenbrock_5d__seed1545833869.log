def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = 50
    x0 = np.random.uniform(lb, ub, (pop_size, dim))
    best_x = x0.copy()
    best_f = np.inf

    for _ in range(budget):
        F = 0.5
        CR = 0.9
        offspring = np.zeros((pop_size, dim))

        for i in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size, 3)
            while r1 == i or r2 == i or r3 == i:
                r1, r2, r3 = rng.randint(0, pop_size, 3)

            v = clip(x0[i] + F * (x0[r1] - x0[r2]) + CR * np.random.uniform(-1, 1))
            offspring[i] = v

        x0 = clip((offspring + best_x) / 2)
        f = func(x0)

        if f < best_f:
            best_f = f
            best_x = x0.copy()

    return best_x
