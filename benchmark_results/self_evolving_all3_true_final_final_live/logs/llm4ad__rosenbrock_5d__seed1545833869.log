    sigma_init = (ub - lb) / 3.0

    best_params = rng.uniform(lb, ub, size=(1, dim))
    best_obj = objective(best_params)

    cma_es = CMAES(dim, bounds, pop_size, num_elites, sigma_init, budget)
    cma_es.optimize(objective)

    return cma_es.best_params
