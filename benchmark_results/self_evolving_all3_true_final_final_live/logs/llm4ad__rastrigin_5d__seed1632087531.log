def algorithm(func, dim, lb, ub, budget, rng):
    X_best = np.zeros(dim)
    f_best = float('inf')
    
    for _ in range(budget):
        X_rand = lb + (ub - lb) * rng.rand(dim)
        
        f_rand = func(X_rand)
        
        if f_rand < f_best:
            f_best = f_rand
            X_best = X_rand
            
        # Perturbation mechanism
        perturb = 0.1 * (ub - lb) * rng.randn(dim)
        for i in range(dim):
            if np.random.rand() < 0.5:
                perturb[i] *= -1
        
        X_perturb = X_best + perturb
        f_perturb = func(X_perturb)
        
        if f_perturb < f_best:
            f_best = f_perturb
            X_best = X_perturb
            
    return np.clip(X_best, lb, ub)
