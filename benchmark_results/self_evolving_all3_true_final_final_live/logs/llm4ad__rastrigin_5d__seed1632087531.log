def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def polynomial_mutation(individual, sigma):
        indpb = 0.1
        for i in range(dim):
            if rng.uniform(0, 1) < indpb:
                individual[i] += rng.normal(0, sigma)
                individual[i] = clip(individual[i], lb, ub)
        return individual

    def fitness(individual):
        return func(individual)

    population_size = 100
    sigma_max = 5.0
    sigma_min = 0.1
    step_size = rng.uniform(sigma_min, sigma_max)
    population = [rng.uniform(lb, ub) for _ in range(population_size)]

    for i in range(budget):
        fitness_values = [fitness(individual) for individual in population]
        best_individual = population[np.argmin(fitness_values)]
        step_size *= 0.9
        sigma_max *= 0.9

        if rng.uniform(0, 1) < 0.01:
            step_size = rng.uniform(sigma_min, sigma_max)

        individuals_to_mutate = []
        for j in range(population_size):
            individual = population[j]
            if rng.uniform(0, 1) < 0.2:
                mutated_individual = polynomial_mutation(individual, step_size)
                individuals_to_mutate.append(mutated_individual)
            else:
                individuals_to_mutate.append(individual)

        new_population = []
        for j in range(population_size):
            if rng.uniform(0, 1) < 0.5:
                index = np.random.randint(population_size)
                while index == j:
                    index = np.random.randint(population_size)
                new_individual = individuals_to_mutate[j] + rng.uniform(-1, 1) * (individuals_to_mutate[index] - population[j])
            else:
                index = np.random.randint(population_size)
                while index == j or index in [i for i in range(len(individuals_to_mutate)) if individuals_to_mutate[i] is None]:
                    index = np.random.randint(population_size)
                new_individual = individuals_to_mutate[j]
            new_population.append(clip(new_individual, lb, ub))

        population = new_population

    return best_individual
