def algorithm(func, dim, lb, ub, budget, rng):
    def bounds(x):
        return np.clip(x, lb, ub)

    x = bounds(rng.uniform(lb, ub, (1, dim)))
    y = func(x)
    best_x = x.copy()
    best_y = y

    for _ in range(budget - 1):
        v = rng.normal(size=(1, dim))
        u = rng.uniform(0, 1)

        if u < 0.5:
            a = np.zeros((1, dim))
            for i in range(dim):
                if rng.random() < 0.1:
                    a[i] = x[i] + v[0, i]
                else:
                    a[i] = x[i]
        elif u < 0.7:
            a = bounds(x + v)
        else:
            a = np.zeros((1, dim))
            for i in range(dim):
                a[i] = best_x[i] + rng.uniform(-1, 1) * (ub - lb)

        y_a = func(bounds(a))

        if y_a < y:
            x = a.copy()
            y = y_a
        elif np.random.rand() < 0.01 and y > 0:
            x[i] += rng.normal(0, 1e-3)
            y = func(bounds(x))

        if y < best_y:
            best_x = x.copy()
            best_y = y

    return best_x
