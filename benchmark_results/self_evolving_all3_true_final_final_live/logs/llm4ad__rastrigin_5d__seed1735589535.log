def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_population(size, dim):
        return rng.uniform(-5, 5, (size, dim))

    def fitness(candidates, func):
        return func(candidates)

    def crossover(parent1, parent2):
        child = parent1.copy()
        for i in range(dim):
            if rng.random() < 0.5:
                child[i] += (parent2[i] - parent1[i]) * rng.uniform(-1, 1)
        return clip(child)

    def mutation(candidate):
        mutated_candidate = candidate + rng.normal(0, 1, dim) * 0.01
        return clip(mutated_candidate)

    population_size = 100
    candidates = generate_population(population_size, dim)
    population_fitness = fitness(candidates, func)

    simplex_size = 10
    simplex = generate_population(simplex_size, dim)
    simplex_fitness = fitness(simplex, func)

    best_candidate = np.argmin(simplex_fitness)
    best_fitness = np.min(simplex_fitness)

    for _ in range(budget):
        for i in range(population_size):
            parent1_idx = rng.choice(population_size, p=np.exp(-population_fitness))
            parent2_idx = rng.choice(population_size, p=np.exp(-population_fitness))
            child = crossover(candidates[parent1_idx], candidates[parent2_idx])
            mutated_child = mutation(child)
            candidates[i] = mutated_child
            population_fitness[i] = func(mutated_child)

        population_idx = np.argmin(population_fitness)
        if population_fitness[population_idx] < best_fitness:
            simplex = candidates[population_idx:population_idx+simplex_size]
            simplex_fitness = population_fitness[population_idx:population_idx+simplex_size]

        centroid = np.mean(simplex, axis=0)

        for i in range(simplex_size):
            if rng.random() < 0.5:
                simplex[i] += (centroid - simplex[i]) * rng.uniform(-1, 1)
                simplex_fitness[i] = func(simplex[i])

        best_candidate_idx = np.argmin(simplex_fitness)
        best_candidate = simplex[best_candidate_idx]
        best_fitness = simplex_fitness[best_candidate_idx]

    return best_candidate
