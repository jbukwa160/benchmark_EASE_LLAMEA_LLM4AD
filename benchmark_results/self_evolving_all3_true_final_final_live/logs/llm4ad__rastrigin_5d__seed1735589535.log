def algorithm(func, dim, lb, ub, budget, rng):
    def generate_init_pop(dim, lb, ub, rng):
        return (ub - lb) * rng.rand(dim) + lb

    def calculate_fitness(x):
        return func(x)

    def clip_to_bounds(x, lb, ub):
        return np.clip(x, lb, ub)

    pop_size = 100
    init_pop = generate_init_pop(dim, lb, ub, rng)
    temp = 10.0
    best_fitness = float('inf')
    best_solution = None

    for _ in range(budget):
        new_pop = init_pop.copy()
        for i in range(pop_size):
            r1, r2, r3 = np.random.choice(range(pop_size), size=3, replace=False)
            v = 0.5 * (init_pop[r1] + init_pop[r2]) + 0.5 * rng.randn(dim)
            x_mutated = clip_to_bounds(init_pop[i] + 0.01 * rng.randn(dim), lb, ub)
            new_pop[i] = np.where(rng.rand(dim) < 0.5, v, x_mutated)

        for i in range(pop_size):
            fitness_new = calculate_fitness(new_pop[i])
            if fitness_new < best_fitness:
                best_fitness = fitness_new
                best_solution = new_pop[i]
            temp *= 0.99
            alpha = np.exp(-temp * (fitness_new - best_fitness))
            if rng.rand() < alpha:
                init_pop[i] = new_pop[i]

    return best_solution
