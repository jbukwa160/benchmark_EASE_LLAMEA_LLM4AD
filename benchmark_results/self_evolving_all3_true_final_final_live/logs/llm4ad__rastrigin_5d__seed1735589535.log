def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    T = 1e3
    a = 0.7
    b = 2.5

    for _ in range(budget - 1):
        y = clip(x + rng.uniform(-ub, ub, size=dim))
        f_y = func(y)
        f_x = func(clip(x))

        if f_y < f_x:
            x = y
        else:
            delta = np.exp(-(f_y - f_x) / (T * b)) * np.log(rng.rand())
            x += a * (y - x)

            if rng.rand() < delta:
                x = y

            T *= 0.995

    return x
