def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def objective(params):
        return func(params)

    x = rng.uniform(low=lb, high=ub, size=(dim,))
    best_x = x.copy()
    best_obj = float('inf')

    for t in range(budget):
        v = np.random.uniform(low=-1.0, high=1.0, size=(dim,))
        u = clip(x + 0.5 * v)
        if objective(u) < objective(x):
            x = u
        elif rng.rand() < 0.1:
            alpha = rng.uniform(low=0.9, high=1.1)
            x = alpha * x + (1 - alpha) * u

        obj = objective(x)
        if obj < best_obj:
            best_x = x.copy()
            best_obj = obj

    return best_x
