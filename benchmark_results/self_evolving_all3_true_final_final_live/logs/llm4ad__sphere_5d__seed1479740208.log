def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 1000.0
    alpha = 0.99
    for i in range(budget):
        f_x = func(x)
        y = rng.normal(loc=x, scale=T*rng.uniform(0, 1, size=dim))
        y = np.clip(y, lb, ub)  # Clip to bounds
        f_y = func(y)
        if f_y < f_x:
            x = y
        else:
            p = np.exp(-(f_y - f_x)/T)
            if rng.uniform(0, 1) > p:
                x = y
        T *= alpha
    return x
