def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = np.random.uniform(lb, ub, size=dim)
    best_obj = func(best_sol)

    for i in range(budget):
        new_sol = np.clip(np.random.normal(loc=best_sol, scale=rng), a_min=lb, a_max=ub)
        
        if rng > 0:
            prob = np.exp(-((new_sol - best_sol) ** 2).sum() / (2 * rng ** 2))
            new_sol = np.where(rng < 1e-8, lb + rng * (np.random.rand(dim) - 0.5), new_sol)
        else:
            prob = 1
        
        if func(new_sol) < best_obj or rng > 0 and np.random.rand() < prob:
            best_sol = new_sol
            best_obj = func(best_sol)

    return best_sol
