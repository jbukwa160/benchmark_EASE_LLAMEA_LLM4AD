def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    x = rng.uniform(lb, ub, (1, dim))
    sigma = 10.0 * np.ones((1, 1)) / dim
    n_evals = 0

    while n_evals < budget:
        for _ in range(dim):
            y = x + sigma * rng.normal(0, 1, (1, dim))
            y = np.clip(y, lb, ub)
            f_y = objective(y)

            if f_y < objective(x):
                x = y
                n_evals += 1

        c = np.eye(dim) + 0.5 * rng.normal(0, 1, (dim, dim))
        sigma = sigma @ c
        sigma = 0.9 * sigma + 0.1 * np.eye(dim)

    return x
