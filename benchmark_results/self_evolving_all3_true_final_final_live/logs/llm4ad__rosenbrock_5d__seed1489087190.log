def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    for _ in range(budget):
        x_try = x_best + 0.1 * (np.random.uniform(-1, 1, size=dim) - 0.5)
        for i in range(dim):
            x_try[i] = np.clip(x_try[i], lb, ub)
        f_try = func(x_try)
        if f_try < func(x_best):
            x_best = x_try
    return x_best
