def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_candidate(parents):
        offspring = parents + 0.1 * (ub - lb) * rng.random((dim,))
        return offspring

    def simulate_annealing(params):
        current_solution = params
        temperature = 1000
        while temperature > 10:
            new_solution = current_solution + temperature * rng.normal(size=(dim,))
            new_solution = clip(new_solution)
            if func(new_solution) < func(current_solution):
                current_solution = new_solution
            else:
                probability = np.exp((func(current_solution) - func(new_solution)) / temperature)
                if rng.random() < probability:
                    current_solution = new_solution
            temperature *= 0.99
        return current_solution

    def differential_evolution(params):
        population_size = budget // 2
        population = params + (ub - lb) * rng.random((population_size, dim))
        for _ in range(population_size):
            parent1_idx = rng.choice(population_size)
            parent2_idx = rng.choice(population_size)
            if parent1_idx != parent2_idx:
                offspring = generate_candidate(population[parent1_idx])
                population[parent2_idx] = clip(offspring)
        return np.min(np.array([func(clip(individual)) for individual in population]), axis=0)

    params = (ub - lb) * rng.random((dim,))
    solution = simulate_annealing(params)
    solution = differential_evolution(solution)
    for _ in range(budget // 2):
        new_solution = generate_candidate(solution)
        if func(new_solution) < func(solution):
            solution = clip(new_solution)
    return solution
