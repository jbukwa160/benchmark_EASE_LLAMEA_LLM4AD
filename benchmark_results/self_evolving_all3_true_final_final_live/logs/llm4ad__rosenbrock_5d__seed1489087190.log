def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def local_search(x0, func, dim, lb, ub, max_iter=100):
        simplex = np.ones((dim + 1, dim)) * x0
        for _ in range(max_iter):
            y = func(simplex)
            i = np.argmin(y)
            if y[i] < y[-1]:
                x = simplex[i]
                for j in range(dim):
                    s = np.zeros(dim)
                    s[j] = 1.5 * (simplex[i, j] - x0[j])
                    new_simplex = clip(x + s)
                    y_new = func(new_simplex)
                    if y_new < y[-1]:
                        simplex[i, j] = new_simplex
                simplex[:, :] = np.roll(simplex, 1, axis=0)
            else:
                break
        return simplex[-1]

    def de_sa(func, dim, lb, ub, pop_size=50, F=0.5, CR=0.9, T_max=100, alpha=0.99, beta=1e-6):
        x_best = None
        y_best = np.inf
        for t in range(T_max):
            population = rng.uniform(lb, ub, (pop_size, dim))
            for i in range(pop_size):
                x_i = local_search(population[i], func, dim, lb, ub)
                if func(x_i) < y_best:
                    y_best = func(x_i)
                    x_best = x_i
            delta = rng.uniform(-F, F, (pop_size, dim))
            new_population = population + delta
            crossover_mask = rng.rand(pop_size, dim) < CR
            for i in range(pop_size):
                if not crossover_mask[i]:
                    continue
                u = rng.choice(pop_size)
                v = rng.choice(pop_size)
                new_population[i] = np.where(crossover_mask[i], new_population[i], population[u])
                new_population[i] = np.where(np.logical_and(crossover_mask[i], ~crossover_mask[u]), new_population[i], population[v])
            population = clip(new_population)
            if func(x_best) < y_best:
                y_best = func(x_best)
        return x_best

    x0 = (np.random.uniform(lb, ub, dim) + np.array([1] * dim)) / 2
    x_best = de_sa(func, dim, lb, ub)
    return x_best
