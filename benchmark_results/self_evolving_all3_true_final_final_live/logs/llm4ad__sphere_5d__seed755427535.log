def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = np.array(x)
    best_f = func(best_x)

    for _ in range(budget):
        new_x = lb + (ub - lb) * np.random.rand(dim)
        new_f = func(new_x)
        
        if new_f < best_f:
            best_f = new_f
            best_x = new_x

    return best_x
