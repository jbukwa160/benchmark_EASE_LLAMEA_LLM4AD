def algorithm(func, dim, lb, ub, budget, rng):
    def gp_model(x):
        K = np.zeros((dim, dim))
        for i in range(dim):
            for j in range(i+1, dim):
                K[i, j] = K[j, i] = 0.5 * np.exp(-np.sum((x[i] - x[j])**2) / (2 * rng**2))
        return func(x), K

    def gp_sample(gp_mean, gp_cov, budget):
        sample = gp_mean + np.linalg.cholesky(gp_cov).dot(rng.randn(dim))
        while True:
            candidate = np.clip(sample, lb, ub)
            if func(candidate) < gp_mean:
                return candidate
            noise = rng.randn(dim)
            sample += 0.1 * noise / (np.linalg.norm(noise) + 1e-6)

    x = rng.uniform(lb, ub, size=dim)
    best_x = np.copy(x)

    for _ in range(budget):
        gp_mean, gp_cov = gp_model(x)
        sample = gp_sample(gp_mean, gp_cov, budget)
        if func(sample) < func(best_x):
            best_x = sample

    return best_x
