def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    
    for _ in range(budget):
        delta = rng.uniform(-1, 1, size=dim)
        cand = x + delta
        
        # Clip candidates to [lb, ub]
        cand = np.clip(cand, lb, ub)
        
        if func(cand) < func(x):
            x = cand
    
    return x
