def algorithm(func, dim, lb, ub, budget, rng):
    def func_wrapper(x):
        return func(np.clip(x, lb, ub))

    x0 = rng.uniform(lb, ub, size=dim)
    D = 1e-6 * len(x0) / (lb + ub)**2
    sigma = np.sqrt(ub - lb) * np.ones(dim)

    for _ in range(budget):
        y = func_wrapper(x0)
        if rng.random() < 0.5:
            x1 = x0 + D * rng.normal(size=dim)
            y1 = func_wrapper(x1)
            if y1 < y:
                x0, sigma = x1, np.sqrt(ub - lb) * (sigma + D * rng.normal(size=dim))
        else:
            s2 = np.sum(sigma**4)
            c = 2 / s2
            d = 2 * (np.sum(x0**3 * sigma**3)) / s2
            x1 = x0 + c * rng.normal(size=dim) - d * (x0**2 / sigma**2) * rng.normal(size=dim)
            y1 = func_wrapper(x1)
            if y1 < y:
                x0, sigma = x1, np.sqrt(ub - lb) * (sigma + D * rng.normal(size=dim))

    return x0
