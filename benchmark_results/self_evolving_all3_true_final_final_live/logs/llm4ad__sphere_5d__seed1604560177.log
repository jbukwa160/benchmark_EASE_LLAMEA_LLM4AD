def algorithm(func, dim, lb, ub, budget, rng):
    n = 10
    mu = np.random.uniform(lb, ub, (1, dim))
    sigma = 1 + rng.uniform(-0.5, 0.5)
    
    for i in range(budget):
        y = func(mu)
        
        if rng.rand() < 1/3:
            lambda_ = n
        elif rng.rand() < 2/3:
            lambda_ = np.random.randint(1, n+1)
        else:
            lambda_ = n
        
        d = mu + sigma * np.random.randn(dim)
        for _ in range(lambda_-1):
            d_ = mu + sigma * np.random.randn(dim)
            y_ = func(d_)
            
            if y_ < y:
                mu, y = d_, y_
        
        mu = mu.clip(lb, ub)
        sigma *= 0.5 + (y / n) ** 2
        
    return mu[0]
