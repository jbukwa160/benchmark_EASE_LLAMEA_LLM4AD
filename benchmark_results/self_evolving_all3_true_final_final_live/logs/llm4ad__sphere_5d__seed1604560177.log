def algorithm(func, dim, lb, ub, budget, rng):
    X = np.random.uniform(lb, ub, (1, dim))
    best_X = X.copy()
    best_fX = func(X)
    current_step_size = 2 * rng.rand(dim) - 1
    for _ in range(budget):
        new_X = best_X + current_step_size
        if np.any(new_X < lb) or np.any(new_X > ub):
            new_X = np.clip(new_X, lb, ub)
        new_fX = func(new_X)
        if new_fX < best_fX:
            best_fX = new_fX
            best_X = new_X.copy()
        if np.std(current_step_size) < 1e-6:
            current_step_size = 2 * rng.rand(dim) - 1
        else:
            variance = np.var(current_step_size)
            current_step_size *= np.sqrt(rng.uniform(0.5, 1))
    return best_X
