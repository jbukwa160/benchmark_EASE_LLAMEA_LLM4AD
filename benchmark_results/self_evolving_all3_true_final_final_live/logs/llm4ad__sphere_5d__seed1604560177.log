def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    x_best = x.copy()
    f_best = func(x)
    
    T = 1000
    alpha = 1 / (T * np.log(2))
    t = 0

    while t < budget:
        for i in range(dim):
            sigma = rng.uniform(size=dim) * 0.5
            x_new = clip(x + sigma)
            
            f_new = func(x_new)
            delta_f = f_new - f_best
            
            if delta_f <= 0 or np.exp(-delta_f / T) > rng.uniform():
                x_best = x_new.copy()
                f_best = min(f_best, f_new)
                
        T *= alpha
        t += 1
        
    return x_best
