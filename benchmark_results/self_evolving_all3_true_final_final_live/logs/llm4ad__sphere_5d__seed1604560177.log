def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    x = rng.uniform(lb, ub, size=(dim,))
    T = 100.0
    best_x = x.copy()
    best_f = func(x)
    for _ in range(budget):
        y = clip(x + rng.normal(size=x.shape))
        delta_f = func(y) - func(best_x)
        if delta_f < 0 or (delta_f >= 0 and np.random.rand() < np.exp(-delta_f / T)):
            x = y
            best_x = x.copy()
            best_f = func(x)
        T *= 0.99999
    return best_x
