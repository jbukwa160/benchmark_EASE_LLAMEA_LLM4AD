def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = 5 * rng.rand(dim) - 5
    for _ in range(budget):
        f_x = func(x)
        y = 5 * rng.randn(dim) - 5
        z = x + 0.1 * y
        z = clip(z)
        fz = func(z)
        if fz < f_x:
            x, f_x = z, fz

    return clip(x)
