def algorithm(func, dim, lb, ub, budget, rng):
    def wrapped_func(x):
        return func(x)

    bounds = [(lb, ub) for _ in range(dim)]
    x0 = 2 * (ub - lb) * rng.rand(dim) - (ub - lb)
    res = minimize(wrapped_func, x0, method="SLSQP", bounds=bounds, constraints=(), options={"maxiter": budget})

    return np.clip(res.x, lb, ub)
