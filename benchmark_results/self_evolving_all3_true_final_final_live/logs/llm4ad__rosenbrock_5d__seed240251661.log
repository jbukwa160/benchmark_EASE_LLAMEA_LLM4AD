def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    n = dim
    x = np.random.uniform(-5.0, 5.0, (1, n))
    lambda_ = 10
    sigma = 0.1
    best_x = clip(x)
    best_f = func(best_x)

    for _ in range(budget):
        new_x = clip(best_x + np.random.normal(0, sigma, (lambda_, n)))
        new_fx = func(new_x)

        if rng.uniform() < np.exp((new_fx - best_f) / 10):
            x = new_x
            best_x = clip(x)
            best_f = new_fx

    return best_x
