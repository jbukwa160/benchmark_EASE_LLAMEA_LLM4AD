def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    x_best = lb + (ub - lb) * rng.rand(n)
    f_best = func(x_best)
    N = 1
    C = np.eye(n) * 0.5
    D = np.eye(n) * 2
    mu = np.zeros(n)
    sigma = 0.5
    lambda_ = int(np.power(n, 2))
    while budget > 0:
        y_best = x_best
        f_y_best = f_best
        for _ in range(lambda_):
            z = rng.randn(n) + mu
            x = x_best + sigma * np.dot(D, z)
            x = lb + (ub - lb) * np.clip(x, 0, 1)
            f_x = func(x)
            if f_x < f_y_best:
                y_best = x
                f_y_best = f_x
        mu = (lambda_-1)/lambda_ * mu + 1/(lambda_*n) * np.dot(C, y_best - x_best)
        sigma *= np.exp((f_y_best-f_best)/(0.5*np.dot(z,y_best-x_best)+sigma**2))
        if budget < lambda_:
            x_best = lb + (ub - lb) * rng.rand(n)
            f_best = func(x_best)
        else:
            x_best = y_best
            f_best = f_y_best
        budget -= 1
    return x_best
