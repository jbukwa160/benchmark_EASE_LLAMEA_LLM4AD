def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    population_size = int(0.2 * budget)
    initial_population = rng.uniform(lb, ub, (population_size, dim))

    best_solution = None
    best_fitness = float('inf')

    for _ in range(budget):
        new_population = []
        for i in range(population_size):
            # DE selection
            index1 = rng.randint(0, population_size)
            index2 = rng.randint(0, population_size)
            index3 = rng.randint(0, population_size)

            while index1 == i or index2 == i or index3 == i:
                index1 = rng.randint(0, population_size)
                index2 = rng.randint(0, population_size)
                index3 = rng.randint(0, population_size)

            parent1 = clip(initial_population[index1])
            parent2 = clip(initial_population[index2])

            child = np.copy(parent1)
            for j in range(dim):
                if rng.random() < 0.5:
                    child[j] += rng.uniform(-1, 1) * (parent2[j] - parent1[j])
                else:
                    child[j] -= rng.uniform(-1, 1) * (parent2[j] - parent1[j])

            # SA mutation
            if rng.random() < 0.01:
                mutated_child = np.copy(child)
                for j in range(dim):
                    mutated_child[j] += rng.normal(0, 1)

            else:
                mutated_child = child

            new_population.append(mutated_child)

        new_population = clip(new_population)
        initial_population = new_population

        # Selection
        new_initial_population = []
        for i in range(population_size):
            individual_fitness = func(new_population[i])
            initial_individual_fitness = func(initial_population[i])

            if individual_fitness < initial_individual_fitness:
                new_initial_population.append(new_population[i])
            else:
                new_initial_population.append(initial_population[i])

        initial_population = new_initial_population

        # Update best solution
        for i in range(population_size):
            candidate_fitness = func(initial_population[i])
            if candidate_fitness < best_fitness:
                best_solution = clip(initial_population[i])
                best_fitness = candidate_fitness

    return best_solution
