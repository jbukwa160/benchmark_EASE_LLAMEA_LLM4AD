def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 10
    sigma = 0.1
    lambda_ = int(np.sqrt(budget))
    sigma_best = 0.1
    p_best = x.copy()
    f_best = func(x)

    for i in range(1, budget):
        c = rng.normal(size=dim)
        x_new = x + sigma * np.exp(-i/T) * (c + 0.5*np.dot(c,c))

        # Clip to search space bounds
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        
        if f_new < f_best:
            p_best = x_new.copy()
            f_best = f_new

        sigma = max(0.1, min(sigma + 0.01 * (f_new - f_best), 5))
        lambda_ = int(np.sqrt(budget - i))

    return p_best
