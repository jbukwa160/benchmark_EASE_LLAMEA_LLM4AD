def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        alpha = 1.0 / (1 + _ / budget)
        new_x = x + alpha * (ub - lb) * rng.normal(size=dim)
        
        # Clip candidates to [lb, ub]
        new_x = np.clip(new_x, lb, ub)

        f_new = func(new_x)

        if f_new < best_f:
            best_f = f_new
            best_x = new_x

        sigma = (ub - lb) / np.sqrt(2 * _)
        x += rng.normal(size=dim, loc=0, scale=sigma)

        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)

    return best_x
