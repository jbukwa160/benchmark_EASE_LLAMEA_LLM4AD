def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def eval(x):
        return func(x)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = eval(x_best)

    for _ in range(budget):
        mutation_step_size = 0.5 * (ub - lb) / rng.rand()
        for _ in range(dim):
            i = rng.choice(dim, replace=False)
            x_mutated = clip(x_best + mutation_step_size * np.sign(rng.randn() - 0.5))
            f_mutated = eval(x_mutated)

            if f_mutated < f_best:
                x_best = x_mutated
                f_best = f_mutated

    return x_best
