def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        return func(x)

    D = 5 # dimensionality of the problem
    N = int(10 * (D + 1)) # initial population size
    t_max = budget // N # maximum number of iterations

    swarm_size = N // 2 # particle swarm size
    learning_rate_pso = 0.7298
    learning_rate_de = 0.5
    crossover_probability = 0.5

    # initialization
    swarm = np.random.uniform(lb, ub, (swarm_size, D))
    population = np.random.uniform(lb, ub, (N - swarm_size, D))

    t = 0
    best_solution_pso = np.inf
    best_solution_de = np.inf
    while t < t_max:
        # particle swarm optimization
        for i in range(swarm_size):
            r1, r2 = rng.uniform(0, 1), rng.uniform(0, 1)
            x_best = swarm[i]
            x_rbest = np.copy(x_best)
            for j in range(D):
                if r1 < learning_rate_pso:
                    x_rbest[j] += (r2 - 0.5) * (x_best[j] - lb) + (1 - r2) * (ub - x_best[j])
                if rng.uniform(0, 1) < crossover_probability:
                    x_best[j] = swarm[i, j]
            swarm[i] = x_best
            fitness_pso = evaluate(x_best)
            if fitness_pso < best_solution_pso:
                best_solution_pso = fitness_pso

        # differential evolution
        for i in range(N - swarm_size):
            x_best = population[i]
            r1, r2, r3, r4, r5 = rng.uniform(0, 1), rng.uniform(0, 1), rng.uniform(0, 1), rng.uniform(0, 1), rng.uniform(0, 1)
            for j in range(D):
                if (rng.randint(1, 6) == 1 or j == D - 1):
                    x_best[j] = clip(population[i, j] + r1 * (population[r4, j] - population[r3, j]) +
                                    r2 * (population[r5, j] - population[r4, j]))
                elif rng.uniform(0, 1) < crossover_probability:
                    x_best[j] = swarm[r5, j]
            fitness_de = evaluate(x_best)
            if fitness_de < best_solution_de:
                best_solution_de = fitness_de

        # update population and swarm
        if np.random.randint(0, 2):
            for i in range(N - swarm_size):
                if rng.uniform(0, 1) < 0.5:
                    population[i] = swarm[rng.randint(0, swarm_size - 1)]
        else:
            for i in range(swarm_size):
                if rng.uniform(0, 1) < 0.5:
                    swarm[i] = population[rng.randint(N - swarm_size, N - 1)]

        t += 1

    best_solution = np.argmin([evaluate(x) for x in (swarm + population)])
    return clip(population[best_solution])
