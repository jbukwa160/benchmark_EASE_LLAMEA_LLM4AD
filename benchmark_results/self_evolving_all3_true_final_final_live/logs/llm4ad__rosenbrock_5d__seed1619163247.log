def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    t = 1.0
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        gradient = np.zeros(dim)
        for i in range(1, dim):
            gradient[i] += 400 * (x[i-1]**2 - x[i]) * (x[i-1]**2 - x[i])
            gradient[i-1] -= 2 * 200 * (x[i-1]**2 - x[i])

        step = rng.uniform(-t, t)
        new_x = x + step

        for i in range(dim):
            if new_x[i] < lb:
                new_x[i] = lb
            elif new_x[i] > ub:
                new_x[i] = ub

        new_f = func(new_x)

        if new_f < best_f or rng.uniform(0, 1) < np.exp((best_f - new_f) / t):
            x = new_x.copy()
            best_x = x.copy()
            best_f = new_f
            t *= 0.99

    return best_x
