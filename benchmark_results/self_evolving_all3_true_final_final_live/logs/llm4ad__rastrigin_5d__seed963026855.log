def algorithm(func, dim, lb, ub, budget, rng):
    def init():
        return np.zeros(dim), np.eye(dim)

    def evaluate(x):
        return func(x), 0  # dummy fitness value, not used in this example

    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    def select_best(population):
        return population[np.argmin([x[1] for x in population])][0]

    def mutate(parents, sigma):
        offsprings = [parent + rng.normal(size=(dim,)) * sigma for parent in parents]
        offsprings = clip(np.array(offsprings))
        return offsprings

    def step(population, sigma):
        selected_parents = select_best(population)
        offsprings = mutate([selected_parents], sigma)[0]
        new_population = population + [offsprings] * (budget - len(population))
        return new_population

    def cma_es_step(population, sigma, budget):
        for _ in range(budget):
            new_population = step(population, sigma)
            best_x = select_best(new_population)[0]
            if func(best_x) < 1e6:  # early stopping
                return best_x
            population = new_population

    def polynomial_mutation(x, lb, ub, budget):
        for i in range(dim):
            x_i = rng.uniform(lb[i], ub[i])
            if rng.random() < 0.01:
                x_i += rng.normal(0, abs(x[i] - x_i))
            x[i] = x_i
        return clip(x)

    def step_polynomial_mutation(population, sigma):
        for _ in range(budget):
            selected_parents = select_best(population)
            offsprings = polynomial_mutation(selected_parents, lb, ub, budget)[0]
            new_population = population + [offsprings] * (budget - len(population))
            best_x = select_best(new_population)[0]
            if func(best_x) < 1e6:  # early stopping
                return best_x
            population = new_population

    sigma_init, cov_matrix = init()
    population = [[np.random.uniform(lb[i], ub[i]) for i in range(dim)] for _ in range(10)]
    cma_es_sigma = np.sqrt(dim)

    while True:
        if rng.random() < 0.5:  # switch between CMA-ES and polynomial mutation
            best_x = step_polynomial_mutation(population, sigma_init)
        else:
            best_x = select_best(population)[0]
        yield best_x
