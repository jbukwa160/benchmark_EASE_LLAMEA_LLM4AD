def algorithm(func, dim, lb, ub, budget, rng):
    gp_params = {'kernel': 'matern32', 'noise': 1e-8}
    
    # Initialise the acquisition function and the GP model
    acq_func = 'ei'
    gp_model = {'x_train': np.zeros((0, dim)), 'y_train': np.zeros(0), 'X_mean': None, 'X_var': None}
    
    # Generate an initial random sample of points
    x_init = rng.uniform(lb, ub, (10, dim))
    y_init = func(x_init)
    
    # Update the GP model with the initial data
    gp_model['x_train'] = np.vstack((gp_model['x_train'], x_init))
    gp_model['y_train'] = np.concatenate((gp_model['y_train'], y_init))
    
    for i in range(budget):
        # Sample a new point using the acquisition function
        if acq_func == 'ei':
            mu, sigma = gp_model['X_mean'], gp_model['X_var']
            x_next = rng.uniform(lb, ub, (1, dim)) + np.random.randn(1, dim) * 0.01
        
        # Evaluate the objective function at the new point
        y_new = func(x_next)
        
        # Update the GP model with the new data
        gp_model['x_train'] = np.vstack((gp_model['x_train'], x_next))
        gp_model['y_train'] = np.concatenate((gp_model['y_train'], y_new))
    
    # Return the best point found
    return gp_model['x_train'][np.argmin(gp_model['y_train'])]
