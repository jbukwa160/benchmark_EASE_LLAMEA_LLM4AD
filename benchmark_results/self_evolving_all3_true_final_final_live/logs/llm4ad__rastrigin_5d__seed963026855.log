def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    def evaluate(x):
        x = clip(x)
        return func(x), 0, {}

    pop_size = int(budget ** (1 / 2))
    init_radius = (ub - lb) * rng.uniform(0.1, 0.9)
    population = np.random.uniform(lb, ub, size=(pop_size, dim))

    for _ in range(int(budget)):
        fitnesses = [evaluate(x)[0] for x in population]
        min_fitness = min(fitnesses)

        if rng.uniform(0, 1) < 0.5:
            # Differential Evolution
            offspring = np.array([population[np.random.choice(pop_size, size=3)] for _ in range(pop_size)])
            for i in range(pop_size):
                x_i = clip(offspring[i] + init_radius * (np.random.rand(dim) - 0.5))
                population[i] = x_i
        else:
            # Simulated Annealing
            temperature = max(budget / (_ + 1), 10)
            for i in range(pop_size):
                if rng.uniform(0, 1) < np.exp(-temperature * (evaluate(population[i])[0] - min_fitness)):
                    population[i] = clip(population[i] + init_radius * (np.random.rand(dim) - 0.5))

    return population[np.argmin([evaluate(x)[0] for x in population])][0]
