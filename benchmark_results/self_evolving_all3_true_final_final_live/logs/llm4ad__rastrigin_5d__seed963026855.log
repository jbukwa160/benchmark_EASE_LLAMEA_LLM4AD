def algorithm(func, dim, lb, ub, budget, rng):
    def get_initial_population(dim, lb, ub, rng):
        return rng.uniform(lb, ub, size=(dim, 100))

    def clip_population(population, lb, ub):
        return np.clip(population, a_min=lb, a_max=ub)

    def calculate_fitness(population, func):
        return np.array([func(ind) for ind in population])

    def adapt_crossover_and_mutation_probabilities(fitnesses, rng):
        std_devs = np.std(fitnesses, axis=0)
        means = np.mean(fitnesses, axis=0)
        crossover_probabilities = 1 / (1 + np.exp(-10 * (means - std_devs)))
        mutation_probabilities = 1 / (1 + np.exp(-10 * (means - std_devs) ** 2))
        return crossover_probabilities, mutation_probabilities

    def differential_evolution(population, fitnesses, lb, ub, rng):
        indices = np.random.choice(100, size=(dim,), replace=False)
        trial_population = population[:, indices]
        trial_fitnesses = fitnesses[indices]

        crossover_probabilities, mutation_probabilities = adapt_crossover_and_mutation_probabilities(trial_fitnesses, rng)

        for i in range(dim):
            if np.random.rand() < crossover_probabilities[i]:
                parent_indices = np.random.choice(100, size=2, replace=False)
                trial_population[i] = (population[i, parent_indices[0]] + population[i, parent_indices[1]]) / 2
                trial_fitnesses[i] = func(trial_population[i])
            if np.random.rand() < mutation_probabilities[i]:
                trial_population[i] += rng.uniform(-1, 1) * ub - lb

        return clip_population(trial_population, lb, ub), calculate_fitness(trial_population, func)

    population = get_initial_population(dim, lb, ub, rng)
    fitnesses = calculate_fitness(population, func)

    for _ in range(budget):
        population, fitnesses = differential_evolution(population, fitnesses, lb, ub, rng)

    best_index = np.argmin(fitnesses)
    return population[:, best_index]
