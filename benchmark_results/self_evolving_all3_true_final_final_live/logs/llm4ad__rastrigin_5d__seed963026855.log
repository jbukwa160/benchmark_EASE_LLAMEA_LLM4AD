def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    sigma0 = 1.0
    c1 = 2 / (dim + 1)
    c2 = 2 / (dim + 1)
    c3 = 1 / (dim + 1)
    weight = np.random.rand(pop_size, dim)

    for _ in range(budget):
        x = rng.uniform(lb, ub, size=(pop_size, dim))
        f_value = func(x)
        y = np.zeros((pop_size, dim))

        for i in range(pop_size):
            v1 = x[np.random.choice(range(pop_size), 3, replace=False)]
            v2 = x[np.random.choice(range(pop_size), 3, replace=False)]

            u = c1 * weight[i] + c2 * np.random.randn(dim) + c3 * (v1 - v2)
            y[i] = x[i] + sigma0 * u

        f_value_new = func(np.clip(y, lb, ub))
        mask = f_value_new < f_value
        x[mask] = y[mask]
        f_value = f_value_new

    best_x = x[np.argmin(f_value)]
    return np.array(best_x)
