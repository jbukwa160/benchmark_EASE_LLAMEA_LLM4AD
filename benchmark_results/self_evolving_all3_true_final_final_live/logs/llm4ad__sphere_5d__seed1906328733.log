def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.array([0.] * dim)
    f_best = func(x_best)

    for _ in range(budget):
        sigma = 1.
        while sigma > 1e-6:
            s = np.random.normal(size=dim) * sigma
            x = clip(np.add(x_best, s), lb, ub)

            f = func(x)
            if f < f_best:
                f_best = f
                x_best = x

            sigma *= 0.5

    return x_best
