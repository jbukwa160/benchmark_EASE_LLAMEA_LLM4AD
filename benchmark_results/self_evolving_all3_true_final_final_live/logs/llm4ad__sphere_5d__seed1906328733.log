def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_candidate = rng.uniform(lb, ub, size=dim)
    best_fitness = func(clip(best_candidate))

    for i in range(budget):
        candidate1 = clip(best_candidate + 0.5 * rng.normal(size=dim))
        candidate2 = clip(best_candidate - 0.5 * rng.normal(size=dim))
        candidate3 = clip(candidate1 + rng.uniform(-1, 1, size=dim))

        fitness1 = func(clip(candidate1))
        fitness2 = func(clip(candidate2))
        fitness3 = func(clip(candidate3))

        if fitness1 < best_fitness:
            best_candidate = candidate1
            best_fitness = fitness1
        elif fitness2 < best_fitness:
            best_candidate = candidate2
            best_fitness = fitness2
        elif fitness3 < best_fitness:
            best_candidate = candidate3
            best_fitness = fitness3

        alpha = 0.95
        temperature = np.exp(-alpha * i / budget)
        if rng.uniform(0, 1) < np.exp((best_fitness - func(clip(best_candidate + temperature * rng.normal(size=dim))))):
            best_candidate += temperature * rng.normal(size=dim)

    return clip(best_candidate)
