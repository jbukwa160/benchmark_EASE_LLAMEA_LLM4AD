def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        i = rng.choice(dim)
        step = rng.uniform(-1.0, 1.0)
        new_x = x.copy()
        new_x[i] += step
        new_x = np.clip(new_x, lb, ub)
        
        if func(new_x) < best_f:
            best_f = func(new_x)
            best_x = new_x

    return best_x
