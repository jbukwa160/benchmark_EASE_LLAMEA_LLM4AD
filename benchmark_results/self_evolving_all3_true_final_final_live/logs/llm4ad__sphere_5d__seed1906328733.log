def algorithm(func, dim, lb, ub, budget, rng):
    D = len(dim)
    x0 = np.array([lb + 2 * rng * (ub - lb)] * D)
    T = 1000000
    alpha = 0.99
    beta = 1 / D

    best_x = x0.copy()
    best_f = func(best_x)

    for _ in range(budget):
        xi = best_x + np.random.normal(size=D, loc=0, scale=T)
        xi = np.clip(xi, lb, ub)
        
        fi = func(xi)
        
        if fi < best_f:
            best_x = xi
            best_f = fi
        
        T *= alpha

    return best_x
