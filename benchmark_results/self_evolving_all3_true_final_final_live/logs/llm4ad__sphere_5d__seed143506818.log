def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    current = np.random.uniform(lb, ub, size=dim)
    best = current.copy()
    temperature = 1.0
    for _ in range(budget):
        new_candidate = clip(current + np.random.uniform(-temperature, temperature, size=dim))
        delta = func(new_candidate) - func(best)
        if delta < 0 or rng.rand() < np.exp(-delta / temperature):
            current = new_candidate.copy()
            best = current.copy()
        temperature *= 1.00001
    return best
