def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    f_x = func(x)

    for _ in range(budget - 1):
        s = rng.choice(dim, size=2, replace=False)
        a, b = x[s]
        if rng.random() < 0.5:
            x[s] = (a + rng.uniform(-ub, ub), b)
        else:
            x[s] = (b, a)
        f_x_new = func(x)
        if f_x_new < f_x:
            f_x = f_x_new

    return x
