def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    pop_size = 50
    sigma = 1
    T = 1000
    alpha = 0.5
    
    # Initialize population
    x = rng.uniform(lb, ub, (pop_size, D))
    
    for _ in range(budget):
        # Compute fitness values
        f_x = func(x)
        
        # Update best solution so far
        idx_best = np.argmin(f_x)
        best_x = x[idx_best]
        best_f_x = f_x[idx_best]
        
        # Simulated annealing
        for i in range(pop_size):
            if i == idx_best:
                continue
                
            delta_f = f_x[i] - best_f_x
            if rng.uniform(0, 1) < np.exp(-delta_f / T):
                x[i] += rng.normal(0, sigma)
                x[i] = np.clip(x[i], lb, ub)
        
        # Nelder-Mead simplex method
        a = 2
        c = 1
        r = 2
        
        s = best_x + rng.uniform(-a, a) * (x - best_x).mean(axis=0)
        s = np.clip(s, lb, ub)
        fs = func(s)
        
        if fs < best_f_x:
            idx_best = pop_size
            best_x = s
            best_f_x = fs
        
        b = best_x + rng.uniform(-c, c) * (x[idx_best] - best_x)
        b = np.clip(b, lb, ub)
        fb = func(b)
        
        if fb < best_f_x:
            idx_best = pop_size
            best_x = b
            best_f_x = fb
        
        d = best_x + rng.uniform(-r, r) * (x[idx_best] - x.mean(axis=0))
        d = np.clip(d, lb, ub)
        fd = func(d)
        
        if fd < best_f_x:
            idx_best = pop_size
            best_x = d
            best_f_x = fd
        
        T *= alpha
    
    return best_x
