def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    x0 = (ub - lb) * rng.rand(n) + lb
    T = 1000
    alpha = 0.99
    k = 0
    best_x = x0.copy()
    best_f = func(x0)

    while k < budget:
        x_new = x0.copy() + (ub - lb) * rng.randn(n)
        x_new = np.clip(x_new, lb, ub)

        if rng.rand() < 0.1: # 10% chance of gradient descent
            grad = np.zeros(n)
            for i in range(n):
                x_new[i] += 1e-6
                grad[i] = (func(x_new) - best_f) / 1e-6
                x_new[i] -= 1e-6

            step_size = 0.1 * np.linalg.norm(x_new - x0)
            x_new -= step_size * grad

        f_new = func(x_new)

        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new
            k = 0
        else:
            delta = f_new - best_f
            if delta < 1e-6 and T > 10: # adaptive restarts
                k = 0
                T *= alpha

            elif rng.rand() < np.exp(-delta / (T * 1e-6)):
                x0 = x_new.copy()
                k += 1
        T *= alpha
        k += 1

    return best_x
