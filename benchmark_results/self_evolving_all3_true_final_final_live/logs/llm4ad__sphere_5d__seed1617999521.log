def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array(rng.uniform(lb, ub, size=dim))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget - 1):
        x_new = x + rng.uniform(-0.5, 0.5, size=dim) * (ub - lb)
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new
            
        # Gradually contract the search space
        delta = 0.9 * (ub - lb) / budget
        lb -= delta
        ub -= delta
        
    return best_x
