def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    t = 1.0
    best_x = x.copy()
    step_size = 2.0 * (ub - lb) / dim

    for _ in range(budget):
        n_x = clip(x + rng.uniform(-step_size, step_size, size=dim))
        delta = func(n_x) - func(x)
        if delta < 0 or np.random.rand() < np.exp(-(delta / t)):
            x = n_x
            if func(x) < func(best_x):
                best_x = x.copy()
        else:
            t *= 0.99

    return best_x
