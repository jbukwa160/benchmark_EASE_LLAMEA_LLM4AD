def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    res = differential_evolution(lambda x: func(clip(x)), [(lb, ub) for _ in range(dim)], 
                                 strategy='best1exp', maxiter=budget, 
                                 x0=rng.uniform(lb, ub, size=dim), 
                                 mutation=(1.5, 2.4), recombination=0.7, 
                                 polish=True, workers=-1)
    
    return clip(res.x)
