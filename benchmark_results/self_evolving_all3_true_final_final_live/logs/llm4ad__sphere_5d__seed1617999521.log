def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def distance(x1, x2):
        return np.linalg.norm(x1 - x2)

    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    current_radius = 5.0
    temperature = 1000

    for _ in range(budget):
        new_x = clip(best_x + rng.normal(0, current_radius, size=(dim,)))
        
        # adaptive radius adjustment
        if func(new_x) < func(best_x):
            best_x = new_x.copy()
            current_radius *= 1.01  # increase radius when improving solution
            temperature *= 0.99    # decrease temperature to control exploration-exploitation trade-off

        elif rng.rand() < np.exp(-(func(new_x) - func(best_x)) / temperature):
            best_x = new_x.copy()

        current_radius = min(current_radius, distance(best_x, x))

    return best_x
