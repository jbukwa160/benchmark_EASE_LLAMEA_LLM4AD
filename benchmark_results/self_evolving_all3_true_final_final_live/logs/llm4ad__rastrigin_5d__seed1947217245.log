def algorithm(func, dim, lb, ub, budget, rng):
    pop = np.random.uniform(lb, ub, size=(budget, dim))
    
    # Smoothed PSO parameters
    c1, c2 = 0.5, 0.3
    w, c = 0.7298, 1.494173
    
    for t in range(budget):
        # Compute fitness ( Rastrigin function )
        fit = func(pop)
        
        # Find the best solution so far
        gbest_idx = np.argmin(fit)
        gbest = pop[gbest_idx]
        
        # Update velocity and position using smoothed PSO
        vel = w * np.copy(pop) + c1 * rng.rand(size=pop.shape) * (pop - np.copy(gbest)) + \
              c2 * rng.rand(size=pop.shape) * (np.copy(gbest) - pop)
        
        # Clip candidates to [lb, ub]
        for i in range(dim):
            vel[:, i] = np.clip(vel[:, i], lb[i], ub[i])
        
        # Update population
        pop += vel
        
    return gbest
