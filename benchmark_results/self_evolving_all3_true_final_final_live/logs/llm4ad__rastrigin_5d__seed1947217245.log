def algorithm(func, dim, lb, ub, budget, rng):
    x0 = 2 * lb + (ub - lb) * rng.uniform(0, 1, size=dim)
    best_x = x0.copy()
    best_f = func(x0)

    for i in range(budget):
        y = np.zeros(dim)
        for j in range(dim):
            if rng.random() < 0.5:
                y[j] = best_x[j] + 1e-3 * (ub - lb) * rng.uniform(-1, 1)
            else:
                y[j] = x0[j]
        
        r1 = rng.uniform(0, 1, size=dim)
        r2 = rng.uniform(0, 1, size=dim)
        x_new = best_x + (y - best_x) * (r1 ** 2)

        for j in range(dim):
            if rng.random() < 0.5:
                x_new[j] += (ub - lb) * rng.uniform(-1, 1)
        
        f_new = func(x_new)
        alpha = np.exp(-(i / budget))
        p = rng.uniform(0, 1)

        if f_new <= best_f or np.random.rand() < alpha:
            best_x = x_new.copy()
            best_f = f_new

    return best_x
