def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(size, dimension, lower_bound, upper_bound):
        return (lower_bound + (upper_bound - lower_bound) * rng.uniform(size=(size, dimension))).astype(float)

    def calculate_fitness(population, func):
        return [func(individual) for individual in population]

    def update_mean(population, mean):
        return np.mean(population, axis=0)

    def update_covariance_matrix(population, mean, covariance_matrix):
        delta = population - mean
        covariance_matrix += np.dot(delta.T, delta)
        return covariance_matrix

    def sample_from_distribution(mean, covariance_matrix):
        return mean + np.linalg.cholesky(covariance_matrix) @ rng.normal(size=mean.shape)

    def rank_based_selection(population, fitness_values, size):
        indices = np.argsort(fitness_values)[:size]
        return [population[i] for i in indices], [fitness_values[i] for i in indices]

    def adaptive_learning_rate(fitness_values, learning_rates):
        return [0.1 + 0.9 * (1 - val) for val in fitness_values]

    population_size = 100
    max_iterations = budget // population_size

    initial_population = generate_initial_population(population_size, dim, lb, ub)
    best_individual = np.zeros(dim)

    for _ in range(max_iterations):
        fitness_values = calculate_fitness(initial_population, func)
        mean = update_mean(initial_population, np.zeros(dim))
        covariance_matrix = np.eye(dim) * 1e-5

        selected_indices, selected_fitness_values = rank_based_selection(initial_population, fitness_values, population_size // 2)

        selected_individuals = [clip(sample_from_distribution(mean, covariance_matrix)) for _ in range(population_size // 2)]

        mean = update_mean(selected_individuals + initial_population[selected_indices], np.zeros(dim))
        covariance_matrix = update_covariance_matrix(selected_individuals + initial_population[selected_indices], mean, covariance_matrix)

        learning_rates = adaptive_learning_rate(selected_fitness_values, [1.0] * len(selected_fitness_values))

        for i in range(population_size):
            selected_individual = clip(sample_from_distribution(mean, covariance_matrix))
            if func(selected_individual) < func(best_individual):
                best_individual = selected_individual

    return best_individual
