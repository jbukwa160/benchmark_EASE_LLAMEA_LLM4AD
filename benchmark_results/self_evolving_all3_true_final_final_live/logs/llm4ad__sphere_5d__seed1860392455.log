def algorithm(func, dim, lb, ub, budget, rng):
    X = rng.uniform(lb, ub, size=(budget, dim))
    Y = func(X)
    best_x = np.zeros(dim)
    best_y = float('inf')
    
    for _ in range(budget):
        # Sample 10 new points
        x = rng.uniform(lb, ub, size=(10, dim))
        
        # Evaluate the function at these points
        y = func(x)
        
        # Create a Gaussian process model
        cov_func = np.cov(X.T) + (1e-8 * np.eye(dim))
        gp = GaussianProcessRegressor(kernel=cov_func,
                                      alpha=0.1).fit(X, Y)
        
        # Predict the mean and standard deviation of the function at each new point
        mu, std = gp.predict(x, return_std=True)
        
        # Sample from a normal distribution with the predicted mean and standard deviation
        x_new = np.zeros((10, dim))
        for i in range(10):
            x_new[i] = x[i] + rng.normal(mu[i], std[i])
            
        # Evaluate the function at these new points
        y_new = func(x_new)
        
        # Add these new points to the dataset
        X = np.vstack((X, x_new))
        Y = np.hstack((Y, y_new))
        
        # Update the best point found so far
        idx = np.argmin(Y[-10:])
        if Y[-10 + idx] < best_y:
            best_x = x_new[idx]
            best_y = Y[-10 + idx]
            
    return best_x
