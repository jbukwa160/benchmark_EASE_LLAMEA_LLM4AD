def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    best_x = np.random.uniform(lb, ub, size=(dim,))
    best_f = func(best_x)
    
    for _ in range(budget):
        step_size = 0.1
        x = clip(best_x + rng.normal(size=(dim,), loc=0, scale=step_size))
        
        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x
            
    return best_x
