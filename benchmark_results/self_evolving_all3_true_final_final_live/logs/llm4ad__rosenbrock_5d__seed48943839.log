def algorithm(func, dim, lb, ub, budget, rng):
    def bounded_de(x_bounds, func, maxiter, popsize, tol, mutation_strategy, recombination_strategy):
        bounds = [(lb[i], ub[i]) for i in range(dim)]
        result = differential_evolution(func, bounds=bounds, args=(), maxiter=maxiter,
                                        popsize=popsize, tol=tol, mutation_strategy=mutation_strategy,
                                        recombination_strategy=recombination_strategy)
        return result.x

    def adaptive_de(x_bounds, func, budget):
        popsizes = [10, 20, 50]
        mutation_strategies = ['best1exp', 'rand1exp']
        recombination_strategies = ['strategic', 'bin']

        best_solution = None
        for popsize in popsizes:
            for mutation_strategy in mutation_strategies:
                for recombination_strategy in recombination_strategies:
                    solution = bounded_de(x_bounds, func, 5000, popsize, 1e-6, mutation_strategy,
                                         recombination_strategy)
                    if best_solution is None or func(solution) < func(best_solution):
                        best_solution = solution

        return best_solution

    x_bounds = [(lb[i], ub[i]) for i in range(dim)]
    budget = int(budget * (10 ** rng))
    best_solution = adaptive_de(x_bounds, func, budget)
    return np.array(best_solution)
