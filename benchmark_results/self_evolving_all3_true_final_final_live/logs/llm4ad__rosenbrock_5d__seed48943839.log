def algorithm(func, dim, lb, ub, budget, rng):
    def fitness(x):
        return func(x)

    x = rng.uniform(lb, ub, size=dim)
    f_best = fitness(x)
    best_x = x.copy()

    for _ in range(budget):
        v = np.zeros(dim)
        for i in range(5):
            C = (np.eye(dim) + 0.1 * rng.normal(size=(dim, dim))).astype(np.float32)
            p = best_x.copy()
            for _ in range(int(budget / 10)):
                v_new = np.dot(C, v) + rng.normal(size=dim)
                x_new = p + v_new
                x_new = np.clip(x_new, lb, ub)
                f_new = fitness(x_new)
                if f_new < f_best:
                    best_x = x_new.copy()
                    f_best = f_new
            C = 0.5 * (C + np.eye(dim))
        f_new = fitness(best_x - rng.normal(size=dim) / np.sqrt(budget))
        if f_new < f_best:
            best_x -= rng.normal(size=dim) / np.sqrt(budget)
            best_x = np.clip(best_x, lb, ub)

    return best_x
