def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.maximum(np.minimum(x, ub), lb)

    def generate_candidates(population, weights, c1, c2, f_min, f_max):
        n = population.shape[0]
        candidates = np.zeros((n, dim))
        for i in range(n):
            a, b, d = rng.choice(n, 3, replace=False)
            trial = population[a] + weights * (population[b] - population[a]) + c1 * rng.uniform(-1, 1, size=dim) + c2 * rng.uniform(-1, 1, size=dim)
            trial = clip(trial, lb, ub)
            candidates[i] = trial
        return candidates

    def evaluate(population):
        evaluations = [func(x) for x in population]
        return np.array(evaluations)

    n_population = 10
    population = rng.uniform(lb, ub, size=(n_population, dim))
    weights = rng.uniform(0.5, 1.5, size=n_population)
    c1 = 2.8
    c2 = 1.3
    f_min = np.inf
    f_max = -np.inf

    for i in range(budget):
        candidates = generate_candidates(population, weights, c1, c2, f_min, f_max)
        evaluations = evaluate(candidates)
        f_min_new = min(evaluations)
        if f_min_new < f_min:
            population = candidates[np.argmin(evaluations)]
            f_min = f_min_new
            f_max = max(f_max, np.max(evaluations))
        weights += rng.uniform(-0.1, 0.1, size=n_population)

    return clip(population, lb, ub)
