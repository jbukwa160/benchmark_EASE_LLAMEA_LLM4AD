def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def generate_initial_population(n, dim, lb, ub):
        return rng.uniform(lb, ub, (n, dim))

    def calculate_fitness(population):
        return np.array([func(ind) for ind in population])

    def calculate_distance(ind1, ind2):
        return np.linalg.norm(ind1 - ind2)

    def generate_offspring(parents, mu):
        offspring = parents + rng.uniform(-mu, mu, (len(parents), dim))
        return clip(offspring, lb, ub)

    def greedy_selection(population, fitness, budget):
        indices = np.argsort(fitness)[:budget]
        selected = population[indices]
        return selected

    n = 50
    mu = 0.1
    population = generate_initial_population(n, dim, lb, ub)
    fitness = calculate_fitness(population)

    for _ in range(budget):
        indices = np.argsort(fitness)[:int(n/2)]
        parents = population[indices]
        offspring = generate_offspring(parents, mu)
        new_fitness = calculate_fitness(offspring)
        new_indices = np.argsort(new_fitness)
        population[new_indices[:int(n/2)]] = parents
        population[new_indices[int(n/2):]] = offspring
        fitness = new_fitness

    best_index = np.argmin(fitness)
    return clip(population[best_index], lb, ub)
