def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        # Step 1: Simulated Annealing
        T = 100.0
        alpha = 0.99
        
        while True:
            y = x + rng.randn(1, dim) * 2e-4
            y = np.clip(y, lb, ub)
            
            fy = func(y)
            if fy < best_f or np.exp((best_f - fy)/T) > rng.rand():
                x = y
                best_x = y.copy()
                best_f = min(best_f, fy)
                
                T *= alpha
                
                if np.abs(T) < 1e-6:
                    break
                    
            if np.random.rand() < 0.01 or _ == budget - 1:
                break
                
        # Step 2: Nelder-Mead
        simplex_size = 20
        
        for i in range(simplex_size):
            y = best_x + (rng.randn(1, dim) * 10).reshape(-1)
            y = np.clip(y, lb, ub)
            
            fy = func(y)
            if fy < best_f:
                best_x = y.copy()
                best_f = fy
                
    return best_x
