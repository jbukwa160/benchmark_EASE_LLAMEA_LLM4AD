def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    best_x = None
    best_f = float('inf')
    for _ in range(budget):
        pop = np.random.uniform(lb, ub, (100, dim))
        for i in range(50): # 50 generations of DE
            r1 = rng.choice(pop, size=dim)
            r2 = rng.choice(pop, size=dim)
            for j in range(dim):
                if rng.random() < 0.5:
                    temp = r1[j]
                    r1[j] = r2[j]
                    r2[j] = temp
            new_x = pop + 0.7 * (r1 - pop) + 0.3 * (rng.uniform(lb, ub, dim) - pop)
            new_f = evaluate(new_x)
            if new_f < best_f:
                best_f = new_f
                best_x = clip(new_x)

    return best_x
