def algorithm(func, dim, lb, ub, budget, rng):
    num_dim = len(dim)
    x = rng.uniform(lb, ub, size=(num_dim,))
    T = 1e3
    alpha = 0.99
    beta = 0.995
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        i = rng.choice(num_dim)
        delta = rng.uniform(-5, 5)
        new_x = x.copy()
        new_x[i] += delta

        # Clip candidates to [lb, ub]
        new_x = np.clip(new_x, lb, ub)

        new_f = func(new_x)

        if new_f < best_f:
            best_x = new_x
            best_f = new_f

        if rng.uniform(0, 1) < np.exp((best_f - new_f) / T):
            x[i] += delta

        T *= alpha
        # To avoid premature convergence
        for j in range(num_dim):
            if rng.uniform(0, 1) > beta:
                i = (i + j) % num_dim
                delta = rng.uniform(-5, 5)
                new_x = x.copy()
                new_x[i] += delta

                # Clip candidates to [lb, ub]
                new_x = np.clip(new_x, lb, ub)

                new_f = func(new_x)

                if new_f < best_f:
                    best_x = new_x
                    best_f = new_f

                if rng.uniform(0, 1) < np.exp((best_f - new_f) / T):
                    x[i] += delta

    return best_x
