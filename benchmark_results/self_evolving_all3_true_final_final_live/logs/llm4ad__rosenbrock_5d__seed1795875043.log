def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_candidate(current_best, rng=rng):
        candidate = current_best.copy()
        for i in range(dim):
            if rng.random() < 0.1:
                candidate[i] += rng.uniform(-5.0, 5.0)
            elif rng.random() < 0.1:
                candidate[i] -= rng.uniform(0.0, 5.0)
        return clip(candidate)

    current_best = np.array([ub + (lb - ub) * rng.uniform(0.0, 1.0)] * dim)
    best_solution = current_best.copy()

    for _ in range(budget):
        candidate = generate_candidate(current_best, rng=rng)
        fitness = func(candidate)
        if fitness < func(best_solution):
            best_solution = candidate
        current_best = np.random.choice([current_best, candidate], p=[0.9, 0.1])

    return best_solution
