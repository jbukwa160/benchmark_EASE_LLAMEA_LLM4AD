def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(x):
        return x + 0.1 * rng.uniform(-1, 1, size=dim)

    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    current = np.zeros(dim)
    best = np.zeros(dim)
    min_value = float('inf')

    for _ in range(budget):
        candidate = generate_candidate(current)
        clipped = clip(candidate, lb, ub)
        new_value = func(clipped)
        
        if new_value < min_value:
            min_value = new_value
            current[:] = clipped
            best[:] = clipped
        else:
            alpha = np.exp(-min_value / (new_value - min_value))
            beta = rng.uniform(0, 1)
            
            if beta > alpha:
                current[:] = clipped
                min_value = new_value

    return best
