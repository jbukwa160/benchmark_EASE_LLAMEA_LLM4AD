def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    F = 0.5
    CR = 0.9
    max_iter = int(budget / pop_size)

    population = rng.uniform(lb, ub, (pop_size, dim))
    fitness = np.array([func(x) for x in population])

    for _ in range(max_iter):
        for i in range(pop_size):
            idx1, idx2, idx3 = rng.choice(range(pop_size), 3, replace=False)
            trial = population[idx1] + F * (population[idx2] - population[idx3])
            for j in range(dim):
                if rng.rand() < CR or trial[j] == population[i][j]:
                    trial[j] = np.clip(trial[j], lb, ub)
            fitness_trial = func(np.array(trial))
            if fitness_trial < fitness[i]:
                population[i] = trial
                fitness[i] = fitness_trial

    return np.argmin(fitness)
