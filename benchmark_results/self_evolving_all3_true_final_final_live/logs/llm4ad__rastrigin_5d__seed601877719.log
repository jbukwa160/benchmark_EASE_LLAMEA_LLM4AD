def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(size, dim, lb, ub):
        return lb + (ub - lb) * rng.uniform(size=(size, dim))

    def clip_candidates(candidates, lb, ub):
        return np.clip(candidates, lb, ub)

    def evaluate_population(population, func):
        return [func(individual) for individual in population]

    def select_parents(population, func_values, size):
        indices = np.argsort(func_values)[:size]
        return population[indices], func_values[indices]

    def crossover(parent1, parent2, rng):
        if rng.uniform() < 0.5:
            child = (parent1 + parent2) / 2
        else:
            child = parent1 * 0.7 + parent2 * 0.3
        return clip_candidates(child, lb, ub)

    def mutate(individual, rng):
        mutation_factor = 0.01
        for i in range(dim):
            if rng.uniform() < 0.5:
                individual[i] += (ub - lb) * mutation_factor * rng.uniform(-1, 1)
                individual[i] = clip_candidates(individual[i], lb, ub)[i]
        return individual

    population_size = int(np.ceil(budget ** (1 / dim)))
    population = generate_initial_population(population_size, dim, lb, ub)

    for _ in range(budget):
        func_values = evaluate_population(population, func)
        parents, parent_values = select_parents(population, func_values, population_size // 2)

        offspring = []
        for i in range(population_size // 2):
            child1 = crossover(parents[i], parents[(i + 1) % (population_size // 2)], rng)
            child2 = mutate(child1, rng)
            offspring.append(child2)

        population = np.array(offspring + [parents[-1]])
        func_values = evaluate_population(population, func)

    return population[np.argmin(func_values)]
