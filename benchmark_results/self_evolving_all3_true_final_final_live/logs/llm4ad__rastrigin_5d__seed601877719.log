def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for i in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
            
        # Local refinement
        step_size = 0.1 * (ub - lb)
        for _ in range(10):
            direction = rng.uniform(-1, 1, size=dim)
            new_x = best_x + step_size * direction
            
            # Clip to bounds
            new_x = np.clip(new_x, lb, ub)
            
            f_new = func(new_x)
            
            if f_new < best_f:
                best_f = f_new
                best_x = new_x
                
    return best_x
