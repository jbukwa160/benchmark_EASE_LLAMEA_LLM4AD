def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(size, dim, lb, ub):
        return rng.uniform(lb, ub, size=(size, dim))

    def clip_to_bounds(x, lb, ub):
        return np.clip(x, a_min=lb, a_max=ub)

    def compute_fitness(x):
        return func(x)

    def generate_offspring(population, parents, sigma):
        offspring = population[parents]
        for i in range(len(offspring)):
            offspring[i] += rng.normal(loc=0.0, scale=sigma, size=(1, dim))
        return clip_to_bounds(offspring, lb, ub)

    def mate_population(parents, num_offspring):
        offspring = np.zeros((num_offspring, dim))
        for i in range(num_offspring):
            idx = rng.randint(0, len(parents), size=2)
            offspring[i] = 0.5 * (parents[idx[0]] + parents[idx[1]])
        return clip_to_bounds(offspring, lb, ub)

    def update_population(population, offspring, selection_method):
        if selection_method == 'random':
            selected_indices = rng.choice(len(population), size=len(population), replace=False)
            new_population = np.concatenate((population[selected_indices], offspring))
        elif selection_method == 'fitness_proportional':
            fitnesses = [compute_fitness(x) for x in population]
            probabilities = fitnesses / sum(fitnesses)
            selected_indices = rng.choice(len(population), size=len(population), p=probabilities, replace=False)
            new_population = np.concatenate((population[selected_indices], offspring))
        return new_population

    def run_cma_es(population, budget, dim):
        sigma = 1.0
        mu = np.mean(population, axis=0)
        cov = np.cov(population, rowvar=False)

        for i in range(budget):
            # Select parents
            parents = population[rng.choice(len(population), size=min(int(0.2 * len(population)), 100), replace=False)]

            # Generate offspring using CMA-ES
            offspring = np.zeros((len(parents), dim))
            for j, parent in enumerate(parents):
                offspring[j] += rng.normal(loc=mu, scale=sigma, size=(1, dim)) + parent

            # Clip to bounds
            offspring = clip_to_bounds(offspring, lb, ub)

            # Evaluate fitness
            fitnesses = [compute_fitness(x) for x in offspring]
            idx = np.argmax(fitnesses)
            new_population = update_population(population, offspring[idx].reshape(1, -1), 'fitness_proportional')
            population = new_population

            sigma *= 0.99  # Decrease sigma over time
            if i % 10 == 0:
                print('Best fitness:', np.max([compute_fitness(x) for x in population]))

        return population

    # Initialize population and run algorithm
    population_size = int(1e3)
    initial_population = generate_initial_population(population_size, dim, lb, ub)

    # Run GA-CMA-ES hybrid
    best_solution = None
    for _ in range(budget):
        new_population = run_cma_es(initial_population, 100, dim)
        if not best_solution or np.max([compute_fitness(x) for x in new_population]) > np.max([compute_fitness(x) for x in initial_population]):
            initial_population = new_population

    # Return the best solution found
    return np.array([x for x in initial_population if compute_fitness(x) == np.min([compute_fitness(x) for x in initial_population])])[0]
