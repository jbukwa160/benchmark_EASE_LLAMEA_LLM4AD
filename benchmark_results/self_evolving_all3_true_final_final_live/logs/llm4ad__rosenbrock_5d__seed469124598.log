def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    pop_size = 50
    learning_rate = 1.0
    crossover_prob = 0.9

    for _ in range(budget):
        for i in range(pop_size):
            target = clip(x[i], lb, ub)
            donor = x[np.random.choice(range(pop_size), size=3, replace=False)]
            if rng.random() < crossover_prob:
                donor = (1 - rng.uniform(0, 1)) * target + rng.uniform(0, 1) * donor
            mutant = clip(target + learning_rate * (donor - target), lb, ub)
            x[i] = mutant

        best_so_far_x = np.copy(x[0])
        for i in range(1, pop_size):
            if func(best_so_far_x) > func(x[i]):
                best_so_far_x = x[i]

        x = best_so_far_x + rng.uniform(-1.5, 1.5, size=dim)

    return clip(x, lb, ub)
