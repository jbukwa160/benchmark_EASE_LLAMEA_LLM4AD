def algorithm(func, dim, lb, ub, budget, rng):
    def adapt_penalty(x, xbest):
        return 1e-3 * np.sum(np.maximum(0, (x - xbest)**2)) + 1e-6 * np.sum(np.abs(x))

    best_x = None
    best_fx = np.inf

    for _ in range(budget):
        if best_x is None:
            cma_init = np.random.uniform(lb, ub, size=dim)
            sigma = 10.0 / dim**2
        else:
            cma_mu = (best_x - lb) / (ub - lb)
            cma_sig = sigma * np.sqrt(1 + (cma_sig**-2))
            cma_init = cma_mu + rng.normal(0, cma_sig, size=dim)

        for i in range(100):
            x_new = cma_init + rng.normal(0, 10.0, size=dim)
            fx = func(x_new)

            if not np.all(np.isfinite(x_new)):
                continue

            penalty = adapt_penalty(x_new, best_x)
            fx += penalty

            if fx < best_fx:
                best_fx = fx
                best_x = x_new
                cma_init = x_new

        if budget - _ <= 10:
            break

    return np.clip(best_x, lb, ub)
