def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    def clip(x):
        return np.clip(x, lb, ub).astype(np.float32)

    for i in range(budget):
        sigma = max(0.01, 1 / (i + 1))
        x_cand = rng.normal(size=dim) * sigma + clip(x_best)
        
        f_cand = func(x_cand)
        
        if f_cand < f_best:
            f_best = f_cand
            x_best = x_cand
    
    return x_best
