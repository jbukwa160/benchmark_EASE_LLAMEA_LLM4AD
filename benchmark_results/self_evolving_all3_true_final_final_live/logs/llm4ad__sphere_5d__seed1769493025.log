def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    for _ in range(budget):
        delta = 0.1 * (ub - lb) * np.ones(dim)
        x_new = x + delta * np.random.uniform(-1, 1, size=dim)
        x_new = np.clip(x_new, lb, ub)
        if func(x_new) < func(x):
            x = x_new
    return x
