def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    y_best = float('inf')
    
    for i in range(budget):
        # Sample a new candidate using a Gaussian distribution centered at the current best solution
        x_candidate = x_best + rng.normal(size=dim) * 0.5
        
        # Clip candidates to [lb, ub]
        x_candidate = np.clip(x_candidate, lb, ub)
        
        # Evaluate the objective function
        y_candidate = func(x_candidate)
        
        # Update the best solution if a better one is found
        if y_candidate < y_best:
            x_best = x_candidate
            y_best = y_candidate
    
    return x_best
