def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    x_best = rng.uniform(lb, ub, size=(dim,))
    f_best = func(x_best)
    
    T = 10.0
    cooling_rate = 0.99
    
    for i in range(budget):
        T *= cooling_rate
        
        # Differential evolution
        v1 = rng.normal(size=(dim,))
        v2 = rng.normal(size=(dim,))
        x_mut = clip(x_best + 0.5 * (v1 - v2))
        
        # Simulated annealing
        f_mut = func(clip(x_mut))
        
        if f_mut < f_best:
            x_best = x_mut
            f_best = f_mut
            
        elif rng.uniform() < np.exp((f_best - f_mut) / T):
            x_best = x_mut
            f_best = f_mut
    
    return x_best
