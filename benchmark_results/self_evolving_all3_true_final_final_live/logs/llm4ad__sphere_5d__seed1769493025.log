def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    X = np.zeros((budget, 1))
    Y = np.zeros(budget)
    for t in range(1, dim+1):
        d_t = rng.randint(t, dim)
        x_0 = np.random.uniform(lb, ub, (t, 1))

        for i in range(t, budget):
            x_next = clip(x_0 + rng.normal(size=(t, 1), loc=0, scale=1))
            X[i] = x_next.flatten()
            Y[i] = func(X[i])

    idx_best = np.argmin(Y)
    return X[idx_best]
