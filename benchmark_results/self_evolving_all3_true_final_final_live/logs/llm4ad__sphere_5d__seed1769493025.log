def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    y_best = func(x)

    for _ in range(budget - 1):
        # Differential Evolution (DE) step
        v = rng.normal(size=dim)
        x_new = x + 0.5 * rng.choice([-1, 1], size=dim) * v

        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)

        y_new = func(x_new)

        if y_new < y_best:
            x = x_new
            y_best = y_new

    return x
