def algorithm(func, dim, lb, ub, budget, rng):
    T = 1000.0
    t = 0
    x_best = -np.inf * np.ones(dim)
    for _ in range(budget):
        x = lb + (ub - lb) * rng.uniform(size=dim)
        f_new = func(x)
        if f_new < x_best:
            x_best = f_new
            x_best_candidate = x.copy()
        f_old = func(-x_best)
        alpha = np.exp(-(f_old - x_best) / T)
        if rng.rand() < alpha:
            t += 1
            T *= 0.99
    return x_best_candidate
