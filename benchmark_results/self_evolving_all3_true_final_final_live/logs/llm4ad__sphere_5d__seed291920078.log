def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_candidate(current_solution):
        candidate = current_solution + (ub - lb) * rng.uniform(-1, 1, size=dim)
        return clip(candidate)

    def acceptance_probability(current_fitness, new_fitness, temperature):
        if new_fitness < current_fitness:
            return 1
        else:
            return np.exp((current_fitness - new_fitness) / temperature)

    best_solution = None
    best_fitness = float('inf')
    current_solution = rng.uniform(lb, ub, size=dim)
    current_fitness = func(current_solution)

    for t in range(budget):
        temperature = 10 / (t + 1)**0.9  # dynamic temperature scheduling

        new_candidate = generate_candidate(current_solution)
        new_fitness = func(new_candidate)

        if np.random.rand() < acceptance_probability(current_fitness, new_fitness, temperature) or new_fitness < best_fitness:
            current_solution = new_candidate
            current_fitness = new_fitness

            if new_fitness < best_fitness:
                best_solution = current_solution
                best_fitness = new_fitness

    return best_solution
