def algorithm(func, dim, lb, ub, budget, rng):
    candidates = np.random.uniform(lb, ub, size=(budget, dim))
    for i in range(budget-1):
        scores = func(candidates)
        idx = np.argmin(scores)
        best_candidate = candidates[idx]
        best_score = scores[idx]

        new_candidates = np.zeros((budget, dim))
        new_candidates[i+1:] = rng.choice([candidates, best_candidate], p=[0.9, 0.1], size=(budget-1-i, dim))

        candidates[i+1:] = np.clip(new_candidates[i+1:], a_min=lb, a_max=ub)

    scores = func(candidates)
    idx = np.argmin(scores)
    return candidates[idx]
