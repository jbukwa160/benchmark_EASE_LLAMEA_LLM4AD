def algorithm(func, dim, lb, ub, budget, rng):
    if dim == 1:
        return np.array([0])

    X = np.random.uniform(lb, ub, (int(budget / dim), dim))
    X = np.clip(X, a_min=lb, a_max=ub)

    for i in range(dim - 1, budget):
        x_new = rng.normal(0, 10, size=(1, dim))
        x_new = np.clip(x_new + X[i % int(budget / dim)], a_min=lb, a_max=ub)
        f_x_new = func(x_new)

        if f_x_new < func(X[i % int(budget / dim)]):
            X[i % int(budget / dim)] = x_new

    best_idx = np.argmin(func(np.array([X])))
    return X[best_idx]
