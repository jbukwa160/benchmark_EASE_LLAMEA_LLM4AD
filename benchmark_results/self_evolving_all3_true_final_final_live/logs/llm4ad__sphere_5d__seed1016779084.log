def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    budget_used = 0
    while budget_used < budget:
        y = x + 1.0 * rng.normal(size=dim)
        y = clip(y)
        f_y = func(y)
        if f_y < func(best_x):
            best_x = y
        budget_used += 1
        sigma = np.std(x, axis=0) + 1e-8
        cov = (np.outer(x - best_x, x - best_x) / dim) * (sigma**2)
        step_size = 1.0 / (1 + sigma**2)
        x += step_size * rng.normal(size=dim) @ np.linalg.cholesky(cov).T
        x = clip(x)

    return best_x
