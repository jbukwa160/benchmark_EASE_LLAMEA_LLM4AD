def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    pop_size = 50
    x_best = np.zeros(dim)
    y_best = float('inf')

    for _ in range(budget // 2):
        population = np.random.uniform(lb, ub, size=(pop_size, dim))
        for i in range(pop_size):
            x_i = clip(population[i])
            if func(x_i) < y_best:
                y_best = func(x_i)
                x_best = x_i

        w = 0.5
        alpha = 2 / (np.random.uniform(1, 2) + rng.rand())
        beta = np.random.uniform(-1, 1)

        population[:] += alpha * (x_best - population) + beta * (population[np.random.permutation(pop_size)[:10]] - population)
        population = clip(population)

    return x_best
