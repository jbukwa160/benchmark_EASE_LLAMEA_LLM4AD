def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 1e5
    alpha = 0.99
    best_x = x.copy()
    best_y = func(x)

    for i in range(budget):
        y = func(np.clip(x + rng.normal(size=dim) * 0.01, lb, ub))
        if y < best_y:
            best_x = x.copy()
            best_y = y
        elif np.random.rand() < np.exp((best_y - y) / T):
            x = x.copy()

        T *= alpha

    return best_x
