def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(best, lb, ub):
        mean = best + 0.1 * (ub - lb) * rng.randn(dim)
        sigma = 0.5 * (ub - lb)
        candidate = mean + sigma * rng.randn(dim)
        return np.clip(candidate, lb, ub)

    def generate_neighbors(best, lb, ub, num):
        candidates = []
        for _ in range(num):
            candidates.append(generate_candidate(best, lb, ub))
        return np.array(candidates)

    best_so_far = 0
    best_solution = np.zeros(dim)
    candidate_pool = [np.zeros(dim)]

    for _ in range(budget):
        if len(candidate_pool) == 0:
            candidate_pool = generate_neighbors(best_solution, lb, ub, dim * 10)
        candidates = [generate_candidate(solution, lb, ub) for solution in candidate_pool]
        function_values = np.array([func(candidates[i]) for i in range(len(candidates))])
        new_candidates = np.array(candidates)[function_values < best_so_far]

        if len(new_candidates) > 0:
            best_solution = new_candidates[np.argmin(function_values)][None]
            candidate_pool.remove(best_solution)
            best_so_far = func(best_solution)

    return best_solution
