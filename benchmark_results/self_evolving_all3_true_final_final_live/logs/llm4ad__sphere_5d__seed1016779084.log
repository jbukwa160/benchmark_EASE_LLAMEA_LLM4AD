def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -1e10 * np.ones(dim)
    f_best = 1e10
    for i in range(budget):
        x = lb + (ub - lb) * rng.rand(dim)
        f = func(x)
        if f < f_best:
            f_best = f
            x_best = x
        x_best = np.clip(x_best, lb, ub)
    return x_best
