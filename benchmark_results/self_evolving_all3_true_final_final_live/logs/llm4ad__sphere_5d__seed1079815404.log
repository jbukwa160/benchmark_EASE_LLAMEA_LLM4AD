def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        if func(x) < best_f:
            best_f = func(x)
            best_x = x
            
        if budget - 1 <= np.random.rand() * budget and np.random.rand() < 0.5:
            break
    
    return best_x
