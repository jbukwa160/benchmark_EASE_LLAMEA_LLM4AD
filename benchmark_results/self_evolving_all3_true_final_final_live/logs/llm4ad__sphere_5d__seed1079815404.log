def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.ones(dim)
    f_best = 1e10
    for t in range(budget):
        x_candidate = np.clip(lb + (ub - lb) * rng.uniform(size=dim), a_min=lb, a_max=ub)
        f_candidate = func(x_candidate)
        if f_candidate < f_best:
            x_best = x_candidate.copy()
            f_best = f_candidate
        direction = rng.normal(size=dim)
        step_size = 0.1 * (ub - lb)
        x_try = x_best + step_size * direction
        x_try = np.clip(x_try, a_min=lb, a_max=ub)
        f_try = func(x_try)
        if f_try < f_best:
            x_best = x_try.copy()
            f_best = f_try
    return x_best
