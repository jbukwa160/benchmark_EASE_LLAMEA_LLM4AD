def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    x_best = clip(x_best)
    f_best = func(x_best)

    sigma = 1.0
    lambda_ = int(np.sqrt(dim))
    mu = 1 / lambda_

    for _ in range(budget):
        z = rng.normal(size=(lambda_, dim))

        v = np.exp(mu) * (x_best + sigma * z)
        v = clip(v)

        f_v = func(v)
        j = np.argsort(f_v)

        x_new = v[j[0]]
        if f_v[j[0]] < f_best:
            f_best = f_v[j[0]]
            x_best = x_new

        delta = (x_new - x_best) / sigma
        s2 = 1 / (lambda_ * mu)
        C = np.zeros((dim, dim))
        for i in range(lambda_):
            if j[i] < lambda_:
                C += s2 * delta[j[i]] @ delta[j[i]].T

        sigma *= 1 + 0.1
        M = np.eye(dim) + mu * C

        v = rng.multivariate_normal(np.zeros(dim), sigma**2 * M)
        x_best -= (x_best - v) / (lambda_ * mu)

    return x_best
