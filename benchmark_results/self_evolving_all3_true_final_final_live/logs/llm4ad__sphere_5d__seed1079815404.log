def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    pop_size = 10 * D
    mu = 1 / (2 * D)
    sigma_max = (ub - lb) * 3
    sigma_min = (ub - lb) / 100
    lambda_ = pop_size // 5
    chi = 1.05
    weights = np.ones(lambda_) / lambda_
    C = np.eye(D)

    x = rng.uniform(lb, ub, size=(pop_size, D))
    f = func(x)
    best_x = np.argmin(f)
    best_f = f[best_x]
    best_x = x[best_x]

    for i in range(budget):
        k = np.random.choice(lambda_, p=weights)
        delta_k = rng.normal(loc=0, scale=sigma_max, size=D)

        while True:
            x_new = x[k] + mu * (np.sqrt(C) @ delta_k) / np.linalg.norm(np.sqrt(C) @ delta_k)
            x_new = lb + (ub - lb) * rng.uniform(size=D)
            if lb <= x_new.all() <= ub:
                break

        f_new = func(x_new)

        alpha = f_new < best_f
        weights[k] *= 0.5 * alpha + 0.25

        if alpha:
            best_x, best_f = x_new, f_new
            x[best_x] = best_x
