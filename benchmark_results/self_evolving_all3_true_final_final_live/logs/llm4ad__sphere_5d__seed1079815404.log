def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    x = np.array([random.uniform(lb, ub) for _ in range(dim)])
    T = 1000.0
    alpha = 0.99

    best_x = x.copy()
    best_f = func(clip(x))

    for i in range(budget):
        y = clip(x + rng.normal(size=dim))
        delta = func(y) - func(clip(x))
        
        if delta < 0 or np.random.rand() < np.exp(-delta / T):
            x = y
            if func(clip(x)) < best_f:
                best_x = x.copy()
                best_f = func(clip(x))

        T *= alpha

    return best_x
