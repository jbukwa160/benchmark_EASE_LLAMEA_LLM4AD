def algorithm(func, dim, lb, ub, budget, rng):
    def accept(candidate, current, T):
        delta = func(candidate) - func(current)
        if delta < 0 or np.random.rand() < np.exp(-delta / T):
            return candidate
        else:
            return current

    def restart():
        return np.array([random.uniform(lb, ub) for _ in range(dim)])

    current = np.array([np.mean((lb + ub) / 2 * np.ones(dim)) for _ in range(dim)])
    best = np.copy(current)
    T = 1
    steps = 0

    while steps < budget:
        candidate = accept(np.clip(current + (ub - lb) * np.random.randn(dim), lb, ub), current, T)
        if func(candidate) < func(best):
            best = candidate
        current = candidate
        steps += 1

        if rng.uniform(0, 1) < 0.05 and steps > 100:
            current = restart()
            T *= 0.9
            steps = 0

    return np.array(best)
