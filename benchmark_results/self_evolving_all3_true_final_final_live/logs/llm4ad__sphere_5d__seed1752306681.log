def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    X = rng.uniform(lb, ub, (1, dim))
    mean = np.mean(X[0])
    sigma = 10.0
    c1 = 1.0 / dim

    for i in range(budget):
        Y = clip(X + rng.normal(0, sigma, (1, dim)))
        fY = func(Y)
        XY = clip(X + rng.normal(mean, sigma, (1, dim)))
        fXY = func(XY)

        if fY < fXY:
            X = Y
            mean = np.mean(X[0])
            sigma *= 0.9

    return X[0]
