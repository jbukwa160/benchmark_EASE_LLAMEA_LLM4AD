def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 1000.0
    cooling_rate = 0.99
    best_x = x.copy()
    best_fval = func(x)

    for _ in range(budget):
        v = np.clip(rng.normal(size=dim), lb, ub)
        u = rng.uniform(0, 1, size=dim) - 1

        y = x + u * (x - best_x) + T * (v - x)
        y = np.clip(y, lb, ub)

        y_fval = func(y)
        if y_fval < best_fval:
            best_x = y.copy()
            best_fval = y_fval

        T *= cooling_rate
        x = np.where(rng.uniform(size=dim) < 0.5, x, best_x)

    return best_x
