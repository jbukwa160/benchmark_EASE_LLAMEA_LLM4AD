def algorithm(func, dim, lb, ub, budget, rng):
    population_size = 1000
    sigma_init = 2.1 * (ub - lb) / np.sqrt(dim)
    lambda_ = int(population_size / 2)
    mu = lambda_
    weights = np.array([lambda_ + 5 - i for i in range(lambda_ + 1)]) / sum(lambda_ + 5 - i for i in range(lambda_ + 1))
    cum_weights = np.cumsum(weights)
    c1 = (4 + 2 * np.sqrt(2)) / (dim * lambda_)
    c_mu = 2 / ((dim + 3) ** 2)
    c_sigma = 0.1
    c_c = 2 / (np.sqrt(dim) + 1)
    pc = 0.5

    best_x = np.zeros(dim)
    best_f = float('inf')

    sigma = sigma_init
    t = 0

    while budget > 0 and not np.isclose(best_f, 0):
        z = rng.randn(lambda_, dim)

        y = mu * np.array([z[i] + np.sqrt(1 - c_c) * best_x for i in range(mu)])

        x_new = best_x + sigma * (np.dot(c1 * np.eye(dim), y.T) + np.dot((1 - c1) * cum_weights[:, None], z.T))

        f_new = func(x_new)

        budget -= 1

        if f_new < best_f:
            best_f = f_new
            best_x = x_new

        t += 1
        if t > 10 and np.isclose(best_f, 0):
            break

        y = (x_new - best_x) / sigma
        cov_y = np.dot(y[:, None], y[None, :]) / mu

        c_sigma = 2 * (c_sigma + c_mucov_y) ** 2

        sigma *= np.exp(c_sigma)
        cum_weights = np.cumsum(weights)

    return best_x
