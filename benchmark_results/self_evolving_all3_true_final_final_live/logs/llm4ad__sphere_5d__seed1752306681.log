def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = 5 * (ub - lb) * rng.rand(dim) + lb
    best_x = clip(x)
    best_f = func(best_x)

    for _ in range(budget-1):
        sigma = 0.2 * (ub - lb) / np.sqrt(np.sum((x - best_x)**2))
        candidates = []
        for _ in range(10*dim):
            v = rng.randn(dim)
            x_new = clip(x + sigma * v)
            candidates.append(x_new)
        f_values = [func(candidate) for candidate in candidates]
        best_candidate_idx = np.argmin(f_values)
        if f_values[best_candidate_idx] < best_f:
            best_x = candidates[best_candidate_idx]
            best_f = f_values[best_candidate_idx]

    return best_x
