def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.array([0.0] * dim)
    f_best = float('inf')
    population_size = 10
    population = [clip(rng.uniform(lb, ub, size=dim)) for _ in range(population_size)]

    for budget_used in range(budget):
        if rng.random() < 0.5:
            # Adaptively reduce population size
            population_size = max(1, int(np.floor(population_size * (1 - 0.05 * budget_used / budget))))

        f_values = [func(x) for x in population]
        idx_best = np.argmin(f_values)
        if f_values[idx_best] < f_best:
            f_best = f_values[idx_best]
            x_best = clip(population[idx_best])

        # Mutation
        mutation_strategies = ['rand1', 'best']
        strategy = rng.choice(mutation_strategies)

        if strategy == 'rand1':
            # Random-to-best/2 strategy
            c = 0.5 * (rng.uniform(lb, ub) + population[idx_best])
        elif strategy == 'best':
            # Best-to-best strategy
            c = x_best

        # Selection
        for i in range(population_size):
            if rng.random() < 0.1:
                # Randomly replace the best individual
                idx_replace = rng.choice([j for j in range(population_size) if j != idx_best])
                population[i] = clip(c + rng.uniform(-1, 1, size=dim))

        else:
            # Regular selection
            population[i] = clip(c + np.random.normal(size=dim)) if rng.random() < 0.5 else x_best

    return x_best
