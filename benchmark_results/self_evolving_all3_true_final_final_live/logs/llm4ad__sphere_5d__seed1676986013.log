def algorithm(func, dim, lb, ub, budget, rng):
    population_size = int(np.sqrt(budget))
    population = np.random.uniform(lb, ub, (population_size, dim))

    for _ in range(budget - 1):
        fitness = np.array([func(x) for x in population])
        sorted_indices = np.argsort(fitness)
        population = population[sorted_indices]

        crossover_points = rng.integers(0, dim, size=population_size)
        offspring = np.zeros((population_size, dim))
        for i in range(population_size):
            parent1 = population[i]
            parent2 = population[(i + 1) % population_size]
            for j in range(dim):
                if crossover_points[i] == j:
                    offspring[i, j] = (parent1[j] + parent2[j]) / 2
                else:
                    offspring[i, j] = parent1[j]

        mutation_prob = 0.01
        for i in range(population_size):
            if rng.random() < mutation_prob:
                idx = rng.integers(0, dim)
                population[i, idx] += rng.uniform(-1, 1)

        population[-1] = offspring[-1]
        population[:population_size - 1] = population[:-1]

    return population[0]
