def algorithm(func, dim, lb, ub, budget, rng):
    def sample(rng):
        return rng.uniform(lb, ub, size=dim)

    def clip(candidate):
        return np.minimum(np.maximum(candidate, lb), ub)

    def evaluate(candidate):
        return func(candidate)

    def adapt_cma(population, population_fitness):
        mean = np.mean(population, axis=0)
        cov = np.cov(population.T)
        sigma = 1.0
        for i in range(budget):
            candidates = np.random.multivariate_normal(mean, cov * sigma**2, size=len(population))
            clipped_candidates = clip(candidates)
            fitnesses = evaluate(clipped_candidates)
            population = np.concatenate((population, clipped_candidates), axis=0)
            population_fitness = np.concatenate((population_fitness, fitnesses), axis=0)
            if i % 10 == 0:
                best_candidate = population[np.argmin(population_fitness)]
                sigma *= 0.9
        return mean, cov

    population = [sample(rng) for _ in range(100)]
    population_fitness = [evaluate(candidate) for candidate in population]
    for i in range(budget):
        mean, cov = adapt_cma(population, population_fitness)
        candidates = np.random.multivariate_normal(mean, cov, size=len(population))
        clipped_candidates = clip(candidates)
        fitnesses = evaluate(clipped_candidates)
        population = np.concatenate((population, clipped_candidates), axis=0)
        population_fitness = np.concatenate((population_fitness, fitnesses), axis=0)

    best_candidate = population[np.argmin(population_fitness)]
    return best_candidate
