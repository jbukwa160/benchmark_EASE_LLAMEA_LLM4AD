def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def mutate(x1, x2, f, c):
        mutation_strategy = rng.choice(['rand/1/exp', 'best/1/exp'])
        if mutation_strategy == 'rand/1/exp':
            mutant = x1 + c * (x2 - x1) + np.random.exponential(0.5, dim)
        elif mutation_strategy == 'best/1/exp':
            mutant = x1 + c * (x_best - x1) + np.random.exponential(0.5, dim)

        return clip(mutant)

    def crossover(x1, mutant):
        crossover_probability = 0.5
        if rng.random() < crossover_probability:
            trial = mutant
        else:
            trial = x1

        return trial

    population_size = int(np.sqrt(budget))
    population = np.random.uniform(lb, ub, (population_size, dim))

    best_so_far = np.inf
    x_best = np.zeros(dim)

    for i in range(population_size):
        f_value = func(population[i])
        if f_value < best_so_far:
            best_so_far = f_value
            x_best = population[i]

    for _ in range(int(budget / population_size)):
        for i in range(population_size):
            r1, r2, _, _ = rng.randint(0, population_size, 4)
            c = rng.uniform(0.5, 1.5)

            mutant = mutate(population[r1], population[r2], func, c)
            trial = crossover(population[i], mutant)

            f_value = func(trial)
            if f_value < best_so_far:
                best_so_far = f_value
                x_best = trial

    return np.array([best_so_far])
