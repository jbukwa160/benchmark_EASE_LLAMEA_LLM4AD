def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    f_best = np.inf
    T = 10
    for t in range(budget):
        x_new = x_best + (ub - lb) * rng.uniform(size=dim)
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
        elif rng.rand() < np.exp(-(f_new - f_best) / T):
            f_best = f_new
            x_best = x_new
        T *= 0.99  # cooling schedule
    return x_best
