def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def crossover(parent1, parent2, F):
        u = rng.uniform(0, 1)
        if u < 0.5:
            child = parent1 + u * (parent2 - parent1)
        else:
            child = parent2 + u * (parent1 - parent2)
        return child

    def mutation(child, Cr, F):
        for i in range(dim):
            u = rng.uniform(0, 1)
            if u < Cr:
                child[i] += F * (rng.gauss(0, 1))
        return child

    def evaluate(x):
        return func(x)

    np.random.seed(rng)

    n_pop = 50
    n_gen = budget // n_pop

    pop = np.random.uniform(lb, ub, (n_pop, dim))

    best_solution = pop[0]
    best_value = evaluate(best_solution)

    for gen in range(n_gen):
        new_pop = np.zeros((n_pop, dim))
        for i in range(n_pop):
            child = crossover(pop[i], pop[(i-1)%n_pop, :], 0.5)
            child = mutation(child, 0.3, 0.8)
            child = clip(child, lb, ub)
            new_pop[i] = child
        new_best_solution = np.argmin([evaluate(x) for x in new_pop])
        if evaluate(new_pop[new_best_solution]) < best_value:
            best_solution = new_pop[new_best_solution]
            best_value = evaluate(best_solution)

    return best_solution
