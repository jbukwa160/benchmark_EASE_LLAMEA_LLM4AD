def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def generate_initial_population(dim, population_size, lb, ub, rng):
        return np.random.uniform(lb, ub, (population_size, dim))

    def differential_evolution(population, func, lb, ub, budget, rng):
        for _ in range(budget // 5):
            z = np.random.choice(population)
            u = np.random.choice(population)
            v = np.random.choice(population)
            c1 = rng.uniform(0, 2.38) / (dim ** 0.5 + 2.38)
            x_new = population[np.argmin([func(c1 * z + (1 - c1) * u)])]
            x_new = clip(x_new, lb, ub)
            population[np.argmin([func(c1 * z + (1 - c1) * u)])] = x_new
        return np.array([np.min(population, axis=0)])

    def simulated_annealing(population, func, lb, ub, budget, rng):
        T = 1000.0
        alpha = 0.99
        for _ in range(budget // 5):
            i = rng.choice(len(population))
            x_new = population[i] + np.random.uniform(-1, 1, dim)
            x_new = clip(x_new, lb, ub)
            delta = func(x_new) - func(population[i])
            if delta < 0 or rng.rand() < np.exp(-delta / T):
                population[i] = x_new
            T *= alpha
        return np.array([np.min(population, axis=0)])

    initial_population = generate_initial_population(dim, budget // 2, lb, ub, rng)
    best_solution_de = differential_evolution(initial_population, func, lb, ub, budget // 2, rng)
    best_solution_sa = simulated_annealing(initial_population, func, lb, ub, budget // 2, rng)

    return np.min([best_solution_de, best_solution_sa], axis=0)
