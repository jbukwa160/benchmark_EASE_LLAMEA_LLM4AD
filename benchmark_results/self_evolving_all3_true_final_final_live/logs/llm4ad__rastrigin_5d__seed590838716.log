def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    n_iter = 0
    pop_size = 50
    sigma = 1.5
    mu = np.random.uniform(lb, ub, size=dim)
    pop = np.random.uniform(lb, ub, size=(pop_size, dim))
    cov = np.eye(dim)
    best_x = None
    best_y = float('inf')

    while n_iter < budget:
        for _ in range(pop_size):
            z = np.dot(np.linalg.cholesky(cov), rng.randn(dim))
            x = mu + sigma * z
            y = evaluate(x)

            if y < best_y:
                best_x = x
                best_y = y

        n_iter += 1
        cov = (1 - 2/pop_size) * cov + np.outer((pop - mu), (pop - mu))
        sigma *= 0.97
        mu = np.mean(pop, axis=0)
        pop = np.clip(mu + rng.randn(pop.shape[0], dim)*sigma, lb, ub)

    return best_x
