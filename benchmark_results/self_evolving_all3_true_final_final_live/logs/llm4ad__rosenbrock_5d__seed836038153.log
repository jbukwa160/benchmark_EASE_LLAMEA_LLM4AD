def algorithm(func, dim, lb, ub, budget, rng):
    def func_candidate(x):
        x = np.clip(x, lb, ub)
        return func(x)

    # Simulated Annealing (SA) initial exploration
    sa_temperature = 1000.0
    n_sa_steps = int(budget * 0.1)
    x_sa = rng.uniform(lb, ub, size=dim)
    for _ in range(n_sa_steps):
        y = rng.uniform(lb, ub, size=dim)
        delta = func_candidate(y) - func_candidate(x_sa)
        if delta < 0 or np.random.rand() < np.exp(-delta / sa_temperature):
            x_sa = y
            sa_temperature *= 0.99

    # Particle Swarm Optimisation (PSO) exploitation
    n_particles = int(budget * 0.9 / dim)
    particle_size = dim + 1
    particles = rng.uniform(lb, ub, size=(n_particles, particle_size))
    best_particle = np.argmin([func_candidate(particle[:-1]) for particle in particles])
    for _ in range(n_particles):
        for i in range(dim):
            y = rng.normal(0, 0.1)
            delta = func_candidate(particles[best_particle, :i] + y * (particles[best_particle, i+1:] - particles[best_particle, :-1])) - func_candidate(particles[best_particle, :-1])
            if delta < 0 or np.random.rand() < np.exp(-delta):
                particles[best_particle, i] = y * (particles[best_particle, i+1:] - particles[best_particle, :-1]) + particles[best_particle, :-1]

    # Return the best solution found
    return np.argmin([func_candidate(particle[:-1]) for particle in particles], axis=0)
