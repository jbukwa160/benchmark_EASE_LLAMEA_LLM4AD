def algorithm(func, dim, lb, ub, budget, rng):
    X = np.array([np.random.uniform(lb[i], ub[i]) for i in range(dim)])
    
    for _ in range(budget):
        candidates = np.zeros((dim, len(X)))
        
        for j in range(len(X)):
            perturbation = 0.1 * (2 * rng.random((dim)) - 1)
            
            for i in range(dim):
                if rng.uniform(0, 1) < 0.5:
                    candidates[i, j] = X[i] + perturbation[i]
                else:
                    candidates[i, j] = X[i] - perturbation[i]
        
        candidates = np.clip(candidates, lb, ub)
        
        gradient_approximations = func(candidates) - func(X)
        
        step_size = 0.01 / (np.linalg.norm(perturbation) + 1e-7)
        
        for i in range(dim):
            X[i] -= step_size * perturbation[i] * gradient_approximations
        
    return np.clip(X, lb, ub)
