def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.minimum(np.maximum(candidate, lb), ub)

    def generate_initial_population(rng, dim, pop_size):
        return clip(rng.uniform(lb, ub, size=(pop_size, dim)))

    def evaluate(population, func, dim):
        return [func(individual) for individual in population]

    def differential_evolution(population, func, dim, lb, ub, f, cr, mutation_strategy):
        n_pop = len(population)
        for _ in range(budget // 2):
            differences = np.zeros((n_pop, dim))
            for i in range(n_pop):
                for j in range(dim):
                    a, b = np.random.choice(n_pop, replace=False, size=2)
                    if a != i:
                        differences[i, j] += (population[a, j] - population[b, j]) * f
                    else:
                        differences[i, j] += rng.uniform(-1, 1) * f
            new_population = np.zeros((n_pop, dim))
            for i in range(n_pop):
                r1, r2, r3 = np.random.choice(n_pop, replace=False, size=3)
                mutated_individual = population[r1] + cr * differences[i] + mutation_strategy * (population[r2] - 2 * population[r3])
                new_population[i] = clip(mutated_individual)
            population = new_population
        return evaluate(population, func, dim)

    def simulated_annealing(initial_population, func, dim, lb, ub, cooling_rate):
        current_temperature = 1.0
        for _ in range(budget // 2):
            current_solution = initial_population[np.argmin(evaluate(initial_population, func, dim))]
            current_fitness = func(current_solution)
            new_candidate = clip(rng.uniform(lb, ub, size=dim))
            new_fitness = func(new_candidate)
            if new_fitness < current_fitness:
                current_solution = new_candidate
                current_fitness = new_fitness
            else:
                delta = new_fitness - current_fitness
                if rng.random() < np.exp(-delta / current_temperature):
                    current_solution = new_candidate
                    current_fitness = new_fitness
            initial_population[np.argmin(evaluate(initial_population, func, dim))] = current_solution
            current_temperature *= 1 - cooling_rate
        return evaluate(initial_population, func, dim)

    f = 0.5
    cr = 0.7
    mutation_strategy = 0.2

    population = generate_initial_population(rng, dim, budget // 10)
    result = differential_evolution(population, func, dim, lb, ub, f, cr, mutation_strategy) + simulated_annealing(population, func, dim, lb, ub, 0.01)

    return clip(np.argmin(result))
