def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=(1, dim))
    for _ in range(budget):
        x_candidate = x_best + 0.1 * (ub - lb) * rng.normal(size=x_best.shape)
        x_candidate = np.clip(x_candidate, lb, ub)
        fitness_candidate = func(x_candidate)
        if fitness_candidate < func(x_best):
            x_best = x_candidate
    return x_best
