def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    x = rng.uniform(lb, ub, size=(dim,))
    T = 1000.0
    alpha = 0.99

    for _ in range(budget):
        candidate = clip(x + 0.1 * rng.normal(size=x.shape))
        delta = func(candidate) - func(x)
        if delta < 0:
            x = candidate
        elif np.random.rand() < np.exp(-delta / T):
            x = candidate
        T *= alpha

    return clip(x)
