def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def sample_gaussian(mean, sigma):
        return mean + sigma * rng.normal(size=(dim,))

    def polynomial_mutation(x, p_c):
        x_mut = np.where(rng.uniform(size=(dim,)) < p_c,
                         2*x + rng.uniform(size=(dim)) - 1,
                         x)
        return clip(x_mut)

    def cma_es():
        lambda_ = int(np.sqrt(budget))
        mean = sample_gaussian(np.zeros(dim), 5.0)
        sigma = 5.0
        p_c = 1 / (2 * dim + 1)

        for _ in range(lambda_):
            offspring = np.array([polynomial_mutation(mean, p_c) for _ in range(lambda_)])
            f_offspring = func(clip(offspring))
            idx_best = np.argmin(f_offspring)
            mean = clip(offspring[idx_best])
            sigma *= 1 + (f_offspring.max() - f_offspring.min()) / budget

    cma_es()
    return mean
