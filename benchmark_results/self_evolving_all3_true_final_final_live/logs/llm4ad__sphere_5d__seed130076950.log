def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    simplex = np.random.rand(4, dim) * (ub - lb) + lb
    for _ in range(budget):
        centroid = np.mean(simplex, axis=0)
        triangles = [(simplex[1], simplex[2], centroid), 
                     (simplex[3], simplex[0], centroid),
                     (simplex[1], simplex[3], centroid)]
        
        new_triangles = []
        for t in triangles:
            x = 2 * clip(t[0]) - clip(t[1])
            new_triangles.append((t[0], x))
            
            y = 2 * clip(t[1]) - clip(t[2])
            new_triangles.append((x, y))
        
        simplex = np.vstack(new_triangles)
        
    return clip(np.mean(simplex, axis=0))
