def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = x + 0.5 * (ub - lb) * rng.normal(size=dim)
        z = np.clip(y, lb, ub)
        f_z = func(z)

        if f_z < best_f:
            best_x = z.copy()
            best_f = f_z

        r1, r2, r3 = rng.choice(dim, size=3, replace=False)
        if rng.random() < 0.5:
            qbf_idx = np.argmax(np.abs(x[r1] - x[r2]) + np.abs(x[r2] - x[r3]))
            y[qbf_idx] += 0.05 * (ub - lb) * rng.choice([-1, 1])
            z[qbf_idx] = np.clip(y[qbf_idx], lb, ub)
            f_z = func(z)

        if f_z < best_f:
            best_x = z.copy()
            best_f = f_z

    return best_x
