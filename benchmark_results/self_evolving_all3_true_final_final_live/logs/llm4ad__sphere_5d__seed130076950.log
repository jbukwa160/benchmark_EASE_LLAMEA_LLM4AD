def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    sigma = 1.0
    c_m = 1.0
    lambda_ = 10
    x_best = x.copy()
    f_best = func(x)

    for _ in range(budget):
        y = np.random.randn(dim) * sigma + x
        y = np.clip(y, lb, ub)
        fy = func(y)
        
        if fy < f_best:
            x_best = y.copy()
            f_best = fy

        z = (y - x) / sigma
        c1 = 1.0 / (1 + np.sum(z**2))
        s = np.sqrt(c1 * c_m)
        delta_x = np.random.randn(dim) * s
        delta_x = np.clip(delta_x, -1, 1)
        
        x += delta_x

    return x_best
