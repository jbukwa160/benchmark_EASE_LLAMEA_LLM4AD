def algorithm(func, dim, lb, ub, budget, rng):
    n = len(rng.uniform(lb, ub, size=(dim,)))
    best_x = n.copy()
    best_f = func(n)
    
    def acceptance_probability(new_f, current_f, T):
        return np.exp((current_f - new_f) / T)

    T = 1.0
    while budget > 0:
        x_new = n + rng.normal(size=(dim,))
        
        # Clip to bounds
        for i in range(dim):
            if x_new[i] < lb or x_new[i] > ub:
                x_new[i] = np.clip(x_new[i], lb, ub)
        
        f_new = func(x_new)
        
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new
        
        if rng.random() < min(1.0, acceptance_probability(best_f, f_new, T)):
            n = x_new.copy()
        
        budget -= 1
        T *= 0.99  # cooling schedule
        
        if np.isnan(func(n)):
            return best_x
        
    return best_x
