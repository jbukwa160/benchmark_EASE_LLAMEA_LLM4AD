def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 1
    alpha = 0.99
    t = 0
    best_x = x.copy()
    while t < budget:
        new_x = best_x + np.random.normal(size=dim) * 0.01
        new_x = np.clip(new_x, lb, ub)
        delta = func(best_x) - func(new_x)
        if delta <= 0 or rng.rand() <= np.exp(-delta / T):
            best_x = new_x.copy()
        T *= alpha
        t += 1
    return best_x
