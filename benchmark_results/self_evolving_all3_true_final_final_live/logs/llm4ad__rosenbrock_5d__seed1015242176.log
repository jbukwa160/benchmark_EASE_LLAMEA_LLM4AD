def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x0 = np.random.uniform(lb, ub, size=dim)
    best_x = clip(x0)
    best_f = func(best_x)

    for _ in range(budget):
        x1 = clip(best_x + rng * (ub - lb) * np.random.randn(dim))
        f1 = func(x1)
        
        if f1 < best_f:
            best_x, best_f = x1, f1

        u, v, w = rng.choice([True, False], size=dim, p=[0.5, 0.5])
        simplex_x = [clip(np.array(best_x) + (u * (ub - lb) * np.random.randn(dim)))]
        for _ in range(4):
            x2 = clip(simplex_x[-1] + (v * (ub - lb) * np.random.randn(dim)))
            f2 = func(x2)
            if f2 < simplex_x[-1][-1]:
                simplex_x.append(x2)

        simplex_x.sort(key=lambda x: func(clip(x)))

        for i in range(4):
            u, v = rng.choice([True, False], size=dim, p=[0.5, 0.5])
            x3 = clip(simplex_x[i] + (v * (ub - lb) * np.random.randn(dim)))
            f3 = func(x3)
            if f3 < simplex_x[-1][-1]:
                simplex_x[-1], simplex_x[-2] = simplex_x[-2], x3

        best_f = min(func(clip(x)) for x in simplex_x)

    return best_x
