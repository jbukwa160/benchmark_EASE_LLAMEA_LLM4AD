def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)
    step_size = 0.5 * (ub - lb) / 2.0
    for _ in range(budget):
        s = np.zeros(dim)
        for i in range(dim):
            s[i] = rng.uniform(-step_size, step_size)
        x_new = x + s
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new
        success_rate = 1.0 * (best_f - f_new) / abs(best_f)
        step_size *= np.power(2.0, success_rate)
        step_size = max(step_size, 0.0001 * (ub - lb))
        x = x_new.copy()
    return best_x
