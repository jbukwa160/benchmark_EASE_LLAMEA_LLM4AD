def algorithm(func, dim, lb, ub, budget, rng):
    def get_random_candidate(lb, ub, rng):
        return [rng.uniform(lb[i], ub[i]) for i in range(dim)]

    def clip(candidate, lb, ub):
        return [max(lb[i], min(ub[i], candidate[i])) for i in range(dim)]

    n_pop = 50
    alpha = 0.5
    f_min = 1e+10
    pop = [[get_random_candidate(lb, ub, rng) for _ in range(n_pop)] for _ in range(budget)]
    
    for t in range(1, budget):
        candidates = []
        
        # Selection step
        for i in range(n_pop):
            x = pop[t-1][i]
            best_x = np.array(pop[t-1][np.argmin([func(x_) for x_ in pop[t-1]])])
            
            if func(x) < f_min:
                f_min = func(x)
                best_individual = i
                
            candidates.append(clip(np.array(x) + alpha * (best_x - np.array(x)) + rng.uniform(-0.5, 0.5), lb, ub))
        
        # Local Search step
        for i in range(n_pop):
            x = pop[t-1][i]
            
            for _ in range(50):
                best_x = np.array(pop[t-1][np.argmin([func(x_) for x_ in pop[t-1]])])
                
                if func(np.array(x) + 0.01 * (best_x - np.array(x))) < func(np.array(x)):
                    x = np.array(x) + 0.01 * (best_x - np.array(x))
                else:
                    break
            
            candidates[i] = clip(x, lb, ub)
        
        # Update population
        pop[t] = candidates
    
    return clip(pop[budget-1][np.argmin([func(x_) for x_ in pop[budget-1]])], lb, ub)
