def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def objective(x):
        return func(x)

    pop_size = 50
    x0 = (ub - lb) * rng.uniform(size=(pop_size, dim)) + lb

    for _ in range(budget):
        x_new = np.zeros((pop_size, dim))
        for i in range(pop_size):
            r1, r2, r3 = rng.choice(range(pop_size), replace=False, size=3)
            mutation = 0.5 * (x0[r1] - x0[r2]) + 0.5 * (x0[r3] - x0[r1])
            mutation *= np.sin(np.pi / 4) * (ub - lb)
            x_new[i] = clip(x0[i] + mutation)

        # Select the best solution among current population and new population
        fitness_current = [objective(clip(x)) for x in x0]
        fitness_new = [objective(clip(x)) for x in x_new]

        x0 = np.array([x if f_new < f_cur else x_old for x, f_new, f_cur, x_old in zip(x_new.T,
                                                                                       fitness_new,
                                                                                       fitness_current,
                                                                                       x0.T)])

    # Return the best solution found
    return clip(np.min(np.argmin(objective(clip(x)) for x in x0)))
