def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_init(dim, lb, ub):
        return lb + (ub - lb) * rng.normal(size=dim)

    def sa_search(x0, func, dim, lb, ub, T0, alpha, steps_per_T):
        x = np.copy(x0)
        T = T0
        for _ in range(steps_per_T):
            y = gaussian_init(dim, lb, ub)
            dy = func(y) - func(x)
            if rng.random() < np.exp(-dy / T):
                x = y
            T *= alpha
        return x

    def local_search(x, func, dim, lb, ub, steps):
        for _ in range(steps):
            d = gaussian_init(dim, lb, ub) - x
            dx = func(x + 0.01 * d) - func(x)
            if rng.random() < np.exp(-dx / (1e-6)):
                x += 0.01 * d
        return x

    # Initialize the current best solution
    x_best = gaussian_init(dim, lb, ub)

    # Simulated Annealing search
    T0 = 1000
    alpha = 0.99
    steps_per_T = budget // 10
    for _ in range(budget):
        x_current = sa_search(x_best, func, dim, lb, ub, T0, alpha, steps_per_T)
        if func(x_current) < func(x_best):
            x_best = x_current

    # Local search refinement
    local_steps = 100
    for _ in range(local_steps):
        x_best = local_search(x_best, func, dim, lb, ub, 10)

    return np.clip(x_best, lb, ub)
