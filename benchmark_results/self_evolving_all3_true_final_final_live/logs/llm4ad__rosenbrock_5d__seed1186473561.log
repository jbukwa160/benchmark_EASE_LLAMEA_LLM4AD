def algorithm(func, dim, lb, ub, budget, rng):
    def sample(bounds):
        return np.array([rng.uniform(lb[i], ub[i]) for i in range(dim)])

    def evaluate(x, func=func):
        return func(x)

    best_x = None
    best_f = np.inf

    X = [sample((lb, ub))]
    y = [evaluate(X[0])]

    for _ in range(budget - 1):
        mu = np.mean(y)
        sigma = np.std(y) if np.std(y) > 1e-4 else 1e-4
        dist = truncnorm(loc=mu, scale=sigma, a=-np.inf, b=np.inf)

        mean, var = norm.pdf(X[-1], loc=mu, scale=sigma), sigma**2
        acq = np.max(dist.rvs(size=dim))

        for _ in range(10):
            x_new = X[-1] + 0.5 * np.random.normal(loc=np.zeros(dim), scale=[acq]*dim)
            x_new = np.clip(x_new, lb, ub)

            fx_new = evaluate(x_new)
            if fx_new < best_f:
                best_x, best_f = x_new, fx_new

            X.append(x_new)
            y.append(fx_new)

    return np.array([best_x])
