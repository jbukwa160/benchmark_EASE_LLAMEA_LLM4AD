def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    x = np.random.uniform(lb, ub, size=(n,))
    sigma = 1.0
    mu = 0.5
    c1 = 1.0 / (n + 1)
    c2 = 1.0 / (np.sqrt(n) * (n + 1))
    damps = (n + 1) ** 2
    p = np.zeros((n,))
    pcov = np.eye(n)

    for _ in range(budget):
        x_new = x + sigma * rng.normal(size=(n,))
        
        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        
        if f_new < func(x):
            x = x_new
            p = (1 - c1) * p + c2 * rng.normal(size=(n,))
            pcov = (1 - c1) ** 2 * pcov + c2 ** 2 * np.eye(n)

    return x
