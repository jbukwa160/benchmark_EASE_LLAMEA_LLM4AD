def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidates, lb, ub):
        return np.clip(candidates, lb, ub)

    def objective(x):
        return func(x)

    x0 = np.random.uniform(lb, ub, size=(dim,))
    best_x = x0
    best_f = objective(best_x)
    
    T = 1.0
    alpha = 0.99
    
    for _ in range(budget):
        if rng.random() < 0.5:
            # Simulated Annealing
            y = np.copy(x0)
            delta = np.zeros_like(y)
            for i in range(dim):
                sigma = T * np.sqrt(np.log(_ + 1) / (_ + 1))
                delta[i] = rng.normal(0, sigma)
                y[i] += delta[i]
            y = clip(y, lb, ub)
            f = objective(y)
            if f < best_f:
                x0 = y
                best_x = y
                best_f = f
            T *= alpha
        else:
            # Differential Evolution
            v1 = np.copy(x0) + rng.uniform(0, 1, size=(dim,))
            v2 = np.copy(x0) + rng.uniform(0, 1, size=(dim,))
            v3 = (v1 - x0) / 2 + (v2 - x0) / 2
            p = rng.uniform(0, 1)
            x = x0 + p * v3
            x = clip(x, lb, ub)
            f = objective(x)
            if f < best_f:
                x0 = x
                best_x = x
                best_f = f
    
    return best_x
