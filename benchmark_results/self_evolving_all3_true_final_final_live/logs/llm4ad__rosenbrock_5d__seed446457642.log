def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_candidate(best, sigma):
        return best + sigma * (ub - lb) * rng.randn(dim)

    def accept_new(candidate, best, temperature):
        if func(candidate) < func(best):
            return candidate
        elif rng.rand() < np.exp((func(best) - func(candidate)) / temperature):
            return candidate
        else:
            return best

    best = clip(rng.uniform(lb, ub, size=dim))
    temperature = 1.0

    for _ in range(budget):
        new_candidate = generate_candidate(best, rng.rand())
        new_candidate = clip(new_candidate)
        
        if func(new_candidate) < func(best):
            best = new_candidate
        
        # perform grid search around promising region
        if func(best) < ub**dim:
            step_size = (ub - lb) / budget
            for i in range(dim):
                candidate_i = best.copy()
                candidate_i[i] += step_size * rng.choice([-1, 1])
                candidate_i = clip(candidate_i)
                new_candidate = accept_new(candidate_i, best, temperature)
                if func(new_candidate) < func(best):
                    best = new_candidate
        
        # decrease temperature
        temperature *= 0.99

    return best
