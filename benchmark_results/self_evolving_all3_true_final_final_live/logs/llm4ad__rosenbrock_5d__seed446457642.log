def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_value = evaluate(best_x)
    current_temperature = 1.0
    learning_rate = 0.01

    for _ in range(budget):
        new_x = clip(x + np.random.normal(0, 0.5, size=dim), lb, ub)
        new_value = evaluate(new_x)

        if new_value < best_value:
            best_x = new_x.copy()
            best_value = new_value

        delta = new_value - best_value
        probability = np.exp(-delta / current_temperature)

        if rng.random() < probability:
            x = new_x.copy()

        current_temperature *= 1 - learning_rate
        if current_temperature < 1e-6:
            break

    return best_x
