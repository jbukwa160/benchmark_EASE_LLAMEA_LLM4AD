def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x), len(x) * [0]  # dummy gradient for Rosenbrock function

    n = 1
    while True:
        pop_size = int(np.sqrt(budget / (n**2)))
        if pop_size == 0:
            break

        mean = np.random.uniform(lb, ub, size=dim)
        sigma = 10
        pop = np.array([mean + rng.normal(0, sigma, size=dim) for _ in range(pop_size)])

        min_loss, _ = evaluate(pop)
        while True:
            if n > budget:
                break

            new_pop = []
            for x in pop:
                loss, grad = evaluate(x)
                new_x = mean + rng.normal(0, sigma * 1.1, size=dim) + np.random.choice([-1, 1], size=dim, p=[0.2, 0.8]) * sigma
                new_pop.append(new_x)

            pop = np.array(new_pop)
            _, grad = evaluate(pop)

            mean = mean + (np.dot(grad.T, pop - mean) / (pop_size * len(pop[0])))
            n += 1

        min_loss, _ = evaluate(mean)
        if min_loss < 10**-6:
            break
