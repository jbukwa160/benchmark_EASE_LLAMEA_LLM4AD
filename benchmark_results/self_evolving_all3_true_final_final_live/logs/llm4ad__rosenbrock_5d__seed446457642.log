def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    mu = 1.0 / (n * np.sqrt(rng))
    sigma = 5.0
    D = 10.0 + n
    C = np.eye(n) + 1 / (D - 1) * np.ones((n, n))
    pc = np.linalg.inv(C)
    x = rng.uniform(lb, ub, size=n)
    y = x.copy()
    best_x = x.copy()

    for _ in range(budget):
        z = rng.normal(size=n)
        v = np.dot(pc, z) * sigma
        x_new = y + v
        clip_x_new = np.clip(x_new, lb, ub)

        if func(clip_x_new) < func(best_x):
            best_x = clip_x_new

        y = 0.5 * (y + x_new)
        C = 0.1 * (np.eye(n) + D / (D - 2) * np.ones((n, n)) +
                   (x_new - y).reshape(-1, 1) @ (x_new - y).reshape(1, -1))
        pc = np.linalg.inv(C)

    return best_x
