def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (1, dim))
    sigma = 10
    c1 = 0.5 / (dim + 2)
    c3 = 0.667 / (dim + 2)
    lambda_ = 4 * dim + 5
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = np.random.normal(size=(lambda_, dim))
        z = x + sigma * np.exp(c1) * c3 * y

        # Clip candidates to [lb, ub]
        z = np.clip(z, lb, ub)

        f = func(z)
        if f < best_f:
            best_x = z.copy()
            best_f = f

        x = (lambda_ - 1) / lambda_ * x + (2 / lambda_) * best_x
        x += (1 / lambda_) * np.sum(z, axis=0)

    return best_x
