def algorithm(func, dim, lb, ub, budget, rng):
    def fitness(x):
        return func(x)

    x0 = (ub - lb) * rng.rand(dim) + lb
    best_x = x0.copy()
    best_f = fitness(best_x)
    
    for _ in range(budget):
        y = best_x + 0.5 * (rng.randn(dim) - 0.5) * (ub - lb)
        
        # clip candidate to bounds
        y = np.clip(y, lb, ub)
        
        z = best_x + rng.rand(dim) * (ub - lb)
        z = np.clip(z, lb, ub)

        v1 = fitness(best_x)
        v2 = fitness(y)
        v3 = fitness(z)

        if v2 < v1 and v2 < v3:
            best_f = v2
            best_x = y.copy()
        elif v3 < v1 and v3 < v2:
            best_f = v3
            best_x = z.copy()

    return best_x
