def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    D = len(dim)
    pop_size = 50
    N = int(budget / (D + 1))

    x0 = [np.random.uniform(lb[i], ub[i]) for i in range(D)]
    population = [[x0] * pop_size]
    fitness = [[func(x) for x in population[0]]]

    for _ in range(N):
        for i in range(pop_size):
            x1, x2, x3 = [population[-1][i] for j in range(3)]
            u = np.random.uniform(-1, 1, D)
            v = rng.uniform(0, 1)
            trial = clip([x1 + u[i] if v < 0.5 else x2 + u[i] for i in range(D)], lb, ub)

            f_trial = func(trial)
            population.append([population[-1][i] for i in range(pop_size)])
            fitness.append([func(x) for x in population[-1]])

            if f_trial < fitness[-1][i]:
                population[-1][i] = trial
                fitness[-1][i] = f_trial

    return np.array(min(fitness[-1], key=lambda x:x))
