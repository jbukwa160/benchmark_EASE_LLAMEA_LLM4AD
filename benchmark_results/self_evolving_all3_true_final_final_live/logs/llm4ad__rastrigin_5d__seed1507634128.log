def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    x = np.zeros(dim)
    best_x = x.copy()
    best_f = func(x)
    
    T = 10.0
    sigma = 1e-2
    
    for _ in range(budget):
        while True:
            if rng.random() < np.exp(-(func(clip(x + rng.uniform(-sigma, sigma, dim))) - best_f) / T):
                x = clip(x + rng.uniform(-sigma, sigma, dim))
                if func(x) < best_f:
                    best_x = x.copy()
                    best_f = func(x)
                break
            else:
                x = clip(best_x + rng.uniform(-1, 1, dim))
                T *= 0.99
        
        T *= 0.9999
    
    return best_x
