def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    x = rng.uniform(lb, ub, size=dim)
    c = 1 / (budget ** (1.0 / (2 * dim)))
    sigma = 1
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        while True:
            z = rng.normal(size=dim) * np.sqrt(sigma)
            y = clip(x + c * z)
            f = func(y)

            if f < best_f or (f == best_f and rng.rand() < 0.1):
                x = y.copy()
                best_x = x.copy()
                best_f = f

                sigma *= 1 + 0.1 * np.sum(z ** 2)
                c *= 1 - 0.01 / (budget - i)

                break
            elif rng.rand() < 0.5:
                z = rng.normal(size=dim) * np.sqrt(sigma)
                y = clip(x + c * z)

    return best_x
