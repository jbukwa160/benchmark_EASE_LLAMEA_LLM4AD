def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    t_max = int(budget / pop_size)
    
    for i in range(t_max):
        theta = (ub - lb) * np.random.rand(pop_size, dim)
        p_best = np.zeros((pop_size, dim))
        
        for j in range(pop_size):
            candidate = theta[j]
            candidate[0] += rng.trunc(1., 5.)
            
            while not np.all(lb <= candidate <= ub):
                idx = np.random.randint(0, dim)
                if candidate[idx] < lb[idx]:
                    candidate[idx] = lb[idx] + (ub[idx] - lb[idx]) * rng.uniform(0., 1.)
                elif candidate[idx] > ub[idx]:
                    candidate[idx] = ub[idx] - (ub[idx] - lb[idx]) * rng.uniform(0., 1.)
            
            f_candidate = func(candidate)
            if i == 0 or f_candidate < func(p_best[j]):
                p_best[j] = candidate
                best_f = f_candidate
        
        # Differential evolution step
        new_theta = np.copy(theta)
        
        for j in range(pop_size):
            idx1, idx2, idx3 = rng.choice(range(pop_size), 3, replace=False)
            
            if rng.trunc(0., 1.) < 0.5:
                u = (ub - lb) * rng.rand(dim)
                new_theta[j] = p_best[idx1] + u * np.sqrt(np.abs(func(p_best[idx2]) - func(p_best[idx3])))
            else:
                v = np.random.normal(0., 1., dim)
                new_theta[j] = p_best[idx1] + v * (p_best[idx2] - p_best[idx3])
            
        # Simulated annealing step
        T = 100. / (i + 1.)
        
        for j in range(pop_size):
            candidate = np.copy(new_theta[j])
            
            while not np.all(lb <= candidate <= ub):
                idx = np.random.randint(0, dim)
                if candidate[idx] < lb[idx]:
                    candidate[idx] = lb[idx] + (ub[idx] - lb[idx]) * rng.uniform(0., 1.)
                elif candidate[idx] > ub[idx]:
                    candidate[idx] = ub[idx] - (ub[idx] - lb[idx]) * rng.uniform(0., 1.)
            
            f_candidate = func(candidate)
            
            if i == 0 or np.exp(-(f_candidate - best_f) / T) < rng.trunc(0., 1.):
                new_theta[j] = candidate
        
        theta = new_theta
    
    # Fine-tuning step
    candidate = (ub + lb) / 2.
    
    while not np.all(lb <= candidate <= ub):
        idx = np.random.randint(0, dim)
        if candidate[idx] < lb[idx]:
            candidate[idx] = lb[idx] + (ub[idx] - lb[idx]) * rng.uniform(0., 1.)
        elif candidate[idx] > ub[idx]:
            candidate[idx] = ub[idx] - (ub[idx] - lb[idx]) * rng.uniform(0., 1.)
    
    f_candidate = func(candidate)
    
    return np.atleast_1d(np.array([candidate]))
