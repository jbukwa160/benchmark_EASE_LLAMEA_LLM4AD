def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(candidate):
        return func(candidate)

    x = rng.uniform(lb, ub, (1, dim))
    T = 10 * (ub - lb)
    alpha = 0.9
    beta = 2

    for _ in range(budget):
        v = clip(rng.normal(size=(1, dim)))
        u = clip(x + 0.5*v)

        if rng.random() < np.exp(-evaluate(clip(u)) / T):
            x = u

        T *= alpha

        y = clip(x + (rng.uniform(-1, 1) * v))
        z = clip(y + beta*(u - y))

        if evaluate(z) < evaluate(u):
            x = z
        elif rng.random() < np.exp((evaluate(u) - evaluate(z)) / T):
            x = u

    return x
