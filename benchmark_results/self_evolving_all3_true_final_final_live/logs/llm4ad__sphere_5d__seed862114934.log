def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_candidate(dim, lb, ub):
        return (ub - lb) * rng.rand(dim) + lb

    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def candidate_fitness(candidate):
        return func(candidate)

    current_candidate = generate_initial_candidate(dim, lb, ub)
    best_candidate = current_candidate.copy()
    initial_temperature = 1.0
    cooling_rate = 0.99

    for i in range(budget):
        new_candidate = current_candidate + (ub - lb) * rng.randn(dim)
        new_candidate = clip(new_candidate, lb, ub)

        delta_fitness = candidate_fitness(new_candidate) - candidate_fitness(current_candidate)
        if delta_fitness < 0 or np.random.rand() < np.exp(-delta_fitness / initial_temperature):
            current_candidate = new_candidate
        else:
            if rng.rand() < 0.1 and i > budget * 0.8: # 10% chance to accept worse candidate in last 20% of iterations
                current_candidate = new_candidate

        if candidate_fitness(current_candidate) < candidate_fitness(best_candidate):
            best_candidate = current_candidate.copy()

        initial_temperature *= cooling_rate

    return best_candidate
