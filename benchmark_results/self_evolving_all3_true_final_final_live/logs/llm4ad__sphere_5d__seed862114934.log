def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        step_size = 1.0 / (np.sqrt(_ + 2) * rng.uniform(0.1, 1))
        new_x = np.clip(x + step_size * rng.normal(size=dim), lb, ub)
        
        if func(new_x) < best_f:
            x = new_x
            best_f = func(x)

    return x
