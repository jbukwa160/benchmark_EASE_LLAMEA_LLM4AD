def algorithm(func, dim, lb, ub, budget, rng):
    def uniform_distribution(lb, ub, size):
        return rng.uniform(size=(size, dim)) * (ub - lb) + lb

    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def compute_fitness(x):
        return func(x)

    population_size = 100
    step_size = 0.5
    sigma = np.ones((population_size,))
    weights = np.ones(population_size) / population_size

    for _ in range(budget):
        candidates = uniform_distribution(lb, ub, population_size)
        
        clipped_candidates = clip(candidates, lb, ub)

        fitnesses = compute_fitness(clipped_candidates)

        argmin_idx = np.argmin(fitnesses)
        sigma[argmin_idx] *= 0.99

        for i in range(population_size):
            if rng.random() < 0.5:
                step = rng.uniform(-step_size, step_size) * sigma[i]
                candidates[i] += step
                clipped_candidates[i] = clip(candidates[i], lb, ub)

        fitnesses = compute_fitness(clipped_candidates)
        
        weights = np.exp(-fitnesses / (2 * sigma**2))
        weights /= np.sum(weights)

    best_candidate = clipped_candidates[np.argmax(fitnesses)]
    
    return best_candidate
