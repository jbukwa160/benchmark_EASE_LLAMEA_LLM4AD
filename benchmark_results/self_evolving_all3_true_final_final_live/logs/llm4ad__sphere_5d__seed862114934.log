def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    best_x = np.zeros(dim)
    best_f = float('inf')

    for _ in range(budget):
        x = np.random.uniform(lb, ub, size=dim)
        y = np.random.normal(size=dim)

        trial_x = clip_candidate(x + 0.1 * y / np.linalg.norm(y))

        if func(trial_x) < best_f:
            best_x = trial_x
            best_f = func(best_x)

    return best_x
