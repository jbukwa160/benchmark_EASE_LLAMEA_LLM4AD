def algorithm(func, dim, lb, ub, budget, rng):
    best_x = rng.uniform(lb, ub, size=dim)
    best_f = func(best_x)
    
    for _ in range(budget):
        sigma = 0.1 + (ub - lb) / 2
        step_size = np.sqrt(1 / (sigma**2 * rng.gamma(3.5)))
        
        x = best_x + step_size * rng.randn(dim)
        x = np.clip(x, lb, ub)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
    
    return best_x
