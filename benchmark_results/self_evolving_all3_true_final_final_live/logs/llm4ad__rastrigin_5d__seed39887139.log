def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x_best = np.zeros(dim)
    y_best = func(x_best)

    for _ in range(budget):
        # Generate a random population
        population = np.random.uniform(lb, ub, size=(dim+1, dim))

        # Evaluate the objective function at each candidate
        y_population = [func(clip(candidate)) for candidate in population]

        # Select the best solution from the current population
        idx_best = np.argmin(y_population)
        x_current = clip(population[idx_best])
        y_current = y_population[idx_best]

        # Update the global best solution found so far
        if y_current < y_best:
            x_best = x_current.copy()
            y_best = y_current

        # Differential Evolution step
        for i in range(1, dim+1):
            idx_p1 = np.random.choice(dim+1, size=i)
            p1 = population[idx_p1]
            v_new = (p1[0] - 2 * p1[1]) + (p1[i-1] - 2 * p1[-1])
            v_new = clip(v_new)

        # Simulated Annealing step
        T = rng.uniform(0.01, 10)
        alpha = 0.99

        while True:
            if np.random.rand() < np.exp((y_best - y_current) / T):
                x_current = x_best.copy()
                y_current = y_best
            else:
                idx_p1 = np.random.choice(dim+1, size=i)
                p1 = population[idx_p1]
                v_new = (p1[0] - 2 * p1[1]) + (p1[i-1] - 2 * p1[-1])
                v_new = clip(v_new)

            T *= alpha

            if y_current < y_best:
                x_best = x_current.copy()
                y_best = y_current
            elif np.random.rand() > np.exp((y_best - y_current) / T):
                break

    return x_best
