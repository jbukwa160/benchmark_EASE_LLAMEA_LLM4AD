def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    t = 1.0
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(1, budget + 1):
        y = clip(best_x + 0.5 * (rng.normal(size=dim) - rng.uniform(lb, ub, size=dim)))
        f_y = func(y)
        
        if f_y < best_f:
            best_f = f_y
            best_x = y
            
        if rng.rand() < np.exp((best_f - f_y) / t):
            x = y
        
        t *= 0.99  # cooling schedule
    
    return best_x
