def algorithm(func, dim, lb, ub, budget, rng):
    def clipped_candidate(bounds, candidate):
        return np.clip(candidate, bounds[0], bounds[1])

    def simulated_annealing(bounds, func, T=1000, cooling_rate=0.99):
        x = np.zeros(dim)
        best_x = x
        best_func_value = float('inf')
        
        for _ in range(budget):
            if rng.random() < 0.5:
                # Local search: perturb current solution with small step size
                delta = rng.uniform(-1, 1, dim) / 10
                new_x = x + delta
                new_func_value = func(new_x)
                
                if new_func_value <= best_func_value and new_func_value < func(x):
                    x = new_x
                    best_x = new_x
                    best_func_value = new_func_value
                    
            else:
                # Global search: perturb current solution with larger step size
                delta = rng.uniform(-5, 5, dim)
                new_x = clipped_candidate(bounds, x + delta)
                new_func_value = func(new_x)
                
                if new_func_value < best_func_value and new_func_value <= func(x):
                    x = new_x
                    best_x = new_x
                    best_func_value = new_func_value
                    
            # Adaptive cooling schedule: reduce temperature based on improvement
            T *= (1 - 0.001 * (best_func_value - func(x)) ** 2)
            
        return clipped_candidate(bounds, best_x)

    x = simulated_annealing((lb, ub), func)
    return x
