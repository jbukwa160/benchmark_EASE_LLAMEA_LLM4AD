def algorithm(func, dim, lb, ub, budget, rng):
    x_best = (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_candidate = x_best.copy()
        for i in range(dim):
            step_size = 0.1
            if rng.rand() < 0.5:
                x_candidate[i] = np.clip(x_candidate[i] + step_size, lb, ub)
            else:
                x_candidate[i] = np.clip(x_candidate[i] - step_size, lb, ub)

        f_candidate = func(x_candidate)
        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate

    return x_best
