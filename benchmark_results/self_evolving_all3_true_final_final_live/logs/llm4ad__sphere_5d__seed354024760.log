def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_gen = budget
    sigma = 1.0
    mu = (ub + lb) / 2 * np.ones(D)
    C = np.eye(D)

    for gen in range(n_gen):
        offspring_population = generate_offspring(mu, C, sigma, rng, lb, ub, D)
        fitness_values = func(offspring_population)
        
        new_mu, C = update_parameters(fitness_values, mu, C, sigma, D)
        
        if np.any(np.isnan(new_mu)):
            break

    best_solution = new_mu[np.argmin(func(new_mu))]
    return best_solution
