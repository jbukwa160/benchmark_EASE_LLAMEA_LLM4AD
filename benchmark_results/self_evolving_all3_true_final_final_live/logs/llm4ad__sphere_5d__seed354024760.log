def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    best = None
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        x = clip(x)
        for t in range(1, 1000): # maximum number of iterations per restart
            x_t = x + rng.normal(size=dim) / np.sqrt(t+1)
            x_t = clip(x_t)
            alpha = np.exp(-t/100.)
            if func(x_t) < func(x):
                x = x_t
                if best is None or func(x) < func(best):
                    best = x
            elif rng.uniform() > alpha:
                break

    return best
