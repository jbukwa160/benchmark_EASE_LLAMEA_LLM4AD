def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    t = 1.0
    while True:
        if budget <= 0:
            break
        
        new_x = clip(x + rng.normal(size=dim))
        new_f = func(new_x)
        
        if new_f < best_f:
            best_f = new_f
            best_x = new_x.copy()
        
        alpha = rng.uniform(0, 1)
        if alpha < np.exp(-(new_f - best_f) / (t + 1e-8)):
            x = new_x.copy()
        
        budget -= 1
        
        t *= 0.99999
    
    return best_x
