def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_points = 10 * D  # Initial number of points to sample the function
    sigma = 0.1
    kappa = 5
    init_x = np.zeros((n_points, D))
    
    for i in range(n_points):
        init_x[i] = lb + (ub - lb) * rng.uniform(0, 1, size=D)
        
    # Main optimization loop
    x_best = None
    y_best = float('inf')
    while budget > 0:
        # Sample the function at n_points using GP surrogate
        y_pred, cov = gaussian_process(init_x, func, D, sigma, kappa)
        
        # Choose next point based on acquisition function
        x_next = choose_point(y_pred, cov, init_x, rng)
        
        # Evaluate function at chosen point and update best solution
        y_new = func(x_next)
        budget -= 1
        
        if y_new < y_best:
            y_best = y_new
            x_best = x_next
            
        # Update GP surrogate with new point
        init_x = np.vstack((init_x, x_next))
        
    return x_best
