def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    population_size = 100
    population = rng.uniform(lb, ub, size=(population_size, dim))
    best_so_far = None

    for _ in range(budget):
        new_population = []
        for _ in range(population_size // 2):
            parents = np.array([rng.choice(population, size=2, replace=False)])
            child = np.copy(parents[0])
            mutation_rate = 0.1
            if rng.rand() < mutation_rate:
                child += rng.uniform(-1, 1, size=(dim,))
            crossover_rate = 0.5
            if rng.rand() < crossover_rate:
                mask = rng.randint(0, dim, size=dim)
                child[mask] = parents[0][mask]
            new_population.append(clip(child))

        population = np.concatenate((population, new_population))
        tournament_size = 10
        winners = [np.max(population[:tournament_size], axis=0)]
        for i in range(tournament_size - 1):
            winner_idx = np.argmax(np.sum(func(population[i:i+tournament_size]) + func(winners[-1]), axis=-1))
            winners.append(population[winner_idx])
        best_candidate = np.max(winners, key=lambda x: func(x))

        if best_so_far is None or func(best_candidate) < func(best_so_far):
            best_so_far = best_candidate

    return best_so_far
