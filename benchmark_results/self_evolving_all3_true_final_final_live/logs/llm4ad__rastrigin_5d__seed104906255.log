def algorithm(func, dim, lb, ub, budget, rng):
    def bounds(x):
        return np.clip(x, lb, ub)

    def generate_population(n, dim, lb, ub, rng):
        population = rng.uniform(lb, ub, size=(n, dim))
        return population

    def calculate_fitness(population, func):
        fitness = [func(bounds(individual)) for individual in population]
        return np.array(fitness)

    def select_parents(population, fitness, n, rng):
        indices = np.argsort(fitness)[:n]
        parents = population[indices]
        return parents

    def crossover(parents, rng):
        n = len(parents)
        children = np.zeros((n, dim))
        for i in range(n):
            p1_idx, p2_idx = rng.choice([j for j in range(n) if j != i], 2, replace=False)
            p1, p2 = parents[p1_idx], parents[p2_idx]
            crossover_rate = rng.uniform(0.5, 0.9)
            children[i] = (crossover_rate * p1 + (1 - crossover_rate) * p2)
        return children

    def mutation(children):
        n, dim = len(children), len(children[0])
        for i in range(n):
            for j in range(dim):
                mutation_rate = rng.uniform(0.01, 0.5)
                children[i, j] += mutation_rate * (rng.uniform(-1, 1) * (ub - lb))
        return np.clip(children, lb, ub)

    def adaptive_crossover_mutation(population, fitness, n, budget, rng):
        best = population[np.argmin(fitness)]
        crossover_rate = 0.5 + 0.4 / (1 + np.exp(-budget * (np.mean(fitness) - fitness[0])))
        mutation_rate = 0.05 + 0.3 / (1 + np.exp(-budget * (fitness[0] - np.mean(fitness))))
        return crossover_rate, mutation_rate

    population = generate_population(100, dim, lb, ub, rng)
    for _ in range(budget):
        fitness = calculate_fitness(population, func)
        best_idx = np.argmin(fitness)
        best_individual = bounds(population[best_idx])
        
        if np.isclose(func(best_individual), 0):
            return best_individual

        crossover_rate, mutation_rate = adaptive_crossover_mutation(population, fitness, len(population), _ + 1, rng)

        parents = select_parents(population, fitness, 20, rng)
        children = crossover(parents, rng)
        children = mutation(children)
        
        population = np.concatenate((parents, children))
    
    return bounds(population[np.argmin(calculate_fitness(population, func))])
