def algorithm(func, dim, lb, ub, budget, rng):
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    T = 10.0
    alpha = 0.99
    n_iter = 0

    while n_iter < budget:
        n_iter += 1
        x_new = x_best + (ub - lb) * rng.randn(dim)
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        delta = f_new - f_best

        if delta <= 0 or rng.rand() < np.exp(-delta / T):
            x_best = x_new
            f_best = f_new

        T *= alpha

    return x_best
