def algorithm(func, dim, lb, ub, budget, rng):
    def wrapper(x):
        return sum(x**2)

    bounds = [(lb, ub) for _ in range(dim)]
    res = differential_evolution(wrapper, bounds)
    best_candidate = res.x
    best_value = res.fun
    candidates = [best_candidate]
    
    for _ in range(budget - 1):
        new_candidates = []
        for candidate in candidates:
            noise = rng.uniform(-5.0, 5.0, size=dim)
            new_candidate = np.clip(candidate + noise, lb, ub)
            new_candidates.append(new_candidate)
        
        new_candidates = np.array(new_candidates)
        values = func(new_candidates)
        indices = np.argsort(values)[:int(0.1 * len(values))]
        candidates = new_candidates[indices]
    
    best_value = np.inf
    best_candidate = None
    
    for candidate in candidates:
        value = wrapper(candidate)
        if value < best_value:
            best_value = value
            best_candidate = candidate
    
    return np.clip(best_candidate, lb, ub)
