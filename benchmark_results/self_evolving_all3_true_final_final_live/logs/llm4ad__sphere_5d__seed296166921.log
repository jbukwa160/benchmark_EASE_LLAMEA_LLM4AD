def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.minimum(np.maximum(x, lb), ub)

    D = dim
    n = 50  # number of samples
    sigma = 1.0  # initial standard deviation
    mu = rng.uniform(lb, ub, size=(D,))
    p = (ub - lb) / 2.0
    C = np.eye(D)
    pc = np.eye(D)

    for _ in range(budget):
        y = rng.normal(size=(n, D))
        z = sigma * y @ C + mu

        # Clip to bounds
        candidates = clip(z, lb, ub)
        
        # Evaluate function on all samples
        f_values = func(candidates)

        # Select the best candidate
        idx = np.argmin(f_values)
        if func(mu) > f_values[idx]:
            mu = candidates[idx]
            C = (1 - 1 / (D + 2)) * C + 1 / (D + 2) * p @ p.T

    return mu
