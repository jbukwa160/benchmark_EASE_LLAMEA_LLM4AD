def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    T = 10 * (ub - lb) / (1 + np.log(budget))
    alpha = 0.99
    sigma = 0.1 * (ub - lb)

    for i in range(int(budget)):
        y = x + rng.normal(size=dim, loc=0, scale=sigma)
        y = clip(y)
        E_new = func(y)
        E_old = func(x)

        if E_new < E_old:
            x = y
        else:
            delta_E = E_new - E_old
            if np.random.rand() < np.exp(-delta_E / T):
                x = y

        T *= alpha
        sigma *= 0.99

    return clip(x)
