def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(sigma, x_best):
        candidate = rng.normal(size=dim) * sigma + x_best
        return clip(candidate)

    def update_sigma(sigma, x_best, func_val):
        if func_val < 1e-6:
            sigma *= 0.9
        else:
            sigma *= 1.01

        return sigma

    def restart(x_best):
        return np.zeros(dim)

    x_best = np.zeros(dim)
    budget_remaining = budget
    sigma = 1.0
    func_val_best = float('inf')

    while budget_remaining > 0 and sigma > 1e-6:
        candidate = generate_candidate(sigma, x_best)
        func_val = func(candidate)

        if func_val < func_val_best:
            x_best = candidate
            func_val_best = func_val

        sigma = update_sigma(sigma, x_best, func_val_best)

        budget_remaining -= 1

    return x_best
