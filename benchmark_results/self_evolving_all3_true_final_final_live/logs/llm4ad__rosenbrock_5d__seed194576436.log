def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def fitness(x):
        return func(x)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = fitness(clip(x_best))
    population_size = 50
    sigma = 1.0

    for _ in range(budget):
        x_population = clip(np.random.normal(x_best, sigma, (population_size, dim)))
        fs_population = [fitness(x) for x in x_population]
        idx = np.argsort(fs_population)[:int(population_size/2)]
        x_population = [x_population[i] for i in idx]

        mu = np.mean(x_population, axis=0)
        cov = np.cov(np.transpose(x_population))
        c1 = 1.0 / (np.linalg.norm(cov) + 1e-8)
        c2 = 2.0 * np.eye(dim)

        sigma = sigma * np.exp(1/(dim+5)) * (c1 * np.sqrt(np.diag(cov)) + c2)

        x_best_new = np.random.normal(mu, sigma, size=dim)
        f_best_new = fitness(clip(x_best_new))
        if f_best_new < f_best:
            x_best = x_best_new
            f_best = f_best_new

    return clip(x_best)
