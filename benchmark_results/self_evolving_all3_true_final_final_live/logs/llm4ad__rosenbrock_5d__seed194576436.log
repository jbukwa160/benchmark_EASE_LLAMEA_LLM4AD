def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(np.array([x] * dim))

    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    sigma = 0.5
    n_evals = 1

    while n_evals < budget:
        candidates = [clip(x + sigma * g) for g in rng.randn(dim)]
        f_values = [f(c) for c in candidates]
        idx_best = np.argmin(f_values)
        if f_values[idx_best] < f(best_x):
            best_x = candidates[idx_best].copy()
        x = clip(x + sigma * (np.array(candidates) - x)[idx_best])
        n_evals += 1

    return best_x
