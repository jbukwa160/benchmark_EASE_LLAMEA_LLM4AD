def algorithm(func, dim, lb, ub, budget, rng):
    if dim < 1:
        raise ValueError("dim must be at least 1")
    
    best = None
    for i in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        f_x = func(x)
        
        if best is None or f_x < func(best):
            best = x
        
        alpha = (i+1)**(-0.5)  # adaptive learning strategy
        x_new = x + alpha * rng.uniform(-1, 1, size=dim)
        
        for j in range(dim-1):
            if np.any(np.isnan(x_new)) or np.any(x_new < lb) or np.any(x_new > ub):
                x_new[j] = max(lb, min(ub, x_new[j]))
        
        f_x_new = func(x_new)
        
        if f_x_new < f_x:
            x = x_new
            f_x = f_x_new
    
    return best
