def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(individual):
        clipped_individual = clip(individual)
        return func(clipped_individual)

    population_size = 50
    max_iter = budget // population_size

    population = rng.uniform(lb, ub, (population_size, dim))
    best_individual = np.zeros(dim)

    for _ in range(max_iter):
        variation = rng.normal(size=(population_size, dim))
        parents = population + 0.1 * variation
        parents[parents > ub] = ub
        parents[parents < lb] = lb

        offspring = np.copy(population)
        crossover_prob = 0.7 + 0.3 * (evaluate(parents) - evaluate(offspring)) / max_iter

        for i in range(population_size):
            if rng.random() < crossover_prob:
                idx1, idx2, idx3 = rng.choice(population_size, 3, replace=False)
                offspring[i] = parents[idx1] + rng.uniform(0, 1) * (parents[idx2] - parents[idx3])

        population = clip(offspring)
        best_individual = clip(np.array([evaluate(individual) for individual in population]).argmin())

    return best_individual
