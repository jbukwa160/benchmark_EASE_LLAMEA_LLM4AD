def algorithm(func, dim, lb, ub, budget, rng):
    def sample_1d(rng, dim, lb, ub):
        return (ub - lb) * rng.uniform(size=dim) + lb
    
    def sample_gaussian(rng, dim, lb, ub, std_dev):
        return (ub - lb) * rng.normal(size=dim) + lb
    
    def acquisition_function(x, y, x_best, y_best):
        return (y - y_best) / abs(y_best)
    
    def gradient_free_evolution_strategy(func, x0, dim, lb, ub, budget, rng):
        x = np.array([x0])
        for _ in range(budget):
            noise_std_dev = 1
            for _ in range(100): # Number of generations
                new_x = sample_gaussian(rng, dim, lb, ub, noise_std_dev)
                if func(new_x) < func(x[-1]):
                    x = np.append(x, new_x)
        return x[-1]
    
    best_x = None
    best_y = float('inf')
    for i in range(budget):
        new_x = sample_1d(rng, dim, lb, ub)
        new_y = func(new_x)
        
        if new_y < best_y:
            best_y = new_y
            best_x = new_x
        
        # Run gradient-free evolution strategy with initial point as the current best solution
        next_x = gradient_free_evolution_strategy(func, best_x, dim, lb, ub, budget // 10, rng)
        
        if func(next_x) < best_y:
            best_y = func(next_x)
            best_x = next_x
    
    return np.array([best_x])
