def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def simplex_search(x0, dim):
        x = [x0 + 1e-3 * rng.normal(0, 1) for _ in range(dim)]
        while True:
            f_new = func(clip(np.array(x)))
            f_old = func(clip(np.array(x0)))
            if f_new < f_old:
                return clip(np.array(x))
            else:
                step_size = np.sqrt((np.array(x) - x0)**2).mean()
                if rng.random() < 0.5 or step_size < 1e-6:
                    break
                for i in range(dim):
                    x[i] += 0.5 * (x[i] - x0[i]) + rng.normal(0, 1) * step_size
        return clip(np.array(x))

    def simulated_annealing(x0, budget):
        T = 100
        while budget > 0:
            f_old = func(clip(x0))
            step_size = 0.01 * (ub - lb)
            x_new = np.clip(x0 + rng.normal(0, step_size, dim), lb, ub)
            f_new = func(clip(x_new))
            delta_f = f_new - f_old
            if delta_f < 0 or rng.random() < np.exp(-delta_f / T):
                x0 = x_new
            budget -= 1
            T *= 0.99
        return clip(np.array(x0))

    x_best = None
    for _ in range(budget // dim):
        x0 = [rng.uniform(lb, ub) for _ in range(dim)]
        simplex_x = simplex_search(clip(np.array(x0)), dim)
        sa_x = simulated_annealing(simplex_x, budget // dim - 1)
        if x_best is None or func(clip(sa_x)) < func(clip(x_best)):
            x_best = sa_x
    return np.array(x_best)
