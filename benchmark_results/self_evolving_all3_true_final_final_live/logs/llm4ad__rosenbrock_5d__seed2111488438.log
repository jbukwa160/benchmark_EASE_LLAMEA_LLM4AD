def algorithm(func, dim, lb, ub, budget, rng):
    def clip(cand):
        return np.clip(cand, lb, ub)

    num_samples = 100
    best_solution = rng.uniform(lb, ub)
    learning_rate = 1.0
    iters = 0

    while iters < budget:
        for _ in range(num_samples):
            cand = best_solution + rng.normal(size=dim) * learning_rate
            cand = clip(cand)
            if func(cand) < func(best_solution):
                best_solution = cand

        progress = (func(clip(np.mean([best_solution, np.zeros(dim)]))) - func(best_solution)) / \
                   (func(clip(np.mean([np.zeros(dim), ub]))) - func(best_solution))
        learning_rate *= 0.99 if progress > 1e-4 else 1.01

        iters += 1

    return best_solution
