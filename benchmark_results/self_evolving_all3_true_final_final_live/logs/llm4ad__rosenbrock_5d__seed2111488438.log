def algorithm(func, dim, lb, ub, budget, rng):
    def get_neighborhood(x, sigma, d=2):
        x_plus = x + np.random.normal(0, sigma, size=(dim,))
        x_minus = x - np.random.normal(0, sigma, size=(dim,))
        for i in range(dim):
            if abs(x_plus[i] - x[i]) > 1 or abs(x_minus[i] - x[i]) > 1:
                x_plus[i] = x[i] + np.sign(rng.uniform(-1, 1)) * rng.uniform(0.5, 1)
                x_minus[i] = x[i] + np.sign(rng.uniform(-1, 1)) * rng.uniform(0.5, 1)
        return (x_plus, x_minus)

    def truncated_norm(shape, loc, scale, lower):
        a = (lower - loc) / scale
        return truncnorm(a, np.inf, loc=loc, scale=scale).rvs(size=shape)

    best_x = lb + rng.uniform(0, ub - lb, size=(dim,))
    curr_x = np.copy(best_x)
    temp = 1.0
    num_local_optima = 0

    for _ in range(budget):
        x_plus, x_minus = get_neighborhood(curr_x, scale=temp)
        f_plus = func(x_plus)
        f_minus = func(x_minus)

        if f_plus < func(curr_x) and rng.uniform(0, 1) > np.exp(-(f_plus - func(curr_x)) / temp):
            curr_x = x_plus
            num_local_optima = 0
        elif f_minus < func(curr_x) and rng.uniform(0, 1) > np.exp(-(f_minus - func(curr_x)) / temp):
            curr_x = x_minus
            num_local_optima = 0

        if func(curr_x) < func(best_x):
            best_x = np.copy(curr_x)

        if num_local_optima >= int(budget * 0.9):
            temp *= 0.99
            num_local_optima = 0

    return best_x
