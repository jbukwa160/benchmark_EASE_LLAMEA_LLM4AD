def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(x, sigma, c):
        if rng.rand() < 0.1:
            return x + rng.randn(dim) * sigma * c
        else:
            return x

    def adapt(sigma, sigma_p, a, b):
        if rng.rand() < 0.5 and sigma > 0.01:
            return np.exp(np.log(sigma) + rng.uniform(-a, -b))
        elif sigma < 1e-2:
            return max(0.001, sigma / np.exp(rng.uniform(a, b)))
        else:
            return sigma

    x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    y_best = func(x)
    sigma = 1
    c = 0.2
    a = -1
    b = 2

    for i in range(budget):
        x_new = mutate(x, sigma, c)
        x_new = np.clip(x_new, lb, ub)
        y_new = func(x_new)

        if y_new < y_best:
            y_best = y_new
            x_best = x_new
        else:
            sigma_p = (y_new - y_best) / 2
            sigma = adapt(sigma, sigma_p, a, b)
            c = min(0.5, max(c * 1.01, rng.uniform(0.05, 0.5)))
            x = mutate(x_best, sigma, c)

    return x_best
