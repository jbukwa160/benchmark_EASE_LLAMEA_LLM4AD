def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    T = 1000.0
    step_size = 10.0 * (ub - lb) / n
    
    best_x = np.zeros(n)
    best_f = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=n)
        
        while True:
            new_x = x + rng.uniform(-step_size, step_size, size=n)
            new_x = np.clip(new_x, lb, ub)
            
            if func(new_x) < func(x):
                x = new_x
                break
            
            elif rng.random() < np.exp((func(x) - func(new_x)) / T):
                x = new_x
        
        if func(x) < best_f:
            best_x = x
            best_f = func(x)
        
        T *= 0.99
    
    return best_x
