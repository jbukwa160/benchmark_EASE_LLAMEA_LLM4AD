def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.array([ub + (lb - ub) * rng.rand(dim)])
    f_best = func(x_best)
    
    for _ in range(budget):
        step_size = 0.1 * (ub - lb) / np.sqrt(_ + 1)
        
        while True:
            x_new = x_best + rng.randn(dim) * step_size
            x_new = np.clip(x_new, lb, ub)
            
            f_new = func(x_new)
            
            if f_new < f_best:
                x_best = x_new
                f_best = f_new
                
            elif rng.rand() > 0.5:
                break
            
    return x_best
