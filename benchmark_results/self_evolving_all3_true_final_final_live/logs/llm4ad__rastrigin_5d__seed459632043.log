def algorithm(func, dim, lb, ub, budget, rng):
    def bounds(x):
        return [max(lb[i], min(ub[i], x[i])) for i in range(dim)]

    def evaluate(x):
        x = np.array([bounds(xi) for xi in x])
        return func(x)

    best_x = [0.5] * dim
    best_f = float('inf')
    temp = 1.0

    for _ in range(budget):
        # Differential evolution step
        offspring = []
        for i in range(dim):
            parent1, parent2, parent3 = np.random.choice(best_x, size=3, replace=False)
            offspring.append([parent1 + rng * (parent2 - parent3) if j != i else best_x[j] 
                              for j in range(dim)])

        # Evaluate new candidates
        new_candidates = [evaluate(x) for x in offspring]
        new_indices = np.argsort(new_candidates)[:int(0.1*len(new_candidates))]
        new_offspring = [offspring[i] for i in new_indices]

        # Simulated annealing step
        new_f = evaluate(new_offspring[0])
        if new_f < best_f or rng.uniform() < (np.exp((best_f - new_f) / temp)):
            best_x, best_f = new_offspring[0], new_f
            temp *= 0.99

    return np.array(best_x)
