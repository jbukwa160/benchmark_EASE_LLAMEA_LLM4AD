def algorithm(func, dim, lb, ub, budget, rng):
    def rand(dim):
        return (ub - lb) * rng.rand(dim) + lb
    
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)
    
    population = [rand(dim) for _ in range(100)]
    best_candidate = np.inf
    for t in range(budget):
        for i in range(len(population)):
            # Mutation step
            candidate = population[i] + rng.uniform(-1, 1, dim)
            
            # Crossover (recombination) step
            v_i = clip(candidate + 0.5 * (population[(i-1)%len(population)] - population[(i+1)%len(population)]), lb, ub)
            
            # Selection step
            candidate = np.where(np.random.rand(dim) < 0.2, v_i, population[i])
            
            # Evaluation step
            candidate_value = func(candidate)
            
            # Update best candidate
            if candidate_value < best_candidate:
                best_candidate = candidate_value
                best_candidate_vector = candidate
        
        # Local search
        for i in range(len(population)):
            if rng.uniform(0, 1) < 0.05:
                step_size = rng.uniform(-1e-3, 1e-3)
                while True:
                    candidate = population[i] + step_size * (population[(i-1)%len(population)] - population[(i+1)%len(population)])
                    candidate_value = func(candidate)
                    if candidate_value < best_candidate and np.linalg.norm(candidate - population[i]) > 1e-6:
                        population[i] = candidate
                        break
        
        # Replacement step
        for i in range(len(population)):
            if rng.uniform(0, 1) < 0.05:
                j = (i + rng.randint(0, len(population))) % len(population)
                if func(population[j]) < func(population[i]):
                    population[i] = population[j]
    
    return best_candidate_vector
