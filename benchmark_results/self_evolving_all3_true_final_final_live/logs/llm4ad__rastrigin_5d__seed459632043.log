def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = objective(best_x)

    for _ in range(budget):
        # Differential Evolution
        r1, r2, r3 = rng.choice(dim, size=3, replace=False), rng.choice(dim, size=3, replace=False), rng.choice(dim, size=3, replace=False)
        mutant = x + 0.5*(x[r1] - x[r2]) + 0.5*(x[r3] - x[rng.choice(dim, size=1)[0]])

        # Clip mutant to bounds
        mutant = np.clip(mutant, lb, ub)

        # Selection
        target = rng.uniform(0, 1)
        if target < 0.6:
            cross_points = rng.choice(dim, size=int(0.2*dim), replace=False)
            trial = x.copy()
            for i in range(len(cross_points)):
                trial[cross_points[i]] = mutant[cross_points[i]]
            if objective(trial) < objective(best_x):
                best_x = trial
                best_f = objective(best_x)

        # Particle Swarm Optimization
        c1, c2 = rng.uniform(0.5, 1.0), rng.uniform(0.5, 1.0)
        pbest_x = np.copy(x)
        pbest_f = objective(pbest_x)
        for i in range(dim):
            if rng.uniform(0, 1) < c1:
                pbest_x[i] = x[i] + 0.2*(rng.uniform(-5, 5) - best_x[i])
            elif rng.uniform(0, 1) < c2:
                pbest_x[i] = x[i] + 0.2*(pbest_x[i] - x[i])

        # Local Search
        for _ in range(int(0.01*dim)):
            trial = np.copy(x)
            for i in range(dim):
                if rng.uniform(0, 1) < 0.5:
                    trial[i] += 0.001*(rng.uniform(-5, 5) - x[i])
                else:
                    trial[i] -= 0.001*(x[i] - rng.uniform(-5, 5))
            # Clip candidate to bounds
            trial = np.clip(trial, lb, ub)
            if objective(trial) < best_f:
                best_x = trial
                best_f = objective(best_x)

    return best_x
