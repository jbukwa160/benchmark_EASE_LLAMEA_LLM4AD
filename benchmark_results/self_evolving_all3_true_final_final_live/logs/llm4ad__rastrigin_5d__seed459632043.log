def algorithm(func, dim, lb, ub, budget, rng):
    def rastrigin(x):
        return func(x) + np.sum([10 * np.sin(2 * np.pi * xi) for xi in x])

    pop_size = 50
    x_best = np.random.uniform(lb, ub, size=(pop_size, dim))
    y_best = np.array([rastrigin(xi) for xi in x_best])
    temperature = 10.0

    for i in range(budget):
        v = rng.normal(size=x_best.shape)
        x_new = x_best + 0.5 * v
        for j in range(dim):
            if lb <= x_new[j, :] <= ub:
                y_new = rastrigin(x_new[:, j])
                if y_new < y_best:
                    x_best[:, j] = x_new[:, j]
                    y_best[:] = y_new

        # SA part
        probability = np.exp((y_best - rastrigin(x_best)) / temperature)
        for k in range(pop_size):
            if rng.uniform(0, 1) < probability[k]:
                v = rng.normal(size=x_best.shape)
                x_new = x_best + 0.5 * v
                y_new = rastrigin(x_new[:, k])
                if y_new < y_best:
                    x_best[:, k] = x_new[:, k]
                    y_best[:] = y_new

        temperature *= 0.99

    return x_best[np.argmin(y_best)]
