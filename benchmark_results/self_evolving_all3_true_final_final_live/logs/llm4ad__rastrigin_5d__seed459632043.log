def algorithm(func, dim, lb, ub, budget, rng):
    n_iter = 0
    x_best = np.random.uniform(lb, ub, (1, dim))
    f_best = func(x_best)

    while n_iter < budget:
        # Sample a new candidate using EI acquisition function
        gp_mean, gp_std = gp_surrogate_model(x_best)
        ei_values = expected_improvement(gp_mean, gp_std, x_best, lb, ub, rng)
        
        next_candidate = np.argmax(ei_values) / (ub - lb) + lb

        # Evaluate new candidate using provided function
        new_x = np.atleast_2d(next_candidate).reshape(1, dim)
        new_f = func(new_x)

        if new_f < f_best:
            x_best = new_x
            f_best = new_f

        n_iter += 1

    return x_best
