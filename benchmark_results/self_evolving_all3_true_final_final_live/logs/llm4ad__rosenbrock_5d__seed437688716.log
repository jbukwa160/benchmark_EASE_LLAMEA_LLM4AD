def algorithm(func, dim, lb, ub, budget, rng):
    def get_bounds(i):
        return (lb[i] + 1e-3, ub[i])

    D = dim
    nharmonies = 10
    learning_rate = 0.5

    x = np.array([np.random.uniform(lb, ub) for _ in range(D)])

    for t in range(budget):
        harmonies = [x.copy() for _ in range(nharmonies)]
        
        for i in range(D):
            lb_i, ub_i = get_bounds(i)
            
            # Update lower bounds
            update_lb = np.random.uniform(0, 1) < 0.5
            
            if update_lb:
                harmonies[i] -= np.random.uniform(0, learning_rate * (ub_i - lb_i))
            else:
                harmonies[i] += np.random.uniform(0, learning_rate * (ub_i - lb_i))
            
            # Clip to bounds
            harmonies[i] = np.clip(harmonies[i], lb_i, ub_i)
        
        # Update best solution
        f_x = func(x)
        f_harmony = np.min([func(h) for h in harmonies])
        
        if f_harmony < f_x:
            x = np.array([h.copy() for h in harmonies])[np.argmin([func(h) for h in harmonies])]

    return x
