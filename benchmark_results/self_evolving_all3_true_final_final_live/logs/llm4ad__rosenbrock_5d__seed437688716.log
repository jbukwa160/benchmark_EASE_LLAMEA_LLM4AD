def algorithm(func, dim, lb, ub, budget, rng):
    x = 1 + (ub - lb) * rng.rand(dim)
    T = 10000
    cooling_rate = 0.99
    best_x = x.copy()
    best_y = func(x)

    for _ in range(budget):
        y_new = func(x)

        if y_new < best_y:
            best_x = x.copy()
            best_y = y_new

        if rng.rand() < np.exp((best_y - y_new) / T):
            x = (x + 0.1 * (ub - lb) * rng.randn(dim)).clip(lb, ub)

        T *= cooling_rate
        T = max(T, 1e-5)
    return best_x
