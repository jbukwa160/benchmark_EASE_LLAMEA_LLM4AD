def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(dim, lb, ub):
        return (ub - lb) * rng.rand(dim) + lb
    
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)
    
    population_size = 100
    temperature = 100.0
    cooling_rate = 0.99
    mutation_factor = 0.1
    crossover_probability = 0.5
    
    initial_population = generate_initial_population(dim, lb, ub)
    best_solution = np.inf * rng.rand(dim)  # Initialize with a random solution
    
    for _ in range(budget):
        new_population = []
        
        for _ in range(population_size):
            parent1, parent2 = rng.choice(initial_population, size=2, replace=False)
            
            candidate = clip(parent1 + mutation_factor * (parent2 - parent1), lb, ub)
            new_population.append(candidate)
            
            if rng.rand() < crossover_probability:
                candidate = clip(0.5 * parent1 + 0.5 * parent2, lb, ub)
                new_population.append(candidate)
        
        initial_population = np.array(new_population)
        
        for solution in initial_population:
            objective_value = func(solution)
            
            if objective_value < best_solution[func]:
                best_solution = solution
        
        temperature *= cooling_rate
        if temperature < 1.0:
            break
    
    return best_solution
