def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    x = np.random.uniform(lb, ub, size=dim)
    mean = x.copy()
    cov = 1.0 * np.eye(dim)
    sigma = 10.0
    lambda_ = 32

    for _ in range(budget):
        dist = func(clip(mean))
        if rng.random() < 0.5:
            z = np.random.normal(size=dim)
            mean_new = mean + sigma * z / np.linalg.norm(z)
            cov_new = (1 - 2 / lambda_) * cov + 1 / (lambda_ * (lambda_ - 1)) * np.outer(z, z) / np.linalg.norm(z)**4
            x_new = clip(mean_new + np.sqrt(cov_new).dot(np.random.normal(size=dim)))
        else:
            x_new = clip(clip(x) + np.random.normal(size=dim))
        
        dist_new = func(clip(x_new))
        if dist_new < dist:
            mean, cov, sigma, lambda_ = x_new, 1.0 * np.eye(dim), 10.0, 32
            dist = dist_new

    return clip(mean)
