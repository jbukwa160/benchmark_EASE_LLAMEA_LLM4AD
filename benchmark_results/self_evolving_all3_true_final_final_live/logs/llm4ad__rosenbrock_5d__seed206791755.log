def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_dim = len(lb)
    n_iter = int(budget * 0.8) # reserve some for final optimization
    x_best = np.random.uniform(lb, ub, (1, D))
    y_best = func(x_best)

    gp = GaussianProcessRegressor(kernel=ConstantKernel(1e-3)*RBF(1e-2), alpha=1e-6)
    X_train = []
    Y_train = []

    for i in range(n_iter):
        X = np.vstack([x_best, [np.random.uniform(lb, ub) for _ in range(D)]])
        y = np.append(y_best, func(X[-1]))
        
        gp.fit(np.array(X_train), np.array(Y_train))
        
        # Predict mean and variance of EI
        mu, sigma = gp.predict(np.array([X[-1]]), return_std=True)
        
        # Calculate EI
        ei = (mu - y_best) * norm.cdf((mu - y_best) / sigma) + sigma * norm.pdf((mu - y_best) / sigma)

        # Select next point with maximum EI
        ix = np.argmax(ei)

        X_train.append(X[ix])
        Y_train.append(y(ix))
        
        if ei[ix] > 0:
            x_best = X[ix]
            y_best = y(ix)
    
    return x_best
