def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    pop_size = min(100, int(n * 10))
    x_best = np.random.uniform(lb, ub, (pop_size, n))

    for _ in range(budget):
        f_x = func(x_best)

        for i in range(pop_size):
            v = np.copy(x_best[i])
            idx1, idx2, idx3 = rng.choice(range(pop_size), replace=False, size=3)
            if rng.random() < 0.5:
                v += 0.5 * (x_best[idx1] - x_best[idx2]) + 0.05 * (rng.random(n) - 0.5)
            else:
                v -= 0.5 * (x_best[idx3] - x_best[idx1]) + 0.05 * (rng.random(n) - 0.5)

            u = np.clip(v, lb, ub)

            f_u = func(u)
            if f_u < f_x[i]:
                x_best[i] = u
                f_x[i] = f_u

        best_idx = np.argmin(f_x)
        if f_x[best_idx] < 1e-6:
            break

    return x_best[best_idx]
