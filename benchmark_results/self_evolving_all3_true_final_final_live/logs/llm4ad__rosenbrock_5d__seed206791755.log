def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(rng):
        population = rng.uniform(lb, ub, (budget, dim))
        return population

    def evaluate(population):
        evaluations = func(population)
        return evaluations

    def differential_evolution(population, evaluations):
        # Select parents
        idx = np.argsort(evaluations)[:int(0.1 * budget)]
        parents = population[idx]
        
        # Create offspring
        offset = rng.uniform(-1, 1, (budget, dim))
        offspring = parents + offset
        
        return offspring

    def hill_climbing(offspring):
        best_candidate = np.random.choice(offspring)
        for _ in range(int(budget * 0.9)):
            candidate = clip(best_candidate + rng.normal(0, 0.1, dim))
            if func(candidate) < func(best_candidate):
                best_candidate = candidate
        return best_candidate

    population = generate_initial_population(rng)
    evaluations = evaluate(population)

    for i in range(int(budget * 0.9)):
        offspring = differential_evolution(population, evaluations)
        best_candidate = hill_climbing(offspring)
        
        if func(best_candidate) < func(population[np.argmin(evaluations)]):
            population[np.argmin(evaluations)] = clip(best_candidate)

    return clip(population[np.argmin(evaluate(population))])
