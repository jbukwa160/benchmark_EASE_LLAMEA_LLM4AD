def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)
    temperature = 1.0
    simplex_size = 2 * dim + 1
    candidates = [x]

    for _ in range(budget):
        for i in range(simplex_size):
            # Generate new point using reflection or expansion
            if i == 0:
                new_x = x - temperature * (x - best_x) / np.linalg.norm(x - best_x)
            elif i == 1:
                new_x = x + temperature * (best_x - x) / np.linalg.norm(best_x - x)
            else:
                new_x = x + rng.normal(size=dim)

            # Clip new point to bounds
            new_x = clip(new_x)

            # Evaluate function at new point
            new_f = func(new_x)

            # Update candidates and best solution if necessary
            candidates.append(new_x)
            if new_f < best_f:
                best_f = new_f
                best_x = new_x

        # Simulated annealing: accept or reject new solution based on temperature
        if rng.uniform(0, 1) > np.exp((best_f - func(best_x)) / temperature):
            candidates.pop()
        else:
            x = clip(np.array(candidates[rng.choice(len(candidates))]))

        # Reduce temperature over time
        temperature *= 0.99

    return best_x
