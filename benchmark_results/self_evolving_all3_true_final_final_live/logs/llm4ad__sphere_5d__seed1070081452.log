def algorithm(func, dim, lb, ub, budget, rng):
    D = 0.99
    T = 1000
    beta = 1 / (T - 1)
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = np.clip(np.random.uniform(lb, ub, dim), lb, ub)
        
        if func(x) < best_f:
            best_f = func(x)
            best_x = x.copy()
            
        f_new = func(x)
        prob_accept = min(1, np.exp(- (f_new - best_f) / T))
        
        if rng.random() < prob_accept or f_new < best_f:
            best_x = x.copy()
            best_f = f_new
            
            T *= D
            beta /= D
            
    return best_x
