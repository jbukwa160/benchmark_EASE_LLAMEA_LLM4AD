def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    N = 10  # Population size
    F = 0.5  # Adaptively updated mutation factor
    CR = 0.9  # Crossover rate

    pop = rng.uniform(lb, ub, (N, dim))

    for _ in range(budget):
        fit_pop = func(pop)
        best_idx = np.argmin(fit_pop)

        if fit_pop[best_idx] < func(clip(pop[best_idx], lb, ub)):
            pop[best_idx] = clip(pop[best_idx], lb, ub)

        F = 0.5 * (1 + 1 / (_ / budget))  # Adaptively decrease mutation factor
        CR = 0.9 - 0.8 * (_ / budget)  # Adaptively increase crossover rate

        for i in range(N):
            if rng.random() < CR or i == best_idx:
                mu = pop[np.random.choice([j for j in range(N) if j != i], size=3, replace=False)]
                v = F * (mu - pop[i]) + pop[i]
                pop[i] = clip(v, lb, ub)

    return pop[best_idx]
