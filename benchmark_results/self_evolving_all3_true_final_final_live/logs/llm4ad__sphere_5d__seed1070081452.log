def algorithm(func, dim, lb, ub, budget, rng):
    best_x = rng.uniform(lb, ub, size=dim)
    best_f = func(best_x)
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        if np.any(x < lb) or np.any(x > ub):
            continue
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
    
    return best_x
