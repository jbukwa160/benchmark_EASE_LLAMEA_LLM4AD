def algorithm(func, dim, lb, ub, budget, rng):
    D = rng.uniform(lb, ub, size=(dim,))
    gp = {'mu': 0, 'sigma': 1}
    best_solution = D.copy()
    best_fitness = func(D)
    
    for _ in range(budget):
        X = np.atleast_2d(rng.multivariate_normal(gp['mu'], gp['sigma'] * rng.eye(dim)))
        Y = func(X)
        
        if Y < best_fitness:
            best_solution = X[0]
            best_fitness = Y
            gp['mu'] = X[0]
            gp['sigma'] = 1 / (np.exp(rng.uniform(0, 2)) + 1)
            
    return best_solution
