def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    pop_size = 50
    individual = lambda: np.random.uniform(lb, ub, dim)
    population = [clip(individual(), lb, ub) for _ in range(pop_size)]
    best_individual = np.inf

    for _ in range(budget):
        differences = [(np.array(p) - q).tolist() for p in population for q in population if p != q]
        variations = [(0.5 * r + 0.5 * (p - q)) for p, q, r in zip(population, population[1:], differences)]
        variations = [clip(v, lb, ub) for v in variations]

        # Crossover: Replace worse individuals with better ones
        for i, ind in enumerate(population):
            if func(ind) > func(variations[i]):
                population[i] = clip(variations[i], lb, ub)
            else:
                variation = np.random.uniform(lb, ub, dim)
                variation = clip(0.5 * ind + 0.5 * variation, lb, ub)
                if func(variation) < func(ind):
                    population[i] = variation

        # Update best individual
        for p in population:
            if func(p) < func(best_individual):
                best_individual = p

    return best_individual
