def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    t = 1.0
    best_x = x.copy()
    best_f = float('inf')

    for _ in range(budget):
        i = rng.choice(dim)
        dx = (ub - lb) * rng.uniform(-1, 1)

        new_x = x.copy()
        new_x[i] += dx

        clipped_new_x = np.clip(new_x, lb, ub)

        new_f = func(clipped_new_x)

        if new_f < best_f:
            best_x = clipped_new_x
            best_f = new_f

        acceptance_prob = np.exp((best_f - new_f) / t)
        r = rng.uniform(0, 1)

        if r < acceptance_prob or new_f <= func(x):
            x = clipped_new_x
            t *= 0.99  # decay temperature

    return best_x
