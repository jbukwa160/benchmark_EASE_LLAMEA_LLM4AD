def algorithm(func, dim, lb, ub, budget, rng):
    n = 0
    while n < budget:
        x = rng.uniform(lb, ub, size=dim)
        y = func(x)

        if n == 0 or y < np.min([func(rng.uniform(lb, ub, size=dim)) for _ in range(100)]):
            best_x = x
            best_y = y

        n += 1

    return clip(best_x, lb, ub)
