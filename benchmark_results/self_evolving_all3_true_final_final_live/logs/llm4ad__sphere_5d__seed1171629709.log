def algorithm(func, dim, lb, ub, budget, rng):
    bounds = [(lb, ub)] * dim
    best_x = np.array([np.random.uniform(*b) for b in bounds])
    best_f = func(best_x)
    
    for _ in range(budget):
        x = best_x + np.random.uniform(-1, 1, size=dim) / rng
        clipped_x = np.clip(x, *bounds)
        
        f = func(clipped_x)
        if f < best_f:
            best_x = clipped_x
            best_f = f
            
    return best_x
