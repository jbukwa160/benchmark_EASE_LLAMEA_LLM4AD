def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    x = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_fval = func(x)
    
    for i in range(budget - 1):
        candidate = clip_candidate(rng.normal(loc=x, scale=0.5, size=(dim)))
        
        while True:
            fval = func(candidate)
            
            if fval < best_fval or rng.uniform(0, 1) < 0.1:
                x = candidate
                best_x = candidate.copy()
                best_fval = fval
                
                break
        
        if rng.uniform(0, 1) < 0.01:
            z = rng.normal(loc=best_x, scale=0.1)
            candidate = clip_candidate(best_x + 0.5 * (z - x))
            
    return best_x
