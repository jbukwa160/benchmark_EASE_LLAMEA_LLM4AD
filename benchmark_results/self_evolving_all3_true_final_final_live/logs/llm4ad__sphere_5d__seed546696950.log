def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(current, rng):
        candidate = current + 0.5 * (ub - lb) * rng.normal(size=dim)
        candidate = clip(candidate)
        return candidate

    initial_solution = np.zeros(dim)
    best_solution = initial_solution
    current_solution = initial_solution
    temperature = budget

    for i in range(budget):
        new_candidate = generate_candidate(current_solution, rng)
        new_cost = func(new_candidate)

        if new_cost < func(best_solution):
            best_solution = new_candidate

        if np.random.rand() < np.exp((func(best_solution) - new_cost) / temperature):
            current_solution = new_candidate

        temperature *= 0.99

    return best_solution
