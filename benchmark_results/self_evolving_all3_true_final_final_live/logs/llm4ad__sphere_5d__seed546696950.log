def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    sigma = 5.0
    T_init = 1000.0
    cooling_rate = 0.99
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(budget):
        y = x + sigma * rng.randn(dim)
        
        # Clip candidates to [lb, ub]
        y = np.clip(y, lb, ub)
        
        f_y = func(y)
        
        if f_y < best_f:
            best_x = y
            best_f = f_y
            
        if i % 100 == 0 and i > 0:
            # Check for stagnation and adjust cooling rate
            if f_y == best_f:
                T_init *= 1.01
                cooling_rate = 0.9
                
        sigma = max(1e-6, min(T_init / (T_init + i), 10 * sigma))
        
    return best_x
