def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(size, dim, lb, ub):
        population = rng.uniform(lb, ub, (size, dim))
        return population

    def evaluate(population):
        fitness = [func(individual) for individual in population]
        return fitness

    def update_velocity(particle_best, global_best, velocity, c1, c2):
        r1 = rng.random()
        r2 = rng.random()
        velocity = (c1 * particle_best + c2 * global_best - 2 * np.dot(r1, r2) * global_best)
        return velocity

    def update_position(particle, velocity, lb, ub):
        new_particle = particle + velocity
        clipped_particle = clip(new_particle)
        return clipped_particle

    c1 = 0.5
    c2 = 0.3
    population_size = 50
    num_generations = budget // (dim * population_size)

    initial_population = generate_initial_population(population_size, dim, lb, ub)
    fitness = evaluate(initial_population)
    best_particle = np.argmin(fitness)
    global_best = clip(initial_population[best_particle])

    for generation in range(num_generations):
        for i in range(population_size):
            particle_best = clip(initial_population[i])
            velocity = np.zeros(dim)
            for j in range(dim):
                velocity[j] = update_velocity(particle_best, global_best, velocity[j], c1, c2)
            new_particle = update_position(initial_population[i], velocity, lb, ub)

            if func(new_particle) < func(global_best):
                global_best = clip(new_particle)
            initial_population[i] = new_particle

        fitness = evaluate(initial_population)
        best_particle = np.argmin(fitness)
        global_best = clip(initial_population[best_particle])

    return global_best
