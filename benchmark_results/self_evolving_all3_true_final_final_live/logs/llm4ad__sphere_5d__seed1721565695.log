def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    x = np.random.uniform(lb, ub, size=dim)
    y = np.copy(x)
    
    for _ in range(budget):
        v1 = np.random.uniform(-1, 1, size=dim)
        v2 = np.random.uniform(-1, 1, size=dim)
        
        x_new = clip(0.5 * (x + y) + rng.rand(dim) - 0.5)
        y_new = clip(x_new + v1 * (x - y) + rng.randn(dim))
        z_new = clip(y_new + v2 * (y - x) + rng.randn(dim))
        
        f_x = func(clip(x))
        f_y = func(clip(y))
        f_z = func(clip(z_new))
        
        if f_z < np.minimum(f_x, f_y):
            x = y = z_new
        elif f_z > np.minimum(f_x, f_y):
            x_new, y_new = y, x_new
            v1 = -v1
            
        x, y = x_new, y_new
    
    return clip(x)
