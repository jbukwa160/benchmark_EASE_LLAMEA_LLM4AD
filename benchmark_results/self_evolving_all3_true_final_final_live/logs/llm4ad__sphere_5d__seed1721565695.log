def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def gradient(x):
        grad = np.zeros(dim)
        for i in range(dim):
            x[i] += 1e-8
            grad[i] = (func(clip(x)) - func(clip(x - 1e-8))) / 2e-8
            x[i] -= 1e-8
        return grad

    def adaptive_lr(lr, step):
        if step < budget * 0.2:
            return lr * 0.9
        elif step < budget * 0.5:
            return lr * 0.95
        else:
            return lr * 1.05

    x = rng.uniform(lb, ub, size=dim)
    best_x = clip(x)
    best_f = func(best_x)

    for _ in range(budget):
        g = gradient(clip(x))
        step_size = adaptive_lr(0.01, _ + 1)
        x += step_size * g
        new_f = func(clip(x))
        if new_f < best_f:
            best_x = clip(x)
            best_f = new_f

    return best_x
