def algorithm(func, dim, lb, ub, budget, rng):
    def grad(x):
        return 2*np.multiply(200*(x[1:]-np.power(x[:-1], 2)),-4*np.multiply(x[1:],x[:-1])-2*x[:-1])

    def grad_descent(x0, step_size, max_iter):
        x = np.copy(x0)
        for _ in range(max_iter):
            gradient = grad(x)
            x -= step_size * gradient
            # Clip to bounds
            x = np.clip(x, lb, ub)
        return x

    def grid_search(x0, num_points, step_size):
        best_x = np.copy(x0)
        best_f = func(best_x)
        for i in range(num_points):
            candidate = np.copy(x0) + rng.uniform(-step_size, step_size, dim)
            # Clip to bounds
            candidate = np.clip(candidate, lb, ub)
            f_candidate = func(candidate)
            if f_candidate < best_f:
                best_f = f_candidate
                best_x = np.copy(candidate)
        return best_x

    x0 = rng.uniform(lb, ub, dim)
    num_local_searches = int(np.ceil(budget / 10))
    for _ in range(num_local_searches):
        x_best = grid_search(x0, 1000, 1e-3)
        x0 = np.copy(grad_descent(x_best, 1e-2, 100))

    return x0
