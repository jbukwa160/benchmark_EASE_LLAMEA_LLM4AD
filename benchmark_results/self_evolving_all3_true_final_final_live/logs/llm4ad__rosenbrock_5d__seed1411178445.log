def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=(1, dim))
    y_best = func(x)
    learning_rate = 1.0
    n_iter = 0

    while n_iter < budget:
        x_new = x + rng.normal(size=x.shape) * learning_rate
        x_new = clip(x_new)

        y_new = func(x_new)
        if y_new < y_best:
            y_best = y_new
            x = x_new

        # adaptive learning rate update
        std_dev = np.std(np.abs(rng.normal(size=x.shape)))
        learning_rate *= 0.5 if std_dev > 1e-3 else (1 + rng.uniform(0, 0.2))

        n_iter += 1

    return x
