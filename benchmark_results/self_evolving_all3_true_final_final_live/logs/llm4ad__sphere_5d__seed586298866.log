def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def generate_initial_population(dim):
        population = np.random.rand(budget, dim)
        for i in range(budget):
            population[i] += (ub - lb) * np.random.uniform(size=dim)
        return population

    def calculate_velocity(population, p_best, global_best):
        velocity = np.zeros((budget, dim))
        for i in range(budget):
            velocity[i] = 0.5 * (p_best[i] + global_best - population[i]) + 0.5 * rng.normal(size=dim)
        return clip(velocity, lb, ub)

    def update_population(population, velocity):
        new_population = np.copy(population) + velocity
        for i in range(budget):
            if func(new_population[i]) < func(population[i]):
                population[i] = new_population[i]
        return clip(population, lb, ub)

    def differential_evolution(population, global_best):
        mutation = np.zeros((budget, dim))
        for i in range(budget):
            indices = np.random.choice(budget, 3, replace=False)
            mutation[i] = (population[indices[0]] - population[indices[1]]) + \
                          (population[indices[2]] - global_best)
            mutation[i] /= 6.0
        return clip(mutation, lb, ub)

    def adapt_mutation(population):
        mutation_rates = np.zeros(budget)
        for i in range(budget):
            mutation_rates[i] = func(np.copy(population[i]) + rng.normal(size=dim)) - func(population[i])
        return np.mean(mutation_rates) > 0

    population = generate_initial_population(dim)
    global_best = np.copy(population[0])
    p_best = np.copy(population)

    for _ in range(budget):
        velocity = calculate_velocity(population, p_best, global_best)
        if adapt_mutation(p_best):
            mutation = differential_evolution(p_best, global_best)
            population += mutation
            for i in range(budget):
                p_best[i] = np.copy(population[i])
        else:
            population = update_population(population, velocity)

    return np.mean(population[np.argmin([func(x) for x in population])], axis=0)
