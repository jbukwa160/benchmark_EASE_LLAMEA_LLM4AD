def algorithm(func, dim, lb, ub, budget, rng):
    if not isinstance(rng, np.random.RandomState):
        rng = np.random.default_rng(rng)

    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)
    
    gradient_directions = [rng.normal(size=dim, loc=0.0, scale=1.0)]
    
    for _ in range(budget - 1):
        sigma = (ub - lb) / budget
        x_new = clip(x_best + rng.uniform(0.0, 1.0) * np.array(gradient_directions[-1]))
        
        f_new = func(x_new)
        
        if f_new < f_best:
            gradient_directions.append(rng.normal(size=dim, loc=x_best - x_new, scale=sigma))
            f_best = f_new
            x_best = x_new
            
    return x_best
