def algorithm(func, dim, lb, ub, budget, rng):
    X = np.random.uniform(lb, ub, size=(budget, dim))
    Y = np.zeros(budget)
    for i in range(1, budget):
        X_new = np.clip(X[i-1] + 0.05 * np.sign(np.random.normal(size=dim)) * np.random.normal(size=dim), lb, ub)
        Y[i] = func(X_new)
        if Y[i] < Y[i-1]:
            X[i:] = X_new
    return X[np.argmin(Y)]
