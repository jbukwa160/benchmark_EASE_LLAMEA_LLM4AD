def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    current_best = func(clip(x))

    T = 1000.0
    cooling_rate = 0.99

    for _ in range(budget):
        for i in range(dim):
            new_x = clip(x.copy())
            new_x[i] += rng.uniform(-1, 1)

            f_new = func(new_x)
            if f_new < current_best:
                x = new_x
                current_best = f_new

            acceptance_prob = np.exp((current_best - f_new) / T)
            if rng.random() < acceptance_prob:
                x = new_x
                current_best = f_new

        T *= cooling_rate

    return best_x.copy()
