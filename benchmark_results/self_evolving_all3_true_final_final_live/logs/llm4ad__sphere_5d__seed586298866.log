def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def generate_initial_simplex(dim):
        simplex = np.random.rand(1 + dim, dim)
        for i in range(1, 1 + dim):
            simplex[i] += simplex[0]
        return simplex

    def calculate_distance(x, y):
        return np.linalg.norm(x - y)

    def calculate_centroid(simplex):
        return np.mean(simplex, axis=0)

    def shrink_simplex(simplex, x_best):
        centroid = calculate_centroid(simplex)
        for i in range(1 + dim):
            simplex[i] -= 2 * (simplex[i] - centroid) / (dim + 1)
        return clip(simplex, lb, ub)

    def expand_simplex(simplex, x_best):
        centroid = calculate_centroid(simplex)
        for i in range(1 + dim):
            simplex[i] += 2 * (centroid - simplex[i]) / (dim + 1)
        return clip(simplex, lb, ub)

    def reflect_simplex(simplex, x_best):
        centroid = calculate_centroid(simplex)
        reflected_point = centroid + 2 * (centroid - simplex[0])
        return clip(reflected_point, lb, ub)

    def contract_simplex(simplex, x_best):
        centroid = calculate_centroid(simplex)
        contracted_point = centroid
        for i in range(1, 1 + dim):
            if func(simplex[i]) < func(x_best):
                contracted_point += (simplex[i] - centroid) / (i + 1)
        return clip(contracted_point, lb, ub)

    def simulated_annealing(func, x0, T_init, cooling_rate, budget):
        x_best = x0
        current_T = T_init
        for _ in range(budget):
            new_x = np.copy(x0) + rng.normal(size=dim)
            new_x = clip(new_x, lb, ub)
            delta_f = func(new_x) - func(x_best)
            if delta_f < 0 or (delta_f >= 0 and current_T > func(new_x)):
                x_best = new_x
                current_T *= cooling_rate
        return x_best

    def nelder_mead_simplex(func, x0, lb, ub, budget):
        simplex = generate_initial_simplex(dim)
        for _ in range(budget):
            centroid = calculate_centroid(simplex)
            reflected_point = reflect_simplex(simplex, centroid)
            if func(reflected_point) < func(centroid):
                expanded_point = expand_simplex(simplex, centroid)
                if func(expanded_point) < func(reflected_point):
                    simplex[0] = expanded_point
                else:
                    simplex = shrink_simplex(simplex, centroid)
            else:
                contracted_point = contract_simplex(simplex, centroid)
                if func(contracted_point) < func(centroid):
                    simplex[0] = contracted_point
                else:
                    simplex = shrink_simplex(simplex, centroid)
        return np.mean(simplex, axis=0)

    x_best_sa = simulated_annealing(func, rng.uniform(lb, ub, size=dim), 100.0, 0.99, budget // 2)
    x_best_nm = nelder_mead_simplex(func, rng.uniform(lb, ub, size=dim), lb, ub, budget // 2)

    if func(x_best_sa) < func(x_best_nm):
        return x_best_sa
    else:
        return x_best_nm
