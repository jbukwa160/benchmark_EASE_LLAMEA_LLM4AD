def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x)

    # Initialize population and temperature
    pop_size = 100
    x = np.random.uniform(lb, ub, (pop_size, dim))
    temp = 1.0

    for i in range(budget):
        # Evaluate fitness
        fitness = np.array([evaluate(clip(x[i], lb, ub)) for i in range(pop_size)])

        # Differential Evolution
        F = 0.5
        CR = 0.9
        a, b, c = rng.choice(pop_size, 3, replace=False)
        u = x[a] + F * (x[b] - x[c])
        v = np.where(rng.uniform(0, 1, dim) < CR, u, x[a])

        # Simulated Annealing
        k = int(np.exp(-i / budget))
        for j in range(pop_size):
            if rng.random() < temp:
                e = clip(v[j], lb, ub)
                if evaluate(e) > fitness[j]:
                    x[j] = e
                    fitness[j] = evaluate(e)

        # Update temperature
        temp *= np.exp(-1 / budget + i * 0.01)

    return x[np.argmin(fitness)]
