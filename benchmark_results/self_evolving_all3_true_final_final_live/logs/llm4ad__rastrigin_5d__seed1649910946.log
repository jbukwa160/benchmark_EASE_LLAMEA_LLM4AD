def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.minimum(np.maximum(x, lb), ub)

    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_candidate = x_best + 0.1 * (ub - lb) * rng.randn(dim)
        x_candidate = clip(x_candidate, lb, ub)
        
        f_candidate = func(x_candidate)
        
        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate

    return x_best
