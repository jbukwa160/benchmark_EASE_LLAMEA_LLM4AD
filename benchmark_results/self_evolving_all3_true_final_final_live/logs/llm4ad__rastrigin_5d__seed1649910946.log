def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    n_samples = int(np.ceil(budget ** (1 / 2)))
    step_size = (ub - lb) * 0.5
    for _ in range(n_samples):
        x = np.clip(lb + rng.uniform(0, 1, dim) * (ub - lb), lb, ub)
        f = func(x)
        if f < f_best:
            f_best = f
            x_best = x.copy()
        step_size *= 0.9
    return x_best
