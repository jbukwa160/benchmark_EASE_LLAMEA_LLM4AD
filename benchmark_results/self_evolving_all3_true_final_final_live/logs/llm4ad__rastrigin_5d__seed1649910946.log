def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    y = np.copy(x)

    for _ in range(budget):
        v = rng.uniform(lb, ub, size=dim)
        u = np.copy(y)

        for i in range(dim):
            t1 = 2 * rng.rand() - 1
            t2 = 2 * rng.rand() - 1

            if (rng.rand() < 0.5) or (t1 == 0 and t2 == 0):
                u[i] += t1 * 0.05 * (ub[i] - lb[i])
                v[i] -= t2 * 0.05 * (ub[i] - lb[i])

            if i > 0:
                u[i] = np.clip(u[i], lb, ub)
                v[i] = np.clip(v[i], lb, ub)

        fu = func(u)
        fv = func(v)

        if fv < fu:
            y = np.copy(u)
            x = np.copy(y)

    return x
