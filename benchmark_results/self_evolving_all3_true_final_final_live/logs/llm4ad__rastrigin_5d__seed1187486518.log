def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    D = dim
    n_particles = 20
    crossover_rate = 0.5
    adaptivity_threshold = 1e-2

    particles = np.random.uniform(lb, ub, (n_particles, D))
    simplex = None
    best_candidate = clip(particles[0])
    best_value = func(best_candidate)

    for _ in range(budget):
        # Particle swarm optimization
        velocities = np.zeros((n_particles, D))
        for i in range(n_particles):
            velocities[i] = rng.uniform(-1, 1, size=D)
        particles += velocities

        particles = clip(particles)

        # Evaluate and update best candidate
        for i in range(n_particles):
            value = func(clip(particles[i]))
            if value < best_value:
                best_candidate = particles[i]
                best_value = value

        # Adaptive crossover rate
        success_rate = (best_value - func(best_candidate)) / func(best_candidate)
        if success_rate > adaptivity_threshold and rng.random() < 0.5:
            crossover_rate *= 2

        # Nelder-Mead simplex algorithm to refine promising solutions
        for i in range(n_particles):
            if func(clip(particles[i])) <= best_value * (1 - crossover_rate / 10):
                if simplex is None or len(simplex) < D + 1:
                    simplex = np.array([particles[i]])
                else:
                    simplex = np.vstack((simplex, particles[i]))
                break

        # Update simplex
        if simplex is not None and len(simplex) == D + 1:
            centroid = np.mean(simplex, axis=0)
            sorted_simplex = simplex[np.argsort(np.linalg.norm(simplex - centroid, axis=1))]
            simplex = sorted_simplex[:D]

    return best_candidate
