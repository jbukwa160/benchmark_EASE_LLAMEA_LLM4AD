def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = np.inf
    alpha = 1.0 / (np.sqrt(budget) * rng.randn())
    beta = 10.0

    for t in range(1, budget + 1):
        x = rng.uniform(lb, ub, size=dim)
        
        f = func(x)

        if f < best_f:
            best_x = x
            best_f = f

        grad = np.zeros(dim)
        for i in range(dim):
            e_i = rng.randn()
            x_plus_e_i = x.copy()
            x_plus_e_i[i] += alpha * e_i
            
            if lb <= x_plus_e_i[i] <= ub:
                f_plus_e_i = func(x_plus_e_i)

                grad[i] = (f_plus_e_i - f) / alpha

        s = np.zeros(dim)
        for i in range(dim):
            s[i] = rng.uniform(-1, 1)
            if np.dot(s, grad) > 0:
                s[i] *= -1
        x_new = x + beta * s

        for i in range(dim):
            x_new[i] = min(max(x_new[i], lb), ub)

    return best_x
