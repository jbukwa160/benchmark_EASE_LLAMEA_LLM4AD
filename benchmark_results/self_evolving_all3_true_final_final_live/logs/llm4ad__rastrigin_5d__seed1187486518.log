def algorithm(func, dim, lb, ub, budget, rng):
    def sample_gaussian(mean, cov):
        return mean + rng.normal(size=(dim,)) @ np.sqrt(cov)

    def gaussian_process(x, y):
        n = len(y)
        K = np.zeros((n+1, n))
        for i in range(n):
            K[i] = np.exp(-np.sum((x - x[i])**2) / (2 * 5**2))
        L = np.linalg.cholesky(np.eye(n) + K @ K.T)
        mu = np.zeros(n)
        s2 = np.exp(1)
        return mu, L, s2

    def acquisition_function(x):
        mean, L, s2 = gaussian_process(x, [func(x)])
        return func(x)

    x_best = np.random.uniform(lb, ub, size=(dim,))
    y_best = func(x_best)
    budget_used = 1
    cov = 10

    while budget_used < budget:
        new_x = sample_gaussian(x_best, cov)
        clipped_new_x = np.clip(new_x, lb, ub)

        if func(clipped_new_x) < y_best:
            x_best = clipped_new_x
            y_best = func(clipped_new_x)
            budget_used += 1

        else:
            alpha = rng.uniform(0, 1)
            acceptance_prob = np.exp((func(x_best) - func(clipped_new_x)) / cov)
            if alpha < acceptance_prob or rng.uniform(0, 1) < 0.01:
                x_best = clipped_new_x
                y_best = func(clipped_new_x)
                budget_used += 1

        cov *= 0.99

    return x_best
