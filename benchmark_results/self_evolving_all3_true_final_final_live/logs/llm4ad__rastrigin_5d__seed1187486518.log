def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    x_best = np.random.uniform(lb, ub, size=n)
    f_best = func(x_best)

    for i in range(budget - 1):
        directions = np.random.normal(size=(n, n))
        for j in range(n):
            if np.all(directions[:, j] == 0):
                directions[j, j] = 1

        cov_matrix = np.cov(np.dot(directions, rng.randn(n)))
        eigenvalues, eigenvectors = np.linalg.eig(cov_matrix)
        idx = np.argsort(eigenvalues)[::-1]
        best_direction = eigenvectors[:, idx[:2]].real
        candidate = x_best + 0.5 * best_direction

        # Clip candidates to [lb, ub]
        candidate = np.clip(candidate, lb, ub)

        f_candidate = func(candidate)
        if f_candidate < f_best:
            x_best = candidate
            f_best = f_candidate

    return x_best
