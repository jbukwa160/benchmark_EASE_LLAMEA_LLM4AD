def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_pop = 50
    f = func

    x_init = (ub - lb) * rng.rand(n_pop, D) + lb

    best_x = None
    best_f = float('inf')

    for _ in range(budget):
        pop = np.zeros((n_pop, D))
        fit = np.zeros(n_pop)
        for i in range(n_pop):
            pop[i] = x_init[i]
            fit[i] = f(pop[i])

        for i in range(n_pop):
            r1, r2, r3 = rng.choice(range(n_pop), 3, replace=False)
            v = pop[r1] + rng.uniform(-0.5, 0.5) * (pop[r2] - pop[r3])
            if not np.any(v < lb) and not np.any(v > ub):
                v_new = v
            else:
                v_new = np.clip(v, lb, ub)
            fit_new = f(v_new)
            if fit_new < fit[r1]:
                pop[r1] = v_new
                fit[r1] = fit_new

        best_idx = np.argmin(fit)
        if fit[best_idx] < best_f:
            best_x = pop[best_idx]
            best_f = fit[best_idx]

    return best_x
