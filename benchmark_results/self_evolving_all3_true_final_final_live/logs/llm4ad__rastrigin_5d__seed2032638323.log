def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    x_best = clip(x.copy())
    f_best = func(x_best)

    p = 1 / (np.log(2) * (budget - 1))

    for i in range(budget):
        y = x + rng.normal(size=dim, scale=p)
        y = clip(y)
        f_y = func(y)

        if f_y < f_best:
            x_best = y.copy()
            f_best = f_y

        p *= np.exp(-1 / (i + 2))

    return x_best
