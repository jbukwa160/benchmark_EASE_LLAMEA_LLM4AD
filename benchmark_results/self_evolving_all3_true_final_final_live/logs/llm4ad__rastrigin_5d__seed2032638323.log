def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_solution = None
    best_fitness = float('inf')

    for _ in range(budget):
        solution = rng.uniform(lb, ub, size=dim)
        fitness = func(solution)

        if fitness < best_fitness:
            best_fitness = fitness
            best_solution = clip(solution)

        # Perform local search around the current best solution
        solution_local = np.copy(best_solution)
        for i in range(dim):
            perturbation = rng.uniform(-1, 1)
            solution_local[i] += perturbation
            solution_local = clip(solution_local)
            fitness_local = func(solution_local)
            if fitness_local < best_fitness:
                best_fitness = fitness_local
                best_solution = np.copy(solution_local)

        # Perform random restarts to escape local optima
        if rng.uniform(0, 1) < 0.1:
            solution_restart = rng.uniform(lb, ub, size=dim)
            fitness_restart = func(clip(solution_restart))
            if fitness_restart < best_fitness:
                best_fitness = fitness_restart
                best_solution = np.copy(solution_restart)

    return best_solution
