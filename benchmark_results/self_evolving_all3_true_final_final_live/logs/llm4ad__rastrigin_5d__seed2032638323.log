def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def local_search(candidate):
        current = candidate.copy()
        for _ in range(1000):
            step_size = 0.01 * (ub - lb)
            delta = np.random.uniform(-step_size, step_size, dim)
            new_candidate = clip(current + delta)
            if func(new_candidate) < func(current):
                current = new_candidate
        return current

    population_size = int(np.sqrt(budget))
    population = rng.uniform(lb, ub, (population_size, dim))

    for _ in range(int(budget / population_size)):
        objectives = np.array([func(x) for x in population])
        sorted_indices = np.argsort(objectives)
        top_two = sorted_indices[:2]

        parent1 = clip(population[top_two[0]])
        parent2 = clip(population[top_two[1]])

        crossover_rate = 0.5 / (1 + objectives[top_two[1]] - objectives[top_two[0]])**2
        candidate = parent1.copy()
        for i in range(dim):
            if rng.random() < crossover_rate:
                candidate[i] = np.random.uniform(parent1[i], parent2[i])

        candidate = local_search(candidate)
        population[top_two[0]] = candidate

    best_candidate = clip(population[np.argmin(objectives)])
    return best_candidate
