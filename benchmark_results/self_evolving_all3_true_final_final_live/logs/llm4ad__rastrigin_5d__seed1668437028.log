def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    D = 0.7
    CR = 0.9

    population = rng.uniform(lb, ub, (pop_size, dim))

    for _ in range(budget):
        target = np.min([func(pop) for pop in population])
        if target == 0:
            return np.zeros(dim)

        fit = [func(pop) for pop in population]
        best_idx = np.argmin(fit)
        best_pop = population[best_idx]

        mutated_pops = []
        for i in range(pop_size):
            idxs = rng.choice(range(pop_size), size=3, replace=False)
            if i == best_idx:
                idxs[0] = (idxs[0] + 1) % pop_size
            v = population[idxs[0]] + D * (population[idxs[1]] - 2 * population[idxs[2]])
            mutated_pops.append(v)

        trial_pops = []
        for i in range(pop_size):
            if rng.rand() < CR:
                idx = i
                while idx == best_idx or idx == i:
                    idx = rng.randint(0, pop_size - 1)
                trial_pops.append(mutated_pops[idx])
            else:
                trial_pops.append(best_pop)

        population[:] = np.clip(trial_pops, lb, ub)

    return population[np.argmin([func(pop) for pop in population])]
