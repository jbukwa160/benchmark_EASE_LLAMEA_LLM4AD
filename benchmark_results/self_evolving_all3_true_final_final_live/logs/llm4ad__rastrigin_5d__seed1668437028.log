def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    sigma = 0.5
    step_size = 1e-3
    c1 = 2.38 / (dim ** 0.5 + 1)

    for _ in range(budget):
        y = func(x)
        v = rng.normal(size=dim) * sigma

        # Step-size adaptation
        if np.random.rand() < 0.01:
            sigma *= np.exp(np.random.uniform(-0.3, -0.1))

        # Selection
        z = x + v
        z = np.clip(z, lb, ub)

        # Evaluation and update
        y_new = func(z)
        if y_new < y:
            x = z
            sigma *= 2
            step_size *= 0.5

    return np.array(x)
