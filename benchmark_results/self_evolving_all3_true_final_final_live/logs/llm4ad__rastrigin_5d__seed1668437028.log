def algorithm(func, dim, lb, ub, budget, rng):
    X = np.random.uniform(lb, ub, size=(budget, dim))
    Y = func(X)
    
    best_x = None
    best_y = np.inf
    
    for i in range(budget):
        x_new = X[i]
        
        if Y[i] < best_y:
            best_x = x_new
            best_y = Y[i]
        
        # Bayesian optimization step
        mu, sigma = 0.1 * np.ones(dim), 1.5 * np.eye(dim)
        
        def surrogate(x):
            return func(np.clip(x, lb, ub)) + np.random.normal(0, 0.2, size=dim)
        
        for _ in range(50):
            x_new = mu + sigma @ rng.normal(size=(1, dim))
            x_new = np.clip(x_new, lb, ub)
            
            if surrogate(x_new) < best_y:
                mu, sigma = mu + 0.5 * (x_new - mu), sigma + 0.2 * (np.outer(x_new - mu, x_new - mu) - sigma)
    
    return best_x
