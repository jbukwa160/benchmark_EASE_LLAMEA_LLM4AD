def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = np.zeros(dim)
        
        # Random sampling with perturbation
        for i in range(dim):
            x[i] = (ub - lb) * rng.uniform(0, 1) + lb
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x.copy()
        
        # Local search
        for _ in range(budget // dim):
            for i in range(dim):
                x_try = np.copy(x)
                dx = 0.1 * (ub - lb) * rng.uniform(-1, 1)
                x_try[i] += dx
                
                f_try = func(x_try)
                
                if f_try < best_f:
                    best_f = f_try
                    best_x = x_try.copy()
                    
            # Clip candidates to [lb, ub]
            for i in range(dim):
                x[i] = max(min(x[i], ub), lb)
    
    return best_x
