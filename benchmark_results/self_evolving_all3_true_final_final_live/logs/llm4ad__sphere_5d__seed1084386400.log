def algorithm(func, dim, lb, ub, budget, rng):
    mu = 1e-4 * np.ones(dim)
    sigma = 0.5
    cmu = np.eye(dim)
    ccov = np.eye(dim) * 1e-3
    ccov_inv = np.linalg.inv(ccov)
    budget_count = 0

    while budget_count < budget:
        y = func(mu)
        
        if rng.rand() < 0.5:
            sigma *= 0.9
        
        for i in range(dim):
            ci = rng.randn(dim)
            chi = mu + sigma * np.dot(cmu, ci)
            yi = func(chi)
            
            if yi < y:
                cmu += (chi - mu) * ci
                ccov += (chi - mu) * (chi - mu).dot(ci)
                y = yi
        
        if rng.rand() < 0.5:
            sigma *= 1.01
        
        budget_count += 1

    best_mu = np.clip(mu, lb, ub)
    return best_mu
