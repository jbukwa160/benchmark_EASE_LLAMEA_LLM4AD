def algorithm(func, dim, lb, ub, budget, rng):
    def generate_init_population(size, dim, lb, ub):
        return (ub - lb) * rng.random((size, dim)) + lb

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    best = None
    max_budget = 0
    for _ in range(10): # number of random restarts
        population_size = 20
        sigma = 1.0
        c_m = 1.0
        mu = generate_init_population(population_size, dim, lb, ub)
        budget_reached = False
        while not budget_reached:
            for i in range(population_size):
                x_new = clip(mu[i] + rng.normal(0, sigma), lb, ub)
                f_x_new = func(x_new)
                if (f_x_new < func(mu[i])) and (not budget_reached):
                    mu[i] = x_new
                    if f_x_new < func(best):
                        best = x_new.copy()
            for i in range(population_size):
                x_new = clip(mu[i] + rng.normal(0, sigma * c_m), lb, ub)
                f_x_new = func(x_new)
                if (f_x_new < func(mu[i])) and (not budget_reached):
                    mu[i] = x_new
            sigma *= 1 - 1 / (5 + population_size)
            max_budget += 1
            if max_budget >= budget:
                budget_reached = True
    return best
