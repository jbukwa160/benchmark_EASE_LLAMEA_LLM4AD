def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lower, upper):
        return np.clip(candidate, lower, upper)

    population_size = int(budget ** 0.5)
    population = rng.uniform(lb, ub, (population_size, dim))
    best_solution = None
    best_value = float('inf')

    iteration = 0

    while budget > 0:
        iteration += 1
        for i in range(population_size):
            candidate = clip(population[i] + rng.normal(0, 0.1, (dim)), lb, ub)
            value = func(candidate)

            if value < best_value:
                best_solution = candidate
                best_value = value

            if rng.uniform(0, 1) > np.exp(-iteration / 100):
                population[i] = clip(candidate + rng.normal(0, 1, (dim)), lb, ub)
        budget -= 1

    return best_solution
