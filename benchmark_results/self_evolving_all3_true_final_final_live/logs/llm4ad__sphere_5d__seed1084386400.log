def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    std_dev = 1.0
    
    for t in range(1, budget + 1):
        if t % (budget // 10) == 0:
            std_dev *= 0.9
        
        x_candidate = x_best + rng.normal(size=dim) * std_dev
        
        for i in range(dim):
            x_candidate[i] = np.clip(x_candidate[i], lb, ub)
        
        f_candidate = func(x_candidate)
        
        if f_candidate < f_best:
            f_best = f_candidate
            x_best = x_candidate
    
    return x_best
