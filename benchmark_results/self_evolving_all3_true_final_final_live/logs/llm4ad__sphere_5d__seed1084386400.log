def algorithm(func, dim, lb, ub, budget, rng):
    D = len(dim)
    num_particles = int(np.sqrt(budget))
    max_iter = int(budget / num_particles)

    # Initialize particles using LHS and K-Means++
    particles = np.zeros((num_particles, D))
    centroids = np.random.rand(num_particles, D)
    for i in range(max_iter):
        indices = rng.choice(num_particles, size=D, replace=False)
        points = []
        for j in indices:
            points.append(centroids[j])
        points = np.array(points)
        for k in range(D):
            min_dist = float('inf')
            for l in range(num_particles):
                dist = distance.euclidean(points[k], centroids[l])
                if dist < min_dist:
                    min_dist = dist
                    idx = l
            particles[idx, k] = points[k]

    # Initialize velocity and acceleration coefficients
    velocities = np.zeros((num_particles, D))
    c1 = rng.uniform(0.5, 2.0)
    c2 = rng.uniform(0.5, 2.0)

    for iter in range(max_iter):
        for i in range(num_particles):
            x = particles[i]
            v = velocities[i]

            # Evaluate objective function
            fx = func(x)

            # Update acceleration coefficients based on fitness
            c1 = max(c1 - (fx / budget), 0.5)
            c2 = max(c2 - (fx / budget), 0.5)

            # Update velocity and position
            r1, r2 = rng.random(2)
            v[i] += c1 * r1 * (x - lb) + c2 * r2 * (ub - x)
            v[i] *= np.clip(abs(v[i]) / max(np.abs(x - lb), np.abs(ub - x)), 0, 1)
            particles[i] = np.clip(x + v[i], lb, ub)

        # Update best position
        for i in range(num_particles):
            if func(particles[i]) < func(particles[0]):
                particles[0] = particles[i]

    return np.array([func(particles[0])] * D)
