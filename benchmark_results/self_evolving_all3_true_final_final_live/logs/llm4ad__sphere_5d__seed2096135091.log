def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(dim, lb, ub):
        return lb + (ub - lb) * rng.rand(dim)

    def accept(candidate, current_best, T):
        if func(candidate) < func(current_best):
            return candidate
        else:
            prob = np.exp(-(func(candidate) - func(current_best)) / T)
            return current_best if rng.rand() > prob else candidate

    best_candidate = generate_candidate(dim, lb, ub)
    for i in range(budget):
        candidate = generate_candidate(dim, lb, ub)
        new_candidate = accept(candidate, best_candidate, 1.0 - (budget - i) / budget)
        best_candidate = new_candidate
    return best_candidate
