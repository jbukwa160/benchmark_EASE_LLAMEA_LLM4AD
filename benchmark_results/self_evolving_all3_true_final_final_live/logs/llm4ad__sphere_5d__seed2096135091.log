def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, (1, dim))
    f_best = func(x_best)
    candidates = []
    
    for _ in range(budget):
        sigma = 0.5 * (ub - lb) / np.sqrt(_ + 1)
        cov = np.eye(dim) * (sigma ** 2)
        
        x_new = rng.multivariate_normal(x_best.flatten(), cov, size=100).T
        
        f_new = func(np.clip(x_new, lb, ub))
        
        indices = np.argsort(f_new)
        
        for i in indices:
            if f_new[i] < f_best and np.random.rand() < 1 / (_ + 2):
                x_best = x_new[i]
                f_best = f_new[i]
                
                candidates.append(x_best)
                break
                
    return np.array([x_best])
