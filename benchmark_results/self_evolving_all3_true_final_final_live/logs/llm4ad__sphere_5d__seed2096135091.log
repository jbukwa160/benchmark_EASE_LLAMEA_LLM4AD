def algorithm(func, dim, lb, ub, budget, rng):
    current = np.full(dim, 0)
    best = np.copy(current)
    temperature = 1.0
    sigma = 5.0

    for i in range(budget):
        noise = rng.normal(0, sigma, size=dim)
        candidate = current + noise
        candidate = np.clip(candidate, lb, ub)

        if func(candidate) < func(best):
            best = candidate

        delta = func(candidate) - func(current)
        probability = np.exp(-delta / temperature)

        if rng.uniform(0, 1) < probability:
            current = candidate

        temperature *= 0.99
        sigma *= 0.999

    return best
