def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    best_score = np.inf
    
    for _ in range(budget):
        candidate = (ub - lb) * rng.rand(dim) + lb
        score = func(candidate)
        
        if score < best_score:
            best_score = score
            best = candidate
            
    return best
