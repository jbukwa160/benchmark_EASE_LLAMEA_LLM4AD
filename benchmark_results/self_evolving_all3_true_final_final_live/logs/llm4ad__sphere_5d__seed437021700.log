def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    current = rng.uniform(lb, ub, size=dim)
    best = current.copy()
    temperature = 1.0
    T_min = 0.01

    for _ in range(budget):
        new = current + rng.uniform(-temperature, temperature, size=dim)
        new = clip(new)

        if func(new) < func(best):
            best = new.copy()

        if np.random.rand() < np.exp((func(current) - func(best)) / temperature):
            current = new.copy()
        
        temperature *= 0.99

    return best
