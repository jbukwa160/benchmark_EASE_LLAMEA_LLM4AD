def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    T = 1.0
    best_x = np.copy(x)

    for _ in range(budget):
        new_x = np.copy(x)
        for i in range(dim):
            if rng.random() < 0.01:
                new_x[i] += (ub - lb) * (rng.random() - 0.5) * 2
                new_x[i] = max(lb, min(ub, new_x[i]))

        f_new = func(new_x)
        f_best = func(best_x)

        if f_new < f_best:
            best_x = np.copy(new_x)

        alpha = (budget - _ + 1) / budget
        T *= np.exp(-alpha * rng.random())

    return best_x
