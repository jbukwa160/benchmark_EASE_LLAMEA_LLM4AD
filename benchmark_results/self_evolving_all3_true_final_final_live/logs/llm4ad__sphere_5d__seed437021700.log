        for i in range(dim):
            step_size = 0.1 * (ub - lb) * rng.uniform(-1, 1)
            candidate = x.copy()
            candidate[i] += step_size
            clipped_candidate = np.clip(candidate, lb, ub)
            if func(clipped_candidate) < func(x):
                x = clipped_candidate
    return x
