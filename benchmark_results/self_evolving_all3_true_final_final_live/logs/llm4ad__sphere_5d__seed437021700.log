def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(x, sigma):
        return x + sigma * (ub - lb) * rng.rand(dim)

    def acceptance_probability(f_new, f_current, T):
        if f_new < f_current:
            return 1
        else:
            return np.exp(-(f_new - f_current) / T)

    x = np.array([0.0] * dim)
    best_x = x.copy()
    T = 10.0
    sigma_max = 5.0
    sigma_min = 0.01
    sigma = sigma_max

    for i in range(budget):
        new_x = generate_candidate(x, sigma)
        clipped_new_x = np.clip(new_x, lb, ub)
        f_new = func(clipped_new_x)

        if f_new < func(best_x):
            best_x = clipped_new_x
            T *= 0.9999

        p = acceptance_probability(f_new, func(x), T)
        if rng.rand() < p:
            x = clipped_new_x

        sigma = max(sigma * 0.99, sigma_min)

    return best_x
