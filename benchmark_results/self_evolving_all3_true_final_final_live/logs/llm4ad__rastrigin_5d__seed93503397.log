def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(dim, lb, ub, rng):
        population = np.zeros((budget, dim))
        for i in range(budget):
            population[i] = rng.uniform(lb, ub, size=dim)
        return population

    def rastrigin_func(x):
        n = len(x)
        return 10*n + sum([xi**2 - 10*np.cos(2*np.pi*xi) for xi in x])

    population = generate_initial_population(dim, lb, ub, rng)

    best_solution = population[0]
    best_fitness = rastrigin_func(best_solution)

    for _ in range(budget-1):
        # Differential Evolution step
        variation = 0.5 * (population[np.random.choice(range(budget), size=4, replace=False)] - np.random.uniform(lb, ub, size=(4, dim)))
        candidate = best_solution + variation.sum(axis=0)

        # Simulated Annealing step
        alpha = 0.9
        temperature = 1000
        current_fitness = rastrigin_func(candidate)
        if current_fitness < best_fitness:
            best_solution = candidate
            best_fitness = current_fitness
        else:
            probability = np.exp((best_fitness - current_fitness) / temperature)
            if rng.uniform(0, 1) < probability:
                best_solution = candidate
                best_fitness = current_fitness

        # Clip candidate to bounds
        candidate = clip(candidate, lb, ub)

        population = np.vstack([population, candidate])

    return best_solution
