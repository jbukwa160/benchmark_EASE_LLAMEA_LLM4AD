def algorithm(func, dim, lb, ub, budget, rng):
    def acquisition(x):
        mu, sigma = gp.predict(np.array([x]).T)
        return mu - 1.96 * sigma

    best_x = rng.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    gp = {'mean': lambda x: np.sum(x**2), 'cov': lambda x, y: np.eye(dim)}
    for _ in range(budget):
        x_new = acquisition(best_x)
        f_new = func(x_new)
        
        if f_new < best_f:
            best_f = f_new
            best_x = x_new

        gp['mean'] = lambda x: np.sum(x**2) + 1.96 * rng.randn(dim)
        for i in range(10):
            x_local = best_x + 0.01 * rng.normal(size=dim)
            x_local = np.clip(x_local, lb, ub)
            f_local = func(x_local)

            if f_local < best_f:
                best_f = f_local
                best_x = x_local

    return best_x
