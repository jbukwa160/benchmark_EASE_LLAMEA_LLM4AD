def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    N = int(budget / D)
    
    pop = np.zeros((N, D))
    pop[:, 0] = rng.uniform(lb[0], ub[0], size=N)

    for i in range(1, D):
        pop[:, i] = rng.uniform(lb[i], ub[i], size=N)

    x_best = pop.copy()
    f_best = np.inf
    gBest = f_best

    iter_count = 0
    while iter_count < N:
        iter_count += 1
        F = 0.5 + (0.3 - rng.uniform(0, 1))
        CR = 0.9 + 0.1*rng.uniform(0, 1)

        for i in range(N):
            if rng.random() > CR or np.all(pop[i] == x_best[i]):
                v = pop[i] + F * (x_best[i] - pop[i])
            else:
                idx = sorted(rng.sample(range(D), D//2))
                v = pop[i]
                for j in range(D):
                    if rng.random() > 0.5:
                        v[idx[j]] = pop[i, idx[j]]
                    else:
                        v[idx[j]] = x_best[i, idx[j]]

            v = np.clip(v, lb, ub)

            f = func(v)
            if f < gBest:
                gBest = f
                x_best = v

            if f < f_best:
                f_best = f
                best_individual = v.copy()

        pop = np.concatenate((pop[1:], [best_individual]))

    return best_individual
