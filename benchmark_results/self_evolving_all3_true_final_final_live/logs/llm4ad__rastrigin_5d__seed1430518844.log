def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_iter = budget // (D * 20)
    x_best = np.random.uniform(lb, ub, size=(1, D))
    f_best = func(x_best)

    for _ in range(n_iter):
        for d in range(D):
            sigma = np.sqrt((ub - lb) / 3)
            a = rng.normal(0, 1, size=(100, D)) * sigma
            x_new = x_best.copy()
            x_new[0, d] += a[:, d]
            x_new = np.clip(x_new, lb, ub)

            f_new = func(x_new)
            if f_new < f_best:
                f_best = f_new
                x_best = x_new

    return x_best
