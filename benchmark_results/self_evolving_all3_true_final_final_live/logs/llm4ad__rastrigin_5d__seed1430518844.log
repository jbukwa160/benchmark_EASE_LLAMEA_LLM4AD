def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget - 1):
        e = rng.normal(size=dim) * 0.01
        x_new = x + e

        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)

        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new
            
        step_size = 0.01
        for i in range(dim):
            e = rng.normal(size=dim) * step_size
            x_try = x + e
            # Clip candidates to [lb, ub]
            x_try = np.clip(x_try, lb, ub)
            
            f_try = func(x_try)

            if f_try < best_f:
                x = x_try.copy()

    return best_x
