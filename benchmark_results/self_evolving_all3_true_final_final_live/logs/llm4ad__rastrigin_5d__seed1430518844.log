def algorithm(func, dim, lb, ub, budget, rng):
    def gp_model(x_train, y_train, x_test):
        cov = 1 / (2 * rng) ** 2 * np.eye(dim)
        k = 1 / (2 * rng) ** 2
        var = 1 / (2 * rng) ** 2
        s = 10 * dim
        return lambda x: y_train + np.sqrt(var - cov) @ np.linalg.solve(cov, x_test - x_train) + k

    def ils(x):
        for _ in range(budget // dim):
            gp = gp_model(x[:dim], func(x), [x] * dim)
            new_x = x.copy()
            for i in range(dim):
                x_i = rng.uniform(lb, ub)
                y_gp = gp([x_i])
                if y_gp < func(new_x + [x_i]):
                    new_x[i] = x_i
            yield new_x

    best_x = None
    best_y = float('inf')
    for x in ils(rng.uniform(lb, ub, size=dim)):
        y = func(x)
        if y < best_y:
            best_y = y
            best_x = x
        if budget <= 0:
            break
        budget -= 1

    return np.clip(best_x, lb, ub)
