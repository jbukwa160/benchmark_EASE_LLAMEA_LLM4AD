def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def generate_candidate(best_sol, rng):
        candidate = best_sol + (ub - lb) * (rng.rand(dim) - 0.5)
        return clip(candidate, lb, ub)

    def perturb(solution, temp, rng):
        for i in range(dim):
            if rng.rand() < np.exp(-(func(solution) - func(best_sol)) / temp):
                solution[i] += (ub - lb) * (rng.rand() - 0.5)
                solution = clip(solution, lb, ub)
        return solution

    best_sol = (ub + lb) / 2 * rng.rand(dim)
    best_sol = clip(best_sol, lb, ub)

    for _ in range(budget):
        candidate = generate_candidate(best_sol, rng)
        if func(candidate) < func(best_sol):
            best_sol = candidate
        temp = max(1e-6, (ub - lb) / (_ + 1))
        perturbed_sol = perturb(np.copy(best_sol), temp, rng)
        if func(perturbed_sol) < func(best_sol):
            best_sol = perturbed_sol

    return best_sol
