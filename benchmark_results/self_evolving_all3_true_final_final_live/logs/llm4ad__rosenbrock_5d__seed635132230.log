def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_candidate = x_best + 0.5 * rng.normal(0, 1, size=dim)
        x_candidate[clip(np.cumsum(rng.normal(0, 0.2, size=dim-1), initial=x_candidate[0]))] += 0.2 * rng.normal(-1, 1)

        f_candidate = func(clip(x_candidate))

        if rng.random() < np.exp((f_best - f_candidate) / (1 + abs(f_candidate))):
            x_best = x_candidate
            f_best = f_candidate

    return clip(x_best)
