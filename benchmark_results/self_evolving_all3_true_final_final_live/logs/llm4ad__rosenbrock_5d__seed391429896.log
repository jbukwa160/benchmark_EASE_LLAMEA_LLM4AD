def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        z = rng.normal(size=x.shape)
        mu = 1 + (rng.rand() - 0.5) * 2
        v = x + mu * z
        
        v = clip(v)
        
        f_v = func(v)
        
        if f_v < best_f:
            best_x = v.copy()
            best_f = f_v
    
    return best_x
