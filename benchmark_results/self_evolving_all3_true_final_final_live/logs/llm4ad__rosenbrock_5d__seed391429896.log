def algorithm(func, dim, lb, ub, budget, rng):
    def func_grad(x):
        return np.array([2*100*(x[i+1]-x[i]**2)*(2*x[i]*(func(x)-func(x[1:]))+100*(x[i+1]-x[i]**2)) + 2*(x[i]-1)
                         for i in range(dim-1)]) + np.array([2*(x[-1]-1)])

    def Lipschitz_constant(func, x):
        return max(np.abs(func(np.array(x)+0.01))-func(np.array(x)), 0)

    cma = rng.uniform(-5, 5, size=(dim,))
    lambda_ = budget // dim
    mu = np.sqrt(lambda_)
    sigma = 1
    global_Lipschitz_constant = Lipschitz_constant(func, cma)
    for i in range(budget):
        x = np.clip(cma + rng.normal(0, sigma, size=(dim,)), lb, ub)
        f_x = func(x)
        g_x = func_grad(x)
        if global_Lipschitz_constant != 0:
            lambda_ *= min(global_Lipschitz_constant / np.linalg.norm(g_x), 1)
            mu = np.sqrt(lambda_)
        else:
            lambda_ -= 10
            mu = np.sqrt(lambda_)
        cma += (lambda_/dim) * g_x + rng.normal(0, sigma/mu, size=(dim,))
    return x
