def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        v = rng.normal(size=dim)
        v = clip(v + x) - clip(2*v*x + v)
        v = clip(v / (1e-7 + np.linalg.norm(v)))
        
        f = func(clip(best_x + 0.5 * v))
        if f < best_f:
            best_f = f
            best_x = best_x + 0.5 * v
            
    return best_x
