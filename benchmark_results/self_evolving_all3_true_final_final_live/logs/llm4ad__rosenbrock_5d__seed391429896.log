def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.sqrt(budget))
    D = dim
    ngen = int(budget / pop_size)
    
    x_min = np.zeros(D) + (ub - lb) * 0.5
    x_max = np.ones(D) * (ub - lb)
    
    pop = rng.uniform(lb, ub, size=(pop_size, D))
    
    for gen in range(ngen):
        for i in range(pop_size):
            u = rng.randint(0, pop_size, size=D)
            v = rng.randint(0, pop_size, size=D)
            
            while np.any(u == v) or np.all(u == i):
                v = rng.randint(0, pop_size, size=D)
                
            y = pop[u] + rng.uniform(-1, 1, size=D)
            z = pop[v]
            
            f_x = func(pop[i])
            f_y = func(y)
            f_z = func(z)
            
            if f_y < f_x and f_y < f_z:
                pop[i] = y
        for i in range(pop_size):
            u = rng.randint(0, pop_size, size=D)
            while np.any(u == i) or np.all(u == i):
                u = rng.randint(0, pop_size, size=D)
                
            v = pop[u]
            
            Cr1 = 1 / (gen + 2)
            F = 0.5 / (gen + 2)
            
            for j in range(D):
                r = rng.uniform(0, 1)
                if r < Cr1:
                    y[j] = v[j] + F * (v[j] - pop[i][j])
                    
                elif not np.isfinite(y[j]):
                    y[j] = pop[i][j]
                
            f_x = func(pop[i])
            f_y = func(y)
            
            if f_y < f_x:
                pop[i] = y
                
    return clip(pop, lb, ub).min(axis=0)
