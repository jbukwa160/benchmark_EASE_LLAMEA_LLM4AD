def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    current = rng.uniform(lb, ub, size=dim)
    best = current.copy()
    sigma = 0.1
    temperature = 100

    for _ in range(budget):
        new_candidate = clip(current + rng.normal(0, sigma, size=dim))
        delta = func(new_candidate) - func(best)

        if delta < 0 or np.random.rand() < np.exp(-delta / temperature):
            current = new_candidate
            if delta < 0:
                best = current.copy()
        else:
            probability = np.exp(-(func(current) - func(best)) / temperature)
            if rng.uniform(0, 1) < probability:
                current = best.copy()

        sigma *= 0.99
        temperature *= 0.999

    return best
