def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return func(x)

    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(x_best, x_r1, x_r2, gamma):
        s = (x_r1 - x_r2) * gamma
        c = 0.5 + 0.5 * rng.rand()
        v = x_best + c * s
        return clip(v)

    def adaptive_mutation_rate(best_candidate, best_fitness, worst_fitness, iteration):
        alpha = 2 / (iteration + 1)
        if worst_fitness < best_fitness:
            alpha *= 0.1
        else:
            alpha *= 1.01
        return np.clip(alpha, 0, 1)

    def adaptive_crossover_rate(best_candidate, best_fitness, iteration):
        beta = 0.2 / (iteration + 1)
        if best_candidate > 4 * rng.rand():
            beta *= 0.5
        else:
            beta *= 1.01
        return np.clip(beta, 0, 1)

    dimension = dim
    population_size = int(budget ** 0.5) // 2 + 1
    iteration = 0

    x_best = rng.uniform(lb, ub, (population_size, dimension))
    y_best = [Rosenbrock(x) for x in x_best]
    best_candidate = np.argmin(y_best)
    best_fitness = y_best[best_candidate]

    while iteration < budget:
        gamma = 0.5 + 0.3 * rng.rand()
        mutation_rate = adaptive_mutation_rate(best_candidate, best_fitness,
                                                max(y_best), iteration)

        for i in range(population_size):
            if i == best_candidate:
                continue
            r1 = (np.arange(population_size) % population_size)[rng.choice(population_size, 2)]
            x_r1, x_r2 = np.copy(x_best[r1[0]]), np.copy(x_best[r1[1]])
            candidate = generate_candidate(x_best[best_candidate], x_r1,
                                            x_r2, mutation_rate)
            y_i = Rosenbrock(candidate)

            if y_i < y_best[i]:
                x_best[i] = candidate
                y_best[i] = y_i

        crossover_rate = adaptive_crossover_rate(best_candidate, best_fitness, iteration)
        for i in range(population_size):
            r1 = (np.arange(population_size) % population_size)[rng.choice(population_size, 2)]
            x_r1, x_r2 = np.copy(x_best[r1[0]]), np.copy(x_best[r1[1]])
            candidate = generate_candidate(x_best[best_candidate], x_r1,
                                            x_r2, crossover_rate)
            y_i = Rosenbrock(candidate)

            if y_i < y_best[i]:
                x_best[i] = candidate
                y_best[i] = y_i

        best_candidate = np.argmin(y_best)
        best_fitness = y_best[best_candidate]

        iteration += 1

    return x_best[best_candidate]
