def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return func(np.array([1] * 5)) if np.allclose(x, [1] * 5) else func(x)

    def clip_bounds(x, lb, ub):
        return np.clip(x, a_min=lb, a_max=ub)

    def generate_initial_population(pop_size, dim, lb, ub):
        return rng.uniform(lb, ub, size=(pop_size, dim))

    def sim_annealing(func, x0, T, alpha, budget, lb, ub):
        x_best = x0
        f_best = func(x0)
        for _ in range(budget):
            delta = 1e-3 * rng.randn(dim)
            new_x = clip_bounds(x_best + delta, lb, ub)
            new_f = func(new_x)
            if new_f < f_best:
                x_best = new_x
                f_best = new_f
            else:
                probability = np.exp((f_best - new_f) / T)
                if rng.rand() < probability:
                    x_best = new_x
                    f_best = new_f
            T *= alpha
        return x_best

    def differential_evolution(func, pop_size, dim, lb, ub, budget):
        population = generate_initial_population(pop_size, dim, lb, ub)
        for _ in range(budget):
            differences = np.array([population[i] - population[(i+1) % pop_size] for i in range(pop_size)])
            indices = rng.choice(pop_size, size=pop_size, replace=False)
            new_population = population.copy()
            for i in range(pop_size):
                trial_x = clip_bounds(population[indices[i]] + 0.5 * differences[indices[i]], lb, ub)
                new_f = func(trial_x)
                if new_f < func(population[indices[i]]):
                    new_population[indices[i]] = trial_x
        return population[np.argmin([func(x) for x in population])]

    def hybrid_algorithm(func, dim, lb, ub, budget, rng):
        x_sa = sim_annealing(Rosenbrock, np.array([1] * 5), 1000, 0.99, int(budget / 2), lb, ub)
        x_de = differential_evolution(Rosenbrock, 50, dim, lb, ub, int(budget - budget / 2))
        return clip_bounds(0.5 * (x_sa + x_de), lb, ub)

    return hybrid_algorithm(func, dim, lb, ub, budget, rng)
