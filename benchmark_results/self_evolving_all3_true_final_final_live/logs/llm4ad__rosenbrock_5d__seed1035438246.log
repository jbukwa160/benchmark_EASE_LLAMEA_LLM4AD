def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        g = np.zeros(dim)
        h = np.eye(dim) * 0.1
        for i in range(dim):
            x_try = x + h[i]
            f_try = func(x_try)
            if f_try < func(x):
                g -= (x_try - x) / (np.linalg.norm(x_try - x) + 1e-8)
                h[i] *= 2.0
            else:
                h[i] /= 2.0

        x += g
        for i in range(dim):
            if x[i] < lb:
                x[i] = lb
            elif x[i] > ub:
                x[i] = ub

        f = func(x)
        if f < best_f:
            best_x = x.copy()
            best_f = f

    return best_x
