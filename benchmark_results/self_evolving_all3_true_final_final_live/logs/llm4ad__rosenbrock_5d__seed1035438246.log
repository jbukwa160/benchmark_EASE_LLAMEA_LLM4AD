def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    D = dim
    n_offspring = 10 * D
    mu = np.zeros(D)
    sigma = 1.0
    lambda_ = n_offspring

    for _ in range(budget):
        candidates = rng.normal(loc=mu, scale=sigma, size=(n_offspring, D))
        candidates = clip(candidates)

        fitnesses = [func(candidate) for candidate in candidates]
        best_idx = np.argmin(fitnesses)
        mu += (1 / lambda_) * (candidates[best_idx] - mu)
        sigma *= 0.5 ** (1 + 2 / (D + 1))

    return clip(mu)
