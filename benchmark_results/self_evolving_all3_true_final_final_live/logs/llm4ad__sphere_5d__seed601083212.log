def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_candidate(current, step_size):
        candidate = current + rng.uniform(-step_size, step_size, size=dim)
        return clip(candidate)

    current_best = lb + (ub - lb) * rng.random(size=dim)
    best_value = func(current_best)

    for i in range(budget):
        step_size = 0.1 / np.sqrt(i + 1)  # adaptive step size
        candidate = generate_candidate(current_best, step_size)
        value = func(candidate)

        if value < best_value:
            current_best = candidate
            best_value = value

    return current_best
