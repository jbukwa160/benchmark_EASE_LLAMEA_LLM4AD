def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_parents = 10
    sigma0 = 1.0
    lambda_ = 100
    mu = 1 / (2 * D)
    weights = [mu] + [1 - 4 * mu + 6 * mu ** 2 for _ in range(lambda_ - 1)]
    
    x_best = np.zeros(D)
    f_best = float('inf')
    
    x_mean = rng.uniform(lb, ub, size=D)
    C = np.eye(D) * sigma0
    
    for i in range(budget):
        z = rng.randn(D)
        x = x_mean + sigma0 * C @ z
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
        
        f = func(x)
        
        if f < f_best:
            f_best = f
            x_best = x
        
        v = rng.randn(D)
        delta_x = sigma0 * C @ v
        
        # Update the mean and covariance matrix
        x_mean += (x - x_mean) / lambda_
        s2 = 1 + np.dot((x - x_mean), (x - x_mean)) - np.dot(delta_x, delta_x)
        
        if s2 > 0:
            C *= s2 / (lambda_ * (s2 - 1))
    
    return x_best
