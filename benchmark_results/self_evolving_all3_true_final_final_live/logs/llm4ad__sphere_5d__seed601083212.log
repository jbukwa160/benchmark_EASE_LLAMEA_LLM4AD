def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        if rng.random() < 0.5:
            # Local refinement
            step_size = 1e-3 * (ub - lb) * np.ones(dim)
            while True:
                x = best_x + rng.uniform(-step_size, step_size, dim)
                x = np.clip(x, lb, ub)
                f = func(x)
                if f < best_f:
                    best_x = x.copy()
                    best_f = f
                else:
                    break

        else:
            # Sampling
            x = rng.uniform(lb, ub, size=dim)

        if i % 100 == 0 or i + 1 == budget:
            print(f'Iteration {i+1}, Best function value: {best_f}')

    return best_x
