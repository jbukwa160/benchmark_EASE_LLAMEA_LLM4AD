def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget - 1):
        new_x = np.clip(np.random.uniform(lb, ub, size=dim), lb, ub)
        new_f = func(new_x)
        
        if new_f < best_f:
            best_f = new_f
            best_x = new_x
            
    return best_x
