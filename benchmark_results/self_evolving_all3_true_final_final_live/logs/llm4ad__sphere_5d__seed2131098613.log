def algorithm(func, dim, lb, ub, budget, rng):
    if not callable(func):
        raise ValueError("The input func must be a callable function")
    
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    for t in range(1, budget + 1):
        x_new = x_best + (ub - lb) * rng.randn(dim)
        
        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
            
    return x_best
