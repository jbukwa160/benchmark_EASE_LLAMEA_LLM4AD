def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    learning_rate = 1e-2
    step_size = 0.9
    
    for _ in range(budget):
        gradient = np.zeros(dim)
        
        for i in range(dim):
            clip_x_i = np.clip(x[i], lb, ub)
            gradient[i] = 2 * x[i]
            
            if rng.random() < 0.5:
                x[i] -= learning_rate * gradient[i]
            else:
                x[i] += learning_rate * gradient[i]
        
        learning_rate *= step_size
        
    return np.clip(x, lb, ub)
