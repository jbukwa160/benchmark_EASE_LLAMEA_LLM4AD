def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    for i in range(budget):
        t = 1 + (budget - 1) * rng.uniform(0, 1)
        candidate = lb + (ub - lb) * (t ** -1 / dim) * rng.uniform(lb, ub, size=dim)
        f_candidate = func(candidate)
        if f_candidate < f_best:
            x_best = candidate
            f_best = f_candidate
    return x_best
