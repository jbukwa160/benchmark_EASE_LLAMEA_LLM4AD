def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(-5.0, 5.0, size=dim)
    best_x = x.copy()
    temp = 1.0
    cooling_rate = 0.999

    for _ in range(budget):
        new_x = clip(x + np.random.normal(size=dim))
        new_f = func(new_x)

        if rng.uniform() < np.exp((func(best_x) - new_f) / temp):
            x = new_x
            best_x = new_x

        temp *= cooling_rate

    return best_x
