def algorithm(func, dim, lb, ub, budget, rng):
    mean = np.zeros(dim)
    sigma = 5.0
    cov = np.eye(dim) * (sigma ** 2)

    for _ in range(budget):
        N = 50
        x = rng.normal(mean, sigma, size=(N, dim))
        f_x = func(x)

        indices = np.argsort(f_x)[:int(N / 2)]
        x_best = x[indices]
        mean = np.mean(x_best, axis=0)
        cov = np.cov(x_best.T) + (1e-8) * np.eye(dim)
        sigma = np.sqrt(np.diag(cov))

    return np.clip(mean, lb, ub)
