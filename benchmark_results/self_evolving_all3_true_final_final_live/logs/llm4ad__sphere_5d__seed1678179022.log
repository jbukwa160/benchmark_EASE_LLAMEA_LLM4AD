def algorithm(func, dim, lb, ub, budget, rng):
    x_best = lb + (ub - lb) * rng.rand(dim)
    for _ in range(budget):
        x_cand = x_best.copy()
        for i in range(dim):
            x_cand[i] += (ub - lb) * rng.uniform(-0.1, 0.1)
            if not np.isfinite(func(x_cand)):
                x_cand[i] = x_best[i]
        f_cand = func(np.clip(x_cand, lb, ub))
        if f_cand < func(x_best):
            x_best = x_cand
    return np.clip(x_best, lb, ub)
