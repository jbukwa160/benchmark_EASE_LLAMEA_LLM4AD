def algorithm(func, dim, lb, ub, budget, rng):
    best_x = rng.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        f = func(x)

        if np.any((x < lb) | (x > ub)):
            continue

        if f < best_f:
            best_x = x
            best_f = f

    return best_x
