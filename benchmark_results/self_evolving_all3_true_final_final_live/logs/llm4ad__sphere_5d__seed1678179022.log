def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    for _ in range(budget):
        idx = rng.choice(dim)
        if rng.uniform(0, 1) < 0.5:
            x[idx] += (ub - abs(x[idx])) * rng.uniform(-1, 1)
        else:
            prob = rng.uniform(0, 1)
            if prob < 0.25:
                x[idx] -= (abs(x[idx]) - lb) * rng.uniform(-1, 1)
            elif prob < 0.5:
                pass
            else:
                x[idx] += (ub - abs(x[idx])) * rng.uniform(-1, 1)
        x = np.clip(x, lb, ub)
    return x
