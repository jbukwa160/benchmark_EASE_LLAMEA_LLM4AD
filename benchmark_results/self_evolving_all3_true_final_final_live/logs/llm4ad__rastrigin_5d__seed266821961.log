def algorithm(func, dim, lb, ub, budget, rng):
    def sample_initial_population(dim, lb, ub, rng):
        return (ub - lb) * rng.rand(dim) + lb
    
    def surrogate_model(population, targets, sigma=0.1):
        weights = 1 / np.array([func(ind) for ind in population])
        weights /= np.sum(weights)
        indices = np.random.choice(len(population), len(population), p=weights)
        return np.mean([targets[i] + sigma * rng.randn(dim) for i in indices], axis=0)
    
    def evolution_strategy(population, targets, bound, budget):
        new_population = []
        for _ in range(budget):
            mu = surrogate_model(population, targets)
            new_population.append(mu)
            variances = np.array([func(ind) - func(mu) + 1e-6 for ind in population])
            indices = np.argsort(variances)[-int(0.2*len(variances)):]
            new_population.extend([population[i] + (mu - population[i]) * rng.randn(dim) for i in indices])
        return [np.clip(ind, bound[0], bound[1]) for ind in new_population]
    
    def evaluate(individual):
        return func(individual)
    
    population = sample_initial_population(dim, lb, ub, rng)
    targets = np.array([evaluate(ind) for ind in population])
    best_individual = np.argmin(targets)
    best_value = targets[best_individual]
    
    for _ in range(budget):
        population = evolution_strategy(population, targets, (lb, ub), budget)
        new_targets = np.array([evaluate(ind) for ind in population])
        best_individual_new = np.argmin(new_targets)
        if new_targets[best_individual_new] < best_value:
            best_value = new_targets[best_individual_new]
            best_individual = best_individual_new
    
    return population[best_individual]
