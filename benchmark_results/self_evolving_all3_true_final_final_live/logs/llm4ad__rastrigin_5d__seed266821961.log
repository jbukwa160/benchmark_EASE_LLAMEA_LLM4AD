def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop = rng.uniform(lb, ub, (1, dim))
    pop_size = 10 + int(np.sqrt(dim))

    for _ in range(budget):
        fit_pop = [func(clip(pop[i])) for i in range(pop_size)]
        fmin = np.min(fit_pop)
        
        if fit_pop.count(fmin) > 1:
            indices = np.where(np.array(fit_pop) == fmin)[0]
            pop[indices] = rng.uniform(lb, ub, (len(indices), dim))
            
        else:
            idx_best = np.argmin(fit_pop)
            x_best = clip(pop[idx_best])
            
            pop_diff = [rng.uniform(-1, 1) for _ in range(dim)]
            children = pop + pop_size * [np.array(x_best) + np.dot(np.array([pop[i] - x_best for i in range(pop_size)]), np.array(pop_diff))]
            
            fit_children = [func(clip(child)) for child in children]
            idx_child = np.argmin(fit_children)
            
            if rng.rand() < 0.1:
                pop[idx_child] = clip(children[idx_child])
            else:
                pop[idx_best] = clip(children[idx_child])

    best_x = np.array(pop[np.argmin([func(clip(x)) for x in pop])])
    return best_x
