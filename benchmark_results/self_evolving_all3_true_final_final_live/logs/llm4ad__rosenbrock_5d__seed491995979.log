def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget - 1):
        # Gradient-free exploration
        x_try = x + np.sqrt(2 * lb * (ub - lb)) * rng.normal(size=x.shape)
        x_try = np.clip(x_try, lb, ub)
        f_try = func(x_try)
        
        if f_try < best_f:
            best_x = x_try.copy()
            best_f = f_try

        # Gradient-based exploitation
        grad = np.zeros_like(x)
        eps = 1e-5
        for i in range(dim):
            x_plus_eps = x.copy()
            x_plus_eps[i] += eps
            x_minus_eps = x.copy()
            x_minus_eps[i] -= eps
            grad[i] = (func(x_plus_eps) - func(x_minus_eps)) / (2 * eps)

        # Gradient descent step
        x_try = x - 0.1 * grad

        # Clip candidates to [lb, ub]
        x_try = np.clip(x_try, lb, ub)
        
        f_try = func(x_try)
        
        if f_try < best_f:
            best_x = x_try.copy()
            best_f = f_try
        
        # Accept new solution with probability 0.5
        u = rng.uniform(0, 1)
        if u > 0.5 or (u <= 0.5 and f_try < best_f):
            x = x_try.copy()

    return best_x
