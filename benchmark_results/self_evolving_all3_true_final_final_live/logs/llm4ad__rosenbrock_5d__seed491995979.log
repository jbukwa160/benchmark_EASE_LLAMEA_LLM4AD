def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = np.full(dim, 5.0)
    best_obj = float('inf')
    
    def clip(sol):
        return np.clip(sol, lb, ub)
    
    for i in range(budget // 2):
        pop_size = 10
        pop = rng.uniform(lb, ub, size=(pop_size, dim))
        
        for _ in range(50):
            x1 = pop[rng.randint(pop_size), :]
            x2 = pop[rng.randint(pop_size), :]
            x3 = pop[rng.randint(pop_size), :]
            
            v = 0.7 * (x1 - 2 * x2 + x3) + 0.4 * rng.normal(0, 5, size=dim)
            v = clip(v)
            u = 0.5 * (pop[rng.randint(pop_size), :] - x2) + 0.3 * rng.uniform(lb, ub, size=dim)
            u = clip(u)
            
            candidate = x2 + 1.4 * (v - x2) + 0.6 * u
            
            obj = func(candidate)
            
            if obj < best_obj:
                best_sol = candidate
                best_obj = obj
                
            pop[rng.randint(pop_size), :] = candidate
    
    for _ in range(budget // 2):
        pop_size = 10
        pop = rng.uniform(lb, ub, size=(pop_size, dim))
        
        for _ in range(50):
            x1 = pop[rng.randint(pop_size), :]
            x2 = pop[rng.randint(pop_size), :]
            
            candidate = clip(x1 + rng.normal(0, 5, size=dim))
            
            obj = func(candidate)
            
            if obj < best_obj:
                best_sol = candidate
                best_obj = obj
                
    return best_sol
