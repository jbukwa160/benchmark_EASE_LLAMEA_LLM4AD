def algorithm(func, dim, lb, ub, budget, rng):
    def init_population(n_pop, dim, lb, ub):
        x = np.zeros((n_pop, dim))
        for i in range(dim):
            mu = (ub[i] + lb[i]) / 2
            sigma = (ub[i] - lb[i]) / 4
            x[:,i] = rng.normal(mu, sigma, n_pop)
        return x

    def mutate(x, c1, c2, f, dim):
        y = np.copy(x)
        for i in range(dim):
            j = rng.randint(0, dim-1)
            k = rng.randint(0, dim-1)
            if i != j and i != k:
                y[i] += c1 * (x[j] - x[k]) + c2 * (rng.normal(0, 1) * f(x[j])) + rng.uniform(-1, 1) * (ub[i] - lb[i])
        return y

    def crossover(u, v):
        z = np.zeros_like(u)
        for i in range(len(u)):
            if rng.random() < 0.5:
                z[i] = u[i]
            else:
                z[i] = v[i]
        return z

    n_pop = 100
    best_x = None
    best_f = float('inf')
    
    x_init = init_population(n_pop, dim, lb, ub)
    for f_values in [func(x) for x in x_init]:
        if f_values < best_f:
            best_f = f_values
            best_x = x_init[f_values.index(min(f_values))]

    c1 = 0.5
    c2 = 0.3
    for _ in range(budget):
        y = np.zeros((n_pop, dim))
        for i in range(n_pop):
            u = mutate(x_init[i], c1, c2, func, dim)
            v = crossover(u, x_init[i])
            y[i] = np.clip(v, lb, ub)

        f_values = [func(yi) for yi in y]
        order = np.argsort(f_values)
        best_f = f_values[order[0]]
        if best_f < best_f:
            best_x = y[order[0]]

    return np.array([best_x])
