def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.ones(dim)
    f_best = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
        
        f = func(x)
        
        if f < f_best:
            f_best = f
            x_best = x
            
        # Probabilistic hill climbing
        for i in range(dim):
            epsilon = rng.uniform(0, 1)
            
            if epsilon > 0.5:
                continue
                
            delta = rng.uniform(-1, 1)
            
            new_x = np.copy(x)
            new_x[i] += delta
            
            # Clip candidates to [lb, ub]
            new_x[i] = np.clip(new_x[i], lb, ub)
            
            f_new = func(new_x)
            
            if f_new < f:
                x = new_x
                f = f_new
                
    return x_best
