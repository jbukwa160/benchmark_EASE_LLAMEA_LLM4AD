def algorithm(func, dim, lb, ub, budget, rng):
    candidates = np.array([np.random.uniform(lb, ub) for _ in range(budget)])
    best_candidate = candidates.copy()
    
    for i in range(1, dim+1):
        best_dim_i = np.argmin(np.abs(candidates[:,i] - 1))
        
        max_improve_rate = 0
        idx = 0
        for j in range(budget):
            candidate_j = candidates[j]
            
            improve_rate = 100 * (candidate_j[i+1]-candidate_j[i]**2)**2 + (1-candidate_j[i])**2
            
            if improve_rate > max_improve_rate:
                max_improve_rate = improve_rate
                idx = j
                
        dim_i_best_candidate = np.copy(candidates[idx])
        
        for k in range(budget):
            candidate_k = candidates[k]
            dim_i_value = 100 * (candidate_k[i+1]-candidate_k[i]**2)**2 + (1-candidate_k[i])**2
            best_dim_i_value = 100 * (dim_i_best_candidate[i+1]-dim_i_best_candidate[i]**2)**2 + (1-dim_i_best_candidate[i])**2
            
            if dim_i_value < best_dim_i_value:
                candidates[k] = np.copy(dim_i_best_candidate)
        
        if max_improve_rate > 0.01:
            candidates[best_dim_i] = np.copy(dim_i_best_candidate)
    
    for i in range(budget):
        candidate_i = candidates[i]
        func(candidate_i)
    
    return best_candidate
