def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(0.1 * budget)
    population = rng.uniform(lb, ub, (pop_size, dim))
    best_solution = population[np.argmin([func(x) for x in population])]
    success_rate = 0
    mutation_strategy = 'rand/1/bin'

    for _ in range(budget):
        new_population = np.zeros((pop_size, dim))

        for i in range(pop_size):
            if rng.random() < success_rate:
                new_solution = best_solution + rng.uniform(-1, 1) * (ub - lb)
                new_population[i] = new_solution
            else:
                a, b = rng.choice(range(pop_size), size=2, replace=False)

                if mutation_strategy == 'rand/1/bin':
                    v = population[a] + rng.uniform(0, 1) * (population[b] - population[a])
                elif mutation_strategy == 'best/1/bin':
                    v = best_solution + rng.uniform(0, 1) * (best_solution - population[a])

                new_population[i] = population[i] + rng.uniform(-1, 1) * (v - population[i])

            new_population[i] = np.clip(new_population[i], lb, ub)

        fitness_new = [func(x) for x in new_population]
        success_rate = (fitness_new < [f(best_solution) for f in fitness_new]).sum() / pop_size

        if success_rate > 0.5:
            mutation_strategy = 'best/1/bin'
        else:
            mutation_strategy = 'rand/1/bin'

        population, best_solution = new_population, new_population[np.argmin(fitness_new)]

    return best_solution
