def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def initial_population(budget):
        return (ub - lb) * rng.rand(budget, dim) + lb

    def simulated_annealing(population, func, temperature, step_size, max_steps):
        for _ in range(max_steps):
            new_population = population.copy()
            for i in range(len(new_population)):
                perturbation = np.zeros(dim)
                for j in range(dim):
                    if rng.rand() < 0.5:
                        perturbation[j] = rng.uniform(-step_size, step_size)
                new_x = clip(population[i] + perturbation)
                new_y = func(new_x)
                old_y = func(clip(population[i]))
                if new_y < old_y or np.exp((old_y - new_y) / temperature) > rng.rand():
                    new_population[i] = new_x
            population[:] = new_population
        return population

    def differential_evolution(population, func):
        for _ in range(budget // 2):
            x_best = np.zeros(dim)
            y_best = float('inf')
            for i in range(len(population)):
                x_i = population[i]
                y_i = func(clip(x_i))
                if y_i < y_best:
                    y_best = y_i
                    x_best[:] = x_i
                for j in range(i + 1, len(population)):
                    x_j = population[j]
                    x_cross = np.copy(x_best)
                    mid = rng.randint(dim)
                    x_cross[mid:] = population[j][mid:]
                    x_cross[:mid] = population[i][:mid]
                    y_cross = func(clip(x_cross))
                    if y_cross < y_best:
                        y_best = y_cross
                        x_best[:] = x_cross
            population[:] = [x_best]
        return population

    # Initialisation
    population = initial_population(budget)

    # Differential Evolution phase
    population = differential_evolution(population, func)

    # Simulated Annealing phase
    temperature = 1.0
    step_size = (ub - lb) * 0.05
    max_steps = budget // 2
    for _ in range(max_steps):
        population = simulated_annealing(population, func, temperature, step_size, max_steps)
        temperature *= 0.9

    # Return the best solution found
    return np.array(min((func(x), x) for x in population)[1])
