def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(np.clip(x, a_min=lb, a_max=ub))

    mu = 1.0 / dim ** (2 + 4 / (dim + 3))
    sigma = 0.5 * (ub - lb)
    x_best = np.random.uniform(lb, ub, size=(1, dim))
    c_c = 2
    cc = 2 / ((dim + 1) * np.sqrt(dim))

    for _ in range(budget):
        z = np.zeros((int(mu), dim))
        for i in range(int(mu)):
            z[i] = x_best[0]
            for d in range(dim):
                if rng.rand() < cc:
                    z[i, d] += sigma * (2 * rng.rand() - 1)
        f_z = objective(z)

        if rng.rand() < mu / int(mu):
            c = 1.0
        else:
            c = np.max(np.abs(f_z - objective(x_best[0])) / (1 + np.linalg.norm(z - x_best[0], axis=1) ** 2))

        for i in range(int(mu)):
            f_xi = objective(x_best[0] + c * z[i])
            if f_xi < f_z[i]:
                f_z[i] = f_xi
                z[i] = x_best[0] + c * z[i]

        x_new = np.copy(z[np.argmin(f_z)])
        if objective(x_new) < objective(x_best[0]):
            x_best = np.array([x_new])

    return x_best
