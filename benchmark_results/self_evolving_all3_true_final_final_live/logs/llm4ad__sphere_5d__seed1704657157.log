def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    T = 10 * (ub - lb)
    alpha = 0.5
    beta = 1e-3
    sigma = 0.01

    for i in range(budget):
        if i % 100 == 0:
            x_best = x.copy()
            f_best = func(x_best)

        fx = func(x)
        grad = np.zeros(dim)
        for j in range(dim):
            e = np.zeros(dim)
            e[j] = sigma
            grad[j] = (func(x + e) - fx) / sigma

        T *= alpha

        if i % 100 == 0:
            if abs(func(x_best)) < 1e-6:
                break

        step = beta * T * np.exp(-beta * func(x))
        dx = grad / np.linalg.norm(grad)
        x += step * dx
        x = np.clip(x, lb, ub)

    return x
