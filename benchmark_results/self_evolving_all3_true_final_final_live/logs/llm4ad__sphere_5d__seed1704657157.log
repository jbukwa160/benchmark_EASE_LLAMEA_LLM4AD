def algorithm(func, dim, lb, ub, budget, rng):
    best = None
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        if func(x) < (best is None or func(x) < func(best)):
            best = x
        for i in range(dim):
            x1 = np.copy(x)
            x2 = np.copy(x)
            while True:
                delta = rng.normal(0, 1e-3, size=dim)
                new_x = x + 0.01 * delta
                new_x = np.clip(new_x, lb, ub)
                if func(new_x) < func(x):
                    x = new_x
                    x1[i] = new_x[i]
                elif rng.random() > 0.5:
                    break
            while True:
                delta = -rng.normal(0, 1e-3, size=dim)
                new_x = x + 0.01 * delta
                new_x = np.clip(new_x, lb, ub)
                if func(new_x) < func(x):
                    x = new_x
                    x2[i] = new_x[i]
                elif rng.random() > 0.5:
                    break
            for j in range(dim):
                if j != i and rng.random() > 0.9:
                    delta = rng.normal(0, 1e-3, size=dim)
                    new_x = x + 0.01 * delta
                    new_x[j] = np.clip(new_x[j], lb, ub)
                    if func(new_x) < func(x):
                        x = new_x
            x = (x1 + x2) / 2
        if func(x) < (best is None or func(x) < func(best)):
            best = x
    return best
