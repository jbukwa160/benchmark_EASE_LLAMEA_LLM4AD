def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = lb + (ub - lb) * rng.rand(dim)
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
            
        if budget / 2 <= _ and rng.rand() < 0.1:
            x_best = np.clip(best_x, lb, ub)
            f_best = func(x_best)
            
            if f_best < best_f:
                best_f = f_best
                best_x = x_best
                
    return best_x
