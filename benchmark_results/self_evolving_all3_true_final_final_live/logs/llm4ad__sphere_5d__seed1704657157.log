def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        step_size = 0.1 * (ub - lb) / 10
        while True:
            s = rng.normal(size=(1, dim)) * step_size
            c = np.clip(x + s, lb, ub)
            f = func(c)
            
            if f < best_f:
                x = c.copy()
                best_x = c.copy()
                best_f = f
                
            if rng.uniform(0, 1) > 0.99:  # 1% chance to accept worse candidate
                break
            
            step_size *= 0.9
        
        x += np.random.choice([-1, 1], size=(1, dim)) * 0.001
    
    return best_x
