def algorithm(func, dim, lb, ub, budget, rng):
    x = 5 * np.random.rand(dim) - 2.5
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        # ARS for exploration
        ars_x = np.clip(ub + (lb - ub) * rng.uniform(size=dim), lb, ub)
        ars_fx = func(ars_x)
        
        if ars_fx < best_f:
            best_x = ars_x.copy()
            best_f = ars_fx

        # SMBO for exploitation
        bounds = [(lb, ub) for _ in range(dim)]
        res = differential_evolution(func, bounds=bounds, x0=best_x, 
                                     polish=True, update_interval=1)
        
        smbo_x = np.clip(res.x, lb, ub)
        smbo_fx = func(smbo_x)

        if smbo_fx < best_f:
            best_x = smbo_x.copy()
            best_f = smbo_fx

    return best_x
