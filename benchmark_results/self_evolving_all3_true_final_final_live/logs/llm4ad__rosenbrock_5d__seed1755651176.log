def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(x_best, x_pop, F, sigma):
        u = np.random.choice(dim)
        v = np.random.choice(dim)
        while v == u:
            v = np.random.choice(dim)
        z1 = x_best + F * (x_pop[u] - x_best) + sigma * (np.random.rand() - 0.5) * (x_pop[v] - x_pop[u])
        return np.clip(z1, lb, ub)

    def crossover(x_best, z):
        r = rng.uniform(0, 1)
        if r < 0.5:
            return x_best + r * (z - x_best)
        else:
            return x_best + (1 - r) * (z - x_best)

    dim = int(dim)
    pop_size = int(np.ceil(budget / dim))
    sigma_max = 10
    F_min = 0.4
    sigma_decay_rate = 2

    x_pop = rng.uniform(lb, ub, size=(pop_size, dim))
    f_pop = np.array([func(x) for x in x_pop])
    budget_used = pop_size * dim

    while budget_used < budget:
        F = max(F_min, 1 - (budget - budget_used) / (budget * 0.5))
        sigma = min(sigma_max, sigma_decay_rate * (sigma_max - np.mean(f_pop)))
        
        for i in range(pop_size):
            x_best = x_pop[i]
            f_best = f_pop[i]

            z = mutate(x_best, x_pop, F, sigma)
            zc = crossover(x_best, z)

            if func(zc) < f_best:
                x_pop[i] = zc
                f_pop[i] = func(zc)
        
        budget_used += dim

    best_idx = np.argmin(f_pop)
    return x_pop[best_idx]
