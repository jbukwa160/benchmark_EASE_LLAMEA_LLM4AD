def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(size=dim) * (ub - lb) + lb
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        pop_size = 100
        pop = np.zeros((pop_size, dim))
        
        for i in range(pop_size):
            pop[i] = clip(rng.uniform(size=dim) * (ub - lb) + lb)
        
        fit = np.array([func(clip(pop[i])) for i in range(pop_size)])
        idx = np.argsort(fit)[:10]
        
        new_pop = np.zeros((pop_size, dim))
        new_fit = np.zeros(pop_size)
        
        for i in range(pop_size):
            if rng.rand() < 0.5:
                c1, c2 = pop[idx[np.random.choice(10)]], pop[idx[np.random.choice(10)]]
                new_pop[i] = (c1 + c2) / 2 + rng.uniform(-ub, ub)
                new_fit[i] = func(new_pop[i])
            else:
                new_pop[i] = pop[i] + rng.uniform(-ub, ub)
                new_fit[i] = func(new_pop[i])
        
        fit = np.array([func(clip(new_pop[i])) for i in range(pop_size)])
        idx = np.argsort(fit)[:10]
        
        best_idx = np.argmin(fit)
        if fit[best_idx] < best_f:
            best_x, best_f = new_pop[best_idx], fit[best_idx]
    
    return best_x
