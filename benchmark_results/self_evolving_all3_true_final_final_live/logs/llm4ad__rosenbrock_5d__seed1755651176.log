def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 10
    iter_count = 0
    best_pos = None
    best_val = float('inf')

    while iter_count < budget:
        # Differential Evolution step
        pos = rng.uniform(lb, ub, (pop_size, dim))
        fit = func(pos)
        idx_best = np.argmin(fit)

        if fit[idx_best] < best_val:
            best_pos = pos[idx_best]
            best_val = fit[idx_best]

        iter_count += 1

        # Simulated Annealing step
        alpha = 0.9
        T_max = 10000.0
        cooling_rate = 0.995
        T = T_max

        while T > 1:
            new_pos = best_pos + rng.normal(0, 1, dim)
            new_pos = np.clip(new_pos, lb, ub)

            new_fit = func(new_pos)

            if new_fit < best_val:
                best_pos = new_pos
                best_val = new_fit

            delta = new_fit - best_val
            if delta < 0 or np.random.rand() < np.exp(-delta / T):
                best_pos = new_pos
                best_val = new_fit

            T *= cooling_rate

        iter_count += 1

    return best_pos
