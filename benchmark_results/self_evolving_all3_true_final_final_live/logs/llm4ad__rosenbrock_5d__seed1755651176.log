def algorithm(func, dim, lb, ub, budget, rng):
    def wrapper(x):
        return func(x)

    bounds = [(lb, ub) for _ in range(dim)]
    res0 = differential_evolution(wrapper, bounds)
    x_best = res0.x
    f_best = res0.fun

    num_start = int(np.ceil(budget / dim))
    for _ in range(num_start):
        x_init = rng.uniform(lb, ub, size=(dim,))
        res1 = differential_evolution(wrapper, bounds, x0=x_init)
        if res1.fun < f_best:
            f_best = res1.fun
            x_best = res1.x

    return x_best
