def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)
    
    alpha = 0.1
    T = 1000
    
    for i in range(budget):
        v = clip(best_x + rng.normal(0, alpha, size=dim))
        f_v = func(v)
        
        if f_v < best_f:
            best_x = v
            best_f = f_v
            
        delta_f = f_v - best_f
        if delta_f > 0 and np.random.rand() < np.exp(-delta_f / T):
            best_x = v
            best_f = f_v
        
        x = clip(x + rng.normal(0, alpha, size=dim))
        
    return best_x
