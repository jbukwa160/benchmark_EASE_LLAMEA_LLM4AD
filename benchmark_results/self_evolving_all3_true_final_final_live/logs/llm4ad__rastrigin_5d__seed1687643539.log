def algorithm(func, dim, lb, ub, budget, rng):
    n = 0
    x_best = rng.uniform(lb, ub, size=dim)
    best_fitness = func(x_best)
    
    for i in range(1, budget + 1):
        sigma = max(np.std(rng.normal(loc=x_best, scale=np.random.rand(), size=(i, dim))), 0.01)
        
        while n < i:
            x_candidate = rng.normal(loc=x_best, scale=sigma, size=dim)
            
            if np.all(x_candidate >= lb) and np.all(x_candidate <= ub):
                candidate_fitness = func(x_candidate)
                
                if candidate_fitness < best_fitness:
                    x_best = x_candidate
                    best_fitness = candidate_fitness
                    
                n += 1
                
    return x_best
