def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    x = np.random.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = evaluate(best_x)
    current_f = best_f
    temp = 1.0

    for _ in range(budget):
        u = rng.choice(dim)
        v = rng.choice(dim)
        w = rng.choice(dim)

        while u == v or u == w or v == w:
            v = rng.choice(dim)
            w = rng.choice(dim)

        a = x.copy()
        b = a.copy()

        c = 0.5 * (a[u] + b[v])
        d = 0.5 * (b[w] - a[u])

        a[u] += d
        a[v] -= d

        f_a = evaluate(a)
        f_b = current_f

        if f_a < f_b:
            best_f = min(best_f, f_a)
            best_x = a.copy()
            current_f = f_a
        elif np.random.rand() < 0.5 * (1 - temp):
            x[u] += rng.uniform(-1, 1) / budget

        for i in range(dim):
            if x[i] < lb:
                x[i] = lb + rng.uniform(0, ub - lb)
            elif x[i] > ub:
                x[i] = ub - rng.uniform(0, ub - lb)

    return best_x
