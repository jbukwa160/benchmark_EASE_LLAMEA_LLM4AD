def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_y = float('inf')
    
    T = 100.0
    alpha = 0.99
    
    for _ in range(budget):
        x = best_x + rng.uniform(-1, 1, size=dim) * (ub - lb)
        
        # Clip to bounds
        x = np.clip(x, lb, ub)
        
        y = func(x)
        
        if y < best_y:
            best_y = y
            best_x = x
        
        delta = best_y - y
        prob = np.exp(-delta / T)
        
        if rng.rand() < prob:
            # Simulated Annealing cooling schedule
            T *= alpha
    
    return best_x
