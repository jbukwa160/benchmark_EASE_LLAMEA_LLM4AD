def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best = None
    best_func_val = float('inf')
    
    current_pop = rng.normal(0, 1, size=dim)
    
    for _ in range(budget):
        candidate = clip(current_pop)
        
        func_val = func(candidate)
        
        if func_val < best_func_val:
            best_func_val = func_val
            best = candidate
            
        sigma = np.std(current_pop)
        current_pop = current_pop + rng.normal(0, 1 / (10 * sigma), size=dim) - current_pop
        
    return clip(best)
