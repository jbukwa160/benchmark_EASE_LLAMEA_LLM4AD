def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(n):
        x = rng.uniform(lb, ub, (n, dim))
        return x

    def evaluate_fitness(population):
        fitness = [func(ind) for ind in population]
        return np.array(fitness)

    def differential_evolution(population, budget):
        mutation_factor = 0.5
        crossover_prob = 0.1
        num_parents = int(budget * 0.2)
        for _ in range(int(budget / (dim + 1))):
            for i in range(num_parents, population.shape[0]):
                idxs = np.random.choice(population.shape[0], size=3, replace=False)
                mutation = mutation_factor * (population[idxs] - population[i])
                crossover = rng.uniform(0, 1, (dim,))
                child = population[i] + mutation
                for j in range(dim):
                    if rng.uniform(0, 1) < crossover[j]:
                        child[j] += mutation[j]
                population[i] = clip(child)
        return population[:num_parents]

    def simulated_annealing(population, budget):
        initial_temperature = 100.0
        cooling_rate = 0.99
        num_steps = int(budget / (dim + 1))
        for _ in range(num_steps):
            temperature = max(initial_temperature * cooling_rate ** _, 1e-3)
            for i in range(population.shape[0]):
                child = population[i] + rng.uniform(-temperature, temperature, dim)
                child = clip(child)
                if func(child) < func(population[i]):
                    population[i] = child
        return population

    population = generate_initial_population(budget)
    population = differential_evolution(clip(population), budget)
    population = simulated_annealing(population, budget)

    best_individual = np.argmin(evaluate_fitness(population))
    best_solution = clip(population[best_individual])

    return best_solution
