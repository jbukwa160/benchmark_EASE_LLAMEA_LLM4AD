def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = None
    best_val = float('inf')
    
    for _ in range(budget):
        sol = rng.uniform(lb, ub, size=dim)
        val = func(sol)
        
        if val < best_val:
            best_val = val
            best_sol = sol
            
        # Clip candidates to [lb, ub]
        clipped_sol = np.clip(sol, lb, ub)
        
        # Early termination when global minimum is reached
        if np.allclose(clipped_sol, 0):
            return clipped_sol
    
    return best_sol
