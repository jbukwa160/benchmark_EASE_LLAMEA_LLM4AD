def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    candidates = [rng.uniform(lb, ub) for _ in range(dim)]
    best_candidate = clip(candidates)
    best_value = func(best_candidate)

    for _ in range(budget - 1):
        new_candidates = [clip(rng.uniform(lb, ub)) for _ in range(dim)]
        new_value = func(new_candidates)

        if new_value < best_value:
            best_candidate = new_candidates
            best_value = new_value

    return np.array(best_candidate)
