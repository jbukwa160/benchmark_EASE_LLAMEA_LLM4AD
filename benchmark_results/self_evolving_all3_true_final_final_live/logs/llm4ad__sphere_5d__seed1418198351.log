def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    learning_rate = 0.01
    adaptation_factor = 1.1
    
    for _ in range(budget):
        x = np.clip(best_x + (ub - lb) * (rng.random(size=dim) - 0.5), lb, ub)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
        
        # Adapt the learning rate
        learning_rate *= adaptation_factor ** (f > best_f)
    
    return best_x
