def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    step_size = (ub - lb) / 100
    num_steps = int(budget / dim)
    
    for _ in range(num_steps):
        x = best_x + np.random.uniform(-step_size, step_size, size=dim)
        x = np.clip(x, lb, ub)
        
        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x
            
    return best_x
