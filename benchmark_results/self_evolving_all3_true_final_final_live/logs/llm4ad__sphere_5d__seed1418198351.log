def algorithm(func, dim, lb, ub, budget, rng):
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    for _ in range(budget):
        step_size = 0.1 if _ == 0 else max(0.01, np.exp(-_ / 100))
        new_x = x_best + step_size * (ub - lb) * rng.randn(dim)
        new_x = np.clip(new_x, lb, ub)

        f_new = func(new_x)

        if f_new < f_best:
            x_best = new_x
            f_best = f_new

    return x_best
