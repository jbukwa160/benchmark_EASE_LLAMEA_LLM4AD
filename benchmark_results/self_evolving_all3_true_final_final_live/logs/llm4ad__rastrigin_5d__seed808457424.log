def algorithm(func, dim, lb, ub, budget, rng):
    def clipped_candidate(candidate):
        return np.clip(candidate, lb, ub)

    best_solution = np.zeros(dim)
    best_score = float('inf')

    for _ in range(budget):
        candidate = clipped_candidate(rng.uniform(lb, ub, size=dim))
        score = func(candidate)

        if score < best_score:
            best_score = score
            best_solution = candidate

        # local hill-climbing step with a small probability
        if rng.uniform(0, 1) < 0.01 and not np.allclose(best_solution, clipped_candidate(best_solution + rng.normal(size=dim))):
            new_solution = clipped_candidate(best_solution + rng.normal(size=dim))
            new_score = func(new_solution)

            if new_score < best_score:
                best_score = new_score
                best_solution = new_solution

    return best_solution
