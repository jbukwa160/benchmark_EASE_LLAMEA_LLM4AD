def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        v = rng.normal(size=dim)
        u = clip(best_x + 0.1 * v, lb, ub)
        f_u = func(u)
        
        if f_u < best_f:
            best_x = u
            best_f = f_u

        elif rng.uniform(0, 1) < np.exp((best_f - f_u) / (1e-6 + rng.uniform(0.01, 0.1))):
            best_x = u
            best_f = f_u

    return best_x
