def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = objective(clip(x_best))

    for _ in range(budget - 1):
        v = rng.normal(size=dim) * 0.1
        v = clip(v + x_best)
        u = rng.choice(dim, size=5, replace=False)
        v[u] += rng.uniform(-1, 1, size=len(u)) * np.abs(x_best[u])

        f_v = objective(clip(v))
        if f_v < f_best:
            x_best = v
            f_best = f_v

    return clip(x_best)
