def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, a_min=lb, a_max=ub)

    N = 50
    M = int(np.ceil(budget / (N * 2)))
    pop_size = 100

    x_best = -np.ones(dim)
    f_best = float('inf')
    p_best = rng.uniform(size=(pop_size, dim))

    for _ in range(M):
        v = rng.uniform(size=(pop_size, dim))
        for _ in range(N):
            for i in range(pop_size):
                r1, r2, r3 = rng.uniform(size=dim), rng.uniform(size=dim), rng.uniform(size=dim)
                mutation = 0.5 * (p_best[i] + v[i]) + 0.5 * r1 * (p_best[rng.randint(0, pop_size)] - p_best[i])
                crossover = clip(mutation + r2 * (x_best - p_best[i]), lb, ub)
                f_new = func(crossover)
                if f_new < func(p_best[i]):
                    p_best[i] = crossover
        for i in range(pop_size):
            if func(p_best[i]) < f_best:
                x_best = p_best[i]
                f_best = func(x_best)

    return x_best
