def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    cr = 0.9
    f = 1.2
    best_x = np.zeros(dim)
    best_f = np.inf

    for _ in range(budget):
        population = rng.uniform(lb, ub, (pop_size, dim))
        for _ in range(pop_size):
            x_i = population[_]
            if func(x_i) < best_f:
                best_f = func(x_i)
                best_x = x_i

        v = np.copy(best_x)
        for i in range(pop_size):
            u = population[i] + f * (v - population[i])
            v = np.where(rng.uniform(0, 1, dim) < cr, u, v)

        v = np.clip(v, lb, ub)

    return best_x
