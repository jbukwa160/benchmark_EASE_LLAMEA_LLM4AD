def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(dim, lb, ub, rng):
        population = rng.uniform(lb, ub, (budget, dim))
        return population

    def evaluate_population(population, func, dim):
        fitness = func(population)
        return fitness

    def de_mutation(x_best, x_candidate, rng):
        mutation_factor = 0.1
        for i in range(dim):
            if rng.random() < 0.5:
                x_candidate[i] += mutation_factor * (x_best[i] - x_candidate[i])
        return x_candidate

    def gradient_based_local_search(x_current, func, dim, lb, ub, rng):
        alpha = 0.01
        for _ in range(10):
            gradient = np.zeros(dim)
            for i in range(dim):
                dx = np.zeros(dim)
                dx[i] = 1e-6
                gradient[i] = (func(x_current + dx) - func(x_current)) / dx[i]
            step_size = alpha * rng.uniform(-1, 1)
            x_candidate = x_current + step_size * gradient
            x_candidate = np.clip(x_candidate, lb, ub)
            if func(x_candidate) < func(x_current):
                x_current = x_candidate
        return x_current

    def adaptive_mutation(population, best_individual, rng):
        mutation_rate = 0.1
        for i in range(budget):
            if rng.random() < mutation_rate:
                population[i] = de_mutation(best_individual, population[i], rng)
        return population

    population = generate_initial_population(dim, lb, ub, rng)
    fitness = evaluate_population(population, func, dim)

    best_individual = np.argmin(fitness)
    for _ in range(budget - 1):
        adaptive_mutation(population, population[best_individual], rng)
        fitness = evaluate_population(population, func, dim)
        best_individual = np.argmin(fitness)
        population[best_individual] = gradient_based_local_search(population[best_individual], func, dim, lb, ub, rng)

    return population[np.argmin(evaluate_population(population, func, dim))]
