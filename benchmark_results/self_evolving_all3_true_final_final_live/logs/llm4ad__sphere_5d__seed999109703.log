def algorithm(func, dim, lb, ub, budget, rng):
    def sample_gaussian(dim, mean, cov):
        return mean + np.sqrt(np.linalg.det(cov)) * rng.randn(dim)

    best_x = np.zeros(dim)
    best_y = float('inf')

    for i in range(budget):
        x = sample_gaussian(dim, np.zeros(dim), 0.5 * np.eye(dim))
        x = np.clip(x, lb, ub)
        y = func(x)

        if y < best_y:
            best_x = x
            best_y = y

    return best_x
