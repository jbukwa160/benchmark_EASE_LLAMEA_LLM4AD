def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    n_restart = 10
    for _ in range(n_restart):
        x = rng.uniform(lb, ub, size=dim)
        
        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x
            
        step_size = (ub - lb) / np.sqrt(np.sum((x - best_x)**2))
        
        for _ in range(budget):
            g = np.zeros(dim)
            
            # Compute gradient using finite differences with a small perturbation
            for i in range(dim):
                dx = 1e-3 * rng.uniform(-1, 1)
                x_plus_dx = x.copy()
                x_plus_dx[i] += dx
                
                f_plus_dx = func(x_plus_dx)
                g[i] = (f_plus_dx - f) / dx
                
            # Clip gradient to [-5, 5]
            g = np.clip(g, -5.0, 5.0)
            
            # Update parameters using gradient descent
            x -= step_size * g
            
            # Clip new position to [lb, ub]
            x = np.clip(x, lb, ub)
            
            f = func(x)
            
            if f < best_f:
                best_f = f
                best_x = x
                
    return best_x
