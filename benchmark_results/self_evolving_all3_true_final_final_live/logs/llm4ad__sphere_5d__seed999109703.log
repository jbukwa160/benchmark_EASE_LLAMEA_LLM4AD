def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(dim,))
    x_best = x.copy()
    for _ in range(budget):
        grad = np.zeros((dim,))
        for i in range(dim):
            delta = 1e-4 * (np.ones((dim,)) if i == rng.randint(0, dim) else np.zeros((dim,)))
            grad[i] = func(x + delta) - func(x)
            x[i] += 1e-5 * (-grad[i])
        x = np.clip(x, lb, ub)
        if func(x) < func(x_best):
            x_best = x.copy()
    return x_best
