def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def polynomial_mutation(x, delta):
        for i in range(dim):
            if rng.uniform(0, 1) < 0.01:
                x[i] += delta * rng.normal(0, 1)
        return clip(x, lb, ub)

    def differential_evolution(population, func):
        offspring = []
        for _ in range(int(budget / dim)):
            idx1, idx2, idx3 = rng.choice(dim, 3, replace=False)
            mutant = population[idx1] + delta * (population[idx2] - population[idx3])
            mutant = polynomial_mutation(mutant, delta)
            offspring.append(mutant)
        return np.array(offspring)

    def simulated_annealing(population, func):
        temperature = 1000
        for _ in range(int(budget / dim)):
            idx1, idx2 = rng.choice(dim, 2, replace=False)
            new_x = population[idx1] + delta * (population[idx2] - population[idx1])
            new_x = polynomial_mutation(new_x, delta)
            if func(new_x) < func(population[idx1]):
                population[idx1] = new_x
            temperature *= 0.99
        return population

    dim_init = int(np.sqrt(budget))
    delta = (ub - lb) / dim_init
    population = np.random.uniform(lb, ub, size=(dim_init, dim))

    for _ in range(int((budget / dim_init)**2)):
        offspring = differential_evolution(population, func)
        population = simulated_annealing(np.concatenate((population, offspring), axis=0), func)

    best_x = population[np.argmin([func(x) for x in population])]

    return clip(best_x, lb, ub)
