def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidates):
        return np.clip(candidates, lb, ub)

    init = np.array([0] * dim)
    init = clip(init)

    best_x = init.copy()
    best_f = func(best_x)

    for _ in range(budget):
        # "Smart" initialisation strategy
        new_x = init + 2.38 / (dim ** 0.5) * rng.normal(size=dim)
        new_x = clip(new_x)

        # DE-like mutation step
        x_mutated = best_x + 1.0 * rng.normal(size=dim)
        x_mutated = clip(x_mutated)

        new_x = (new_x + x_mutated) / 2

        new_f = func(new_x)
        
        if new_f < best_f:
            best_f = new_f
            best_x = new_x.copy()

    return best_x
