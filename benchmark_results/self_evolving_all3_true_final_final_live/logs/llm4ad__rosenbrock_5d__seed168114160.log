def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    NIND = int(budget / (D + 2))
    x = np.random.uniform(lb, ub, size=(NIND, D))
    y = func(x)

    for _ in range(budget):
        F = 0.5
        CR = 0.9
        r1 = rng.randint(0, NIND - 1)
        r2 = rng.randint(0, NIND - 1)
        while r2 == r1:
            r2 = rng.randint(0, NIND - 1)

        v = x[r1] + F * (x[r2] - x[r1])
        for i in range(D):
            u = np.random.uniform(0, 1) < CR and np.random.uniform(lb, ub) or x[r1][i]
            v[i] = np.clip(u, lb, ub)

        y_v = func(np.array([v]))
        if y_v < y[r1]:
            x[r1] = v
            y[r1] = y_v

    return np.min(x, axis=0)
