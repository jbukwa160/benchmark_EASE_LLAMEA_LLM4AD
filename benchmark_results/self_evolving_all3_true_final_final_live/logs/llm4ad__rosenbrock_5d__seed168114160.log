def algorithm(func, dim, lb, ub, budget, rng):
    def grad_func(x):
        return 2 * (np.array([x[i+1] - x[i]**2 for i in range(dim-1)]) + [0]) * 200 * (x[1:] - x[:-1]**2) + 2 * np.array([1 - x_i for i, x_i in enumerate(x)])

    def quasi_newton_step(x):
        H = np.eye(dim)
        d = -np.linalg.solve(H, grad_func(x))
        new_x = x + 0.1 * d
        return new_x

    best_x = rng.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for _ in range(budget):
        new_x = quasi_newton_step(best_x)
        clipped_new_x = np.clip(new_x, lb, ub)
        f_new = func(clipped_new_x)
        
        if f_new < best_f:
            best_f = f_new
            best_x = clipped_new_x

    return best_x
