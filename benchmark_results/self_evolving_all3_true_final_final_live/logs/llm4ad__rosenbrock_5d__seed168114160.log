def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def objective(x):
        x = clip(x)
        return func(x)

    init_x = rng.uniform(lb, ub, size=(dim,))
    best_x = init_x
    best_f = objective(best_x)

    for _ in range(budget):
        mutant = np.copy(init_x)
        idx = rng.choice(dim, 2, replace=False)
        mutant[idx[0]] += rng.gauss(0, 1)
        mutant[idx[1]] += rng.gauss(0, 1)
        cross_idx = [i for i in range(dim) if i not in idx]
        mutant[cross_idx] = init_x[cross_idx]

        trial_f = objective(mutant)

        if rng.uniform(0, 1) < np.exp((best_f - trial_f) / (1e-6 + rng.uniform(0.01, 0.1))):
            best_x = mutant
            best_f = trial_f

    return best_x
