def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    sigma = 0.5
    T_init = 1000
    cooling_rate = 0.99

    def simulated_annealing(x0, func, lb, ub, T, rng):
        x = np.copy(x0)
        while T > 1:
            delta = rng.uniform(-T, T)
            new_x = x + delta
            for i in range(dim):
                if new_x[i] < lb: new_x[i] = lb
                elif new_x[i] > ub: new_x[i] = ub
            f_new = func(new_x)
            f_old = func(x)
            if f_new <= f_old:
                x = np.copy(new_x)
            else:
                if rng.random() < np.exp((f_old - f_new) / T):
                    x = np.copy(new_x)
            T *= cooling_rate
        return x

    def differential_evolution(func, lb, ub, dim, pop_size, sigma, rng):
        pop = np.random.uniform(lb, ub, (pop_size, dim))
        for _ in range(budget - 1):
            pop_new = np.copy(pop)
            for i in range(pop_size):
                r1 = np.random.choice(pop_size, size=2, replace=False)
                if rng.random() < 0.5:
                    diff = pop[r1[1]] - pop[r1[0]]
                else:
                    diff = pop[r1[0]] - pop[r1[1]]
                new_x = pop[i] + sigma * np.clip(diff, -10, 10)
                for j in range(dim):
                    if new_x[j] < lb: new_x[j] = lb
                    elif new_x[j] > ub: new_x[j] = ub
                pop_new[i] = new_x
            pop = pop_new
        return np.min(func(pop), axis=0)

    x_best_DE = differential_evolution(func, lb, ub, dim, pop_size, sigma, rng)
    x_best_SA = simulated_annealing(x_best_DE, func, lb, ub, T_init, rng)
    return x_best_SA
