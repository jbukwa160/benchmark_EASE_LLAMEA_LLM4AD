def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidates(pop_size, mean, sigma):
        candidates = np.random.randn(pop_size, dim)
        return candidates * sigma + mean

    def clip(candidates, lb, ub):
        return np.clip(candidates, lb, ub)

    def evaluate(population):
        scores = []
        for x in population:
            score = func(x)
            scores.append(score)
        return np.array(scores)

    def update_distribution(pop_size, mean, sigma, weights, population, scores):
        sorted_indices = np.argsort(scores)
        top_weights = 1 / (pop_size * weights[sorted_indices[-1]])
        for i in range(1, pop_size):
            top_weights += 1 / (i * weights[sorted_indices[-i-1]])
        mean = np.average(population, axis=0, weights=top_weights)
        sigma *= np.sqrt(np.sum(top_weights) / pop_size)
        covariances = np.cov(population.T, rowvar=False, aweights=top_weights)
        for i in range(dim):
            covariances[i, i] += 1e-8
        U, s, V = np.linalg.svd(covariances)
        sigma *= np.sqrt(np.prod(s))
        mean -= (mean - population[-1]) / (1 + pop_size * top_weights[-1])
        return mean, sigma

    def restart_cmaes(pop_size, dim, lb, ub, budget, rng):
        best = None
        mean = 0.5 * np.ones(dim)
        sigma = 0.1
        weights = np.ones(pop_size) / pop_size
        for iteration in range(budget // (pop_size + 2)):
            population = generate_candidates(pop_size, mean, sigma)
            clipped_population = clip(population, lb, ub)
            scores = evaluate(clipped_population)
            best_score = np.min(scores)
            if best is None or best_score < best['score']:
                best = {'x': clipped_population[np.argmin(scores)], 'score': best_score}
            mean, sigma = update_distribution(pop_size, mean, sigma, weights, clipped_population, scores)
        return best

    def kmeans_clustering(population):
        n_clusters = int(np.ceil(np.sqrt(len(population))))
        centroid_indices = np.random.choice(len(population), size=n_clusters, replace=False)
        centroids = population[centroid_indices]
        labels = np.zeros(len(population))
        for i in range(n_clusters):
            labels += (population - centroids[i]) ** 2
        return np.argmin(labels, axis=0)

    def restart_kmeans(pop_size, dim, lb, ub, budget, rng):
        best = None
        population = generate_candidates(pop_size, 0.5 * np.ones(dim), 0.1)
        clipped_population = clip(population, lb, ub)
        scores = evaluate(clipped_population)
        for iteration in range(budget // (pop_size + 2)):
            labels = kmeans_clustering(clipped_population)
            centroid_indices = np.unique(labels)
            centroids = clipped_population[centroid_indices]
            new_population = np.zeros((len(clipped_population), dim))
            for i, label in enumerate(labels):
                mean = np.mean(clipped_population[i], axis=0) if label == 0 else np.mean(centroids[label])
                sigma = np.std(clipped_population[i]) if label == 0 else np.std(centroids[label])
                new_population[i] = generate_candidates(1, mean, sigma)[0]
            clipped_new_population = clip(new_population, lb, ub)
            scores_new = evaluate(clipped_new_population)
            best_score = np.min(scores_new)
            if best is None or best_score < best['score']:
                best = {'x': clipped_new_population[np.argmin(scores_new)], 'score': best_score}
        return best

    restarts = 10
    results = []
    for _ in range(restarts):
        result = restart_kmeans(pop_size=50, dim=dim, lb=lb, ub=ub, budget=budget, rng=rng)
        results.append(result['x'])
    return np.array([result for result in results if result == results[0]])[0]
