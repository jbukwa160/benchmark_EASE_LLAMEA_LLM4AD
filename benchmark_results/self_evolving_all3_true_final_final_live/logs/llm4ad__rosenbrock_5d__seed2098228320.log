def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    min_val = float('inf')
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        val = func(x)
        if val < min_val:
            min_val = val
            best = x
        # Build a probabilistic model of the objective function
        mean = np.zeros(dim)
        cov = 1e-3 * np.eye(dim)
        for _ in range(10):  # number of iterations for SMBO
            x_new = np.random.multivariate_normal(mean, cov)
            x_new = np.clip(x_new, lb, ub)  # clip candidates to [lb, ub]
            val_new = func(x_new)
            if val_new < min_val:
                mean += (val_new - val) * x_new
                cov *= (1 + (x_new**2).sum()) / (dim + 1)
                best = x_new
                min_val = val_new
    return best
