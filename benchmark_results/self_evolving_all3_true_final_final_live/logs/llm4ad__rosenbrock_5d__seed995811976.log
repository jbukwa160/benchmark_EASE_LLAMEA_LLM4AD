def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    gradient = None

    for _ in range(budget):
        g = np.zeros(dim)
        for i in range(dim - 1):
            g[i] = 2 * 100 * (x[i+1] - x[i]**2) * (2*x[i]*100 + 1 - x[i+1]) + 2*(x[i] - 1)
        g[-1] = 2 * (x[-1] - 1)

        step_size = np.clip(0.01 / np.linalg.norm(g), 1e-6, 0.5)
        new_x = clip(x - step_size * g)

        if func(new_x) < func(best_x):
            best_x = new_x

        x = new_x

    return best_x
