def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    D = dim
    N = int(np.ceil(budget / (D * 20)))
    pop_size = min(N, int(rng.uniform(10, 50)))

    if pop_size == 0:
        x_best = rng.uniform(lb, ub, size=D)
        return bound(x_best)

    population = rng.uniform(lb, ub, size=(pop_size, D))
    for _ in range(int(budget / (D * 20))):
        z = population.copy()
        for i in range(pop_size):
            r1, r2, r3 = rng.choice(pop_size, size=3, replace=False)
            if rng.rand() < 0.5:
                mutation = bound(z[r1] + rng.uniform(-1, 1) * (population[r1] - population[r2]))
            else:
                mutation = bound(z[r1] + rng.uniform(-1, 1) * (z[r1] - z[r2]))
            crossover = population[r3] + rng.uniform(0, 1) * (mutation - population[r3])
            z[i] = crossover
        z = np.array([func(x) for x in bound(z)])
        idxs = np.argsort(z)[:pop_size]
        population = population[idxs]
        x_best = bound(population[0])

    return x_best
