def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def sample_candidate(mean, cov):
        return np.random.multivariate_normal(mean, cov)

    best = None
    max_fitness = -np.inf
    for i in range(budget):
        if i > 0:
            mean = current_best
            cov = current_cov
        else:
            mean = np.zeros(dim)
            cov = np.eye(dim) * 1e-4

        candidates = [clip(sample_candidate(mean, cov)) for _ in range(50)]

        fitnesses = [func(candidate) for candidate in candidates]

        sorted_indices = np.argsort(fitnesses)

        max_fitness_new = fitnesses[sorted_indices[-1]]
        best_candidate = clip(candidates[sorted_indices[-1]])

        if max_fitness_new > max_fitness:
            current_best = mean + 0.5 * (best_candidate - mean)
            current_cov = 0.5 * cov + 0.25 * np.outer(best_candidate - mean, best_candidate - mean)

            max_fitness = max_fitness_new
            best = best_candidate

        if rng.uniform(0, 1) < 0.01:
            mean += np.random.normal(size=dim)
            cov *= 2.38 / (dim + 1.4)

    return best
