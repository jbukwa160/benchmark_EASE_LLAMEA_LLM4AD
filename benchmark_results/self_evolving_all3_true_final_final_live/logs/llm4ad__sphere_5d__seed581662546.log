def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    for _ in range(budget):
        i = rng.randint(0, dim)
        delta = 2 * rng.uniform(-1, 1) - 1
        new_x = x.copy()
        new_x[i] += delta
        new_x = np.clip(new_x, lb, ub)
        if func(new_x) < func(x):
            x = new_x
    return x
