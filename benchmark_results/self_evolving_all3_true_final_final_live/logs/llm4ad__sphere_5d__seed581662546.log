def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    sigma = 1.0
    mu = np.zeros(dim)
    pop_size = min(100, int(budget / dim))
    iteration = 0

    while iteration < budget:
        iteration += 1
        population = rng.normal(mu, sigma, (pop_size, dim))

        population = clip(population)

        fitnesses = func(population)

        ranks = np.argsort(fitnesses)
        mu = np.mean(population[ranks[:int(0.1 * pop_size)], :], axis=0)

    return clip(mu)
