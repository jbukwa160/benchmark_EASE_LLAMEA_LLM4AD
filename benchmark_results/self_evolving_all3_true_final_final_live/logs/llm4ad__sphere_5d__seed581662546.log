def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(mu, sigma):
        candidate = mu + sigma * rng.normal(size=(dim,))
        return clip(candidate)

    def evolve_population(population, weights, budget_remaining):
        if not population:
            return []

        new_population = []
        for _ in range(budget - 1):
            parent_indices = np.random.choice(len(population), size=dim, p=weights)
            parents = [population[i] for i in parent_indices]
            mu = np.mean(parents, axis=0)

            # Adapt sigma based on the population's spread
            sigma = np.sqrt(np.sum(weights * (np.linalg.norm(parent - mu) ** 2 for parent in parents)) / sum(weights))

            candidate = generate_candidate(mu, sigma)
            new_population.append(candidate)

        return new_population

    def optimize():
        population = [generate_candidate(np.zeros(dim), 1.0)]
        weights = np.ones(len(population)) / len(population)

        while budget > 0:
            budget -= 1
            new_population = evolve_population(population, weights, budget)
            population.extend(new_population)
            weights = np.array([1.0 / len(population) for _ in range(len(population))])

            fitnesses = [func(x) for x in population]
            best_index = np.argmin(fitnesses)
            best_candidate = population[best_index]

        return best_candidate

    return optimize()
