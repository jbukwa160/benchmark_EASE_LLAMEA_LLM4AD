def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_y = float('inf')
    
    for _ in range(budget):
        x = lb + (ub - lb) * rng.rand(dim)
        
        if not (np.all(x >= lb) and np.all(x <= ub)):
            continue
        
        y = func(x)
        
        if y < best_y:
            best_x = x
            best_y = y
    
    return best_x
