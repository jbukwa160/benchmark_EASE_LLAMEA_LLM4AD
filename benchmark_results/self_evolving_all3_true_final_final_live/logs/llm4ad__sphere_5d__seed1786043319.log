def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.zeros(dim)
    T = 1.0
    beta = 0.99
    sigma = 5.0
    best_x = x.copy()
    best_f = func(x)
    for i in range(budget):
        if rng.random() < 0.05:
            x += rng.uniform(-sigma, sigma, size=dim)
        else:
            dx = rng.normal(0, 1e-2, size=dim)
            x += dx
        x = clip(x)
        f = func(x)
        if f < best_f:
            best_x = x.copy()
            best_f = f
        T *= beta
        sigma /= (1 + i / budget) ** 0.5
    return best_x
