def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    current = np.zeros(dim)
    best = current.copy()
    for _ in range(budget):
        perturbation = rng.uniform(-1, 1, size=dim) * 0.01
        new_current = clip(current + perturbation)
        if func(new_current) < func(best):
            best = new_current
            current = new_current.copy()
        elif rng.random() < 0.05:
            current = np.clip(rng.uniform(lb, ub, size=dim), lb, ub)
    return best
