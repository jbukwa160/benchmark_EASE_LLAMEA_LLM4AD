def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        for i in range(dim):
            noise = rng.uniform(-1.0, 1.0)
            new_x = clip(best_x + noise * (best_x - lb))
            new_f = func(new_x)
            
            if new_f < best_f:
                best_x = new_x
                best_f = new_f
                
    return best_x
