def algorithm(func, dim, lb, ub, budget, rng):
    X = rng.uniform(lb, ub, size=(budget, dim))
    for _ in range(budget):
        Y = func(X)
        idx = np.argmin(Y)
        if Y[idx] < budget:
            return X[idx]
    return None
