def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    y_best = func(x)
    cma_rho = 0.1
    sigma = 1.0
    mu = int(0.1 * dim)

    for i in range(budget):
        # selection
        c = rng.normal(size=(mu, dim))
        x_new = x + sigma * np.dot(c, np.diag(np.exp(rng.uniform(-cma_rho, cma_rho, size=dim))))

        # clip candidates to bounds
        x_new = np.clip(x_new, lb, ub)

        # evaluation
        y_new = func(x_new)
        
        # update best solution
        if y_new < y_best:
            y_best = y_new
            x_best = x_new

        # update population mean and variance
        x = (1 - 2 * cma_rho) * x + cma_rho * x_new
        sigma *= np.exp(0.5 * rng.normal() - 0.5)
    
    return x_best
