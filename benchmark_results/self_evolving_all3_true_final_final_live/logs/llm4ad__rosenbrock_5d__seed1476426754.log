def algorithm(func, dim, lb, ub, budget, rng):
    def clipped(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(candidate):
        candidate = clipped(candidate)
        return func(candidate)

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = evaluate(x_best)

    for _ in range(budget):
        p = 0.1
        sigma = 0.2

        x_new = np.copy(x_best)
        for i in range(dim):
            if rng.random() < p:
                noise = rng.normal(0, sigma)
                x_new[i] += noise

        f_new = evaluate(x_new)

        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
