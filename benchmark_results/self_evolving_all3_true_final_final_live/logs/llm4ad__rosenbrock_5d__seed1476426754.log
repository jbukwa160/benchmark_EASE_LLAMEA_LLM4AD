def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_x = lb + (ub - lb) * rng.rand(dim)
    best_f = func(clip(best_x))

    for _ in range(budget):
        x_rand = lb + (ub - lb) * rng.rand(dim)
        f_rand = func(clip(x_rand))
        if f_rand < best_f:
            best_x, best_f = x_rand, f_rand

        F = 0.5
        alpha = 0.01
        T = _ / budget

        while True:
            candidate = best_x + (best_x - x_rand) * rng.rand() ** alpha + np.sqrt(T) * rng.randn(dim)
            candidate = clip(candidate)

            f_candidate = func(candidate)
            if f_candidate < best_f:
                best_x, best_f = candidate, f_candidate
                break

    return best_x
