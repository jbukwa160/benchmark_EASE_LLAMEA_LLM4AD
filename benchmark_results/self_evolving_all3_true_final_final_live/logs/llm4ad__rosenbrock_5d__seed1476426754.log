def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for _ in range(budget // 10 + 1):
        x_new = []
        for i in range(dim):
            if len(x_new) == 0:
                sigma = rng.uniform(0.01, 2.0)
            else:
                sigma = np.mean([x[1] - x[0] for x in zip(x_new, [np.nan] * (i - 1) + list(x_new))])

            sample_x = best_x + rng.normal(size=i+1, loc=0, scale=sigma)
            sample_x[:i] = np.clip(sample_x[:i], lb, ub)

            if not np.isnan(np.sum(sample_x)):
                x_new.append(sample_x)

        x_new = np.array(x_new).astype(float)
        valid_mask = (x_new[:, 1:] > x_new[:, :-1]**2) & (x_new[:, 1:] < ub) & (x_new[:, :-1] >= lb)
        x_new = x_new[valid_mask]

        if len(x_new) > 0:
            sample_f = func(x_new)
            idx = np.argmin(sample_f)

            for i in range(dim):
                new_x = x_new[idx]
                best_f_candidate = func(new_x)

                if best_f_candidate < best_f:
                    best_f = best_f_candidate
                    best_x = new_x

    return best_x
