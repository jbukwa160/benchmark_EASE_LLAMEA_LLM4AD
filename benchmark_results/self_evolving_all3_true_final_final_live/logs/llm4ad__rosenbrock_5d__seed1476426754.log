def algorithm(func, dim, lb, ub, budget, rng):
    def obj(x):
        return func(x)

    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    n = dim
    D = 1.0 + (ub - lb) / 3.0
    C = np.eye(n)
    mu = rng.normal(size=n) * D

    for i in range(budget):
        x = clip(mu)
        f_x = obj(x)

        y = rng.normal(size=n) * D
        s, c = np.linalg.eigvals(C), np.linalg.eigh(C)
        C = 0.5 * (c + np.transpose(np.conj(c))) @ np.diag(np.exp(y)) @ c

        alpha = 1.0 / (1 + np.sum(y**2))
        mu += alpha * y
        mu = clip(mu)

    return mu
