def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    best = np.zeros(dim)
    best_fitness = float('inf')

    for _ in range(budget):
        population_size = int(budget * 0.1)
        mutation_prob = 0.5
        crossover_prob = 0.5

        population = rng.uniform(lb, ub, (population_size, dim))

        for _ in range(population_size):
            parent = best.copy()
            if rng.rand() < mutation_prob:
                mutation = rng.normal(0, 1, dim)
                parent += mutation
                parent = clip(parent, lb, ub)

            child = population[rng.randint(population_size)]
            if rng.rand() < crossover_prob:
                for i in range(dim):
                    if rng.rand() < 0.5:
                        child[i] = (parent[i] + child[i]) / 2
                        parent[i] = child[i]

            fitness = func(child)
            if fitness < best_fitness:
                best_fitness = fitness
                best = child

    return best
