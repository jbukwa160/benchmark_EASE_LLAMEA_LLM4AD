def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    n = 10  # number of offspring for each iteration
    mu = 1.0 / np.sqrt(dim)  # step size parameter
    sigma = 1.0  # initial standard deviation
    x_best = rng.uniform(lb, ub, dim)
    f_best = func(x_best)

    for i in range(budget):
        offspring = [clip(x_best + mu * rng.normal(0, sigma, dim)) for _ in range(n)]
        f_offspring = [func(x) for x in offspring]
        
        # Simulated Annealing (SA) component
        tau = 1.5 / np.sqrt(np.log(i + 2))
        sa_probability = np.exp(-np.array(f_offspring) - f_best) / tau
        
        # CMA-ES update
        idx = np.random.choice(n, n, replace=False, p=sa_probability)
        x_new = np.mean([offspring[i] for i in idx], axis=0)
        
        if func(x_new) < f_best:
            x_best = x_new
            f_best = func(x_best)

    return clip(x_best)
