def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate(parents, sigma):
        children = parents + rng.normal(size=(len(parents), dim)) * sigma
        children = clip(children)
        return children

    best_solution = rng.uniform(low=lb, high=ub, size=dim)
    best_fitness = func(best_solution)

    for _ in range(budget):
        new_solutions = generate([best_solution], 0.1)
        fitnesses = [func(s) for s in new_solutions]

        idx = np.argmin(fitnesses)
        if fitnesses[idx] < best_fitness:
            best_solution = new_solutions[idx]
            best_fitness = fitnesses[idx]

    return best_solution
