def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(-5, 5, size=dim)
    best_x = x.copy()
    best_y = func(x)

    for _ in range(budget):
        y = func(best_x)
        candidates = [best_x]

        for i in range(dim):
            candidate = best_x.copy()
            if rng.random() < 0.5:
                if rng.random() < 0.5:
                    delta = np.exp(rng.normal(0, 1)) * (ub - lb) / 2
                    candidate[i] += rng.uniform(-delta, delta)
                else:
                    candidate[i] = np.clip(best_x[i] + rng.uniform(lb, ub), lb, ub)
            else:
                if rng.random() < 0.5:
                    candidate[i] = rng.uniform(lb, ub)
                else:
                    candidate[i] = best_x[i]

            candidates.append(candidate)

        candidates = [c for c in candidates if np.all(c >= lb) and np.all(c <= ub)]

        if len(candidates) > 1:
            scores = [func(c) for c in candidates]
            idx = np.argmin(scores)
            candidate = candidates[idx]
            best_x = candidate
            best_y = func(best_x)

    return best_x
