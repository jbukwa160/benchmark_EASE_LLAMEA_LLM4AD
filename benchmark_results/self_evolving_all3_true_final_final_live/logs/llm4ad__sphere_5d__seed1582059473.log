def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def sample():
        return rng.uniform(lb, ub, size=dim)

    x_best = clip(sample())
    f_best = func(x_best)
    for _ in range(budget - 1):
        x_candidate = clip(sample())
        f_candidate = func(x_candidate)
        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate
    return x_best
