def algorithm(func, dim, lb, ub, budget, rng):
    def sample(bounds, sigma=1e-2):
        return bounds + (ub - lb) * np.random.normal(size=(dim,), loc=.5, scale=sigma)

    def evaluate(candidate):
        clipped = np.clip(candidate, lb, ub)
        return func(clipped), clipped

    best_candidate = lb + (ub - lb) * rng.uniform(size=dim)
    current_best = evaluate(best_candidate)[0]

    for _ in range(budget):
        sample_indices = np.random.choice(dim, size=int(.1*dim), replace=False)
        new_candidates = [evaluate(sample(bounds=np.clip(candidate, lb, ub))) for candidate in sample(ub - lb) + best_candidate]
        new_candidates.sort(key=lambda x: x[0])
        
        for _, (fitness, candidate) in enumerate(new_candidates[:int(.8*len(new_candidates))]):
            if fitness < current_best:
                best_candidate = candidate
                current_best = fitness

    return best_candidate
