def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    n_iter = int(budget / (dim * 10))
    x_best = lb + rng.rand(dim) * (ub - lb)
    f_best = func(x_best)
    
    for _ in range(n_iter):
        t = max(0.01, 1 - (_/n_iter)**2)
        n_perturbations = int(dim / np.sqrt(_))
        
        for _ in range(n_perturbations):
            i = rng.randint(dim)
            step_size = (ub - lb) * rng.rand()
            
            x_new = clip(x_best.copy())
            x_new[i] += step_size
            
            f_new = func(x_new)
            
            if f_new < f_best:
                x_best = x_new
                f_best = f_new
                
    return x_best
