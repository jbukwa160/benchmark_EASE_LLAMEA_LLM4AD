def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    for _ in range(budget):
        x_new = np.random.uniform(lb, ub, size=dim) + 0.1 * rng.randn(dim)
        y_new = func(x_new)
        if y_new < func(x_best):
            x_best = x_new
    return x_best
