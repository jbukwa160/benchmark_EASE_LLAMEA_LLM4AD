def algorithm(func, dim, lb, ub, budget, rng):
    def sample(rng):
        return np.clip(rng.uniform(lb, ub, size=dim), a_min=lb, a_max=ub)

    candidates = [sample(rng) for _ in range(budget)]
    best_candidate = min(candidates, key=lambda x: func(x))

    def expected_improvement(x, model):
        mu, sigma = model.predict(np.array([x]))
        ei = (func(x) - mu) * np.exp(-((func(x) - mu) ** 2) / (2 * sigma ** 2))
        return ei

    for _ in range(budget - len(candidates)):
        x_new = sample(rng)
        model = func(np.array([x_new]))
        expected_improvement_value = expected_improvement(x_new, model)
        if expected_improvement_value > np.mean([expected_improvement(x, model) for x in candidates]):
            best_candidate = x_new

    return best_candidate
