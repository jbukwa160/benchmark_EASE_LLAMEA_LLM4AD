def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 1.0
    D = np.diag(rng.randn(dim))
    x = rng.uniform(lb, ub, size=dim)
    best_x = np.copy(x)

    for _ in range(budget):
        y = x + sigma * np.dot(D, rng.randn(dim))
        y = np.clip(y, lb, ub)

        if func(y) < func(best_x):
            best_x = y

        r = (func(best_x) - func(y)) / func(best_x)
        D *= 1 + r
        x = best_x + sigma * np.dot(D, rng.randn(dim))
        x = np.clip(x, lb, ub)

    return best_x
