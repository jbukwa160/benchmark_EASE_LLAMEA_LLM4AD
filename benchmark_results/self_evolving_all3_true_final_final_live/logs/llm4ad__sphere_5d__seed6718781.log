def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(clip(x_best))

    for _ in range(budget):
        x_new = clip(x_best + rng.normal(size=dim) * 0.1)
        f_new = func(clip(x_new))
        
        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
