def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    n_vars = dim
    init_temp = 1.0
    alpha = 0.99
    cooling_schedule = []

    def generate_candidate(current_point):
        for i in range(n_vars):
            if rng.random() < 0.5:
                current_point[i] += (ub - lb) * rng.uniform(-1, 1)
            else:
                current_point[i] -= (ub - lb) * rng.uniform(-1, 1)
            current_point[i] = clip(current_point[i])
        return current_point

    def evaluate_point(point):
        return func(clip(point))

    best_point = np.zeros(n_vars)
    current_point = np.copy(best_point)

    for i in range(budget):
        cooling_schedule.append(init_temp * (alpha ** len(cooling_schedule)))
        new_point = generate_candidate(np.copy(current_point))
        if evaluate_point(new_point) < evaluate_point(current_point):
            current_point = new_point
        elif rng.random() < np.exp((evaluate_point(current_point) - evaluate_point(new_point)) / cooling_schedule[-1]):
            current_point = new_point

    return current_point
