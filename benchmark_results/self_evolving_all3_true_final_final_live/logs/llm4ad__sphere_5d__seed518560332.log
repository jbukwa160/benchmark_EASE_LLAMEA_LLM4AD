def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    temp = 1.0
    x_best = np.random.uniform(lb, ub, n)
    f_best = func(x_best)

    for i in range(budget):
        x_new = x_best + rng.normal(0, 1, n) * (ub - lb)
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        
        if f_new < f_best:
            x_best = x_new
            f_best = f_new
        
        delta = f_new - f_best
        prob = np.exp(-delta / temp)
        
        if rng.random() < prob and delta <= 0:
            continue
        
        temp *= 0.99

    return x_best
