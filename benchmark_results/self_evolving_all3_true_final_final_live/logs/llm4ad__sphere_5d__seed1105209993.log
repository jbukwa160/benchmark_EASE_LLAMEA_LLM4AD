def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 1000.0
    alpha = 0.99
    
    for _ in range(budget):
        y = x.copy()
        
        # Coordinate Descent (CD) phase
        for i in range(dim):
            j = rng.choice(dim, replace=False)
            
            x[j] += 0.1 * np.sign(x[j]) * (ub - lb)
            if func(x) < func(y):
                y = x.copy()
        
        # Simulated Annealing (SA) phase
        Delta = func(y) - func(x)
        if Delta < 0 or rng.random() < np.exp(-Delta / T):
            x = y
        
        T *= alpha
    
    return x.clip(lb, ub)
