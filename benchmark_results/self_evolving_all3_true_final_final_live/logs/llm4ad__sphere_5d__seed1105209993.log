def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_x = np.zeros(dim)
    best_f = np.inf
    simplex_size = 10 * dim + 1
    x = np.random.uniform(lb, ub, (simplex_size, dim))

    for _ in range(budget):
        x_clipped = clip(x)
        f = func(x_clipped)

        if np.any(f < best_f):
            best_x = x_clipped[np.argmin(f)]
            best_f = np.min(f)

        # Sort by function value
        idx = np.argsort(f)
        x[idx[:dim], :] = x_clipped[idx[:dim]]

        # Reflection step
        centroid = np.mean(x, axis=0)
        r_x = 2 * centroid - x[0]
        r_f = func(clip(r_x))

        if f[0] > r_f:
            # Expansion step
            e_x = 1.5 * (centroid - x[0]) + x[0]
            e_f = func(clip(e_x))
            if e_f < r_f:
                x[0] = clip(e_x)
            else:
                x[0] = clip(r_x)

        # Contraction step
        c_x = 1.5 * (centroid - x[dim]) + x[dim]
        c_f = func(clip(c_x))
        if f[dim] > c_f and np.all(f < c_f):
            x[dim] = clip(c_x)

    return best_x
