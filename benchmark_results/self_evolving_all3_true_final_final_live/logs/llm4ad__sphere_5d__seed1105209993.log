def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    learning_rate = 0.1
    for _ in range(budget):
        gradient = func.gradient(x)
        step_size = (learning_rate / np.linalg.norm(gradient)) * -gradient
        new_x = x + step_size
        clipped_x = np.clip(new_x, lb, ub)
        if func(clipped_x) < func(x):
            x = clipped_x
    return x
