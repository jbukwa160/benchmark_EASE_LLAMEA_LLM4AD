def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = np.zeros(dim)
    best_obj = float('inf')
    
    for i in range(budget):
        N = int(np.log2(i + 1)) if i > 0 else 1
        n = int(budget / (i + 1))
        
        candidates = rng.uniform(lb, ub, size=(n, dim))
        
        for candidate in candidates:
            obj = func(candidate)
            
            if lb <= candidate <= ub:
                if obj < best_obj:
                    best_sol = candidate
                    best_obj = obj
                    
    return best_sol
