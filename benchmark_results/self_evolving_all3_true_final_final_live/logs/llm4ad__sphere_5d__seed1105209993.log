def algorithm(func, dim, lb, ub, budget, rng):
    n = len(dim)
    x_best = np.zeros(n)
    f_best = float('inf')
    
    for _ in range(budget):
        x_rand = np.clip(rng.uniform(lb, ub, size=n), lb, ub)
        f_rand = func(x_rand)
        
        if f_rand < f_best:
            x_best = x_rand
            f_best = f_rand
        
        # Successive Quadratic Approximation (SQA) update step
        B = np.eye(n)
        s = x_rand - x_best
        y = f_rand - f_best
        
        for i in range(n):
            p = np.zeros(n)
            p[i] = 1.0
            
            q = func(x_best + 0.01 * p) - f_best
            r = func(x_best + 0.01 * s) - f_best
            
            B[i, :] -= (q - r) / (0.01 * np.dot(s, s)) * s
        
        # Update quadratic model parameters
        m = np.linalg.solve(B, s)
        
        step_size = 1.0
        for i in range(n):
            x_new = x_best + step_size * m[i] * s
        
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)
        
        if f_new < f_best:
            x_best = x_new
            f_best = f_new
    
    return x_best
