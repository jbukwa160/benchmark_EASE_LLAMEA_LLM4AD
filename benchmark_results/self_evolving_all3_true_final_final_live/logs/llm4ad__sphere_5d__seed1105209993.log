def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(budget):
        # Gradient evaluation
        grad = np.full(dim, 2 * (func(x) - np.sum(x**2)) / dim)
        
        # Randomized gradient descent update
        step_size = rng.uniform(0.001, 0.1)
        x += step_size * grad
        
        # Clip to bounds
        x = np.clip(x, lb, ub)
        
        # Evaluate new function value and update best solution if necessary
        f = func(x)
        if f < best_f:
            best_x = x.copy()
            best_f = f
    
    return best_x
