def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(pop_size, dim):
        return rng.uniform(lb, ub, (pop_size, dim))

    def mutation(population, mu, sigma):
        noise = rng.normal(0, 1, population.shape)
        return population + mu * population + sigma * noise

    def crossover(parents, children):
        return np.where(rng.rand(*parents.shape) < 0.5, parents, children)

    pop_size = int(budget ** 0.5)
    initial_population = generate_initial_population(pop_size, dim)
    best_solution = clip(initial_population[rng.randint(0, pop_size)])
    temperature = 1
    sigma = 3

    for _ in range(budget):
        candidates = mutation(initial_population, mu=0.2, sigma=sigma / (temperature + 1))
        clipped_candidates = clip(candidates)
        f_values = func(clipped_candidates)

        parents = np.argsort(f_values)[:pop_size]
        children = crossover(clipped_candidates[parents], clipped_candidates[rng.randint(0, pop_size)])

        f_values_children = func(children)
        mask = f_values_children < f_values[parents]

        new_population = np.where(mask, children, initial_population[parents])
        initial_population = new_population

        f_values_new = func(initial_population)

        mask_best = f_values_new < func(best_solution)
        if np.any(mask_best):
            best_solution = clip(initial_population[np.argmax(f_values_new)])

        temperature *= 0.99
        sigma /= (1 + 1 / (budget - _))

    return best_solution
