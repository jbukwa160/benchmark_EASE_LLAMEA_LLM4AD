def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_stepsize(dim, sigma0=1.0, c1=2.0, cMu=1.0):
        return 10 / (dim ** (cMu + 1) * ((budget // dim) ** (cMu - 1)) ** (0.5))

    def cma_stepsize(dim, lambda_, sigma0=1.0):
        return np.sqrt(4 * lambda_ / dim)

    def clip(x, lb, ub):
        return np.clip(x, a_min=lb, a_max=ub)

    def sample_gaussian(sigma):
        return rng.normal(loc=0, scale=sigma, size=(dim,))

    def evaluate_candidate(candidate):
        clipped_candidate = clip(candidate, lb, ub)
        return func(clipped_candidate)

    sigma = gaussian_stepsize(dim)
    population_size = 10
    lambda_ = population_size

    for _ in range(budget):
        parent_candidates = sample_gaussian(sigma) + np.zeros((population_size, dim))
        parent_fitnesses = [evaluate_candidate(parent_candidate) for parent_candidate in parent_candidates]

        mean = np.mean(parent_candidates, axis=0)
        sigma = cma_stepsize(dim, lambda_, sigma)

        candidates = sample_gaussian(sigma) + mean
        candidate_fitnesses = [evaluate_candidate(candidate) for candidate in candidates]

        best_candidate_index = np.argmin(candidate_fitnesses)
        best_candidate = clip(candidates[best_candidate_index], lb, ub)

    return best_candidate
