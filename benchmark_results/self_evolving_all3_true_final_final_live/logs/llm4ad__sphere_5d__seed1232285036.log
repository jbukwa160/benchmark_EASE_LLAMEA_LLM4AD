def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(current_point):
        new_point = current_point + rng.normal(size=dim) * 0.1
        new_point = np.clip(new_point, lb, ub)
        return new_point

    def evaluate_point(point):
        return func(point)

    current_point = rng.uniform(lb, ub, size=dim)
    best_point = current_point.copy()
    best_fitness = float('inf')
    temperature = 1.0
    cooling_rate = 0.99

    for _ in range(budget):
        new_point = generate_candidate(current_point)
        new_fitness = evaluate_point(new_point)

        if new_fitness < best_fitness:
            best_fitness = new_fitness
            best_point = new_point.copy()

        temperature *= cooling_rate
        if np.random.rand() < np.exp((best_fitness - new_fitness) / temperature):
            current_point = new_point

    return best_point
