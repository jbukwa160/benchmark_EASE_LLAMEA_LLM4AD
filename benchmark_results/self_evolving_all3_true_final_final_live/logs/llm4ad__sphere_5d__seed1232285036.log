def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    best_x = rng.uniform(lb, ub, size=dim)
    best_f = evaluate(best_x)
    budget_used = 1

    for _ in range(2, budget + 1):
        x = best_x + rng.normal(size=dim) * 0.05
        x = np.clip(x, lb, ub)

        f = evaluate(x)
        if f < best_f:
            best_f = f
            best_x = x

    return best_x
