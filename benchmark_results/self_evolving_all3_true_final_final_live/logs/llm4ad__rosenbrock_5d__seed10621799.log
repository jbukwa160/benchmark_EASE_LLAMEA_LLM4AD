def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x), len(np.where((x - 1)**2 < 0.001)[0]) == dim

    best_x = None
    best_f = float('inf')
    pop_size = int(4 + np.log(budget)) if budget > 10 else min(int(16 * (budget ** (1 / 3))), 50)
    sigma = 0.5
    lambda_ = pop_size // 2
    mu = 1 / lambda_
    x = rng.uniform(-5, 5, size=(pop_size, dim))
    for _ in range(budget):
        if evaluate(x):
            return x
        f, c = [func(clip(x_i)) for x_i in x], np.zeros(pop_size)
        for i in range(lambda_):
            s = rng.normal(size=dim)
            new_x = clip(x[i] + sigma * s)
            f_new, _ = evaluate(new_x)
            if f_new < f[i]:
                x[i] = new_x
                f[i] = f_new
                c[i] = 1
        for i in range(lambda_):
            if c[i] == 0:
                s = rng.normal(size=dim)
                new_x = clip(x[i] + sigma * s)
                f_new, _ = evaluate(new_x)
                if f_new < f[i]:
                    x[i] = new_x
                    f[i] = f_new
        cov = np.dot((x - mu - np.expand_dims(f, 1)) ** 2, np.transpose(x - mu))
        sigma *= np.exp(0.05 * np.trace(cov) / pop_size)
        if sigma < 1e-6:
            x = rng.uniform(-5, 5, size=(pop_size, dim))
    return clip(np.mean(x, axis=0))
