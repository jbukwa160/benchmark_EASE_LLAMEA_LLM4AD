def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def cma_es(func, bounds, x0, popsize=50, sigma=1.0, maxiter=100, mu=0.8, damp=1e-10):
        n = len(bounds)
        mu = int(popsize * mu)
        D = 2 * n + 5
        cov = np.eye(n) * sigma**2
        xbest = x0.copy()
        for i in range(maxiter):
            candidates = rng.normal(loc=xbest, scale=np.sqrt(cov), size=(popsize, n))
            candidates[:, :] += xbest
            candidates = clip(candidates, bounds[0], bounds[1])
            fs = np.array([func(candidate) for candidate in candidates])
            ind = np.argsort(fs)
            if fs[ind[0]] < func(xbest):
                xbest = candidates[ind[0]]
            cov = (1 - mu / popsize) * cov + mu / popsize * np.outer((candidates[ind[:mu], :] - xbest).T, (candidates[ind[:mu], :] - xbest))
        return xbest

    def differential_evolution(func, bounds, x0, maxiter=100, scaling_factor=0.8, crossover_prob=0.9):
        n = len(bounds)
        popsize = 50
        population = np.array([rng.uniform(lb, ub, size=n) for _ in range(popsize)]) + x0
        population = clip(population, lb, ub)
        best = func(population[0])
        for i in range(maxiter):
            for j in range(popsize):
                trial = np.copy(population[j])
                for k in range(n):
                    if rng.random() < crossover_prob:
                        trial[k] += scaling_factor * (population[rng.randint(0, popsize - 1), k] - population[j, k])
                trial = clip(trial, lb, ub)
                f_trial = func(trial)
                if f_trial < best:
                    best = f_trial
                    population[j] = trial
        return np.array([best])

    def powell_uobyqa(func, bounds, x0, maxiter=100):
        n = len(bounds)
        x = x0.copy()
        for i in range(maxiter):
            hessian_inv = np.eye(n)
            lambda_val = 1.0
            while True:
                gradient = np.array([func(np.append(x[:i], [x[i] + lambda_val])) - func(np.append(x[:i], [x[i] - lambda_val])) for i in range(n)])
                hessian_approx = (gradient[1:] - gradient[:-1]) / (2 * lambda_val)
                if np.linalg.norm(hessian_approx) < 1e-10:
                    break
                hessian_inv = np.linalg.solve(hessian_approx, hessian_inv)
                lambda_val *= 0.5
            step = hessian_inv @ gradient
            x += step
        return x

    x = clip(rng.uniform(lb, ub, size=dim), lb, ub)
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        candidates = []
        for _ in range(10):
            if rng.random() < 0.5:
                candidate = cma_es(func, [(lb[i], ub[i]) for i in range(dim)], x)
            elif rng.random() < 0.3:
                candidate = differential_evolution(func, [(lb[i], ub[i]) for i in range(dim)], x)
            else:
                candidate = powell_uobyqa(func, [(lb[i], ub[i]) for i in range(dim)], x)
            candidates.append(candidate)
        fs = np.array([func(candidate) for candidate in candidates])
        ind = np.argsort(fs)
        if fs[ind[0]] < best_f:
            best_x = candidates[ind[0]]
            best_f = fs[ind[0]]

    return best_x
