def algorithm(func, dim, lb, ub, budget, rng):
    def clipped_candidate(bounds, lower, upper):
        return min(max(np.array(candidate), lower), upper)

    def distance(x1, x2):
        return np.sum((x1 - x2)**2)

    current = rng.uniform(lb, ub)
    current = np.full(dim, current)
    best = current.copy()
    temperature = 10.0
    alpha = 0.99

    for _ in range(budget):
        candidate = clipped_candidate([lb]*dim + [ub]*dim, lb, ub)
        candidate[1:] = rng.uniform(lb, ub)

        # Calculate the change in fitness and distance between candidates
        delta_fitness = func(candidate) - func(current)
        delta_distance = distance(candidate, current)

        if delta_fitness < 0 or random.random() < np.exp(-delta_distance/temperature):
            current = candidate

        if func(best) > func(current):
            best = current.copy()

        temperature *= alpha

    return best
