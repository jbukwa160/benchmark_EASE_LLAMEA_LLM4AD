def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.minimum(np.maximum(x, lb), ub)

    x = np.random.uniform(lb, ub, size=(1, dim))
    best_x = x.copy()
    best_f = func(bound(x))

    for _ in range(2 * budget):
        for _ in range(dim):
            if rng.rand() < 0.5:
                # uniform mutation
                step = np.random.uniform(-1, 1)
                x[0, _] += step
                x[0, _] = bound(x[0, _])
            else:
                # perturbation-based mutation
                step = rng.normal(0, 0.5)
                x[0, _] += step
                x[0, _] = bound(x[0, _])

        f = func(bound(x))
        if f < best_f:
            best_x = x.copy()
            best_f = f

    return best_x
