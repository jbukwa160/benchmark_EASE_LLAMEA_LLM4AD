def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (1, dim))
    y = func(x)

    for _ in range(budget - 1):
        N = int(rng.rand() * 10) + 1
        simplex = np.zeros((N, dim))
        for i in range(N):
            v = rng.randn(dim)
            while np.linalg.norm(v) < 0.00001:
                v = rng.randn(dim)
            simplex[i] = x.copy()
            simplex[i] += np.sqrt(2 * N - 1) / (N + 1) * v
        simplex -= lb + (ub - lb) / (N + 1)
        for i in range(N):
            if func(simplex[i]) < y:
                x = simplex[i]
                y = func(x)

    return np.clip(x, a_min=lb, a_max=ub)
