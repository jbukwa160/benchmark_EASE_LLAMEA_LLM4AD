def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 10.0
    alpha = 0.99
    best_x = x.copy()
    best_y = func(x)

    for _ in range(budget):
        y = func(np.clip(x, lb, ub))
        if rng.random() < np.exp((best_y - y) / T):
            best_y = y
            best_x = x.copy()

        delta = 0.1 * (ub - lb)
        step = np.zeros(dim)
        for i in range(dim):
            step[i] = rng.uniform(-delta, delta)

        x_new = x + step
        x_new = np.clip(x_new, lb, ub)

        y_new = func(np.clip(x_new, lb, ub))
        if y_new < best_y:
            x = x_new.copy()
            best_y = y_new

        T *= alpha

    return best_x
