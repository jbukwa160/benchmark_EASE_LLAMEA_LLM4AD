def algorithm(func, dim, lb, ub, budget, rng):
    x_best = 1e10 * np.ones(dim)
    for i in range(budget):
        if rng.rand() < 0.5:
            step_size = (ub - lb) / (2 ** (i + 1))
            x_new = clip(x_best + rng.uniform(-step_size, step_size, size=dim), lb, ub)
        else:
            num_local_searches = min(10, i // 100)
            for _ in range(num_local_searches):
                x_candidate = x_best + rng.uniform(-1e-3, 1e-3, size=dim)
                x_candidate = clip(x_candidate, lb, ub)
                if func(x_candidate) < func(x_best):
                    x_best = x_candidate
            x_new = x_best + rng.uniform(-step_size, step_size, size=dim)
        x_new = clip(x_new, lb, ub)
        if func(x_new) < func(x_best):
            x_best = x_new
    return x_best
