def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_x = None
    best_f = float('inf')
    
    for i in range(budget):
        x = rng.uniform(-5.0, 5.0, size=dim)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
            
        step_size = np.power(ub - lb, 1 / (i + 2))
        x_new = clip(best_x + rng.uniform(-step_size, step_size, size=dim))
        
        f_new = func(x_new)
        
        if f_new < best_f:
            best_f = f_new
            best_x = x_new
            
    return best_x
