def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = clip(rng.uniform(size=dim) * (ub - lb) + lb)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        v = clip(rng.normal(size=dim, loc=x, scale=1.0))
        new_x = x + v
        if func(new_x) < best_f:
            best_x = new_x.copy()
            best_f = func(best_x)
            x = new_x

    return best_x
