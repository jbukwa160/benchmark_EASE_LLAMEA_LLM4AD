def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    best_f = float('inf')
    
    for _ in range(budget):
        # Clip candidates to [lb, ub]
        candidate = lb + (ub - lb) * rng.uniform(size=dim)
        
        f = func(candidate)
        
        if f < best_f:
            best_f = f
            best_x = candidate.copy()
            
        x += 0.1 * rng.normal(size=dim)
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
    
    return best_x
