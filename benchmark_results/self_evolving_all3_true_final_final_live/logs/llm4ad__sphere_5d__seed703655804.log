def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    x = np.zeros(dim)
    s = 1.0 / (ub - lb) * rng.uniform(0, 1)
    sigma = s

    for _ in range(budget):
        y = clip(x + sigma * rng.normal(size=dim))
        fy = func(y)

        if fy < func(x):
            x = y
        else:
            s *= np.sqrt(rng.uniform(0, 2))

    return x
