def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    def step_size(t, max_t, t_max=1000.0):
        return 1 / (max_t + t_max) * min(max_t, t ** 2 / (t_max + t))

    def sample(step_size, mean):
        sigma = np.sqrt(np.diag(np.exp(2 * np.log(step_size))))
        candidate = mean + rng.randn(dim) * sigma
        return clip(candidate)

    def update(mean, cov, candidate, func_value):
        mean += (candidate - mean) / (1.0 + 1e-6)
        cov = 3/4 * cov + (candidate - mean) ** np.newaxis @ (candidate - mean)[None] / (1.0 + 1e-6)
        return mean, cov

    t = 0
    best_candidate = rng.uniform(lb, ub, size=dim)
    best_func_value = func(best_candidate)

    for _ in range(budget):
        candidate = sample(step_size(t, max_t=5.0), best_candidate)
        func_value = func(candidate)
        if func_value < best_func_value:
            best_candidate = candidate
            best_func_value = func_value

        mean = np.array([best_candidate])
        cov = 1e-8 * np.eye(dim)

        t += 1
        mean, cov = update(mean, cov, sample(step_size(t, max_t=5.0), mean), func)

    return best_candidate
