def algorithm(func, dim, lb, ub, budget, rng):
    x_best = lb + (ub - lb) * rng.rand(dim)
    y_best = func(x_best)
    
    for _ in range(budget):
        N = 10
        D = np.zeros((N, dim))
        Y = np.zeros(N)
        
        for i in range(N):
            xi = x_best + rng.randn(dim) * (ub - lb) / 3
            yi = func(xi)
            D[i] = xi
            Y[i] = yi
        
        s2 = 1.0 / N * np.sum((Y - y_best)**2)
        sigma2 = s2 + 1e-6
        L = np.linalg.cholesky(sigma2 * np.eye(dim))
        
        for i in range(N):
            D[i] -= x_best
            D[i] = np.dot(D[i], L.T)
        
        a = Y - y_best
        beta = np.dot(a, np.linalg.solve(L, D.T)) / sigma2
        
        s = np.sqrt(sigma2) * rng.randn(dim)
        x_new = x_best + np.dot(s, L.T)
        x_new = lb + (ub - lb) * (x_new + 1) / 2
        
        y_new = func(x_new)
        
        if y_new < y_best:
            x_best = x_new
            y_best = y_new
    
    return x_best
