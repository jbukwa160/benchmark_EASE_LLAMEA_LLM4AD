def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def func_candidate(candidate):
        return func(clip(candidate))

    population_size = 100
    x0 = rng.uniform(lb, ub, size=(population_size, dim))
    best_x = x0[np.argmin([func_candidate(x) for x in x0])]

    for _ in range(budget // population_size):
        trial_population = np.concatenate([
            x0 + rng.uniform(-1, 1, size=(population_size, dim)),
            x0 - rng.uniform(-1, 1, size=(population_size, dim))
        ], axis=0)

        trial_population = clip(trial_population)
        trial_fitness = [func_candidate(x) for x in trial_population]

        next_x = np.array([
            x if f <= best_func else x + rng.uniform(-1, 1, size=dim)
            for x, f in zip(trial_population, trial_fitness)
        ])

        next_x = clip(next_x)
        next_best_x = next_x[np.argmin([func_candidate(x) for x in next_x])]

        if func_candidate(next_best_x) < best_func:
            best_x = next_best_x

        x0 = np.concatenate((x0, [next_best_x]))

    return best_x
