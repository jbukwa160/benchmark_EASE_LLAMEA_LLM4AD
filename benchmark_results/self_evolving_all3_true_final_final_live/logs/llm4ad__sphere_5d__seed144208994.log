def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    def generate_candidates(mu, sigma):
        return mu + sigma * np.random.randn(dim)

    def update_sigma(sigma, step_size, success):
        if success:
            sigma *= 1 + step_size
        else:
            sigma /= 1 + step_size
        return np.maximum(sigma, 1e-10)

    def update_mu(mu, x, elite=True):
        mu = mu + (x - mu) / (dim + 1)
        if elite:
            mu = clip(mu)
        return mu

    budget_left = budget
    dim_half = int(dim / 2)
    mu = np.zeros(dim)
    sigma = 10.0 * rng.rand()
    step_size = 1e-5 * rng.rand()

    while budget_left > 0:
        # Generate candidates
        candidates = generate_candidates(mu, sigma)

        # Evaluate candidates
        values = [func(clip(c)) for c in candidates]

        # Select elites
        elite_idx = np.argsort(values)[:dim_half]
        x_elite = [candidates[i] for i in elite_idx]

        # Update mean and sigma
        success = values[0] < func(mu)
        mu = update_mu(mu, x_elite[0], success)

        # Early stopping
        if values[0] < 1e-10:
            break

        # Adapt step size
        step_size *= 1 - (success / (dim + 1))

        # Decrease budget
        budget_left -= len(values)
        sigma = update_sigma(sigma, step_size, success)

    return mu
