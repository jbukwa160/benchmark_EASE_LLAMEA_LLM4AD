def algorithm(func, dim, lb, ub, budget, rng):
    D = np.prod([ub - lb for _ in range(dim)])
    x_best = (np.random.rand(dim) * (ub - lb)) + lb
    y_best = func(x_best)
    
    n_evals = 1
    
    while n_evals <= budget:
        x_new = np.clip(
            x_best + rng.normal(size=dim, loc=0.0, scale=1e-4),
            a_min=lb,
            a_max=ub
        )
        
        y_new = func(x_new)
        
        if y_new < y_best:
            x_best = x_new
            y_best = y_new
        
        n_evals += 1
    
    return np.clip(x_best, a_min=lb, a_max=ub)
