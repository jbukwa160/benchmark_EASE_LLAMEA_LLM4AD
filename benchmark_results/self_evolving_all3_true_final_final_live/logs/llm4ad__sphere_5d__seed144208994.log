def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(x):
        return np.clip(x + rng.randn(dim), lb, ub)

    x = np.zeros(dim)
    T = 10.0  # initial temperature
    alpha = 1e-4  # cooling rate

    for _ in range(budget):
        x_new = generate_candidate(x)
        f_new = func(x_new)
        f_curr = func(x)

        if f_new < f_curr or rng.rand() < np.exp((f_curr - f_new) / T):
            x = x_new
            T *= (1 - alpha)

    return x
