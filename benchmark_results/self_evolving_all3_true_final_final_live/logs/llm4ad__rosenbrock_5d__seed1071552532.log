def algorithm(func, dim, lb, ub, budget, rng):
    def func_with_bounds(x):
        return func(np.clip(x, lb, ub))

    x0 = np.array([1] * dim)
    sigma = 5
    c1, c2 = 1.04, 2.
    chi = 1.
    d = 1.
    m = 10
    p = 20

    for _ in range(budget):
        y = func_with_bounds(x0) + rng.normal(0, sigma, dim)
        x_new = x0 + (y - func_with_bounds(x0)) / m
        dist = np.linalg.norm(y - x_new)

        if dist < chi * d:
            x0 = x_new

        cm = sigma ** 2 * (1. + c1) + rng.normal(0, sigma, dim)
        d = max(d, np.max(np.abs(cm)))
        m = min(m, np.min(np.abs(cm)))

    return x0
