def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        sigma = 1.0
        for _ in range(dim):
            e = np.random.normal(size=(1, dim), loc=0.0, scale=sigma)
            new_x = x + e

            # Clip to bounds
            new_x = np.clip(new_x, lb, ub)

            f_new = func(new_x)

            if f_new < best_f:
                best_x = new_x.copy()
                best_f = f_new

        # Step size update
        sigma *= 1.01 + (np.random.uniform(-0.5, 0.5))

    return best_x
