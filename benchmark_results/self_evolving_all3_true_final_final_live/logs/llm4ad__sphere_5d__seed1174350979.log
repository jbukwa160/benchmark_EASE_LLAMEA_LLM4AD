def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    T = 100.0
    alpha = 0.99
    
    for _ in range(budget):
        new_x = x + (rng.rand(dim) - 0.5) * 2.0
        new_x = np.clip(new_x, lb, ub)
        
        if func(new_x) < func(x):
            x = new_x
        else:
            delta = func(new_x) - func(x)
            if rng.rand() < np.exp(-delta / T):
                x = new_x
        
        T *= alpha
    
    return x
