def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    D = 10 ** (1 / n) * (ub - lb)
    
    x = np.random.uniform(lb, ub, size=(n,))
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(budget):
        if rng.rand() < 0.5:
            # Uniform perturbation
            x = np.clip(x + D * (rng.randn(n) - 0.5), lb, ub)
        else:
            # Adaptive step size
            alpha = min(1, max(0.01, 10 ** (best_f / budget)))
            dx = alpha * rng.randn(n)
            x = np.clip(best_x + D * dx, lb, ub)
        
        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x.copy()
    
    return best_x
