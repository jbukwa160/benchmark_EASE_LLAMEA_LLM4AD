def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    pop_size = 50
    D = 0.5
    CR = 0.9
    sigma_max = 10.0
    sigma_min = 1e-6
    population = np.random.uniform(lb, ub, (pop_size, n))
    mutation_history = [100] * pop_size

    for _ in range(budget):
        fitness = func(population)
        min_fitness_idx = np.argmin(fitness)

        if rng.rand() < 0.1 and np.min(mutation_history) > 10:
            sigma = (sigma_max - sigma_min) / (np.max(mutation_history) + 1e-6) * np.random.uniform(1, np.max(mutation_history)) + sigma_min
            mutation_history[:] = [max(x, 10) for x in mutation_history]
        else:
            sigma = sigma_min

        new_population = population.copy()
        for i in range(pop_size):
            target = population[i]
            donor_idx = np.random.choice(range(pop_size), replace=False)

            if rng.rand() < CR or fitness[i] == 0:
                donor = population[donor_idx]

                mutation = sigma * (target - donor)
                new_target = target + mutation
                new_target = np.clip(new_target, lb, ub)
                new_population[i] = new_target

        population = new_population.copy()
        mutation_history[:] = [func(x) for x in population]
    return population[min_fitness_idx]
