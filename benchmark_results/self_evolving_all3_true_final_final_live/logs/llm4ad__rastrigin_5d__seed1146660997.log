def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    F = 1.5
    learning_rate = 0.01
    
    x_best = np.zeros(dim)
    f_best = func(x_best)
    
    population = np.random.uniform(lb, ub, size=(pop_size, dim))
    for t in range(budget):
        y_pop = population + F * rng.normal(size=population.shape)[:, None] * (population - population[np.random.randint(0, pop_size, size=dim), :])
        
        clipped_y_pop = np.clip(y_pop, lb, ub)
        
        f_values = func(clipped_y_pop)
        
        idx_best = np.argmin(f_values)
        y_best = clipped_y_pop[idx_best]
        
        if f_best > f_values[idx_best]:
            x_best = y_best
            f_best = f_values[idx_best]
            
        population = clipped_y_pop
        
        # Dynamic adaptation of the population size and learning rate
        if t % 100 == 0:
            pop_size += int(pop_size * 0.1)
            F -= learning_rate
    
    return x_best
