def algorithm(func, dim, lb, ub, budget, rng):
    n = len(dim)
    init_stddev = 0.5 * (ub - lb) / np.sqrt(n)
    min_val = float('inf')
    best_sol = None
    T = 1e4
    alpha = 0.95

    for _ in range(budget):
        x = rng.uniform(lb, ub, size=(n,))
        y = func(x)

        if y < min_val:
            min_val = y
            best_sol = x

        # Simulated annealing step
        delta = np.random.normal(0, init_stddev)
        new_x = x + delta
        new_y = func(new_x)

        if new_y <= y * (1 - 1 / (T + _)):
            T *= alpha
            x = new_x

        # Gradient-free optimization step
        learning_rate = 0.01 * (ub - lb) / n
        grad = np.zeros(n)
        for i in range(n):
            eps = rng.uniform(0, 1e-6)
            new_x_i = x.copy()
            new_x_i[i] += eps
            new_y = func(new_x_i)

            if new_y < y:
                grad[i] -= (new_y - y) / eps

        x += learning_rate * grad

        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)

    return best_sol
