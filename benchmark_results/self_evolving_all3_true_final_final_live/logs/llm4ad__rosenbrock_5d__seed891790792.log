def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)
    
    for i in range(budget):
        x_try = np.zeros(dim)
        for j in range(dim):
            if rng.random() < 0.2: # 20% chance to sample randomly
                x_try[j] = rng.uniform(lb, ub)
            else:
                x_try[j] = clip(x_best + rng.normal(0, 1e-5))
        
        f_try = func(x_try)
        if f_try < f_best:
            f_best = f_try
            x_best = x_try
        
        # Bayesian optimization component: update the mean and variance of the GP model
        alpha = 0.1 * rng.normal(0, 1) + 1
        cov = np.eye(dim)
        
        for j in range(dim):
            cov[j, (j-1)%dim] = cov[(j-1)%dim, j] = alpha
            if j < dim - 1:
                cov[j, j+1] = cov[j+1, j] = alpha
        
        cov += rng.normal(0, 1e-5, size=(dim, dim))
        
        # Sample from the GP model using Cholesky decomposition
        L = np.linalg.cholesky(cov)
        x_new = clip(x_best + L @ rng.normal(size=dim))
        
        f_new = func(x_new)
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
    
    return x_best
