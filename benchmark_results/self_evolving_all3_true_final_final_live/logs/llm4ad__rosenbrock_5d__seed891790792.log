def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(pop_size, dim, lb, ub):
        return np.random.uniform(lb, ub, (pop_size, dim))

    def crossover(parent1, parent2):
        child = np.zeros(dim)
        for i in range(dim):
            if rng.random() < 0.5:
                child[i] = parent1[i]
            else:
                child[i] = parent2[i]
        return child

    def mutation(child, lb, ub):
        indices = np.where(np.abs(child) > 1e-3)
        for i in indices[0]:
            child[i] += rng.uniform(-1, 1) * 1e-3
            child[i] = max(lb, min(ub, child[i]))
        return child

    pop_size = 100
    population = generate_initial_population(pop_size, dim, lb, ub)
    best_solution = population[0]

    for _ in range(budget):
        parents = np.array([crossover(population[i], population[j]) for i in range(pop_size) for j in range(i+1, pop_size)])
        parents = np.array([mutation(parents[i], lb, ub) for i in range(len(parents))])
        fitness_parents = func(parents)
        idx = np.argmax(fitness_parents)
        best_parent = parents[idx]
        
        if func(best_parent) < func(best_solution):
            best_solution = best_parent
        
        population = np.concatenate((population, [best_parent]))

    return best_solution
