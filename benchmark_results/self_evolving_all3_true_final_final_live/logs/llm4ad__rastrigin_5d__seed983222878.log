def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x, lb, ub)
        return func(x)

    def pso(budget, dim, lb, ub, rng):
        pop_size = 50
        num_particles = int(pop_size * (dim ** -0.5))
        particles = np.random.uniform(lb, ub, size=(num_particles, dim))
        velocities = np.zeros((num_particles, dim))
        best_positions = np.copy(particles)
        global_best_position = np.zeros(dim)
        
        learning_rate = 1
        for i in range(budget):
            for j in range(num_particles):
                r1, r2 = rng.uniform(0, 1), rng.uniform(0, 1)
                velocities[j] += learning_rate * (r1 - 0.5) * (best_positions[j] - particles[j]) + \
                                 learning_rate * (r2 - 0.5) * (global_best_position - particles[j])
                particles[j] += velocities[j]
                
            for j in range(num_particles):
                fitness = evaluate(particles[j])
                if fitness < evaluate(best_positions[j]):
                    best_positions[j] = particles[j].copy()
                    
            global_fitness, global_index = np.inf, None
            for j in range(num_particles):
                fitness = evaluate(best_positions[j])
                if fitness < global_fitness:
                    global_fitness = fitness
                    global_index = j
                    
            if global_fitness < evaluate(global_best_position):
                global_best_position = best_positions[global_index].copy()
                
        return global_best_position

    num_restarts = 10
    best_solution = np.zeros(dim)
    
    for i in range(num_restarts):
        solution = pso(budget // num_restarts, dim, lb, ub, rng)
        if evaluate(solution) < evaluate(best_solution):
            best_solution = solution
            
    return best_solution
