def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def objective(x):
        return func(x)

    x0 = (ub - lb) * rng.rand(dim) + lb
    best_x = x0.copy()
    best_f = objective(best_x)

    for _ in range(budget):
        # Simulated Annealing
        T = 1.0
        alpha = 0.9
        while T > 1e-6:
            # Differential Evolution
            x = clip(best_x + rng.uniform(-1, 1, dim) * (ub - lb))
            f = objective(x)
            if f < best_f:
                best_x = x.copy()
                best_f = f

            # Simulated Annealing
            if f > best_f:
                accept_prob = np.exp((best_f - f) / T)
                r = rng.rand(1)[0]
                if r < accept_prob:
                    best_x = x.copy()
                    best_f = f
            T *= alpha

    return best_x
