def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.zeros(dim)
    f_best = float('inf')
    schedule = np.linspace(1, 0.01, budget // (dim * 10))

    for t in range(budget):
        if t > 100:
            sigma = rng.uniform(0, 0.2) + 0.5
        else:
            sigma = rng.uniform(0, 0.1)
        
        x_new = clip(x_best + rng.normal(0, sigma, size=dim))
        
        f_new = func(x_new)
        
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
        
        temperature = schedule[t // (budget // 100)]
        
        if rng.uniform(0, 1) < np.exp((f_best - f_new) / temperature):
            x_best = clip(x_new + 0.5 * rng.normal(0, 0.1, size=dim) - 0.5 * rng.normal(0, sigma, size=dim))
    
    return x_best
