def algorithm(func, dim, lb, ub, budget, rng):
    X = np.zeros((budget, dim))
    Y = np.zeros(budget)
    
    for i in range(1, budget + 1):
        x = np.zeros(dim)
        
        # Sample a point from the prior distribution
        for j in range(dim):
            mu = (lb[j] + ub[j]) / 2.0
            sigma = (ub[j] - lb[j]) / 4.0
            x[j] = norm.rvs(loc=mu, scale=sigma, size=1, random_state=rng)[0]
        
        # Clip the sample to the bounds
        x = np.clip(x, lb, ub)
        
        Y[i-1] = func(x)
        
        X[i-1] = x
        
        if i >= 2:
            # Learn from the observed data using a Gaussian Process model
            K = np.zeros((i, i))
            for k in range(i):
                for l in range(i):
                    K[k, l] = norm.pdf(X[k] - X[l])
            
            alpha = np.linalg.inv(K).dot(Y[:i])
            
            # Get the next sample by maximizing the acquisition function
            mu = np.zeros(dim)
            sigma = np.ones(dim) * 1e-6
            
            for j in range(dim):
                mu[j] = (lb[j] + ub[j]) / 2.0
                sigma[j] = (ub[j] - lb[j]) / 4.0
                
                # Compute the acquisition function value at this point
                acq_val = Y[:i].dot(np.linalg.inv(K).dot(norm.pdf(X - np.array([mu[j], ] * dim, dtype=float)))[:, j])
                
                # Update the mean and variance based on the acquisition function
                mu[j] += (ub[j] - lb[j]) / 2.0 * acq_val
                
            # Sample from the updated posterior distribution
            x = np.zeros(dim)
            for j in range(dim):
                x[j] = norm.rvs(loc=mu[j], scale=sigma[j], size=1, random_state=rng)[0]
            
        best_x = X[np.argmin(Y[:i])]
        
    return best_x
