def algorithm(func, dim, lb, ub, budget, rng):
    X_best = np.zeros(dim)
    f_best = float('inf')

    for _ in range(budget):
        X_candidate = rng.normal(loc=X_best, scale=1.0, size=(dim,))
        X_candidate = np.clip(X_candidate, a_min=lb, a_max=ub)

        f_candidate = func(X_candidate)

        if f_candidate < f_best:
            f_best = f_candidate
            X_best = X_candidate

    return X_best
