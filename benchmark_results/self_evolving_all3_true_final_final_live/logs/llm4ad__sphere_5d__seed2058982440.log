def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    best_x = np.zeros(dim)
    best_fx = float('inf')

    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        fx = func(x)
        
        # Update the best candidate if a better one is found
        if fx < best_fx:
            best_x = x
            best_fx = fx

    return clip_candidate(best_x)
