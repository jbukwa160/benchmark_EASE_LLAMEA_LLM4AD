def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(low=lb, high=ub, size=(dim,))
    best_x = x.copy()
    for _ in range(budget):
        step_size = 0.1 / (1 + rng.uniform(0, 1) * (_ // 100))
        g = np.zeros(dim)
        for i in range(dim):
            x_try = x.copy()
            x_try[i] += step_size
            if all(lb <= ti <= ub for ti in x_try):
                g[i] = func(x_try) - func(x)
        if rng.uniform(0, 1) < 0.9:
            x -= step_size * g
        else:
            x = rng.uniform(low=lb, high=ub, size=(dim,))
        if func(x) < func(best_x):
            best_x = x.copy()
    return best_x
