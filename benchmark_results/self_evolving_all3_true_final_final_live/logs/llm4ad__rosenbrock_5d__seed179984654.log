def algorithm(func, dim, lb, ub, budget, rng):
    def boundedCandidate(candidate):
        return np.clip(candidate, lb, ub)

    x0 = 1 + (ub - lb) * rng.rand(dim)
    best_candidate = x0.copy()
    best_func_value = func(x0)

    n_evals = 0
    while n_evals < budget:
        new_x = boundedCandidate(best_candidate + rng.normal(size=dim, scale=5))
        new_func_value = func(new_x)

        if new_func_value < best_func_value and n_evals < 100:
            best_candidate = new_x.copy()
            best_func_value = new_func_value

        if n_evals >= 100:
            res = differential_evolution(func, [(lb, ub)] * dim, x0=best_candidate)
            best_candidate = res.x
            best_func_value = res.fun

        n_evals += 1

    return boundedCandidate(best_candidate)
