def algorithm(func, dim, lb, ub, budget, rng):
    def clip(cand, lb, ub):
        return np.clip(cand, a_min=lb, a_max=ub)

    def evaluate(sol, func, dim):
        return func(sol)

    best_sol = np.random.uniform(lb, ub, size=(dim,))
    best_val = evaluate(best_sol, func, dim)

    for _ in range(budget):
        cand = clip(np.random.uniform(lb, ub, size=(dim,)), lb, ub)
        val = evaluate(cand, func, dim)
        
        if val < best_val:
            best_sol = cand
            best_val = val

    return best_sol
