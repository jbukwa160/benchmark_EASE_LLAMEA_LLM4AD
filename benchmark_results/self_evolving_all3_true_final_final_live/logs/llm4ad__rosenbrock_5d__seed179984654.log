def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(budget):
        population = np.random.uniform(lb, ub, size=(budget, dim))
        return population

    def differential_evolution(population, func, dim, budget, rng):
        weights = [0.5, 0.3, 0.2] + (1 - sum(weights)) * rng.rand(dim)
        for i in range(budget // 10):
            offspring = np.copy(population)
            for j in range(len(offspring)):
                indices = np.random.choice(len(offspring), size=dim, replace=False)
                candidate = population[j] + weights[rng.randint(0, dim)] * (population[indices[0]] - population[indices[1]])
                offspring[j] = clip(candidate)
            population = np.minimum(population, offspring)
        return population

    def iterated_local_search(population, func, dim, budget, rng):
        for i in range(budget // 10):
            idx = rng.randint(0, len(population))
            candidate = clip(population[idx] + rng.uniform(-1, 1, size=dim))
            population[idx] = np.minimum(candidate, func(candidate))

    population = generate_initial_population(budget)
    population = differential_evolution(population, func, dim, budget // 10, rng)
    iterated_local_search(population, func, dim, budget - (budget // 10) * 2, rng)

    best_candidate = np.zeros(dim)
    for i in range(len(population)):
        if func(population[i]) < func(best_candidate):
            best_candidate = population[i]

    return best_candidate
