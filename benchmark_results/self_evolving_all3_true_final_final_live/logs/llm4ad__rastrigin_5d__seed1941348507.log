def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    sigma = 0.1
    T = 1000.0
    cooling_rate = 0.99
    
    x = np.random.uniform(lb, ub, (pop_size, dim))
    
    for i in range(budget):
        f = func(x)
        
        idx_best = np.argmin(f)
        best_x = x[idx_best]
        best_f = f[idx_best]
        
        if best_f < 0:
            return best_x
        
        for j in range(pop_size):
            v = rng.normal(0, sigma, dim)
            trial_x = best_x + v
            
            # Clip to bounds
            trial_x = np.clip(trial_x, lb, ub)
            
            f_trial = func(trial_x)
            
            if f_trial < best_f:
                x[j] = trial_x
                f[j] = f_trial
                
        T *= cooling_rate
        
        for j in range(pop_size):
            if rng.random() < np.exp((best_f - f[j]) / T):
                x[j] = best_x + rng.normal(0, sigma, dim)
                
                # Clip to bounds
                x[j] = np.clip(x[j], lb, ub)
                
                f[j] = func(x[j])
    
    idx_best = np.argmin(f)
    return x[idx_best]
