    n = len(dim)
    x_best = np.zeros(n)
    f_best = float('inf')
    
    T = 1000.0
    a = 1.0 / (budget * n)
    alpha = 0.95
    
    for i in range(budget):
        x_new = rng.uniform(lb, ub, size=n) + np.random.normal(size=n)
        
        while not all(lb <= x_new[i] <= ub for i in range(n)):
            x_new = rng.uniform(lb, ub, size=n) + np.random.normal(size=n)
        
        f_new = func(x_new)
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
            
        delta_f = f_new - f_best
        
        if delta_f <= 0 or rng.uniform() <= np.exp(-delta_f / T):
            x_best = (x_best + x_new) / 2.0
            f_best = func(x_best)
        
        T *= alpha
    
    return x_best
