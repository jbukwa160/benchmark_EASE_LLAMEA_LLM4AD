def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    D = 0.5 * (ub - lb)
    sigma = (ub - lb) / 3
    lambda_ = int(np.ceil(1 + np.log(dim)))
    mu = lambda_
    cmu = np.zeros((dim, dim))
    pc = 1 + 2 * rng.rand()
    c1 = 1 + 2 * rng.rand()
    cmu = (1 - c1) * D / (dim ** 0.5)
    z = np.zeros(dim)

    for i in range(budget):
        y = cmu @ z
        x = lb + ub - lb + pc * sigma * y

        f_x = f(x)
        if f_x < f_best:
            f_best = f_x
            x_best = x

        u = np.random.randn(lambda_)
        v = np.random.randn(lambda_)

        for j in range(lambda_):
            w = x + c1 * sigma * (v[j] - mu / 2)
            if lb <= w <= ub:
                y = cmu @ z
                f_w = f(w)
                if f_w < f_best:
                    f_best = f_w
                    x_best = w

        v += u
        for j in range(lambda_):
            w = x + c1 * sigma * (v[j] - mu / 2)
            if lb <= w <= ub:
                y = cmu @ z
                f_w = f(w)
                if f_w < f_best:
                    f_best = f_w
                    x_best = w

        v += u
        for j in range(lambda_):
            w = x + c1 * sigma * (v[j] - mu / 2)
            if lb <= w <= ub:
                y = cmu @ z
                f_w = f(w)
                if f_w < f_best:
                    f_best = f_w
                    x_best = w

        cmu += np.outer((pc - 1) * sigma ** 2 * v, v)

    return x_best
