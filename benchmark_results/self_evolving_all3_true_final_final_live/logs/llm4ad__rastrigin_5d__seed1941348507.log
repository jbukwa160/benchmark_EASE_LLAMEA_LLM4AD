def algorithm(func, dim, lb, ub, budget, rng):
    D = len(dim)
    pop_size = 50
    sigma = 0.5
    T = 1000.0
    alpha = 0.95
    best_x = None
    best_fval = np.inf

    for t in range(budget):
        # Initialize population
        x = rng.uniform(lb, ub, (pop_size, D))

        # DE
        while True:
            v = x + sigma * rng.normal(0, 1, (pop_size, D))
            v = np.clip(v, lb, ub)
            fval = func(v)

            if fval < best_fval:
                best_x = v[np.argmin(fval)]
                best_fval = fval
                break

            # SA
            T *= alpha
            if rng.uniform(0, 1) < np.exp((best_fval - fval) / T):
                x[np.argmin(fval)] = v[np.argmin(fval)]

        # Update best solution
        best_x = np.clip(best_x, lb, ub)
        if func(best_x) < best_fval:
            best_fval = func(best_x)

    return best_x
