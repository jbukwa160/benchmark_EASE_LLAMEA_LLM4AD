def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    def generate_initial_population(dim, bounds):
        x = np.zeros((1, dim))
        for i in range(dim):
            x[0, i] = (ub - lb) * rng.rand() + lb
        return x

    def generate_neighbor(x, step_size):
        noise = np.zeros_like(x)
        for i in range(len(x)):
            if rng.rand() < 0.5:
                noise[i] = rng.uniform(-1, 1)
            else:
                noise[i] = rng.normal(0, 1)
        return clip(x + step_size * noise)

    def cma_es_update(population, fitnesses, dim, bounds):
        sigma = np.std(population)
        for _ in range(dim):
            mean = population.mean(axis=0)
            cov = (population - mean[:, np.newaxis]) ** 2
            cov /= len(population) - 1
            step_size = 1 / np.sqrt(np.diag(cov))
            noise = rng.normal(0, sigma * np.sqrt(len(population)))
            x_new = clip(mean + step_size * noise)
            population = np.vstack((population, x_new))
        return population

    def simulated_annealing(update_func, initial_population, bounds, budget):
        current_best = initial_population
        temperature = 1.0
        for _ in range(budget):
            candidate = update_func(current_best, rng.uniform(0, 1), temperature)
            if func(candidate) < func(current_best):
                current_best = candidate
            temperature *= 0.99
        return current_best

    initial_population = generate_initial_population(dim, (lb, ub))
    population = cma_es_update(initial_population, np.zeros(len(initial_population)), dim, (lb, ub))

    for _ in range(budget // len(population)):
        candidates = []
        for x in population:
            candidates.append(generate_neighbor(x, 0.1))
        new_population = cma_es_update(np.vstack((population, candidates)), np.zeros(len(population) + len(candidates)), dim, (lb, ub))
        population = new_population

    return simulated_annealing(cma_es_update, population, (lb, ub), budget)
