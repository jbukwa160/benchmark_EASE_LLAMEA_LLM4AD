def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    F = 0.5
    CR = 0.9
    
    def mutate(x, y):
        z = x + F * (y - x)
        return z
        
    def crossover(u, v):
        if rng.random() < CR:
            for i in range(dim):
                if rng.random() < 0.5:
                    u[i] = v[i]
        return u
    
    best = None
    best_val = np.inf
    
    for _ in range(budget):
        pop = np.clip(np.random.uniform(lb, ub, (pop_size, dim)), lb, ub)
        
        for x in pop:
            if func(x) < best_val:
                best_val = func(x)
                best = x
                
        for i in range(pop_size):
            y = mutate(pop[i], pop[(i-1)%pop_size])
            u = crossover(y.copy(), pop[(i+1)%pop_size])
            
            if rng.random() < 0.5:
                u = np.abs(u)
                
            val = func(u)
            if val < best_val:
                best_val = val
                best = u
                
    return best
