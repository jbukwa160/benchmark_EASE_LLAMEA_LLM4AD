def algorithm(func, dim, lb, ub, budget, rng):
    n_iter = int(budget)
    
    # Initialize GP model with random observations
    x = lb + (ub - lb) * rng.uniform(size=(1, dim))
    y = func(x[0])
    gp_model = GaussianProcessRegressor(theta0=1e-2, theta_L=1e-3, theta_U=1e+3)
    
    for i in range(1, n_iter):
        # Predict mean and variance of the GP model at random points
        x_new = lb + (ub - lb) * rng.uniform(size=(100, dim))
        y_pred_mean, y_pred_var = gp_model.predict(x_new)
        
        # Compute expected improvement for each point
        ei = np.zeros_like(y_pred_mean)
        for j in range(len(ei)):
            mean = y_pred_mean[j]
            var = y_pred_var[j]
            std_dev = np.sqrt(var)
            z = (y - mean) / std_dev if std_dev != 0 else 1e10
            ei[j] = (mean - y + std_dev * norm.pdf(z)) * np.exp(-z**2 / 2) if std_dev != 0 else 1e10
        
        # Select the point with maximum expected improvement
        x_new_max_ei = x_new[np.argmax(ei)]
        
        # Update GP model and observe new point
        y_new = func(x_new_max_ei)
        gp_model.fit(np.vstack((x, x_new_max_ei)), np.append(y, y_new))
        x = np.vstack((x, x_new_max_ei))
        y = np.append(y, y_new)
        
    # Return the best point found
    return x[np.argmin(y)]
