def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    best_f = float('inf')
    sigma = 0.5 * (ub - lb) / 2
    
    for i in range(budget):
        x = np.random.uniform(lb, ub, size=dim)
        
        # SA part
        t = max(0.1, budget - i) / (budget * 10)
        delta = func(x) - func(best)
        if rng.rand() < np.exp(-delta / (t * sigma**2)):
            best = x
            best_f = func(best)
        
        # CMA-ES part
        mu = np.random.normal(size=dim, loc=np.zeros(dim), scale=sigma)
        m = 0.75 + 2.38 / np.sqrt(np.sum(mu**2) + 1e-6)
        zeta = norm.ppf(rng.rand())
        x_trial = best + m * mu + sigma * zeta
        
        # Clip to bounds
        x_trial = np.clip(x_trial, lb, ub)
        
        if func(x_trial) < best_f:
            best = x_trial
            best_f = func(best)
    
    return best
