def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best = np.zeros(dim)
    best_value = float('inf')
    step_size = 5.0

    for i in range(budget):
        x = clip(rng.uniform(lb, ub, size=dim))
        value = func(x)
        
        if value < best_value:
            best_value = value
            best = x
        
        success_rate = (i + 1 - np.sum([func(clip(best + rng.normal(0, step_size, size=dim))) < best_value for _ in range(10)])) / 11.0
            
        if success_rate > 0.7:
            step_size *= 2
        else:
            step_size /= 2

    return best
