def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    N = int(np.ceil(budget / (D + 2)))
    
    x_best = rng.uniform(lb, ub, size=D)
    f_best = func(x_best)
    
    for _ in range(N):
        u = rng.choice(D, size=4, replace=False)  # Select four indices
        v = np.array([rng.uniform(0, 1) for i in range(D)])
        
        x_new = (ub - lb) * v + lb
        
        for j in range(D):
            if v[j] < 0.5:
                x_new[j] = x_best[j]
            elif u[j] == j:
                x_new[j] += rng.uniform(-1, 1)
        
        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        
        if f_new < f_best:
            f_best = f_new
            x_best = x_new.copy()
    
    return x_best
