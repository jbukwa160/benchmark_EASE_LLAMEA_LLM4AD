def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    n_parents = int(pop_size * 0.2)
    sigma_init = 1.0
    t = 0
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    while True:
        if t >= budget:
            break
        
        # Initialize population
        pop = rng.uniform(lb, ub, size=(pop_size, dim))
        
        for i in range(pop_size):
            x_i = pop[i]
            f_i = func(x_i)
            
            if f_i < f_best:
                f_best = f_i
                x_best = x_i
        
        # Update population using DE and CMA-ES
        pop[:, 0] += rng.normal(0, sigma_init, size=(pop_size,))
        
        for i in range(pop_size):
            x_i = pop[i]
            f_i = func(x_i)
            
            if f_i < f_best:
                f_best = f_i
                x_best = x_i
        
        # Update covariance matrix using CMA-ES
        mu = np.mean(pop, axis=0)
        sigma = 1.0 / (t + 1)
        cov = np.cov(pop.T)
        
        if t % 10 == 0:
            # Adapt population size using DE
            n_parents = int(pop_size * rng.uniform(0.1, 0.3))
            
            for i in range(n_parents):
                x_i = pop[i]
                f_i = func(x_i)
                
                if f_i < f_best:
                    f_best = f_i
                    x_best = x_i
        
        t += 1
    
    return x_best
