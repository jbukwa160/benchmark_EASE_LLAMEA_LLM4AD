def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def sample():
        x = rng.normal(size=dim)
        x = clip(x)
        return x

    def mutation_step(sigma):
        x = sample()
        y = x + rng.normal(size=dim) * sigma
        y = clip(y)
        return func(y), y

    sigma0 = 1.5
    lambda_ = 10
    budget_per_dim = int(budget / dim)

    population_size = lambda_
    population = [sample() for _ in range(population_size)]

    mean_x = np.mean([individuals[i] for i, individual in enumerate(population)], axis=0)
    sigma = sigma0

    best_individual = None
    best_value = float('inf')

    for _ in range(budget):
        values, new_population = zip(*[mutation_step(sigma) for _ in range(lambda_)])

        mean_x_new = np.mean([individuals[i] for i, individual in enumerate(new_population)], axis=0)
        sigma_new = (1 + 2 / (len(values) * dim)) * sigma

        population = list(new_population)

        if values[0] < best_value:
            best_value = values[0]
            best_individual = new_population[0]

        mean_x = (1 - 1 / (len(values) * dim)) * mean_x + (1 / (len(values) * dim)) * mean_x_new
        sigma = (1 - 1 / (len(values) * dim)) * sigma + (1 / (len(values) * dim)) * sigma_new

    return best_individual
