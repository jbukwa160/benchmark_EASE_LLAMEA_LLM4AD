def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    x_best = -np.ones(dim)
    f_best = 1e10
    pop_size = int(np.sqrt(budget))
    iter_count = 0
    T = 100.0

    while iter_count < budget and np.any(x_best == -1):
        population = np.random.uniform(lb, ub, (pop_size, dim))
        for i in range(pop_size):
            if np.all(population[i] != -1) and f(population[i]) < f_best:
                x_best = population[i]
                f_best = f(population[i])

        iter_count += 1
        T *= 0.99

        for _ in range(int(pop_size/2)):
            i, j = rng.choice(pop_size, size=2, replace=False)
            if np.all(population[j] != -1) and np.random.rand() < 0.5:
                u = np.random.uniform(-10, 10, dim)
                population[j] += u * (population[i] - population[rng.choice(pop_size)])
                population[j] = np.clip(population[j], lb, ub)

        for i in range(pop_size):
            if np.all(population[i] != -1) and f(population[i]) < f_best:
                x_best = population[i]
                f_best = f(population[i])

            if np.random.rand() < 0.01 and rng.uniform(0, 1) < np.exp((f_best - f(population[i]))/T):
                population[i] = np.clip(population[i], lb, ub)

    return x_best
