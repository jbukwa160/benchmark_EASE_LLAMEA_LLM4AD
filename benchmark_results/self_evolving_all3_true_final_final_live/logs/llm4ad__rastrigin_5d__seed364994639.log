def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.zeros(dim)
    f_best = float('inf')

    for _ in range(budget):
        x = clip(rng.uniform(lb, ub, size=dim))
        
        if func(x) < f_best:
            f_best = func(x)
            x_best = x

        # Perform local search
        for i in range(dim):
            x_try = clip(x.copy())
            x_try[i] += rng.uniform(-1e-6, 1e-6)

            if func(x_try) < f_best:
                f_best = func(x_try)
                x_best = x_try

    return x_best
