def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(x):
        return np.clip(x, lb, ub)

    def sample_random_point():
        return rng.uniform(lb, ub, size=dim)

    def evaluate(candidate):
        candidate = clip_candidate(candidate)
        return func(candidate)

    def differential_evolution(population_size, mutation_rate, crossover_probability):
        for _ in range(budget // population_size):
            new_population = []
            for _ in range(population_size):
                parent1, parent2, parent3 = rng.choice(population, replace=False, size=3)
                difference = parent2 - parent1
                mutation = mutation_rate * difference + parent1
                crossover = clip_candidate(parent2 + crossover_probability * (mutation - parent2))
                new_population.append(crossover)
            population = new_population

    def polynomial_mutation(population_size):
        for _ in range(budget // population_size):
            new_population = []
            for candidate in population:
                child = np.copy(candidate)
                for i in range(dim):
                    if rng.random() < 0.1:  # 10% chance of mutation
                        child[i] += rng.uniform(-5, 5) * (ub - lb)
                new_population.append(clip_candidate(child))
            population = new_population

    population = [sample_random_point() for _ in range(budget)]
    best_so_far = np.inf
    best_solution = None
    for _ in range(10):  # 10 runs of DE and PM with different seeds
        rng.seed(np.random.randint(0, 2**32))  # Randomly seed the generator
        differential_evolution(population_size=budget // 10, mutation_rate=0.5, crossover_probability=0.7)
        polynomial_mutation(population_size=budget // 10)
        for candidate in population:
            value = evaluate(candidate)
            if value < best_so_far:
                best_so_far = value
                best_solution = candidate

    return best_solution
