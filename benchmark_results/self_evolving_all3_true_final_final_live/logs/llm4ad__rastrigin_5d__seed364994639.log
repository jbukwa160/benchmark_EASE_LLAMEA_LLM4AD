def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(dim, lb, ub):
        population = np.zeros((budget, dim))
        for i in range(budget):
            for j in range(dim):
                population[i, j] = lb + (ub - lb) * rng.random()
        return population

    def calculate_fitness(population, func):
        fitness = np.array([func(individual) for individual in population])
        return fitness

    def mutation_strategy(population, dim, lb, ub, rng):
        mutated_population = population.copy()
        for i in range(budget):
            idx1 = rng.randint(0, budget)
            idx2 = rng.randint(0, budget)
            idx3 = rng.randint(0, budget)
            while idx1 == idx2 or idx1 == idx3 or idx2 == idx3:
                idx1 = rng.randint(0, budget)
                idx2 = rng.randint(0, budget)
                idx3 = rng.randint(0, budget)
            mutant = mutated_population[idx1] + 0.5 * (mutated_population[idx2] - mutated_population[idx3])
            mutated_population[i] = clip(mutant)
        return mutated_population

    def selection(population, fitness):
        sorted_indices = np.argsort(fitness)
        selected_individuals = population[sorted_indices[:budget]]
        selected_fitnesses = fitness[sorted_indices[:budget]]
        return selected_individuals, selected_fitnesses

    population = generate_initial_population(dim, lb, ub)
    fitness = calculate_fitness(population, func)

    for _ in range(budget - 1):
        mutated_population = mutation_strategy(population, dim, lb, ub, rng)
        fitness_mutated = calculate_fitness(mutated_population, func)
        selected_individuals, selected_fitnesses = selection(population, fitness)
        selected_indices = np.argsort(selected_fitnesses)[:budget // 2]
        population[selected_indices] = mutated_population[selected_indices]
        fitness[selected_indices] = fitness_mutated[selected_indices]

    best_individual_index = np.argmin(fitness)
    return clip(population[best_individual_index])
