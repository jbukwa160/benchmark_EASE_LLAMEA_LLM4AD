def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 10 * dim
    D = dim
    n_gen = int(budget / (pop_size * D))
    
    x_best = np.random.uniform(lb, ub, (1, D)) if rng is None else rng.randint(0, 100, size=D)
    f_best = func(x_best)

    for _ in range(n_gen):
        pop = np.random.uniform(lb, ub, (pop_size, D))
        diff = pop - x_best
        for i in range(pop_size):
            mutation = 1 + 0.5 * rng.randint(0, 100) / 100
            if rng is not None:
                mu_idx = rng.choice(range(D), size=D, replace=False)
                diff[i, mu_idx] *= mutation

        pop += x_best
        f_pop = func(pop)

        for i in range(pop_size):
            if f_pop[i] < f_best:
                x_best = pop[i]
                f_best = f_pop[i]

    return x_best
