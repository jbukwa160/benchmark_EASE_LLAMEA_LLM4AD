def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    initial_solution = np.random.uniform(lb, ub, size=dim)
    best_solution = initial_solution.copy()
    best_cost = func(initial_solution)

    for _ in range(budget):
        new_solution = initial_solution + rng.randn(dim) * 0.1
        new_solution = clip_candidate(new_solution)

        alpha = np.exp(-np.sum(rng.uniform(0, 1, size=dim)))
        if func(new_solution) < best_cost or rng.rand() < alpha:
            initial_solution = new_solution.copy()
            best_solution = new_solution.copy()
            best_cost = func(best_solution)

    return best_solution
