def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x0 = np.zeros(dim)
    sigma = 1.0
    pop_size = 16
    mu = x0
    cov = np.eye(dim) * sigma ** 2
    evals = 0

    while budget > 0:
        for _ in range(pop_size):
            y = np.random.multivariate_normal(mu, cov)
            y = clip(y)
            f_y = func(y)

            if f_y < func(mu):
                mu = y
                sigma *= 1.1
            else:
                sigma /= 1.1

        cov = (1 - 2 / (evals + 1)) * cov + np.outer((mu - x0), (mu - x0))
        evals += pop_size

        budget -= pop_size

    return mu
