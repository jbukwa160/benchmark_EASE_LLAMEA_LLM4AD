def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        i = np.random.randint(0, dim)
        sigma = 5.0 / (1 + np.exp(-_ * 0.01))
        new_x = x.copy()
        new_x[i] += rng.normal(loc=0, scale=sigma)

        # Clip candidates to [lb, ub]
        new_x = np.clip(new_x, lb, ub)

        f_new = func(new_x)
        delta = f_new - best_f

        if delta < 0 or (np.random.rand() < np.exp(-delta / sigma)):
            x = new_x
            if f_new < best_f:
                best_x = new_x.copy()
                best_f = f_new

    return best_x
