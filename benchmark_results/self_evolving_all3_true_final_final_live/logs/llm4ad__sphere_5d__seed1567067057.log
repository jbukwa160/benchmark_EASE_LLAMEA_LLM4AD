def algorithm(func, dim, lb, ub, budget, rng):
    best_x = rng.uniform(lb, ub, size=dim)
    best_y = func(best_x)
    for i in range(budget):
        step_size = 1 / (i + 1) ** 0.5
        candidate = best_x + step_size * rng.normal(size=dim)
        clipped_candidate = np.clip(candidate, lb, ub)
        y = func(clipped_candidate)
        if y < best_y:
            best_x = clipped_candidate
            best_y = y
    return best_x
