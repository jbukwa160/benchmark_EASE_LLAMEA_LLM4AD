def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    gen_size = int(budget / pop_size)
    
    def evaluate(x):
        return func(x), x
    
    best_x = None
    best_f = float('inf')
    
    for _ in range(gen_size):
        population = np.random.uniform(lb, ub, (pop_size, dim))
        
        for i in range(pop_size):
            if rng.random() < 0.1:  # mutation rate
                idx = rng.choice(dim)
                population[i, idx] += rng.uniform(-1, 1)
                population[i, idx] = max(lb, min(ub, population[i, idx]))
        
        scores = np.array([evaluate(x)[0] for x in population])
        best_idx = np.argmin(scores)
        best_x = evaluate(population[best_idx])[1]
        
        if scores[best_idx] < best_f:
            best_f = scores[best_idx]
    
    return best_x
