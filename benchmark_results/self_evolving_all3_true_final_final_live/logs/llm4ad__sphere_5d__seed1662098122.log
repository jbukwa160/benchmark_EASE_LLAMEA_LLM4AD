def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 1e3
    alpha = 0.99
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = x + 0.01 * rng.normal(size=dim)
        y = np.clip(y, lb, ub)
        
        f = func(y)
        
        if f < best_f:
            best_f = f
            best_x = y.copy()
            
        delta = f - best_f
        
        if delta <= 0 or np.random.rand() * T / (T + _ + 1) < np.exp(-delta / T):
            x = y
            
        else:
            if rng.rand() < 0.5:
                pass
            else:
                x = np.clip(x + 0.01 * rng.normal(size=dim), lb, ub)
        
        T *= alpha

    return best_x
