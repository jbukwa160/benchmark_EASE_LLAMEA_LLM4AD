def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    x = np.zeros(dim)
    temperature = 1.0
    best_x = x.copy()
    best_val = func(x)
    
    for _ in range(budget):
        for i in range(dim):
            sigma = rng.uniform(0, 1) * (ub - lb)**2 / budget
            noise = np.random.normal(loc=0, scale=sigma, size=(dim,))
            new_x = clip(best_x + temperature * noise)
            
            if func(new_x) < best_val:
                best_x = new_x.copy()
                best_val = func(new_x)
        
        temperature *= 1 - rng.uniform(0, 1)**2
        
    return best_x
