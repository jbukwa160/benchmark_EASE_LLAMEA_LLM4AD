def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    # Initialize a population of random candidates within the bounds
    population_size = 50
    population = np.random.uniform(lb, ub, (population_size, dim))

    for _ in range(budget):
        # Evaluate each candidate and store its fitness value
        fitness_values = [func(candidate) for candidate in population]
        
        # Select the best candidates using tournament selection
        selected_candidates = []
        for i in range(population_size):
            j = rng.randint(0, population_size - 1)
            if fitness_values[i] < fitness_values[j]:
                selected_candidates.append(population[i])
            else:
                selected_candidates.append(population[j])

        # Use Nelder-Mead simplex method to locally optimize the best candidate
        best_candidate = np.array(selected_candidates[0])
        x0 = best_candidate
        simplex_size = 20
        simplex = np.zeros((simplex_size, dim))
        for i in range(simplex_size):
            simplex[i] = clip_candidate(best_candidate + rng.uniform(-1.0, 1.0, dim))

        # Update the simplex using Nelder-Mead rules
        def centroid(x):
            return np.mean(x, axis=0)

        def reflect(x, x0):
            return 2 * x0 - x

        def expand(x, x0):
            return 4 * x0 - x

        def contract(x, x0, r):
            return x0 + r * (x0 - x)

        for i in range(simplex_size):
            if i == 0:
                # Center
                centroid_simplex = centroid(simplex)
                simplex[i] = clip_candidate(centroid_simplex)
            elif i == 1 or i == 2:
                # Reflect and expand
                centroid_simplex = centroid(simplex[:i])
                new_x = reflect(simplex[i], centroid_simplex)
                fitness_new_x = func(new_x)
                if fitness_new_x < func(centroid_simplex):
                    simplex[i] = clip_candidate(new_x)
                else:
                    expanded_x = expand(simplex[i], centroid_simplex)
                    fitness_expanded_x = func(expanded_x)
                    if fitness_expanded_x < func(new_x) and fitness_expanded_x < func(centroid_simplex):
                        simplex[i] = clip_candidate(expanded_x)
                    else:
                        new_x = contract(simplex[i], centroid_simplex, 0.5)
                        simplex[i] = clip_candidate(new_x)
            elif i == 3:
                # Reflection
                centroid_simplex = centroid(simplex[:i])
                new_x = reflect(simplex[i], centroid_simplex)
                fitness_new_x = func(new_x)
                if fitness_new_x < func(centroid_simplex):
                    simplex[i] = clip_candidate(new_x)
            elif i == 4:
                # Expansion
                centroid_simplex = centroid(simplex[:i])
                new_x = expand(simplex[i], centroid_simplex)
                fitness_new_x = func(new_x)
                if fitness_new_x < func(centroid_simplex):
                    simplex[i] = clip_candidate(new_x)
            else:
                # Contraction
                centroid_simplex = centroid(simplex[:i])
                new_x = contract(simplex[i], centroid_simplex, 0.5)
                simplex[i] = clip_candidate(new_x)

        best_candidate = np.min(simplex[:, 0])

        population = simplex

    return np.array([best_candidate])
