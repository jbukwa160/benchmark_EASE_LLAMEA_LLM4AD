def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 1.0
    alpha = 0.99
    num_iterations = 0
    best_x = x.copy()
    best_value = func(x)

    while True:
        for i in range(dim):
            x_copy = x.copy()
            x[i] += np.random.uniform(-0.5, 0.5)
            if lb <= x[i] <= ub:
                value = func(x)
                delta = value - best_value
                if delta < 0 or rng.rand() < np.exp(-delta / T):
                    best_x = x_copy.copy()
                    best_value = value
            else:
                x[i] = np.clip(x[i], lb, ub)

        num_iterations += dim

        if num_iterations >= budget:
            break

        for i in range(dim):
            x[i] = np.clip(x[i], lb, ub)
            x_copy = x.copy()
            x[i] -= 0.1 * (x[i] - best_x[i])
            value = func(x)

            delta = value - best_value
            if delta < 0 or rng.rand() < np.exp(-delta / T):
                best_x = x_copy.copy()
                best_value = value

        num_iterations += dim
        T *= alpha

    return best_x
