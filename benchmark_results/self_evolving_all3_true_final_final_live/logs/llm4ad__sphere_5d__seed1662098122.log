def algorithm(func, dim, lb, ub, budget, rng):
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    for i in range(budget):
        # Generate a new candidate by adding a random perturbation to the best known solution
        x_new = x_best + 0.1 * (ub - lb) * rng.randn(dim)
        
        # Clip the new candidate to the bounds
        x_new = np.clip(x_new, lb, ub)

        # Evaluate the function at the new candidate
        f_new = func(x_new)

        # If the new candidate is better than the current best, update the best solution
        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
