def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for _ in range(budget):
        x_new = best_x + 0.5 * (np.random.uniform(-1, 1, size=dim) - np.random.uniform(0, 1, size=dim)) / rng
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        
        if f_new < best_f:
            best_x = x_new
            best_f = f_new

        # Simulated Annealing part
        delta = f_new - best_f
        if delta < 0 or np.random.rand() < np.exp(-delta):
            best_x = x_new
            best_f = f_new
    
    return best_x
