def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_init_population(pop_size, dim):
        population = rng.uniform(lb, ub, (pop_size, dim))
        velocities = rng.uniform(-1.0, 1.0, (pop_size, dim))
        return population, velocities

    def fitness(x):
        return func(x)

    pop_size = int(np.sqrt(budget))
    population, velocities = generate_init_population(pop_size, dim)
    personal_best = population.copy()
    global_best = np.inf
    gbest = None

    for _ in range(budget):
        for i in range(pop_size):
            r1, r2, r3 = rng.uniform(0.0, 1.0), rng.uniform(0.0, 1.0), rng.uniform(0.0, 1.0)
            velocities[i] = 0.8 * velocities[i] + 1.2 * (rng.uniform(-1.0, 1.0) ** r1) + \
                            1.4 * (personal_best[i] - population[i]) * rng.uniform(0.0, 1.0) ** r2 + \
                            0.5 * (global_best - population[i]) * rng.uniform(0.0, 1.0) ** r3

            new_position = clip(population[i] + velocities[i])
            if fitness(new_position) < fitness(personal_best[i]):
                personal_best[i] = new_position
            if fitness(new_position) < global_best:
                global_best = fitness(new_position)
                gbest = new_position

        for i in range(pop_size):
            r1, r2, r3 = rng.uniform(0.0, 1.0), rng.uniform(0.0, 1.0), rng.uniform(0.0, 1.0)
            p1, p2, p3 = np.random.choice(pop_size, replace=False, size=3)
            new_position = clip(population[i] + \
                                (personal_best[p1] - population[i]) * rng.uniform(-1.0, 1.0) ** r1 + \
                                (personal_best[p2] - population[i]) * rng.uniform(-1.0, 1.0) ** r2 + \
                                (gbest - population[i]) * rng.uniform(-1.0, 1.0) ** r3)
            if fitness(new_position) < fitness(personal_best[i]):
                personal_best[i] = new_position

    return gbest
