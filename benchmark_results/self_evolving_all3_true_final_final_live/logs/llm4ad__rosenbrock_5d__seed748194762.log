def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    y_best = func(x_best)

    for _ in range(budget):
        # Differential Evolution
        mutation = 0.5 * (np.random.uniform(lb, ub, size=dim) - np.random.uniform(lb, ub, size=dim))
        crossover = np.random.uniform(0, 1, size=dim)
        x_trial = clip(x_best + mutation * crossover)

        # Simplex Search
        simplex_size = int(np.ceil(dim / 2)) if dim > 3 else 3
        v = np.zeros((simplex_size, dim))
        for i in range(simplex_size):
            v[i] = clip(x_trial + (i % 2) * rng.uniform(-1, 1, size=dim))

        # Update x_best and y_best
        x_best_new = np.mean(v[:simplex_size // 2], axis=0)
        y_best_new = func(clip(x_best_new))
        if y_best_new < y_best:
            x_best = x_best_new
            y_best = y_best_new

    return clip(x_best)
