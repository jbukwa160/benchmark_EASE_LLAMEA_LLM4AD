def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def mutate(x1, x2, x3):
        y = x2 + 0.5 * (x1 - x3)
        return clip(y)

    def crossover(x1, x2):
        if rng.random() < 0.7:
            return x2
        else:
            return x1

    population_size = int(1e4)
    population = np.random.uniform(lb, ub, (population_size, dim))
    best_solution = population[0]
    best_fitness = func(best_solution)

    for _ in range(budget):
        fitness_values = [func(x) for x in population]
        sorted_indices = np.argsort(fitness_values)
        population = population[sorted_indices]

        new_population = []
        for i in range(population_size // 2):
            x1, x2, x3 = population[i], population[i + 1], population[population_size - 1 - i]
            y = mutate(x1, crossover(x2, x3), x3)
            new_population.append(y)

        new_fitness_values = [func(x) for x in new_population]

        sorted_indices = np.argsort(new_fitness_values)
        new_population = new_population[sorted_indices]
        population = np.concatenate((population, new_population))

        best_solution = population[0]
        best_fitness = func(best_solution)

    return best_solution
