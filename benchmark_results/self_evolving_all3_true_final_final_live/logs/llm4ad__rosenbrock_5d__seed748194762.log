def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    learning_rate = 1.0 / (2 * (ub - lb))
    for _ in range(budget):
        gradient = func(np.clip(x + 0.0001, lb, ub), grad=True) - func(x, grad=True)
        step_size = np.mean(learning_rate * gradient) * rng.uniform(0.5, 1.5)
        x -= clip(step_size * gradient / np.abs(gradient), lb, ub)

    return clip(x, lb, ub)
