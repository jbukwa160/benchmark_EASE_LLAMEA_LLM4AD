def algorithm(func, dim, lb, ub, budget, rng):
    num_evals = 0
    x_best = np.random.uniform(lb, ub, size=dim)
    
    while num_evals < budget:
        model = GaussianProcessRegressor()
        X_train = [x_best]
        y_train = [func(x_best)]
        
        model.fit(X_train, y_train)
        
        x_next = None
        best_gp_mean = -np.inf
        
        for x in np.random.uniform(lb, ub, size=(1000, dim)):
            gp_mean, _ = model.predict(np.array([x]), return_std=True)
            if gp_mean > best_gp_mean:
                best_gp_mean = gp_mean
                x_next = x
                
        x_next = clip(x_next, lb, ub)
        
        y_next = func(x_next)
        
        X_train.append(x_next)
        y_train.append(y_next)
        
        model.fit(X_train, y_train)
        
        if y_next < y_train[0]:
            x_best = x_next
            num_evals += 1
    
    return x_best
