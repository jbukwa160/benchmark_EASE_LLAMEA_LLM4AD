def algorithm(func, dim, lb, ub, budget, rng):
    x0 = (ub + lb) / 2 * np.ones(dim)
    cov = np.eye(dim)
    
    def surrogate(x):
        return func(x)
    
    for i in range(budget):
        # CMA-ES step
        mean = x0
        cov *= 1 - 1/(i+10)
        z = rng.normal(size=dim)
        proposal = mean + np.sqrt(cov).dot(z)
        if surrogate(proposal) < surrogate(x0):
            x0 = proposal
    
    # ADGO step
    for i in range(budget//2):
        # Find the local minimum of the current best point using gradient descent
        x = x0
        while True:
            grad = np.zeros(dim)
            for j in range(dim):
                eps = 1e-6 * (ub - lb) / 2 + rng.uniform(-eps, eps)
                grad[j] = (surrogate(x + eps*e_j) - surrogate(x)) / eps
                e_j = np.eye(dim)[j]
            
            step_size = 0.01
            x_new = x - step_size * grad
            
            # Clip to bounds
            for j in range(dim):
                x_new[j] = max(lb, min(ub, x_new[j]))
            
            if surrogate(x_new) < surrogate(x):
                x = x_new
            else:
                break
    
    return x0
