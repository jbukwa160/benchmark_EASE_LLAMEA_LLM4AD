def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for _ in range(budget):
        variance = 0.1 * (ub - lb) ** 2
        step_size = np.sqrt(variance / dim)
        step = rng.normal(size=dim) * step_size

        new_x = best_x + step
        new_x = np.clip(new_x, lb, ub)

        f_new = func(new_x)

        if f_new < best_f:
            best_f = f_new
            best_x = new_x

    return best_x
