def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def objective(candidate):
        return func(candidate)

    pop_size = 50
    sigma_init = 5.0
    mu_init = 1.0

    population = rng.uniform(lb, ub, (pop_size, dim))
    cov_matrix = np.eye(dim) * sigma_init**2
    mean_vector = np.zeros((dim))

    for _ in range(budget):
        candidates = clip(population + rng.normal(size=(pop_size, dim)) * np.sqrt(np.diag(cov_matrix)), lb, ub)
        fitnesses = [objective(candidate) for candidate in candidates]

        best_candidate = clip(candidates[np.argmin(fitnesses)], lb, ub)

        if objective(best_candidate) < objective(mean_vector):
            mean_vector = best_candidate

        cov_matrix += 0.1 * (np.outer((best_candidate - mean_vector), (best_candidate - mean_vector)) - np.eye(dim) * sigma_init**2)
        sigma = np.sqrt(np.diag(cov_matrix))
        mu = mean_vector

        population = clip(mu + rng.normal(size=(pop_size, dim)) * sigma, lb, ub)

    return best_candidate
