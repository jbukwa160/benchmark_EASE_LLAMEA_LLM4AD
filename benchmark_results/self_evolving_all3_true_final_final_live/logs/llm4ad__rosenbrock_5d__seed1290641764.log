def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    best_cost = func(x_best)

    std_dev = (ub - lb) / 2.0
    for _ in range(budget):
        new_std_dev = std_dev * 0.9  # decay factor
        x_new = x_best + np.random.normal(size=dim, loc=0, scale=new_std_dev)
        
        # Clip to bounds
        x_new = np.clip(x_new, lb, ub)

        cost_new = func(x_new)
        if cost_new < best_cost:
            best_cost = cost_new
            x_best = x_new

    return x_best
