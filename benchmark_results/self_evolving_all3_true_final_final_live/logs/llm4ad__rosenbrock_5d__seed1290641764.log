def algorithm(func, dim, lb, ub, budget, rng):
    def neg_func(x):
        return -func(x)

    x = np.random.uniform(lb, ub, size=(dim,))
    gp_model = GaussianProcessRegressor(kernel=np.ones((1, 1)))
    for _ in range(budget):
        y_pred, sigma_sq = gp_model.predict(np.array([x]), return_std=True)
        ei = ExpectedImprovement(neg_func, gp_model, x, rng=rng)
        next_x = ei.suggest(gp_model, lb, ub)
        gp_model.fit(x=next_x.reshape(1, -1), y=neg_func(next_x))
        x = next_x
    return x
