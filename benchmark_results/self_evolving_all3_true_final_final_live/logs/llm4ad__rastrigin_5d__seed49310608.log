def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    f_best = np.inf
    for _ in range(budget):
        r = 0.5 / (1 + _/budget) # adaptive radius
        x_rand = rng.uniform(lb, ub, size=dim)
        x_new = x_best + r * rng.normal(size=dim)
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)
        if f_new < f_best:
            x_best = x_new
            f_best = f_new
