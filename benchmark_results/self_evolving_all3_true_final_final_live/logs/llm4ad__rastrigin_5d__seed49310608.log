def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(dim, lb, ub, rng):
        return np.random.uniform(lb, ub, (10, dim))

    def clip_candidates(candidates, lb, ub):
        return np.clip(candidates, lb, ub)

    def evaluate_population(func, candidates):
        return func(candidates).flatten()

    def update_distribution(population, mean, step_size, rng):
        cov = 1.0 / len(population) * np.dot((population - mean[:, None]).T, (population - mean[:, None]))
        for i in range(dim):
            if cov[i, i] < 1e-8:
                cov[i, i] = 1e-8
        return mean + step_size * rng.multivariate_normal(mean, cov)

    def restart_search(mean, step_size, distribution):
        new_mean = np.zeros_like(mean)
        new_step_size = step_size / 2.0
        new_distribution = np.random.uniform(lb, ub, (10, dim))
        return new_mean, new_step_size, new_distribution

    mean = rng.normal(0, 1, dim)
    step_size = 1.0
    distribution = generate_initial_population(dim, lb, ub, rng)

    for _ in range(budget):
        population = clip_candidates(distribution, lb, ub)
        fitness = evaluate_population(func, population)
        best_idx = np.argmin(fitness)
        new_mean = mean + step_size * (population[best_idx] - mean)
        distribution = update_distribution(population, new_mean, step_size, rng)

        if _ % 100 == 0:
            mean, step_size, distribution = restart_search(mean, step_size, distribution)

    best_candidate = clip_candidates(distribution[np.argmin(evaluate_population(func, distribution))], lb, ub)
    return best_candidate
