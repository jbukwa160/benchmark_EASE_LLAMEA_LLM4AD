def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.maximum(np.minimum(x, ub), lb)

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_candidate = x_best.copy()
        for i in range(dim):
            v1, v2, v3 = rng.uniform(-1, 1, size=3)
            x_candidate[i] += 0.5 * (v1 + v2) * (ub - lb) + v3
            x_candidate[i] = bound(x_candidate[i])
        f_candidate = func(x_candidate)

        if f_candidate < f_best:
            x_best = x_candidate.copy()
            f_best = f_candidate

        alpha = 0.5 / np.log(_ + 2)
        if rng.uniform(0, 1) < np.exp(-(f_candidate - f_best) / alpha):
            x_best = x_candidate.copy()
            f_best = f_candidate
    return x_best
