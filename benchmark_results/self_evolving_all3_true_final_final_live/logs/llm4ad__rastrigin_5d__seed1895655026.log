def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_f = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
            
        # Local hill climbing
        for i in range(dim):
            step_size = 0.1 * (ub - lb)
            new_x = np.copy(x)
            new_x[i] += rng.uniform(-step_size, step_size)
            new_x = np.clip(new_x, lb, ub)
            
            f_new = func(new_x)
            
            if f_new < best_f:
                x = new_x
                f = f_new
                
    return best_x
