def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    n = 1
    while True:
        if n >= budget: break

        X = rng.uniform(lb, ub, size=(n, dim))
        Y = func(X)
        m_idx = np.argmax(Y)

        if Y[m_idx] < func(np.zeros(dim)):
            best_x = clip(X[m_idx])
            print(f"Best x so far: {best_x}")
            n *= 2

    return best_x
