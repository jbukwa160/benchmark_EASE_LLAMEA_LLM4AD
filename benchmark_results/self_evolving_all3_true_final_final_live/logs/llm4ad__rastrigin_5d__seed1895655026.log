def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(1, dim))
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        v = rng.normal(size=x.shape)
        u = x + 0.5 * v
        u = np.clip(u, lb, ub)

        f_u = func(u)

        if f_u < best_f:
            best_x = u.copy()
            best_f = f_u

        tau = np.exp(-1 / (rng.uniform(1, budget) ** 2 + 1))
        prob_accept = min(1, np.exp((best_f - f_u) / tau))

        if rng.uniform(0, 1) < prob_accept:
            x = u.copy()

    return best_x
