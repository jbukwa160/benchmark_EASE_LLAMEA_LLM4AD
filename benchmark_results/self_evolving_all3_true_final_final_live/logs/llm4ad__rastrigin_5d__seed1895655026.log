def algorithm(func, dim, lb, ub, budget, rng):
    archive = []
    best_sol = None
    best_obj = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        # Evaluate function and update archive
        y = func(x)
        if len(archive) < 100:
            archive.append((x, y))
        else:
            idx = np.argsort([f[1] for f in archive])[::-1]
            archive[idx[:50]] = [(x, y)]
        
        # Update best solution
        if y < best_obj:
            best_sol = x.copy()
            best_obj = y
            
    return best_sol
