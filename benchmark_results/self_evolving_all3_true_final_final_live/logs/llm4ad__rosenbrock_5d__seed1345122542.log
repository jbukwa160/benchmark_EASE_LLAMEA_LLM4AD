def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    sigma = 0.5 * (ub - lb) / 2
    lambda_ = int(np.ceil(4 + 3 * np.log(dim)))
    mu = lambda_ // 2
    D = dim + 1
    cumul_sum = np.zeros((D,))

    for _ in range(budget):
        y = func(x)
        cumul_sum[:dim] += x ** 2
        cumul_sum[dim] += 1

        c_d = (1 / lambda_) * rng.normal(size=(mu,))
        z = sigma * np.sqrt(cumul_sum) @ c_d + x
        z = lb + (ub - lb) * rng.uniform(size=dim)
        z[z < lb] = lb
        z[z > ub] = ub

        y_new = func(z)

        if y_new < y:
            x = z
            sigma *= 1.01
        else:
            D -= 1
            cumul_sum[:D] /= lambda_
            sigma *= np.sqrt(2 / (dim + 0.5)) * 1.1

    return x
