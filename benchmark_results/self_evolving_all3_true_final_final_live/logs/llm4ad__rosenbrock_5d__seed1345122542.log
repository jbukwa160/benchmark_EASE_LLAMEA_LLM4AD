def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def f(x):
        return func(x)

    D = dim
    N = budget // (10 * D)
    init_sigma = 1.0
    best_x = np.random.uniform(lb, ub, D)
    best_fx = f(best_x)
    current_x = best_x

    for i in range(N):
        current_fx = best_fx
        next_x = clip(current_x + rng.normal(size=D) * init_sigma)
        
        # SA step
        alpha = 0.9
        delta_fx = f(next_x) - current_fx
        if delta_fx < 0 or np.random.rand() < np.exp(-delta_fx / (current_fx + 1e-6)):
            current_x, current_fx = next_x, f(current_x)
        
        # ADE step
        for j in range(D):
            candidate_x = clip(next_x.copy())
            w = rng.uniform(0.5, 1.0)
            candidate_x[j] += w * (next_x[j] - current_x[j]) + rng.normal(0, 0.1) * (current_x[j] - best_x[j])
            delta_fx = f(candidate_x) - current_fx
            if delta_fx < 0 or np.random.rand() < np.exp(-delta_fx / (current_fx + 1e-6)):
                next_x, current_fx = candidate_x, f(next_x)
        
        if f(current_x) < best_fx:
            best_fx, best_x = f(current_x), current_x

    return best_x
