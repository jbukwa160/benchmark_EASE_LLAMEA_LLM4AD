def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget - 1):
        i = rng.choice(dim)
        x[i] += (ub - lb) * (rng.rand() - 0.5)
        
        # clip to bounds
        x = np.clip(x, lb, ub)
        
        f = func(x)
        
        if f < best_f:
            best_x = x.copy()
            best_f = f
    
    return best_x
