def algorithm(func, dim, lb, ub, budget, rng):
    n = len(rng)
    x_best = -np.inf
    y_best = np.zeros(n)
    for _ in range(budget):
        mean = (ub + lb) / 2 * rng(np.ones(n)) + (ub - lb) / 2 * (2 * rng(np.ones(n)) - 1)
        cov = np.eye(dim) * 0.5
        for _ in range(10):
            cov += 0.01
            cov -= 0.005 * np.outer(rng(np.ones(dim)), rng(np.ones(dim)))
            cov[np.diag_indices(dim)] *= (np.mean(rng(np.ones(n))) - 1)**2 + 0.05
            x = mean + np.sqrt(cov) * rng((dim,))
            for i in range(dim):
                if x[i] < lb:
                    x[i] = lb
                elif x[i] > ub:
                    x[i] = ub
            y = func(x)
            if y > x_best:
                x_best = y
                y_best = x.copy()
        cov = np.linalg.inv(cov)
    return y_best
