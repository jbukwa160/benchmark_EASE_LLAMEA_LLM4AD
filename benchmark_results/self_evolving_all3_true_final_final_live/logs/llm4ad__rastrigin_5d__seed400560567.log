def algorithm(func, dim, lb, ub, budget, rng):
    def sample(rng, n):
        return np.clip(rng.randn(n, dim), -5, 5)

    def evaluate(x):
        return func(x) / len(x)

    best = np.zeros(dim)
    best_fit = float('inf')
    restarts = 0
    while restarts < budget:
        pop_size = 10 * dim + 1
        pop = sample(rng, pop_size)
        population_size = pop_size // 2
        learning_rate = 5 / (population_size ** 0.33)
        for _ in range(population_size):
            parent = rng.choice(pop, size=dim, replace=False)
            child = parent + np.random.normal(0, 1, dim) * learning_rate
            pop = np.vstack((pop, np.clip(child, lb, ub)))
        fit = evaluate(pop)
        sorted_pop = pop[np.argsort(fit)]
        if fit[-1] < best_fit:
            best_fit = fit[-1]
            best = sorted_pop[-1]
        else:
            for i in range(len(sorted_pop) - 1):
                child = (sorted_pop[i] + sorted_pop[i+1]) / 2
                pop = np.vstack((pop, np.clip(child, lb, ub)))
                fit = evaluate(pop)
                if fit[-1] < best_fit:
                    best_fit = fit[-1]
                    best = pop[-1]
        restarts += 1
    return best
