def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def sample_gaussian(mean, std_dev, size):
        return mean + std_dev * rng.randn(size)

    best_solution = None
    for _ in range(budget):
        if best_solution is not None:
            current_solution = clip(best_solution + 0.1 * sample_gaussian(0, 1, dim))
        else:
            current_solution = clip(sample_gaussian(0, 5, dim))

        current_value = func(current_solution)
        if best_solution is None or current_value < func(best_solution):
            best_solution = current_solution

    return best_solution
