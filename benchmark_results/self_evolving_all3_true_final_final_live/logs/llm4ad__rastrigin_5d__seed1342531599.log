def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    for _ in range(budget):
        if rng.rand() < 0.1:  # 10% chance of random restart
            x_candidate = rng.uniform(lb, ub, size=dim)
        else:
            mu = rng.uniform(lb, ub, size=dim)
            sigma = rng.uniform(0.1, 5.0, size=dim)
            noise = rng.randn(dim) * sigma
            x_candidate = mu + noise

        f_candidate = func(x_candidate)

        if f_candidate < func(x_best):
            x_best = x_candidate

    return x_best
