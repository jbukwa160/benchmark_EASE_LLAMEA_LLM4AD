def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.ceil(dim * 100 / (func.__name__ == 'Rastrigin' and dim < 30)))
    D = np.zeros((pop_size, dim))
    f_value = np.zeros(pop_size)
    x_best = np.zeros(dim)

    for i in range(pop_size):
        D[i] = rng.uniform(lb, ub, size=(1, dim))

    best_idx = np.argmin(f_value)

    for _ in range(budget):
        for i in range(pop_size):
            idxs = np.random.choice(pop_size, 3, replace=False)
            v = D[idxs[0]] + rng.uniform(-1, 1) * (D[idxs[1]] - D[idxs[0]])
            f_v = func(v)

            if not np.isfinite(f_v):
                continue

            if f_value[i] > f_v:
                D[i] = v
                f_value[i] = f_v

        best_idx = np.argmin(f_value)
        x_best = D[best_idx]

        for i in range(pop_size):
            r1, r2, r3 = rng.uniform(0, 1), rng.uniform(0, 1), rng.uniform(0, 1)
            F = 0.5 + (1 - _ / budget) * 0.5
            CR = 0.9 + (1 - _ / budget) * 0.1

            if r1 < CR or np.random.rand() < 0.1:
                D[i] = x_best + F * (D[idxs[0]] - x_best) + rng.uniform(-1, 1) * (D[idxs[1]] - D[idxs[2]])
                f_v = func(D[i])

                if not np.isfinite(f_v):
                    continue

                if f_value[i] > f_v:
                    D[i] = D[idxs[0]] + F * (v - D[idxs[0]]) + rng.uniform(-1, 1) * (D[idxs[2]] - D[idxs[1]])
                    f_value[i] = f_v

        for i in range(pop_size):
            if not np.isfinite(f_value[i]):
                continue
            D[i] = np.clip(D[i], lb, ub)

    return x_best
