def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    def differential_evolution(population_size, max_iter):
        population = np.random.uniform(lb, ub, (population_size, dim))
        for _ in range(max_iter):
            candidates = np.zeros((population_size, dim))
            for i in range(population_size):
                idxs = np.random.choice(population_size, 3, replace=False)
                u = population[idxs]
                v = np.mean(u, axis=0)
                candidates[i] = clip(v + rng.uniform(-1.0, 1.0, dim))
            fit = [func(c) for c in candidates]
            fits = np.array(fit)
            best_idx = np.argmin(fits)
            if fits[best_idx] < func(population[np.argmin([func(p) for p in population])]):
                population[best_idx] = clip(candidates[best_idx])
        return population[np.argmin([func(p) for p in population])]

    def local_search(population, max_iter):
        for _ in range(max_iter):
            idxs = np.random.choice(len(population), 2, replace=False)
            u = population[idxs]
            v = np.mean(u, axis=0)
            new_population = clip(v + rng.uniform(-1.0, 1.0, dim))
            if func(new_population) < func(population[np.argmin([func(p) for p in population])]):
                population = [new_population] + [p for i, p in enumerate(population) if i != idxs[0] and i != idxs[1]]
        return population[np.argmin([func(p) for p in population])]

    population = differential_evolution(100, 10 * dim)
    best = local_search(population[:budget], 5*dim)
    return best
