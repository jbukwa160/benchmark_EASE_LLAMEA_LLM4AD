def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    def distance(p1, p2):
        return sum((p1 - p2) ** 2)

    def evaluate(params):
        return func(bound(params))

    num_particles = int(0.01 * dim)
    particle_size = dim
    inertia_weight = 0.7298
    cognitive_weight = 1.49618
    social_weight = 1.49618

    population = np.random.rand(num_particles, particle_size) - 0.5 + (ub - lb) / 2
    temperature = rng.uniform(10, 100)
    best_solution = None
    best_fitness = float('inf')

    for i in range(budget):
        fitnesses = [evaluate(p) for p in population]
        worst_idx = np.argmin(fitnesses)
        global_best_fitness = min(min(fitnesses[:worst_idx]), min(fitnesses[worst_idx:]))

        if best_solution is None or best_fitness > global_best_fitness:
            best_solution = population[worst_idx].copy()
            best_fitness = global_best_fitness

        for j in range(num_particles):
            candidate = population[j] + rng.uniform(-1, 1)
            candidate = bound(candidate)

            fitness_candidate = evaluate(candidate)
            if fitness_candidate < fitnesses[j]:
                population[j] = candidate
                if fitnesses[j] > best_fitness:
                    best_solution = candidate.copy()
                    best_fitness = fitnesses[j]

        for j in range(num_particles):
            r1, r2 = rng.uniform(0, 1), rng.uniform(0, 1)
            p1_idx = np.random.choice(num_particles, replace=False)
            p2_idx = np.random.choice(num_particles, replace=False)

            velocity_candidate = inertia_weight * population[j] + cognitive_weight * rng.uniform(0, 1) * (population[p1_idx] - population[j]) \
                                + social_weight * rng.uniform(0, 1) * (population[p2_idx] - population[j])

            candidate = bound(population[j] + velocity_candidate)
            fitness_candidate = evaluate(candidate)

            if fitness_candidate < fitnesses[j]:
                population[j] = candidate
                if fitnesses[j] > best_fitness:
                    best_solution = candidate.copy()
                    best_fitness = fitnesses[j]

        temperature *= 0.99

    return best_solution
