def algorithm(func, dim, lb, ub, budget, rng):
    n = 10  # number of neighbors to consider for local refinement
    pop_size = 50  # initial population size
    F = 0.5  # differential evolution scaling factor
    CR = 0.9  # crossover probability

    x_best = np.random.uniform(lb, ub, dim)
    f_best = func(x_best)

    for i in range(budget):
        pop = np.random.uniform(lb, ub, (pop_size, dim))
        f_pop = [func(x) for x in pop]

        # differential evolution step
        for j in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size, 3)
            while r1 == j or r2 == j or r3 == j:
                r1, r2, r3 = rng.randint(0, pop_size, 3)

            u = pop[r1] + F * (pop[r2] - pop[r3])
            if func(u) < f_pop[j]:
                pop[j] = u
                f_pop[j] = func(pop[j])

        # local refinement step
        for j in range(pop_size):
            x = pop[j]
            for k in range(dim):
                u = x.copy()
                u[k] += 1e-6 * rng.uniform(-1, 1)
                if u[k] < lb:
                    u[k] = lb
                elif u[k] > ub:
                    u[k] = ub

                # gradient information for local refinement
                grad = np.zeros(dim)
                grad[k] = -2 * (u[k]**2 - 10 * np.cos(2 * np.pi * u[k]))
                grad -= 2 * x[k]

                if func(u) < f_pop[j]:
                    pop[j] = u
                    f_pop[j] = func(pop[j])

        # update best solution
        for j in range(pop_size):
            if f_pop[j] < f_best:
                f_best = f_pop[j]
                x_best = pop[j]

    return x_best
