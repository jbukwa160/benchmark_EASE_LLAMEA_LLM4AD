def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([random.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)

    def neighborhood(x, sigma):
        return x + sigma * (np.random.rand(dim) - 0.5)

    scale = max(ub - lb, 1e-6)
    scale /= 2

    for _ in range(budget):
        if np.random.rand() < 0.05:
            scale *= 0.9
        elif np.random.rand() < 0.05:
            scale /= 0.9

        for i in range(dim):
            cand = neighborhood(x, scale)
            cand = np.clip(cand, lb, ub)

            f_cand = func(cand)
            if f_cand < best_f:
                best_x = cand
                best_f = f_cand

        x = best_x.copy()

    return best_x
