def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = dim
    n_born = int(budget / 10)
    mu = np.zeros(D)
    sigma = 1.0
    cov = np.eye(D) * (sigma ** 2)

    for i in range(n_born):
        X_new = np.random.uniform(lb, ub, size=(D,))
        X_new = clip(X_new)
        f_new = func(X_new)
        if i == 0 or f_new < f_best:
            mu = X_new
            f_best = f_new

    for _ in range(n_born, budget):
        lambda_ = int(budget / n_born)
        x = np.clip(mu + cov @ rng.normal(size=(lambda_, D)), lb, ub)

        F = np.array([func(clip(x_i)) for x_i in x])

        idx_best = np.argsort(F)[:1]
        f_new = F[idx_best[0]]
        if f_new < f_best:
            mu = x[idx_best[0]]
            f_best = f_new

        cov = (lambda_ - 1) / lambda_ * cov + 1 / lambda_ * np.outer((x[idx_best[0]] - mu), (x[idx_best[0]] - mu))
        sigma = np.sqrt(np.diag(cov)).mean()

    return mu
