def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = clip(rng.uniform(lb, ub, size=(1, dim)))
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(budget):
        # Adaptive mutation strategy
        v = np.zeros((1, dim))
        for j in range(dim):
            if rng.random() < 0.5:
                v[0, j] = x[0, j] + (ub - lb) * rng.uniform(-1, 1)
            else:
                grad = func(clip(x + 1e-6 * np.eye(dim)[j])) - best_f
                v[0, j] = x[0, j] + grad / (100 * (x[0, j+1] - x[0, j]**2)**2)
        v = clip(v)

        # Differential evolution crossover and mutation
        u = np.zeros((1, dim))
        for k in range(dim):
            if rng.random() < 0.5:
                u[0, k] = v[0, k]
            else:
                u[0, k] = x[0, k] + (v[0, k] - x[0, k]) * rng.uniform(0, 1)

        # Simulated annealing
        f_u = func(u)
        if f_u < best_f and rng.random() > np.exp((best_f - f_u) / (i+1)):
            x = u.copy()
            best_x = x.copy()
            best_f = f_u

    return best_x
