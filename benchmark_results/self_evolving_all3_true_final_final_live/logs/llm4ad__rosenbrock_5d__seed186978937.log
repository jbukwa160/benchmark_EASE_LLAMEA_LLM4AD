def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(np.array([x]))

    n_dim = len(lb)
    x_best = 5 * np.ones(n_dim) + rng.uniform(-5, 0, n_dim)
    f_best = 1e10
    sigma = 5.0

    for _ in range(budget):
        x = x_best + sigma * rng.normal(size=n_dim)
        f_x = f(x)

        if f_x < f_best:
            f_best = f_x
            x_best = x

        # SA part
        alpha = 0.9
        T = budget - _
        P = np.exp(-alpha / T)
        u = rng.uniform(0, 1, n_dim)
        x_new = x_best + sigma * np.sqrt(P) * (x_best - x) + sigma * np.sqrt(1-P) * rng.normal(size=n_dim)

        # clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)

        if f_new < f_best:
            f_best = f_new
            x_best = x_new

    return x_best
