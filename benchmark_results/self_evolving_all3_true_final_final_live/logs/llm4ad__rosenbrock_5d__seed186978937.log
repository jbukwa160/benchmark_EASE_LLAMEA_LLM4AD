def algorithm(func, dim, lb, ub, budget, rng):
    num_init = 10 * dim  # number of initial random candidates
    num_iter = (budget - num_init) // 2  # number of iterations for BO and RS
    sigma_schedule = [1.0] + [1 / np.sqrt(2 ** i) for i in range(num_iter)]  # schedule for std dev of GP

    init_candidates = rng.uniform(lb, ub, size=(num_init, dim))
    scores = np.array([func(candidate) for candidate in init_candidates])

    best_candidate = init_candidates[np.argmin(scores)]
    best_score = np.min(scores)

    for i in range(num_iter):
        # Bayesian Optimization (BO)
        X_bo = init_candidates[scores < best_score]
        Y_bo = func(X_bo)
        mu, sigma = GaussianProcess(X_bo, Y_bo, sigma_schedule[i])
        next_candidate_bo = sample_from_gp(mu, sigma, rng)

        # Random Search (RS)
        next_candidate_rs = rng.uniform(lb, ub, size=dim)

        next_candidates = np.vstack((next_candidate_bo, next_candidate_rs))
        scores = np.array([func(candidate) for candidate in next_candidates])
        best_candidate = next_candidates[np.argmin(scores)]
        best_score = np.min(scores)
        init_candidates = np.vstack((init_candidates, next_candidates))

    clipped_best_candidate = np.clip(best_candidate, lb, ub)
    return clipped_best_candidate
