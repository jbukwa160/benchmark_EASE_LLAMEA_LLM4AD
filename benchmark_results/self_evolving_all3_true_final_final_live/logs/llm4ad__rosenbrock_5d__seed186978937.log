def algorithm(func, dim, lb, ub, budget, rng):
    def clip_bounds(x):
        return np.clip(x, lb, ub)

    bounds = [(lb, ub) for _ in range(dim)]
    
    # Initial global search using DE
    res_de = differential_evolution(func, bounds)
    
    # Local optimization around the best found solution
    init_guess = clip_bounds(res_de.x)
    res_lbfgs = minimize(lambda x: func(clip_bounds(x)), init_guess, method="L-BFGS-B", bounds=bounds)
    
    # Update budget counter and return the best solution found so far
    budget -= 1 + 1  # DE + L-BFGS-B iterations
    
    if res_lbfgs.fun < res_de.fun:
        return clip_bounds(res_lbfgs.x)
    else:
        return clip_bounds(res_de.x)
