def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    learning_rate = 0.1
    best_x = x.copy()
    best_y = func(x)

    for _ in range(budget):
        gradient = np.zeros(dim)
        for i in range(dim-1):
            gradient[i] += 400 * (x[i+1] - x[i]**2) * (2*x[i] - 2*(x[i+1]-x[i]**2)) + 2 * (1-x[i])
            gradient[i+1] -= 400 * (x[i+1] - x[i]**2)**2

        step_size = learning_rate / np.sqrt(np.sum(gradient**2) + 1e-8)
        x += rng.uniform(-step_size, step_size, dim)

        for i in range(dim):
            if x[i] < lb:
                x[i] = lb
            elif x[i] > ub:
                x[i] = ub

        y = func(x)
        if y < best_y:
            best_x = x.copy()
            best_y = y

    return best_x
