def algorithm(func, dim, lb, ub, budget, rng):
    best_candidate = np.zeros(dim)
    best_score = float('inf')
    
    for _ in range(budget):
        candidate = (ub - lb) * rng.rand(dim) + lb
        score = func(candidate)
        
        if score < best_score:
            best_score = score
            best_candidate = candidate
            
        # Elitism: keep 10% of the worst candidates
        if np.random.rand() < 0.1 and _ > budget // 10:
            worst_candidate = np.array([x for x in [candidate, best_candidate] if x != best_candidate])
            if func(worst_candidate) < score:
                candidate = worst_candidate
                
    return best_candidate
