def algorithm(func, dim, lb, ub, budget, rng):
    def wrapper(x):
        return func(x)

    res = differential_evolution(wrapper, [(lb, ub) for _ in range(dim)], x0=np.zeros(dim), strategy='rand1exp', maxiter=budget)
    
    best_x = np.clip(res.x, lb, ub)
    
    if rng.rand() < 0.01:
        return np.random.uniform(lb, ub, size=dim)
    
    return best_x
