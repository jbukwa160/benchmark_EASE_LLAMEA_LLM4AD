def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x) + 0.1 * (ub - lb)**5

    pop_size = int(np.ceil(budget ** (1 / 4)))
    population = rng.uniform(lb, ub, size=(pop_size, dim))

    for _ in range(budget // pop_size):
        new_population = np.zeros_like(population)
        for i in range(pop_size):
            a, b, c = rng.choice(pop_size, size=3, replace=False)
            child = clip(population[a] + 0.5 * (population[b] - population[c]) + rng.uniform(-1, 1))
            new_population[i] = child
        population = np.concatenate((new_population, population))

    for _ in range(10): # number of local search iterations
        for i in range(pop_size):
            x = clip(population[i])
            x_best = x.copy()
            best_value = evaluate(x)
            for j in range(dim):
                x[j] += 0.01 * rng.uniform(-1, 1) * (x_best[j] - x[j])
                value = evaluate(clip(x))
                if value < best_value:
                    best_value = value
                    x_best = x.copy()
            population[i] = x_best

    return np.argmin([evaluate(x) for x in population], axis=0)
