def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for i in range(budget):
        x_candidate = x_best + 0.1 * (np.random.rand(dim) - 0.5) * 2
        x_candidate = clip(x_candidate)
        f_candidate = func(x_candidate)

        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate

        # Local refinement with adaptive sampling
        if rng.uniform() > 0.9:
            step_size = 0.01 * (ub - lb) / np.sqrt(i + 1)
            for j in range(dim):
                x_local = x_best.copy()
                x_local[j] += np.sign(x_candidate[j] - x_best[j]) * step_size
                x_local = clip(x_local)
                f_local = func(x_local)

                if f_local < f_best:
                    x_best = x_local
                    f_best = f_local

    return x_best
