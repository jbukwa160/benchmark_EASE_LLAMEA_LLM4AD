def algorithm(func, dim, lb, ub, budget, rng):
    D = len(dim)
    n_gen = int(budget / (D * 100))
    temp_init = 1.0
    cooling_rate = 0.99

    best_pos = rng.uniform(lb, ub, size=dim)
    best_val = func(best_pos)

    for gen in range(n_gen):
        population = np.random.rand(50, D) * (ub - lb) + lb
        tmp_pop = np.copy(population)

        for i in range(50):
            v1 = rng.uniform(lb, ub)
            v2 = rng.uniform(lb, ub)
            vi = v1 * best_pos[i] + v2 * population[i]

            for j in range(D):
                if rng.random() < 0.5:
                    tmp_pop[i, j] += (vi[j] - population[i, j]) / D
                    if tmp_pop[i, j] > ub:
                        tmp_pop[i, j] = ub
                    elif tmp_pop[i, j] < lb:
                        tmp_pop[i, j] = lb

        for i in range(50):
            vi = np.copy(population[i])
            if rng.random() < 0.1:
                idx1, idx2 = rng.randint(0, 49, size=2)
                vi[idx1], vi[idx2] = population[idx2].copy(), population[idx1].copy()

            val_i = func(vi)
            if val_i < best_val or rng.random() < np.exp((best_val - val_i) / temp_init):
                best_val = val_i
                best_pos = vi

        temp_init *= cooling_rate

    return best_pos
