def algorithm(func, dim, lb, ub, budget, rng):
    n = 0
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)
    
    while n < budget:
        lambda_ = 4 + int(np.log(2 * (budget - n) / rng))
        n += lambda_
        
        for _ in range(lambda_):
            sigma = np.exp((f_best - func(x_best)) / (0.5 * dim))
            
            x_new = x_best + sigma * np.random.normal(size=dim)
            x_new = np.clip(x_new, lb, ub)
            
            f_new = func(x_new)
            
            if f_new < f_best:
                f_best = f_new
                x_best = x_new
                
        mu = lambda_ // 2
        x_avg = (1 / mu) * sum([func(np.clip(x, lb, ub)) for _ in range(mu)])
        
        if func(x_avg) < f_best:
            f_best = func(x_avg)
            x_best = x_avg
            
    return x_best
