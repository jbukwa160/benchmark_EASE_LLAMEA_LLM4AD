def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x)

    def random_search(budget):
        x = rng.uniform(lb, ub, size=(dim,))
        best_x = x
        best_f = evaluate(clip(x))
        for _ in range(budget - 1):
            x = rng.uniform(lb, ub, size=(dim,))
            f = evaluate(clip(x))
            if f < best_f:
                best_f = f
                best_x = x
        return best_x

    def differential_evolution(budget):
        population_size = int(np.ceil((budget / 5)**0.8)) + 1
        pop = rng.uniform(lb, ub, size=(population_size, dim))
        for _ in range(int(np.ceil((budget - population_size) / (4 * population_size))) + 1):
            for i in range(population_size):
                r1, r2, r3 = np.random.choice(range(population_size), replace=False, size=3)
                while r1 == i or r2 == i or r3 == i:
                    r1, r2, r3 = np.random.choice(range(population_size), replace=False, size=3)
                trial_x = pop[r1] + 0.5 * (pop[r2] - 2 * pop[r3]) + rng.uniform(-1, 1, size=(dim,))
                trial_x = clip(trial_x)
                if evaluate(clip(trial_x)) < evaluate(clip(pop[i])):
                    pop[i] = trial_x
        return pop[np.argmin([evaluate(clip(x)) for x in pop])]

    best_x = random_search(budget // 2)
    best_pop = differential_evolution(budget - budget // 2)
    return np.argmin([evaluate(clip(x)) for x in [best_x] + best_pop])
