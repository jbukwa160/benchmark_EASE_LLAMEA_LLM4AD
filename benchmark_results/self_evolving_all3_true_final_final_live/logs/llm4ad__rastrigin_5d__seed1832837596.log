        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_fitness = float('inf')

    for _ in range(budget):
        v = rng.uniform(-1, 1, size=dim)
        u = clip(best_x + v)
        w = rng.choice(dim, size=np.random.randint(1, dim+1), replace=False)

        y = np.zeros_like(x)
        for i in w:
            y[i] = u[i]

        y = clip(y)
        y_fitness = evaluate(y)

        if y_fitness < best_fitness:
            best_x = y.copy()
            best_fitness = y_fitness

        alpha = 0.9
        beta = 1 - alpha * (budget - _) / budget
        T = 100.0

        p = rng.uniform(0, 1)
        if p < np.exp((best_fitness - y_fitness) / T):
            x = y.copy()

    return best_x
