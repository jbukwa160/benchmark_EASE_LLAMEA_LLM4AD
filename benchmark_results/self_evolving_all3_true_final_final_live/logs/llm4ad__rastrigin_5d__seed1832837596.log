def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x) + 1e-32 * np.sum(np.abs(x))

    D = dim
    N = int(budget / (D * 10))
    pop_size = 50
    sigma = 0.5
    temperature = 1000

    x_best = lb + (ub - lb) * rng.rand(pop_size, D)
    y_best = evaluate(x_best)

    for n in range(N):
        x_new = np.copy(x_best)
        for i in range(pop_size):
            diff = sigma * (rng.rand(D) - 0.5)
            x_new[i] += diff
            x_new[i] = np.clip(x_new[i], lb, ub)
        y_new = evaluate(x_new)

        if n % D == 0:
            temperature *= 0.9

        for i in range(pop_size):
            if y_new[i] < y_best[i]:
                y_best[i] = y_new[i]
                x_best[i] = np.copy(x_new[i])
            elif rng.rand() < np.exp((y_best[i] - y_new[i]) / temperature):
                y_best[i] = y_new[i]
                x_best[i] = np.copy(x_new[i])

    return x_best[np.argmin(y_best)]
