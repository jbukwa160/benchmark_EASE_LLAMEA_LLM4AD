def algorithm(func, dim, lb, ub, budget, rng):
    def acceptance_probability(t, current_fitness, new_fitness):
        return min(1, np.exp(-(new_fitness - current_fitness) / t))

    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def generate_candidate(current_solution, sigma):
        return current_solution + rng.normal(size=dim, loc=0, scale=sigma)

    # Initial solution and temperature
    x = rng.uniform(lb, ub, size=dim)
    t = 1.0

    # Initialize CMA-ES parameters
    mu = np.zeros(dim)
    sigma = 0.5 * (ub - lb)
    cov = np.eye(dim) * (sigma ** 2)

    for i in range(budget):
        # Generate a new candidate using SA or CMA-ES
        if rng.uniform(0, 1) < 0.9:
            candidate = generate_candidate(x, sigma)
        else:
            candidate = mu + rng.multivariate_normal(mu, cov)

        # Clip the candidate to bounds
        candidate = clip(candidate, lb, ub)

        # Evaluate the new candidate
        current_fitness = func(x)
        new_fitness = func(candidate)

        # Update CMA-ES parameters if new solution is better
        if new_fitness < current_fitness:
            x = candidate
            mu = (1 - 0.5) * mu + 0.5 * candidate
            cov = (1 - 0.3) * cov + 0.3 * np.outer(candidate - mu, candidate - mu)
            sigma = 0.9 * sigma

        # Annealing schedule for temperature reduction
        t *= 0.99999

        # Accept or reject the new solution based on acceptance probability
        if rng.uniform(0, 1) < acceptance_probability(t, current_fitness, new_fitness):
            x = candidate

    return x
