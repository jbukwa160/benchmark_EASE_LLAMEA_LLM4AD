def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    def func_val(x):
        x = clip(x)
        return func(x)

    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func_val(best_x)

    pop_size = 10
    mean = best_x.copy()
    cov = np.eye(dim) * 0.1
    learning_rate = 0.01

    for _ in range(budget):
        new_pop = np.random.multivariate_normal(mean, cov, size=pop_size)
        new_pop = clip(new_pop)

        f_new = [func_val(x) for x in new_pop]
        best_idx = np.argmax(f_new)

        if f_new[best_idx] < best_f:
            best_x = new_pop[best_idx].copy()
            best_f = f_new[best_idx]

        cov = (1 - learning_rate) * cov + learning_rate * np.outer(new_pop[best_idx] - mean, new_pop[best_idx] - mean)

    return best_x
