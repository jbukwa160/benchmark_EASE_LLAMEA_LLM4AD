def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.ceil(budget ** (1 / dim)))
    x_best = None
    f_best = float('inf')
    sigma = rng.uniform(0.01, 10)
    mean = rng.uniform(lb, ub, size=dim)

    for _ in range(pop_size):
        z = rng.normal(size=dim)
        offspring = mean + sigma * z

        # clip to bounds
        offspring = np.clip(offspring, lb, ub)

        f_new = func(offspring)

        if f_new < f_best:
            x_best = offspring.copy()
            f_best = f_new

        sigma *= 0.99
        if _ % int(pop_size * 0.9) == 0:  # every 10% of population size
            sigma = rng.uniform(max(sigma / 2, 0.01), max(sigma * 2, 1))

    return x_best
