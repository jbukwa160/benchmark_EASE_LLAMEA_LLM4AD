def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    best_f = func(x)

    while budget > 0:
        if rng.random() < 0.1:  # 10% chance of mutation
            for i in range(dim):
                if rng.random() < 0.5:  # flip a bit with 50% chance
                    x[i] = np.clip(lb + (ub - lb) * rng.rand(1), lb, ub)[0]
        else:
            delta = rng.randn(dim)
            step_size = 0.01 * (ub - lb) * rng.uniform()
            x += delta * step_size

        f = func(x)
        if f < best_f:
            best_x = x.copy()
            best_f = f

        budget -= 1
        x[:] = np.clip(x, lb, ub)

    return best_x
