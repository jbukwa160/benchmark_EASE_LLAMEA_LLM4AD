def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    pop_size = 50
    best_candidate = np.random.uniform(lb, ub, size=dim)
    personal_best = [clip(best_candidate.copy()) for _ in range(pop_size)]
    global_best = clip(best_candidate)

    for i in range(budget):
        for j in range(pop_size):
            mutation_vector = rng.uniform(lb, ub, size=dim) if rng.randint(0, 2) else np.zeros(dim)
            mutated_candidate = personal_best[j] + mutation_vector
            trial_candidate = clip(mutated_candidate)

            fitness_trial = func(trial_candidate)
            fitness_personal = func(personal_best[j])

            if fitness_trial < fitness_personal:
                personal_best[j] = trial_candidate

        best_candidate = np.array([min(personal_best, key=func)])
        global_best = min(global_best, best_candidate, key=func)

    return global_best
