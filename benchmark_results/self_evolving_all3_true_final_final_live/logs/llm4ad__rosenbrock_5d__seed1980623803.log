def algorithm(func, dim, lb, ub, budget, rng):
    def clipped(x):
        return np.clip(x, lb, ub)

    def objective(x):
        return func(clipped(x))

    def grad(x):
        dx = np.zeros(dim)
        for i in range(dim-1):
            dx[i] += 400*(x[i+1]-x[i]**2)*2*x[i]
            dx[i] -= 2*100*(x[i+1]-x[i]**2)
            dx[i+1] += 2*100*(x[i+1]-x[i]**2)*2
            dx[i+1] -= 2*(1-x[i])
        return dx

    def local_search(x, max_iter=10):
        x_best = x.copy()
        for _ in range(max_iter):
            d = np.random.uniform(-1, 1, dim)
            step_size = 0.01
            x_new = x + step_size * d
            if objective(x_new) < objective(x_best):
                x_best = x_new
        return x_best

    pop_size = 100
    population = rng.normal(size=(pop_size, dim))
    for _ in range(budget):
        fitnesses = np.array([objective(x) for x in population])
        weights = np.random.uniform(0.1, 1.0, size=dim)
        weighted_fitnesses = np.sum(fitnesses * weights, axis=1)
        idx = np.argsort(weighted_fitnesses)[:pop_size]
        population = population[idx]

        for i in range(pop_size):
            x_best = local_search(population[i])
            if objective(x_best) < objective(population[i]):
                population[i] = x_best

    return clipped(population[np.argmin(np.array([objective(x) for x in population]))])
