def algorithm(func, dim, lb, ub, budget, rng):
    def obj(x):
        return func(x)

    bounds = [(lb, ub) for _ in range(dim)]
    res_de = differential_evolution(obj, bounds, maxiter=budget//dim, x0=np.random.uniform(lb, ub, size=(dim, budget//dim)))

    # Local search step
    def local_search(x):
        for _ in range(budget - dim*res_de.nit):
            perturb = rng.uniform(-1e-3, 1e-3, size=dim)
            x_new = np.clip(x + perturb, lb, ub)
            if obj(x_new) < obj(x):
                x = x_new
        return x

    # Run local search starting from the best solution found by DE
    res_ls = local_search(res_de.x)

    return res_ls
