def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    best_candidate = rng.uniform(lb, ub, size=dim)
    best_fitness = func(best_candidate)

    sigma = 10.0
    mutation_strategy = 'rand/1/exp'

    for _ in range(budget):
        population = [get_candidate(rng.normal(loc, scale=sigma, size=dim), lb, ub) for loc in np.concatenate([best_candidate.reshape(1, dim)] * (budget - 1))]

        fitnesses = np.array([func(candidate) for candidate in population])
        indices = np.argsort(fitnesses)

        if _ > budget // 2:
            sigma *= 0.9

        best_candidate_next = get_candidate(population[indices[-1]], lb, ub)
        best_fitness_next = func(best_candidate_next)

        if best_fitness_next < best_fitness:
            best_candidate = best_candidate_next
            best_fitness = best_fitness_next

    return best_candidate
