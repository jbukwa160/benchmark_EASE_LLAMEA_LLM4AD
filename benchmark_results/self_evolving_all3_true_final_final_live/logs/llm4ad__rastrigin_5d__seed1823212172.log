def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=(1, dim))
    best_x = x.copy()

    for _ in range(budget):
        pop_size = 50
        pop = np.tile(clip(rng.uniform(lb, ub, size=(pop_size, dim))), (1, 1))

        for i in range(pop_size):
            v = clip(pop[i] + rng.uniform(-0.5, 0.5, size=dim))
            u = clip(v + rng.uniform(-0.5, 0.5, size=dim))
            pop[i] = u if func(u) < func(v) else v

        x_new = np.mean(pop, axis=0)
        best_x = clip(x_new if func(x_new) < func(best_x) else best_x)

    return best_x
