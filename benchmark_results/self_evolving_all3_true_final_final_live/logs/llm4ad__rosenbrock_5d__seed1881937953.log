def algorithm(func, dim, lb, ub, budget, rng):
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    for _ in range(budget):
        x = x_best.copy()
        for i in range(dim):
            x_new = x.copy()
            step_size = 0.1
            noise = np.random.normal(0, step_size, dim)
            x_new[i] += (ub - lb) * rng.uniform(-1, 1) + noise[i]
            x_new = np.clip(x_new, lb, ub)
            f_new = func(x_new)

            if f_new < f_best:
                x_best = x_new
                f_best = f_new

    return x_best
