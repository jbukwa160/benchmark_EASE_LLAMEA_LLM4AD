def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    T = 1.0
    alpha = 0.99

    for _ in range(budget):
        candidate = x + np.random.normal(size=dim) * 0.01
        candidate = clip(candidate)

        delta_f = func(candidate) - best_f
        if delta_f < 0:
            x = candidate.copy()
            best_x = candidate.copy()
            best_f = func(candidate)
        elif rng.uniform(0, 1) < np.exp(-delta_f / T):
            x = candidate.copy()

        T *= alpha

    return best_x
