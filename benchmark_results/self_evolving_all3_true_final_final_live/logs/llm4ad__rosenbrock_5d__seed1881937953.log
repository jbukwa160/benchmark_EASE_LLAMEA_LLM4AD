def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return sum(100*(x[i+1]-x[i]**2)**2 + (1-x[i])**2 for i in range(dim))

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(best_x)

    pop_size = 10
    sigma0 = 1.5
    sigma = sigma0
    mu = (ub-lb)/2

    for i in range(budget):
        if rng.random() < 0.01:
            x = np.random.uniform(lb, ub, size=dim)
        else:
            x = best_x + rng.normal(0, sigma, size=dim)

        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)

        f = func(x)

        if f < best_f:
            best_f = f
            best_x = x

        if i % 100 == 0 and rng.random() < 0.5:
            sigma *= 1 + 0.1*(rng.uniform(-1, 1) + (best_f - func(best_x))/np.sqrt(np.sum((x-best_x)**2)))
            mu = np.mean([func(x + rng.normal(0, sigma, size=dim)) for x in [best_x] * pop_size])

    return best_x
