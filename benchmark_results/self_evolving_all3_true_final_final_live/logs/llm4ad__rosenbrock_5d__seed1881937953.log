def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(x_best, x_i, F):
        z = x_best + F * (x_i - x_best)
        return np.clip(z, lb, ub)

    def crossover(x1, x2):
        a = 0.5
        u = rng.rand(dim)
        v = rng.rand(dim)
        return a*x1 + u*(x2 - x1) + v*np.sqrt(np.fabs(np.dot(x2-x1,u)))

    def local_search(x, budget):
        for _ in range(budget):
            cands = np.clip(x + 0.01*rng.randn(dim), lb, ub)
            if func(cands) < func(x):
                x = cands
        return x

    pop_size = int(np.sqrt(budget))
    pop = rng.uniform(lb, ub, size=(pop_size, dim))
    for _ in range(int(0.9 * budget)):
        targets = rng.choice(pop_size, size=pop_size, replace=False)
        parents = pop[targets]
        mutated_pop = np.array([mutate(parents[i], pop[i], 1) for i in range(pop_size)])
        crossed_pop = np.array([crossover(mutated_pop[i], parents[i]) for i in range(pop_size)])
        cross_prob = 0.5
        pop = (crossed_pop + mutated_pop) / 2 * cross_prob + parents * (1 - cross_prob)
    best_x = local_search(pop[0], int(budget*0.1))
    return best_x
