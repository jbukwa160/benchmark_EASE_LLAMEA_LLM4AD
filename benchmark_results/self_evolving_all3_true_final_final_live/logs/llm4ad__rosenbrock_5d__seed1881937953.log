def algorithm(func, dim, lb, ub, budget, rng):
    def bounds(x):
        return np.clip(x, lb, ub)

    def rand(lb, ub):
        return rng.uniform(lb, ub)

    x = np.array([lb + (ub - lb) * rand(0.0, 1.0) for _ in range(dim)])
    pop = [bounds(x)]
    f_pop = [func(bounds(x))]
    best_x = bounds(x)
    best_f = func(best_x)

    for i in range(budget):
        z = np.array([rand(0.0, 1.0) if rng.random() < 0.5 else pop[i][j] for j in range(dim)])
        z = bounds(z)
        
        cr = rand(0.0, 1.0)
        f_x = func(bounds(x + cr * (z - x)))
        f_z = func(bounds(z))
        f_best = np.min(f_pop)

        if i == budget - 1 or f_x < best_f:
            best_f = f_x
            best_x = bounds(x + cr * (z - x))

        if f_x < f_best:
            pop.append(bounds(x + cr * (z - x)))
            f_pop.append(f_x)
            idx = np.argmin(f_pop)
            x[idx] = pop[idx]
        elif f_z < f_best:
            pop.append(bounds(z))
            f_pop.append(f_z)
            idx = np.argmin(f_pop)
            x[idx] = pop[idx]

    return best_x
