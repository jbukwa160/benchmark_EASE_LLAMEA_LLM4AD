def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    min_val = func(x)

    for _ in range(budget):
        step_size = 0.1 * (ub - lb)
        delta = np.zeros_like(x)
        for i in range(dim):
            if rng.random() < 0.5:
                delta[i] = rng.uniform(-step_size, step_size)
        candidate = x + delta
        candidate = np.clip(candidate, lb, ub)

        val = func(candidate)
        if val < min_val:
            min_val = val
            best_x = candidate.copy()

    return best_x
