def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, (1, dim))
    simplex = np.vstack((x, [clip(x + 0.5 * (ub - lb) * np.random.normal(size=(1, dim))) for _ in range(dim)]))

    for _ in range(budget):
        y = func(simplex)
        s = np.argsort(y)[::-1]

        if y[s[0]] < y[s[-1]]:
            x_new = 2 * simplex[s[0]] - simplex[s[-1]]
            simplex[s[0], :] = clip(x_new)

    return simplex[s[0], :]
