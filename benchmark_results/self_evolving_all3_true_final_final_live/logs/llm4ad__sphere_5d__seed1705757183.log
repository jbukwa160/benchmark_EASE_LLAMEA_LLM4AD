def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 20
    sigma = 0.5
    c1 = 1.0
    c2 = 1.0
    strategy = "cma-es"
    
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for i in range(budget):
        if rng.uniform(0, 1) < 0.5:
            x = best_x + rng.normal(0, sigma, dim)
            x = np.clip(x, lb, ub)
        else:
            x = np.zeros(dim)
            x += rng.normal(0, c1 * (ub - lb), dim)
            x2 = np.zeros(dim)
            x3 = np.zeros(dim)
            for j in range(pop_size):
                if rng.uniform(0, 1) < 0.5:
                    x2[j] = best_x + rng.normal(0, sigma, 1)
                else:
                    x2[j] = np.zeros(1)
                    x2[j] += rng.normal(0, c1 * (ub - lb), 1)
            for j in range(pop_size):
                if rng.uniform(0, 1) < 0.5:
                    x3[j] = best_x + rng.normal(0, sigma, 1)
                else:
                    x3[j] = np.zeros(1)
                    x3[j] += rng.normal(0, c1 * (ub - lb), 1)
            x2 = np.clip(x2, lb, ub)
            x3 = np.clip(x3, lb, ub)
            x = best_x + c2 * (x2 - best_x) + c2 * (x3 - best_x)
        
        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x
    
    return best_x
