def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = np.copy(x)
    best_f = func(x)

    for _ in range(budget):
        candidate = rng.uniform(lb, ub, size=dim)
        f_candidate = func(candidate)

        if f_candidate < best_f:
            best_f = f_candidate
            best_x = np.copy(candidate)

    return best_x
