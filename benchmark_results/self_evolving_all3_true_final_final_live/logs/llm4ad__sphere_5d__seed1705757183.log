def algorithm(func, dim, lb, ub, budget, rng):
    D = np.array([ub - lb] * dim)
    best = np.zeros(dim)
    best_fit = float('inf')
    
    for _ in range(budget):
        candidate = lb + (ub - lb) * rng.rand(dim)
        
        # Clip candidate to [lb, ub]
        candidate = np.clip(candidate, a_min=lb, a_max=ub)
        
        fit = func(candidate)
        
        if fit < best_fit:
            best_fit = fit
            best = candidate
            
    return best
