def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    current = 5 * (ub - lb) + rng.uniform(-1, 1, size=dim)
    best_candidate = current.copy()
    
    for _ in range(budget):
        new_candidate = current + rng.normal(size=dim)
        new_candidate = clip(new_candidate)
        
        delta = func(new_candidate) - func(current)
        
        if delta < 0 or (delta >= 0 and np.exp(-delta / (0.1 + _)) > rng.random()):
            current = new_candidate
            
            if func(current) < func(best_candidate):
                best_candidate = current.copy()
                
    return best_candidate
