def algorithm(func, dim, lb, ub, budget, rng):
    np.random.seed(rng)
    
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    iteration = 0
    
    while iteration < budget:
        x = np.clip(np.random.uniform(lb, ub, size=dim), a_min=lb, a_max=ub)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x.copy()
            
            iteration = 0
        else:
            iteration += 1
            
    return best_x
