def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = rng.uniform(lb, ub, size=(dim,))
    sigma = 1.0
    T = 10000.0
    cooling_rate = 0.99

    for _ in range(budget):
        new_D = clip(D + rng.normal(size=D.shape) * sigma)
        new_sigma = (1 - rng.uniform(0, 0.5)) ** 2 * sigma
        new_T = max(T * cooling_rate, 1e-6)

        f_new = func(new_D)
        f_old = func(D)

        if f_new < f_old:
            D = new_D
            sigma = new_sigma
        else:
            alpha = np.exp(-(f_new - f_old) / (T * rng.uniform(0, 1)))
            u = rng.uniform(0, 1)
            if u > alpha:
                D = new_D
                sigma = new_sigma

    return clip(D)
