def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = lb + (ub - lb) * rng.uniform(size=dim)
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
            
        if np.any(np.isnan(x)):
            continue
        
        x1 = lb + (ub - lb) * rng.uniform(size=dim)
        f1 = func(x1)
        
        if f1 < best_f:
            best_f = f1
            best_x = x1
            
    return best_x
