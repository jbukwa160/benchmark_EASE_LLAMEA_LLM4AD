def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_process(x, x_train, y_train, sigma_f=1e-2):
        K = np.zeros((len(x), len(x_train)))
        for i in range(len(x)):
            for j in range(len(x_train)):
                if i == j:
                    K[i, j] = 0
                else:
                    K[i, j] = np.exp(-np.sum(np.square(x[i] - x_train[j])) / (2 * sigma_f**2))
        return np.dot(K, y_train)

    def acquisition_function(x):
        mu_gp = gaussian_process(x, x_train, y_train)
        std_dev_gp = np.sqrt(np.diag(np.cov(gaussian_process(x, x_train, y_train))))
        return mu_gp - 3 * std_dev_gp

    bounds = [(lb[i], ub[i]) for i in range(dim)]
    x_init = rng.uniform(lb, ub, (dim,))
    x_train = [x_init]
    y_train = [func(x_init)]

    for _ in range(budget):
        x_best = np.argmax([acquisition_function(x) for x in x_train])
        x_new = x_train[x_best] + 0.1 * rng.normal(size=dim)
        x_train.append(np.clip(x_new, lb, ub))
        y_train.append(func(np.clip(x_new, lb, ub)))
        if func(np.array(x_train[-1])) < func(np.array(x_train[0])):
            x_train.pop(0)
            y_train.pop(0)

    res = differential_evolution(func, bounds=bounds)
    return np.array(res.x)
