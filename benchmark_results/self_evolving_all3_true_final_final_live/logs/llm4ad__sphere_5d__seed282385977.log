def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    T = 10 * (ub - lb)**2 / dim
    for _ in range(budget):
        y = x + rng.normal(size=x.shape) * 0.1
        y = np.clip(y, lb, ub)
        f_y = func(y)
        f_x = func(x)
        if f_y < f_x:
            x = y
            best_x = y
        else:
            delta = f_y - f_x
            accept_prob = np.exp(-delta / T)
            if rng.random() < accept_prob or delta == 0:
                x = y
        T *= 0.99
    return best_x
