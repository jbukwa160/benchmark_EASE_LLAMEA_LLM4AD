def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def evaluate(x):
        clipped_x = clip(x)
        return func(clipped_x)

    n_candidates = 10
    candidate_population = rng.uniform(lb, ub, size=(n_candidates, dim))

    temperature = budget * 0.1

    for _ in range(budget - 1):
        current_best = np.inf
        new_candidate_population = np.copy(candidate_population)
        
        for i in range(n_candidates):
            # Differential Evolution
            other_indices = rng.choice(range(n_candidates), size=3, replace=False)
            other_candidiates = candidate_population[other_indices]
            difference = (candidate_population[i] - other_candidiates).mean(axis=0)
            new_candidate = clip(candidate_population[i] + 1.0 * rng.uniform(-1, 1) * difference)

            # Simulated Annealing
            if rng.rand() < np.exp((evaluate(new_candidate) - evaluate(candidate_population[i])) / temperature):
                candidate_population[i] = new_candidate

        current_best = min([evaluate(candidate) for candidate in candidate_population])
        
        # Update Temperature
        temperature *= 0.99
        
        # Update Best Candidate
        best_index = np.argmin([evaluate(candidate) for candidate in candidate_population])
        if evaluate(candidate_population[best_index]) < current_best:
            current_best = evaluate(candidate_population[best_index])

    return clip(candidate_population[np.argmin([evaluate(candidate) for candidate in candidate_population])])
