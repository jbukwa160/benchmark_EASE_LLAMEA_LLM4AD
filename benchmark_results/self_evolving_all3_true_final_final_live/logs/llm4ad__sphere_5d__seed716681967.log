def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(clip(best_x))

    for _ in range(budget):
        i = rng.randint(dim)
        x = np.copy(best_x)
        x[i] += rng.uniform(-1.0, 1.0) * (ub - lb)
        x = clip(x)

        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x

    return best_x
