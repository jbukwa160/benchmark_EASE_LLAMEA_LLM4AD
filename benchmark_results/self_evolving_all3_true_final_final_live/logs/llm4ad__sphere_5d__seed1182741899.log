def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    elite_size = int(pop_size * 0.2)
    generations = budget // (dim + 1)  # one generation per dimension plus one for overall evolution
    sigma_init = 5.0
    sigma_decay_rate = 0.9

    def clip(x):
        return np.clip(x, lb, ub)

    def crossover(parent1, parent2, rng):
        child = (parent1 + parent2) / 2.0
        return child

    def mutate(child, rng):
        for i in range(dim):
            if rng.random() < 0.1:
                child[i] += rng.uniform(-sigma_init, sigma_init)
        return clip(child)

    population = np.random.uniform(lb, ub, (pop_size, dim))
    best_x = None
    best_f = float('inf')
    for _ in range(generations):
        fitness = func(population)
        for i in range(pop_size):
            if fitness[i] < best_f:
                best_f = fitness[i]
                best_x = population[i].copy()
        parents = np.argsort(fitness)[:elite_size]
        new_population = population[parents]
        for _ in range(pop_size - elite_size):
            parent1_id, parent2_id = rng.choice(pop_size, size=2, replace=False)
            child = crossover(population[parent1_id], population[parent2_id], rng)
            mutated_child = mutate(child, rng)
            new_population[-1] = mutated_child
        population = new_population.copy()
        sigma_init *= sigma_decay_rate

    return best_x
