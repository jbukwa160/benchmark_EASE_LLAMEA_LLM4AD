def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    lr = 1.0
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        new_x = x + rng.normal(size=dim) * (ub - lb) / 2
        new_f = func(new_x)

        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f

        if np.std(x - best_x) > 0.1:
            lr *= 0.9

        x += rng.normal(size=dim) * (ub - lb) / 2 * lr
        x = np.clip(x, lb, ub)

    return best_x
