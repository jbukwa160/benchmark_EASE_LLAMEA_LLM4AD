def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        f_prime = func(x)
        
        if f_prime < best_f:
            best_f = f_prime
            best_x = x.copy()

        delta = (ub - lb) * rng.uniform(-1, 1, size=dim)
        x_prime = x + delta
        
        # Clip candidates to [lb, ub]
        x_prime = np.clip(x_prime, lb, ub)

        if rng.rand() < np.exp(-(f_prime - best_f)):
            x = x_prime

    return best_x
