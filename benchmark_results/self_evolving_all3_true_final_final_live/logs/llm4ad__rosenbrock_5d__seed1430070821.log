def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.sqrt(budget))
    max_iter = int(pop_size * (budget / pop_size))

    pop = rng.uniform(lb, ub, size=(pop_size, dim))
    for _ in range(max_iter):
        new_pop = np.copy(pop)
        
        for i in range(pop_size):
            idx1, idx2, idx3 = np.random.choice(pop_size, 3, replace=False)
            
            # Apply different mutation strategies based on dimensionality
            if dim == 5:
                # For higher dimensions, use a Cauchy mutation with a larger scale parameter
                mutant = pop[idx1] + rng.standard_cauchy(size=dim) * (ub - lb) / 2
            else:
                # For lower dimensions, use a Gaussian mutation with a smaller scale parameter
                mutant = pop[idx1] + rng.normal(size=dim) * (ub - lb) / 4
            
            new_pop[i] = np.clip(mutant + rng.uniform(lb, ub), lb, ub)
        
        # Use DE/best/1/bin strategy for selection and replacement
        fit_new = func(new_pop)
        fit_old = func(pop)
        for i in range(pop_size):
            if fit_new[i] < fit_old[i]:
                pop[i] = new_pop[i]
    
    return np.min(pop, axis=0)
