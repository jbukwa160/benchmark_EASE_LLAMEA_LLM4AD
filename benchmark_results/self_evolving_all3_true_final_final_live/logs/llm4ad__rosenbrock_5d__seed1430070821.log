    best_x = np.random.uniform(lb, ub, size=(dim,))
    best_y = objective(best_x)
    
    gp = GaussianProcessRegressor(kernel=ConstantKernel(1.0) * RBF(length_scale_bounds=(1e-2, 1e+2), length_scale=np.ones(dim)),
                                  alpha=1e-6, random_state=rng)

    for i in range(budget):
        x_new = np.clip(gp.sample_f(y_best=best_y, y_optimum=None, random_state=rng).reshape(-1,), lb, ub)
        y_new = objective(x_new)
        
        if y_new < best_y:
            best_x = x_new
            best_y = y_new
            
            gp.fit(x_new.reshape(1,-1), y_new)

    return best_x
