def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.sqrt(budget))
    x_best = np.full(dim, (ub - lb) * rng.uniform(0, 1) + lb)
    f_best = func(x_best)
    
    for _ in range(pop_size):
        child = x_best.copy()
        for i in range(dim):
            if rng.random() < 0.01:
                child[i] += (ub - lb) * rng.uniform(-1, 1) + lb
            elif rng.random() < 0.02:
                child[i] = rng.uniform(lb, ub)
        
        f_child = func(child)
        if f_child < f_best:
            x_best = child
            f_best = f_child
    
    return x_best
