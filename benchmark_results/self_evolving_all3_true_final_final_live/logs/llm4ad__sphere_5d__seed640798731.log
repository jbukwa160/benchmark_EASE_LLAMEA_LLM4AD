def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = func(x)

    for i in range(1, budget+1):
        noise = (ub - lb) * rng.randn(dim)
        new_x = x + 0.5 * noise

        # Clip candidates to [lb, ub]
        new_x = np.clip(new_x, lb, ub)

        new_f = func(new_x)

        if new_f < best_f:
            best_f = new_f
            best_x = new_x.copy()

        prob_accept = 1 - (best_f - new_f) / (func(best_x + 0.01 * noise))
        accept_prob = rng.rand()
        if accept_prob > prob_accept or np.random.rand() < 0.5:
            x = new_x

    return best_x
