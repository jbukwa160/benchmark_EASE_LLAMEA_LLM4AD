def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, (1, dim))[0]
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(budget):
        z = np.zeros(dim)
        for j in range(dim):
            p1, p2, p3 = rng.choice(best_x), rng.choice(best_x), rng.choice(best_x)
            z[j] = (p1 + p2 + p3) / 3 + rng.uniform(-1, 1) * (best_x[j] - p1)
        x = clip(z)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x.copy()
            
    return best_x
