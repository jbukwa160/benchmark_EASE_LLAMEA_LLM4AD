def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    max_iter = int(budget / pop_size)
    sigma = 0.1
    mu = 0.5

    def differential_evolution(x, y):
        v = x + rng.normal(0, sigma, dim)
        f = func(v)
        return f

    def local_search(x, best_x):
        for i in range(dim):
            step_size = 0.01
            while True:
                new_x = np.copy(x)
                new_x[i] += rng.uniform(-step_size, step_size)
                if lb <= new_x[i] <= ub and func(new_x) < func(best_x):
                    x = new_x
                else:
                    break
        return x

    def adaptive_mutation(pop, best_pop):
        for i in range(pop_size):
            mu_i = max(0.01, min(mu, 1 - np.abs(np.dot(rng.normal(0, 1, dim), pop[i] - best_pop))))
            pop[i] += rng.normal(0, mu_i, dim)
        return pop

    def clip_candidates(candidates, lb, ub):
        clipped_candidates = []
        for candidate in candidates:
            clipped_candidate = np.clip(candidate, lb, ub)
            clipped_candidates.append(clipped_candidate)
        return clipped_candidates

    x = rng.uniform(lb, ub, (pop_size, dim))
    best_x = np.zeros(dim)

    for _ in range(max_iter):
        f_values = [func(x_i) for x_i in x]
        best_pop_idx = np.argmax(f_values)
        best_pop = clip_candidates([x[best_pop_idx]], lb, ub)[0]

        pop = adaptive_mutation(x, best_pop)
        pop = [local_search(candidate, best_pop) for candidate in pop]

        x = clip_candidates(pop, lb, ub)

    return np.array(best_x)
