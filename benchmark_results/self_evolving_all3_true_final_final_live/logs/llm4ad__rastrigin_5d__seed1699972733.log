def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = lb + (ub - lb) * rng.rand(dim)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
            
        # Local refinement using gradient descent
        grad = np.zeros(dim)
        for i in range(dim):
            eps = 1e-4
            x_copy = x.copy()
            x_copy[i] += eps
            grad[i] = (func(x_copy) - f) / eps
        
        step_size = 0.01
        while True:
            new_x = best_x + step_size * np.array(grad)
            new_f = func(new_x)
            
            if new_f < best_f and all(lb <= new_x <= ub):
                best_f = new_f
                best_x = new_x
                
            # Convergence check
            if np.allclose(best_x, new_x):
                break
            
            step_size *= 0.5
    
    return best_x
