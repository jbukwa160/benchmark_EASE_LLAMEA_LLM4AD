def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_f = np.inf
    for _ in range(budget):
        x = np.zeros(dim)
        while True:
            # Evaluate function at current point and get the value of f(x) 
            fx = func(x)
            
            # If the current point is better than the global best, update it
            if fx < best_f:
                best_f = fx
                best_x = x.copy()
                
            # Clip candidates to [lb, ub]
            x = np.clip(x, lb, ub)
            
            # Neighborhood selection: choose one of three neighborhoods with equal probability
            if rng.uniform(0, 1) < 0.33:
                # Neighborhood 1: Add a random perturbation
                x += rng.normal(size=dim, loc=0, scale=0.5) * (ub - lb)
                x = np.clip(x, lb, ub)
            elif rng.uniform(0, 1) < 0.66:
                # Neighborhood 2: Apply polynomial mutation
                for i in range(dim):
                    if rng.uniform(0, 1) < 0.01:
                        x[i] += (ub - lb) * rng.normal(size=1)
                        x[i] = np.clip(x[i], lb, ub)
            else:
                # Neighborhood 3: Move to a random point
                x = rng.uniform(lb, ub, size=(dim,))
        
        # Local search: perform one step of gradient descent (approximated by perturbation)
        if rng.uniform(0, 1) < 0.5 and best_f > 0:
            x += rng.normal(size=dim, loc=0, scale=0.01) * np.array(best_x - x)
    
    return best_x
