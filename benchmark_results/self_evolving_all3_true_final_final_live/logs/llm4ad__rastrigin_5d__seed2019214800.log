def algorithm(func, dim, lb, ub, budget, rng):
    def generate_population(size, dim):
        return rng.uniform(lb, ub, (size, dim))

    def clip_candidates(candidates, lb, ub):
        return np.clip(candidates, lb, ub)

    def evaluate(population):
        return [func(x) for x in population]

    def select_parents(population, fitnesses, size):
        parents = []
        indices = np.argsort(fitnesses)[:size]
        for i in indices:
            parents.append(population[i])
        return np.array(parents)

    def crossover(parent1, parent2, p_cross):
        if rng.random() < p_cross:
            idx = rng.randint(0, dim)
            child = np.copy(parent1)
            child[idx] = parent2[idx]
            return child
        else:
            return parent1

    def mutate(child, lb, ub, std_dev):
        noise = rng.normal(0, std_dev, size=dim)
        child += noise
        return clip_candidates(child, lb, ub)

    pop_size = 50
    std_dev = 1.0
    p_cross = 0.5

    population = generate_population(pop_size, dim)
    fitnesses = evaluate(population)

    for _ in range(budget):
        parents = select_parents(population, fitnesses, pop_size // 2)
        children = np.array([crossover(parents[i], parents[j], p_cross) for i in range(0, pop_size//2) for j in range(i+1, pop_size//2)])
        children = [mutate(child, lb, ub, std_dev) for child in children]
        population = np.concatenate((parents, np.array(children)))
        fitnesses = evaluate(population)

    best_idx = np.argmin(fitnesses)
    return population[best_idx]
