        for _ in range(N - 1):
            z = x_mean + sigma * np.random.multivariate_normal(np.zeros(n), cm)
            z = np.clip(z, lb, ub)
            fz = fitness(z)
            if fz < fy:
                y = z
                fy = fz
        y = (N - 1) * y / N + z / N
        y = np.clip(y, lb, ub)

        d = y - x_mean
        cm = (cm + D * np.outer(d, d)) / (i + 1)
