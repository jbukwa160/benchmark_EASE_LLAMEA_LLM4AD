def algorithm(func, dim, lb, ub, budget, rng):
    def bounds(x):
        return np.clip(x, lb, ub)

    pop_size = 50
    max_iter = int(budget / (dim * pop_size))
    step = 1.0

    x = bounds(rng.uniform(lb, ub, size=(pop_size, dim)))
    f_x = func(x)

    for i in range(max_iter):
        y = np.copy(x)
        idx = rng.permutation(pop_size)[:int(0.2*pop_size)]
        
        for j in idx:
            v = bounds(x[j] + step * (x[rng.randint(0, pop_size), :] - x[j]))
            f_v = func(v) + 10*rng.uniform(-1, 1)
            
            if f_v < f_x[j]:
                y[j] = v
                f_x[j] = f_v
                
        x = bounds(y)

    return np.min(f_x)
