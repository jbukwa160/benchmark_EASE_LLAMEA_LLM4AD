def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    D = 1e-4 * (ub - lb) ** 2
    x_mean = np.zeros(n)
    sigma = (ub - lb) / 3.0
    cm = np.eye(n) * D

    def fitness(x):
        return func(x)

    for i in range(budget):
        N = rng.randint(1, 31) + 5
        y = x_mean + sigma * np.random.multivariate_normal(np.zeros(n), cm)
        y = np.clip(y, lb, ub)
