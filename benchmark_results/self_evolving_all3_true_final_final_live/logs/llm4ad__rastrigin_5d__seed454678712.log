def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidates, lb, ub):
        return np.clip(candidates, lb, ub)

    def generate_initial_population(rng, dim, lb, ub):
        population = rng.uniform(lb, ub, size=(population_size, dim))
        return population

    def differential_evolution(population, func, dim, lb, ub, budget):
        for _ in range(budget):
            fitnesses = np.array([func(clip(x, lb, ub)) for x in population])
            for i in range(population_size):
                r1, r2, r3 = rng.choice(population_size, 3, replace=False)
                x_i = clip(population[r1] + sigma * (population[r2] - population[r3]), lb, ub)
                u_i = clip(population[i] + sigma * (x_i - population[i]), lb, ub)
                if func(clip(u_i, lb, ub)) < fitnesses[i]:
                    population[i] = u_i
        return population

    def adaptive_crossover(population):
        crossover_rates = np.linspace(0.1, 0.9, population_size // 10 + 1)
        for i in range(population_size):
            j = rng.choice(population_size, p=crossover_rates)
            x_i = clip(population[i] + crossover_rate * (population[j] - population[i]), lb, ub)
            if func(clip(x_i, lb, ub)) < func(clip(population[i], lb, ub)):
                population[i] = x_i

    def multi_start(rng, dim, lb, ub, budget):
        best_candidate = None
        best_fitness = np.inf
        for _ in range(num_restarts):
            population = generate_initial_population(rng, dim, lb, ub)
            population = differential_evolution(population, func, dim, lb, ub, budget)
            adaptive_crossover(population)
            candidate = np.mean(population, axis=0)
            fitness = func(clip(candidate, lb, ub))
            if fitness < best_fitness:
                best_candidate = clip(candidate, lb, ub)
                best_fitness = fitness
        return best_candidate

    population_size = 100
    num_restarts = 10
    sigma = 1.5
    crossover_rate = 0.75

    rng = np.random.default_rng(rng)

    best_candidate = multi_start(rng, dim, lb, ub, budget)
    return best_candidate
