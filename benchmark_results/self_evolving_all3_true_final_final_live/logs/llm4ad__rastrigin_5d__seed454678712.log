def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Differential mutation
        v = 0.5 * (x + np.random.uniform(-1, 1, size=dim))
        v = np.clip(v, lb, ub)

        # Selection and replacement
        if func(v) < best_f:
            x = v.copy()
            best_x = x.copy()
            best_f = func(x)
        else:
            # Crossover (arithmetic)
            u = 0.5 * (best_x + np.random.uniform(-1, 1, size=dim))
            u = np.clip(u, lb, ub)

            # Selection and replacement
            if func(u) < best_f:
                x = u.copy()
                best_x = x.copy()
                best_f = func(x)

    return best_x
