def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    max_iter = int(budget / pop_size)
    x_init = (ub - lb) * rng.rand(pop_size, dim) + lb
    f_val = func(x_init)

    for _ in range(max_iter):
        F = 0.5
        c1, c2 = 1, 1

        u = np.random.uniform(0, 1, (pop_size, dim))
        v = np.random.uniform(0, 1, (pop_size, dim))

        temp = x_init + F * (x_init - x_init[:, None] + c1 * (u ** 2) * (x_init[u > 0.5] - lb) + c2 * (v ** 2) * (ub - x_init[v < 0.5]))
        temp = np.clip(temp, lb, ub)

        f_temp = func(temp)
        idx = np.argsort(f_temp)[:int(pop_size / 10)]
        x_best = np.copy(x_init[idx])
        f_val[idx] = f_temp[idx]

        if budget > pop_size:
            x_init[:] = temp
            budget -= pop_size

    return x_best[0]
