def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    population_size = int(0.5 * budget)
    max_iter = budget // population_size

    x = rng.uniform(lb, ub, (population_size, dim))
    y = func(x)

    for _ in range(max_iter):
        new_x = x + 0.5 * rng.normal(size=(population_size, dim))
        new_y = func(clip(new_x))

        idx = np.argsort(y - new_y)
        x[idx[:int(population_size/2)]] = clip(new_x[idx[:int(population_size/2)]])
        y[idx[:int(population_size/2)]] = new_y[idx[:int(population_size/2)]]

    best_idx = np.argmax(np.argmin(y, axis=0))
    return x[best_idx]
