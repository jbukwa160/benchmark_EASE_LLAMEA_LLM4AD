def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    y_best = func(x_best)
    
    for i in range(budget):
        mean = (ub + lb) / 2 * np.random.rand(dim)
        sigma = np.sqrt(1.0)
        
        while True:
            x_candidate = mean + rng.randn(dim) * sigma
            x_candidate = np.clip(x_candidate, lb, ub)
            
            if func(x_candidate) < y_best or i == budget - 1:
                x_best = x_candidate
                y_best = func(x_candidate)
                break
            
            sigma *= 0.9
        
        if y_best <= y_best * 1e-5 and i > dim:
            mean = (ub + lb) / 2 * np.random.rand(dim)
            sigma = np.sqrt(1.0)
    
    return x_best
