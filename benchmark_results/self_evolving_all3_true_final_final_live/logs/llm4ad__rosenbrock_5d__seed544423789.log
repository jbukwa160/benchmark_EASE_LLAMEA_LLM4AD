def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 0.5 * (ub - lb)
    mu = (ub + lb) / 2
    lambda_ = int(np.ceil(1.65 * dim ** 3 / (dim + 3))) if dim > 4 else 10
    kappa = 1.01
    damping_factor = 0.5

    # Initialize population and best solution
    pop_size = min(lambda_, budget)
    pop = rng.uniform(lb, ub, (pop_size, dim))
    best = np.zeros(dim)

    for i in range(budget):
        # Compute fitness and select candidates
        fits = [func(ind) for ind in pop]
        indices = np.argsort(fits)[:int(pop_size / 2)]
        selected = pop[indices]

        # Update mean
        mu = (1 - kappa) * mu + kappa * rng.uniform(lb, ub, dim)

        # Compute covariance matrix and select parents
        cov_mat = sigma ** 2 * np.eye(dim)
        for ind in selected:
            cov_mat += rng.normal(0, sigma, (dim, dim))
        parents = rng.choice(selected, size=lambda_, replace=False, p=np.exp(-fits/np.sum(np.exp(-fits))))

        # Update population and select new candidates
        pop[:] = rng.normal(mu, sigma, (pop_size, dim))

        for j in range(pop_size):
            pop[j] = np.clip(pop[j], lb, ub)

        indices = np.argsort([func(ind) for ind in pop])[:int(pop_size / 2)]
        selected = pop[indices]

        # Update covariance matrix and compute new parents
        cov_mat[:] = (1 - kappa) * cov_mat + kappa * sigma ** 2 * rng.normal(0, np.eye(dim), (dim, dim))
        for ind in selected:
            cov_mat += rng.normal(0, sigma, (dim, dim))

        # Local search using gradient descent
        grad = np.zeros(dim)
        for _ in range(10):
            grad = rng.normal(0, 1, dim)
            new_x = best + grad
            new_x = np.clip(new_x, lb, ub)

            if func(new_x) < func(best):
                best = new_x

    return best
