def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.zeros(dim)
    T0 = 10.0
    alpha = 0.99
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        x_prime = x + rng.uniform(-1, 1, size=dim) * (ub - lb)
        f_prime = func(clip(x_prime))

        if f_prime < best_f:
            best_f = f_prime
            best_x = x_prime.copy()

        T = max(T0 * alpha ** i, 1e-6)

        if rng.uniform(0, 1) < np.exp((best_f - f_prime) / T):
            x = x_prime

    return best_x
