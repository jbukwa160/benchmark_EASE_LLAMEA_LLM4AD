def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    best_fx = func(x)
    
    for _ in range(budget):
        step_size = 0.1 / (_ + 1)
        new_x = x + np.clip(step_size * rng.randn(dim), -5, 5)
        
        if lb <= new_x <= ub:
            new_fx = func(new_x)
            
            if new_fx < best_fx:
                best_x = new_x
                best_fx = new_fx
                
        x = best_x
    
    return best_x
