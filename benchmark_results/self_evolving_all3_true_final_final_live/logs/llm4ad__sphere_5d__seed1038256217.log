def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    mu = 0.5 * (ub + lb)
    s = 0.1 * (ub - lb)
    
    for _ in range(budget):
        sigma = s
        x_new = x + rng.randn(dim) * sigma
        
        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, a_min=lb, a_max=ub)
        
        f_new = func(x_new)
        f_curr = func(x)
        
        if f_new < f_curr:
            x = x_new
    
    return x
