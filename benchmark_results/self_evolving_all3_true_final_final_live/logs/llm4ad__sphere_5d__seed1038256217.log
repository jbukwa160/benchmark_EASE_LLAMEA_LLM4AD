def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)
    step_size = 1.0
    sigma_decay = 0.9

    for _ in range(budget):
        y = rng.normal(size=dim)
        candidates = clip(x_best + y * step_size)

        fs = np.array([func(candidate) for candidate in candidates])

        f_avg = np.mean(fs)
        std_dev = np.std(fs)

        if f_avg < f_best:
            x_best = candidates[np.argmin(fs)]
            f_best = np.min(fs)

        step_size *= sigma_decay
    return x_best
