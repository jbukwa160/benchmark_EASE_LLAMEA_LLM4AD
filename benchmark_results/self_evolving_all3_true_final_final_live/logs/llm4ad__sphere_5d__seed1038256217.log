def algorithm(func, dim, lb, ub, budget, rng):
    def init_params():
        params = {'mu': 0.1, 'sigma': 5.0, 'stagnation_iter': 10, 
                  'pop_size': 100, 'seed': 0}
        return params

    def update_stagnation(params):
        if 'stagnation_iter' not in params:
            params['stagnation_iter'] = 10
        if budget <= params['pop_size']:
            return True
        params['stagnation_iter'] += 1
        if params['stagnation_iter'] >= 20 and params['sigma'] < 0.01:
            return True
        return False

    def sample_candidate(params, x_best):
        params['seed'] += 1
        np.random.seed(params['seed'])
        candidate = lb + (ub - lb) * np.random.rand(dim)
        return candidate

    def clip_candidate(candidate, lb, ub):
        clipped_candidate = np.clip(candidate, lb, ub)
        return clipped_candidate

    def evaluate_candidate(func, candidate):
        value = func(candidate)
        return value

    params = init_params()
    best_solution = None
    budget_remaining = budget

    for _ in range(budget):
        if update_stagnation(params):
            break
        
        x_best = np.zeros(dim)

        for _ in range(params['pop_size']):
            candidate = sample_candidate(params, x_best)
            clipped_candidate = clip_candidate(candidate, lb, ub)
            value = evaluate_candidate(func, clipped_candidate)
            if best_solution is None or value < func(best_solution):
                best_solution = clipped_candidate

    return best_solution
