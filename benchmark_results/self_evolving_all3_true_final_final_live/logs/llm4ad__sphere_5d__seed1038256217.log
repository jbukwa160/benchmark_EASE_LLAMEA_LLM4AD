def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    T = 1.0
    delta = 1e-6

    for _ in range(budget):
        new_x = x + rng.normal(size=dim) * delta
        new_x = clip(new_x)

        old_value = func(x)
        new_value = func(new_x)

        if new_value < old_value:
            x = new_x
            best_x = new_x

        T *= 0.99999  # custom cooling schedule

    return best_x
