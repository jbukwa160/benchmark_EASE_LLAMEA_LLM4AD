def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    pop_size = 10 * dim
    population = rng.uniform(lb, ub, (pop_size, dim))
    target_f = float('inf')

    for _ in range(budget):
        for i in range(pop_size):
            mutated = population[rng.randint(0, pop_size), :] + 0.1 * (population[rng.randint(0, pop_size), :] - population[rng.randint(0, pop_size), :])
            mutated = np.clip(mutated, lb, ub)
            trial = evaluate(mutated)
            if trial < target_f:
                target_f = trial
                best_individual = mutated

        for i in range(pop_size):
            mutated = population[i, :] + 0.1 * (best_individual - population[rng.randint(0, pop_size), :])
            mutated = np.clip(mutated, lb, ub)
            trial = evaluate(mutated)
            if trial < target_f:
                target_f = trial
                best_individual = mutated

        population = rng.uniform(lb, ub, (pop_size, dim))

    return best_individual
