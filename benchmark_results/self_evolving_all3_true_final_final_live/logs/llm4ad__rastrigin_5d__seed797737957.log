def algorithm(func, dim, lb, ub, budget, rng):
    pop = np.random.uniform(lb, ub, (budget, dim))
    
    for t in range(budget):
        # Evaluate fitness of all candidates
        fit = func(pop)
        
        # DE selection and mutation
        indices = np.random.choice(dim, 3, replace=False)
        mutated_pop = np.copy(pop)
        for i in range(budget):
            if rng.rand() < 0.5:
                v = pop[i] + 0.2 * (pop[i, indices[0]] - 2*pop[i, indices[1]] + pop[i, indices[2]])
                mutated_pop[i] = np.clip(v, lb, ub)
        
        # SA acceptance
        for i in range(budget):
            mutated_fit = func(mutated_pop[i])
            if rng.rand() < np.exp((fit[i] - mutated_fit) / (t + 1)):
                pop[i] = np.copy(mutated_pop[i])
    
    # Return best candidate found
    fit = func(pop)
    idx_best = np.argmin(fit)
    return np.clip(pop[idx_best], lb, ub)
