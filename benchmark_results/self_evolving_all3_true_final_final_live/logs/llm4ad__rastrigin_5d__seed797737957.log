def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x[0])

    for _ in range(budget):
        mutation_scale = 0.5
        crossover_rate = 0.9

        y = x + rng.normal(0, mutation_scale, (1, dim))

        v = clip(crossover(y, x, crossover_rate) + rng.uniform(lb, ub, (1, dim)), lb, ub)
        f = func(v[0])

        if f < best_f:
            best_x = v.copy()
            best_f = f

        T = 100.0
        alpha = 0.99

        u = clip(best_x + rng.normal(0, T, (1, dim)), lb, ub)
        fu = func(u[0])

        if np.random.rand() < np.exp((best_f - fu) / T):
            best_x = u.copy()
            best_f = fu

        x = best_x.copy()

    return best_x
