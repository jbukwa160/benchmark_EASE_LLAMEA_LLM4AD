def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(dim,))
    sigma = 1.0
    T = 10000.0
    L = 0.99
    t = 0
    best_x = x.copy()
    f_best = func(x)

    for _ in range(budget):
        if rng.uniform(0, 1) < 0.5:
            y = x + sigma * rng.normal(size=(dim,))
            y = np.clip(y, lb, ub)
            fy = func(y)
            if fy < f_best:
                f_best = fy
                best_x = y
        else:
            mu, sigma = np.mean(x), np.std(x)
            sdev = L * (ub - lb) / 2.0 + rng.uniform(0, 1)
            delta = rng.normal(size=(dim,)) * sdev
            x_new = x + delta
            x_new = np.clip(x_new, lb, ub)
            fx_new = func(x_new)
            if fx_new < f_best:
                f_best = fx_new
                best_x = x_new

        t += 1
        sigma *= L ** (t / T)

    return best_x
