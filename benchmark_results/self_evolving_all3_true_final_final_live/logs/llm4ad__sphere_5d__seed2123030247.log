def algorithm(func, dim, lb, ub, budget, rng):
    def gp_func(x, gp_model):
        mu = gp_model.predict(x)[0]
        return func(x) + mu * (1 - 1e-3)
    
    x_best = np.random.uniform(lb, ub, size=dim)
    y_best = func(x_best)

    for _ in range(budget):
        # Sample a new point
        x_new = np.clip(np.random.normal(loc=x_best, scale=0.5, size=dim), lb, ub)

        # Evaluate the function at the new point
        y_new = func(x_new)

        if y_new < y_best:
            x_best = x_new
            y_best = y_new

        # Update the GP model with the new data
        gp_model = rng.gaussian_process_update(gp_model, x_new, y_new - func(x_new))

    return np.clip(x_best, lb, ub)
