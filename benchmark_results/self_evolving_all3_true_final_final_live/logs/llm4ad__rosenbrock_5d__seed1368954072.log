def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)
    
    n_dim = len(lb)
    x_best = np.array([ub]*n_dim)
    best_f = float('inf')
    
    for _ in range(budget):
        gp_params = {'kernel': 'matern32', 'lengthscale': 1, 'noise': 0.01}
        x_new = rng.uniform(lb, ub, size=n_dim)
        
        # Sample size adaptation
        n_samples = min(int(np.sqrt(n_dim * budget)), budget // 10)
        X_gp = np.vstack([x_best.reshape(-1, dim)] + [rng.uniform(lb, ub, size=dim) for _ in range(n_samples-1)])
        y_gp = np.array([f(x_best)] + [f(rng.uniform(lb, ub, size=dim)) for _ in range(n_samples-1)])
        
        # Fit Gaussian process
        gp = {'kernel': gp_params['kernel'], 'lengthscale': gp_params['lengthscale'], 
              'noise': gp_params['noise']}
        from GPy.models import GPRegression
        m_gp = GPRegression(X_gp, y_gp, **gp)
        m_gp.optimize()
        
        # Predictive mean and variance
        mu_new, s_new = m_gp.predict(np.array([x_new]).reshape(1, -1))
        
        # Explore-exploit trade-off
        if np.random.rand() < 0.5:
            x_new = np.clip(x_new + rng.uniform(-1, 1, size=n_dim), lb, ub)
        else:
            x_new = x_best
        
        f_new = func(x_new)
        
        if f_new < best_f:
            best_f = f_new
            x_best = np.clip(x_new, lb, ub)
    
    return x_best
