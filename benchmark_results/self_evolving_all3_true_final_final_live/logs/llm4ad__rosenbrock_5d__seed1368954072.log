def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(current_best, rng=rng):
        noise = rng.normal(size=dim)
        return current_best + 0.1 * noise

    current_best = np.random.uniform(lb, ub, size=dim)
    current_best = clip(current_best)

    for _ in range(budget):
        candidate = generate_candidate(current_best, rng=rng)
        candidate = clip(candidate)

        if func(candidate) < func(current_best):
            current_best = candidate

        # Simulated annealing
        alpha = 0.9 * np.exp(-1 / (budget + 1))
        beta = np.random.uniform(0, 1)
        if beta > alpha:
            candidate = generate_candidate(current_best, rng=rng)
            candidate = clip(candidate)

        if func(candidate) < func(current_best):
            current_best = candidate

    return current_best
