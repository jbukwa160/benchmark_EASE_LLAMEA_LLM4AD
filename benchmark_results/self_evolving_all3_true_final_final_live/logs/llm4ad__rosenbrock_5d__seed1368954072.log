def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    n_dim = len(dim)
    init_x = np.array([0.5 * (ub + lb) for _ in range(n_dim)])
    best_x = init_x.copy()
    best_obj = objective(best_x)

    temperature = 1
    T_schedule = 10000

    for i in range(budget):
        # Differential evolution step
        x1, x2, x3 = best_x + rng.normal(0, 0.5, n_dim), best_x + rng.normal(0, 0.5, n_dim), best_x + rng.normal(0, 0.5, n_dim)
        x1, x2, x3 = clip(x1, lb, ub), clip(x2, lb, ub), clip(x3, lb, ub)

        # Simulated annealing step
        delta = objective(np.mean([x1, x2, x3])) - best_obj
        if delta < 0:
            best_x, best_obj = np.mean([x1, x2, x3], axis=0), objective(np.mean([x1, x2, x3]))
        elif rng.rand() < np.exp(-delta / temperature):
            best_x, best_obj = np.mean([x1, x2, x3], axis=0), objective(np.mean([x1, x2, x3]))

        temperature *= 1 - 0.01
        if temperature < 1e-6:
            break

    return best_x
