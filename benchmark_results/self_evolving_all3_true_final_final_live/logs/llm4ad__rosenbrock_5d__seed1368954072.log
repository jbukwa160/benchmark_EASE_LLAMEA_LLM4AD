def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    pop_size = 50
    n_generations = int(budget / (dim * pop_size))
    best_solution = np.array([0.5] * dim)
    best_fitness = float('inf')
    
    for generation in range(n_generations):
        population = rng.uniform(lb, ub, size=(pop_size, dim))
        
        for i in range(pop_size):
            candidate = clip(population[i])
            
            fitness = func(candidate)
            
            if fitness < best_fitness:
                best_fitness = fitness
                best_solution = candidate
                
            for j in range(dim):
                trial_candidate = np.copy(candidate)
                
                trial_candidate[j] += rng.uniform(-0.1, 0.1) * (candidate[j] - lb)
                
                trial_candidate = clip(trial_candidate)
                
                trial_fitness = func(trial_candidate)
                
                if trial_fitness < fitness:
                    candidate = trial_candidate
                    fitness = trial_fitness
                    
            population[i] = candidate
        
        mu = np.mean(population, axis=0)
        
        for i in range(pop_size):
            trial_candidate = np.copy(population[i])
            
            for j in range(dim):
                if rng.rand() < 0.5:
                    trial_candidate[j] += rng.uniform(-1, 1) * (population[i, j] - mu[j])
                    
            trial_candidate = clip(trial_candidate)
            
            trial_fitness = func(trial_candidate)
            
            if trial_fitness < fitness:
                population[i] = trial_candidate
                fitness = trial_fitness
                
    return best_solution
