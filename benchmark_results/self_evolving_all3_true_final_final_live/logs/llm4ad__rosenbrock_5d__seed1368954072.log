def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    T_init = 1e2 * (ub - lb)**dim
    T_decay = 0.99
    accept_count = 0

    for _ in range(budget):
        y = np.copy(x)
        i = rng.randint(0, dim)

        # non-uniform sampling strategy: perturb x_i with probability 1 / (i + 1)
        if rng.rand() < 1. / (i + 1):
            step_size = 0.2 * (ub - lb) * rng.randn()
            y[i] += step_size

        # clip to bounds
        y = np.clip(y, lb, ub)

        delta = func(y) - func(x)
        if delta < 0 or rng.rand() < np.exp(-delta / T_init):
            x = y
            accept_count += 1

        T_init *= T_decay

    return x
