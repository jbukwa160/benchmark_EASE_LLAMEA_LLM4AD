def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, (dim,))
    best_x = x.copy()
    best_fitness = func(x)

    adaptive_mut_rate = 0.1
    adaptive_crossover_rate = 0.5

    for i in range(budget):
        y = bound(x + rng.normal(0, 1, (dim,)))
        fitness = func(y)
        
        if fitness < best_fitness:
            best_x = y.copy()
            best_fitness = fitness
            
        mutant_prob = adaptive_mut_rate / (adaptive_mut_rate + np.exp(-i))
        crossover_prob = adaptive_crossover_rate / (adaptive_crossover_rate + np.exp(-i))

        for j in range(dim):
            if rng.random() < mutant_prob:
                y[j] = bound(y[j] + rng.uniform(-1, 1))
                
            if rng.random() < crossover_prob:
                x[j], y[j] = y[j], x[j]
        
        x = y.copy()

    return best_x
