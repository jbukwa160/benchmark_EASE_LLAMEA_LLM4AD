def algorithm(func, dim, lb, ub, budget, rng):
    D = len(dim)
    NIND = int(budget * 1e4) # number of individuals in population
    M = 10 # number of generations between temperature decrease
    T0 = 100.0 # initial temperature
    alpha = 0.99 # cooling rate

    pop = np.random.uniform(lb, ub, (NIND, D))
    pop_best = np.copy(pop)
    f_pop_best = func(pop)

    for t in range(budget):
        if t % M == 0:
            T = max(1e-6, alpha * T0) # temperature decrease
        else:
            T = T0

        # differential evolution step
        p = rng.choice(NIND, size=D, replace=False)
        x_new = pop[p[0]] + 0.5 * (pop[p[1]] - pop[p[2]]) / np.linalg.norm(pop[p[1]] - pop[p[2]])

        # clip new candidate to [lb, ub]
        x_new = np.clip(x_new, lb, ub)

        f_x_new = func(np.array([x_new]))
        if f_x_new < f_pop_best:
            pop_best = np.copy(x_new)
            f_pop_best = f_x_new
        elif rng.rand() < np.exp((f_pop_best - f_x_new) / T):
            pop_best = x_new
            f_pop_best = f_x_new

