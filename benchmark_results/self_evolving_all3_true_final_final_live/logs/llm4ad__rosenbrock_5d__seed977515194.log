            x_new = pop[p[0]] + 0.5 * (pop[p[1]] - pop[p[2]]) / np.linalg.norm(pop[p[1]] - pop[p[2]])

        # clip new candidate to [lb, ub]
        x_new = np.clip(x_new, lb, ub)

        f_x_new = func(np.array([x_new]))
        if f_x_new < f_pop_best:
            pop_best = np.copy(x_new)
