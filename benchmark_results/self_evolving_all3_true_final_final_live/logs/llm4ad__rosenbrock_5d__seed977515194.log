def algorithm(func, dim, lb, ub, budget, rng):
    def grad(x):
        return 2 * 100 * np.array([(x[i+1] - x[i]**2) * (2*x[i] + 100*(x[i+1]-x_i**2)) if i < dim-1 else -(200*x[i]*np.ones(dim)+2) for i, x_i in enumerate(x)])

    def objective(x):
        return func(np.clip(x, lb, ub))

    pop_size = int(budget * 0.7)
    x = np.random.uniform(lb, ub, (pop_size, dim))
    y_best = np.inf
    best_x = None

    for i in range(int(budget)):
        f = objective(x)
        if f < y_best:
            y_best = f
            best_x = x[np.argmin(f)]
        
        # Differential Evolution
        x_new = np.random.permutation(pop_size)
        x_dev = x[x_new] + 0.5 * rng.normal(size=(pop_size, dim))
        for j in range(dim):
            x_dev[:,j] += 0.05 * (x[:,j] - x[:,(j-1)%dim])
        
        # Gradient Descent
        xGD = x.copy()
        learning_rate = 0.01
        step = 0
        while step < 100 and np.linalg.norm(grad(xGD)) > 1e-6:
            xGD -= learning_rate * grad(xGD)
            step += 1
        
        # Selection
        mask = (objective(x_dev) < objective(x))
        x[mask] = x_dev[mask]
        x[(~mask) & (x_new == 0)] = xGD

    return np.clip(best_x, lb, ub)
