def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        # Grid search step
        x_grid = clip(x + rng * (ub - lb), lb, ub)
        f_grid = func(x_grid)
        
        # Update the current point if a better solution is found
        idx_best = np.argmin(f_grid)
        if f_grid[idx_best] < best_f:
            x = x_grid[idx_best]
            best_x = x.copy()
            best_f = f_grid[idx_best]

        # Local hill climbing step
        for i in range(dim):
            alpha = rng.uniform(-1, 1) * (ub - lb)
            new_x = clip(x + alpha * np.ones(dim), lb, ub)
            new_f = func(new_x)
            
            if new_f < best_f:
                x = new_x.copy()
                best_x = x.copy()
                best_f = new_f
                
    return best_x
