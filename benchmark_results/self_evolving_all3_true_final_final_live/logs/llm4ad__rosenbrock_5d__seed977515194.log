def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(size, dim, lb, ub):
        return rng.uniform(lb, ub, (size, dim))

    def generate_new_candidate(parent, lb, ub):
        child = parent.copy()
        for i in range(dim):
            if rng.random() < 0.5:
                child[i] += rng.normal(0, 1)
                child[i] = max(lb, min(child[i], ub))
        return child

    def evaluate_candidate(candidate, func, lb, ub):
        clipped_candidate = np.clip(candidate, lb, ub)
        return func(clipped_candidate)

    def adaptive_cooling_schedule(current_temperature, current_step, budget):
        cooling_rate = 0.95
        return max(1e-5, current_temperature * (cooling_rate ** current_step))

    initial_population_size = int(np.sqrt(budget))
    temperature = 100
    population = generate_initial_population(initial_population_size, dim, lb, ub)
    best_candidate = np.inf * rng.normal(size=dim)

    for _ in range(budget):
        new_population = []
        for candidate in population:
            new_candidate = generate_new_candidate(candidate, lb, ub)
            new_population.append(new_candidate)
        new_population = np.array(new_population)
        evaluate_new_population = [evaluate_candidate(cand, func, lb, ub) for cand in new_population]

        # Adaptive cooling schedule
        temperature *= adaptive_cooling_schedule(temperature, len(population), budget)

        # Selection and replacement
        idx = rng.choice(len(evaluate_new_population), size=len(population), replace=False, p=[1 / (e + 1) for e in evaluate_new_population])
        new_population = [new_population[i] if evaluate_new_population[idx[i]] <= evaluate_candidate(best_candidate, func, lb, ub) else best_candidate for i in range(len(population))]
        population = np.array(new_population)

        # Update best candidate
        current_best_idx = np.argmin([evaluate_candidate(cand, func, lb, ub) for cand in population])
        if evaluate_candidate(population[current_best_idx], func, lb, ub) < evaluate_candidate(best_candidate, func, lb, ub):
            best_candidate = population[current_best_idx]

    return best_candidate
