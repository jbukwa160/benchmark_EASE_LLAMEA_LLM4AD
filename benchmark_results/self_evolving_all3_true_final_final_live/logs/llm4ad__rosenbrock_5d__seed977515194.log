def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidates(mean, sigma):
        candidates = mean + rng.normal(0, 1, size=(budget, dim)) * sigma
        return np.clip(candidates, lb, ub)

    def update_sigma(sigma, best_candidate, iteration):
        if iteration == 0:
            return sigma
        improvement = (func(best_candidate) - func(mean)) / func(mean)
        sigma *= np.exp(max(0.1, min(2.4 - 0.01 * (iteration-1), 0.5 + 20 * np.abs(improvement))))
        return sigma

    def update_mean(mean, best_candidate):
        mean += 0.1 * (best_candidate - mean)
        return mean

    mean = np.array([0.5] * dim)  # initialize with a middle value
    sigma = 10.0  # initial learning rate
    iteration = 0

    while iteration < budget:
        candidates = generate_candidates(mean, sigma)
        fitnesses = func(candidates)

        best_idx = np.argmin(fitnesses)
        best_candidate = candidates[best_idx]

        if func(best_candidate) < func(mean):
            mean = update_mean(mean, best_candidate)
            sigma = update_sigma(sigma, best_candidate, iteration)
        else:
            # bounds adaptation
            for i in range(dim):
                lb[i] = max(lb[i], mean[i] - 1.5 * (best_candidate[i] - mean[i]))
                ub[i] = min(ub[i], mean[i] + 1.5 * (best_candidate[i] - mean[i]))

        iteration += candidates.shape[0]

    return best_candidate
