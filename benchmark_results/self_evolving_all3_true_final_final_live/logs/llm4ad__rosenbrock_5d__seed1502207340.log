def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = clip(rng.uniform(lb, ub, size=dim))
    f_best = func(x_best)

    for _ in range(budget - 1):
        # Differential Evolution
        x_de = clip(x_best + rng.normal(size=(dim,), scale=0.5) * (ub - lb))
        f_de = func(x_de)
        
        if f_de < f_best:
            x_best, f_best = x_de, f_de

        # Nelder-Mead Simplex Search
        simplex_size = int(np.ceil(np.power(budget / (_ + 1), 1.0 / dim)))
        simplex = np.array([clip(x_best + rng.uniform(-5, 5, size=dim)) for _ in range(simplex_size)])
        
        for i in range(1, simplex_size):
            f_i = func(simplex[i])
            
            if f_i < f_best:
                x_best, f_best = simplex[i], f_i
                
                # Update the best point in the simplex
                simplex[0] = x_best + rng.normal(size=dim) * (ub - lb)
                
                for j in range(1, i):
                    simplex[j] = 0.5 * (simplex[0] + simplex[i])
                    
    return x_best
