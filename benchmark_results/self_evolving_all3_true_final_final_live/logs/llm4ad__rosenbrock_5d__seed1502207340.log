def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    x0 = (ub - lb) * rng.uniform(size=dim) + lb
    c = 1.4
    sigma = (ub - lb) / 2.
    mu = np.zeros(dim)
    D = np.eye(dim)
    nq = 10

    for i in range(budget):
        q = np.random.multivariate_normal(mu, sigma**2 * D)
        q = np.clip(q, lb, ub)

        fx_q = f(q)
        if rng.uniform() < 0.1:
            q += (ub - lb) * rng.uniform(size=dim)

        fx_q = f(q)

        y = q + np.random.normal(size=dim, loc=0., scale=sigma / np.sqrt(i+1))
        y = np.clip(y, lb, ub)
        fy_y = f(y)

        if fy_y < fx_q:
            mu = (mu * i + y) / (i + 1)
            D *= 1. - c / (c + 1.)**2
            sigma /= np.sqrt(c + 1.)
            x0 = q

    return x0
