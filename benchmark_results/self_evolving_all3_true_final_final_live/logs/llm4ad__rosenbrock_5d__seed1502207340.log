def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x = clip(rng.uniform(lb, ub, size=dim), lb, ub)
    best_x = x.copy()
    best_f = func(x)
    hill_valley_region = np.inf

    for _ in range(budget - 1):
        noise = rng.uniform(-0.5, 0.5, size=dim)
        x_noisy = clip(x + noise, lb, ub)

        f_noisy = func(x_noisy)
        hill_valley_region_new = np.abs(best_f - f_noisy) / (1 + np.sum(np.abs(x_noisy - best_x)))

        if hill_valley_region_new > hill_valley_region:
            x = x_noisy
            hill_valley_region = hill_valley_region_new

        if f_noisy < best_f:
            best_f = f_noisy
            best_x = x_noisy

    return best_x
