def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        return func(bound(x))

    def crossover(u, v, cr):
        mask = rng.rand(dim) < cr
        u[mask] = v[mask]
        return u

    x0 = lb + (ub - lb) * rng.random((1, dim))
    best_x = x0.copy()

    for _ in range(budget):
        population_size = 50
        population = lb + (ub - lb) * rng.random((population_size, dim))

        F_adaptive = np.exp(-_ / budget)
        CR_adaptive = 0.9 - _ / budget

        for i in range(population_size):
            u_i = crossover(best_x.copy(), population[i], CR_adaptive)
            v_i = crossover(best_x.copy(), population[(i + rng.randint(1, population_size)) % population_size], CR_adaptive)

            mutation = F_adaptive * (v_i - u_i)
            child = u_i + mutation

            if evaluate(child) < evaluate(best_x):
                best_x = child

    return best_x
