def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    def cma_es(dim, lb, ub, budget, num_restarts=10, tol=1e-6, sigma_init=0.5, step_size=0.5):
        for _ in range(num_restarts):
            w = np.random.randn(dim) * 0.01
            cov = np.eye(dim)
            mu = np.zeros(dim)

            for i in range(budget // num_restarts):
                d = np.random.multivariate_normal(mu, cov) * sigma_init
                x = clip(mu + d)

                fx = evaluate(x)
                fmu = evaluate(mu)

                if fx < fmu:
                    mu = x
                    cov *= 1.0 + step_size

            if i % 100 == 0 and i != 0:
                print(f'Iteration {i}, Best fitness: {evaluate(mu)}')

        return mu, evaluate(mu)

    best_solution, best_fitness = cma_es(dim, lb, ub, budget)
    return best_solution
