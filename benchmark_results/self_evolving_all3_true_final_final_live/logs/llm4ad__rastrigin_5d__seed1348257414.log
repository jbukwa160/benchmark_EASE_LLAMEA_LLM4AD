def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(mean, std_dev):
        return mean + std_dev * rng.normal(size=dim)

    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    initial_mean = (ub - lb) / 2
    initial_std_dev = (ub - lb) / 5

    candidate = generate_candidate(initial_mean, initial_std_dev)
    best_candidate = candidate.copy()
    best_fitness = func(candidate)

    for _ in range(budget):
        std_dev *= np.exp(-0.001 * rng.uniform(0, 1))
        new_candidate = generate_candidate(best_candidate, std_dev)
        new_candidate = clip(new_candidate)
        new_fitness = func(new_candidate)

        if new_fitness < best_fitness:
            best_candidate = new_candidate
            best_fitness = new_fitness

    return best_candidate
