def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    best_solution = np.zeros(dim)
    best_value = float('inf')

    restarts = 0
    while True:
        if restarts > 10 and budget < 1000:
            break

        population_size = int(np.ceil(budget / (restarts + 1)))
        cma_sigma = (ub - lb) * rng.uniform(0.1, 1)

        solution = np.random.normal(size=dim)
        while True:
            solution = clip(solution)

            solution = solution * cma_sigma

            value = func(solution)
            if value < best_value:
                best_solution = solution
                best_value = value

            if rng.rand() > 0.1 and budget > population_size * (restarts + 1):
                new_solution = np.random.normal(size=dim) * cma_sigma
                while True:
                    new_solution = clip(new_solution)

                    new_value = func(new_solution)
                    if new_value < value:
                        solution = new_solution
                        value = new_value

            budget -= 1
            if budget == 0:
                break

        best_solution = clip(best_solution)

        if restarts > 10 or (budget == 0 and restarts <= 10):
            break

        restarts += 1

    return best_solution
