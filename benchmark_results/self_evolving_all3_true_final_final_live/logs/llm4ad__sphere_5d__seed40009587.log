    sigma = 1
    lambda_ = 32
    mu = np.zeros(dim)
    C = np.eye(dim)
    step_size = 0.5
    for i in range(budget):
        candidates = np.clip(x + norm.rvs(loc=mu, scale=sigma, size=(lambda_, dim)), lb, ub)
        fitnesses = [func(cand) for cand in candidates]
        idx = np.argsort(fitnesses)[:int(lambda_/2)]
        new_x = np.mean(candidates[idx], axis=0)
        new_sigma = sigma * 1.005
        new_mu = (1 + step_size) * new_x - step_size * mu
        new_C = C + step_size * ((new_x - mu).reshape(dim, 1) @ (new_x - mu)).T / lambda_
        
        accept_prob = np.exp(-fitnesses[idx[-1]] / sigma)
        if rng.rand() < accept_prob:
            x, sigma, mu, C = new_x, new_sigma, new_mu, new_C
    return np.clip(x, lb, ub)
