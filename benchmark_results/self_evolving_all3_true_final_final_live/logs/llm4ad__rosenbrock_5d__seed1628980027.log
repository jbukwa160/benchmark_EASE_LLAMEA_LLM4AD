def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    T = 1e6
    delta_T = 0.99

    for i in range(budget):
        new_x = clip(x + rng.normal(size=dim))
        new_f = func(new_x)

        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f

        dF = new_f - best_f
        T_new = max(1e-6, delta_T * T)
        prob_accept = np.exp(-dF / T_new)

        if rng.uniform() < prob_accept:
            x = new_x.copy()

        if i % 100 == 0:  # every 100 iterations, reduce temperature by 50%
            T *= 0.5
            delta_T = 0.99 * delta_T

    return best_x
