def algorithm(func, dim, lb, ub, budget, rng):
    def fitness(x):
        return func(x)

    x = np.random.uniform(lb, ub, size=dim)
    population_size = 10
    num_parents = int(population_size * 0.2)
    elite_count = 5

    for i in range(budget):
        pop = np.clip(np.random.normal(loc=x, scale=0.1, size=(population_size, dim)), lb, ub)
        fit_pop = [fitness(x_) for x_ in pop]

        idx_sorted = np.argsort(fit_pop)[:num_parents]
        parents = pop[idx_sorted]
        best_x = parents[np.argmin(fit_pop)][None]

        x = (1 - rng.uniform(0, 1)) * x + rng.uniform(0, 1) * (best_x[0] - x)

    return np.clip(x, lb, ub)
