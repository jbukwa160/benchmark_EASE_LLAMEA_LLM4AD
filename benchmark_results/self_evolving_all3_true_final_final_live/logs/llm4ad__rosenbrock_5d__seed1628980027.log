def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def golden_section_search(f, lower, upper, dim=1):
        c = (3 - np.sqrt(5)) / 2
        a = lower
        b = upper
        for _ in range(budget // dim):
            fa = f(clip(a * np.ones(dim)))
            fb = f(clip(b * np.ones(dim)))
            if fa < fb:
                b, a = a, (c * b + a) / (1 + c)
                yield clip((a + b) / 2)
            else:
                a, b = (c * b + a) / (1 + c), b
                yield clip((a + b) / 2)

    def simulated_annealing(f, lower, upper, dim=1):
        T = 10.0
        beta = 0.99
        x = np.random.uniform(lower, upper, size=dim)
        for _ in range(budget // (dim * 10)):
            y = np.random.normal(size=dim)
            if f(clip(x + y)) < f(clip(x)):
                x += y
            elif np.random.rand() < np.exp(-(f(clip(x + y)) - f(clip(x))) / T):
                x += y
            T *= beta

    best_x = None
    best_f = float('inf')
    for _ in range(budget // (dim * 10)):
        x = np.random.uniform(lb, ub, size=dim)
        x = clip(x)
        f_x = func(x)
        if f_x < best_f:
            best_f = f_x
            best_x = x

        golden_section_search_iter = list(golden_section_search(f=func, lower=lb, upper=ub))
        for x_gold in golden_section_search_iter:
            f_x_gold = func(x_gold)
            if f_x_gold < best_f and rng.random() > 0.1:
                best_f = f_x_gold
                best_x = x_gold

        simulated_annealing_iter = list(simulated_annealing(f=func, lower=lb, upper=ub))
        for x_sa in simulated_annealing_iter:
            f_x_sa = func(x_sa)
            if f_x_sa < best_f and rng.random() > 0.1:
                best_f = f_x_sa
                best_x = x_sa

    return best_x
