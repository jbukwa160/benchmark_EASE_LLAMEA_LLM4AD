def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    T = 100.0
    step_size = (ub - lb) / 10
    cma_sigma = (ub - lb) / 3
    cma_dim = dim

    for i in range(budget):
        if rng.random() < 0.05:
            # Simulated Annealing step
            T *= 0.99
            delta = np.random.uniform(-step_size, step_size, size=dim)
            x_new = x + delta
            x_new = np.clip(x_new, lb, ub)
            f_new = func(x_new)

            if f_new < best_f:
                best_x = x_new.copy()
                best_f = f_new

        else:
            # CMA-ES step
            x += rng.normal(0, cma_sigma, size=dim)
            x = np.clip(x, lb, ub)
            f = func(x)

            if f < best_f:
                best_x = x.copy()
                best_f = f

    return best_x
