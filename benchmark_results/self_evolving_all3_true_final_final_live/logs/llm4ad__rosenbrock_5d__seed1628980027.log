def algorithm(func, dim, lb, ub, budget, rng):
    def func_with_bounds(x):
        return func(np.clip(x, lb, ub))

    def cma_es(dim, lb, ub, budget):
        sigma = 1.0
        mu = np.zeros(dim)
        cmu = np.eye(dim) * sigma**2

        for _ in range(budget):
            n_candidates = 100
            candidates = mu + rng.normal(0, sigma, (n_candidates, dim))

            scores = [func_with_bounds(candidate) for candidate in candidates]

            idx = np.argsort(scores)[:3]
            new_mu = np.mean(candidates[idx], axis=0)
            new_cmu = np.zeros((dim, dim))
            for i in range(dim):
                for j in range(i+1):
                    diff = candidates[idx[i]][j] - candidates[idx[j]][i]
                    new_cmu[i][j] = np.mean(diff**2)

            lambda_ = 0.5 * (np.sum(new_cmu) / sigma**2)
            cmu += lambda_ * (new_cmu - cmu)

            mu, cmu = new_mu, new_cmu
            sigma *= 1 + 1e-6

        return mu

    def mutate(x):
        for i in range(dim):
            if rng.random() < 0.01:
                x[i] += rng.normal(0, 2)
                x[i] = max(lb, min(ub, x[i]))

        return x

    best_x = cma_es(dim, lb, ub, budget // 5 * 3)

    for _ in range(budget - (budget // 5 * 3)):
        new_best_x = mutate(best_x)
        if func_with_bounds(new_best_x) < func_with_bounds(best_x):
            best_x = new_best_x

    return best_x
