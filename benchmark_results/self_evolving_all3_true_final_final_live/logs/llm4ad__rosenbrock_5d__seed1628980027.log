def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def objective(x):
        return func(x)

    population_size = 50
    x0 = np.random.uniform(lb, ub, (population_size, dim))

    for _ in range(budget // population_size):
        fitness = np.array([objective(clip(x)) for x in x0])

        F = 0.9  # scaling factor for differential evolution
        CR = 1 / dim  # crossover rate

        y = np.copy(x0)
        for i in range(population_size):
            j, k = rng.choice(population_size, size=2, replace=False)

            u = x0[j] + F * (x0[k] - x0[j])
            v = x0[j]

            for d in range(dim):
                if rng.uniform(0, 1) < CR or u[d] > x0[j][d]:
                    v[d] = np.clip(u[d], lb, ub)

            y[i] = v

        fitness_y = np.array([objective(clip(yi)) for yi in y])

        idx = np.argsort(fitness)[::-1]
        x0 = clip(y[idx[:population_size]])

    best_idx = np.argmin(np.array([objective(clip(x)) for x in x0]))
    return x0[best_idx]
