def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def adapt_CMA(x, y, x_best, pop):
        mu = 1 / len(pop)
        sigma = 0.1
        cov = np.zeros((dim, dim))
        for i in range(len(pop)):
            x_i = clip(pop[i])
            delta_x = x_i - x
            cov += (delta_x.reshape(-1, 1) * delta_x).reshape(1, -1)
        cov *= mu
        return sigma, np.linalg.inv(cov)

    def restart_CMA(x_best, pop):
        new_x = x_best + rng.randn(dim)
        return clip(new_x), adapt_CMA(new_x, x_best, x_best, pop)

    x = rng.uniform(lb, ub, size=dim)
    pop = [x]
    best_x = x
    budget_used = 0

    while budget_used < budget:
        sigma, cov_inv = adapt_CMA(x, x, best_x, pop)
        new_pop = []
        for _ in range(len(pop)):
            z = rng.randn(dim)
            x_new = x + sigma * np.dot(cov_inv, z)
            new_pop.append(clip(x_new))
        new_best_x = min(new_pop, key=func)

        if func(new_best_x) < func(best_x):
            best_x = new_best_x

        pop.extend(new_pop)
        budget_used += len(pop)

        if len(pop) > 1000:
            x_restart, (sigma, cov_inv) = restart_CMA(best_x, pop[:100])
            budget_used -= len(pop) - 100
            pop = [x_restart]
            x = x_restart

    return best_x
