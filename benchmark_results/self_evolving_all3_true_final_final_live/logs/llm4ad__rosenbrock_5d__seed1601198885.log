def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return func(x)

    class CovarianceMatrixAdaptation:
        def __init__(self, n_dim, lower_bound, upper_bound, learning_rate=0.01, noise_covar=1e-6):
            self.n_dim = n_dim
            self.lower_bound = np.repeat(lower_bound, n_dim)
            self.upper_bound = np.repeat(upper_bound, n_dim)
            self.learning_rate = learning_rate
            self.noise_covar = noise_covar
            self.pca = None

        def generate_sample(self):
            if self.pca is not None:
                sample = np.random.normal(size=self.n_dim) * np.sqrt(np.diag(self.pca['covar']))
                sample = self.lower_bound + (self.upper_bound - self.lower_bound) * sample
                return self.pca['rotation'].dot(sample)
            else:
                return np.random.uniform(low=self.lower_bound, high=self.upper_bound, size=self.n_dim)

        def update(self, sample, fitness):
            if self.pca is None and budget > 1:
                self.pca = {'covar': np.cov(np.array([self.generate_sample() for _ in range(200)]).T), 'rotation': np.eye(self.n_dim)}

            mean = (sample + self.lower_bound) / 2
            sigma = max(0.01, np.sqrt(np.mean((np.abs(sample - self.pca['rotation'].dot(mean)) ** 2))))
            covar = self.noise_covar * sigma

            if fitness < Rosenbrock(self.lower_bound):
                self.learning_rate *= 1.5
            else:
                self.learning_rate /= 1.5

            return mean, covar, self.learning_rate

        def step(self, sample, fitness):
            mean, covar, learning_rate = self.update(sample, fitness)
            noise = np.random.normal(size=self.n_dim) * np.sqrt(covar)
            new_sample = mean + noise
            new_sample = self.lower_bound + (self.upper_bound - self.lower_bound) * new_sample

            if self.pca is not None:
                new_sample = self.pca['rotation'].dot(new_sample)

            return new_sample, learning_rate

    cma_es = CovarianceMatrixAdaptation(dim, lb, ub)
    x_best = np.random.uniform(low=lb, high=ub, size=dim)
    best_fitness = Rosenbrock(x_best)

    for i in range(budget):
        sample = cma_es.generate_sample()
        fitness = Rosenbrock(sample)
        if fitness < best_fitness:
            best_fitness = fitness
            x_best = sample

        next_sample, learning_rate = cma_es.step(sample, fitness)
        sample = next_sample

    return np.clip(x_best, a_min=lb, a_max=ub)
