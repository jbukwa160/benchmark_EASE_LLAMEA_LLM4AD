def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    def clipToBounds(candidate):
        clipped_candidate = np.clip(candidate, a_min=lb, a_max=ub)
        return clipped_candidate

    def sampleCandidate(budget_left):
        candidate = 0.5 * (ub + lb) + rng.uniform(-1, 1) * (ub - lb)
        candidate = clipToBounds(candidate)
        return candidate

    def mutate(candidate, budget_left):
        mutation_step = 0.01
        mutated_candidate = candidate + rng.uniform(-mutation_step, mutation_step) * np.ones(dim)
        mutated_candidate = clipToBounds(mutated_candidate)
        return mutated_candidate

    def bayesianOptimization(dim, lb, ub, func, budget):
        from scipy.optimize import DifferentialEvolution
        bounds = [(lb, ub) for _ in range(dim)]
        result = DifferentialEvolution(func, bounds, maxiter=budget, popsize=10).result
        return result.x

    def evolutionaryAlgorithm(pop_size, dim, lb, ub, func, budget):
        from deap import base
        from deap import creator
        from deap import tools
        creator.createIndividual = lambda: np.random.uniform(lb, ub, size=dim)
        creator.createFitnessMulti = None
        toolbox = base.Toolbox()
        toolbox.register("individual", creator.Individual, n=1, fitness=creator.FitnessMinimized(cost, 0))
        toolbox.register("population", tools.initRepeat, list, toolbox.individual)

        def cost(individual):
            return func(individual)

        def evaluate(individual):
            fitness = (cost(individual),)
            return fitness

        def select(population):
            offspring = tools.selBest(population, k=1)[0]
            return offspring

        population = toolbox.population(n=pop_size)
        for generation in range(budget):
            for individual in population:
                individual.fitness.values = evaluate(individual)
            offspring = toolbox.clone(population)
            toolbox.select(offspring, k=len(offspring))
            for i in range(len(offspring)):
                if rng.random() < 0.1:
                    mutated_offspring = mutate(offspring[i], budget - generation - 1)
                    offspring[i] = mutated_offspring
        return select(population)

    def hybridAlgorithm(dim, lb, ub, func, budget):
        best_candidate = sampleCandidate(budget)
        for iteration in range(1, budget + 1):
            bayes_result = bayesianOptimization(dim, lb, ub, func, budget - iteration)
            evol_result = evolutionaryAlgorithm(pop_size=10, dim=dim, lb=lb, ub=ub, func=func, budget=budget - iteration)
            if rng.random() < 0.5:
                best_candidate = bayes_result
            else:
                best_candidate = evol_result
        return best_candidate

    return hybridAlgorithm(dim, lb, ub, objective, budget)
