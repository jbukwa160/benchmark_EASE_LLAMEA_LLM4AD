def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    x = rng.uniform(lb, ub, size=dim)
    T = 1000.0
    alpha = 0.99
    t = 0

    while t < budget:
        x_new = x + rng.normal(size=dim) / np.sqrt(t + 1)
        x_new = clip(x_new)
        f_new = func(x_new)

        if f_new <= func(x):
            x = x_new
        else:
            delta = func(x) - f_new
            p = np.exp(-delta / T)
            if rng.uniform(0, 1) < p:
                x = x_new

        T *= alpha
        t += 1

    return x
