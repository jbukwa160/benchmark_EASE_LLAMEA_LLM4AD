def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    D = dim
    n_params = 1.0 / (D * np.sum(rng.uniform(size=D)))
    mean = rng.uniform(lb, ub, size=dim)
    sigma = np.abs(ub - lb) * 0.5

    best_x = mean.copy()
    best_y = f(best_x)

    for _ in range(budget):
        offspring = np.random.multivariate_normal(mean, np.eye(dim) * (sigma**2))
        y_offspring = f(offspring)
        if y_offspring < best_y:
            best_x = offspring
            best_y = y_offspring

        if np.random.rand() < n_params:
            sigma *= 1.01 - 0.5 / (_ + 1)
        else:
            sigma *= 0.99 + 0.1 / (_ + 1)

        mean += (offspring - mean) * 0.8
        for i in range(dim):
            if np.random.rand() < 0.2:
                mean[i] = lb + rng.uniform(0, ub - lb)
                sigma *= 0.9

    return best_x.clip(lb, ub)
