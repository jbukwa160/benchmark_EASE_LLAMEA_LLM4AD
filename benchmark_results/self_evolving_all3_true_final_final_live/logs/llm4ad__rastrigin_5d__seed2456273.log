def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    D = len(dim)
    x0 = (ub - lb) * rng.rand(D) + lb
    sigma = 1.0
    best_x = x0.copy()
    best_f = objective(best_x)
    n_iter = 0

    while n_iter < budget:
        for _ in range(10):  # inner loop to adaptively adjust step size
            x_new = best_x + np.random.normal(size=D, scale=sigma)
            x_new = np.clip(x_new, lb, ub)

            f_new = objective(x_new)

            if f_new < best_f:
                best_x = x_new.copy()
                best_f = f_new

        sigma *= 0.99
        n_iter += 1

    return best_x
