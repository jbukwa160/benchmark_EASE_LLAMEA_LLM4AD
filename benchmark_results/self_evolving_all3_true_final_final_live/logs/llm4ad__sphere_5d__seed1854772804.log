def algorithm(func, dim, lb, ub, budget, rng):
    if isinstance(rng, int):
        seed = rng
        rng = np.random.default_rng(seed)
    else:
        rng = rng.bit_generator
    
    x_best = np.full(dim, (ub - lb) / 2 + lb)
    f_best = func(x_best)
    
    for _ in range(budget):
        x_candidate = rng.uniform(lb, ub, size=dim)
        
        if func(x_candidate) < f_best:
            x_best = x_candidate
            f_best = func(x_candidate)
        
        # Early stopping criterion: number of evaluations allowed
        if (_ + 1) * dim >= budget and np.all(x_candidate == x_best):
            break
    
    return x_best
