def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def sample(rng, dim):
        return rng.uniform(lb, ub, size=dim)

    population_size = 50
    mutation_covariance_matrix = np.eye(dim)
    best_solution = None

    for _ in range(budget):
        samples = [clip(sample(rng, dim)) for _ in range(population_size)]
        fitnesses = [func(x) for x in samples]

        if all(f == 0.0 for f in fitnesses):
            return np.array([x for x in samples][0])

        if best_solution is None or min(fitnesses) < func(best_solution):
            best_solution = np.argmin(fitnesses)

        selected_indices = np.argsort(fitnesses)[:population_size // 2]
        selected_samples = [samples[i] for i in selected_indices]

        delta = np.array([x - samples[np.argmin(fitnesses)] for x in selected_samples])
        cov_update = np.dot(delta.T, delta) / population_size
        mutation_covariance_matrix += cov_update

    return samples[best_solution]
