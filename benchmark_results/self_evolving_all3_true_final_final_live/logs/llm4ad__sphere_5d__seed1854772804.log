def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    t = 1.0
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        y = clip(x + rng.uniform(-ub, ub, size=dim))
        f_y = func(y)
        
        if f_y < best_f:
            x = y
            best_x = y.copy()
            best_f = f_y
            
        elif np.random.rand() < np.exp((best_f - f_y) / t):
            x = y
            
        t *= 0.99
        
    return best_x
