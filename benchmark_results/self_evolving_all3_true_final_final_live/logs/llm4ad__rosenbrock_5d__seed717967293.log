def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    for i in range(budget):
        n_points = 1
        while n_points <= dim:
            x = clip(rng.uniform(lb, ub, size=(n_points, dim)))
            f = np.array([func(xi) for xi in x])
            idx = np.argmin(f)
            if f[idx] < f_best:
                x_best = x[idx]
                f_best = f[idx]

            n_points *= 2

    return x_best
