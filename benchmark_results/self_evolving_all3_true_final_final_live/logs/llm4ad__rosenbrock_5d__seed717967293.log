def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    
    best_x = None
    best_f = float('inf')
    
    learning_rate = 0.1
    
    while True:
        fx = func(x)
        
        if fx < best_f or budget == 0:
            best_f = fx
            best_x = x.copy()
            
        if np.any(np.isnan(x)) or not np.all((lb <= x) & (x <= ub)):
            x = np.clip(x, lb, ub)
        
        for i in range(dim):
            dx = np.zeros(dim)
            dx[i] = 1
            
            fxp = func(x + learning_rate * dx)
            fxm = func(x - learning_rate * dx)
            
            if fxp < fx and x + learning_rate * dx <= ub:
                x += learning_rate * dx
            elif fxm < fx and x - learning_rate * dx >= lb:
                x -= learning_rate * dx
        
        budget -= dim
        
        if best_f == 0 or budget == 0:
            return best_x
        
        # adaptive learning rate
        for i in range(dim):
            dx = np.zeros(dim)
            dx[i] = 1
            
            fxp = func(x + learning_rate * dx)
            
            if fxp < fx and x + learning_rate * dx <= ub:
                learning_rate *= 0.9
                
    return best_x
