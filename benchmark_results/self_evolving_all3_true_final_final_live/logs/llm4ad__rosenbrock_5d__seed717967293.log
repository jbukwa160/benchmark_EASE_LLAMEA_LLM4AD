def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    min_value = func(x)
    budget_used = 0

    sigma = 2.0
    T = 10000

    while budget_used < budget:
        for _ in range(int(budget / dim)):
            new_x = clip(x + np.random.uniform(-sigma, sigma, size=dim))
            new_value = func(new_x)

            if new_value < min_value:
                min_value = new_value
                best_x = new_x

            p = rng.uniform(0, 1)
            delta = new_value - min_value

            if delta <= 0 or np.exp(-delta / T) >= p:
                x = new_x

        sigma *= 0.99
        T -= 100

    return best_x
