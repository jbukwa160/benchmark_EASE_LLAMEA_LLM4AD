def algorithm(func, dim, lb, ub, budget, rng):
    def obj(x):
        return func(x)

    pop_size = 50
    D = dim
    G = budget // pop_size
    bounds = [(lb, ub) for _ in range(D)]
    x0 = rng.uniform(lb, ub, size=(pop_size, D))

    for g in range(G):
        y = np.array([x0[np.random.randint(0, pop_size), :] for _ in range(pop_size)])
        z = np.array([x0[np.random.randint(0, pop_size), :] for _ in range(pop_size)])

        for i in range(pop_size):
            v1 = rng.uniform(lb, ub)
            v2 = rng.uniform(lb, ub)
            y[i] += v1 * (z[i] - x0[i])
            z[i] += v2 * (y[i] - x0[i])

        F = 0.5
        CR = 0.9

        for i in range(pop_size):
            r1, r2, r3 = np.random.choice(range(pop_size), size=3, replace=False)
            if rng.rand() < CR or obj(y[i]) < obj(x0[r1]):
                x0[i] += F * (y[i] - x0[i])
            if rng.rand() < CR or obj(z[i]) < obj(x0[r2]):
                x0[r2] += F * (z[i] - x0[r2])

        for i in range(pop_size):
            if np.any(np.array([x0[i, j] <= bounds[j][0] or x0[i, j] >= bounds[j][1] for j in range(D)])):
                x0[i] = rng.uniform(bounds[0][0], bounds[0][1], size=D)

    return np.min(x0, axis=0)
