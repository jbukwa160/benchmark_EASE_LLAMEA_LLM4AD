def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(mean, sigma):
        return mean + sigma * rng.normal(size=dim)

    def evaluate(candidate):
        candidate = clip(candidate)
        return func(candidate)

    best_solution = None
    best_fitness = float('inf')
    step_size = 1.0

    for iteration in range(budget):
        population_size = int(np.sqrt(dim) * 10)
        mean = np.random.uniform(lb, ub, size=dim)
        candidates = [generate_candidate(mean, step_size) for _ in range(population_size)]

        fitnesses = [evaluate(candidate) for candidate in candidates]

        sorted_indices = np.argsort(fitnesses)
        top_candidates = [candidates[i] for i in sorted_indices[:population_size]]

        mean = np.mean([candidate for candidate in top_candidates], axis=0)

        if iteration > 1 and best_fitness - fitnesses[sorted_indices[0]] < 1e-6:
            step_size *= 0.9
        else:
            step_size *= 1.01

        if evaluate(mean) < best_fitness:
            best_solution = mean
            best_fitness = evaluate(mean)

    return best_solution
