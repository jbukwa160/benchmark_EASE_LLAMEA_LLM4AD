def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def differential_evolution(pop_size=50, crossover_prob=0.5, mutation_factor=0.1, temperature=1000):
        x = rng.uniform(lb, ub, (pop_size, dim))
        best_x = x[np.argmin([func(clip(x_i)) for x_i in x])]

        for i in range(budget - 1):
            trial_pop = np.zeros_like(x)
            for j in range(pop_size):
                parent_idx = rng.choice(pop_size, size=3, replace=False)
                crossover_mask = rng.uniform(size=dim) < crossover_prob
                trial_pop[j] = mutation_factor * (x[parent_idx[0]] - x[parent_idx[1]]) + clip(x[parent_idx[2]])
                if rng.uniform() < 0.5:
                    trial_pop[j, crossover_mask] = x[parent_idx[0], crossover_mask]
                else:
                    trial_pop[j, crossover_mask] = x[parent_idx[2], crossover_mask]

            trial_pop = np.clip(trial_pop, lb, ub)
            trial_fitness = [func(clip(x_i)) for x_i in trial_pop]
            idx = np.argmin(trial_fitness)

            if trial_fitness[idx] < func(best_x):
                best_x = trial_pop[idx]

        return best_x

    def simulated_annealing(init_temp=1000, cooling_rate=0.99, num_steps=10):
        x = rng.uniform(lb, ub, (1, dim))
        best_x = clip(x[0])

        for _ in range(num_steps):
            new_x = rng.uniform(lb, ub, size=dim)
            delta = func(clip(new_x)) - func(best_x)

            if delta < 0 or np.random.rand() < np.exp(-delta / init_temp):
                best_x = clip(new_x)

            init_temp *= cooling_rate

        return best_x

    pop_size = int(np.sqrt(budget))
    x = differential_evolution(pop_size=pop_size)
    x = simulated_annealing(num_steps=int((budget - 1) // pop_size))

    return clip(x)
