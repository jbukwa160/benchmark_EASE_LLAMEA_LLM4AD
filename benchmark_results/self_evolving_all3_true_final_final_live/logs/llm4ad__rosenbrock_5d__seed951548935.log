def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    cov = np.eye(dim)
    mean = x.copy()
    step_size = 0.1
    count = 0
    best_x = x.copy()

    while count < budget:
        for i in range(dim):
            new_mean = mean.copy()
            new_mean[i] += np.random.normal(0, step_size, size=1)

            # Clip to bounds
            new_mean = np.clip(new_mean, lb, ub)

            new_x = func(new_mean) + rng.random()
            new_x = np.clip(new_x, 0, 1e10)  # Prevent overflow

            if new_x < func(mean):
                mean[i] = new_mean[i]
                x[i] = new_mean[i]
                best_x[i] = new_mean[i]

        cov = 0.9 * cov + 0.1 * np.dot((mean - best_x).reshape(-1, 1), (mean - best_x).reshape(1, -1))
        step_size *= 0.999

        count += 1

    return best_x
