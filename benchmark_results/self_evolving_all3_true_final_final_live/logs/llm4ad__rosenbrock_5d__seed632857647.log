def algorithm(func, dim, lb, ub, budget, rng):
    def wrapper(x):
        return func(x)

    x0 = rng.uniform(lb, ub, size=dim)
    bounds = [(lb, ub) for _ in range(dim)]
    
    res_cmaes = minimize(wrapper, x0, method="SLSQP", bounds=bounds, options={'maxfun': budget})
    
    def crossover(u, v):
        f1, f2 = np.random.choice([True, False], size=2)
        if f1:
            u[dim-1] = v[dim-1]
        if f2:
            u[-1] = v[-1]
        return u
    
    for i in range(dim-1):
        x1 = rng.uniform(lb, ub, size=dim)
        x2 = rng.uniform(lb, ub, size=dim)
        
        for _ in range(budget - 100 * dim):
            x_new = (x0 + crossover(x1, x2)) / 2
            x_new = np.clip(x_new, lb, ub)
            res_de = wrapper(x_new)
            
            if res_de < wrapper(x0):
                x0 = x_new
    
    return x0
