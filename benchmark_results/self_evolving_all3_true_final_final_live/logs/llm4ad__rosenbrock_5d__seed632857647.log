def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    mu = 1.0 / dim
    c_m = (4 + 2/dim) ** 2
    c_c = (4 + 2/dim) * (4 + 2/dim + 2)

    def cma_step(x):
        f_x = func(x)
        y = x + mu*rng.normal(size=dim)
        f_y = func(y)
        if f_y < f_x:
            x = y
            f_x = f_y
        D = (y - x) / 2 + mu * rng.normal(size=(dim, dim))
        C_new = c_m*D@D.T + c_c*np.eye(dim)
        return f_x, C_new

    best_x = x.copy()
    best_f_x = func(x)

    for _ in range(budget):
        f_x, C_new = cma_step(best_x)
        if f_x < best_f_x:
            best_f_x = f_x
            best_x = best_x + np.sqrt(C_new)@rng.normal(size=dim)
        else:
            C_new = 0.5 * (C_new + np.eye(dim))

    return best_x
