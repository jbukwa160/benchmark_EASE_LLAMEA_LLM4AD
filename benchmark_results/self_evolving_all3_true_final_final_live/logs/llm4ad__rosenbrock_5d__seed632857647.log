def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = 10
    candidates = rng.uniform(lb, ub, (pop_size, dim))
    scores = np.zeros(pop_size)
    best_candidate = None

    for _ in range(budget):
        if best_candidate is not None:
            candidates[rng.randint(0, pop_size)] = clip(best_candidate)

        for i in range(pop_size):
            a = rng.randint(0, pop_size)
            b = rng.randint(0, pop_size)
            c = rng.randint(0, pop_size)
            while (a == i or b == i or c == i):
                a = rng.randint(0, pop_size)
                b = rng.randint(0, pop_size)
                c = rng.randint(0, pop_size)

            candidate = clip(candidates[a] + 0.5 * rng.normal(0, 1) * (candidates[b] - candidates[c]))
            score = func(candidate)

            if best_candidate is None or score < scores[i]:
                best_candidate = candidate
                scores[i] = score
            elif score < scores[i]:
                candidates[i] = clip(candidate)
                scores[i] = score

    return best_candidate
