def algorithm(func, dim, lb, ub, budget, rng):
    x_best = 0.5 * (lb + ub) + rng.normal(size=dim) * (ub - lb)
    for _ in range(budget):
        x_candidate = x_best + rng.normal(size=dim) * 0.1 * (ub - lb)
        x_candidate = np.clip(x_candidate, lb, ub)
        f_candidate = func(x_candidate)
        if f_candidate < func(x_best):
            x_best = x_candidate
    return x_best
