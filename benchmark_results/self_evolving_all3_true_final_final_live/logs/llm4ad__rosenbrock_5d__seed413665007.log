def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    n = len(lb)
    x_best = np.full(n, 0.5 * (lb + ub))
    f_best = func(clip(x_best))

    def lhs_sampling(num_samples, dim):
        samples = []
        for _ in range(num_samples):
            sample = rng.uniform(lb, ub, size=dim)
            samples.append(sample)
        return np.array(samples)

    def sa_search(current_x, current_f, max_iter, T_init, alpha):
        x_current = clip(current_x)
        f_current = func(x_current)

        for _ in range(max_iter):
            x_new = clip(rng.normal(x_current, 0.1 * (ub - lb), size=dim))
            f_new = func(x_new)
            delta_f = f_new - f_current

            if delta_f < 0:
                x_current = x_new
                f_current = f_new
            elif rng.uniform(0, 1) < np.exp(-delta_f / T_init):
                x_current = x_new
                f_current = f_new
            else:
                T_init *= alpha

        return x_current, f_current

    samples = lhs_sampling(budget // 10, dim)
    for i in range(len(samples)):
        sample_i = samples[i]
        x_best, _ = sa_search(sample_i, np.inf, budget // 10, 1.0, 0.99)
        f_best = min(f_best, func(clip(x_best)))

    return clip(x_best)
