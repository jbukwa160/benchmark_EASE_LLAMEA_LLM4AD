def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        new_x = x.copy() if rng.rand() < 0.1 else (ub - lb) * rng.randn(dim) + lb
        new_f = func(new_x)
        
        if new_f < best_f:
            best_f = new_f
            best_x = new_x
            
        for i in range(dim):
            delta = np.zeros(dim)
            delta[i] = 0.1 * (new_x[i] - x[i])
            
            candidate = x.copy()
            candidate[i] += delta[i]
            candidate = np.clip(candidate, lb, ub)
            
            candidate_f = func(candidate)
            
            if candidate_f < best_f:
                best_f = candidate_f
                best_x = candidate
                
        x = best_x
    
    return best_x
