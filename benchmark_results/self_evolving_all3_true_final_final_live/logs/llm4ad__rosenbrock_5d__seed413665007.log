def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 0.1
    ngen = int(budget)
    mu, cmu, pc, xmean, dv, d, lambda_, delta, lbd, cc, dcovar = [0] * dim, np.eye(dim), 1, np.zeros(dim), np.zeros((dim, dim)), 0, 2, 0.1, 1e-300, np.eye(dim), 0
    x = rng.uniform(lb, ub, (1, dim))
    
    for i in range(ngen):
        y = func(x)
        
        if y < dv:
            dv = y
            d = i
        
        cc += 1
        dcovar = np.eye(dim) * 0.2 / cc + cmu * delta / (cc + 1)
        
        z, sigma_new = [], []
        for j in range(lambda_):
            z.append(rng.normal(xmean, sigma))
            sigma_new.append(np.sqrt(sigma**2 + lbd * np.dot(z[j], dcovar @ z[j])))
            
        z = [xi / sigma_new[i] for i, xi in enumerate(z)]
        cmu = (cmu * delta + 0.1 * lambda_ * lbd * np.outer(xmean - mu, xmean - mu)) / (cc + 1)
        
        if cc < 20:
            lbd *= 2
        else:
            lbd /= 2
        
        for j in range(lambda_):
            z[j] = np.clip(z[j], lb, ub)
            
        y_new = func(np.array(z))
        
        if rng.random() > 0.1 and cc < 50:
            y, d = y_new, i
            xmean, mu, cmu, delta = z[j], z[j], dcovar, 2
        
    return np.clip(xmean, lb, ub)
