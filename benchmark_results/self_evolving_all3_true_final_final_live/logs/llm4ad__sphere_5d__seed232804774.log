def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    elite_size = 5
    mut_rate = 0.01
    generations = int(budget / (pop_size * dim))
    
    def clip(x):
        return np.clip(x, lb, ub)
    
    def mutate(x):
        if random.random() < mut_rate:
            for i in range(dim):
                x[i] += rng.uniform(-1, 1) * 0.5
                x[i] = clip(x)[i]
        return x
    
    pop = np.array([rng.uniform(lb, ub, dim) for _ in range(pop_size)])
    
    for gen in range(generations):
        fitness = [func(ind) for ind in pop]
        
        # Selection with replacement
        selected_idx = []
        while len(selected_idx) < pop_size:
            idx1, idx2 = random.randint(0, pop_size - 1), random.randint(0, pop_size - 1)
            if fitness[idx1] < fitness[idx2]:
                selected_idx.append(idx1)
            else:
                selected_idx.append(idx2)
        
        new_pop = np.array([pop[i] for i in selected_idx])
        new_fitness = [fitness[i] for i in selected_idx]
        
        # Elitism
        sorted_indices = sorted(range(pop_size), key=lambda i: fitness[i], reverse=True)[:elite_size]
        new_pop[:elite_size, :] = pop[sorted_indices]
        new_fitness[:elite_size] = fitness[sorted_indices]
        
        # Mutation
        for i in range(elite_size, pop_size):
            new_pop[i] = mutate(new_pop[i])
        
        pop, fitness = new_pop, new_fitness
    
    min_idx = np.argmin(fitness)
    return clip(pop[min_idx])
