def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 1000.0
    alpha = 0.9
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = x + (rng.rand(dim) - 0.5) * 2 * np.log(1 + rng.rand())
        y = np.clip(y, lb, ub)
        f_y = func(y)
        
        if f_y < best_f:
            best_x = y.copy()
            best_f = f_y
        elif rng.rand() < np.exp((best_f - f_y) / T):
            x = y.copy()

        if _ % (budget // 10) == 0: # every 1/10 of the budget
            T *= alpha

    return best_x
