def algorithm(func, dim, lb, ub, budget, rng):
    x = 5 * (ub - lb) * rng.rand(dim)
    T0 = 1.0
    alpha = 0.99
    step_size = 0.2
    
    for t in range(budget):
        y = np.clip(x + rng.randn(dim) * step_size, lb, ub)
        
        if func(y) < func(x):
            x = y
        else:
            delta = func(y) - func(x)
            T = max(T0 * alpha**t, 1e-3)
            
            if rng.rand() < np.exp(-delta / T):
                x = y
        
    return x
