def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(x, sigma=1e-2):
        return x + np.random.normal(size=x.shape) * sigma

    def local_search(x0, func, dim, lb, ub, max_iter=1000):
        x = x0
        for _ in range(max_iter):
            x_candidate = mutate(x)
            f_candidate = func(x_candidate)
            if f_candidate < func(x):
                x = x_candidate
        return x

    def genetic_algorithm(func, dim, lb, ub, budget, rng):
        population_size = 100
        candidates = np.random.uniform(lb, ub, size=(population_size, dim))
        for _ in range(budget):
            scores = func(candidates)
            parents = np.argsort(scores)[:int(population_size/2)]
            children = []
            for i in parents:
                child1 = mutate(candidates[i])
                child2 = mutate(candidates[i])
                children.extend([child1, child2])
            candidates[parents] = local_search(children[:int(population_size)], func, dim, lb, ub)
        best_candidate = np.argmin(func(candidates))
        return candidates[best_candidate]

    rng.seed(0)  # Ensure reproducibility
    best_candidate = genetic_algorithm(func, dim, lb, ub, budget, rng)
    return np.clip(best_candidate, lb, ub)
