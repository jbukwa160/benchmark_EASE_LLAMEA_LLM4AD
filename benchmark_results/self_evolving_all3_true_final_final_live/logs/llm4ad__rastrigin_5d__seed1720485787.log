def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def DE(population, best, f):
        n = population.shape[0]
        offspring = np.zeros((n, dim))
        for i in range(n):
            r1, r2, r3 = rng.randint(0, n, 3)
            mutation = clip(best + rng.uniform(-1, 1) * (population[r1] - population[r2]) + rng.uniform(-1, 1) * (population[r3] - best))
            crossover = clip(population[i] + 0.5 * (mutation - population[i]))
            offspring[i] = mutation if rng.random() < 0.5 else crossover
        return offspring

    def local_search(candidate):
        step_size = 0.1
        while True:
            new_candidate = candidate + np.random.uniform(-step_size, step_size, dim)
            new_candidate = clip(new_candidate)
            improvement = func(new_candidate) - func(candidate)
            if improvement < 0 or np.abs(improvement) < 1e-6:
                return new_candidate
            candidate = new_candidate

    population = rng.uniform(lb, ub, (budget, dim))
    best = local_search(population[0])
    for _ in range(budget - 1):
        population = DE(population, best, func)
        best = local_search(population[np.argmin([func(ind) for ind in population])])

    return best
