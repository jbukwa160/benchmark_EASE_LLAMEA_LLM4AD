def algorithm(func, dim, lb, ub, budget, rng):
    n_starts = int(np.ceil(budget / (2 * 10**dim)))
    
    def bounded_bounds(bounds, x):
        return [min(max(x[i], bounds[0]), bounds[1]) for i in range(len(x))]

    def objective(params):
        clipped_params = bounded_bounds((lb, ub), params)
        return func(clipped_params)

    best_params = None
    best_fitness = np.inf
    
    for _ in range(n_starts):
        result = differential_evolution(objective, [(lb, ub)] * dim, maxiter=int(budget / n_starts))
        
        if result.fun < best_fitness:
            best_fitness = result.fun
            best_params = result.x
            
        budget -= int(budget / n_starts)
        
    return np.array(best_params)
