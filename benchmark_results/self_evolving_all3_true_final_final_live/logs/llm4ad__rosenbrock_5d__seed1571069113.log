def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(x, x_best):
        mutation_scale = 0.5
        trial_individual = np.copy(x)
        
        for i in range(dim):
            r1, r2, r3 = rng.uniform(0, 1), rng.uniform(0, 1), rng.uniform(0, 1)
            trial_individual[i] = x_best[i] + mutation_scale * (x[rng.randint(0, dim)] - x_best[rng.randint(0, dim)]) \
                                 + r1 * (ub - lb) + r2 * (lb + ub) + r3 * x_best[i]
        
        return trial_individual
    
    def simplex_search(x_current, x_best):
        n = len(x_current)
        delta = 0.05
        
        for i in range(n):
            step_length = delta * np.random.choice([-1, 1])
            new_x = np.copy(x_current)
            new_x[i] += step_length
            if func(new_x) < func(x_best):
                x_best = new_x
        
        return x_best
    
    x_best = rng.uniform(lb, ub, dim)
    budget_used = 0
    population_size = int(10 * dim + 1)
    
    while budget_used < budget:
        x_currents = [rng.uniform(lb, ub, dim) for _ in range(population_size)]
        
        for i in range(population_size):
            trial_individual = generate_candidate(x_currents[i], x_best)
            if func(trial_individual) < func(x_best):
                x_best = trial_individual
        
        # Simplex Search
        for i in range(population_size):
            x_best = simplex_search(x_currents[i], x_best)
        
        budget_used += population_size
    
    return np.clip(x_best, lb, ub)
