def algorithm(func, dim, lb, ub, budget, rng):
    population_size = int(np.ceil(budget ** (1 / 2)))
    num_generations = int(np.ceil(budget / population_size))
    
    def genetic_algorithm(population_size, num_generations):
        population = rng.uniform(lb, ub, size=(population_size, dim))
        for _ in range(num_generations):
            offspring = np.copy(population)
            for i in range(population_size):
                idx = rng.choice(population_size, 3, replace=False)
                parent1, parent2, parent3 = population[idx]
                child = parent1 + rng.normal(0, 0.01, size=dim)
                child = (child - lb) / (ub - lb)
                offspring[i] = child
            population = np.concatenate((population, offspring))
        return population
    
    def differential_evolution(population_size):
        population = rng.uniform(lb, ub, size=(population_size, dim))
        for i in range(population_size):
            idx = rng.choice(range(population_size), 3, replace=False)
            parent1, parent2, parent3 = population[idx]
            child = parent1 + (parent2 - parent3) * rng.normal(0, 0.01, size=dim)
            child = (child - lb) / (ub - lb)
            population[i] = child
        return population
    
    def clip_candidates(candidates):
        return np.clip(candidates, a_min=lb, a_max=ub)
    
    population = genetic_algorithm(population_size, num_generations)
    best_individual = population[np.argmin([func(ind) for ind in population])]
    best_individual = clip_candidates(best_individual)
    
    # Run differential evolution with the best individual as the starting point
    population = differential_evolution(1)
    population = clip_candidates(np.array(population))
    new_best_individual = population[0]
    
    if func(new_best_individual) < func(best_individual):
        best_individual = new_best_individual
    
    return best_individual
