def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def objective(x):
        return func(x)

    def nelder_mead_simplex(x0, f, dim, max_iter=100, tol=1e-5):
        simplex = np.array([clip(np.array(x0) + 2*(np.random.rand(dim)-0.5)) for _ in range(10)])
        for i in range(max_iter):
            y = objective(simplex)
            idx = np.argsort(y)[:5]
            if np.linalg.norm(simplex[idx[1]]-simplex[idx[0]]) < tol:
                return simplex[idx[0]]
            centroid = (np.sum(simplex, axis=0)/len(simplex))
            new_point = clip(centroid + 2*(simplex[idx[4]]-centroid))
            y_new = objective(new_point)
            if y_new < y[idx[1]]:
                simplex[idx[4]] = new_point
            else:
                for j in range(len(idx)-1):
                    idx[j], idx[j+1] = idx[j+1], idx[j]
                    centroid = (np.sum(simplex, axis=0)/len(simplex))
                    new_point = clip(centroid + 2*(simplex[idx[4]]-centroid))
                    y_new = objective(new_point)
                    if y_new < y[idx[j]]:
                        simplex[idx[j+1]] = new_point
                    else:
                        break
        return simplex[idx[0]]

    best_x = None
    best_f = np.inf

    for _ in range(budget):
        x0 = clip(rng.uniform(lb, ub, size=dim))
        if objective(x0) < best_f:
            best_f = objective(x0)
            best_x = x0
        x_new = nelder_mead_simplex(x0, objective, dim)
        if objective(x_new) < best_f:
            best_f = objective(x_new)
            best_x = x_new

    return np.array(best_x)
