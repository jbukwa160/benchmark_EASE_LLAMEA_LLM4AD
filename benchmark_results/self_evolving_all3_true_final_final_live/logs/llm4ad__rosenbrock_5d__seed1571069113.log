def algorithm(func, dim, lb, ub, budget, rng):
    n = 1.4 * len(rng)
    sigma = (ub - lb) / n ** (1.0 / dim)
    x = [rng.uniform(lb, ub) for _ in range(dim)]
    cm = np.array([1.0] * dim)
    cmflat = cm.flatten()
    fhist = []
    
    for i in range(budget):
        y = func(x)
        fhist.append(y)
        
        if len(fhist) > 2 and min(fhist[-3:]) < 1e-6:
            break
        
        ygrad = np.zeros(dim)
        c = 0.5
        sigma *= (c + 2 / n * (len(fhist) - 1)) ** (-0.25)
        
        for j in range(len(x)):
            xj = x[j]
            lbj, ubj = lb, ub
            
            if dim == 1:
                ygrad[j] = c * rng.gauss(0, 1)
            else:
                v = np.random.normal(size=dim) / (2 ** n)
                v /= np.linalg.norm(v)
                v *= min(cmflat)
                
                for k in range(n):
                    xk = [x[ki] + v[ki] * sigma for ki in range(dim)]
                    
                    if all(lbk <= xi <= ubk for lbk, xi, ubk in zip(lb, xk, ub)):
                        yk = func(xk)
                        
                        if yk < fhist[-1]:
                            c += 2 / n
                            cmflat *= (yk - y) ** (-0.5)
                            v[k] += np.random.normal(0, sigma)
                            break
                        
                        elif rng.uniform() < 0.5:
                            xj = xk[j]
                            ygrad[j] -= cm[j] * (y - yk)
                    
                    if k == n // 2:
                        break
                    
            x[j] = xj
        fhist.append(func(x))
        
    return np.array(x)
