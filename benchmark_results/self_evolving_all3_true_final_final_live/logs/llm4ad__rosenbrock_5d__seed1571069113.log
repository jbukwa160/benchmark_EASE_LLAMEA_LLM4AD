def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_candidates(population_size, mean, sigma):
        candidates = rng.normal(mean, sigma, (population_size, dim))
        return clip(candidates)

    best_solution = np.random.uniform(lb, ub, dim)
    population_size = 10
    learning_rate = 1.0

    for _ in range(budget):
        candidates = generate_candidates(population_size, best_solution, 5.0)
        evaluations = func(candidates)

        idx = np.argsort(evaluations)[:population_size]
        new_mean = np.mean(candidates[idx], axis=0)
        sigma = np.std(candidates[idx], axis=0).mean()

        learning_rate *= 0.9
        population_size = int(population_size * (1 + learning_rate))

        best_solution = clip(new_mean)

    return best_solution
