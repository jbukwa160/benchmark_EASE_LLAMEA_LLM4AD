def algorithm(func, dim, lb, ub, budget, rng):
    def func_wrapper(x):
        return func(np.clip(x, lb, ub))

    x = np.random.uniform(size=dim)
    lambda_ = 0.5
    mean = x.copy()
    sigma = 1.
    learning_rate = 0.01

    for _ in range(budget):
        candidates = np.zeros((lambda_, dim))
        for i in range(lambda_):
            for j in rank_25:
                candidates[i] += lambda_ * (mean + rng.normal(size=dim) / sigma)
            for i in rank_25:
                if i == rank_25[0]:
                    continue
                candidates[i] -= (i - 1) * (candidates[i] - candidates[rank_25[0]])
        candidates = np.clip(candidates, lb, ub)

        fitnesses = func_wrapper(candidates)
        indices = np.argsort(fitnesses)
        x_new = np.mean(candidates[indices[:int(lambda_/2)]], axis=0)

        delta = x_new - mean
        sigma *= 1 + learning_rate * (delta.dot(delta) / dim)
        mean += delta

    return mean
