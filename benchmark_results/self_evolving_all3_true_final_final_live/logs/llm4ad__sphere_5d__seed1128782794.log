def algorithm(func, dim, lb, ub, budget, rng):
    n = int(np.ceil(budget / dim))
    
    mean = rng.uniform(lb, ub, size=dim)
    step_size = (ub - lb) / 3
    
    best_solution = None
    for _ in range(n):
        offspring_population = np.random.normal(mean, step_size, size=(2*dim,))
        
        clipped_offspring = np.clip(offspring_population, a_min=lb, a_max=ub)
        
        fitnesses = func(clipped_offspring)
        
        indices = np.argsort(fitnesses)[:dim]
        new_mean = np.mean(clipped_offspring[indices], axis=0)
        
        if best_solution is None or fitnesses[indices[0]] < func(best_solution):
            best_solution = clipped_offspring[indices[0]]
    
    return best_solution
