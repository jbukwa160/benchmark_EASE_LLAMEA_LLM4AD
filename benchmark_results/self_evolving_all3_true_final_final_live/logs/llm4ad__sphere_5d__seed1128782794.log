def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.sqrt(budget))
    population = (ub - lb) * rng.rand(pop_size, dim) + lb
    best = None

    for _ in range(budget // 2):
        # Select parents using tournament selection
        parents = np.zeros((pop_size, dim))
        for i in range(pop_size):
            idx1, idx2 = rng.randint(0, pop_size, size=2)
            if func(population[idx1]) < func(population[idx2]):
                parents[i] = population[idx1]
            else:
                parents[i] = population[idx2]

        # Perform crossover (average of two parents)
        offspring = np.zeros((pop_size, dim))
        for i in range(pop_size):
            idx1, idx2 = rng.randint(0, pop_size, size=2)
            offspring[i] = 0.5 * (parents[idx1] + parents[idx2])

        # Perform mutation
        for i in range(pop_size):
            mutation = (ub - lb) * rng.randn(dim) + lb
            offspring[i] += 0.01 * mutation

        # Clip to bounds
        population = np.clip(offspring, lb, ub)

        # Update best solution
        candidate_best = func(population[np.argmin([func(x) for x in population])])
        if best is None or candidate_best < func(best):
            best = population[np.argmin([func(x) for x in population])]

    return np.clip(best, lb, ub)
