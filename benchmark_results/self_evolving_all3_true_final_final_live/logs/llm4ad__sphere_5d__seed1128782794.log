def algorithm(func, dim, lb, ub, budget, rng):
    best = None
    for _ in range(budget // 10):
        cma_params = {'mu': int(0.1 * dim), 'lambda_': int(dim + 5)}
        cma_es = cma.CMAEvolutionStrategy(np.zeros(dim), 1e-3, cma_params)
        
        while not cma_es.is_stop():
            params = cma_es.ask()
            clipped_params = np.clip(params, lb, ub)
            fitness = func(clipped_params)
            
            if best is None or fitness < func(best):
                best = clipped_params
            
            cma_es.tell(params, fitness)
        
        cma_es.resultats['x'][-1]
    
    return best
