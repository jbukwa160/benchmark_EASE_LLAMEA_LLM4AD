def algorithm(func, dim, lb, ub, budget, rng):
    D = rng.rand(dim)
    best_x = None
    best_y = float('inf')
    
    for i in range(budget):
        x = 0.5 * (ub - lb) * D + (lb + ub) / 2
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, a_min=lb, a_max=ub)
        
        y = func(x)
        
        if y < best_y:
            best_y = y
            best_x = x
            
    return best_x
