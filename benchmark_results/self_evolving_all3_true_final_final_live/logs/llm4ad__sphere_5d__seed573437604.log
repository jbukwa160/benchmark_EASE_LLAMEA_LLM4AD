def algorithm(func, dim, lb, ub, budget, rng):
    n = len(dim)
    best_x = np.zeros(n)
    best_f = float('inf')
    T_max = 1000.0
    T_min = 1e-3
    alpha = 0.99
    x = np.array([rng.uniform(lb[i], ub[i]) for i in range(n)])
    
    for budget_ in range(budget):
        f_x = func(x)
        
        if f_x < best_f:
            best_f = f_x
            best_x = x.copy()
            
        delta = rng.normal(0, 1) * (ub - lb)
        step_size = np.clip(np.abs(delta), a_min=0.01, a_max=None)
        new_x = x + step_size
        
        # clip new_x to [lb, ub]
        for i in range(n):
            new_x[i] = np.clip(new_x[i], a_min=lb[i], a_max=ub[i])
        
        f_new_x = func(new_x)
        
        if f_new_x < best_f:
            x = new_x
        else:
            T = max(T_min, T_max * (1 - alpha)**budget_)
            P = np.exp((f_new_x - f_x) / T)
            r = rng.uniform(0, 1)
            
            if r < P:
                x = new_x
                
    return best_x
