def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    v = np.zeros(dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        for i in range(dim):
            r1 = 2 * rng.rand() - 1
            r2 = 2 * rng.rand() - 1

            if rng.rand() < 0.5:
                v[i] *= 0.9
            else:
                x[i] += r1 * 0.05 * (ub - lb)
                x[i] = np.clip(x[i], lb, ub)
                v[i] = r2 * 0.1 * (x[i] - best_x[i])

        f = func(x)

        if f < best_f:
            best_f = f
            best_x = x.copy()

    return best_x
