def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.array([0.0] * dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_new = x_best + rng.normal(0, 1, size=dim) / (1 + np.exp(-(f_best - func(x_best))))
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
