def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(lb, ub, rng):
        return [rng.uniform(lb[i], ub[i]) for i in range(dim)]

    best_x = np.array([ub[i] - (ub[i] - lb[i])*rng.random() for i in range(dim)])
    best_f = func(best_x)

    n_directions = 10
    directions = [[np.cos(2*np.pi*i/n_directions), np.sin(2*np.pi*i/n_directions)] for i in range(n_directions)]

    for _ in range(budget):
        candidate = get_candidate(lb, ub, rng)
        f = func(candidate)

        if f < best_f:
            best_x = candidate
            best_f = f

        for direction in directions:
            new_candidate = [candidate[i] + 0.5*direction[0]*rng.uniform(-1, 1) + 0.5*direction[1]*rng.uniform(-1, 1) for i in range(dim)]
            new_candidate = [max(lb[i], min(ub[i], x)) for i, x in enumerate(new_candidate)]

            f = func(new_candidate)

            if f < best_f:
                best_x = new_candidate
                best_f = f

    return np.array(best_x)
