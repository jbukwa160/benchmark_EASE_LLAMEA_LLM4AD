def algorithm(func, dim, lb, ub, budget, rng):
    x_best = (np.random.uniform(lb, ub, dim) - lb) * 2
    f_best = func(x_best)
    step_size = 1
    success_rate = [0]
    
    for i in range(budget):
        x_new = x_best + np.random.choice([-1, 1], size=dim) * (step_size / rng.randint(1, 10))
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        
        if f_new < f_best:
            x_best = x_new
            f_best = f_new
            
            success_rate.append(success_rate[-1] + 1)
            
            if len(success_rate) > 10 and (success_rate[-1] / len(success_rate)) < 0.2:
                step_size /= rng.uniform(0.5, 1)
                
        else:
            success_rate.append(success_rate[-1])
    
    return x_best
