def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    for _ in range(budget):
        grad = np.zeros(dim)
        for i in range(dim):
            x_new = x.copy()
            x_new[i] += 1e-4
            x_new = np.clip(x_new, lb, ub)
            grad[i] = (func(x_new) - func(x)) / 1e-4
        x -= 0.01 * grad / np.max(np.abs(grad))
        x = np.clip(x, lb, ub)
    return x
