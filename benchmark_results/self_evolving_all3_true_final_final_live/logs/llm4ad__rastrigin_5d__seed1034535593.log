def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def generate_initial_population(size, dim, lb, ub):
        population = np.zeros((size, dim))
        for i in range(size):
            for j in range(dim):
                population[i, j] = rng.uniform(lb, ub)
        return population

    def differential_evolution(population, func, dim, lb, ub, f):
        n_parents = int(0.2 * len(population))
        parents = np.copy(population[np.argsort(f)[-n_parents:]])
        offsprings = np.zeros((len(population), dim))

        for i in range(len(population)):
            idx1 = random.randint(0, n_parents - 1)
            idx2 = (idx1 + 1) % n_parents
            idx3 = (idx1 + 2) % n_parents

            v = parents[idx1] + rng.uniform(-1, 1) * (parents[idx2] - parents[idx3])

            for j in range(dim):
                if rng.random() < 0.5:
                    offsprings[i, j] = clip(v[j], lb, ub)
                else:
                    offsprings[i, j] = population[i, j]

        return func(offsprings), np.copy(offsprings)

    def crossover(parents, offsprings):
        for i in range(len(parents)):
            idx1 = random.randint(0, len(parents) - 1)
            idx2 = (idx1 + 1) % len(parents)

            r = rng.uniform(0, 1)
            if r < 0.5:
                offsprings[i] = parents[idx1]
            else:
                offsprings[i] = parents[idx2]

    population = generate_initial_population(budget, dim, lb, ub)
    f_values = np.zeros(len(population))
    for _ in range(int(0.8 * budget)):
        f_values, population = differential_evolution(population, func, dim, lb, ub, f_values)

    best_idx = np.argmin(f_values)
    return clip(population[best_idx], lb, ub)
