def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def rastrigin(x):
        n = len(x)
        return 10*n + sum(i**2 - 10*np.cos(2*np.pi*i) for i in x)

    population_size = int(np.sqrt(budget))
    temperature = budget / np.log(population_size + 1)
    current_best = rng.uniform(lb, ub, size=dim)

    for _ in range(budget):
        new_population = [clip(rng.uniform(lb, ub, size=dim)) for _ in range(population_size)]
        fitnesses = [func(individual) for individual in new_population]

        # DE step
        differences = np.array([new_individual - current_best for new_individual in new_population])
        indices = rng.choice(population_size, population_size, replace=False)
        new_population_de = [clip(current_best + 0.5 * difference[i] if rng.random() > 0.5 else current_best) 
                              for i, difference in enumerate(differences) if rng.random() < 0.5]

        # SA step
        new_population_sa = [clip(new_individual - temperature * np.log(rng.uniform())) for new_individual in new_population]
        fitnesses_sa = [func(individual) for individual in new_population_sa]

        new_fitnesses_de = [rastrigin(individual) for individual in new_population_de]
        new_fitnesses_sa = [rastrigin(individual) for individual in new_population_sa]

        if rng.random() < 0.5:
            fitnesses = np.minimum(fitnesses, new_fitnesses_de)
        else:
            fitnesses = np.minimum(fitnesses, new_fitnesses_sa)

        current_best = np.argmin(fitnesses)
        current_best_individual = clip(new_population[current_best] if rng.random() < 0.5 
                                        else new_population_sa[current_best])

    return clip(current_best_individual)
