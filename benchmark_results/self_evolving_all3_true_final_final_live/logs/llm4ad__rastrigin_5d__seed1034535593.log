def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 20
    num_iter = int(budget / (dim * pop_size))
    best_sol = np.zeros(dim)
    best_val = float('inf')
    
    for i in range(num_iter):
        pop = np.random.uniform(lb, ub, size=(pop_size, dim))
        
        for j in range(pop_size):
            if func(pop[j]) < best_val:
                best_val = func(pop[j])
                best_sol = pop[j]
                
            if rng.random() < 0.1 / (i + 1):
                step_size = np.abs(ub - lb) * rng.uniform(0, 1)
                new_sol = pop[j] + step_size * np.sign(np.random.normal(size=dim))
                new_sol = np.clip(new_sol, lb, ub)
                
                if func(new_sol) < best_val:
                    best_val = func(new_sol)
                    best_sol = new_sol
                    
    return best_sol
