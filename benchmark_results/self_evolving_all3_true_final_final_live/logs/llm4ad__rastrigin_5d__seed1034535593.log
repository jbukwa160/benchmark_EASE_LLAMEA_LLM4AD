def algorithm(func, dim, lb, ub, budget, rng):
    D = rng.uniform(lb, ub, size=(dim,))
    best_x = D.copy()
    best_y = func(D)
    
    for _ in range(budget):
        v1 = rng.uniform(lb, ub, size=(dim,))
        v2 = rng.uniform(lb, ub, size=(dim,))
        
        while np.any(np.abs(v1 - v2) < 0.01):
            v2 = rng.uniform(lb, ub, size=(dim,))
            
        z = (D + v1 + v2) / 3
        
        y = func(z)
        
        if y < best_y:
            best_x = z.copy()
            best_y = y
            
    return best_x
