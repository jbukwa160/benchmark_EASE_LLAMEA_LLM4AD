def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def adaptive_crossover(population, fvals, mu=1e-4):
        mask = fvals > 0
        if np.any(mask):
            weights = (fvals[mask] / (np.abs(fvals[mask]) + mu))[:, None]
            weights /= np.sum(weights, axis=0)
            indices = rng.choice(dim, size=(dim,), replace=False)
            return np.dot(population[mask], weights[indices])
        else:
            return population

    def differential_evolution(population, fvals, lb, ub):
        indices = rng.permutation(len(population))
        x1 = population[indices[:int(0.2*len(indices))]]
        x2 = population[indices[int(0.8*len(indices)):]]
        mu = 0.5
        for i in range(dim):
            x3 = clip(x1[:, i] + (x2[i] - x1[:, i]) * rng.uniform(low=-mu, high=mu), lb, ub)
            population[indices[int(0.8*len(indices)):], i] = x3
        return population

    population = np.random.uniform(lb, ub, size=(budget, dim))
    for _ in range(int(budget/2)):
        fvals = func(population)
        population = differential_evolution(population, fvals, lb, ub)
        if rng.random() > 0.5:
            x = adaptive_crossover(population, fvals)
            population[rng.choice(len(population), size=1)[0]] = x

    return clip(np.argmin(func(population)), lb, ub)
