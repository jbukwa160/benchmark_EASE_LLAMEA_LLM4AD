def algorithm(func, dim, lb, ub, budget, rng):
    x_best = lb + (ub - lb) * rng.uniform(size=dim)
    f_best = func(x_best)

    for t in range(budget):
        # Define the acquisition function
        def expected_improvement(x):
            mu, sigma = 0, np.sqrt(1)
            z = (func(x) - f_best) / sigma
            return max(mu + sigma * z, 0)

        # Get a new sample using the acquisition function as the likelihood
        x_new = rng.uniform(size=dim)

        # Update the probabilistic model of the objective function
        def gp_model(x):
            mu, sigma = 0, np.sqrt(1)
            return mu + sigma * (x - lb) / (ub - lb)

        # Predict the expected improvement at the new sample
        ei_new = expected_improvement(x_new)

        # Greedily select the next evaluation point based on the predicted expected improvement
        if rng.uniform() < ei_new / np.max([expected_improvement(x_best), 1e-6]):
            x_new = x_best.copy()
            for i in range(dim):
                if lb[i] != ub[i]:
                    mu, sigma = gp_model(x_new)
                    z = (rng.normal(loc=mu, scale=sigma) + (ub[i] - lb[i]) / 2) * (x_new[i] - lb[i])
                    x_new[i] = lb[i] + np.tanh(z) * (ub[i] - lb[i])

        # Clip candidates to [lb, ub]
        x_best = np.clip(x_new, lb, ub)
        f_best = func(x_best)

    return x_best
