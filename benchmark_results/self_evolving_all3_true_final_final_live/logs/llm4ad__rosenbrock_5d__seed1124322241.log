def algorithm(func, dim, lb, ub, budget, rng):
    X = np.random.uniform(lb, ub, (10, dim))
    Y = func(X)
    
    gp = GPy.models.GPRegression(X, Y, kernel=Matern32())
    gp.optimize('scipy')
    
    best_x = None
    best_y = float('inf')
    
    for i in range(budget):
        mu, sigma = gp.predict(np.random.uniform(lb, ub, (1, dim)), full_output=True)
        
        x_candidate = np.clip(mu[0], lb, ub)
        
        ei = func(x_candidate) - mu[0] + sigma[0] * norm.cdf((func(x_candidate) - mu[0]) / sigma[0])
        
        if ei > 0:
            X_new = np.vstack([X, x_candidate])
            Y_new = np.hstack([Y, func(x_candidate)])
            
            gp.set_XY(X_new, Y_new)
            gp.optimize('scipy')
            
            best_x = x_candidate
            best_y = func(best_x)
    
    return best_x
