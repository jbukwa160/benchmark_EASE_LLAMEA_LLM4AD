def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(current_x):
        candidate = current_x + (ub - lb) * rng.rand(dim)
        return clip(candidate)

    def evaluate(current_x):
        return func(current_x)

    best_x = lb + (ub - lb) * rng.rand(dim)
    best_eval = evaluate(best_x)

    T = 1.0
    alpha = 0.99

    for i in range(budget):
        candidate = generate_candidate(best_x)
        candidate_eval = evaluate(candidate)

        if candidate_eval < best_eval:
            best_x = candidate
            best_eval = candidate_eval

        T *= alpha

        # restarts with decreasing probability
        if rng.rand() > 0.1 * (budget - i) / budget and i > budget // 5:
            best_x = lb + (ub - lb) * rng.rand(dim)
            best_eval = evaluate(best_x)

    return best_x
