def algorithm(func, dim, lb, ub, budget, rng):
    bounds = [(lb[i], ub[i]) for i in range(dim)]
    
    best_point = np.zeros(dim)
    best_value = float('inf')
    
    for _ in range(budget):
        point = rng.uniform(bounds[0][0], bounds[0][1])
        for i in range(1, dim):
            point = np.append(point, rng.uniform(bounds[i][0], bounds[i][1]))
        
        value = func(point)
        
        if lb <= point <= ub:
            point = np.clip(point, a_min=lb, a_max=ub)
            
            if value < best_value:
                best_value = value
                best_point = point
                
            # re-evaluate previously visited points with similar values
            if rng.random() < 0.1 and value - best_value <= 0.01:
                old_point = rng.uniform(-5, 5, size=dim)
                while np.linalg.norm(old_point - best_point) > 0.1 or (old_point >= lb).all() and (old_point <= ub).all():
                    old_point = rng.uniform(-5, 5, size=dim)
                
                old_value = func(np.clip(old_point, a_min=lb, a_max=ub))
                
                if old_value < best_value:
                    best_value = old_value
                    best_point = old_point
                    
    return best_point
