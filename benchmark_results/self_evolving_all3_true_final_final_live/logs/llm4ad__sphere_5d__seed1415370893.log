def algorithm(func, dim, lb, ub, budget, rng):
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    T = 1.0
    alpha = 0.99
    cooling_rate = 0.01

    for _ in range(budget):
        x_new = x_best.copy()
        i = rng.randint(0, dim)
        x_new[i] += (ub - lb) * (2 * rng.rand() - 1)

        f_new = func(np.clip(x_new, a_min=lb, a_max=ub))

        if f_new < f_best:
            x_best = x_new
            f_best = f_new

        delta = f_new - f_best
        if delta < 0 or np.exp(-delta / T) > rng.rand():
            x_best = x_new
            f_best = f_new

        T *= alpha + cooling_rate * (1 - _ / budget)
    return x_best
