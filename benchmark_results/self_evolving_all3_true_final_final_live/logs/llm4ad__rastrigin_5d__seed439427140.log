def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    T = 5.0 * (ub - lb)
    cooling_rate = 0.99

    for _ in range(budget):
        x_new = x + 0.1 * rng.normal(size=dim)
        x_new = clip(x_new)

        f_x_new = func(x_new)
        f_x = func(x)

        if f_x_new < f_x:
            x = x_new
        else:
            delta_f = f_x_new - f_x

            if np.exp(-delta_f / T) > rng.uniform():
                x = x_new

        T *= cooling_rate

    return clip(x)
