def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        # Adaptive learning rate
        lr = 0.1 / (1 + 0.001 * np.sum(np.abs(x_best)))

        # Local refinement
        x_new = x_best + rng.uniform(-lr, lr, size=dim)
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)

        if f_new < f_best:
            f_best = f_new
            x_best = x_new

    return x_best
