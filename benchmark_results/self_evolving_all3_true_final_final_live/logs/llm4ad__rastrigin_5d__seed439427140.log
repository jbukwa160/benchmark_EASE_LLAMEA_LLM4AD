def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 10
    max_iter = int(budget / (dim * pop_size))
    pop = rng.uniform(lb, ub, (pop_size, dim))

    for _ in range(max_iter):
        new_pop = np.zeros((pop_size, dim))

        for i in range(pop_size):
            j = rng.choice(range(pop_size), size=3, replace=False)

            # Modified mutation strategy
            mutant = pop[j] + 0.5 * (pop[rng.randint(0, 4)] - pop[rng.randint(0, 4)])

            # Apply bounds to mutate vector
            for k in range(dim):
                mutant[k] = max(lb, min(ub, mutant[k]))

            new_pop[i] = mutant + rng.uniform(-1, 1, dim)

        fit = np.array([func(x) for x in new_pop])
        pop = new_pop[np.argsort(fit)]

    return pop[0]
