def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    current = np.zeros(dim)
    current_best = current.copy()
    best_func_value = func(current)
    temp = 1.0

    for _ in range(budget):
        i = rng.randint(0, dim)
        step_size = rng.uniform(-1, 1) * (ub - lb)
        new_candidate = clip(current + np.zeros(dim) + step_size)

        new_func_value = func(new_candidate)
        if new_func_value < best_func_value:
            current_best = new_candidate.copy()
            best_func_value = new_func_value

        if rng.uniform(0, 1) < np.exp((best_func_value - new_func_value) / temp):
            current = new_candidate

        temp *= 0.9999  # cooling schedule
    return current_best
