def algorithm(func, dim, lb, ub, budget, rng):
    n_iter = int(np.sqrt(budget))
    sigma_init = 1.0
    sigma_final = 0.01
    alpha = (sigma_init - sigma_final) / (n_iter * 2 + 1)
    
    x_best = np.zeros(dim)
    y_best = float('inf')
    
    for t in range(n_iter):
        for _ in range(10 if budget > 100 else int(np.sqrt(budget)) // n_iter):
            x = np.clip(rng.uniform(lb, ub, size=dim), lb, ub)
            
            gp = GaussianProcess(x, func(x))
            mean, var = gp.predict(x, 0)
            
            sigma_t = max(sigma_final, sigma_init - alpha * (t + 1))
            if np.random.uniform(0, 1) < 0.5:
                x_new = x_best + sigma_t * rng.normal(mean, np.sqrt(var), size=dim)
            else:
                x_new = x
            
            y_new = func(x_new)
            
            gp.update(x_new, y_new)
            
            if y_new < y_best:
                x_best = x_new
                y_best = y_new
                
    return x_best
