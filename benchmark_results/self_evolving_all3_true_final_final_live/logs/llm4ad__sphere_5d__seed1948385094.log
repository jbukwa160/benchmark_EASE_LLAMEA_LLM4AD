def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def sample_candidate(mu, sigma, t):
        return mu + sigma * np.random.randn(dim) if t == 0 else mu + sigma * np.random.randn(dim) / np.sqrt(t+1)

    def update_covariance(cov, x, t):
        delta = x - mu
        cov += delta[np.newaxis].T @ delta / (t + 1)
        return cov

    budget_used = 0
    mu = rng.uniform(lb, ub, size=dim)
    cov = np.eye(dim) * 10**6
    best_candidate = clip(mu)

    while budget_used < budget:
        candidate = sample_candidate(mu, np.sqrt(cov), budget_used)
        candidate = clip(candidate)
        candidate_value = func(candidate)

        if candidate_value <= func(best_candidate):
            mu = candidate
            cov = update_covariance(cov, candidate, budget_used)
            best_candidate = candidate

        budget_used += 1

    return best_candidate
