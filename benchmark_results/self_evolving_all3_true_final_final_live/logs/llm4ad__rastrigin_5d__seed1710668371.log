def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = dim
    mu = np.zeros(D)
    sigma = 5.0 * rng.uniform()
    lambda_ = 100
    gamma = 1 / (2 ** (lambda_ - 1))
    cumul_deviation = np.zeros(lambda_)
    covariance_matrix = np.eye(D) * sigma ** 2

    for i in range(budget):
        distribution = mu + rng.normal(size=(lambda_, D)) * sigma
        distribution = clip(distribution)

        fitness_values = func(distribution)
        sorted_indices = np.argsort(fitness_values)

        if i == 0:
            mu = distribution[sorted_indices[:1]]
            cumul_deviation[:] = distribution[sorted_indices[:1]] - mu
            for j in range(lambda_):
                cumul_deviation[j] /= fitness_values[sorted_indices[j]]
        else:
            mu += gamma * (distribution[sorted_indices[0]] - mu)
            cumul_deviation[:] = distribution[sorted_indices[0]] - mu

            for j in range(1, lambda_):
                deviation = distribution[sorted_indices[j]] - mu
                cumul_deviation[j] = deviation / fitness_values[sorted_indices[j]]
                covariance_matrix += gamma * deviation[:, np.newaxis] @ deviation[np.newaxis, :]

        sigma *= 1 + (gamma / (2 ** (lambda_ - i)))
        if sigma > 5.0:
            sigma = 5.0

    return mu
