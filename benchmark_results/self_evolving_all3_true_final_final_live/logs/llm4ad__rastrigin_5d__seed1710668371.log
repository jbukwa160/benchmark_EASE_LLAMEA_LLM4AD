def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    best_sol = np.zeros(n)
    best_val = 1e9
    restarts = int(np.ceil(budget / (n * 100)))
    
    for _ in range(restarts):
        sol = rng.uniform(lb, ub, size=n)
        
        for _ in range(100):
            candidates = rng.uniform(sol - 0.5, sol + 0.5, size=(n,))
            clipped_candidates = np.clip(candidates, lb, ub)
            
            new_sol = clipped_candidates
            new_val = func(new_sol)
            
            if new_val < best_val:
                best_sol = new_sol
                best_val = new_val
                
            for i in range(n):
                candidate1 = clipped_candidates.copy()
                candidate2 = clipped_candidates.copy()
                
                candidate1[i] += 0.5 * rng.uniform(-1, 1)
                candidate2[i] -= 0.5 * rng.uniform(-1, 1)
                
                new_val1 = func(candidate1)
                new_val2 = func(candidate2)
                
                if new_val1 < best_val:
                    best_sol[i] = candidate1[i]
                    best_val = new_val1
                    
                if new_val2 < best_val:
                    best_sol[i] = candidate2[i]
                    best_val = new_val2
                
        sol = best_sol
    
    return best_sol
