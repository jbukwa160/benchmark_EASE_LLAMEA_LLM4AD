def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    current_best = evaluate(np.zeros(dim))
    temperature = 1
    sigma = 0.2

    for _ in range(budget):
        candidate = rng.uniform(lb, ub, size=dim)
        variation = np.random.uniform(-sigma, sigma, size=dim)
        new_candidate = clip(candidate + variation)

        if evaluate(new_candidate) < current_best:
            current_best = evaluate(new_candidate)

        probability = np.exp((current_best - evaluate(new_candidate)) / temperature)
        if rng.uniform(0, 1) < probability:
            candidate = new_candidate

        temperature *= 0.99
        sigma *= 0.999

    return clip(current_best)
