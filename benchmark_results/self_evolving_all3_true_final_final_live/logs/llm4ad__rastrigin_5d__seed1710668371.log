def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    D = 0.5 * (ub - lb)
    A = 2.1 + 3 * np.random.uniform(low=-1, high=1, size=(dim))
    C = 2 * np.random.uniform(low=-1, high=1, size=(dim))

    x_best = np.zeros(dim)
    f_best = f(x_best)

    for i in range(budget):
        r1 = rng.randint(0, dim)
        r2 = rng.randint(0, dim)
        while r2 == r1:
            r2 = rng.randint(0, dim)

        x_new = np.copy(x_best)
        x_new[r1] += A[r1] * (x_best[r1] - C[r1])
        x_new[r2] += A[r2] * (x_best[r2] - C[r2])

        for j in range(dim):
            if j != r1 and j != r2:
                u = rng.uniform(lb, ub)
                x_new[j] = lb + np.random.uniform(0, 1) * D[j] + u

        x_new = np.clip(x_new, lb, ub)

        f_new = f(x_new)

        if f_new < f_best:
            f_best = f_new
            x_best = np.copy(x_new)

    return x_best
