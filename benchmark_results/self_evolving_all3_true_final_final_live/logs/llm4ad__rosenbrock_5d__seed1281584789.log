def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population():
        population = np.random.uniform(lb, ub, (budget, dim))
        return population

    def calculate_fitness(population):
        fitness = np.array([func(c) for c in population])
        return fitness

    def mutation(population, best, rng):
        child = np.copy(best)
        child += rng.normal(0, 1, size=dim)
        child = clip(child)
        return child

    def crossover(parent1, parent2, rng):
        child = (parent1 + parent2) / 2.0
        child = clip(child)
        return child

    population = generate_initial_population()
    for i in range(budget - 1):
        fitness = calculate_fitness(population)
        best_idx = np.argmin(fitness)
        best = population[best_idx]
        
        # Local search around the current best solution
        new_best = mutation(best, best, rng)
        new_fitness = func(new_best)
        if new_fitness < fitness[best_idx]:
            population[best_idx] = new_best

        # Global crossover to explore other regions of the search space
        for j in range(len(population)):
            if j != best_idx:
                candidate1 = population[j]
                candidate2 = np.random.choice([c for i, c in enumerate(population) if i != best_idx and i != j])
                new_candidate = crossover(candidate1, candidate2, rng)
                new_fitness = func(new_candidate)
                if new_fitness < fitness[best_idx]:
                    population[best_idx] = new_candidate

    return population[np.argmin(calculate_fitness(population))]
