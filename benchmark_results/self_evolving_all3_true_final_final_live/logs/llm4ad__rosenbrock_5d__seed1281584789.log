def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def de(x0, y, sigma):
        v1 = rng.uniform(size=dim)
        v2 = rng.uniform(size=dim)
        v3 = x0 + 0.5 * (v1 - v2)
        return clip(y + sigma * np.exp(2) * (v3 - y))

    def sa(x, t):
        if rng.rand() < 0.9:
            return clip(np.clip(x + 0.01 * rng.randn(dim), a_min=lb, a_max=ub))
        else:
            return x

    x = np.random.uniform(size=(dim,))
    best_x = x
    best_y = func(x)
    for _ in range(budget):
        for _ in range(dim):
            y1 = de(best_x, x, 0.5)
            if func(y1) < best_y:
                best_x = y1
                best_y = func(y1)
        sa_x = sa(best_x, max(1 - _ / budget, 0))
        if func(sa_x) < best_y:
            best_x = sa_x
            best_y = func(sa_x)
    return best_x
