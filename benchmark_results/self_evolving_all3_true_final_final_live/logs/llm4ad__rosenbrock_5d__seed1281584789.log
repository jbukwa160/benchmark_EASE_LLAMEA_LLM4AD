def algorithm(func, dim, lb, ub, budget, rng):
    n_dim = dim
    best_x = rng.uniform(lb, ub, size=n_dim)
    best_f = func(best_x)

    def gaussian_proposal(x, sigma):
        return x + sigma * rng.normal(size=n_dim)

    for _ in range(budget):
        x = gaussian_proposal(best_x, 0.1)  # initial step size
        f = func(np.clip(x, lb, ub))

        if f < best_f:
            best_f = f
            best_x = np.copy(x)
        else:
            delta = f - best_f
            prob_accept = np.exp(-delta / 0.01)

            if rng.uniform() < prob_accept:
                best_f = f
                best_x = np.copy(x)

    return best_x
