def algorithm(func, dim, lb, ub, budget, rng):
    def sample(bounds):
        return np.random.uniform(low=bounds[0], high=bounds[1], size=dim)

    def estimate_lipschitz(bounds, x, f_x):
        n = 10
        samples = [sample(bounds) for _ in range(n)]
        Lipschitz = 0.0
        for s in samples:
            f_s = func(s)
            Lipschitz = max(Lipschitz, (f_s - f_x) / np.linalg.norm(s - x))
        return Lipschitz

    def optimize(bounds, x_best, f_best):
        Lip = estimate_lipschitz(bounds, x_best, f_best)
        candidates = [x_best + rng.uniform(low=-1.0/Lip, high=1.0/Lip, size=dim)]
        while len(candidates) < budget:
            cand = sample(bounds)
            if np.linalg.norm(cand - x_best) > 1.0 / Lip:
                candidates.append(cand)
        candidates = [c for c in candidates if lb <= c <= ub]
        new_x_best, new_f_best = None, float('inf')
        for cand in candidates:
            f_cand = func(cand)
            if f_cand < new_f_best:
                new_x_best, new_f_best = cand, f_cand
        return new_x_best, new_f_best

    bounds = [np.array([lb])]*dim + [np.array([ub])]*dim
    x_best, f_best = sample(bounds), func(sample(bounds))
    while True:
        x_best, f_best = optimize(bounds, x_best, f_best)
        if f_best < 1e-6: # stop condition
            break
    return x_best
