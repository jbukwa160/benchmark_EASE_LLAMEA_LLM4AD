def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = lb + (ub - lb) * rng.uniform(size=dim)
    T = 1e6
    best_x = x.copy()
    best_val = func(x)
    
    for _ in range(budget):
        y = clip(x + 0.5 * (ub - lb) * rng.normal(size=dim))
        val = func(y)
        
        if val < best_val:
            best_x = y
            best_val = val
        
        delta = val - best_val
        if delta > 0 or np.random.rand() < np.exp(-delta/T):
            x = y
            
        T *= 0.99999
    
    return best_x
