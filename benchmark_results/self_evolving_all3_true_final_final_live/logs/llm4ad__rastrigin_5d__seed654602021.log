def algorithm(func, dim, lb, ub, budget, rng):
    n_iter = 0
    x_best = rng.uniform(lb, ub, size=dim)
    y_best = func(x_best)

    while n_iter < budget:
        # Step 1: Set up Gaussian Process model
        X = np.array([x_best])
        Y = np.array([y_best])

        # Define kernel and noise parameters
        alpha = 2.0
        lengthscale = norm.rvs(loc=1, scale=5, size=dim)
        noise_var = norm.rvs(loc=0, scale=10**-3)

        # Step 2: Evaluate a candidate using the GP model
        x_cand = rng.uniform(lb, ub, size=dim)
        dists = np.sqrt(np.sum((x_cand - X)**2, axis=1))
        weights = np.exp(-alpha * (dists / lengthscale)**2)

        # Predictive mean and variance at the new point
        mu_new = np.dot(weights, Y)
        var_new = noise_var + np.dot(weights, np.diag(np.var(Y)))

        # Sample from the predictive distribution
        x_sample = x_cand + rng.normal(0, lengthscale, size=dim)

        # Evaluate function and update best solution if necessary
        y_sample = func(x_sample)

        if y_sample < y_best:
            x_best = x_sample
            y_best = y_sample

        n_iter += 1

    return x_best
