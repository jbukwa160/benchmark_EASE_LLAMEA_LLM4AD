def algorithm(func, dim, lb, ub, budget, rng):
    x = 5 * np.random.rand(dim)
    sigma = 0.5
    lambda_ = 10
    lambda_max = 100
    c1 = 2 / (dim + 1.27)
    cmu = 1 - c1
    mu = int(lambda_ * c1)
    w_m = np.zeros(mu)
    w_c = np.zeros(mu)
    x_m = np.zeros((mu, dim))
    c = rng.normal(0, sigma, (lambda_, dim))

    for i in range(budget):
        y = func(x + c)

        # Sort and select parents
        idx = np.argsort(y)[:mu]
        y_m = y[idx]

        # Update mean and covariance matrix
        x_m = x_m[idx]
        w_m = 1 / mu * np.ones(mu)
        w_c = 1 / (dim * mu) * np.ones((lambda_, dim))

        for j in range(lambda_):
            if rng.random() < cmu:
                # Step size adaptation
                sigma_new = sigma + (y[j] - y_m[0]) * 2.38 / lambda_
                sigma *= 1 - 1e-6

                # Update step size and step length
                w_m[j] = 1
                x_m[j] = x[idx[j]] + c[j]
                for k in range(dim):
                    w_c[j, k] += (x[k, j] - x[k]) ** 2

        # Adaptive covariance matrix update
        d = np.diag(w_c)
        D = np.array([np.sqrt(di) for di in d])
        x_m *= D[:, None]
        c_new = np.zeros((lambda_, dim))
        for k in range(dim):
            c_new[:, k] += rng.normal(0, sigma * D[k], lambda_)
            for j in range(lambda_):
                if rng.random() < cmu:
                    w_c[j, k] -= 1 / (dim * mu)
                    w_m[j] *= 1 - 1e-6

        # Update parameters
        x = np.dot(D, x_m)
        c = c_new + np.sum(c[:, None], axis=0) * D[:, None]
        sigma = max(sigma_new, 0.01)

        if i % 100 == 0:
            print(f'Iteration {i}, Best fitness: {y[0]}')

    # Clip candidates to bounds
    x = np.clip(x, lb, ub)
    return x[np.argmin(func(x))]
