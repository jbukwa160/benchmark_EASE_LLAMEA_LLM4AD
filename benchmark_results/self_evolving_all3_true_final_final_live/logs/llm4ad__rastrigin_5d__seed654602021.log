def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = lb + (ub - lb) * rng.rand(dim)
    y_best = func(clip(x_best))
    population_size = 50
    diversity = 0.1
    iterations_without_improvement = 0

    for i in range(budget):
        # Generate new candidates
        x_new = clip(lb + (ub - lb) * rng.rand(dim))

        # Calculate fitness and update best solution if necessary
        y_new = func(x_new)
        if y_new < y_best:
            iterations_without_improvement = 0
            y_best = y_new
            x_best = x_new

        # Adaptive restarts
        if i % (budget // population_size) == 0 and rng.rand() < diversity:
            x_best = lb + (ub - lb) * rng.rand(dim)
            iterations_without_improvement += budget // population_size

        # Elitism
        if iterations_without_improvement > budget // 2:
            break

    return clip(x_best)
