def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def fitness(x):
        x = clip(x)
        return func(x)

    n_iter = 0
    mu, sigma, c1, c2 = 10 * np.random.rand(dim), 1.0, 0.8, 1.25
    lambda_ = int(np.ceil(4 + 3 * dim**0.5))
    x = clip(rng.normal(loc=0, scale=sigma, size=(lambda_, dim)))
    y_best = fitness(x[np.random.randint(lambda_), :])

    while n_iter < budget:
        y = np.zeros((lambda_,)) + y_best
        for i in range(lambda_):
            z = rng.normal(loc=x[i, :], scale=sigma)
            t = clip(z)
            u = x[i, :] + (t - x[i, :]) * c1 * (y[i] - fitness(t))
            if i == 0 or rng.random() < np.exp(c2 * (fitness(u) - y[i])):
                x[i, :], y[i] = t, fitness(u)
        mu += 1 / (n_iter + 1) * np.dot(x.T, x) / lambda_
        sigma *= 1 + 1.1 * (budget - n_iter) / budget
        if rng.random() < 0.5:
            sigma = max(sigma * 0.99, 0.01)
        else:
            mu += rng.normal(loc=0, scale=sigma, size=(dim,))
        n_iter += 1

    x_best = np.argmin(y)
    return clip(x[x_best, :])
