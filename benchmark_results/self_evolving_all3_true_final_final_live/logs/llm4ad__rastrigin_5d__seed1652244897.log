def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    def generate_initial_pop():
        x = rng.uniform(lb, ub, size=(dim))
        return x

    def get_fitness(x):
        return func(clip(x))

    def cma_es_step(mu, sigma, pop_size, budget):
        mean = np.zeros(dim)
        cov = np.eye(dim)
        for _ in range(budget):
            x_new = np.random.multivariate_normal(mean, cov, size=pop_size)
            x_new = clip(x_new)
            f_new = get_fitness(x_new)
            idx_best = np.argmin(f_new)
            mean += (x_new[idx_best] - mean) / pop_size
            cov += np.outer((x_new[idx_best] - mean), (x_new[idx_best] - mean)) / pop_size
        return mean, cov

    def de_step(population, budget):
        mu = population.shape[0]
        sigma = 10.0
        for _ in range(budget):
            x_new = np.zeros((mu,))
            idx_choice1, idx_choice2, idx_choice3 = rng.choice(mu, size=3, replace=False)
            x_new[:] = population[idx_choice1] + rng.uniform(-sigma, sigma) * (population[idx_choice2] - population[idx_choice3])
            x_new = clip(x_new)
            f_new = get_fitness(x_new)
            idx_best = np.argmin(f_new)
            population[idx_best] = x_new
        return population

    def hybrid_step(population, budget):
        mu = population.shape[0]
        sigma = 10.0
        for _ in range(budget):
            mean, cov = cma_es_step(mu, sigma, mu, budget=1)
            x_new = np.random.multivariate_normal(mean, cov, size=mu)
            x_new = clip(x_new)
            f_new = get_fitness(x_new)
            idx_best = np.argmin(f_new)
            population[idx_best] = x_new
        return population

    def main():
        initial_population = generate_initial_pop()
        for budget_step in range(budget):
            if rng.random() < 0.5:
                initial_population = de_step(initial_population, budget_step + 1)
            else:
                initial_population = hybrid_step(initial_population, budget_step + 1)
        return np.argmin(get_fitness(initial_population))

    return main()
