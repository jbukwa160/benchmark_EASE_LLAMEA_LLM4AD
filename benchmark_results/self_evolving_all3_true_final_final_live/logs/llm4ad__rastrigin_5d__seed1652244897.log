def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    x = [rng.uniform(lb, ub) for _ in range(dim)]
    best_x = np.array(x)
    best_f = func(np.array(x))

    step_size = 10.0
    n_iter = 0

    while n_iter < budget:
        y = np.array(x) + rng.normal(0, step_size, size=dim)
        z = clip_candidate(y)
        f_z = func(z)

        if f_z < best_f:
            best_x = z
            best_f = f_z

        n_iter += 1
        step_size *= 0.9

    return np.array(best_x)
