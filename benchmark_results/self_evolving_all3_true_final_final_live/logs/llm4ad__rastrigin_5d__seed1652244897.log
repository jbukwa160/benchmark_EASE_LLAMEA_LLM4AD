def algorithm(func, dim, lb, ub, budget, rng):
    population_size = 1000
    crossover_probability = 0.8
    mutation_probability = 0.1
    num_generations = int(budget / (dim * population_size))

    def generate_initial_population(dim, lb, ub, rng):
        return [rng.uniform(lb, ub, dim) for _ in range(population_size)]

    def calculate_fitness(individuals, func):
        return [func(individual) for individual in individuals]

    def select_parents(fitnesses, population_size):
        indices = np.argsort(fitnesses)[:population_size]
        parents = [population[indices[i]] for i in range(population_size)]
        return parents

    def crossover(parents, dim, rng):
        offspring = []
        for _ in range(len(parents)):
            parent1, parent2 = np.random.choice(parents, 2, replace=False)
            child = (parent1 + parent2) / 2
            if np.random.rand() < crossover_probability:
                offspring.append(child)
            else:
                offspring.append(np.copy(parent1))
        return offspring

    def mutate(offspring, dim, lb, ub, rng):
        for i in range(len(offspring)):
            if np.random.rand() < mutation_probability:
                indices = np.random.choice(dim, 2, replace=False)
                offspring[i][indices] += rng.uniform(-1, 1)
                offspring[i] = np.clip(offspring[i], lb, ub)

    def next_generation(current_population, func):
        fitnesses = calculate_fitness(current_population, func)
        parents = select_parents(fitnesses, population_size // 2)
        offspring = crossover(parents, dim, rng)
        for i in range(len(offspring)):
            mutate(offspring[i], dim, lb, ub, rng)
        return np.concatenate([parents, offspring])

    current_population = generate_initial_population(dim, lb, ub, rng)

    for _ in range(num_generations):
        current_population = next_generation(current_population, func)

    best_individual = min(current_population, key=func)
    return best_individual
