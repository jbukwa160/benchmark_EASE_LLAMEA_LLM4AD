def algorithm(func, dim, lb, ub, budget, rng):
    n_iter_sa = int(budget * 0.3)  # 30% for SA phase
    sigma_init = 5.0
    lambda_gp = 1e-6
    kappa_gp = 10
    alpha_gp = 2
    n_iter_gp = budget - n_iter_sa

    # Simulated Annealing (SA) phase
    def sa_func(x):
        return func(x)

    bounds = [(lb, ub)] * dim
    x0 = np.random.uniform(lb, ub, size=dim)
    res_sa = differential_evolution(sa_func, bounds, x0=x0, args=[], strategy='best1exp', disp=False)

    # Gaussian Process Optimization (GPO) phase
    def gp_func(x):
        return func(x)

    x_gp = np.array([res_sa.x])
    for _ in range(n_iter_gp):
        y_gp = gp_func(x_gp)
        mean, var = predict_gp(lambda_gp, kappa_gp, alpha_gp, rng, x_gp)
        next_x_gp = sample_gp(mean, var)
        next_y_gp = gp_func(next_x_gp)

        # Update GP parameters
        lambda_gp *= 0.9
        kappa_gp += np.random.normal(0, 1e-4, size=dim)

        if next_y_gp < y_gp:
            x_gp = np.vstack((x_gp, next_x_gp))
            y_gp = next_y_gp

    # Return best solution found by GPO phase
    return x_gp[np.argmin(y_gp)]
