def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    best_x = np.random.uniform(lb, ub, size=(dim,))
    best_y = func(clip(best_x))
    
    for _ in range(budget):
        x = np.copy(best_x)
        for i in range(dim):
            candidate = np.array(x)
            candidate[i] += rng.uniform(-1.0, 1.0)
            candidate = clip(candidate)
            
            y = func(candidate)
            if y < best_y:
                best_x = candidate
                best_y = y
                
    return best_x
