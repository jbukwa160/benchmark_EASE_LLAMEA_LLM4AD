def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        x = np.clip(x, lb, ub)
        return func(x)

    def cma_es():
        sigma = 0.5
        mu = np.random.uniform(lb, ub, (1, dim))
        cov = np.eye(dim) * 1e-6
        for _ in range(budget):
            step_size = sigma * np.sqrt(np.diag(cov))
            new_mu = mu + np.random.multivariate_normal(np.zeros(dim), cov)
            new_mu = np.clip(new_mu, lb, ub)
            new_fitness = f(new_mu)
            old_fitness = func(mu)
            if new_fitness < old_fitness:
                mu = new_mu
                cov += 0.1 * (step_size**2) * np.eye(dim)
            else:
                cov *= 0.99
        return mu

    def pso():
        swarm = rng.uniform(lb, ub, (100, dim))
        velocities = np.zeros((100, dim))
        for _ in range(budget):
            for i in range(100):
                velocity = velocities[i] + 0.5 * rng.normal(size=dim)
                new_position = swarm[i] + velocity
                new_position = np.clip(new_position, lb, ub)
                fitness = f(new_position)
                old_fitness = func(swarm[i])
                if fitness < old_fitness:
                    swarm[i] = new_position
                    velocities[i] = velocity
        return np.mean(swarm, axis=0)

    def hybrid():
        cma = cma_es()
        pso_swarm = pso()
        for _ in range(budget):
            cma_f = func(cma)
            pso_f = func(pso_swarm)
            if cma_f < pso_f:
                return cma
            else:
                return pso_swarm

    return hybrid()
