def algorithm(func, dim, lb, ub, budget, rng):
    def generate_population(size, dim):
        return (ub - lb) * rng.rand(size, dim) + lb

    def evaluate(population):
        fitness = []
        for x in population:
            value = func(x)
            fitness.append(value)
        return np.array(fitness)

    def select_parents(population, fitness, size):
        indices = np.argsort(fitness)[:size]
        parents = population[indices]
        return parents

    def crossover(parents, dim):
        children = np.zeros((len(parents), dim))
        for i in range(len(parents)):
            mid_point = rng.rand(dim)
            for j in range(dim):
                if rng.rand() < 0.5:
                    children[i, j] = (parents[i, j] + parents[(i+1) % len(parents), j]) / 2
        return children

    def mutate(children, lb, ub):
        mutation_rate = 0.01
        mutated_children = np.copy(children)
        for i in range(len(mutated_children)):
            for j in range(dim):
                if rng.rand() < mutation_rate:
                    mutated_children[i, j] += (ub - lb) * rng.randn()
                    mutated_children[i, j] = max(lb, min(ub, mutated_children[i, j]))
        return mutated_children

    def gradient_free_search(func, x0, lb, ub, budget):
        best_x = x0
        best_f = func(x0)
        for _ in range(budget):
            new_x = np.copy(best_x) + 0.01 * (ub - lb) * rng.randn()
            new_x = max(lb, min(ub, new_x))
            f = func(new_x)
            if f < best_f:
                best_x = new_x
                best_f = f
        return best_x

    population = generate_population(size=100, dim=dim)
    for _ in range(budget):
        fitness = evaluate(population)
        parents = select_parents(population, fitness, size=50)
        children = crossover(parents, dim)
        mutated_children = mutate(children, lb, ub)
        new_population = np.concatenate((population, mutated_children))
        best_x = gradient_free_search(func, population[np.argmin(fitness)], lb, ub, 10)
        if func(best_x) < func(population[np.argmin(fitness)]):
            population = np.array([best_x])
    return population[0]
