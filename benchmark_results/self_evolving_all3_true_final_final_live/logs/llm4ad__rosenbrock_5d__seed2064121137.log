def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x)

    x0 = rng.uniform(lb, ub, (dim,))
    best_x = x0
    best_f = float('inf')
    cma_history = [np.zeros((1, dim))]

    for i in range(budget):
        sigma = np.exp(np.log(np.sqrt(ub - lb) / 5.0) * (i + 1) / budget)
        distribution = np.random.multivariate_normal(x0, sigma**2 * np.eye(dim))
        candidates = clip(distribution)

        f_values = [evaluate(candidate) for candidate in candidates]
        next_x = candidates[np.argmin(f_values)]
        cma_history.append(np.array([next_x]))

        if f_values[0] < best_f:
            best_x = next_x
            best_f = f_values[0]

        if np.linalg.norm(best_x - x0) > 1e-3 and i > budget / 2:
            x0 = rng.uniform(lb, ub, (dim,))
            cma_history.append(np.zeros((1, dim)))

    return clip(best_x)
