def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    n = len(dim)
    pop_size = 50
    candidates = [clip(rng.uniform(-5, 5, n)) for _ in range(pop_size)]
    best_so_far = [None]*pop_size

    for i in range(budget):
        fitnesses = [func(c) for c in candidates]
        best_candidate_idx = np.argmin(fitnesses)
        best_candidate = clip(candidates[best_candidate_idx])
        best_so_far[best_candidate_idx] = tuple(best_candidate)

        if np.min([f(x=best_so_far[j]) for j in range(pop_size)]) <= np.min(fitnesses):
            candidates = [np.array(best_so_far[rng.choice(range(pop_size))]) + 0.5*rng.uniform(-1, 1, n) for _ in range(pop_size)]
        else:
            mutant = []
            for k in range(n):
                r1, r2, r3 = rng.choice(range(pop_size), size=3, replace=False)
                if np.random.rand() < 0.5:
                    mutant.append(best_candidate[k] + rng.uniform(-1, 1)*(best_so_far[r1][k]-best_so_far[r2][k]))
                else:
                    mutant.append(best_candidate[k] + rng.uniform(-1, 1)*(best_so_far[r3][k]-best_so_far[r1][k]))
            candidates = [clip(mutant[k] + 0.5*rng.uniform(-1, 1, n)[k]) for k in range(n)]

        fitnesses = [func(c) for c in candidates]

    best_idx = np.argmin(fitnesses)
    return clip(candidates[best_idx])
