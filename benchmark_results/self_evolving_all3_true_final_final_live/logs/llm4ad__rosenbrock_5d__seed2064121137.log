def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n = int(budget)
    init_X = np.random.uniform(lb, ub, (n, D))
    Y = func(init_X)

    for i in range(n-1):
        gp_model = GaussianProcessRegressor()
        gp_model.fit(init_X[:i+1], Y[:i+1])
        
        mean, std = gp_model.predict(np.linspace(lb, ub, 1000).reshape(-1, D), return_std=True)
        EI = AcquisitionFunctionEI(gp_model, np.argmax(Y[:i+1]))
        next_x = optimize_next_x(EI, lb, ub)

        new_X = np.clip(next_x, lb, ub)
        new_Y = func(new_X)
        
        init_X = np.vstack((init_X, new_X))
        Y = np.hstack((Y, new_Y))

    best_idx = np.argmin(Y[1:])
    return init_X[best_idx+1]
