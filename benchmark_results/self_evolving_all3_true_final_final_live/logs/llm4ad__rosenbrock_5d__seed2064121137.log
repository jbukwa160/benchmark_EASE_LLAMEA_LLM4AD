def algorithm(func, dim, lb, ub, budget, rng):
    def bounded_candidate(x):
        x = np.clip(x, lb, ub)
        return x

    T = 1.0
    best_x = rng.uniform(lb, ub, size=dim)
    f_best = func(best_x)

    for _ in range(budget):
        x = bounded_candidate(rng.normal(size=dim))
        delta_f = func(x) - f_best
        if delta_f < 0:
            f_best = func(x)
            best_x = x
        else:
            p = np.exp(-delta_f / T)
            if rng.uniform(0, 1) < p:
                f_best = func(x)
                best_x = x

        # adaptive cooling schedule
        T *= 0.99999

    return best_x
