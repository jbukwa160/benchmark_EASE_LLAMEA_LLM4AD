def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = len(dim)
    bounds = [(lb[i], ub[i]) for i in range(D)]
    
    x = [rng.uniform(lb[i], ub[i]) for i in range(D)]
    x = np.array(x)
    best_x = x.copy()
    best_f = float('inf')
    
    T = 1.0
    alpha = 0.99
    
    def DEstep(x):
        a, b, c = rng.choice(D, size=3, replace=False), rng.choice(D, size=2, replace=True)
        u = x.copy()
        v = clip(u + 0.5*(x[b] - x[a]) + rng.uniform(-1, 1)*(bounds[b][1] - bounds[b][0]))
        return v
    
    for _ in range(budget):
        if rng.random() < 0.1:
            new_x = DEstep(x)
        else:
            step = T * np.log(1 / (T + 1))
            new_x = x + step * rng.normal(size=D)
            new_x = clip(new_x)
        
        f_new = func(new_x)
        if f_new < best_f:
            best_f = f_new
            best_x = new_x.copy()
        
        if f_new < func(x):
            x = new_x.copy()
            T *= alpha
        
    return best_x
