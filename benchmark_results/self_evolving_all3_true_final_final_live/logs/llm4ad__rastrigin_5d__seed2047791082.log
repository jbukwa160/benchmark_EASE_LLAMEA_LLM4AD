def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def crossover(parent1, parent2):
        if rng.rand() < 0.5:
            child = (parent1 + parent2) / 2
        else:
            child = (parent1 - parent2) * rng.uniform(-1, 1)
        return clip(child)

    def mutation(x, F):
        u = rng.normal(size=dim)
        v = rng.normal(size=dim)
        trial = x + F * (u / np.linalg.norm(u)) + F * (v / np.linalg.norm(v))
        return clip(trial)

    pop_size = 50
    population = rng.uniform(lb, ub, size=(pop_size, dim))

    for _ in range(budget):
        scores = [func(ind) for ind in population]
        best_idx = np.argmax(scores)
        if scores[best_idx] < func(population[best_idx]):
            population[best_idx] = pop_size * rng.uniform(lb, ub, size=dim)

        F = 0.1 + (np.max(scores) - scores[best_idx]) / np.sum(scores)
        for i in range(pop_size):
            trial = mutation(population[i], F)
            if func(trial) < func(population[i]):
                population[i] = trial

    best_individual = population[np.argmax([func(ind) for ind in population])]
    return best_individual
