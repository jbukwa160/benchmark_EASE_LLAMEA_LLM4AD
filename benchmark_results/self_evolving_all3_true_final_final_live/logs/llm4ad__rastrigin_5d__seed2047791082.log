def algorithm(func, dim, lb, ub, budget, rng):
    def surrogate(x):
        return -func(x)

    x0 = (ub + lb) / 2 * np.ones(dim)
    bounds = [(lb, ub)] * dim

    res = minimize(surrogate, x0, method='SLSQP', bounds=bounds)

    x_best = res.x
    f_best = -res.fun

    GP = GaussianProcessRegressor(kernel=1.0 * RBF(length_scale=np.ones(dim)), n_restarts_cholesky=10)
    GP.fit(np.array([[x_best]]), np.array([f_best]))

    for i in range(1, budget):
        x_candidate = GP.sample_conditional(mean=np.zeros(dim), sigma=np.ones(dim), size=1)[0]
        f_candidate = func(x_candidate)

        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate

        GP.fit(np.vstack((np.array([[x_best]]), np.array([[x_candidate]]))), np.array([f_best, f_candidate]))

    return np.clip(x_best, lb, ub)
