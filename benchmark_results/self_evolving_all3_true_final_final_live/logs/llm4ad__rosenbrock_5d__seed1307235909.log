    pop = rng.uniform(lb, ub, (budget, dim))
    best_sol = None
    best_fitness = float('inf')

    for _ in range(budget):
        X = pop.copy()
        V = rng.normal(size=(budget, dim))

        for i in range(1, budget):
            u = rng.uniform(0, 1, size=dim)
            v = np.dot(V[i], (u ** 2).reshape(-1, 1))
            x_new = clip(X[i - 1] + u * v)

            X[i] = x_new
            V[i] += rng.normal(size=dim) / (1 + i)

        mean_pop = np.mean(pop, axis=0)
        cov_pop = np.cov(np.transpose(pop), bias=True)
