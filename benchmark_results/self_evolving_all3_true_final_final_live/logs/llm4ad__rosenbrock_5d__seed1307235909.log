def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        learning_rate = 1 / (rng.rand() + 0.01) * 0.001
        noise = rng.randn(dim)
        new_x = x + learning_rate * noise
        new_x = np.clip(new_x, lb, ub)

        new_f = func(new_x)
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f

        prob_accept = np.exp((best_f - new_f) / 10)
        if rng.rand() < prob_accept:
            x = new_x.copy()

    return best_x
