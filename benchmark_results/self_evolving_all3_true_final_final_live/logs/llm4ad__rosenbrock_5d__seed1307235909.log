def algorithm(func, dim, lb, ub, budget, rng):
    def direct_lbfgsb(x0, func, lb, ub, max_iter=10000, tol=1e-6):
        from scipy.optimize import differential_evolution, minimize
        def func_wrapper(x):
            return func(np.clip(x, lb, ub))
        
        def direct_func(x):
            return -func_wrapper(x)
        
        bounds = [(lb[i], ub[i]) for i in range(dim)]
        result_de = differential_evolution(direct_func, bounds=bounds, maxiter=max_iter, tol=tol)
        x0 = result_de.x
        
        result_lbfgsb = minimize(func_wrapper, x0, method="L-BFGS-B", bounds=bounds, options={'disp': False})
        
        return result_lbfgsb.x
    
    best_x = np.random.uniform(lb, ub, size=(dim,))
    
    for _ in range(budget):
        new_x = direct_lbfgsb(best_x, func, lb, ub)
        if func(new_x) < func(best_x):
            best_x = new_x
            
    return np.clip(best_x, lb, ub)
