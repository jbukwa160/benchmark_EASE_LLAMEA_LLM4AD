def algorithm(func, dim, lb, ub, budget, rng):
    def wrapped_func(x):
        return func(x)

    num_evals = 0
    best_x = rng.uniform(lb, ub, size=dim)
    best_f = wrapped_func(best_x)

    for _ in range(budget):
        X_gp = np.vstack((best_x[None], lb + (ub - lb) * rng.uniform(size=(budget-1, dim))))
        y_gp = np.concatenate(([best_f], [wrapped_func(x) for x in X_gp[1:]]))

        from sklearn.gaussian_process import GaussianProcessRegressor
        from sklearn.gaussian_process.kernels import ConstantKernel as C, RBF

        kernel = C(1.0) * RBF(length_scale=1.0)
        gpr = GaussianProcessRegressor(kernel=kernel, n_restarts_optimizer=5)

        gpr.fit(X_gp, y_gp)

        x_next = X_gp[np.argmax(gpr.predict(X_gp))]

        if wrapped_func(x_next) < best_f:
            best_x = x_next
            best_f = wrapped_func(best_x)
            num_evals += 1

        else:
            x_next -= np.array([0.01, 0.01]) * gpr.sample_fidelity(X_gp)

            if np.all(lb <= x_next) and np.all(x_next <= ub):
                num_evals += 1
                best_x = x_next
                best_f = wrapped_func(best_x)
            else:
                x_next = rng.uniform(lb, ub, size=dim)
                while not np.all(lb <= x_next) or not np.all(x_next <= ub):
                    x_next = rng.uniform(lb, ub, size=dim)

        if num_evals >= budget:
            break

    return best_x
