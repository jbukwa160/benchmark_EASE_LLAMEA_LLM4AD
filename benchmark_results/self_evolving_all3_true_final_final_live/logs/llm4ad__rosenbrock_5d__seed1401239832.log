def algorithm(func, dim, lb, ub, budget, rng):
    def func_wrap(x):
        x = np.clip(x, lb, ub)
        return func(x)

    n_dim = dim
    n_gen = budget // (n_dim * 5) + 1
    sigma = 0.7
    mu = rng.rand(n_dim)
    sigma_best = sigma
    for i in range(1, n_gen):
        x = np.clip(mu + rng.randn(n_dim) * sigma, lb, ub)
        fx = func_wrap(x)
        if fx < func_wrap(mu):
            mu = x
            sigma_best = max(sigma_best, 0.5 * (i ** 2 / i + 1))
        else:
            step_size = 0.9 * rng.rand(n_dim) + 0.01
            for j in range(n_dim):
                x[j] = mu[j] + step_size[j] * np.sign(rng.randn())
                x[j] = np.clip(x[j], lb, ub)
            fx_new = func_wrap(x)
            if fx_new < fx:
                mu = x
        sigma = min(sigma_best, 0.5 * (i ** 2 / i + 1))
    return mu
