def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def nelder_mead(x0, func, dim, maxiter=1000, tol=1e-6):
        x = x0
        y = func(x)
        best_x = x.copy()
        best_y = y
        for _ in range(maxiter):
            z = x + 0.5 * (x - np.roll(x, 1))
            z = clip(z, lb, ub)
            yz = func(z)
            if yz < best_y:
                best_x = z.copy()
                best_y = yz
            elif yz == best_y and rng.random() < 0.5:
                x[np.argmin(y)] += 0.1 * (x - np.roll(x, 1))[np.argmin(y)]
                x = clip(x, lb, ub)
        return best_x

    def simulated_annealing(x0, func, dim, T=100, tcool=0.99, maxiter=1000):
        x = x0
        T = T * (tcool ** np.arange(maxiter))
        for i in range(maxiter):
            y = func(x)
            z = clip(x + rng.uniform(-1, 1, dim), lb, ub)
            yz = func(z)
            if yz < y:
                x = z
            elif rng.random() < np.exp((y - yz) / T[i]):
                x = z
        return x

    def hybrid(x0, func, dim, lb, ub, budget):
        best_x = x0
        for i in range(budget):
            x1 = simulated_annealing(best_x, func, dim)
            x2 = nelder_mead(x1, func, dim)
            if func(x2) < func(best_x):
                best_x = x2
        return best_x

    x0 = (ub + lb) / 2 * np.ones(dim)
    budget /= dim
    return hybrid(x0, func, dim, lb, ub, int(budget))
