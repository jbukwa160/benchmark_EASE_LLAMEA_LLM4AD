def algorithm(func, dim, lb, ub, budget, rng):
    def grad(x):
        return 2 * np.sum(200 * x[:-1] * (x[1:] - x[:-1]**2) + 2 * (x[:-1] - 1), axis=0)

    def laplace_approx(x):
        mean = func(x)
        var = np.sum((grad(x))**2, axis=0)
        return mean, var

    dim = int(dim)
    x_best = rng.uniform(lb, ub, size=(dim,))
    f_best = func(x_best)
    for i in range(budget):
        mean, var = laplace_approx(x_best)
        std = np.sqrt(var)
        xi = x_best + (ub - lb) * rng.normal(size=(dim,)) / np.sqrt(dim)
        xi = np.clip(xi, lb, ub)
        fi = func(xi)
        if fi < f_best:
            f_best = fi
            x_best = xi
        else:
            ei = mean + 1e-8 + std * (np.log(ub - lb) / np.sqrt(np.pi)) * (1 + np.exp(-((xi - x_best) / (0.5 * (ub - lb)))**2))
            if rng.uniform() < ei:
                x_best = xi
    return x_best
