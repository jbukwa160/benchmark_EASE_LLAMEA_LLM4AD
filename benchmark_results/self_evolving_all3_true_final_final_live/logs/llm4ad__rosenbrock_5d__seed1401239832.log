def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    current = rng.uniform(lb, ub, size=dim)
    best = np.copy(current)
    temperature = 1.0

    for _ in range(budget):
        # Simulated Annealing part
        mutated = np.copy(current)
        for i in range(dim):
            if rng.random() < 0.01:
                mutated[i] += rng.uniform(-temperature, temperature)
            elif rng.random() < 0.02:
                mutated[i] -= rng.uniform(temperature, 2*temperature)

        # Clip the candidate
        mutated = clip(mutated)

        # Calculate the function value for the candidate and the current point
        f_mutated = func(mutated)
        f_current = func(current)

        # Differential Evolution part
        if f_mutated < f_current:
            current = np.copy(mutated)
            best = np.copy(mutated)
            temperature *= 0.99

        # Simulated Annealing acceptance criterion
        elif rng.random() < np.exp((f_current - f_mutated) / temperature):
            current = np.copy(mutated)

    return best
