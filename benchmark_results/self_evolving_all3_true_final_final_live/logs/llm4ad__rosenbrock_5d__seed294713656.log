def algorithm(func, dim, lb, ub, budget, rng):
    def func_wrapper(x):
        return func(x)

    x = lb + (ub - lb) * rng.rand(dim)
    x_best = x.copy()
    best_obj = func_wrapper(x_best)
    temp = 1.0
    alpha = 0.99
    beta = 0.01

    for _ in range(budget):
        for i in range(dim):
            delta = np.zeros(dim)
            delta[i] = rng.normal(0, 1)
            x_new = x + delta

            # Clip candidates to [lb, ub]
            x_new = np.clip(x_new, lb, ub)

            obj_new = func_wrapper(x_new)
            if obj_new < best_obj:
                x_best = x_new.copy()
                best_obj = obj_new
            elif rng.rand() < 0.01:  # 1% chance to accept worse solution for exploration
                x = x_new.copy()

        temp *= alpha
        if temp < beta:
            x = x_best.copy()
            temp = beta

    return x_best
