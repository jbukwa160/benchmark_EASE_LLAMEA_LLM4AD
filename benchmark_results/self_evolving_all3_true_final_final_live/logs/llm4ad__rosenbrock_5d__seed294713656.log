def algorithm(func, dim, lb, ub, budget, rng):
    def logprior(x):
        return -0.5 * np.sum((x - 1) ** 2)

    def loglike(x):
        return -func(x)

    def posterior_logprob(x):
        lp = logprior(x)
        ll = loglike(x)
        return lp + ll

    x = rng.uniform(lb, ub, size=dim)
    prev_best = np.inf
    for i in range(budget):
        log_prob = posterior_logprob(x)
        if log_prob < -1e30:
            continue
        candidate = np.exp(log_prob) / (np.exp(-loglike(x)) + 1e-8)
        new_x = x + rng.normal(size=dim, scale=0.01)
        new_candidate = np.exp(posterior_logprob(new_x)) / (np.exp(-loglike(new_x)) + 1e-8)
        ucb = candidate * new_candidate
        if ucb > np.random.rand():
            x = new_x
        value = func(x)
        if value < prev_best:
            prev_best = value
    return x
