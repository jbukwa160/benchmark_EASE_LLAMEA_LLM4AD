def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(np.clip(x, lb, ub))

    def cma_es_step():
        mean = 1.0 * np.ones(dim)
        cov = 1e-4 * np.eye(dim)

        for i in range(budget):
            n_candidate = 20
            candidates = rng.multivariate_normal(mean, cov, n_candidate)

            fitnesses = f(candidates.T).T

            best_idx = np.argmin(fitnesses)
            best_candidate = candidates[best_idx]

            if f(best_candidate) < np.min(fitnesses):
                mean = (1 - 0.01) * mean + 0.01 * best_candidate
                cov = 0.9 * cov + 0.1 * (best_candidate[:, None] - mean[:, None]).dot((best_candidate[:, None] - mean[:, None]).T)
            else:
                cov = 0.5 * cov

        return np.clip(mean, lb, ub)

    best_candidate = cma_es_step()
    return best_candidate
