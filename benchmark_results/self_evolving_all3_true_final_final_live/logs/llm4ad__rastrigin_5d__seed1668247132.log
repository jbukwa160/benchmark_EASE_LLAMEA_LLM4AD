def algorithm(func, dim, lb, ub, budget, rng):
    def init_sigma():
        return 0.5 * (ub - lb)

    def generate_candidate(x, sigma):
        return x + sigma * rng.normal(size=dim)

    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    n_candidates = int(np.sqrt(budget))
    best_x = rng.uniform(lb, ub, size=dim)
    best_fx = func(best_x)
    best_candidate = best_x

    sigma = init_sigma()
    for _ in range(n_candidates):
        x = generate_candidate(best_x, sigma)
        fx = func(clip(x, lb, ub))
        if fx < best_fx:
            best_x = x
            best_fx = fx
            best_candidate = x

        x_new = rng.uniform(lb, ub, size=dim)
        if func(clip(x_new, lb, ub)) < best_fx:
            sigma = init_sigma()
            best_x = x_new
            best_fx = func(best_x)
            best_candidate = best_x

    return best_candidate
