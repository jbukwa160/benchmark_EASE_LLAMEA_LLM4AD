def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 10.0 * (ub - lb) / (1 + np.log(budget))
    a = 0.5 * (ub - lb)
    c = 2.0 / dim
    k = 0

    while budget > 0:
        for i in range(dim):
            r1, r2, r3 = rng.uniform(0, 1), rng.uniform(0, 1), rng.uniform(0, 1)
            x_new = x.copy()
            x_new[i] += a * (r1 - 0.5) + c * r2 * (x[i] - lb) - c * r3 * (ub - x[i])

        if np.all(x_new >= lb) and np.all(x_new <= ub):
            f_new = func(x_new)
            f_current = func(x)

            if f_new < f_current:
                x = x_new
                budget -= 1

        else:
            beta = np.exp(-(budget - k) / (T * rng.uniform(0, 1)))
            k += 1

            for i in range(dim):
                r2, r3 = rng.uniform(-1, 1), rng.uniform(-1, 1)
                x_new = x.copy()
                x_new[i] = lb + np.random.choice([-r2 * a, r3 * a]) + c * (x[i] - lb) + beta * (x_new[i] - x[i])

            if np.all(x_new >= lb) and np.all(x_new <= ub):
                f_new = func(x_new)
                f_current = func(x)

                if f_new < f_current:
                    x = x_new
                    budget -= 1

    return x
