def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_population():
        return rng.uniform(lb, ub, (budget, dim))

    def mutation(population, index):
        c1 = rng.normal(0, 1)
        c2 = rng.choice(budget)
        c3 = rng.choice(dim)
        candidate = population[c2] + c1 * (population[index] - 2 * lb) if rng.random() < 0.5 else population[index]
        return clip(candidate)

    def crossover(population, index):
        c1 = rng.uniform(0, 1)
        candidate = c1 * population[index] + (1 - c1) * mutation(population, index)
        return clip(candidate)

    def acceptance(old_fitness, new_fitness, temperature):
        return new_fitness < old_fitness or np.exp((old_fitness - new_fitness) / temperature) > rng.random()

    population = generate_population()
    best_candidate = np.copy(population[0])
    best_fitness = func(best_candidate)
    temperature = 1.0

    for i in range(1, budget):
        candidate = crossover(population, i-1)
        fitness = func(candidate)

        if acceptance(best_fitness, fitness, temperature):
            population[i] = np.copy(candidate)
            best_candidate = np.copy(candidate)
            best_fitness = fitness
            temperature *= 0.99

    return best_candidate
