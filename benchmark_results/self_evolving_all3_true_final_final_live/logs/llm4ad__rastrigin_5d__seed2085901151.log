def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        return func(x)

    x = rng.uniform(lb, ub, size=dim)
    x_best = x.copy()
    f_best = evaluate(x)

    for _ in range(budget):
        # Differential Evolution
        y = clip(x + 0.5 * rng.normal(size=dim))
        if evaluate(y) < f_best:
            x_best = y.copy()
            f_best = evaluate(y)
        
        # Local Search (Simulated Annealing)
        t = 1000 / (_+1)
        for _ in range(int(ub - lb)):
            z = clip(x_best + rng.uniform(-t, t))
            if evaluate(z) < f_best:
                x_best = z.copy()
                f_best = evaluate(z)

    return x_best
