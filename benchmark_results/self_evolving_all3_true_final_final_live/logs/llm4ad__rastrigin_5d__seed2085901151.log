def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def f(x):
        x = clip(x)
        return func(x)

    best_x = None
    best_f = float('inf')
    for _ in range(budget):
        x0 = lb + (ub - lb) * rng.uniform(size=dim)
        for t in range(100):
            sigma_t = 1 / np.sqrt(t + 1)
            x = x0 + sigma_t * rng.normal(size=dim)
            if f(x) < best_f:
                best_x = x
                best_f = f(x)
            p = 1 / (t + 1)
            for _ in range(10):
                idx = np.random.choice(dim, size=int(np.sqrt(dim)), replace=False)
                x[idx] += sigma_t * rng.normal(size=len(idx))
                if f(x) < best_f:
                    best_x = x
                    best_f = f(x)
        if best_f < 1e-6:  # restart
            break
    return best_x
