def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_process(X, Y):
        theta = 1e-6 * rng.rand(dim)
        sigma2 = 1e-3 + 0.5 * rng.randn()
        K = np.exp(-np.sum((X[:, None] - X[None, :])**2 / (2*theta**2), axis=2))
        alpha = np.linalg.solve(K + sigma2*np.eye(dim), Y)
        return lambda x: np.dot(x, alpha) + np.sqrt(np.diag(np.dot(x.T, K @ alpha))) * rng.randn()

    def differential_evolution(X, Y):
        f, d = func, dim
        mu, sigma = 0, 1
        while True:
            X_new = X.copy()
            for i in range(d):
                x_best = np.argmax(Y)
                X_new[i] = lb + (ub - lb) * rng.uniform(0, 1)
                if f(X_new) < f(X[x_best]):
                    Y[x_best] = f(X[x_best])
                else:
                    Y[i] = f(X_new)
            yield X_new

    def surrogate_assisted_DE(func, dim, lb, ub, budget, rng):
        X = np.random.uniform(lb, ub, (budget, dim))
        Y = func(X)
        gp = gaussian_process(X, Y)
        for x in differential_evolution(X, Y):
            f_x = gp(x)
            if f_x < min(Y):
                X[-1] = x
                Y[-1] = f_x
        return np.argmin(Y)

    return surrogate_assisted_DE(func, dim, lb, ub, budget, rng).reshape(-1,)
