def algorithm(func, dim, lb, ub, budget, rng):
    def surrogate(x):
        return 1e6 * np.sum((x**2 - 10*np.cos(2*np.pi*x)) + 10*dim)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        # Sample a candidate
        mu = uniform(loc=lb, scale=ub-lb).rvs(size=1)[0]
        sigma = (ub - lb) / 10.0
        x_candidate = norm.rvs(loc=mu, scale=sigma, size=dim)

        # Clip to bounds
        x_candidate = np.clip(x_candidate, lb, ub)

        # Evaluate and update best
        f_candidate = func(x_candidate)
        if f_candidate < f_best:
            x_best = x_candidate.copy()
            f_best = f_candidate

        # Update surrogate
        x_surrogate = (x_best + x_candidate) / 2.0
        f_surrogate = (f_best + func(x_candidate)) / 2.0
        surrogate_value = surrogate(x_surrogate)
        
        # Gaussian process update
        def gp_logpdf(x):
            mu_gp = np.mean(surrogate_value - surrogate(x))
            sigma_gp = np.std(surrogate_value - surrogate(x))
            return norm.logpdf(mu_gp, loc=mu_gp, scale=sigma_gp)

        x_next = uniform(loc=lb, scale=ub-lb).rvs(size=dim)
        if gp_logpdf(x_candidate) > 0.1:
            x_next = x_candidate.copy()
        
        # Differential evolution
        v1 = x_best - np.random.uniform(lb, ub, size=dim)
        v2 = x_surrogate - np.random.uniform(lb, ub, size=dim)
        candidate = (v1 + v2) / 2.0

        # Clip to bounds
        candidate = np.clip(candidate, lb, ub)

        # Evaluate and update best
        f_candidate = func(candidate)
        if f_candidate < f_best:
            x_best = candidate.copy()
            f_best = f_candidate

    return x_best
