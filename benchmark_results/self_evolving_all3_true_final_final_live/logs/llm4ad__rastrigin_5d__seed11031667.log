def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        return func(x)

    X = np.random.uniform(lb, ub, (budget, dim))
    Y = np.zeros(budget)
    for i in range(budget):
        x = X[i]
        y = evaluate(clip(x))
        Y[i] = y

    gp = GaussianProcessRegressor(kernel=Matern(nu=2.5), alpha=np.ones(budget) * 1e-6)
    gp.fit(X, Y)

    best_x = np.zeros(dim)
    best_y = np.inf
    for i in range(budget):
        x = X[i]
        y = evaluate(clip(x))
        mu, sigma = gp.predict(np.array([x]), return_std=True)
        if y < best_y:
            best_y = y
            best_x = clip(x)

    return best_x
