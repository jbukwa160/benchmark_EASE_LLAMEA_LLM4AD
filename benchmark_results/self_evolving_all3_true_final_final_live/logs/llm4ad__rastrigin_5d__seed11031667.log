def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    sigma = 0.5
    T_max = 1000
    cooling_rate = 0.99
    crossover_prob = 0.9
    mutation_prob = 0.1
    
    x = np.random.uniform(lb, ub, (pop_size, dim))
    
    for t in range(T_max):
        y = np.copy(x)
        
        for i in range(pop_size):
            if rng.rand() < crossover_prob:
                idx = rng.choice(pop_size, size=3, replace=False)
                v1, v2, v3 = x[idx]
                y[i] = (v1 + sigma * rng.randn(dim)) / 2 + (v2 - v3) / 2
            if rng.rand() < mutation_prob:
                y[i] += sigma * rng.randn(dim)
        
        y = np.clip(y, lb, ub)
        f_y = func(y)
        
        x = np.where(f_y < func(x), y, x)
        
    return x[np.argmin(func(x))]
