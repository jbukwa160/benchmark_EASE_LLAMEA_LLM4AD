def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    step_size = 1.0
    for _ in range(budget):
        gradient = np.zeros(dim)
        for i in range(dim):
            x_plus_eps = clip(x + step_size * rng.uniform(-1, 1, size=dim))
            x_minus_eps = clip(x - step_size * rng.uniform(-1, 1, size=dim))
            gradient[i] = (func(x_plus_eps) - best_f) / step_size + (best_f - func(x_minus_eps)) / step_size
        x -= np.sign(gradient) * step_size ** 2

        if func(x) < best_f:
            best_x = x.copy()
            best_f = func(x)

    return best_x
