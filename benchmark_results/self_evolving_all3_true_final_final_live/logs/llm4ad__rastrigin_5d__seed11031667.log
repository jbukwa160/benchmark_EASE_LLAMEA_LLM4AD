def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x)

    n = len(rng)
    x_best = None
    f_best = np.inf

    for _ in range(budget):
        # Selection
        x = rng.normal(size=dim)
        f = evaluate(clip(x, lb, ub))

        if f < f_best:
            x_best = clip(x, lb, ub)
            f_best = f

        # Mutation
        mu = 1.0 / np.sqrt(_ + 1)
        delta = rng.normal(size=(dim, n)) * mu
        z = x + delta

        # Polynomial mutation
        for i in range(dim):
            beta = 3.0 if z[i] < lb else (ub - z[i]) / (ub - lb) ** 2
            p = 1 + rng.uniform(-beta, beta)
            z[i] = lb + (ub - lb) * np.power(p, 20)

        # Replacement
        f_z = evaluate(clip(z, lb, ub))
        if f_z < f_best:
            x_best = clip(z, lb, ub)
            f_best = f_z

    return x_best
