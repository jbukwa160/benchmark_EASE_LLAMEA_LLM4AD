def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_y = func(x)

    for _ in range(budget):
        # Differential Evolution step
        v = rng.uniform(lb, ub, size=dim)
        u = np.where(rng.random(dim) < 0.5, x + v, x - v)
        u = np.clip(u, lb, ub)
        y = func(u)

        if y < best_y:
            best_x = u.copy()
            best_y = y

        # Gradient-based local search step
        h = rng.uniform(-1e-3, 1e-3, size=dim)
        x += h
        x = np.clip(x, lb, ub)

        y = func(x)

        if y < best_y:
            best_x = x.copy()
            best_y = y

    return best_x
