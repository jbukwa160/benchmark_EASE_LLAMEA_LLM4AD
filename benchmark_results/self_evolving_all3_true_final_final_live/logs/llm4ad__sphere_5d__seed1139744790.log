def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    for _ in range(budget):
        x_new = x_best + (ub - lb) * rng.uniform(size=dim)
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
            
    return x_best
