def algorithm(func, dim, lb, ub, budget, rng):
    def grad(x):
        return 2 * (x[1:] - x[:-1]**2)[:, None] * 200 * (x[1:] - x[:-1]**2) + 2 * (x[:-1] - 1)

    x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_fx = func(x)
    
    for _ in range(budget):
        step_size = rng.uniform(0.01, 0.1)
        direction = rng.choice([-1, 1], size=dim)
        
        new_x = x + step_size * direction
        new_x = np.clip(new_x, lb, ub)
        
        new_fx = func(new_x)
        
        if new_fx < best_fx:
            best_fx = new_fx
            best_x = new_x.copy()
            
        grad_value = grad(x)
        if rng.uniform(0, 1) > 0.5:
            x += step_size * grad_value
        else:
            x += np.sign(grad_value) * step_size
        
        x = np.clip(x, lb, ub)
    
    return best_x
