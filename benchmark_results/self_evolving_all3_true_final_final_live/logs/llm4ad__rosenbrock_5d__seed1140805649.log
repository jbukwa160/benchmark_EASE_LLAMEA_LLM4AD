def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_fitness = func(x)
    
    for _ in range(budget):
        # Differential Evolution
        candidate = x + 0.5 * rng.normal(0, 1, x.shape)[:, np.newaxis] * (x - rng.permutation(x))
        
        # Random Search
        if rng.uniform() < 0.2:
            candidate = clip(rng.uniform(lb, ub, (1, dim)))
        
        # Evaluate the candidate and update best solution if necessary
        candidate_fitness = func(candidate)
        if candidate_fitness < best_fitness:
            best_x = candidate.copy()
            best_fitness = candidate_fitness
            
        x = np.clip(x + 0.01 * rng.normal(0, 1, x.shape), lb, ub)
    
    return best_x
