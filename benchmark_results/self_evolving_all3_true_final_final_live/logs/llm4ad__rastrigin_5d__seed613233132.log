def algorithm(func, dim, lb, ub, budget, rng):
    D = np.random.uniform(lb, ub, (budget, dim))
    
    for i in range(1, budget):
        p = np.exp(-i / budget)
        
        X = (1 - p) * D[i-1] + p * np.clip(np.random.normal(size=(dim,), loc=0.5, scale=0.3), lb, ub)
        
        y_i = func(X)
        y_i_1 = func(D[i-1])
        
        if y_i < y_i_1:
            D[i] = X
            
    return np.argmin(np.array([func(x) for x in D]), axis=0)
