def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Differential evolution mutation
        v = rng.normal(size=dim)
        u = np.clip(best_x + 0.5 * v, lb, ub)
        
        # Simulated annealing acceptance probability
        T = 100 / (1 + _)
        alpha = 0.9
        
        if func(u) < best_f:
            best_f = func(u)
            best_x = u.copy()
        else:
            if rng.uniform(0, 1) < np.exp((best_f - func(u)) / T):
                best_f = func(u)
                best_x = u.copy()

    return best_x
