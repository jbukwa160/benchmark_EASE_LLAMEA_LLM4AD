def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return func(x)

    pop_size = 100
    x_best = np.random.uniform(lb, ub, (pop_size, dim))
    f_best = np.inf

    for t in range(budget):
        gbest = np.zeros(dim)
        fgbest = np.inf

        for i in range(pop_size):
            noise = rng.normal(size=dim)
            x_candidate = x_best[i] + 0.1 * noise
            f_candidate = Rosenbrock(x_candidate)

            if f_candidate < fgbest:
                gbest = x_candidate
                fgbest = f_candidate

        for i in range(pop_size):
            crossover_rate = 0.5 / (t / budget + 1)
            noise = rng.normal(size=dim) * crossover_rate
            x_candidate = x_best[i] + noise
            x_candidate = np.clip(x_candidate, lb, ub)

            f_candidate = Rosenbrock(x_candidate)

            if f_candidate < fgbest:
                x_best[i] = x_candidate

        if gbest < f_best:
            f_best = gbest
            best_idx = np.argmin(fgbest)

    return x_best[best_idx]
