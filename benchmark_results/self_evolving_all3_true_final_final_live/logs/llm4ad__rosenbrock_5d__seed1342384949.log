def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        n_select = int(rng.uniform(1, dim))
        idxs = rng.choice(dim, n_select, replace=False)

        d = np.zeros(dim)
        for j in idxs:
            dx_j = (ub[j] - lb[j]) * rng.normal(0, 1.5) + (x[j] - ub[j])
            d[j] = dx_j
        x[idxs] += d[idxs]

        fx = func(x)
        if fx < best_f:
            best_x = x.copy()
            best_f = fx

        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)

    return best_x
