def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def evaluate(x):
        x = clip(x)
        return func(x), -x  # Use negative of function value as gradient

    def de(x0, x1, x2, y):
        v1 = rng.uniform(-1, 1) * y[1] + rng.uniform(-1, 1) * (y[2] - y[1])
        v2 = rng.uniform(-1, 1) * y[2] + rng.uniform(-1, 1) * (y[3] - y[2])
        v3 = rng.uniform(-1, 1) * y[3] + rng.uniform(-1, 1) * (y[4] - y[3])

        x = [x0, x1]
        for i in range(1, dim):
            u = rng.uniform(0, 1)
            if u <= 0.5:
                xi = clip(x[i-1] + v1 + u * (v2 - v1))
            else:
                xi = clip(x[i-1] + v3 + u * (v2 - v1))
            x.append(xi)

        return np.array(x)

    def gd(x, y):
        step_size = 0.01
        for i in range(dim):
            x[i] += step_size * y[i]
            x[i] = clip(x[i])

        return x

    best_x = rng.uniform(lb, ub)
    best_y = evaluate(best_x)

    de_count = 0
    gd_count = 0

    for _ in range(budget):
        if rng.random() < 0.5:
            new_x = de(best_x, best_x, best_x, best_y)
            f_new, y_new = evaluate(new_x)
            if f_new > best_y[0]:
                best_x = new_x
                best_y = (f_new, -y_new)  # Update gradient as well

                de_count += 1
        else:
            new_x = gd(best_x, best_y)
            f_new, y_new = evaluate(new_x)

            if f_new > best_y[0]:
                best_x = new_x
                best_y = (f_new, -y_new)  # Update gradient as well

                gd_count += 1

    return best_x
