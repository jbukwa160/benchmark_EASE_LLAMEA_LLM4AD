def algorithm(func, dim, lb, ub, budget, rng):
    best_x = 0.5 * (lb + ub) * rng.rand(dim)
    best_f = func(best_x)

    for i in range(budget):
        x = best_x + 0.1 * (ub - lb) * rng.randn(dim)
        x = np.clip(x, lb, ub)

        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x

        if i % 100 == 0 or i == budget - 1:
            r = 0.9 * (ub - lb) / 10
            for j in range(dim):
                a = np.clip(best_x[j] + r, lb, ub)
                b = np.clip(best_x[j] - r, lb, ub)

                x_new = best_x.copy()
                x_new[j] = a
                f_a = func(x_new)
                if f_a < best_f:
                    best_f = f_a
                    best_x = x_new

                x_new = best_x.copy()
                x_new[j] = b
                f_b = func(x_new)
                if f_b < best_f:
                    best_f = f_b
                    best_x = x_new

    return best_x
