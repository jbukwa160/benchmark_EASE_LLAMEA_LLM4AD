def algorithm(func, dim, lb, ub, budget, rng):
    def generate_random_candidate(dim, lb, ub, rng):
        return (ub - lb) * rng.rand(dim) + lb
    
    candidates = [generate_random_candidate(dim, lb, ub, rng)]
    swarms = [[candidates[0], 1.0]]
    
    for _ in range(budget):
        new_swarms = []
        for swarm_id, (centroid, velocity_coefficient) in enumerate(swarms):
            for _ in range(5): # 5 particles per swarm
                candidate = centroid + velocity_coefficient * generate_random_candidate(dim, lb, ub, rng)
                if np.any(np.isinf(func(candidate))):
                    continue
                
                new_swarms.append([candidate, velocity_coefficient])
        swarms = new_swarms
        
        for i in range(len(swarms)):
            candidate, _ = swarms[i]
            best_candidate = min(candidates, key=func)
            if func(candidate) < func(best_candidate):
                candidates[i] = candidate
                centroid = np.mean([c for c, _ in swarms], axis=0)
                velocity_coefficient *= 1.001  # Adapt the coefficient based on success
            else:
                centroid = (centroid * 0.9 + candidate) / 1.1  # Adapt the centroid based on failure
        new_candidates = [generate_random_candidate(dim, lb, ub, rng)]
        
        for _, (candidate, _) in swarms:
            new_candidates.append(candidate)
        
        candidates = new_candidates
    
    best_candidate = min(candidates, key=func)
    return np.clip(best_candidate, lb, ub)
