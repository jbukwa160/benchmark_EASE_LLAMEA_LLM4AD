def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate():
        return rng.uniform(lb, ub, size=dim)

    def clip(candidate):
        clipped = np.clip(candidate, lb, ub)
        return clipped if not np.all(clipped == candidate) else candidate

    best_solution = get_candidate()
    best_fitness = func(best_solution)
    
    for _ in range(budget):
        population_size = 5
        mutation_rate = 1 / (budget + 1)
        
        candidates = [get_candidate() for _ in range(population_size)]
        clipped_candidates = [clip(c) for c in candidates]
        
        fitnesses = [func(c) for c in clipped_candidates]
        
        best_candidate_index = np.argmin(fitnesses)
        if fitnesses[best_candidate_index] < best_fitness:
            best_solution = clipped_candidates[best_candidate_index]
            best_fitness = fitnesses[best_candidate_index]
            
        for i, candidate in enumerate(clipped_candidates):
            if rng.random() > 0.9 or fitnesses[i] == best_fitness:
                continue
            
            mutation_amount = rng.uniform(-1, 1) * (ub - lb)
            mutated_candidate = clipped_candidates[best_candidate_index] + mutation_amount
            mutated_clipped_candidate = clip(mutated_candidate)
            
            if func(mutated_clipped_candidate) < fitnesses[i]:
                clipped_candidates[i] = mutated_clipped_candidate
                
        best_solution = np.mean(clipped_candidates, axis=0)
        
    return best_solution
