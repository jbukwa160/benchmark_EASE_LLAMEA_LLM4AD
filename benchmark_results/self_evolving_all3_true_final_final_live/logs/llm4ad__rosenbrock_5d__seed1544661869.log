def algorithm(func, dim, lb, ub, budget, rng):
    def sample_candidate(params):
        return params + rng.normal(0, 1e-3, size=dim)

    def clip(candidate):
        return np.clip(candidate, lb, ub)

    n_iterations = int(budget / (2 * dim))
    params = np.random.uniform(lb, ub, size=(n_iterations, dim))

    for i in range(n_iterations):
        candidates = [sample_candidate(params[i]) for _ in range(5)]
        candidates = [clip(candidate) for candidate in candidates]
        
        scores = [func(candidate) for candidate in candidates]

        idx_best = np.argmin(scores)
        score_best = scores[idx_best]

        params[i] = clip(candidates[idx_best])

    return clip(params[-1])
