def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    best_x = rng.uniform(lb, ub, size=dim)
    best_f = evaluate(best_x)

    num_sa_steps = int(budget * 0.6)
    num_de_steps = int(budget * 0.3)
    num_rs_steps = budget - num_sa_steps - num_de_steps

    t = 1
    for _ in range(num_sa_steps):
        new_x = best_x + rng.uniform(-t, t, size=dim)
        new_f = evaluate(new_x)
        if new_f < best_f:
            best_x = new_x
            best_f = new_f
        t *= np.exp(-0.01)

    for _ in range(num_de_steps):
        x1 = best_x + rng.uniform(-1, 1, size=dim)
        x2 = best_x + rng.uniform(-1, 1, size=dim)
        v = x1 + rng.uniform(0, 1, size=dim) * (x2 - x1)
        new_f = evaluate(v)
        if new_f < best_f:
            best_x = v
            best_f = new_f

    for _ in range(num_rs_steps):
        new_x = clip(rng.uniform(lb, ub, size=dim))
        new_f = evaluate(new_x)
        if new_f < best_f:
            best_x = new_x
            best_f = new_f

    return best_x
