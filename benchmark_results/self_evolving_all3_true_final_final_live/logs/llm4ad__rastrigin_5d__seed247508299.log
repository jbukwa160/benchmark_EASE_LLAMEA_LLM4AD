def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    T = 10.0
    alpha = 0.99
    iter_count = 0

    while iter_count < budget:
        f_x = func(x)
        new_x = x.copy()

        for i in range(dim):
            delta = (ub - lb) * rng.randn()
            new_x[i] += delta

        if np.any(new_x < lb) or np.any(new_x > ub):
            new_x = clip(new_x, lb, ub)

        f_new_x = func(new_x)
        delta_f = f_new_x - f_x

        if delta_f <= 0:
            x = new_x
            iter_count += 1
        else:
            accept_prob = np.exp(-delta_f / T)
            r = rng.rand()
            if r < accept_prob:
                x = new_x
                iter_count += 1
            else:
                iter_count += 1

        T *= alpha

    return x
