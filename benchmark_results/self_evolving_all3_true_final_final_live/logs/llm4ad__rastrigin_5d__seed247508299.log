def algorithm(func, dim, lb, ub, budget, rng):
    def fitness(x):
        return func(x)

    D = 5  # dimensionality of the problem
    x_best = -np.inf * np.ones(D)
    y_best = np.inf
    T_max = 1000
    alpha = 0.99

    for i in range(budget):
        n = rng.randint(1, D + 1)  # select dimension for mutation
        delta = (ub - lb) / 2 * np.sin(np.pi * rng.uniform(lb, ub))
        x_mutation = x_best.copy()
        x_mutation[n] += delta

        if fitness(x_mutation) < y_best:
            y_best = fitness(x_mutation)
            x_best = x_mutation.copy()

        T = max(T_max / (i + 1), 0.01)

        prob_acceptance = np.exp((y_best - fitness(x_best)) / T)
        if rng.uniform(0, 1) < prob_acceptance:
            y_best = fitness(x_best)

    return x_best
