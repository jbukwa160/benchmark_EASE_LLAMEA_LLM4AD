def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def differential_evolution(population, f, bounds, mut, cross, sel):
        pop = population.copy()
        for i in range(len(pop)):
            x1, y1 = pop[np.random.choice(len(pop)), :].copy(), pop[i, :].copy()
            diff = np.random.uniform(-mut, mut)
            x2 = x1 + diff
            if f(x2) < f(y1):
                pop[i] = x2
        for i in range(len(pop)):
            x1, y1 = pop[np.random.choice(len(pop)), :].copy(), pop[i, :].copy()
            cross_prob, mut_prob = 0.5, 0.5
            if np.random.rand() < cross_prob:
                x1[:], x2[:] = x2[:], x1[:]
            diff = np.random.uniform(-mut, mut)
            x2 = x1 + diff
            if f(x2) < f(y1):
                pop[i] = x2
        return sel(pop)

    def adaptive_step_size(f, population, bounds, budget):
        best = np.inf
        for i in range(budget):
            new_pop = differential_evolution(population.copy(), f, bounds, 0.5, 0.5, lambda pop: pop[np.argmin([f(x) for x in pop])])
            if min(f(x) for x in new_pop) < best:
                population = new_pop
                best = min(f(x) for x in new_pop)
        return np.min([f(x) for x in population])

    population = [[rng.uniform(lb, ub) for _ in range(dim)] for _ in range(10)]
    return clip(np.array(adaptive_step_size(func, population, [(lb, ub) for i in range(dim)], budget)), lb, ub)
