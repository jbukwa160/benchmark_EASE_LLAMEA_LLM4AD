def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = rng.uniform(-1e-3, 1e-3, (dim,))
    mu = rng.uniform(lb, ub, (dim,))
    sigma = 0.5
    best_x = mu.copy()
    best_f = float('inf')

    for _ in range(budget):
        x = clip(mu + sigma * np.dot(D, np.random.randn(dim,)))
        f = func(x)

        if f < best_f:
            best_f = f
            best_x = x

        D = (1 - 0.01) * D + 0.005 * np.outer(np.random.randn(dim,), rng.uniform(-1e-3, 1e-3))

    return best_x
