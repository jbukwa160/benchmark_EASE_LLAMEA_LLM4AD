def algorithm(func, dim, lb, ub, budget, rng):
    best = None
    for _ in range(budget):
        x = (ub - lb) * rng.rand(dim) + lb
        new_best = func(x)
        if best is None or new_best < func(best):
            best = x
    return np.clip(best, lb, ub)
