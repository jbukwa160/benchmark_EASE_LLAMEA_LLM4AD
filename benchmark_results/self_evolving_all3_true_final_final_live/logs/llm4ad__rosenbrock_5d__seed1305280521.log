def algorithm(func, dim, lb, ub, budget, rng):
    pop = rng.uniform(lb, ub, size=(100, dim))
    T = 1e6
    
    for _ in range(budget):
        # Evaluate fitness
        fit = np.array([func(x) for x in pop])
        
        # Selection (DE)
        idx = np.argsort(fit)[:int(0.2 * len(pop))]
        new_pop = pop[idx] + rng.uniform(-1, 1, size=(len(idx), dim))
        
        # Clip to bounds
        new_pop = np.clip(new_pop, lb, ub)
        
        # Update population (SA)
        for i in range(len(pop)):
            r = rng.rand()
            if r < 0.5 or fit[i] > func(new_pop[i]):
                pop[i] = new_pop[i]
                T *= 0.9999
            else:
                T *= 1.0001
        
    # Return best solution
    return np.argmin(func(pop))
