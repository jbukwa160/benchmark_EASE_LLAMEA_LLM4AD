def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    population_size = 100
    mutation_rate = 0.01
    crossover_probability = 0.5
    elite_size = int(population_size * 0.2)
    offspring_size = population_size - elite_size

    initial_population = rng.uniform(lb, ub, size=(population_size, dim))

    for _ in range(budget):
        fitness_values = func(clip(initial_population))
        sorted_indices = np.argsort(fitness_values)

        elite_candidates = initial_population[sorted_indices[:elite_size]]
        offspring_candidates = []

        while len(offspring_candidates) < offspring_size:
            parent1 = initial_population[sorted_indices[np.random.randint(elite_size, population_size)]]
            parent2 = initial_population[sorted_indices[np.random.randint(elite_size, population_size)]]

            if np.random.rand() < crossover_probability:
                child = (parent1 + parent2) / 2
                offspring_candidates.append(child)
            else:
                mutation = rng.uniform(-0.5, 0.5, size=dim)
                child = clip(parent1 + mutation)
                offspring_candidates.append(child)

        initial_population = np.concatenate((elite_candidates, offspring_candidates))

    best_candidate = initial_population[np.argmin(func(clip(initial_population)))]
    return best_candidate
