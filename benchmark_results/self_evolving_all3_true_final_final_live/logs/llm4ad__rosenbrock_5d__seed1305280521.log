def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    pop_size = 50
    mutation_rate = 0.5
    crossover_rate = 0.9
    sigma = 1.0
    best_so_far = None

    population = np.random.uniform(lb, ub, (pop_size, dim))
    for _ in range(budget):
        fit_values = func(population)
        idx_best = np.argmin(fit_values)

        if best_so_far is None or fit_values[idx_best] < func(best_so_far):
            best_so_far = population[idx_best]

        parent1_idx = rng.randint(0, pop_size)
        parent2_idx = rng.randint(0, pop_size)

        while parent2_idx == parent1_idx:
            parent2_idx = rng.randint(0, pop_size)

        child_candidate = clip(
            population[parent1_idx] + mutation_rate * (population[parent2_idx] - population[parent1_idx]) +
            sigma * np.random.normal(size=dim)
        )

        if rng.random() < crossover_rate:
            child_candidate = clip((population[parent1_idx] + child_candidate) / 2)

        fit_value_child = func(child_candidate)
        idx_best_child = np.argmin(fit_values)

        if fit_value_child < fit_values[idx_best]:
            population[idx_best_child] = child_candidate

    return best_so_far
