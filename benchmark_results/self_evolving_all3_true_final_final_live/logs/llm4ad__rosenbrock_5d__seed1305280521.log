def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def cma_es(pop_size=20, sigma=0.1, bounds=(0, 5), max_iter=10000):
        x_best = None
        f_best = float('inf')
        pop = rng.uniform(bounds[0], bounds[1], (pop_size, dim))
        cov = np.eye(dim)
        for i in range(max_iter):
            # sample new population using the current covariance matrix and mean
            new_pop = rng.multivariate_normal(np.mean(pop, axis=0), cov)
            f_new_pop = func(new_pop)
            idx_best = np.argmin(f_new_pop)
            if f_new_pop[idx_best] < f_best:
                x_best = new_pop[idx_best]
                f_best = f_new_pop[idx_best]
            # update covariance matrix
            cov += sigma ** 2 * (np.outer(pop[idx_best], pop[idx_best]) - cov)
            pop = clip(new_pop)
        return x_best

    x_best = cma_es()
    if func(x_best) > budget:
        while True:
            x_best_restart = cma_es(sigma=sigma / 2, max_iter=max_iter // 2)
            if func(x_best_restart) < budget:
                break
            x_best = x_best_restart
    return x_best
