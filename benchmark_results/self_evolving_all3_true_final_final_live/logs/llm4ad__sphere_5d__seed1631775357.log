def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for i in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x
        
        # Adaptive exploration-exploitation: with probability 0.1, take a step of fixed length
        if np.random.rand() < 0.1 and i > 100:
            epsilon = 1e-2
            x += rng.uniform(-epsilon, epsilon, size=dim)
    
    return best_x
