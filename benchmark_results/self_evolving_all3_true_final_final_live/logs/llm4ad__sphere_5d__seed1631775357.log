def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        s = 0.1 * (ub - lb) / (1 + _/budget)
        sigma = max(s, 0.01)

        while True:
            x = np.clip(x_best + rng.normal(size=dim) * sigma, lb, ub)
            f = func(x)

            if f < f_best:
                x_best = x
                f_best = f

            if f - f_best < (ub - lb) / budget or _ >= 0.99 * budget:
                break

    return x_best
