def algorithm(func, dim, lb, ub, budget, rng):
    best_x = -np.inf * np.ones(dim)
    best_fx = np.inf
    
    for _ in range(budget):
        x = (ub - lb) * rng.rand(dim) + lb
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, a_min=lb, a_max=ub)
        
        fx = func(x)
        
        if fx < best_fx:
            best_x = x
            best_fx = fx
    
    return best_x
