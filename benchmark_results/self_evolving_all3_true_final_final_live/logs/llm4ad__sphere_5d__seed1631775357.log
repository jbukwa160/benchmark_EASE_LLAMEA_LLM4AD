def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = -np.ones(dim)
    for i in range(budget):
        sol = best_sol + rng.normal(0, 1e-2, size=dim)
        sol = np.clip(sol, lb, ub)
        fitness = func(sol)
        if fitness < func(best_sol):
            best_sol = sol
    return best_sol
