def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def gradient_descent(candidate):
        x = candidate.copy()
        for i in range(dim):
            learning_rate = 0.1 / (i + 1)
            x[i] -= learning_rate * func(clip(x))[i]
        return clip(x)

    population_size = 10
    candidates = np.random.uniform(lb, ub, size=(population_size, dim))
    for _ in range(budget):
        new_candidate = gradient_descent(np.mean(candidates, axis=0))
        candidates = np.append(candidates, [new_candidate], axis=0)
        candidates = candidates[np.argmin([func(clip(candidate)) for candidate in candidates])]
    return candidates[0]
