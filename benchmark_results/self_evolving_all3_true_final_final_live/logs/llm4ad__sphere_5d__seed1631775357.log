def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    x_best = -np.inf * np.ones(n)
    while budget > 0:
        sigma = 1.0
        mean = (lb + ub) / 2
        cov = sigma ** 2 * np.eye(n)
        distribution = rng.multivariate_normal(mean, cov)
        candidate = rng.uniform(lb, ub, size=n)
        for i in range(budget):
            x_cand = rng.normal(distribution, scale=sigma)
            x_cand = np.clip(x_cand, lb, ub)
            f_val = func(x_cand)
            if f_val < x_best:
                x_best = f_val
                best_candidate = x_cand
        budget -= 1
    return best_candidate
