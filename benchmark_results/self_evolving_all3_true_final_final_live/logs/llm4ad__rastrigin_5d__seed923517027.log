def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    best = np.random.uniform(lb, ub, size=(dim,))
    best_eval = evaluate(best)
    temp_best = best.copy()

    for i in range(budget):
        # Differential Evolution
        offspring = best + rng.uniform(-1, 1, size=(dim,)) * (best - rng.uniform(lb, ub, size=(dim,)))
        offspring = clip(offspring, lb, ub)
        offspring_eval = evaluate(offspring)

        if offspring_eval < best_eval:
            best = offspring
            best_eval = offspring_eval

        # Simulated Annealing
        temp_best = np.copy(best)
        for j in range(dim):
            temp_best[j] += rng.uniform(-1, 1) * (ub - lb)
            temp_best[j] = clip(temp_best[j], lb, ub)

        temp_best_eval = evaluate(temp_best)

        if rng.random() < np.exp((best_eval - temp_best_eval) / 100):
            best = temp_best
            best_eval = temp_best_eval

    return best
