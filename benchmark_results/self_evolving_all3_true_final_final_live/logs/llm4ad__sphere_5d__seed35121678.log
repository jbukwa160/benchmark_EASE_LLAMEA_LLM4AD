def algorithm(func, dim, lb, ub, budget, rng):
    n = len(dim)
    x_best = rng.uniform(lb, ub, size=n)
    best_func_val = func(x_best)
    
    T = 1.0
    alpha = 0.99
    k = 0
    
    while k < budget:
        for i in range(n):
            new_x = x_best.copy()
            if rng.random() < 0.5:  # flip sign of a random dimension
                new_x[i] *= -1
            else:  # uniformly sample within bounds
                new_x[i] += (ub - lb) * (rng.uniform(0, 1) - 0.5)
            new_x = np.clip(new_x, lb, ub)  # clip to bounds
            
            new_func_val = func(new_x)
            
            if new_func_val < best_func_val:
                x_best = new_x
                best_func_val = new_func_val
                
        T *= alpha
        k += 1
        
    return x_best
