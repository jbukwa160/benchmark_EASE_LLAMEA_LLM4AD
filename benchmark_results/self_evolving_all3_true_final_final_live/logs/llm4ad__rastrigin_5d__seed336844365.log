def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        # Polynomial mutation
        for j in range(dim):
            if rng.random() < 0.1:
                x[j] += (ub - lb) * (rng.uniform(-2, 2))**3 / ((i + 1)**(1/4))
                x[j] = np.clip(x[j], lb, ub)

        # Polynomial mutation with high probability
        for j in range(dim):
            if rng.random() < 0.5:
                x[j] += (ub - lb) * (rng.uniform(-2, 2))**3 / ((i + 1)**(1/4))
                x[j] = np.clip(x[j], lb, ub)

        # Evaluate the function
        f = func(x)
        
        if f < best_f:
            best_x = x.copy()
            best_f = f

    return best_x
