def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def fitness(x):
        return func(x) + 1e10 * sum(np.maximum(0, (x - lb)) ** 2)

    pop_size = int(budget / dim)
    pop = rng.uniform(lb, ub, size=(pop_size, dim))
    best = np.inf
    for _ in range(pop_size):
        f = fitness(pop[_])
        if f < best:
            best = f
            best_sol = pop[_]

    for _ in range(budget - pop_size):
        new_pop = rng.uniform(lb, ub, size=(pop_size, dim))
        for i in range(pop_size):
            c1 = rng.choice([j for j in range(pop_size) if j != i])
            c2 = rng.choice([k for k in range(pop_size) if k != i and k != c1])
            mutant = clip(new_pop[i] + 0.5 * (pop[c1] - pop[c2]), lb, ub)
            trial = pop[i]
            for j in range(dim):
                u = rng.uniform(0, 1)
                if u < 0.5:
                    trial[j] = mutant[j]
                else:
                    trial[j] = new_pop[i][j]
            f_trial = fitness(trial)
            if f_trial < best:
                best = f_trial
                best_sol = trial
        pop = new_pop

    return best_sol
