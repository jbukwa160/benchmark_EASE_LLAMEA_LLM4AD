def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    max_iter = int(budget / (dim * pop_size))
    n_iter = 0
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    while n_iter < max_iter:
        if n_iter % 10 == 0: # Switch to DE every 10 iterations
            population = np.random.uniform(lb, ub, (pop_size, dim))
            for _ in range(100):
                y = population[np.random.choice(pop_size)]
                u = population[np.random.choice(pop_size)]
                v = population[np.random.choice(pop_size)]
                z = y + rng.uniform(-0.1, 0.1) * (u - v)
                f_z = func(z)
                if f_z < func(y):
                    y = z
                population[population == y] = z
        else: # Simple Random Search
            population = np.random.uniform(lb, ub, (pop_size, dim))
        
        for x in population:
            f_x = func(x)
            if f_x < f_best:
                f_best = f_x
                x_best = x
        
        n_iter += 1
    
    return x_best
