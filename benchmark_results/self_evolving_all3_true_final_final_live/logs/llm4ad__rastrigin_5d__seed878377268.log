def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    D = 1e-4 + rng.uniform(0, 1) * (ub - lb)
    mu = np.random.uniform(lb, ub, size=(n,))
    C = D * np.eye(n)
    
    for _ in range(budget):
        Y = np.dot(np.linalg.cholesky(C), np.random.randn(n,))
        x_new = mu + Y
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        if f_new < func(mu):
            mu = x_new
        
        C = (1 - 1 / (len(mu) + 3)) * C + 1 / (len(mu) + 3) * Y.dot(Y.T)
    
    return mu
