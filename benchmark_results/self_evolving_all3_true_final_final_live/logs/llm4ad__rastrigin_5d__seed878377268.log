def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    initial_guess = np.random.uniform(lb, ub, size=(1, dim))
    best_solution = initial_guess.copy()

    def nelder_mead_simplex(func, x0, bounds, max_iter=1000, tol=1e-6):
        x = x0
        y_best = func(x)
        for _ in range(max_iter):
            z = np.random.choice([-1, 1], size=x.shape)
            new_x = x + 0.5 * z
            new_y = func(new_x)
            if all(np.all(np.abs(z) <= 1e-6)) or (new_y < y_best and not np.any(np.isclose(x, new_x))):
                x[:] = new_x
                y_best = new_y
            elif (new_y < y_best or np.random.rand() < 0.5 * np.exp((y_best - new_y) / tol)):
                x = 0.5 * (x + new_x)
                y_best = func(x)
        return x

    def simulated_annealing(func, x0, bounds, T_max=100, T_min=1e-6):
        x = x0
        T = T_max
        best_solution = x.copy()
        for _ in range(int(budget / 10)):
            y_new = func(x)
            if y_new < func(best_solution):
                best_solution = x.copy()
            elif np.random.rand() < 0.5 * np.exp((func(best_solution) - y_new) / T):
                best_solution = x.copy()
            z = np.random.uniform(-T, T, size=x.shape)
            new_x = x + z
            if func(new_x) < func(x):
                x = new_x
        return best_solution

    for _ in range(budget):
        simplex_center = nelder_mead_simplex(func, initial_guess, [lb] * dim, max_iter=1000, tol=1e-6)
        clipped_center = clip(simplex_center, lb, ub)
        candidate = simulated_annealing(func, clipped_center, [lb] * dim, T_max=100, T_min=1e-6)

        if func(candidate) < func(best_solution):
            best_solution = candidate.copy()

    return np.array([best_solution])
