def algorithm(func, dim, lb, ub, budget, rng):
    D = len(dim)
    pop_size = 50  # population size for initial exploration
    sigma_init = 1.0  # initial standard deviation
    c_c = 2.0 / (D + 1.25)  # damping factor for step-size adaptation
    c_1 = 1/(D + 1.25)
    c_m = 2 * (D + 2)

    x_best = np.zeros(D)
    f_best = float('inf')
    pop = np.random.uniform(lb, ub, (pop_size, D))
    cov = np.eye(D) * sigma_init ** 2
    m = rng.choice(pop_size)
    mean = pop[m]

    for _ in range(budget):
        y = func(mean)

        if y < f_best:
            x_best = mean.copy()
            f_best = y

        if len(x_best.shape) > 1:
            x_best = x_best[np.unravel_index(np.argmax(x_best), x_best.shape)]

        z = np.random.multivariate_normal(mean, cov)
        z = lb + (ub - lb) * rng.uniform(size=D)
        z = clip_to_bounds(z, lb, ub)

        y_new = func(z)

        if y_new < f_best:
            mean = z
            m = rng.choice(pop_size)

        cov = c_c * cov + np.outer(c_1 * (mean - pop[m]), mean - pop[m]) + \
              np.outer(c_m, pop[m] - mean)
        mean = mean + 0.5 * np.sqrt(np.diag(cov)) * rng.randn(D)

    return x_best
