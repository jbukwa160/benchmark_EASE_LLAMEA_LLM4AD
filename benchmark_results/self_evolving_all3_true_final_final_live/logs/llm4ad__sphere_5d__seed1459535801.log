def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    best_x = rng.uniform(low=lb, high=ub, size=(dim,))
    best_f = func(clip(best_x))

    for _ in range(budget):
        new_x = clip(rng.normal(loc=best_x, scale=0.1, size=(dim,)))
        new_f = func(new_x)

        if new_f < best_f:
            best_x = new_x
            best_f = new_f

    return best_x
