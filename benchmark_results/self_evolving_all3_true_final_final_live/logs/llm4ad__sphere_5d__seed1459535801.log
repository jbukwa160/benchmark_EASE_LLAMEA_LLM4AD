def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (1, dim))
    sigma = 0.5 * (ub - lb)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        c = 1 + 1 / (len(x) ** 2)
        v = np.zeros((dim,))
        for i in range(dim):
            v[i] = sigma * rng.uniform(-c, c)
        x_new = x + v

        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new
        sigma *= 0.5 * (best_f / (func(best_x) + 1e-6)) ** 0.2

        # Accept or reject the new solution with probability based on its fitness
        r = rng.uniform(0, 1)
        if r < np.exp(-f_new + best_f):
            x = x_new.copy()

    return best_x
