def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_y = float('inf')
    
    for _ in range(budget):
        x = lb + (ub - lb) * rng.rand(dim)
        y = func(x)
        
        if y < best_y:
            best_y = y
            best_x = x
            
        new_lb = np.minimum(lb, best_x - 2.0 / (dim * _))
        new_ub = np.maximum(ub, best_x + 2.0 / (dim * _))
        
        lb = np.clip(lb, None, new_lb)
        ub = np.clip(ub, new_lb, None)
    
    return best_x
