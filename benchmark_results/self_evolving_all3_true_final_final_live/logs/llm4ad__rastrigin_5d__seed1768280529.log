def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def rastrigin(x):
        return func(10*dim + np.sum(np.square(x) - 10*np.cos(2*np.pi*x)))

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = rastrigin(best_x)

    de_count = 0
    sa_count = 0

    for i in range(budget):
        if rng.rand() < 0.5:
            # Differential Evolution phase
            v = np.random.uniform(lb, ub, size=dim)
            u = x + 0.1*rng.randn(dim)
            trial_x = clip(u + 0.9*(v - x))
            trial_f = rastrigin(trial_x)

            if trial_f < best_f:
                best_x = trial_x
                best_f = trial_f

        else:
            # Simulated Annealing phase
            trial_x = clip(best_x + rng.randn(dim)*0.1)
            trial_f = rastrigin(trial_x)

            if trial_f < best_f:
                best_x = trial_x
                best_f = trial_f
                sa_count += 1

        x = best_x.copy()
        de_count += int(rng.rand() < 0.5)

    return best_x
