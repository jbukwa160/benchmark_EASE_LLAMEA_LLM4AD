def algorithm(func, dim, lb, ub, budget, rng):
    def clip(cand, lb, ub):
        return np.clip(cand, lb, ub)

    def rand(lb, ub):
        return rng.uniform(lb, ub)

    def mutate(x, sigma):
        return x + sigma * (rng.normal(size=dim) - 0.5)

    def crossover(x1, x2):
        y = np.zeros(dim)
        for i in range(dim):
            if rng.random() < 0.5:
                y[i] = x1[i]
            else:
                y[i] = x2[i]
        return y

    def evaluate(x):
        cand = clip(x, lb, ub)
        return func(cand)

    current_best = np.zeros(dim)
    best_eval = float('inf')
    budget_left = budget
    sigma = 10.0
    alpha = 1e-4
    t = 0

    while budget_left > 0:
        x = clip(current_best + rng.normal(size=dim) * sigma, lb, ub)
        new_eval = evaluate(x)

        if new_eval < best_eval:
            current_best = x
            best_eval = new_eval

        trial_x1 = mutate(current_best, sigma / np.sqrt(budget_left))
        trial_x2 = crossover(trial_x1, clip(mutate(current_best, sigma / np.sqrt(budget_left)), lb, ub))

        trial_new_eval1 = evaluate(trial_x1)
        if trial_new_eval1 < best_eval:
            current_best = trial_x1
            best_eval = trial_new_eval1

        trial_new_eval2 = evaluate(trial_x2)
        if trial_new_eval2 < best_eval:
            current_best = trial_x2
            best_eval = trial_new_eval2

        t += 1
        budget_left -= 1

    return clip(current_best, lb, ub)
