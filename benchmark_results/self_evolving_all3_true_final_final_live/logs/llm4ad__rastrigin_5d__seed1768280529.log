def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, a_min=lb, a_max=ub)

    pop_size = 100
    w = 0.7298
    c1 = c2 = 1.49618

    x = np.random.uniform(lb, ub, size=(pop_size, dim))
    pbest = x.copy()
    gbest = np.zeros(dim)
    fgbest = float('inf')

    for _ in range(budget):
        for i in range(pop_size):
            r1 = rng.rand(dim)
            r2 = rng.rand(dim)
            r3 = rng.rand(dim)

            v = w * clip(pbest[i] + c1 * r1 * (pbest[i] - x[i]) +
                         c2 * r2 * (gbest - pbest[i]) + r3 * (x[rng.randint(0, pop_size-1), :] - pbest[i]), lb, ub)

            f = func(v)
            if f < func(pbest[i]):
                pbest[i] = v
                if f < func(gbest):
                    gbest = v
                    fgbest = f

        x = np.copy(pbest)

    return clip(gbest, lb, ub)
