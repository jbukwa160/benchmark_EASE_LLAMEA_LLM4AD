def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def bounds_adjustment(pop):
        minx = np.min(pop, axis=0)
        maxx = np.max(pop, axis=0)
        new_bounds = (minx - 0.1*(maxx-minx), maxx + 0.1*(maxx-minx))
        return clip(new_bounds)

    def adaptive_crossover(x_best, x1, x2):
        r = rng.rand()
        if r < 0.3:
            child = x1
        elif r < 0.6:
            child = x2
        else:
            child = (x_best + x1 + x2)/3
        return clip(child)

    pop_size = int(budget**0.5)
    population = rng.uniform(lb, ub, size=(pop_size, dim))
    fitness_values = [func(x) for x in population]
    best_x = population[np.argmin(fitness_values)]

    for _ in range(int(budget)):
        new_population = np.zeros((pop_size, dim))
        for i in range(pop_size):
            p1_idx = rng.randint(0, pop_size)
            p2_idx = rng.randint(0, pop_size)
            while p2_idx == p1_idx:
                p2_idx = rng.randint(0, pop_size)
            x_best_i = best_x
            child = adaptive_crossover(x_best_i, population[p1_idx], population[p2_idx])
            new_population[i] = child + rng.uniform(-1, 1, size=dim) * (population[p1_idx] - population[p2_idx])

        population = bounds_adjustment(new_population)
        fitness_values = [func(x) for x in population]
        best_x_new = population[np.argmin(fitness_values)]
        if func(best_x_new) < func(best_x):
            best_x = best_x_new

    return best_x
