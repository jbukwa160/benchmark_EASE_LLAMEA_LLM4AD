def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    mu = 20
    lambda_ = 80
    sigma = 0.5
    elite_size = 10
    
    x = np.random.uniform(lb, ub, size=(pop_size, dim))
    
    for i in range(budget):
        fitness = func(x)
        
        idx_sorted = np.argsort(fitness)
        
        x_best = x[idx_sorted[:mu]]
        y_new = np.zeros((lambda_, dim))
        v_new = np.zeros((lambda_, dim))
        
        for j in range(lambda_):
            i1, i2 = random.sample(range(mu), 2)
            v_new[j] = x[i1] + sigma * (x_best[i1] - x[i2]) + sigma * rng.normal(0, 1, size=dim)
            
            idx_clipped = np.where((v_new[j] < lb) | (v_new[j] > ub))[0]
            if len(idx_clipped) > 0:
                v_new[j, idx_clipped] = np.clip(v_new[j, idx_clipped], lb, ub)
        
        fitness_new = func(v_new)
        idx_sorted = np.argsort(fitness_new)[::-1]
        
        x[idx_sorted[:mu]] = v_new[idx_sorted[:mu]]
    
    best_x = x[np.argmin(func(x))]
    return best_x
