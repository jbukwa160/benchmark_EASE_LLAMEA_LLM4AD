def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    x = (np.random.uniform(lb, ub, n) - np.array([ub]*n)) + np.array([lb]*n)
    best_x = x.copy()
    best_f = func(x)

    learning_rate = 0.1

    for _ in range(budget):
        new_x = x + (np.random.uniform(-learning_rate, learning_rate, n) * (best_x - x))
        new_x = np.clip(new_x, lb, ub)
        
        new_f = func(new_x)

        if new_f < best_f:
            best_x = new_x
            best_f = new_f

        x = 0.9*x + 0.1*new_x

    return best_x
