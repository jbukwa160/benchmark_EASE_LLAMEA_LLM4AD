def algorithm(func, dim, lb, ub, budget, rng):
    sobol_seq = rng.randint(0, 2**32)
    candidates = np.zeros((budget, dim))
    
    for i in range(dim):
        # Generate a new Sobol sequence for each dimension
        sobol_seq_i = (sobol_seq * 1103515245 + 12345) % 2**31
        indices = np.arange(0, budget)
        
        # Create an array of random indices using the Sobol sequence
        candidates[:, i] = (sobol_seq_i * rng.uniform(1.0/2**32, 1.0)) % ub - lb
        
    for _ in range(budget):
        # Select a candidate randomly from the generated candidates
        candidate_idx = np.random.randint(0, budget)
        
        # Evaluate the function at the selected candidate and clip to bounds
        candidate = np.clip(candidates[candidate_idx], lb, ub)
        
        # Calculate the new candidate by adding a small random perturbation
        new_candidate = candidate + rng.uniform(-1e-3, 1e-3, size=dim) * (ub - lb)
        
        # Clip to bounds and evaluate the function at the new candidate
        new_candidate = np.clip(new_candidate, lb, ub)
        new_func_value = func(new_candidate)
        
        # If the new function value is better than the previous best, update the best candidate
        if _ == 0 or new_func_value < candidates[candidate_idx].min():
            best_candidate = new_candidate
            
    return best_candidate
