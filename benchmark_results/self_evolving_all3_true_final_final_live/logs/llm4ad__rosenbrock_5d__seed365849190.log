    sigma_max = 10.0
    sigma_min = 1e-6
    sigma_init = 5.0
    max_iter_no_improvement = 20

    # Initial population
    x = rng.uniform(lb, ub, size=(pop_size, dim))

    for t in range(budget):
        # GA exploration (first 10 iterations)
        if t < 10:
            fitness = np.array([func(x_i) for x_i in x])
            ind_best = np.argmin(fitness)
            best_x = x[ind_best]
            fBest = fitness[ind_best]

            # Selection
            parent_indices = rng.choice(pop_size, size=pop_size, replace=True, p=np.exp(-fitness))

            # Variation (mutation and crossover)
            child = np.zeros((pop_size, dim))
            for i in range(pop_size):
                x_parent1 = x[parent_indices[i]]
                x_parent2 = x[parent_indices[(i+1) % pop_size]]

                noise = rng.normal(size=dim) * sigma_init
                child[i] = 0.5 * (x_parent1 + x_parent2) + noise

            # Replacement
            x = np.clip(child, lb, ub)

