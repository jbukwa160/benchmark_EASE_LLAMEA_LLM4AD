def algorithm(func, dim, lb, ub, budget, rng):
    def sample_candidate(lb, ub):
        candidate = rng.uniform(low=lb, high=ub, size=(1, dim))
        return candidate

    def gaussian_process(X_train, Y_train):
        from sklearn.gaussian_process import GaussianProcessRegressor
        gp = GaussianProcessRegressor(kernel=None)
        gp.fit(X_train, Y_train)
        return gp

    def expected_improvement(gp, X_test, y_best, sigma):
        mean, std = gp.predict(X_test, return_std=True)
        ei = (mean - y_best) * norm.cdf((mean - y_best) / std) + std * norm.pdf((mean - y_best) / std)
        return ei

    def optimize(func, dim, lb, ub, budget, rng):
        X_train = np.zeros((1, dim))
        Y_train = func(X_train)
        
        for _ in range(budget-1):
            candidate = sample_candidate(lb, ub)
            
            gp = gaussian_process(X_train, Y_train)
            X_test = np.array([candidate])
            
            ei = expected_improvement(gp, X_test, Y_train[0], 0) # standard deviation is set to 0 for simplicity
            
            if ei > 0:
                X_train = np.vstack((X_train, candidate))
                Y_train = np.append(Y_train, func(candidate))
        
        best_idx = np.argmax(Y_train)
        return X_train[best_idx]

    x_best = optimize(func, dim, lb, ub, budget, rng)
    
    if not np.any(np.isnan(x_best)):
        return x_best
    else:
        return np.zeros(dim)
