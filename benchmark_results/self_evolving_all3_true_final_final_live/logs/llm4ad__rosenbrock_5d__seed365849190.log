def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    T = 1.0
    alpha = 0.99

    for i in range(1, budget + 1):
        s = rng.normal(size=dim)
        v = 10 / np.sqrt(i) * np.exp(-i**2/100)
        x_new = clip(x + v * s)

        f_new = func(x_new)
        if f_new < best_f:
            best_x = x_new
            best_f = f_new

        delta = f_new - best_f
        if delta < 0 or rng.uniform() < np.exp(-delta/T):
            x = x_new
            T *= alpha

    return best_x
