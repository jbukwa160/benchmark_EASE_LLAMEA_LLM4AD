def algorithm(func, dim, lb, ub, budget, rng):
    def clipped(x):
        return np.clip(x, lb, ub)

    pop_size = 10
    generation = 0
    best_sol = None
    best_val = float('inf')

    while generation < budget:
        generation += 1

        population = np.random.uniform(lb, ub, (pop_size, dim))

        for i in range(pop_size):
            x1 = clipped(np.copy(population[i]))
            v = rng.uniform(-0.5, 0.5) * pop_size
            x2 = population + v / pop_size

            x2 = np.where(rng.rand(dim) < 0.5, x1, x2)

            f_val = func(x2)
            if f_val < best_val:
                best_sol = x2
                best_val = f_val

        population[0] = best_sol

    return best_sol
