def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    f_x = func(x)

    pop_size = 50
    de_iter = 0
    cma_es_iter = 0

    while budget > 0:
        # Differential Evolution (DE) phase
        for _ in range(pop_size):
            y = x + rng.uniform(-1, 1, size=dim)
            y = clip(y)
            fy = func(y)
            if fy < f_x:
                x = y
                f_x = fy

        de_iter += 1
        budget -= pop_size

        # Covariance Matrix Adaptation Evolution Strategy (CMA-ES) phase
        cma_es_mu = np.zeros(dim)
        for i in range(pop_size):
            z = clip(x + rng.normal(size=dim))
            fz = func(z)
            if fz < f_x:
                x = z
                f_x = fz

        cma_es_iter += 1
        budget -= pop_size

    return x
