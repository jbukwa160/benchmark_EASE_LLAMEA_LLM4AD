def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(dim, lb, ub, rng):
        population = np.zeros((budget, dim))
        for i in range(budget):
            for j in range(dim):
                population[i, j] = rng.uniform(lb, ub)
        return population

    def clip_candidates(candidates, lb, ub):
        clipped_candidates = np.clip(candidates, a_min=lb, a_max=ub)
        return clipped_candidates

    def differential_evolution(population, func, dim, lb, ub, budget, rng):
        for i in range(budget - 1):
            # Select three random individuals
            indices = rng.choice(range(budget), size=3, replace=False)
            selected_individuals = population[indices]
            
            # Calculate mutation strategy
            mu = np.mean(selected_individuals, axis=0)
            sigma = np.std(selected_individuals, axis=0)
            delta = rng.normal(loc=0, scale=sigma, size=(budget, dim))
            mutated_individuals = selected_individuals + 0.5 * delta
            
            # Clip mutated individuals to bounds
            clipped_mutated_individuals = clip_candidates(mutated_individuals, lb, ub)
            
            # Evaluate fitness function for each individual
            evaluations = func(clipped_mutated_individuals)
            
            # Replace worst individual with best mutated one
            worst_index = np.argmax(evaluations)
            population[worst_index] = clipped_mutated_individuals[np.argmin(evaluations)]
        return population

    population = generate_initial_population(dim, lb, ub, rng)
    population = differential_evolution(population, func, dim, lb, ub, budget, rng)

    # Find index of best individual
    evaluations = func(population)
    best_index = np.argmin(evaluations)

    return population[best_index]
