def algorithm(func, dim, lb, ub, budget, rng):
    x_best = 0.5 * (lb + ub) * rng.rand(dim)
    score_best = func(x_best)

    for i in range(1, budget):
        v = 0.5 * (lb + ub) * rng.rand(dim)
        for j in range(i):
            v += 0.9 * rng.uniform(-1, 1) * (x_best - x_best[j % i])
        v = v / np.linalg.norm(v)

        u = v.copy()
        for k in range(5):
            u = u + 0.3 * rng.uniform(-1, 1) * (v - x_best)
            if func(u) < score_best:
                x_best, score_best = u, func(u)

    return x_best
