def algorithm(func, dim, lb, ub, budget, rng):
    n = len(rng)
    x_best = np.zeros(dim)
    f_best = float('inf')
    for i in range(budget):
        x = rng.multivariate_normal(np.zeros(dim), np.eye(dim) * 5.0)
        while True:
            x = np.clip(x, lb, ub)
            if (x < lb).any() or (x > ub).any():
                continue
            f = func(x)
            if f < f_best:
                f_best = f
                x_best = x
            break
    return x_best
