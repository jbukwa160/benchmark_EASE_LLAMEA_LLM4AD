def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    step_size = 0.1

    for _ in range(budget):
        if rng.rand() < 0.5:
            # Adaptive restart
            x = clip(np.array(best_x) + np.random.uniform(-step_size, step_size, size=dim))
            f = func(x)

            if f < best_f:
                best_f = f
                best_x = x.copy()

        else:
            # Learning and update of step size
            for i in range(dim):
                if rng.rand() < 0.1:  # 10% chance to update step size
                    max_without_improve = _max_without_improve(i, func, clip, lb, ub, best_x, rng)
                    if max_without_improve > 20:
                        step_size *= 0.9

                x_i = clip(best_x[i] + np.random.uniform(-step_size, step_size))
                f = func(np.array(best_x[:i]) + [x_i] + np.array(best_x[i+1:]))

                if f < best_f:
                    best_f = f
                    best_x = np.array(best_x[:i]) + [x_i] + np.array(best_x[i+1:])

    return best_x
