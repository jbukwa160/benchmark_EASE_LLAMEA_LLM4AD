def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(np.clip(x, lb, ub))

    x0 = np.array([1.0] * dim)
    sigma = 10.0
    T = 10000.0
    cooling_rate = 0.99

    x_best = x0.copy()
    f_best = f(x_best)

    for i in range(budget):
        n = len(rng.normal(0, 1, size=dim))
        while np.any(np.abs(n) > 5.0):
            n = rng.normal(0, 1, size=dim)
        
        x_new = x_best + sigma * n / np.linalg.norm(n)

        f_new = f(x_new)
        if f_new < f_best:
            x_best = x_new.copy()
            f_best = f_new

        sigma *= cooling_rate
        T -= 1

    return x_best
