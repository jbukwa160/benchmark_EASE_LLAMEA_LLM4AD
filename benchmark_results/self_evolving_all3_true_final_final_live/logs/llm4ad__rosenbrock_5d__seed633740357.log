def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_evals = 0
    x_best = np.random.uniform(lb, ub, size=(D,))
    f_best = func(x_best)
    n_best = 1
    step_size = 1.0

    for i in range(budget):
        if rng.rand() < 0.5:
            step_size *= 0.9 + 0.2 * rng.uniform()
        else:
            step_size /= 1.1 + 0.2 * rng.uniform()

        x_new = np.clip(x_best + rng.normal(size=(D,), loc=0, scale=step_size), lb, ub)

        f_new = func(x_new)
        n_evals += 1

        if f_new < f_best:
            x_best = x_new
            f_best = f_new
            n_best = 1
        elif rng.rand() < (n_best / (n_best + 1)):
            x_best = x_new
            f_best = f_new
            n_best = 1

    return x_best
