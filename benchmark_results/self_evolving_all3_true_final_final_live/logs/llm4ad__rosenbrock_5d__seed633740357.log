def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x), x

    def generate_population(rng, dim, n, lb, ub):
        return rng.uniform(lb, ub, (n, dim))

    best_x = None
    best_f = np.inf

    for i in range(budget):
        population = generate_population(rng, dim, 100, lb, ub)
        
        # Probabilistic initialization with a small chance to start over from scratch
        if rng.rand() < 0.1 and i > 10:
            population = generate_population(rng, dim, 100, lb, ub)

        fits = np.array([evaluate(x)[0] for x in population])
        
        # Differential Evolution step
        for j in range(len(population)):
            r1, r2, r3 = rng.choice(range(len(population)), size=3, replace=False)
            while r1 == j or r2 == j or r3 == j:
                r1, r2, r3 = rng.choice(range(len(population)), size=3, replace=False)
            
            v = population[r1] + rng.uniform(-1, 1) * (population[r2] - population[r3])
            population[j] = clip(v)

        fits = np.array([evaluate(x)[0] for x in population])
        
        # Selection step
        idx = np.argsort(fits)
        population = population[idx]
        fits = fits[idx]

        if i == 0 or fits[0] < best_f:
            best_x, best_f = evaluate(population[0])

    return best_x
