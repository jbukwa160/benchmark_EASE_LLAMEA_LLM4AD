def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    T0 = 1.0
    cooling_rate = 0.99

    for i in range(budget):
        y = x + rng.normal(size=dim) * 0.01
        y = clip(y, lb, ub)
        
        f_y = func(y)
        f_x = func(x)

        delta_f = f_y - f_x

        if delta_f < 0 or np.exp(-delta_f / T0) > rng.uniform():
            x = y.copy()
            best_f = min(best_f, f_y)

            if i % int(budget * 0.1) == 0: # update temperature
                T0 *= cooling_rate

        best_x = clip(best_x + (x - best_x) / (i + 2), lb, ub)
        best_f = func(best_x)

    return best_x
