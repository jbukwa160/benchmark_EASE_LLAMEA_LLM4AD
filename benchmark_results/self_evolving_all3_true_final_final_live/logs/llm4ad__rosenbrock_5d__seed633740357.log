def algorithm(func, dim, lb, ub, budget, rng):
    def rand(lb, ub):
        return (ub - lb) * rng.uniform(0, 1) + lb
    
    def clip(x, lb, ub):
        return np.minimum(np.maximum(x, lb), ub)
    
    best = np.zeros(dim)
    best_fitness = float('inf')
    
    for _ in range(budget):
        x = np.array([rand(lb, ub) for _ in range(dim)])
        
        while True:
            z = np.copy(x) + 0.5 * rng.normal(0, 1, dim)
            
            for i in range(dim):
                if rng.random() < 0.2:
                    z[i] = rand(lb, ub)
            
            z = clip(z, lb, ub)
            fitness = func(z)
            
            if fitness < best_fitness:
                best_fitness = fitness
                best = np.copy(z)
                
            x = z
            
            if rng.random() < 0.9 and rng.random() < 0.9 * (1 - _ / budget):
                break
                
    return best
