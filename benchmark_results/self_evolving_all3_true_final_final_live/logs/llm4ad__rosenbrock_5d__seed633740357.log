def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def rand_bounds(bound1, bound2):
        rand_val = (bound2 - bound1) * rng.rand() + bound1
        return rand_val

    def generate_initial_population(pop_size, dim, lb, ub):
        population = np.zeros((pop_size, dim))
        for i in range(pop_size):
            for j in range(dim):
                population[i, j] = rand_bounds(lb[j], ub[j])
        return population

    def fitness_function(x):
        return func(x)

    population = generate_initial_population(budget, dim, lb, ub)
    target_fitness = 1e+10
    iteration = 0

    while iteration < budget:
        iteration += 1
        new_population = np.zeros((budget, dim))
        for i in range(budget):
            r1 = np.random.choice(range(budget), replace=False)
            r2 = np.random.choice(range(budget), replace=False)
            r3 = np.random.choice(range(budget), replace=False)

            if rng.rand() < 0.5:
                new_population[i] = population[r1] + 0.01 * (population[r2] - population[r3])
            else:
                new_population[i] = population[r1] + 0.8 * (population[r2] - population[r3])

        for i in range(budget):
            for j in range(dim):
                new_population[i, j] = clip(new_population[i, j], lb[j], ub[j])

        new_fitnesses = np.array([fitness_function(x) for x in new_population])
        old_fitnesses = np.array([fitness_function(clip(x, lb, ub)) for x in population])

        population[new_fitnesses < old_fitnesses] = new_population[new_fitnesses < old_fitnesses]

        best_individual = population[np.argmin(new_fitnesses)]
        target_fitness = min(target_fitness, fitness_function(best_individual))
        if target_fitness == 0:
            break

    best_individual = population[np.argmin(np.array([fitness_function(x) for x in population]))]
    return clip(best_individual, lb, ub)
