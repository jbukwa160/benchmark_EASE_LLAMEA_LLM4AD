def algorithm(func, dim, lb, ub, budget, rng):
    def func_eval(x):
        return func(x)

    n = len(x)
    D = np.eye(n)
    mu = np.zeros(n)
    sigma = 0.5 * (ub - lb)
    pc = 1
    cc = 1 + 2 / (n + 1.3)
    cmu = 1
    c1 = 2 / (n + 1.3)

    for i in range(budget):
        x_star = mu + sigma * np.random.multivariate_normal(mu, D)
        x_star = np.clip(x_star, lb, ub)
        f_value = func_eval(x_star)

        if rng.rand() < pc:
            D += cc * (np.outer(x_star - mu, x_star - mu) - D)
            cmu += c1
            sigma *= 1 + 2 / (n + np.sqrt(2 * i))
            mu = (cmu - 1) * mu + c1 * x_star

    return mu
