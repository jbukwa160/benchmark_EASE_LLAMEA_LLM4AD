def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def objective(x):
        return func(x)

    pop_size = 50
    de_pop = np.random.uniform(lb, ub, (pop_size, dim))
    rs_best = None

    for _ in range(budget // 2):
        # Differential Evolution step
        de_new = np.array([clip(de_pop[i] + rng.normal(0, 1, size=dim)) for i in range(pop_size)])
        fitness_de = [objective(x) for x in de_new]
        idx_best = np.argmin(fitness_de)
        if rs_best is None or fitness_de[idx_best] < objective(rs_best):
            rs_best = de_new[idx_best]

    # Random Search step
    rng_rs = rng.choice(ub - lb, size=dim)
    for _ in range(budget // 2):
        candidate = clip(rng_rs + np.random.uniform(lb, ub, size=dim))
        if objective(candidate) < objective(rs_best):
            rs_best = candidate

    return rs_best
