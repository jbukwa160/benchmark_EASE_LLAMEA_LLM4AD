def algorithm(func, dim, lb, ub, budget, rng):
    n = 10 * dim
    x = -5 + 10*rng.rand(dim)
    sigma = 1.0
    pop_size = 10
    while True:
        for _ in range(pop_size):
            y = x + sigma*rng.randn(dim)
            y = np.clip(y, lb, ub)
            f_y = func(y)
            if rng.uniform(0, 1) < 0.5 and f_y < func(x):
                x = y
        for i in range(10):
            for j in range(i+1, dim):
                sigma *= np.sqrt(rng.uniform(-1, 1))
                pop_size = min(pop_size * (1 + rng.uniform(-1e-2, 1e-2)), budget)
                break
        if func(x) < n:
            return x
