def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    best_x = None
    best_f = np.inf

    for _ in range(budget):
        pop_size = int(0.1 * budget)
        cross_prob = 0.5

        population = np.random.uniform(lb, ub, (pop_size, dim))

        for i in range(pop_size):
            x_i = population[i]
            f_i = evaluate(x_i)

            if f_i < best_f:
                best_x = x_i
                best_f = f_i

        for _ in range(budget - pop_size):
            parent1 = np.random.choice(pop_size, 1)[0]
            parent2 = np.random.choice(pop_size, 1, exclude=parent1)[0]

            u = np.random.uniform(ub, lb, dim)
            trial = population[parent1] + cross_prob * (population[parent2] - population[parent1]) + u

            trial = np.clip(trial, lb, ub)

            f_trial = evaluate(trial)

            if f_trial < best_f:
                population[parent1] = trial
                if f_trial < best_f:
                    best_x = trial
                    best_f = f_trial

    return best_x
