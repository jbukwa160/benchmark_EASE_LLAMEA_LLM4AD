def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    n = dim
    D = 1e-4 * (ub - lb)**2
    mu = 0.5 * (ub + lb)
    sigma = (ub - lb) / 3

    x = rng.uniform(lb, ub, size=(n,))
    y = clip(x)

    for _ in range(budget):
        f_x = func(y)
        f_y = func(y + D * rng.normal(size=n))
        
        if f_y < f_x:
            x = y
            y = clip(y + D * rng.normal(size=n))

        f_z = func(clip(x + sigma * rng.normal(size=n)))
        
        if f_z < f_x:
            x = clip(x + sigma * rng.normal(size=n))
            y = clip(y + D * rng.normal(size=n))

    return np.array([x])
