def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def eval(x):
        x = clip(x)
        return func(x)

    def hybrid_crossover(u, v, w):
        if rng.uniform(0, 1) < 0.5:
            c = u + rng.uniform(-1, 1) * (v - u)
        else:
            c = u + (w - u) / np.linalg.norm(w - u) * np.dot(v - u, w - u) / np.linalg.norm(v - u)**2
        return clip(c)

    def self_adaptive_mutation(x):
        sigma = 0.1
        if rng.uniform(0, 1) < 0.5:
            return x + sigma * rng.normal(size=dim)
        else:
            return x + sigma / np.linalg.norm(x) * rng.normal(size=dim)

    population_size = int(budget ** (1/2))
    population = rng.uniform(lb, ub, size=(population_size, dim))

    for i in range(int(0.9 * budget)):
        fitness = [eval(individual) for individual in population]
        best_individual = population[np.argmin(fitness)]
        offspring = []

        for j in range(population_size):
            u, v, w = rng.choice(population, size=3, replace=False)
            c = hybrid_crossover(u, v, w)
            m = self_adaptive_mutation(c)
            offspring.append(m)

        population = np.array(offspring + [best_individual])

    best_individual = population[np.argmin([eval(individual) for individual in population])]
    return best_individual
