def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    D = 1 if isinstance(lb, (int, float)) else len(lb)
    x0 = [rng.uniform(lb[i], ub[i]) for i in range(D)]
    T = 100.0
    alpha = 0.99

    for _ in range(budget):
        x_new = np.array(x0) + rng.normal(size=D, loc=0, scale=1)
        x_new = [max(lb[i], min(ub[i], xi)) for i, xi in enumerate(x_new)]
        
        if objective(x_new) < objective(x0):
            x0 = x_new
        else:
            delta = np.array(objective(x0) - objective(x_new))
            if rng.uniform() < np.exp(-delta / T):
                x0 = x_new
        
        T *= alpha

    return np.array([max(lb[i], min(ub[i], xi)) for i, xi in enumerate(x0)])
