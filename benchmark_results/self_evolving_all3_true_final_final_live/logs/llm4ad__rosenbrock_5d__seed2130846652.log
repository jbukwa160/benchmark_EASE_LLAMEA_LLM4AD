def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def evaluate(x):
        return func(x)

    current_best = None
    current_score = float('inf')

    for _ in range(budget):
        if rng.random() < 0.1:  # 10% chance of simulated annealing
            # Simulated Annealing (SA) phase
            temperature = 100.0
            candidate = clip_candidate(rng.uniform(lb, ub, size=dim))
            score = evaluate(candidate)
            while score < current_score and temperature > 1e-6:
                temperature *= 0.99
                candidate = clip_candidate(rng.uniform(lb, ub, size=dim))
                score = evaluate(candidate)

        else:  # Random Search (RS) phase
            candidate = clip_candidate(rng.uniform(lb, ub, size=dim))

        if evaluate(candidate) < current_score:
            current_best = candidate
            current_score = evaluate(candidate)

    return current_best
