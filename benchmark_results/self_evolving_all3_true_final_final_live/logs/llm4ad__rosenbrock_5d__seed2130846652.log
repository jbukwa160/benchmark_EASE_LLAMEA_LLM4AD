def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best = np.zeros(dim)
    best_func_val = float('inf')

    pop_size = int(budget / 3) + 1
    for _ in range(pop_size):
        x = np.random.uniform(lb, ub, size=dim)
        y = clip(x)

        fit_y = func(y)
        if fit_y < best_func_val:
            best_func_val = fit_y
            best = y

        for i in range(dim):
            mutation_rate = rng.uniform(0.2, 1.0)
            x_mutated = y + mutation_rate * (np.random.uniform(lb, ub, size=dim) - y)
            x_mutated = clip(x_mutated)

            fit_x_mutated = func(x_mutated)
            if fit_x_mutated < best_func_val:
                best_func_val = fit_x_mutated
                best = x_mutated

    return best
