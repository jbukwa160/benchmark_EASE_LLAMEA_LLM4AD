def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    x = np.random.uniform(lb, ub, size=(dim,))
    pop_size = 50
    sigma = 1.0
    c1 = 1.05
    c2 = 2.0
    lambda_ = int(pop_size / 4)
    mu = pop_size

    x_best = np.array(x)
    f_best = objective(x)

    for i in range(budget):
        y = np.random.choice(['de', 'cmaes'], p=[1/3, 2/3])
        
        if y == 'de':
            v = np.random.normal(0, sigma, size=(lambda_, dim))
            x_new = x_best + v
            f_new = objective(x_new)
            
            for j in range(lambda_):
                u = np.random.choice(np.arange(pop_size), replace=False, size=lambda_)
                v = np.random.normal(0, 1.0, size=dim)
                
                if y[j] < f_new:
                    x_best = x_new
                    f_best = f_new
                    
        elif y == 'cmaes':
            C = np.eye(dim) * sigma **2
            for _ in range(lambda_):
                v = np.random.multivariate_normal(np.zeros(dim), C)
                w = 1 / (1 + objective(x_best + v))
                
                if rng.random() < w:
                    x_new = x_best + v
                    
                    if rng.uniform(0, 1) > c2:
                        r = rng.uniform(0, 1)
                        sigma *= np.exp((np.log(c1) - np.log(c2)) * (r ** (1 / lambda_)))
                        
                        for j in range(lambda_):
                            C[j] += v[j] * v[j]
                    
                    x_best = x_new
                    f_best = objective(x_best)

        if rng.uniform(0, 1) < c1:
            x_best = np.clip(x_best, lb, ub)
    
    return np.array([x_best])
