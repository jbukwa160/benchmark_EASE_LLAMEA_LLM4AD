def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return func(x)

    x = np.random.uniform(lb, ub, (1, dim))
    f_best = float('inf')
    best_x = None

    for t in range(budget):
        if t % 100 == 0:
            population_size = rng.integers(5, 51)
        else:
            population_size = max(int(rng.uniform(10, 50)), 1)

        pop = np.clip(np.random.uniform(lb, ub, (population_size, dim)), lb, ub)
        f_pop = np.array([Rosenbrock(x) for x in pop])

        diff = np.random.uniform(-1.0, 1.0, population_size - 1)
        z = np.zeros((dim,))
        p = np.zeros(population_size)

        for i in range(population_size):
            if f_pop[i] < f_best:
                f_best = f_pop[i]
                best_x = pop[i]

            x_new = pop[i] + diff * (pop[(i+1) % population_size] - pop[i])
            x_new = np.clip(x_new, lb, ub)

            p[i] = 0.5 * (f_pop[i] + Rosenbrock(x_new))

        f_best = float('inf')
        for i in range(population_size):
            if f_best > p[i]:
                f_best = p[i]
                best_x = pop[i]

    return np.array([best_x])
