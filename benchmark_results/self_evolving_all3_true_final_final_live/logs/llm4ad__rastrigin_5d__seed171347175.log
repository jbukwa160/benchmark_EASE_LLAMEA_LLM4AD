def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 10 * (ub - lb) / np.log(1 + budget)

    for _ in range(budget):
        y = x + np.random.uniform(-T, T, size=dim)
        y = np.clip(y, lb, ub)

        if func(y) < func(x):
            x = y
        else:
            alpha = 0.95 * (1 - (_ / budget))
            T *= alpha

    return x
