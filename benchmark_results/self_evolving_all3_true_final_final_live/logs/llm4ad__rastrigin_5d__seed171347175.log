def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        # Random Search
        x_rs = lb + (ub - lb) * rng.rand(dim)
        
        f_rs = func(x_rs)
        if f_rs < best_f:
            best_f = f_rs
            best_x = x_rs
        
        # Differential Evolution
        x_de = np.copy(best_x)
        for i in range(dim):
            v = np.zeros(dim)
            idx = rng.choice(range(dim), size=3, replace=False)
            v[idx] = best_x[idx]
            mu = 1.0
            v[i] += mu * (best_x[i] - x_rs[i])
            x_de[i] = v[i]
        f_de = func(x_de)
        
        if f_de < best_f:
            best_f = f_de
            best_x = x_de
        
        # Clip candidates to [lb, ub]
        best_x = np.clip(best_x, lb, ub)
    
    return best_x
