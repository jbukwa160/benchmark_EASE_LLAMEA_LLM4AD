def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    pop_size = 10
    sigma0 = 1.0
    mu = 0.8
    c_cov = 2 / (D + 3 + 2 * np.sqrt(D))
    c_step = 1 / (D + 1.27)

    best_x = np.random.uniform(lb, ub, D)
    best_f = func(best_x)
    x = np.zeros((pop_size, D))

    for i in range(budget):
        # Generate initial population
        x[:, :] = rng.normal(size=(pop_size, D)) * sigma0 + best_x

        # Clip candidates to [lb, ub]
        np.clip(x, lb, ub, out=x)

        # Compute fitness function values
        f = func(x)

        # Update the best solution found so far
        idx = np.argmin(f)
        if f[idx] < best_f:
            best_x = x[idx]
            best_f = f[idx]

    return best_x
