def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Generate a candidate solution by applying a mutation with probability 0.1
        mutate_prob = 0.1
        if rng.random() < mutate_prob:
            mutation_type = rng.choice(['gaussian', 'uniform'])
            if mutation_type == 'gaussian':
                step_size = 0.5 * (ub - lb) / np.sqrt(_ + 2)
                x_mutated = x + rng.normal(0, step_size, size=dim)
            else:
                x_mutated = x + rng.uniform(-1, 1, size=dim) * (ub - lb)

        # Clip the candidate solution to the bounds
        x_mutated = np.clip(x_mutated, lb, ub)

        f_mutated = func(x_mutated)

        # Accept the mutated solution if it's better or with a probability of 0.1
        accept_prob = 0.1
        if f_mutated < best_f or rng.random() < accept_prob:
            x = x_mutated.copy()
            best_x = x.copy()
            best_f = f_mutated

    return best_x
