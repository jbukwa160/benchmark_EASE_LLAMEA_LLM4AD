def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    x_best = lb + (ub - lb) * rng.rand(n)
    f_best = func(x_best)

    T_max = 1000
    alpha = 0.99
    gamma = 1e-4

    for _ in range(budget):
        T = T_max / np.log(_ + 2)
        x_cand = x_best.copy()
        y1 = rng.randn(n) * T
        y2 = rng.randn(n) * T
        for i in range(n):
            if rng.rand() < 0.5:
                x_cand[i] += gamma * y1[i]
            else:
                x_cand[i] += gamma * y2[i]

        # clip to bounds
        x_cand = np.clip(x_cand, lb, ub)

        f_cand = func(x_cand)
        if f_cand < f_best:
            x_best = x_cand.copy()
            f_best = f_cand

    return x_best
