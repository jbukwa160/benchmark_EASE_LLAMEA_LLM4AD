def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    def differential_evolution(bounds, mu, sigma, max_iter, pop_size=10):
        X = np.random.uniform(bounds[:, 0], bounds[:, 1], size=(pop_size, dim))
        for _ in range(max_iter):
            Y = np.zeros(pop_size)
            for i in range(pop_size):
                j = np.random.choice([k for k in range(pop_size) if k != i])
                X[i] += np.random.uniform(-sigma, sigma) * (X[j] - X[i])
                Y[i] = evaluate(X[i])
                if rng.random() < 0.1:
                    X[i], _ = differential_evolution(bounds, mu, sigma, max_iter//2)
            indices = np.argsort(Y)[:int(pop_size*0.2)]
            X[indices] = np.random.uniform(bounds[:, 0], bounds[:, 1], size=(len(indices), dim))
        return X[np.argmax([evaluate(X_) for X_ in X])]

    def simulated_annealing(x, T, alpha, max_iter):
        x_best = x
        T_current = T
        for _ in range(max_iter):
            x_new = np.clip(x + rng.uniform(-T_current, T_current), lb, ub)
            if evaluate(x_new) < evaluate(x_best):
                x_best = x_new
            elif rng.random() < 0.9 * (1 - alpha ** (_ / max_iter)):
                x = x_new
            else:
                x = x_best
            T_current *= alpha
        return x

    bounds = np.array([[lb]*dim, [ub]*dim]).T

    # Run Differential Evolution for a certain number of iterations or until convergence is detected
    X_DE = differential_evolution(bounds, 0.5, 1, budget//2)

    # Switch to Simulated Annealing and run it with an adaptive cooling schedule
    T = np.sqrt(np.sum([evaluate(x) for x in X_DE]))
    alpha = 0.9
    X_SA = simulated_annealing(X_DE[-1], T, alpha, budget//2)

    return X_SA
