    x = np.random.uniform(lb, ub, size=(1, dim))
    pop_size = 50
    population = np.zeros((pop_size, dim))
    for i in range(pop_size):
        population[i] = clip(np.random.uniform(lb, ub, size=dim))

    for _ in range(budget):
        min_val = float('inf')
        best_sol = None

        for pop in range(pop_size):
            diff = np.zeros(dim)
            for j in range(dim-1):
                sigma = 0.5 * (ub - lb) / rng
                noise = np.random.normal(0, sigma, size=dim)
                diff[j] = population[pop, j+1] - x[0, j]**2 + noise[j]
            for j in range(dim-1):
                diff[j] = 100 * (diff[j])**2

        for pop in range(pop_size):
            diff = np.zeros(dim)
            for j in range(dim-1):
                sigma = 0.5 * (ub - lb) / rng
                noise = np.random.normal(0, sigma, size=dim)
                diff[j] = population[pop, j+1] - x[0, j]**2 + noise[j]
            for j in range(dim-1):
                diff[j] = 100 * (diff[j])**2

        for pop in range(pop_size):
            new_sol = clip(x[0] + 0.5 * np.random.normal(0, 1, size=dim))
            val = func(new_sol)
            if val < min_val:
                min_val = val
                best_sol = new_sol
            elif rng.uniform(0, 1) < (min_val - val)/np.exp(min_val):
                x[0] = new_sol

        population[pop] = best_sol

