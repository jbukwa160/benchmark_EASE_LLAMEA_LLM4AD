def algorithm(func, dim, lb, ub, budget, rng):
    X = np.random.uniform(lb, ub, (budget, dim))
    Y = np.zeros(budget)
    
    for i in range(budget):
        gp = GaussianProcess(X[:i+1], Y[:i+1])
        
        mean, cov = gp.predict(X[i+1], full_cov=True)
        var = cov[i+1]
        
        if var < 0.01: # Prevent division by zero
            var = 0.01
        
        noise_var = 0.001 ** 2 # Observation noise variance
        weights = np.exp(- (mean - lb) ** 2 / (2 * var))
        weights /= np.sum(weights)
        
        idx = rng.choice(i+1, p=weights)
        X[i+1] = X[idx]
        Y[i+1] = func(X[i+1])
    
    best_idx = np.argmin(Y)
    return X[best_idx]
