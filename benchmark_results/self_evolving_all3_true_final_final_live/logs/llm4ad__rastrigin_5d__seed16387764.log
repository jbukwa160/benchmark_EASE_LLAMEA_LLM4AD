def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_fitness = func(x)

    for _ in range(budget):
        v = rng.normal(size=dim)
        u = clip_candidate(best_x + 0.1 * v, lb, ub)
        w = clip_candidate(u + 0.1 * rng.normal(size=dim), lb, ub)
        y = np.where(rng.random(dim) < 0.5, x, u)
        z = np.where(rng.random(dim) < 0.5, y, w)

        new_fitness = func(z)
        if new_fitness < best_fitness:
            best_x = z
            best_fitness = new_fitness

    return best_x
