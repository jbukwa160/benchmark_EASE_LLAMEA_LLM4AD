def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(current, rng):
        return current + rng.uniform(-1, 1, size=dim)

    def evaluate(candidate):
        return func(candidate)

    n = 0
    best = None
    temperature = 1.0

    initial_solution = np.random.uniform(lb, ub, size=dim)
    current = initial_solution
    for _ in range(budget):
        candidate = generate_candidate(current, rng)
        candidate = np.clip(candidate, lb, ub)

        score_current = evaluate(current)
        score_candidate = evaluate(candidate)

        if score_candidate < score_current:
            current = candidate
            if best is None or score_candidate < func(best):
                best = candidate

        temperature *= 0.9999  # adaptive cooling schedule
        n += 1

        if best is not None and np.abs(func(best)) < 1e-6:  # early stopping based on convergence check
            break

    return best
