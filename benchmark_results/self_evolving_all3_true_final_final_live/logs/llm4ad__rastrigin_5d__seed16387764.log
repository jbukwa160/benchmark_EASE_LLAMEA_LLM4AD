def algorithm(func, dim, lb, ub, budget, rng):
    D = len(dim)
    n_offspring = 10 * D
    sigma = 0.5
    lambda_ = n_offspring
    x_mean = [np.mean([lb[i], ub[i]]) for i in range(D)]
    x_best = np.array(x_mean) - np.zeros(D)
    func_best = float('inf')

    for _ in range(budget):
        offspring = np.clip(np.random.normal(loc=x_mean, scale=sigma, size=(lambda_, D)), a_min=lb, a_max=ub)

        f_values = [func(offspring[i]) for i in range(lambda_)]
        x_new = np.array([offspring[f_values.index(min(f_values))]])

        func_new = min(f_values)
        if func_new < func_best:
            func_best = func_new
            x_best = x_new

        cov = 1 / lambda_ * sum([(x_new[i] - x_mean) * (x_new[i] - x_mean) for i in range(D)])
        mean_diff = np.mean([offspring[i] - x_mean for i in range(lambda_)])
        sigma *= 1 + 2 / (lambda_ + 3) if cov > 0 else 1
        x_mean += mean_diff

    return x_best
