def algorithm(func, dim, lb, ub, budget, rng):
    population_size = 50
    iterations = int(budget / (population_size * dim))
    sigma_init = 1.0
    sigma_final = 0.01
    cooling_rate = 0.99
    T_initial = 1000

    x_best = np.random.uniform(lb, ub, size=(dim,))
    f_best = func(x_best)

    for i in range(iterations):
        sigma = (sigma_final + (sigma_init - sigma_final) * (1 - cooling_rate ** i)) * rng.uniform()
        population = np.random.uniform(lb, ub, size=(population_size, dim))

        y = np.zeros((population_size,))
        for j in range(population_size):
            x_r = np.random.choice(population_size)
            while x_r == j:
                x_r = np.random.choice(population_size)

            z = population[j] + sigma * (population[x_r] - population[j])
            y[j] = func(z)

            if y[j] < f_best:
                f_best = y[j]
                x_best = z

        T = int(T_initial * (1 - cooling_rate ** i))
        for k in range(population_size):
            accept_prob = np.exp((f_best - y[k]) / T)
            if rng.random() < accept_prob:
                y[k] = f_best
                population[k] = x_best

    return x_best
