def algorithm(func, dim, lb, ub, budget, rng):
    pop = rng.uniform(lb, ub, (budget, dim))
    
    # Evaluate the initial population
    fit = np.array([func(cand) for cand in pop])
    
    # Main loop
    while True:
        # Select the best candidate so far
        best_cand = pop[np.argmin(fit)]
        
        # Stop if budget is reached or no improvement was made
        if np.min(np.abs(best_cand)) < 1e-5 or budget == 0:
            return best_cand
        
        # Update budget
        budget -= 1
        
        # Apply Nelder-Mead Simplex optimization for local search
        simplex = [best_cand]
        while len(simplex) <= dim + 1 and budget > 0:
            new_simplex = []
            for i in range(len(simplex)):
                cand_i = simplex[i] + rng.uniform(-1, 1, (dim,))
                cand_i = np.clip(cand_i, lb, ub)
                fit_i = func(cand_i)
                if fit_i < np.min(fit):
                    new_simplex.append(cand_i)
            simplex += new_simplex
            fit.extend([func(cand) for cand in new_simplex])
            simplex.sort(key=lambda x: func(x))
            
            # Perform reflection, expansion, contraction, or shrinkage
            if len(simplex) > dim + 1 and func(simplex[0]) < np.min(fit):
                mid = (simplex[0] + simplex[-2]) / 2.0
                fit.append(func(mid))
                simplex.append(np.clip(mid, lb, ub))
            
            # Remove worst candidate
            if len(simplex) > dim + 1:
                del fit[np.argmin(fit)]
                simplex.pop(-1)
        
        # Update best candidate and fitness values
        pop = np.array(simplex[:dim+1])
        fit = np.array([func(cand) for cand in pop])
