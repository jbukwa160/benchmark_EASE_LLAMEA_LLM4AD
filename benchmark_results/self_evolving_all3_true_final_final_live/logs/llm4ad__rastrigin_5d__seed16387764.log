def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=(1, dim))
    f_best = func(x_best)
    x_current = x_best.copy()
    f_current = f_best
    
    T = 100.0
    step_size = 0.01
    adaptive_restart_budget = budget // 10
    num_adaptive_restarts = 0
    
    for _ in range(budget):
        # Simulated annealing
        if rng.uniform(0, 1) < np.exp((f_current - f_best) / T):
            x_new = x_current + step_size * (ub - lb) * rng.normal(size=(1, dim))
            x_new = np.clip(x_new, lb, ub)
            f_new = func(x_new)
            
            if f_new < f_current:
                x_current = x_new
                f_current = f_new
                
                if f_new < f_best:
                    x_best = x_new
                    f_best = f_new
                    
        # Adaptive restarts
        num_adaptive_restarts += 1
        if num_adaptive_restarts >= adaptive_restart_budget and T > 0.01:
            T *= 0.99
            num_adaptive_restarts = 0
            
    return x_best
