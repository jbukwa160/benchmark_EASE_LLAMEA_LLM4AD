def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 10
    elite = 2
    sigma = 1.0
    
    best_sol = np.random.uniform(lb, ub, size=dim)
    best_val = func(best_sol)
    
    for i in range(budget):
        new_pop = np.zeros((pop_size, dim))
        for j in range(pop_size):
            if rng.rand() < elite / (i + 1):
                new_pop[j] = best_sol.copy()
            else:
                sol = np.random.uniform(lb, ub, size=dim)
                for k in range(dim):
                    if rng.rand() < 0.5:
                        sol[k] = new_pop[j, k]
                noise = np.random.normal(0, sigma, size=dim)
                sol += noise
                new_pop[j] = np.clip(sol, lb, ub).copy()
        best_sol = new_pop[np.argmin([func(x) for x in new_pop])]
        
    return best_sol
