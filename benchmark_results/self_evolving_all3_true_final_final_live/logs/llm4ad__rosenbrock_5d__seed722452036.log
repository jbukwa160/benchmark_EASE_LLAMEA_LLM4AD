def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(n):
        return rng.uniform(lb, ub, size=(n, dim))

    def evaluate(population):
        return func(clip(population))

    def simulate_annealing(population, temperature, num_iterations):
        for _ in range(num_iterations):
            for i in range(len(population)):
                new_population = population.copy()
                j = rng.choice(len(new_population))
                while j == i:
                    j = rng.choice(len(new_population))
                new_population[i] += rng.uniform(-temperature, temperature) * (new_population[j] - population[i])
                new_population[i] = clip(new_population[i])
                if evaluate(np.array([new_population[i]])) < evaluate(np.array([population[i]])):
                    population[i] = new_population[i]
                else:
                    if rng.random() < np.exp((evaluate(np.array([population[i]]) - evaluate(np.array([new_population[i]]))) / temperature)):
                        population[i] = new_population[i]

    def differential_evolution(population):
        for i in range(len(population)):
            r1, r2, r3 = rng.choice(len(population), size=3, replace=False)
            while r1 == i or r2 == i or r3 == i:
                r1, r2, r3 = rng.choice(len(population), size=3, replace=False)
            mutation = population[r1] + rng.uniform(-1, 1) * (population[r2] - population[r3])
            mutation = clip(mutation)
            if evaluate(np.array([mutation])) < evaluate(np.array([population[i]])):
                population[i] = mutation

    num_initial_population = min(1000, budget // 10)
    initial_population = generate_initial_population(num_initial_population)

    temperature = max(abs(lb), abs(ub))

    for _ in range(budget // 10):
        simulate_annealing(initial_population.tolist(), temperature, 20)
        differential_evolution(initial_population)
        temperature *= 0.9

    return np.argmin(evaluate(initial_population))
