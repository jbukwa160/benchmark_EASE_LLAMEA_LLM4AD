def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = np.atleast_1d(x)
        if len(x) != dim:
            raise ValueError("Dimension mismatch")
        return func(x)

    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = evaluate(best_x)

    n_smallest = int(0.1 * budget)
    population_size = 100

    for _ in range(budget):
        # Simulated annealing
        T = 10.0
        sigma = 0.5
        while True:
            new_x = clip(best_x + rng.uniform(-sigma, sigma, size=dim))
            f_new = evaluate(new_x)
            if f_new < best_f:
                best_f = f_new
                best_x = new_x
            elif np.random.rand() < np.exp(-(f_new - best_f) / T):
                best_f = f_new
                best_x = new_x
            T *= 0.99
            if T < 1e-3:
                break

        # Downhill simplex
        n_simplex = min(n_smallest, population_size)
