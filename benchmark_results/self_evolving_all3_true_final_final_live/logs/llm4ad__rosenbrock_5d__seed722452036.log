def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    pop_size = 10 * D + 15
    sigma_init = 0.5
    T_max = 10000
    T_min = 1e-3
    cooling_rate = 0.99

    # Initialize the population with random solutions in [lb, ub]
    x_pop = rng.uniform(lb, ub, (pop_size, D))

    # Initialize the covariance matrix for CMA-ES
    cov_matrix = np.eye(D)

    # Main loop
    for budget_used in range(budget):
        # Evaluate the function at the population
        f_values = func(x_pop)

        # Sort the population by fitness and select the best solution
        idx_sorted = np.argsort(f_values)
        x_best = x_pop[idx_sorted[:1]]
        f_best = f_values[idx_sorted[0]]

        # Update the covariance matrix using CMA-ES
        cov_matrix, mu, sigma, sigma_max = update_cma(cov_matrix, x_pop, f_values)

        # Simulated Annealing (SA) step
        if np.random.rand() < 1e-3:
            # Select a random solution from the population
            idx_random = rng.randint(0, pop_size)
            x_random = x_pop[idx_random]
            f_random = func(x_random)

            # If the new solution is better or has a lower probability of being worse (due to SA), replace the worst solution in the population
            if np.random.rand() < np.exp((f_best - f_random) / sigma_max):
                idx_worst = rng.choice(pop_size, 1, replace=False)[0]
                x_pop[idx_worst] = x_random

        # Update the covariance matrix using CMA-ES with the new solution
        cov_matrix, mu, sigma, sigma_max = update_cma(cov_matrix, x_pop, f_values)

    return x_best
