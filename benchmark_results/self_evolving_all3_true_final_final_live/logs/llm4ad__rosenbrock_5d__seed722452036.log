def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    T = 1000.0
    alpha = 0.99
    step_size = 1e-6

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(clip(x_best))
    prev_f = f_best

    for _ in range(budget):
        sigma = np.exp(-T / budget) * step_size
        new_x = clip(x_best + rng.normal(size=dim) * sigma)

        delta_f = func(clip(new_x)) - f_best

        if delta_f < 0:
            x_best, f_best = new_x, func(clip(new_x))
        elif rng.uniform() < np.exp(-delta_f / T):
            x_best, f_best = new_x, func(clip(new_x))

        prev_f = f_best
        T *= alpha

    return clip(x_best)
