def algorithm(func, dim, lb, ub, budget, rng):
    def generate_population(size, lb, ub):
        return np.random.uniform(lb, ub, size=(size, dim))

    def evaluate(x):
        return func(x)

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def differential_evolution(population, func, lb, ub, budget):
        n = population.shape[0]
        for _ in range(budget // 2):
            F = rng.uniform(0.5, 1.5)
            CR = rng.uniform(0.9, 1.0)
            C = np.random.choice(population, size=(n,), replace=False)
            for i in range(n):
                v = population[i] + F * (C[i] - population[i])
                if rng.rand() < CR:
                    v = np.where(rng.randint(0, 2, size=dim) == 1, v, population[i])
                population[i] = clip(v, lb, ub)
        return population

    def simulated_annealing(population, func, lb, ub, budget):
        T = 100.0
        for _ in range(budget // 2):
            for i in range(len(population)):
                x = np.copy(population[i])
                dx = rng.normal(size=dim)
                new_x = clip(x + 0.1 * dx, lb, ub)
                if evaluate(new_x) < evaluate(x):
                    population[i] = new_x
                else:
                    T *= 0.99
                    delta = evaluate(new_x) - evaluate(x)
                    if np.exp(-delta / T) > rng.rand():
                        population[i] = new_x

    population = generate_population(50, lb, ub)
    differential_evolution(population, func, lb, ub, budget // 2)
    simulated_annealing(population, func, lb, ub, budget // 2)
    return np.argmin(evaluate(np.array([clip(x, lb, ub) for x in population])), axis=0)
