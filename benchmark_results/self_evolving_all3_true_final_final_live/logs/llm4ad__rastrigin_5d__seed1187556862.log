def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def mutate(x, sigma):
        return x + sigma * (2*rng.rand(dim) - 1)

    def recombine(x1, x2):
        return (x1 + x2) / 2

    population = [lb + rng.rand(dim)*(ub-lb)]
    for _ in range(budget-1):
        offspring = []
        for parent in population:
            child = mutate(parent, rng.uniform(0.01, 0.1))
            offspring.append(child)
            child = recombine(parent, child)
            offspring.append(child)
        population += offspring
        population = [clip(x) for x in population]
        population.sort(key=func)
        population = population[:budget]
    return clip(population[0])
