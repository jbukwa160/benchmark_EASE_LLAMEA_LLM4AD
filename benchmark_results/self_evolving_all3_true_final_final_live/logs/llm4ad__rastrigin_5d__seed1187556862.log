def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = clip(rng.uniform(lb, ub, size=dim))
    temp = 1
    best_x = x.copy()
    for _ in range(budget):
        y = x + rng.normal(size=dim) * 0.01
        y = clip(y)
        f_y = func(y)
        f_best = func(best_x)
        delta_f = f_y - f_best

        if delta_f < 0 or (delta_f >= 0 and np.random.rand() < np.exp(-delta_f / temp)):
            x = y
            best_x = x.copy()

        # Adaptive temperature control
        alpha = 1.01
        temp *= max(alpha, 1 - (temp * budget) / (_ + 1))

    return best_x
