def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidates(mu, sigma):
        return mu + sigma * np.random.randn(dim)

    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def polynomial_mutation(individual, mutation_rate, bounds):
        for i in range(len(individual)):
            if rng.uniform(0, 1) < mutation_rate:
                delta = rng.uniform(bounds[i][0], bounds[i][1])
                individual[i] += delta
        return individual

    def cma_es(func, dim, lb, ub, budget, rng):
        mu = np.zeros(dim)
        sigma = 5.0
        lambda_ = 40
        crossover_probability = 0.5
        mutation_rate = 1 / dim
        bounds = [(lb, ub)] * dim

        for _ in range(budget):
            candidates = generate_candidates(mu, sigma) + np.random.randn(lambda_, dim)
            candidates = clip(candidates, lb, ub)

            fitness_values = func(candidates)
            parents = np.argsort(fitness_values)[:int(0.2 * lambda_)]
            mu = np.mean(candidates[parents], axis=0)
            sigma = 1 / (1 + np.sum(np.square(candidates[parents] - mu)) / (lambda_ * np.square(sigma)))

            for i in range(lambda_):
                if rng.uniform(0, 1) < crossover_probability:
                    parent1_idx, parent2_idx = rng.choice(parents, size=2, replace=False)
                    new_individual = candidates[parent1_idx] + rng.uniform(0, 1) * (candidates[parent2_idx] - candidates[parent1_idx])
                else:
                    new_individual = np.copy(candidates[i])

                mutated_individual = polynomial_mutation(new_individual, mutation_rate, bounds)

                if rng.uniform(0, 1) < 0.1:
                    sigma *= 1 + rng.uniform(-0.5, 0.5)
                    sigma = max(sigma, 0.01)

            mu = np.mean(candidates[parents], axis=0)
        return mu

    best_individual = cma_es(func, dim, lb, ub, budget // 10, rng)
    for _ in range(budget - (budget // 10)):
        individual = generate_candidates(best_individual, 1) + np.random.randn(dim)
        individual = clip(individual, lb, ub)
        if func(individual) < func(best_individual):
            best_individual = individual
    return best_individual
