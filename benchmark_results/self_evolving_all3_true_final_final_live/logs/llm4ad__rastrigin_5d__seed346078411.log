def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    max_iter = int(budget / (dim * 2))
    sigma = 1.0
    T = 1000.0
    alpha = 0.9

    x_best = np.random.uniform(lb, ub, size=(pop_size, dim))

    for t in range(max_iter):
        y = np.copy(x_best)
        f_y = func(y)

        for i in range(pop_size):
            z = np.copy(x_best[i])
            mutation = rng.normal(0, sigma, size=dim)
            v = z + mutation

            clip_v = np.clip(v, lb, ub)
            f_v = func(clip_v)

            if f_v < f_y:
                y[i] = clip_v
                f_y = f_v
            elif rng.uniform(0, 1) < np.exp((f_y - f_v) / T):
                y[i] = clip_v

        x_best = y
        sigma *= alpha
        T *= alpha

    return x_best[np.argmin(func(x_best))]
