def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    population_size = 50
    candidate_size = 1000
    sigma = 10 * (ub - lb) / dim ** 0.5

    population = rng.uniform(lb, ub, size=(population_size, dim))
    best_candidate = np.inf

    for i in range(candidate_size):
        noise = rng.normal(0, sigma, size=dim)
        candidate = clip(population + noise)

        if func(candidate) < func(best_candidate):
            best_candidate = candidate

        population[rng.randint(0, population_size)] = candidate

    for _ in range(budget - candidate_size):
        donor1_idx, donor2_idx, target_idx = rng.choice(population_size, size=3, replace=False)
        donor1, donor2, target = population[donor1_idx], population[donor2_idx], population[target_idx]

        weight = rng.uniform(0.5, 1.0)

        donor = clip(weight * target + (1 - weight) * (donor1 + donor2) / 2)
        if func(donor) < func(best_candidate):
            best_candidate = donor

    return best_candidate
