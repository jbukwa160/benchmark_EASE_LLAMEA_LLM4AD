def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(dim, lb, ub, rng):
        return np.random.uniform(lb, ub, size=(budget, dim))

    population = generate_initial_population(dim, lb, ub, rng)
    best_solution = None
    best_fitness = float('inf')

    for i in range(budget):
        # Evaluate the fitness of each candidate in the population
        fitnesses = func(population)

        # Update the best solution found so far
        best_idx = np.argmin(fitnesses)
        if fitnesses[best_idx] < best_fitness:
            best_fitness = fitnesses[best_idx]
            best_solution = clip(population[best_idx])

        # Differential Evolution step
        r1_idx, r2_idx, r3_idx = rng.randint(0, budget, size=3)
        while r1_idx == i or r2_idx == i or r3_idx == i:
            r1_idx, r2_idx, r3_idx = rng.randint(0, budget, size=3)

        candidate = clip(population[r1_idx] + 0.5 * (population[r2_idx] - population[r3_idx]))

        # Update the population with the new candidate
        population[i] = candidate

    return best_solution
