def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(-5.0, 5.0, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = x + rng.uniform(0, 1, size=dim) * rng.normal(0, 2, size=dim)
        y = np.clip(y, lb, ub)
        
        f = func(y)
        
        if f < best_f:
            best_x = y.copy()
            best_f = f

    return best_x
