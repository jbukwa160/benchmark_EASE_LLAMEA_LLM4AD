def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    T = 1e5
    alpha = 0.99
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        new_x = x.copy()
        i = np.random.randint(0, dim)
        new_x[i] += (ub - lb) * rng.uniform(-1, 1)
        new_x = np.clip(new_x, lb, ub)
        
        new_f = func(new_x)
        
        if new_f < best_f:
            best_x = new_x
            best_f = new_f
            
        delta = new_f - best_f
        
        if delta < 0 or rng.rand() < np.exp(-delta / T):
            x = new_x
            
        T *= alpha
        
    return best_x
