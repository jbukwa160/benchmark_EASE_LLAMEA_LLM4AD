def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidates):
        return np.clip(candidates, lb, ub)

    x = rng.uniform(-5, 5, size=(dim,))
    for _ in range(budget):
        y = func(x)
        best_x = x
        best_y = y

        # Create an offspring population with different step sizes
        sigma = np.exp(rng.loguniform(np.log(0.01), np.log(1)))
        offspring_population = clip(best_x + rng.normal(size=(100, dim)) * sigma)

        for i in range(100):
            y_i = func(offspring_population[i])
            if y_i < best_y:
                best_y = y_i
                best_x = offspring_population[i]

        x = best_x

    return best_x
