def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = clip(np.array(rng.uniform(lb, ub, size=dim)))
    T = 1e6  # initial temperature
    cooling_rate = 0.9995  # geometrically decreasing schedule

    for _ in range(budget):
        y = clip(x + rng.uniform(-T, T, size=dim))
        if func(y) < func(x):
            x = y
        else:
            prob = np.exp((func(x) - func(y)) / T)
            if prob > rng.uniform(0, 1):
                x = y

        T *= cooling_rate

    return clip(x)
