def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def mutate(population, best_individual, F, CR):
        mutated_population = np.copy(population)
        
        for i in range(dim):
            if rng.random() < CR:
                donor_index = rng.randint(0, population.shape[0])
                mutated_individual = population[donor_index] + F * (population[donor_index] - best_individual)
                mutated_population[i] += mutated_individual[i]
        
        return clip(mutated_population)

    def evaluate(population):
        return np.array([func(x) for x in population])

    def cooling_schedule(t, T0, alpha):
        return max(1e-6, T0 * np.exp(-alpha * t))

    def simulated_annealing(population, temperature, best_individual, best_fitness, budget, rng):
        while budget > 0:
            new_individual = mutate(population, best_individual, rng.uniform(0.5, 1.0), rng.uniform(0.1, 0.3))
            new_fitness = func(new_individual)
            
            if new_fitness < best_fitness:
                population = np.array([new_individual])
                best_individual = new_individual
                best_fitness = new_fitness
            else:
                delta = new_fitness - best_fitness
                probability = np.exp(-delta / temperature)
                
                if rng.random() < probability or rng.uniform(0, 1) < 0.01: # 1% chance to accept worse solution
                    population = np.array([new_individual])
                    best_individual = new_individual
                    best_fitness = new_fitness
            
            budget -= 1
            temperature = cooling_schedule(budget, 100, 0.0005)
        
        return best_individual

    T0 = 100
    alpha = 0.001
    
    population_size = int(np.sqrt(budget))
    
    if rng.random() < 0.5: # Flip a coin to decide whether to start with an initial guess or random sampling
        initial_guess = np.array([rng.uniform(lb, ub) for _ in range(dim)])
        population = np.array([initial_guess] * population_size)
    else:
        population = rng.random((population_size, dim)) * (ub - lb) + lb
    
    best_individual = clip(population[0])
    best_fitness = func(best_individual)
    
    for t in range(1, budget):
        temperature = cooling_schedule(t, T0, alpha)
        
        if rng.uniform(0, 1) < 0.01: # 1% chance to restart the search
            population = np.random.rand(population_size, dim) * (ub - lb) + lb
        
        for i in range(population.shape[0]):
            individual = clip(population[i])
            fitness = func(individual)
            
            if fitness < best_fitness:
                best_individual = individual
                best_fitness = fitness
        
        population = simulated_annealing(population, temperature, best_individual, best_fitness, budget - t, rng)
    
    return best_individual
