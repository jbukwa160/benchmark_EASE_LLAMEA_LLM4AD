def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    def generate_candidate(current_solution, rng):
        candidate = current_solution + (ub - lb) * rng.uniform(-1.0, 1.0, size=dim)
        return clip_candidate(candidate)

    def acceptance_probability(current_fitness, new_fitness, temperature):
        if new_fitness < current_fitness:
            return 1.0
        else:
            return np.exp(-(new_fitness - current_fitness) / temperature)

    dim = int(dim)
    lb = float(lb)
    ub = float(ub)
    budget = int(budget)
    rng = np.random.RandomState(rng)

    current_solution = (ub - lb) * rng.uniform(size=dim) + lb
    current_fitness = func(current_solution)

    for _ in range(budget):
        new_solution = generate_candidate(current_solution, rng)
        new_fitness = func(new_solution)

        temperature = 1.0 / (_ + 1)

        if new_fitness < current_fitness or rng.rand() < acceptance_probability(current_fitness, new_fitness, temperature):
            current_solution = new_solution
            current_fitness = new_fitness

    return clip_candidate(current_solution)
