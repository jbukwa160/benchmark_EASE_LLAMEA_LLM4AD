def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_solution = None
    best_value = float('inf')

    for _ in range(budget):
        candidate = rng.uniform(lb, ub, size=dim)
        candidate = clip(candidate)
        value = func(candidate)

        if value < best_value:
            best_value = value
            best_solution = candidate

        # Elitism: update the best solution with a certain probability
        if rng.rand() < 0.1 and not np.all(candidate == best_solution):
            best_solution = candidate

    return best_solution
