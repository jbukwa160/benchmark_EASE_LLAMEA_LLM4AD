def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_candidate(mean, sigma):
        return mean + sigma * (rng.standard_normal(dim) - 0.5)

    mean = np.zeros(dim)
    cov_matrix = np.eye(dim) * 1e-4
    n_evals = 0
    best_candidate = np.zeros(dim)
    best_func_value = float('inf')

    for _ in range(budget):
        candidate = generate_candidate(mean, np.sqrt(np.diag(cov_matrix)))
        clipped_candidate = clip(candidate)

        func_value = func(clipped_candidate)

        if func_value < best_func_value:
            best_func_value = func_value
            best_candidate = clipped_candidate

        n_evals += 1

        if n_evals % dim == 0: # re-evaluate covariance matrix every 'dim' evaluations
            cov_matrix, mean = cma_es_update(cov_matrix, mean, np.array([clipped_candidate]), func_value)

    return best_candidate
