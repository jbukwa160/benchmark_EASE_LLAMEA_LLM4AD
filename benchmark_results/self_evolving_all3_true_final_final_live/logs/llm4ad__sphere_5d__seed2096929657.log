def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.zeros(dim)
    sigma = 0.5
    p_c = 1.0 / (dim + 3.0)
    p_w = 1.0 / ((dim + 2.0) * np.sqrt((dim + 1.0)))
    w = np.ones(dim) * p_w
    c = np.ones(dim) * p_c

    for _ in range(budget):
        z = rng.randn(dim)
        v = np.dot(z, np.diag(np.exp(c)))
        x_new = clip(x + sigma * v)

        f_new = func(x_new)

        if f_new < func(x):
            x = x_new
            sigma *= 1.1 ** (1 - 2 / (dim + 3))
            c += z ** 2 * p_c

    return x
