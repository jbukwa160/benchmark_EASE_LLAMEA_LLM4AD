def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    x = 5 * (ub - lb) * rng.rand(dim)
    sigma = 1.0
    mu = 0
    c1 = 1.0
    c2 = 2.0
    damps = 1e-4
    n = dim

    for _ in range(budget):
        x_new = clip(x + sigma * rng.randn(dim))
        f_new = func(x_new)
        if f_new < mu:
            mu = f_new
            best_x = x_new
        c = (f_new - mu) / (sigma ** 2)

        sigma *= np.exp(c1 * c / (c2 + damps))
        x += (x_new - x) / (n + 1.0)
    return best_x
