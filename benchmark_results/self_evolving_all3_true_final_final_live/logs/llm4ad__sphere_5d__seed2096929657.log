def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    max_iter = int(budget / (pop_size * dim))
    
    x = rng.uniform(lb, ub, size=(pop_size, dim))
    best_x = x[np.argmin([func(xi) for xi in x])]

    for _ in range(max_iter):
        for i in range(pop_size):
            idx1, idx2, idx3 = np.random.choice(pop_size, 3, replace=False)
            if idx1 == i:
                idx1 = (idx1 + 1) % pop_size
            if idx2 == i:
                idx2 = (idx2 + 1) % pop_size
            if idx3 == i:
                idx3 = (idx3 + 1) % pop_size

            u = rng.uniform(lb, ub)
            v = rng.uniform(lb, ub)

            x_new = best_x + v * (x[idx1] - 2*x[i] + x[idx2]) / np.linalg.norm(x[idx1] - 2*x[i] + x[idx2])
            x_new = lb + (ub - lb) * x_new

            if func(x_new) < func(best_x):
                best_x = x_new
                x[i] = x_new.copy()

    return best_x
