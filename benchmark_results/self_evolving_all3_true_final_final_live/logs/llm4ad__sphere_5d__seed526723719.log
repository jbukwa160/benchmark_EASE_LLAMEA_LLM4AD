def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def mutate(x):
        return x + (ub - lb) * rng.uniform(-1, 1, size=dim)

    def crossover(p1, p2):
        c = 0.5
        mask = rng.random(size=dim) < c
        return np.where(mask, p1, p2)

    population_size = 100
    population = np.zeros((population_size, dim))
    for i in range(population_size):
        population[i] = clip(ub - lb * rng.uniform(size=dim))

    for _ in range(budget):
        fitnesses = [func(clip(x)) for x in population]
        idxs = np.argsort(fitnesses)[:int(population_size/2)]
        parents = population[idxs]

        offspring = []
        while len(offspring) < population_size:
            p1, p2 = rng.choice(parents, size=2, replace=False)
            child = crossover(p1, p2)
            if func(clip(child)) < func(clip(p1)):
                offspring.append(child)
            elif np.random.rand() < 0.5:
                offspring.append(mutate(child))

        population = np.array(offspring)

    best_idx = np.argmin([func(clip(x)) for x in population])
    return clip(population[best_idx])
