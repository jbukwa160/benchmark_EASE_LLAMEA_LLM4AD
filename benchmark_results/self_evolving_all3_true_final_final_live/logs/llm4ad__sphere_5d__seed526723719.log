def algorithm(func, dim, lb, ub, budget, rng):
    n = int(np.ceil(budget / 10))
    D = dim
    m = 50
    kappa = 1.04
    chi = 1.0 + 2/(D+1)
    cc = 0.8
    cs = 0.7
    cmu = 0.5

    mu = np.random.uniform(lb, ub, size=(m,))
    sigma = 10 * np.ones(D)

    pc = 0.01 + (ub - lb) / 2
    for _ in range(n):
        # selection
        y = func(mu)
        z = rng.normal(size=m)
        Z = np.random.choice([-1, 1], size=(m, D))
        sigma_new = sigma * np.exp(0.5 * (1 - 1/kappa) + cc * np.sqrt((kappa - 1)/kappa))

        # perturbation
        w = rng.normal(size=D)
        v = rng.laplace(size=D)

        # sample
        x = mu + sigma_new * z @ Z.T

        # clipping
        x = np.clip(x, lb, ub)

        # update
        f = func(x)
        if _ % 10 == 0:
            y_new = np.min(f)
            if y_new < y:
                mu = x[np.argmin(f)]
                sigma = sigma_new

        # covariance matrix adaptation
        C = (1 - 2/(D+3)) * cmu + (2/(D+3)) * (w @ w.T + v @ v.T)

    return mu
