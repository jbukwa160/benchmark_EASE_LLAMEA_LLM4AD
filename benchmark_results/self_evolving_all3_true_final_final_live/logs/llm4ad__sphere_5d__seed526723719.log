        beta = 0.5 * (ub - lb) / np.sqrt(i + 1)
        
        candidates = np.random.uniform(lb, ub, size=(100, dim))
        
        for candidate in candidates:
            clipped_candidate = np.clip(candidate, lb, ub)
            fval = func(clipped_candidate)
            
