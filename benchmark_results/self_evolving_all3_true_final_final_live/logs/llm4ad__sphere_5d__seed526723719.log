def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    
    # Initialize best solution found so far
    best_sol = None
    best_val = np.inf
    
    for _ in range(budget):
        # Sample a random population within the bounds
        sols = (ub - lb) * rng.rand(pop_size, dim) + lb
        
        # Evaluate the objective function at these points
        vals = func(sols)
        
        # Select the best solution found so far
        new_best_idx = np.argmin(vals)
        if vals[new_best_idx] < best_val:
            best_sol = sols[new_best_idx]
            best_val = vals[new_best_idx]
    
    return best_sol
