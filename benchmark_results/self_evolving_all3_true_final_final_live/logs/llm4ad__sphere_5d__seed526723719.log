def algorithm(func, dim, lb, ub, budget, rng):
    mu = 1.0 + rng.uniform(0, 1)
    sigma = (ub - lb) * rng.uniform(0.5, 1.5)
    x_best = lb + (ub - lb) * rng.uniform(size=dim)
    f_best = func(x_best)

    for i in range(budget):
        if i > 10 and rng.random() < 0.2:
            sigma *= np.exp(rng.normal(0, 1))
            mu += rng.normal(0, 1)
        
        x_candidate = x_best + sigma * (rng.normal(size=dim) + mu - rng.uniform(-1, 1, size=dim).dot(mu / np.linalg.norm(mu)))
        f_candidate = func(np.clip(x_candidate, lb, ub))
        
        if f_candidate < f_best:
            f_best = f_candidate
            x_best = x_candidate
    
    return np.clip(x_best, lb, ub)
