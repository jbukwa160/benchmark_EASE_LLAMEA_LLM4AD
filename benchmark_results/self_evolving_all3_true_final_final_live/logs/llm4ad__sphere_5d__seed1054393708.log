def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(-5.0, 5.0, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        new_x = x + 0.1 * rng.normal(size=dim)
        new_x = np.clip(new_x, lb, ub)
        new_f = func(new_x)

        if new_f < best_f:
            best_f = new_f
            best_x = new_x

        # quasi-random sampling for exploration
        x = (ub - lb) * rng.uniform(size=dim) + lb

    return best_x
