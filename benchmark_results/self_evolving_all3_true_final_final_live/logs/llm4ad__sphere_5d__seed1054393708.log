def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    x = np.zeros(dim)
    T = 1e6
    alpha = 0.99
    best_x = x.copy()
    best_f = func(clip(x))

    for i in range(budget):
        x_new = clip(x + rng.uniform(-5, 5, dim))
        f_new = func(x_new)

        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new

        if rng.rand() < np.exp((best_f - f_new) / T):
            x = x_new

        T *= alpha

    return best_x
