def algorithm(func, dim, lb, ub, budget, rng):
    n_iter = 0
    best_x = None
    best_f = np.inf
    
    # Define EI acquisition function
    def ei(model, x):
        mean, std = model.predict(x)
        return (mean - best_f) * normcdf((best_f - mean) / std)
    
    # Initialize probabilistic model
    from sklearn.gaussian_process import GaussianProcessRegressor
    gp_model = GaussianProcessRegressor(kernel=np.square(1.0*np.ones(dim)).tolist())
    
    while n_iter < budget:
        # Sample next candidate based on EI acquisition function
        x_new = rng.uniform(lb, ub, size=dim)
        
        # Evaluate new candidate
        f_new = func(x_new)
        
        # Update best candidate found so far
        if f_new < best_f:
            best_x = x_new
            best_f = f_new
        
        # Update probabilistic model
        gp_model.fit(np.vstack([best_x, x_new]), np.hstack([best_f, func(x_new)]))
        
        # Clip new candidate to bounds
        x_new = np.clip(x_new, lb, ub)
        
        n_iter += 1
    
    return best_x
