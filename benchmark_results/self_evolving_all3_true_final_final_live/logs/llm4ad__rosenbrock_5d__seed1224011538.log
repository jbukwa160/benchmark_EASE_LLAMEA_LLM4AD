def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_f = float('inf')
    
    for _ in range(budget):
        x = np.array([lb + (ub - lb) * rng.uniform() for _ in range(dim)])
        
        for _ in range(1000):  # Local gradient descent iterations
            grad = np.zeros(dim)
            
            for i in range(dim-1):
                grad[i] += 200.0 * (x[i+1] - x[i]**2) * (2*x[i] - 1)
                grad[i+1] -= 200.0 * (x[i+1] - x[i]**2)
                
            if np.any(np.abs(grad) > 1e-6):
                step_size = 1e-3
                x += step_size * grad
                
                # Clip candidates to [lb, ub]
                x = np.clip(x, lb, ub)
                
            f = func(x)
            
            if f < best_f:
                best_x = x.copy()
                best_f = f
    
    return best_x
