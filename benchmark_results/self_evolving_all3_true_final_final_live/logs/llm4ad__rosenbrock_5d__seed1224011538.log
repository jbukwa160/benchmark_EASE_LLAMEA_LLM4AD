def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.ceil((budget / 2)**(1/3)))
    pop = rng.uniform(lb, ub, (pop_size, dim))
    
    for _ in range(budget - pop_size):
        x_new = pop.copy()
        
        for i in range(pop_size):
            idx = np.random.choice(range(pop_size), replace=False)
            if rng.rand() < 0.1:  # 10% chance of mutation
                mu = pop[idx]
            else:
                mu = pop[i] + rng.uniform(-1, 1, dim) * (ub - lb)
            
            x_new[i] += rng.uniform(-0.5, 0.5) * (func(mu) - func(pop[i]))
        
        x_best = np.argmin([func(x) for x in x_new])
        pop[x_best] = x_new[x_best]
    
    return np.min([np.clip(x, lb, ub) for x in pop], axis=0)
