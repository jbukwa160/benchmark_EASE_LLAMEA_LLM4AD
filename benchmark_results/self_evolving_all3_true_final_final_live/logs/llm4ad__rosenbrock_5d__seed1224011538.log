def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x0 = np.random.uniform(lb, ub, size=dim)
    best_x = clip(x0.copy())
    best_f = func(best_x)

    step_size = 5.0
    iterations = 0

    while iterations < budget:
        x_new = best_x + rng.normal(size=dim) * (step_size / np.sqrt(iterations + 1))
        x_new = clip(x_new)
        f_new = func(x_new)

        if f_new < best_f:
            best_f = f_new
            best_x = x_new

        iterations += 1

    return best_x
