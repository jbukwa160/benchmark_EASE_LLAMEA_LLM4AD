def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    def crossover(p1, p2):
        F = 0.9  # mutation factor
        C = 1.0   # crossover probability
        v = p1 + F * (p2 - p1)
        u = rng.uniform(0, 1, dim)
        return bound(v) if u < C else bound(p1)

    def mutate(x):
        F = 0.9  # mutation factor
        v = x + F * rng.normal(size=dim)
        return bound(v)

    n_generations = budget // (2 * dim)
    pop_size = min(100, int(np.sqrt(budget)))
    pop = np.array([rng.uniform(lb, ub, dim) for _ in range(pop_size)])

    for generation in range(n_generations):
        pop_new = []
        for i in range(len(pop)):
            p1, p2, p3 = pop[(i - 1) % len(pop)], pop[(i + 1) % len(pop)], pop[i]
            c1, c2, c3 = crossover(p1, p2), crossover(p2, p3), crossover(p3, p1)
            m1, m2, m3 = mutate(c1), mutate(c2), mutate(c3)
            pop_new.append(np.mean([c1, c2, c3], axis=0))
            pop_new.append(m1)
            pop_new.append(m2)
            pop_new.append(m3)
        pop = np.array(pop_new)[:len(pop)]

    return bound(np.mean(pop, axis=0))
