def algorithm(func, dim, lb, ub, budget, rng):
    n_dim = dim
    n_samples = 1000
    root_node = {'value': float('inf'), 'x': None}
    
    nodes = [root_node]
    node_idx = 1
    
    for _ in range(budget):
        if len(nodes) > 200:
            parent_idx = rng.randint(0, len(nodes))
            leaf_nodes = [node for node in nodes if node != nodes[parent_idx]]
            child_idx = rng.choice(len(leaf_nodes), p=[-node['value'] for node in leaf_nodes])
            parent_node = nodes[parent_idx]
            leaf_node = leaf_nodes[child_idx]
            
            if -np.sum([func(node['x']) for node in nodes]) < -np.sum([func(parent_node['x']), func(leaf_node['x'])]):
                parent_node['children'] = [parent_node['x'], leaf_node['x']]
                parent_node['value'] = np.min([-func(x) for x in parent_node['children']])
            else:
                nodes[parent_idx] = parent_node
        
        # Select node to expand
        if len(nodes) > 1:
            select_prob = [-node['value'] / np.max([node['value'] for node in nodes]) for node in nodes]
            selected_idx = rng.choice(len(nodes), p=select_prob)
            selected_node = nodes[selected_idx]
        else:
            selected_idx = 0
            selected_node = root_node
        
        # Expand new children
        selected_x = selected_node['x']
        if selected_x is None or np.random.rand() < (budget - _)/budget:
            for i in range(n_dim):
                x_new = selected_x + rng.uniform(-1, 1) * 0.1
                x_new = np.clip(x_new, lb[i], ub[i])
                new_node = {'value': float('inf'), 'x': x_new}
                selected_node['children'] = [child for child in selected_node.get('children', []) if child != new_node['x']]
                nodes.append(new_node)
        
        # Backpropagate
        current_x = selected_node['x']
        current_value = func(current_x)
        while current_x is not None:
            selected_node['value'] = np.min([selected_node['value'], -current_value])
            if 'children' in selected_node:
                for child_idx, child in enumerate(selected_node['children']):
                    if child == current_x:
                        selected_node = nodes[node_idx]
                        node_idx += 1
            else:
                selected_node = root_node
            
            # Backpropagate to parent node
            current_value = -current_value
            current_x = selected_node['x']
    
    # Find best x
    best_value = float('inf')
    best_x = None
    for node in nodes:
        value = func(node['x'])
        if value < best_value:
            best_value = value
            best_x = node['x']
    
    return np.clip(best_x, lb, ub)
