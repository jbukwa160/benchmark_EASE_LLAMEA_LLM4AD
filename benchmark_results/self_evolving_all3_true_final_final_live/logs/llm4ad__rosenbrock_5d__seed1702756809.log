def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    n_dim = len(dim)
    pop_size = int(budget / (n_dim + 1))
    T_init = 1000.0
    alpha = 0.99

    x_best = lb + (ub - lb) * rng.rand(n_dim)
    f_best = func(x_best)

    for _ in range(pop_size):
        x_new = clip(x_best + rng.randn(n_dim) * (ub - lb))
        f_new = func(x_new)
        if f_new < f_best:
            x_best, f_best = x_new, f_new
        elif rng.rand() < np.exp(-(f_new - f_best) / T_init):
            x_best, f_best = x_new, f_new

        T_init *= alpha

    return clip(x_best)
