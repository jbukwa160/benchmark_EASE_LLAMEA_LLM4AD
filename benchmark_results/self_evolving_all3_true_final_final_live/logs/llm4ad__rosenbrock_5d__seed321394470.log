def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    step_size = 1.0
    for _ in range(budget):
        y = x.copy()
        for i in range(dim):
            epsilon = step_size * (ub - lb) * rng.randn()
            y[i] += epsilon
            y[i] = np.clip(y[i], lb, ub)
        if func(y) < func(best_x):
            best_x = y.copy()
        step_size *= 0.9  # Reduce step size by a factor of 10 every 100 iterations
        if _ % 100 == 99:
            step_size /= 10
    return best_x
