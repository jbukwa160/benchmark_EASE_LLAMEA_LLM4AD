def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidates(population):
        offspring = population + 0.5 * rng.normal(size=(population.shape[0], dim))
        for i in range(offspring.shape[0]):
            for j in range(dim):
                if rng.random() < 0.1:
                    offspring[i, j] += rng.uniform(-ub, ub)
        return clip(offspring)

    def differential_evolution(population, budget):
        for _ in range(budget // dim):
            candidates = generate_candidates(population)
            population = np.concatenate((population, candidates))
            population = population[:budget]
        return population

    def simulated_annealing(population, temperature, budget):
        for i in range(1, budget + 1):
            x_new = clip(population + temperature * rng.normal(size=population.shape))
            if func(x_new) < func(population):
                population = x_new
            else:
                probability = np.exp(-(func(x_new) - func(population)) / temperature)
                if rng.random() < probability:
                    population = x_new
            temperature *= 0.99

    initial_population = np.array([np.random.uniform(lb, ub, size=dim) for _ in range(20)])
    population = differential_evolution(initial_population, budget // dim * dim)

    temperature = 5.0
    simulated_annealing(population, temperature, int(budget - (budget // dim * dim)))

    return clip(population[np.argmin([func(x) for x in population])])
