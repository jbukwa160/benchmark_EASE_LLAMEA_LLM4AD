def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = clip(rng.uniform(lb, ub, size=dim))
    f_best = func(x_best)
    
    for _ in range(budget):
        # Generate a mutant vector
        v = rng.normal(size=dim)
        
        # Calculate the differential evolution vector
        u = np.zeros(dim)
        for i in range(dim):
            if rng.random() < 0.5:
                u[i] = x_best[i] + v[i]
            else:
                u[i] = clip(x_best[i] - v[i])
        
        # Perform crossover and mutation
        x_new = 0.7 * x_best + 0.3 * clip(u)
        
        # Evaluate the new candidate
        f_new = func(clip(x_new))
        
        # Update best solution if necessary
        if f_new < f_best:
            x_best = x_new
            f_best = f_new
    
    return x_best
