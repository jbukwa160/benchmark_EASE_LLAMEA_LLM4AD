def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    for _ in range(budget):
        # Local search step
        for i in range(dim):
            new_x = x.copy()
            new_x[i] += 0.1 * rng.uniform(-1, 1)
            if func(new_x[:i]) < func(x[:i]):
                new_x = np.clip(new_x, lb, ub)
                x = new_x
        # Global exploration step
        delta = (ub - lb) * rng.randn(dim)
        new_x = x + 0.5 * delta
        new_x = np.clip(new_x, lb, ub)
        if func(new_x) < func(x):
            x = new_x
        # Update best solution
        if func(x) < func(best_x):
            best_x = x.copy()
    return best_x
