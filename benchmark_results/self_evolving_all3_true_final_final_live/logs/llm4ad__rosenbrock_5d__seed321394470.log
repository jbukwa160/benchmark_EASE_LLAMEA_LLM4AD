def algorithm(func, dim, lb, ub, budget, rng):
    x0 = 5 * np.random.rand(dim) - 5
    t = 1e3
    T = [t]
    it = 0
    best_x = x0.copy()
    best_f = func(x0)

    while True:
        x_next = x0 + (ub - lb) * rng.uniform(-1, 1, size=dim)
        x_next = np.clip(x_next, lb, ub)

        f_next = func(x_next)

        if f_next < best_f or rng.rand() < np.exp(-(f_next - best_f) / t):
            it += 1
            best_x = x_next.copy()
            best_f = f_next

            # adaptive cooling schedule
            if it % int(0.9 * budget) == 0:
                T.append(np.max([T[-1] / 2, 1e-6]))

        t = T[-1]

        # differential evolution part
        for i in range(dim):
            x_i = np.copy(x_next)
            j = (rng.randint(0, dim) + i) % dim
            k = (rng.randint(0, dim) + i) % dim

            if rng.rand() < 0.1:
                alpha = erf(rng.randn()) * 2 - 1
                x_i[i] += alpha * (x_next[j] - x_next[k])

            x_i = np.clip(x_i, lb, ub)
            f_i = func(x_i)

            if f_i < best_f or rng.rand() < np.exp(-(f_i - best_f) / t):
                it += 1
                best_x = x_i.copy()
                best_f = f_i

        # stopping criteria
        if it >= budget:
            break

    return best_x
