def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    T = 1.0
    alpha = 0.99
    c = 0.1

    for _ in range(budget):
        f_x = func(clip(x))
        
        # Generate a new candidate point using a polynomial-based adaptive cooling schedule and gradient-free exploration-exploitation trade-off strategy.
        dx = rng.uniform(-c, c, size=dim)
        y = clip(x + 0.1 * T * dx)

        f_y = func(y)
        
        if f_y < f_x:
            x = y
        else:
            # Apply the Simulated Annealing acceptance criterion to update the temperature and candidate point.
            p = np.exp((f_x - f_y) / (T * c))
            if rng.uniform(0, 1) < p:
                x = y
            T *= alpha

    return x
