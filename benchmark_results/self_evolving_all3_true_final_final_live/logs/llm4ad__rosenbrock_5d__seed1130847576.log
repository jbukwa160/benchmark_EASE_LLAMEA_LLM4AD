def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(current, step_size):
        return current + np.random.uniform(-step_size, step_size, size=dim)

    def evaluate(x):
        return func(x), x

    def accept(current, new, temperature):
        if new < current:
            return True
        else:
            prob = np.exp(-(new - current) / temperature)
            return rng.rand() < prob

    best_candidate = np.zeros(dim)
    best_value = float('inf')
    current_candidate = np.random.uniform(lb, ub, size=dim)
    temperature = 1.0
    step_size = (ub - lb) * 2

    for _ in range(budget):
        new_candidate = generate_candidate(current_candidate, step_size)
        clipped_new_candidate = np.clip(new_candidate, lb, ub)
        new_value, new_candidate = evaluate(clipped_new_candidate)

        if new_value < best_value:
            best_value = new_value
            best_candidate = new_candidate

        if accept(best_value, new_value, temperature):
            current_candidate = new_candidate
            step_size *= 0.99  # Reduce step size for better exploration

        temperature *= 0.9999  # Slowly decrease the temperature for cooling

    return best_candidate
