def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_random_candidate():
        return rng.uniform(lb, ub, size=dim)

    def local_search(candidate, func, rng):
        current_best = candidate.copy()
        for _ in range(10 * dim):  # Perform local search for a reasonable number of iterations
            mutation_index = rng.randint(0, dim)
            new_candidate = candidate.copy()
            new_candidate[mutation_index] += rng.uniform(-1, 1)  # Apply random mutation
            new_candidate = clip(new_candidate)
            if func(new_candidate) < func(current_best):
                current_best = new_candidate
        return current_best

    def iterated_local_search(candidate, func, rng):
        for _ in range(budget // dim):  # Perform ILS for a reasonable number of iterations
            candidate = local_search(candidate, func, rng)
        return candidate

    best_candidate = generate_random_candidate()
    for _ in range(10):  # Random restarts to escape local optima
        current_candidate = iterated_local_search(generate_random_candidate(), func, rng)
        if func(current_candidate) < func(best_candidate):
            best_candidate = current_candidate
    return best_candidate
