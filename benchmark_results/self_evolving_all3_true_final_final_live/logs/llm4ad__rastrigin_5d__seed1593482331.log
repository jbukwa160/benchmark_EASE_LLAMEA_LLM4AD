def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    initial_population = rng.uniform(lb, ub, (budget, dim))
    best_so_far = np.inf
    current_temperature = 1.0

    for i in range(budget):
        # Simulated Annealing
        new_population = initial_population.copy()
        for j in range(dim):
            candidate1 = clip(new_population[i] + rng.uniform(-current_temperature, current_temperature))
            candidate2 = clip(new_population[i] - current_temperature)
            if func(candidate1) < func(candidate2):
                new_population[i, j] = candidate1
            else:
                p = np.exp((func(candidate2) - func(candidate1)) / (current_temperature * rng.uniform(0.5, 1)))
                if rng.random() > p:
                    new_population[i, j] = candidate1

        # Differential Evolution
        for j in range(dim):
            index1, index2, index3 = rng.choice(range(budget), 3, replace=False)
            mutation = 0.5 * (new_population[index1, j] + new_population[index2, j]) - new_population[index3, j]
            candidate = clip(new_population[i, j] + mutation * rng.uniform(-1, 1))
            if func(candidate) < func(new_population[i, j]):
                new_population[i, j] = candidate

        # Update best so far and temperature
        current_solution = np.mean(new_population, axis=0)
        if func(current_solution) < best_so_far:
            best_so_far = func(current_solution)
            best_solution = current_solution.copy()

        # Dynamic temperature adjustment
        if rng.uniform(0, 1) < 0.2 and i > budget / 4:
            current_temperature *= np.exp(rng.uniform(-1, -0.5))

    return best_solution
