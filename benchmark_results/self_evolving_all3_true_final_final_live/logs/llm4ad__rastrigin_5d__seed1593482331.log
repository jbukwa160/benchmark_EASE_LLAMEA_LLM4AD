def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(np.array(x))

    x0 = np.random.uniform(lb, ub, size=dim)
    best_x = np.copy(x0)
    best_obj = objective(best_x)

    for _ in range(budget):
        # Selection
        r1, r2, r3 = rng.randint(0, budget), rng.randint(0, budget), rng.randint(0, budget)
        while r1 == r2 or r1 == r3 or r2 == r3:
            r2, r3 = rng.randint(0, budget), rng.randint(0, budget)
        while r1 == r2 or r1 == r3 or r2 == r3:
            r3 = rng.randint(0, budget)

        u = np.array([x for x in best_x if x != best_x[rng.randint(0, dim)]])
        v = (ub - lb) * rng.uniform(size=dim)
        w = 1 + (ub - lb) * rng.uniform(size=dim)
        z = u[rng.randint(0, len(u))] + v / w

        # Mutation
        z[rng.choice(dim, dim // 2)] = np.random.uniform(lb, ub, size=(dim // 2))

        # Crossover
        x_new = best_x + 0.5 * (z - best_x)

        # Clipping and evaluation
        x_new = np.clip(x_new, lb, ub)
        obj_new = objective(x_new)

        if obj_new < best_obj:
            best_x = np.copy(x_new)
            best_obj = obj_new

    return best_x
