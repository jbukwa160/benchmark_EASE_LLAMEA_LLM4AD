def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x) + 1e-9  # avoid division by zero

    x_best = -np.ones(dim)
    f_best = float('inf')
    t = 0.5
    T = 100.0
    sigma = 0.1 * (ub - lb)

    for _ in range(budget):
        y = rng.uniform(lb, ub, size=dim) + x_best
        f_y = evaluate(y)
        if f_y < f_best:
            f_best = f_y
            x_best = y

        # SA part
        delta = np.random.normal(0, sigma, dim)
        z = x_best + t * delta
        while True:
            if all(lb <= z_i <= ub for i, z_i in enumerate(z)):
                f_z = evaluate(z)
                if rng.uniform() < np.exp((f_best - f_z) / T):
                    break
                else:
                    z = x_best + np.random.normal(0, sigma, dim)

        # DE part
        x1 = rng.uniform(lb, ub, size=dim) + x_best
        x2 = rng.uniform(lb, ub, size=dim) + x_best
        y_de = 2 * x_best - x1 + x2
        f_y_de = evaluate(y_de)
        if f_y_de < f_best:
            f_best = f_y_de
            x_best = y_de

    return x_best
