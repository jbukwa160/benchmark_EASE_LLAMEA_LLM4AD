def algorithm(func, dim, lb, ub, budget, rng):
    bounds = [(lb, ub) for _ in range(dim)]
    
    def objective(x):
        return func(x)
    
    result = differential_evolution(objective, bounds=bounds, maxiter=budget//dim, polish=True, mutation=(1.2 if rng.random() < 0.5 else 0.8), recombination=0.7, strategy='rand1exp', x0=rng.uniform(lb, ub, size=(1, dim))[0])
    
    return np.clip(result.x, lb, ub)
