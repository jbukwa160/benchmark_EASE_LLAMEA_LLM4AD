def algorithm(func, dim, lb, ub, budget, rng):
    def generate_random_solution(dim, lb, ub):
        return (ub - lb) * rng.rand(dim) + lb

    x_best = None
    f_best = np.inf

    sigma = 0.1 * (ub - lb)
    lambda_ = int(4 + 3 * dim**0.5)

    mu = np.zeros(dim)
    C = np.eye(dim)
    d = np.zeros((dim, lambda_))

    for t in range(budget):
        y = rng.randn(lambda_, dim)
        for i in range(lambda_):
            d[i] = C @ y[i]

        x = mu + sigma * d
        f = func(x)

        if f < f_best:
            f_best = f
            x_best = x

        u = (f - f_best) / sigma**2
        if t > 0 and u <= -1e-3:
            break

        y_new = np.zeros(lambda_)
        for i in range(lambda_):
            r = rng.randn(dim)
            s = C @ r
            y_new[i] = (s.T @ d[i]) / (d[i].T @ C @ d[i])

        y_new += u * mu / sigma**2

        C = C + 1 / lambda_ * np.outer(y_new, y_new) - np.outer(d[:, 0], d[:, 0])
        C = (C + C.T) / 2
        C[np.diag_indices(dim)] += 1 / lambda_

        mu = (1 - 1 / lambda_) * mu + 1 / lambda_ * x_best

    return x_best
