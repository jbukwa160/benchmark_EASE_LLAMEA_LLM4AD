def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    pop_size = 100
    population = rng.uniform(lb, ub, (pop_size, dim))
    
    for _ in range(budget):
        fitness = [func(clip(x)) for x in population]
        best_idx = np.argmin(fitness)
        best_candidate = clip(population[best_idx])
        
        next_population = []
        while len(next_population) < pop_size:
            parent1_idx, parent2_idx = rng.choice(pop_size, 2, replace=False)
            child = (clip(population[parent1_idx]) + clip(population[parent2_idx])) / 2.0
            for i in range(dim):
                if rng.random() < 0.01:
                    child[i] += rng.uniform(-ub, ub) - lb
            next_population.append(child)
        population = np.array(next_population)
    
    return best_candidate
