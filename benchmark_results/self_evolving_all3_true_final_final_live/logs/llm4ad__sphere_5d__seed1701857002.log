def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget - 1):
        dx = rng.normal(size=dim)
        step_size = rng.uniform(0.01, 1)
        new_x = x + step_size * dx
        new_x = np.clip(new_x, lb, ub)
        
        new_f = func(new_x)
        
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f

    return best_x
