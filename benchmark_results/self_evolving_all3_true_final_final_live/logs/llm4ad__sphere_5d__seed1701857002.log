def algorithm(func, dim, lb, ub, budget, rng):
    best_x = rng.uniform(-5.0, 5.0, size=dim)
    best_f = func(best_x)

    for i in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        f = func(x)

        if np.linalg.norm(x - best_x) < 1e-6 or f < best_f:
            step_size = 0.5
            while True:
                candidate = best_x + step_size * (x - best_x)
                clipped_candidate = np.clip(candidate, lb, ub)
                new_f = func(clipped_candidate)

                if new_f < f:
                    best_x = clipped_candidate
                    best_f = new_f
                else:
                    break

                step_size *= 0.5

    return best_x
