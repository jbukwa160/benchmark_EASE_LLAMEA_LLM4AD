def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def objective(x):
        x = np.atleast_2d(x)
        return func(x).flatten()

    def gp_local_search(best_x, best_f, n_iterations=10):
        X = []
        Y = []
        sigma = 1.0
        for _ in range(n_iterations):
            mu = best_x
            sigma *= 0.99
            x_new = mu + rng.normal(size=(dim,)) * sigma
            f_new = objective(clip(x_new))
            if f_new < best_f:
                X.append(best_x)
                Y.append(best_f)
                best_x = clip(x_new)
                best_f = f_new
        return best_x, best_f

    def cma_es_global_search(best_x, best_f, population_size=50, n_iterations=10):
        for _ in range(n_iterations):
            pop = rng.normal(size=(population_size, dim))
            pop = clip(pop + best_x)
            f_pop = objective(pop)
            idx = np.argsort(f_pop)
            pop = pop[idx]
            f_pop = f_pop[idx]
            if f_pop[0] < best_f:
                best_f = f_pop[0]
                best_x = pop[0]

    best_x, best_f = None, float('inf')
    for _ in range(budget):
        if rng.random() < 0.5: # 50% chance of global search
            best_x, best_f = cma_es_global_search(best_x, best_f)
        else: # 50% chance of local search
            best_x, best_f = gp_local_search(best_x, best_f)

    return np.array([best_x])
