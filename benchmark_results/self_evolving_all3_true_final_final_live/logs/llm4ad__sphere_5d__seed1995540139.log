def algorithm(func, dim, lb, ub, budget, rng):
    def sample(rng, dim, lb, ub):
        return rng.uniform(lb, ub, size=dim)

    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    best_solution = None
    best_value = float('inf')

    temperature = 1.0

    for _ in range(budget):
        x = sample(rng, dim, lb, ub)
        x_clipped = clip(x, lb, ub)
        f_x = func(x_clipped)

        if f_x < best_value:
            best_solution = x_clipped
            best_value = f_x

        alpha = rng.uniform(0.5, 1.5)  # temperature adaptation factor
        delta_f = f_x - best_value
        delta_temp = np.exp(-delta_f / (temperature * budget))

        if delta_temp > rng.rand():
            temperature *= alpha
            temperature = max(0.001, min(100.0, temperature))  # bounds on temperature

    return best_solution
