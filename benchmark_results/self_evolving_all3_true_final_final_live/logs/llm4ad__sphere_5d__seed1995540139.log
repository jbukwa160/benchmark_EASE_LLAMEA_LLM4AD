def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=(1, dim))
    best_eval = func(x_best)
    
    for i in range(1, budget + 1):
        n_samples = max(int(np.sqrt(i)) - 5, 10)  # Increase sample number as budget increases
        candidates = np.random.uniform(lb, ub, size=(n_samples, dim))
        
        for _ in range(n_samples):
            candidate = candidates[np.random.choice(n_samples, 1)[0]]
            
            if (candidate > x_best).any() or (np.isnan(candidate)).any():
                continue
            
            eval = func(candidate)
            
            if eval < best_eval:
                best_eval = eval
                x_best = candidate
                
    return x_best
