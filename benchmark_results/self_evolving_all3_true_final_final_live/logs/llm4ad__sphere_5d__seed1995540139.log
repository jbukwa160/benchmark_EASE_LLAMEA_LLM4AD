def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    def sample(dim):
        return rng.uniform(lb, ub, size=dim)

    def evaluate(population):
        fitnesses = [func(individual) for individual in population]
        return fitnesses

    def update_population(population, mu, sigma):
        new_population = []
        for _ in range(len(population)):
            parent1, parent2 = rng.choice(population, size=2, replace=False)
            child = parent1 + rng.normal(size=dim) * sigma
            child = clip_candidate(child)
            new_population.append((child, func(child)))
        return sorted(new_population, key=lambda x: x[1])

    mu = 10
    sigma = 1.0
    population_size = 100

    population = [sample(dim) for _ in range(population_size)]
    population = sorted(population, key=func)

    for _ in range(budget):
        population = update_population(population, mu, sigma)
        mu = np.mean([individual[0] for individual in population[:mu]])
        sigma = 1 / len(population[:mu]) * np.sqrt(np.sum([(individual[0] - mu) ** 2 for individual in population[:mu]]))

    return [individual[0] for individual in population][0]
