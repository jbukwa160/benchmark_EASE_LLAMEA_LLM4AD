def algorithm(func, dim, lb, ub, budget, rng):
    n = 50  # number of population members
    T = 1000  # initial temperature
    alpha = 0.99  # cooling rate

    pop = rng.uniform(lb, ub, (n, dim))
    best = np.inf
    for i in range(budget):
        for j in range(n):
            candidate = pop[j]
            for k in range(dim):
                perturb = rng.uniform(-1, 1)
                candidate[k] += perturb * 0.5 * (ub[k] - lb[k])
                if not (lb <= candidate[k] <= ub):
                    candidate[k] = np.clip(candidate[k], lb, ub)

            candidate_fitness = func(candidate)
            if candidate_fitness < best:
                best = candidate_fitness
                best_candidate = candidate

            pop[j] = np.clip(pop[j] + 0.01 * (candidate - pop[j]), lb, ub)

        for j in range(n):
            k = rng.randint(0, n)
            for l in range(dim):
                if rng.random() < 0.1:
                    perturb = rng.uniform(-1, 1)
                    pop[k][l] += perturb * 0.5 * (ub[l] - lb[l])
                    if not (lb <= pop[k][l] <= ub):
                        pop[k][l] = np.clip(pop[k][l], lb, ub)

        for j in range(n):
            candidate_fitness = func(pop[j])
            if candidate_fitness < best:
                best = candidate_fitness
                best_candidate = pop[j]

        T *= alpha

    return best_candidate
