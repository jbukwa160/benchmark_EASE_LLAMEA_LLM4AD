def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for _ in range(budget):
        x = np.copy(best_x)
        i = np.random.randint(dim)
        dx = 0.5 * (ub - lb) / dim
        if rng.random() < 0.5:
            x[i] += dx
        else:
            x[i] -= dx

        f = func(np.clip(x, lb, ub))
        if f < best_f:
            best_x = x
            best_f = f

    return best_x
