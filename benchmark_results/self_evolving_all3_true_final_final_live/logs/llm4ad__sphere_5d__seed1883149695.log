def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(mu, sigma):
        return mu + sigma * rng.normal(size=dim)

    def evaluate(candidate):
        candidate = clip(candidate)
        return func(candidate), candidate

    x_best = np.zeros(dim)
    f_best = float('inf')
    step_size = 1.0
    mutation_probability = 0.1
    for _ in range(budget):
        mu = (ub + lb) / 2
        sigma = step_size * rng.uniform(0, 1, size=dim)
        candidates = [generate_candidate(mu, sigma)]
        while len(candidates) < budget:
            candidate = generate_candidate(mu, sigma)
            if rng.rand() < mutation_probability or np.linalg.norm(candidate - mu) > 5 * np.linalg.norm(sigma):
                candidates.append(candidate)
        y_best, x_best_new = min((evaluate(candidate) for candidate in candidates), key=lambda x: x[0])
        if y_best < f_best:
            f_best = y_best
            x_best = x_best_new
        step_size *= 1.1
        mutation_probability *= 1.001
    return x_best
