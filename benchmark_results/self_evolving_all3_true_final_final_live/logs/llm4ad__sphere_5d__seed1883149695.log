def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x), len(np.where(x != 0)[0])

    mu = 1.0
    sigma = 2.0
    lambda_ = int(4 + 3 * dim ** (1 / 4))
    distribution = np.zeros((lambda_, dim))

    for i in range(lambda_):
        distribution[i] = rng.uniform(lb, ub, size=dim)

    population_size = 1
    best_solution = None

    while budget > 0:
        solutions = np.array([evaluate(distribution[i]) for i in range(lambda_)])
        ranks = np.argsort(solutions[:, 0])

        if best_solution is None or solutions[ranks[-1], 0] < best_solution[0]:
            best_solution = solutions[ranks[-1]]

        selected_indices = ranks[:population_size]
        distribution[selected_indices] = solutions[selected_indices, 1] * rng.normal(size=(population_size, dim)) + \
                                         solutions[selected_indices, 1]

        sigma *= (np.mean(solutions[:, 1]) / mu) ** (3 / lambda_)

        budget -= population_size
        if best_solution is None:
            continue

    return np.array([best_solution[1]])
