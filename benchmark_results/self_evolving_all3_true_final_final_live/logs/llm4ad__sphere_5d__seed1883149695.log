def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def sample(budget):
        x = np.zeros(dim)
        for _ in range(budget):
            x += rng.uniform(-1.0, 1.0, size=dim)
        return clip(x / (np.linalg.norm(x) + 1e-8))

    def evaluate(x):
        return func(x)

    population_size = 10
    step_size = 1.0
    best = np.inf

    for _ in range(population_size):
        x = sample(budget)
        f_x = evaluate(x)
        if f_x < best:
            best = f_x
            best_solution = x

    for _ in range(1000): # max number of iterations
        mean = (best_solution + np.zeros(dim)) / 2.0
        variation = rng.uniform(-1.0, 1.0, size=dim)
        new_mean = clip(mean + step_size * variation)

        f_new_mean = evaluate(new_mean)

        if f_new_mean < best:
            best = f_new_mean
            best_solution = new_mean

    return best_solution
