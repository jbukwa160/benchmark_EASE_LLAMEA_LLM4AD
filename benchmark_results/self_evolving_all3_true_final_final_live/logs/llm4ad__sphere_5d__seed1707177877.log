def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 10 * (ub - lb)**2
    t = 0
    best_x = x.copy()
    best_f = func(x)

    while t < budget:
        if t % 100 == 0:  # every 100 iterations
            T *= 0.99

        for i in range(dim):
            a = rng.uniform(lb, ub)
            b = rng.uniform(0, 1)
            new_x = x.copy()
            if rng.random() < 0.5:
                new_x[i] += (ub - lb) * b
            else:
                new_x[i] += (new_x[i] - lb) / (ub - lb) * (b ** (1 / np.log(t + 2)))

            new_x = np.clip(new_x, lb, ub)
            new_f = func(new_x)

            if new_f < best_f or rng.random() < np.exp((best_f - new_f) / T):
                x = new_x.copy()
                best_x = new_x.copy()
                best_f = new_f

        t += 1

    return best_x
