def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        step_size = 0.1
        noise = np.array(rng.random(dim)) * 2 - 1

        new_x = x + noise * (ub - lb) / 10

        # clip to bounds
        new_x = np.clip(new_x, lb, ub)

        new_f = func(new_x)
        
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f
        
        x = new_x + (best_x - x) / np.linalg.norm(best_x - x) * step_size

    return best_x
