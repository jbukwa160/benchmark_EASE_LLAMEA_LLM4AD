def algorithm(func, dim, lb, ub, budget, rng):
    def sphere(x):
        return np.sum(np.square(x))

    x = np.random.uniform(lb, ub, size=dim)
    x_best = x.copy()
    best_value = func(x)

    step_size = 5.0
    annealing_rate = 0.99

    for _ in range(budget):
        sigma = step_size * (1 - annealing_rate)**_ / np.sqrt(_ + 1)

        # CMA-ES step
        x_new = x_best + rng.normal(size=(dim,)) * sigma
        clipped_x_new = np.clip(x_new, lb, ub)
        new_value = func(clipped_x_new)

        if new_value < best_value:
            x_best = clipped_x_new.copy()
            best_value = new_value

        # SA step
        delta = rng.normal(size=(dim,))
        sa_step_size = 0.1 * np.exp(-_ / budget) * sigma

        for _ in range(dim):
            x_new = x_best + delta[:_] * sa_step_size
            clipped_x_new = np.clip(x_new, lb, ub)
            new_value = func(clipped_x_new)

            if new_value < best_value:
                x_best = clipped_x_new.copy()
                best_value = new_value

    return x_best
