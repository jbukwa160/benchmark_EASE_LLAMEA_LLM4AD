def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.random.uniform(lb, ub, size=dim)
    best_y = func(best_x)
    
    current_x = np.copy(best_x)
    current_y = best_y
    
    T = 1.0
    alpha = 0.99
    
    for _ in range(budget):
        new_x = rng.normal(size=dim)
        
        # Clip to bounds
        new_x = np.clip(new_x + current_x, lb, ub)
        
        new_y = func(new_x)
        
        if new_y < current_y:
            current_x = new_x
            current_y = new_y
            
            # Update best solution if necessary
            if current_y < best_y:
                best_x = current_x
                best_y = current_y
                
        elif rng.uniform(0, 1) < np.exp((current_y - new_y) / T):
            current_x = new_x
            current_y = new_y
            
        # Adaptive cooling schedule
        if _ % (budget // 10) == 0:
            T *= alpha
            
    return best_x
