def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_x = np.zeros(dim)
    best_f = float('inf')
    iteration = 0

    while iteration < budget:
        x = best_x + rng.normal(size=dim) * (ub - lb)
        x = clip(x)
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
        
        iteration += 1

        if iteration % int(budget / 10) == 0:  # restart every 10% of budget
            best_x = np.zeros(dim)

    return best_x
