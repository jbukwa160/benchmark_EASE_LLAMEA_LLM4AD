def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, a_min=lb, a_max=ub)

    def de_sa(params):
        x = params[:dim]
        y = params[dim:]

        f_x = func(clip(x, lb, ub))
        f_y = func(clip(y, lb, ub))

        if rng.random() < 0.1:  # 10% chance of accepting worse solution
            if f_x > f_y:
                return np.concatenate((x, y)), True
            else:
                return np.concatenate((y, x)), False

        alpha = rng.uniform(-1, 1)
        trial_x = clip(x + alpha * (y - x), lb, ub)

        f_trial_x = func(clip(trial_x, lb, ub))
        beta = rng.uniform(0, 1)

        if rng.random() < 0.5:  # 50% chance of using SA
            T = np.sqrt(np.linalg.norm(x) ** 2)
            delta_f = f_trial_x - f_x
            if np.exp(-delta_f / T) > beta:
                return np.concatenate((trial_x, [f_trial_x])), True
        else:
            if f_trial_x < f_x or rng.random() < (np.exp(-(f_trial_x - f_x)) + 1e-6):
                return np.concatenate((trial_x, [f_trial_x])), True

        return np.concatenate((x, [f_x])), False

    params = np.array([-5.0] * dim + [func(np.zeros(dim))])
    for _ in range(budget):
        next_params, accepted = de_sa(params)
        if accepted:
            params = next_params
        else:
            break

    return params[:dim]
