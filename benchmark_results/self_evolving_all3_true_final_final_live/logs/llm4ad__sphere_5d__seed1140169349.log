def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    grid_size = 10.0 / (ub - lb)
    best_candidate = None
    best_value = float('inf')

    for i in range(int(budget)):
        candidate = np.zeros(dim) + rng.uniform(lb, ub)
        clipped_candidate = clip(candidate)
        
        value = func(clipped_candidate)

        if value < best_value:
            best_value = value
            best_candidate = clipped_candidate

        if rng.random() < 0.1:
            grid_size *= 2.0 / (ub - lb)

        for _ in range(int(budget * 0.9)):
            new_candidate = clipped_candidate + rng.uniform(-grid_size, grid_size, size=dim)
            new_value = func(new_candidate)
            
            if new_value < best_value:
                best_value = new_value
                best_candidate = new_candidate

    return best_candidate
