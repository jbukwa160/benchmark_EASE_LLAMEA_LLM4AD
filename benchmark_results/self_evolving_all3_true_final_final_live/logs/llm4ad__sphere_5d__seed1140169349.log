def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    for i in range(budget):
        x_rand = lb + (ub - lb) * rng.rand(dim)
        
        if func(x_rand) < f_best:
            x_best = x_rand
            f_best = func(x_rand)
        
        # Adaptive sampling: focus on the most promising region
        step_size = max(1e-3, 0.9 ** (i / budget))
        sigma = 0.1 * np.std(x_best) if np.std(x_best) > 1e-2 else 1e-2
        
        x_new = x_best + rng.randn(dim) * step_size
        x_new = lb + (ub - lb) * (x_new / np.linalg.norm(x_new))
        
        if func(x_new) < f_best:
            x_best = x_new
            f_best = func(x_new)
    
    return x_best
