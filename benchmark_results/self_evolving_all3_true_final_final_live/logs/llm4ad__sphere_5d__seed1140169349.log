def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(current, sigma):
        candidate = current + rng.normal(size=dim) * sigma
        return clip(candidate)

    def accept(current, new, temperature):
        if func(new) < func(current):
            return True
        else:
            probability = np.exp(-(func(new) - func(current)) / temperature)
            return rng.random() < probability

    current = np.zeros(dim)
    temperature = 1.0
    sigma = ub - lb

    for _ in range(budget):
        new = generate_candidate(current, sigma * (ub - lb))
        if accept(current, new, temperature):
            current = new
            sigma *= 0.99
            temperature *= 0.9999

    return current
