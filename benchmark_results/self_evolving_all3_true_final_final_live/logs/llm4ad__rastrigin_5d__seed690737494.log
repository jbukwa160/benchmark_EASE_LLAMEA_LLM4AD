def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    max_iter = int(budget / (dim * pop_size))
    sigma = 0.1
    CR = 0.5
    F = 0.8
    
    def generate_initial_population(dim, lb, ub):
        return np.random.uniform(lb, ub, size=(pop_size, dim))
    
    def evaluate(candidate):
        candidate = np.clip(candidate, lb, ub)
        return func(candidate)
    
    def select_parents(population, evaluation):
        indices = np.argsort(evaluation)
        parents = population[indices[:int(0.2 * pop_size)]]
        return parents
    
    def crossover(parent1, parent2, CR):
        child = parent1.copy()
        for i in range(dim):
            if rng.random() < CR:
                child[i] = parent2[i]
        return child
    
    def mutate(child, sigma):
        mutated_child = child + np.random.uniform(-sigma, sigma, size=dim)
        return np.clip(mutated_child, lb, ub)
    
    population = generate_initial_population(dim, lb, ub)
    evaluation = [evaluate(candidate) for candidate in population]
    
    for _ in range(max_iter):
        parents = select_parents(population, evaluation)
        
        children = []
        for i in range(int(0.8 * pop_size)):
            parent1, parent2 = parents[np.random.randint(parents.shape[0]), :], parents[(np.random.randint(parents.shape[0])) % (parents.shape[0] - 1), :]
            child = crossover(parent1, parent2, CR)
            child = mutate(child, sigma)
            children.append(child)
        
        evaluation_children = [evaluate(candidate) for candidate in children]
        
        population = np.concatenate((population, np.array(children)))
        evaluation = evaluation + evaluation_children
        
        indices = np.argsort(evaluation)
        population = population[indices[:pop_size]]
        evaluation = evaluation[indices[:pop_size]]
    
    best_candidate = population[np.argmin(evaluation)]
    return best_candidate
