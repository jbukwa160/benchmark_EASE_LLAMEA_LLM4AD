def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    current = np.zeros(dim)
    best = current.copy()
    radius = 5.0
    for _ in range(budget):
        perturbation = rng.uniform(-radius, radius, dim)
        candidate = clip(current + perturbation)
        
        if func(candidate) < func(best):
            best = candidate

        radius *= 0.9
        current = best.copy()

    return best
