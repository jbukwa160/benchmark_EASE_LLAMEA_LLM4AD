def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    current_f = best_f
    temperature = 1.0

    for i in range(1, budget + 1):
        # SA step
        new_x = x.copy() + rng.normal(size=dim) * 0.01
        new_x = clip(new_x)

        # CMA-ES step
        if rng.uniform() < 0.9:
            cov_matrix = np.eye(dim)
            for _ in range(10):
                z = rng.normal(size=dim)
                s = np.dot(cov_matrix, z) * 0.1
                new_x += s

        new_x = clip(new_x)

        new_f = func(new_x)

        if new_f < current_f:
            x = new_x
            current_f = new_f
        else:
            # SA acceptance criterion
            delta = new_f - current_f
            if delta < 0 or rng.uniform() < np.exp(-delta / temperature):
                x = new_x
                current_f = new_f

        # Adaptively adjust the temperature based on the convergence rate
        if i % 100 == 0:
            if current_f < best_f - 1e-5 * (i + 1) ** (-0.8):
                temperature *= 0.99

        # Update the best solution
        if current_f < best_f:
            best_x = x.copy()
            best_f = current_f

    return best_x
