def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        segment_size = max(1e-3, (ub - lb) / 10)
        x = np.clip((ub - lb) * rng.rand(dim) + lb, lb, ub)
        
        count = 0
        while True:
            f = func(x)
            if f < best_f:
                best_x = x.copy()
                best_f = f
                
            count += 1
            
            if f >= best_f or count > 100:
                segment_size /= 2
                break
        
        lb += segment_size
        ub -= segment_size
    
    return best_x
