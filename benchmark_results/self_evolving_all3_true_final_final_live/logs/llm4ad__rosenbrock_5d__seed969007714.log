def algorithm(func, dim, lb, ub, budget, rng):
    def acquisition(x):
        mu = func(x)
        std = 1e-6 + 0.1 * np.exp(-norm.cdf(np.abs(mu)))
        return mu - 2 * std

    x_best = np.random.uniform(lb, ub, size=dim)
    for _ in range(budget):
        if rng.rand() < 0.01:
            x_new = x_best + rng.normal(size=dim) * 1e-3
            x_new = np.clip(x_new, lb, ub)
            if acquisition(x_new) > acquisition(x_best):
                x_best = x_new

        else:
            gp = GaussianProcessRegressor(kernel=1.0 * RBF(length_scale=1.0), alpha=1e-6)
            X = [x_best]
            y = [acquisition(x_best)]
            for _ in range(100):
                x_new = rng.uniform(lb, ub, size=dim)
                gp.fit(X, y)
                mu = gp.predict(np.array([x_new]))
                std = gp.std_[0] * np.exp(-norm.cdf(np.abs(mu)))
                if rng.rand() < np.exp(acquisition(x_new) - acquisition(x_best)):
                    X.append(x_new)
                    y.append(acquisition(x_new))
                    x_best = x_new
                else:
                    break

    return x_best
