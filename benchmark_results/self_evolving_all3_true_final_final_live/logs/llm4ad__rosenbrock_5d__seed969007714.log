def algorithm(func, dim, lb, ub, budget, rng):
    n_evals = 0
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    def gp_mean(X):
        mean = np.zeros((X.shape[0],))
        for i in range(dim):
            mean += np.log(np.sum([np.exp(-norm.pdf(x[i] - X[:,i])) for x in X]))
        return mean

    def gp_var(X, X_test):
        var = np.zeros((len(X), len(X_test)))
        for i in range(dim):
            for j in range(len(X)):
                for k in range(len(X_test)):
                    var[j,k] += (x[k,i] - x[j,i])**2 * np.exp(-norm.pdf(x[k,i] - x[j,i]))
        return var

    def acquisition(X, alpha=0.01):
        mean = gp_mean(X)
        var = gp_var(X, X)
        return mean + alpha * np.sqrt(var)

    while n_evals < budget:
        X = np.random.uniform(lb, ub, size=(int(budget/2), dim))
        for _ in range(int(budget/2)):
            x_new = np.argmax(acquisition(X)) if acquisition(X).max() > 0 else rng.choice(len(X))
            f_new = func(np.clip(X[x_new], lb, ub))

            n_evals += 1
            X = np.vstack((X[:x_new], X[x_new+1:]))
            X = np.vstack((X, np.random.uniform(lb, ub, size=(int(budget/2) - len(X), dim))))

            if f_new < f_best:
                x_best = np.clip(np.array([f_new] + list(X[x_new])), lb, ub)
                f_best = f_new
        X = np.vstack((X[:x_new], X[x_new+1:]))
    return x_best[1:]
