def algorithm(func, dim, lb, ub, budget, rng):
    x_init = rng.uniform(lb, ub, size=dim)
    best_x = x_init.copy()
    best_f = func(x_init)

    gp = GaussianProcessRegressor(kernel=rbf(1e-3), random_state=rng)
    gp.fit(np.array([best_x]).T, np.array([best_f]))

    for t in range(budget):
        if t % 10 == 0:
            gp.fit(np.array([best_x]).T, np.array([best_f]))
        
        mean, std = gp.predict(np.array([[np.nan]*dim]).T, return_std=True)
        x_new = rng.normal(mean, std, size=dim)
        x_new = clip(x_new, lb, ub)

        f_new = func(x_new)
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new

    return best_x
