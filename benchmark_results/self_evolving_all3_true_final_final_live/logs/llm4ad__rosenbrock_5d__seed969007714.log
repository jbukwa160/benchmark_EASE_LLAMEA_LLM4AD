def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def create_simplex(dim):
        simplex = np.zeros((dim + 1, dim))
        for i in range(1, dim + 1):
            simplex[i] = lb + (ub - lb) * rng.rand()
        return simplex

    def nelder_mead_simplex(simplex, func, dim):
        y_best = float('inf')
        x_best = None
        for _ in range(budget // dim):
            centroid = np.mean(simplex[:-1], axis=0)
            z = func(centroid)
            if z < y_best:
                y_best = z
                x_best = centroid
            rho = 2.0 / (dim + 1) * simplex[-1] - simplex[:-1]
            s = np.argsort(rho, kind='mergesort')[: dim // 2 + 1]
            for i in s:
                simplex[i] += rho[i]
        return x_best

    def differential_evolution(simplex, func, dim):
        population_size = int(np.ceil(budget / (dim * 100)))
        population = np.random.rand(population_size, dim) * (ub - lb) + lb
        for _ in range(int(np.ceil(budget / (population_size * 10)))):
            fitness = np.array([func(individual) for individual in population])
            idx_best = np.argmin(fitness)
            x_best = population[idx_best]
            if func(x_best) < func(simplex[-1]):
                simplex[-1] = x_best
        return simplex[-1]

    simplex = create_simplex(dim)
    best_solution = clip(nelder_mead_simplex(simplex, func, dim))
    for _ in range(budget - int(np.ceil(budget / (dim * 100))) * population_size * 10):
        new_simplex = differential_evolution(simplex, func, dim)
        if func(new_simplex) < func(best_solution):
            best_solution = clip(new_simplex)

    return best_solution
