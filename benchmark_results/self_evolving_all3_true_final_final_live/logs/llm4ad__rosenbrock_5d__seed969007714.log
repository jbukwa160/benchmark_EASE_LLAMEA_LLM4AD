def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(size, dim, lb, ub):
        return (ub - lb) * rng.random((size, dim)) + lb

    def clip_population(population, lb, ub):
        return np.clip(population, lb, ub)

    def mutate_individual(individual, lb, ub, mutation_rate):
        mutated = individual.copy()
        for i in range(len(mutated)):
            if rng.random() < mutation_rate:
                mutated[i] += (ub - lb) * rng.uniform(-1.0, 1.0)
                mutated[i] = np.clip(mutated[i], lb, ub)
        return mutated

    def generate_offspring(population):
        parents = population[np.argsort(rng.randint(0, len(population), size=len(population)))[::-1][:len(population)//2]]
        offspring = []
        while len(offspring) < len(population):
            parent1 = parents[rng.randint(0, len(parents))]
            parent2 = parents[rng.randint(0, len(parents))]
            child = (parent1 + parent2) / 2.0
            offspring.append(child)
        return np.array(offspring)

    def fitness(individual):
        return func(individual)

    population_size = int(np.sqrt(budget))
    initial_population = generate_initial_population(population_size, dim, lb, ub)
    best_individual = None

    for i in range(1, budget+1):
        clipped_population = clip_population(initial_population, lb, ub)
        fitness_values = np.array([fitness(individual) for individual in clipped_population])
        sorted_indices = np.argsort(fitness_values)[:population_size//2]
        population = clipped_population[sorted_indices]
        
        for j in range(len(population)):
            mutated_individual = mutate_individual(population[j], lb, ub, 0.1)
            fitness_value = fitness(mutated_individual)
            if best_individual is None or fitness_value < fitness(best_individual):
                best_individual = mutated_individual
        
        initial_population = generate_offspring(population)

    return best_individual
