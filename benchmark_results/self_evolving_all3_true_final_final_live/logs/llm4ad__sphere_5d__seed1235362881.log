def algorithm(func, dim, lb, ub, budget, rng):
    x_best = None
    f_best = np.inf
    
    for _ in range(budget):
        # Generate a random initial solution
        x0 = np.clip(rng.uniform(lb, ub, size=(dim)), lb, ub)
        
        # Perform local search using differential evolution
        res_de = differential_evolution(func, [[lb]*dim, [ub]*dim], x0=x0, polish=True)
        
        # Check if the best solution found so far is improved
        f_best_candidate = func(res_de.x)
        if f_best_candidate < f_best:
            x_best = res_de.x.copy()
            f_best = f_best_candidate
        
    return np.array([x_best])
