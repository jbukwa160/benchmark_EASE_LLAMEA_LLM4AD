def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, (1, dim))
    gbest = x.copy()
    best = func(clip(gbest))

    for _ in range(budget):
        offspring = np.zeros((1, dim))
        v = rng.normal(size=(1, dim))
        
        # Modified DE
        for i in range(dim):
            vi = v[0, i]
            xi = x[0, i]
            gxi = gbest[0, i]
            
            if rng.rand() < 0.5:
                offspring[0, i] = xi + vi * (gxi - xi)
            else:
                offspring[0, i] = xi + vi * (x[0, i] - xi)
        
        offspring = clip(offspring)
        f_offspring = func(offspring)
        
        if f_offspring < best:
            x = offspring.copy()
            gbest = x.copy()
            best = f_offspring

    return gbest
