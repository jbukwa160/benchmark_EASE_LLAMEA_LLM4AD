def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        offspring_size = 4 * dim
        parents = rng.choice(dim, size=offspring_size, replace=False)
        candidates = np.eye(dim)[parents] + 0.5 * (np.random.randn(dim) - 1)
        
        clipped_candidates = clip(candidates)
        new_f = func(clipped_candidates)
        
        if rng.uniform(0, 1) < 0.1: # 10% chance of accepting all
            x = clipped_candidates.copy()
        else:
            for i in range(offspring_size):
                if new_f[i] < best_f:
                    best_f = new_f[i]
                    best_x = clipped_candidates[i].copy()
        
    return best_x
