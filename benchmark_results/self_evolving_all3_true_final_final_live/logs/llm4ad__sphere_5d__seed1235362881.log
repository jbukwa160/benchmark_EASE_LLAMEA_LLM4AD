def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    best_val = 0
    T = 1000.0
    alpha = 1e-3
    
    for _ in range(budget):
        x = np.array(rng.uniform(lb, ub, size=dim))
        
        if func(x) < best_val:
            best = x.copy()
            best_val = func(x)
            
        delta = func(best) - func(x)
        if delta > 0 or rng.rand() < np.exp(-delta / T):
            best = x.copy()
            best_val = func(x)
        
        T *= (1 - alpha)
    
    return best
