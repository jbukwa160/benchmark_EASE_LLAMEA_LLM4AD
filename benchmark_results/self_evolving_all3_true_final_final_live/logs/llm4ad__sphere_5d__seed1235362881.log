def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n = int(budget ** (1 / D))
    sigma0 = 5.0
    mu = np.zeros(D)
    cov = np.eye(D) * sigma0**2
    x_best = None

    for _ in range(n):
        z = np.random.randn(D)
        y = mu + sigma0 * np.sqrt(np.diag(cov)) * z / np.linalg.norm(z)
        y = np.clip(y, lb, ub)

        f_value = func(y)

        if x_best is None or f_value < func(x_best):
            x_best = y

        sigma = 2**(-1/D) + sigma0
        cov = (1 - 2**(-2/D)) * cov + np.outer(sigma * z, sigma * z / np.linalg.norm(z)**2)

    return x_best
