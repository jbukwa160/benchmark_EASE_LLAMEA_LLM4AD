def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = None
    best_obj = float('inf')
    
    for _ in range(budget):
        sol = rng.uniform(lb, ub, size=dim)
        
        while True:
            new_sol = sol + rng.uniform(-1e-3, 1e-3, size=dim)
            
            # Clip to bounds
            new_sol = np.clip(new_sol, lb, ub)
            
            obj = func(new_sol)
            
            if obj < best_obj:
                best_sol = new_sol
                best_obj = obj
                
            if rng.uniform(0, 1) > 0.999:  # accept or reject with low probability
                sol = new_sol
                
    return best_sol
