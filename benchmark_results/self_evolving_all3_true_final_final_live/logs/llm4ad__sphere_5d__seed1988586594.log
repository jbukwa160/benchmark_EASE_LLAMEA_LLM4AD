def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    n = 4 * dim + 1  # population size
    mu = np.zeros(dim)
    sigma = 0.5
    c1 = 2 / (dim + 1.25)
    c_mu = (dim + 2) / ((dim + 2) ** 2 - 1)

    for _ in range(budget):
        x = np.random.normal(mu, sigma, (n, dim))
        x = clip(x)
        
        f_x = func(x)
        y = np.argsort(f_x)[:1]
        
        mu = (mu * c_mu + x[y].mean(axis=0)) / (c_mu + 1)

    return mu
