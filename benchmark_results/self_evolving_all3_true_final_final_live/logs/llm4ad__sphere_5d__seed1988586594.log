def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    x = np.array([0] * dim)
    T = 1e6
    alpha = 0.99
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = clip_candidate(best_x + rng.uniform(-5.0, 5.0, size=dim))
        f_y = func(y)
        
        if f_y < best_f:
            best_f = f_y
            best_x = y.copy()
            
        elif np.random.rand() < np.exp((best_f - f_y) / T):
            best_f = f_y
            best_x = y.copy()

        T *= alpha

    return best_x
