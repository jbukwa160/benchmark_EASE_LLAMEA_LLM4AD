def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    step_size = 1.0
    best_x = None
    best_f = float('inf')

    for _ in range(budget):
        y = x + step_size * np.random.normal(size=x.shape)
        clipped_y = np.clip(y, lb, ub)

        if func(clipped_y) < func(x):
            x = clipped_y

        if func(x) < best_f:
            best_x = x
            best_f = func(x)

        step_size *= 0.9995  # exponential decay

    return best_x
