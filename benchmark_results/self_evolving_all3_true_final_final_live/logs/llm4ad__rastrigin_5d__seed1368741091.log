def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    best_candidate = np.zeros(dim)
    best_fitness = float('inf')
    num_restart = 0

    while True:
        for _ in range(budget // dim):
            candidate = rng.uniform(lb, ub, size=dim)
            clipped_candidate = clip(candidate)
            fitness = func(clipped_candidate)

            if fitness < best_fitness:
                best_candidate = clipped_candidate
                best_fitness = fitness

        num_restart += 1
        new_candidates = np.zeros((num_restart * dim, dim))
        for i in range(num_restart * dim):
            candidate = rng.uniform(lb, ub, size=dim)
            clipped_candidate = clip(candidate)
            new_candidates[i] = clipped_candidate

        new_fitnesses = func(new_candidates)

        if num_restart == 1:
            best_candidate = np.mean(new_candidates[new_fitnesses.argmin()], axis=0)
            best_fitness = new_fitnesses.min()
        else:
            idx = new_fitnesses.argsort()[::-1][:num_restart]
            new_candidates = new_candidates[idx]

            for i in range(num_restart):
                candidate = (new_candidates[i] + best_candidate) / 2
                clipped_candidate = clip(candidate)
                fitness = func(clipped_candidate)

                if fitness < best_fitness:
                    best_candidate = clipped_candidate
                    best_fitness = fitness

        if budget - num_restart * dim <= 0 or new_fitnesses.min() >= best_fitness:
            break

    return best_candidate
