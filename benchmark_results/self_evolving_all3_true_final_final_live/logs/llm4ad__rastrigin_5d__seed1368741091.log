def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(n_particles, dim):
        return rng.uniform(lb, ub, size=(n_particles, dim))

    def calculate_objective(x):
        return func(x)

    n_particles = 50
    n_iterations = int(budget / n_particles)
    learning_rate = 0.1

    population = generate_initial_population(n_particles, dim)
    personal_best = population.copy()
    global_best = np.inf * -np.ones(dim)

    for _ in range(n_iterations):
        velocities = np.zeros((n_particles, dim))
        for i in range(n_particles):
            r1 = rng.uniform(0, 1)
            r2 = rng.uniform(0, 1)
            velocities[i] += learning_rate * (r1 * personal_best[i] + r2 * global_best - population[i])
        
        # DE crossover
        children = np.zeros((n_particles, dim))
        for i in range(n_particles):
            idx1, idx2, idx3 = rng.choice(range(n_particles), 3, replace=False)
            children[i] = (population[idx1] + velocities[idx1]) / 2 + r1 * (population[idx2] - population[idx3])

        # Clip to bounds
        children = np.clip(children, lb, ub)

        # Update personal best and global best
        for i in range(n_particles):
            new_fitness = calculate_objective(children[i])
            if new_fitness < calculate_objective(population[i]):
                population[i] = children[i]
                personal_best[i] = population[i]
                if new_fitness < calculate_objective(global_best):
                    global_best = population[i]

    # Return the best solution found
    best_solution = np.argmin([calculate_objective(x) for x in population])
    return population[best_solution]
