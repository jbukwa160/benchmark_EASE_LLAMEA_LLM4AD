def algorithm(func, dim, lb, ub, budget, rng):
    def bounds(i, j):
        if i == 0:
            return [lb[i], ub[i]]
        else:
            return [(lb[i] + (ub[i] - lb[i]) * j / (dim - 1)), (lb[i] + (ub[i] - lb[i]) * (j + 1) / (dim - 1))]

    def hybrid_sampling(bounds, rng):
        candidates = np.zeros((budget, dim))
        for i in range(dim):
            candidates[:, i] = np.random.uniform(bounds[i][0], bounds[i][1], budget)
        return candidates

    def local_search(candidate, func, lb, ub, rng):
        best_candidate = candidate
        best_fitness = func(candidate)
        for _ in range(10):
            noise = rng.uniform(-1, 1, dim) / 100
            new_candidate = candidate + noise
            new_candidate = np.clip(new_candidate, lb, ub)
            new_fitness = func(new_candidate)
            if new_fitness < best_fitness:
                best_fitness = new_fitness
                best_candidate = new_candidate
        return best_candidate

    candidates = hybrid_sampling([lb, ub], rng)
    for i in range(budget - 1):
        fitnesses = [func(candidate) for candidate in candidates]
        indices = np.argsort(fitnesses)[:int(budget / 2)]
        sampled_candidates = candidates[indices, :]
        next_candidates = np.zeros((budget, dim))
        for j in range(dim):
            next_candidates[:, j] = np.random.uniform(bounds(j, int(rng.uniform(0, 1)))[0], bounds(j, int(rng.uniform(0, 1)))[1], budget)
        for k in range(budget):
            noise = rng.uniform(-1, 1, dim) / 10
            next_candidate = sampled_candidates[k] + (next_candidates[k] - sampled_candidates[k]) * np.random.uniform(0.5, 1.5) + noise
            next_candidate = np.clip(next_candidate, lb, ub)
            candidates[k] = local_search(next_candidate, func, lb, ub, rng)

    best_fitness = float('inf')
    best_candidate = None
    for candidate in candidates:
        fitness = func(candidate)
        if fitness < best_fitness:
            best_fitness = fitness
            best_candidate = candidate

    return best_candidate
