def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = 100
    sigma = 3.0
    mutation_prob = 0.1

    population = rng.uniform(lb, ub, size=(pop_size, dim))
    fitnesses = np.array([func(clip(pop)) for pop in population])

    best_pop = population[np.argmin(fitnesses)]
    best_fitness = np.min(fitnesses)

    for _ in range(budget):
        new_population = np.empty((pop_size, dim))

        for i in range(pop_size):
            parent1_idx = rng.randint(0, pop_size)
            parent2_idx = rng.randint(0, pop_size)

            if fitnesses[parent1_idx] < fitnesses[parent2_idx]:
                parent1, parent2 = population[parent1_idx], population[parent2_idx]
            else:
                parent1, parent2 = population[parent2_idx], population[parent1_idx]

            child = np.copy(parent1)
            for j in range(dim):
                if rng.random() < mutation_prob:
                    child[j] += rng.uniform(-sigma, sigma)

            new_population[i] = clip(child)

        fitnesses_new = np.array([func(clip(pop)) for pop in new_population])

        population = new_population
        fitnesses = fitnesses_new

        idx = np.argmin(fitnesses)
        if fitnesses[idx] < best_fitness:
            best_pop = population[idx]
            best_fitness = fitnesses[idx]

    return clip(best_pop)
