def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    pop_size = 50
    population = rng.uniform(lb, ub, (pop_size, dim))
    best_solution = population[np.random.choice(pop_size)]
    best_fitness = float('inf')

    for _ in range(budget):
        # Differential Evolution
        a, b, c = np.random.choice(pop_size, size=3, replace=False)
        mutant = best_solution + 0.5 * (population[b] - population[a]) + 0.5 * (population[c] - best_solution)

        # Simulated Annealing
        temperature = 100.0 / _  # Decrease the temperature over time
        probability = np.exp((evaluate(best_solution) - evaluate(mutant)) / temperature)
        mutant_fitness = evaluate(mutant)

        if rng.random() < probability or mutant_fitness < best_fitness:
            best_solution = mutant
            best_fitness = mutant_fitness

    return best_solution
