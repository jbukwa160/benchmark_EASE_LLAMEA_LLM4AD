def algorithm(func, dim, lb, ub, budget, rng):
    n = int(np.ceil(budget / 10))
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    for i in range(n):
        x_cand = []
        for _ in range(100):
            x = np.array(lb + (ub - lb) * rng.rand(dim), dtype=float)
            if rng.random() < 0.1:
                x[:len(x_best)] = x_best
            x_cand.append(x)

        f_cand = [func(np.clip(x, lb, ub)) for x in x_cand]
        idx = np.argmax(f_cand)
        x_new = x_cand[idx]

        if func(x_new) < f_best:
            x_best = x_new
            f_best = func(x_best)

    return np.clip(x_best, lb, ub)
