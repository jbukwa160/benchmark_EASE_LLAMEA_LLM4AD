def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = clip(x)
    best_f = evaluate(best_x)

    for _ in range(budget):
        # Generate offspring
        v = rng.normal(size=dim)
        u = rng.uniform(-1, 1, size=dim)
        y = x + u * v

        # Clip to bounds
        y = clip(y)

        # Evaluate and update
        f_y = evaluate(y)
        if f_y < best_f:
            best_x = y
            best_f = f_y

    return best_x
