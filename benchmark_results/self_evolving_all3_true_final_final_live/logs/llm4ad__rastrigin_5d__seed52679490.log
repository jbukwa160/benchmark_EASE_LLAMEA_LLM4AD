def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    n = len(rng)
    D = 0.01 * (ub - lb)**2
    c1 = 0.5 / n
    c_mu = 2 / (n + 3) if n > 1 else 1

    x_mean = np.zeros(dim)
    cov = D * np.eye(dim)

    best_x = None
    best_f = float('inf')

    for t in range(budget):
        z = rng.randn(n, dim)
        y = z / np.linalg.norm(z, axis=0) + x_mean

        # Sample from truncated normal distribution with mean x_mean and covariance cov.
        x_cand = np.clip(y @ np.diag(np.sqrt(cov)) + x_mean, lb, ub)

        f_cand = f(x_cand)
        if f_cand < best_f:
            best_f = f_cand
            best_x = x_cand

        # Update mean and covariance.
        delta = x_cand - x_mean
        cov = (1 - c1) * cov + c1 * delta @ delta.T
        x_mean = x_mean + c_mu * delta

    return best_x
