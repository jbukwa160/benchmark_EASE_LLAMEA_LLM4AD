def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    sigma = 0.1
    T = 1000
    alpha = 0.95
    
    x_best = np.zeros(dim)
    f_best = np.inf
    
    for i in range(budget):
        x_curr = rng.uniform(lb, ub, size=dim)
        
        while True:
            noise = rng.normal(0, sigma, size=dim)
            trial = x_curr + noise
            
            # Clip to bounds
            trial = np.clip(trial, lb, ub)
            
            f_trial = func(trial)
            
            if f_trial < f_best:
                x_best = trial
                f_best = f_trial
                
            elif rng.uniform(0, 1) < np.exp(-(f_trial - f_best) / T):
                x_curr = trial
            
            # Simulated Annealing cooling schedule
            T *= alpha
            
            if T < 1e-6:
                break
        
        # Differential Evolution mutation strategy
        noise = rng.normal(0, sigma, size=dim)
        x_new = x_best + np.sum(rng.uniform(-1, 1, size=(pop_size-1, dim)), axis=0) * noise
        
        # Clip to bounds
        x_new = np.clip(x_new, lb, ub)
        
        if func(x_new) < f_best:
            x_best = x_new
            f_best = func(x_best)
    
    return x_best
