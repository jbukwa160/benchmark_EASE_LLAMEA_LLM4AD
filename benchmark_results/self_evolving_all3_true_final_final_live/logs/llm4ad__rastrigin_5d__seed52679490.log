def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(clip(x_best))

    for _ in range(budget - 1):
        x_candidate = rng.uniform(lb, ub, size=dim)
        f_candidate = func(clip(x_candidate))
        
        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate

    return clip(x_best)
