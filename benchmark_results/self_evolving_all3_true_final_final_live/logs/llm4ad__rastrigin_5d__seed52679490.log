def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    x_best = np.zeros(dim)
    y_best = float('inf')

    for _ in range(budget):
        x = np.random.uniform(lb, ub, size=dim)
        y = f(x)

        if y < y_best:
            y_best = y
            x_best = x

        candidates = np.clip(x + rng * (np.random.uniform(-1, 1, size=(dim,)) * lb + np.random.uniform(0, 1, size=(dim,))), lb, ub)
        for i in range(dim):
            y = f(candidates)

            if y < y_best:
                y_best = y
                x_best = candidates

    return x_best
