def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    x = np.random.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        new_x = x + rng.randn(dim,)
        new_x = clip(new_x)
        
        res = minimize(lambda x: func(clip(x)), new_x, method='SLSQP', bounds=[(lb, ub)]*dim, constraints=())
        
        if res.fun < best_f:
            best_f = res.fun
            best_x = res.x
            
    return np.array(best_x)
