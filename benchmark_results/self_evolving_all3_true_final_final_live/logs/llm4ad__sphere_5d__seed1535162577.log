def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_random_candidate():
        return rng.uniform(lb, ub, size=dim)

    candidate = generate_random_candidate()
    best_candidate = candidate.copy()
    current_best_value = func(candidate)
    best_value = current_best_value

    temperature = 1.0
    for _ in range(budget):
        new_candidate = clip(generate_random_candidate())
        delta_value = func(new_candidate) - current_best_value

        if delta_value < 0 or (delta_value >= 0 and rng.rand() < np.exp(-delta_value/temperature)):
            candidate = new_candidate
            current_best_value = func(candidate)

        if current_best_value < best_value:
            best_candidate = candidate.copy()
            best_value = current_best_value

        temperature *= 0.99  # cooling schedule

    return best_candidate
