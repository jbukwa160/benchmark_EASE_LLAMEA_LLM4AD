def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        new_x = x + rng.normal(size=x.shape)
        new_x = np.clip(new_x, lb, ub)
        
        if func(new_x) < best_f:
            best_x = new_x
            best_f = func(new_x)
            x = new_x

    return best_x
