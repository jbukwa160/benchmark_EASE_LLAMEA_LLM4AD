def algorithm(func, dim, lb, ub, budget, rng):
    def neg_func(x):
        return -func(x)

    init_x = rng.uniform(lb, ub, size=dim)
    init_y = func(init_x)

    x_best = init_x.copy()
    y_best = init_y
    dist_best = 0

    for _ in range(budget):
        # Bayesian Optimization with a novel acquisition function
        mean, var = model.predict(x_best.reshape(1, -1))
        std = np.sqrt(var)
        acq = mean + 2 * (ub - lb) / (dist_best + 1e-6) * np.exp(-(mean**2) / (4 * std**2))

        # Get the next candidate by sampling from a normal distribution centered at x_best
        next_x = rng.normal(x_best, acq.reshape(-1, 1) * (ub - lb) / (dist_best + 1e-6))
        next_x = np.clip(next_x, lb, ub)

        # Update the model and compute the new objective value
        y_next = func(next_x)
        x_best[next_x < x_best] = next_x[next_x < x_best]
        y_best = min(y_best, y_next)
        dist_best = 1 / (y_best + 1e-6)

        # Update the model
        X = np.vstack((x_best, init_x))
        Y = np.hstack((np.full_like(init_y, -init_y), func(X)))
        model.fit(X, Y)

    return x_best
