def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.array([0.5] * dim)
    y_best = func(x_best)

    for _ in range(budget):
        # Random Search phase
        x_random = lb + (ub - lb) * rng.rand(dim)
        y_random = func(x_random)
        
        if y_random < y_best:
            x_best = x_random
            y_best = y_random

        # Gradient Descent phase
        x_gd = np.copy(x_best)
        learning_rate = 0.01 / (1 + _ ** -1)  # adaptive learning rate
