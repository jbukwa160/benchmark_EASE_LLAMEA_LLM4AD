def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    x_best = np.random.uniform(lb, ub, size=(1, D))
    y_best = func(x_best)
    
    for i in range(budget):
        # Sample a random point
        x_random = np.random.uniform(lb, ub, size=(1, D))
        
        # Evaluate the surrogate model at this point
        f_mean, f_std = gp.predict(np.array([x_random]), eval_MCMC=False)
        f_sample = np.random.normal(f_mean[0], f_std[0])
        
        # Evaluate the objective function at this point
        if f_sample < y_best:
            x_best = x_random
            y_best = f_sample
        
        # Update the GP surrogate model with this new point and its function value
        gp.update(np.array([x_random]), [f_sample - 1e-6])
    
    return np.clip(x_best, lb, ub)
