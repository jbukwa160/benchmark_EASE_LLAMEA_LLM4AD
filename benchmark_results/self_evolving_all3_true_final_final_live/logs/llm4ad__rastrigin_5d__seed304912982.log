def algorithm(func, dim, lb, ub, budget, rng):
    D = 1 + int(np.floor(np.log10(budget)))
    ngen = 5 * (budget // D)
    
    x = rng.uniform(lb, ub, size=(dim,))
    y = x.copy()
    f = func(x)
    F = 0.8
    T = 100
    
    for i in range(ngen):
        for j in range(D):
            v = y + F * (rng.uniform(-1, 1, size=(dim,)) * ub - lb) + \
                rng.uniform(-1, 1, size=(dim,))
            v = np.clip(v, lb, ub)
            fv = func(v)
            
            if fv < f:
                x = v
                y = v
                f = fv
            else:
                if rng.random() < np.exp((f - fv) / T):
                    x = v
                    f = fv
        T *= 0.99
        
    return x
