def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    N = int(np.sqrt(budget))
    best_x = None
    best_y = float('inf')

    for i in range(N):
        N_halving = int(budget / (i + 1))
        x_init = rng.uniform(lb, ub, size=(dim,))
        x_best_halving = x_init.copy()
        y_best_halving = func(x_best_halving)

        for _ in range(N_halving):
            x_random = clip(rng.normal(loc=x_best_halving, scale=0.1, size=(dim,)))
            y_random = func(x_random)
            if y_random < y_best_halving:
                x_best_halving = x_random
                y_best_halving = y_random

        if y_best_halving < best_y:
            best_x = x_best_halving.copy()
            best_y = y_best_halving

    return best_x
