def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    sigma = 5.0
    lambda_ = 1
    mu = rng.uniform(lb, ub, (lambda_, dim))
    best_x = None
    best_f = float('inf')

    for _ in range(budget):
        f_values = func(mu)
        idx = np.argsort(f_values)[:lambda_]
        mu[idx] = mu[idx] + rng.normal(0, sigma, (lambda_, dim))

        for i in range(lambda_):
            if f_values[i] < best_f:
                best_x = mu[i]
                best_f = f_values[i]

        x = clip(x, lb, ub)
        if np.sum((x - best_x) ** 2) > sigma**2:
            sigma *= 0.5

    return best_x
