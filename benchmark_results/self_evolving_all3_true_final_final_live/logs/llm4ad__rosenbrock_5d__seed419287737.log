def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    init_sigma = 0.5 * (ub - lb) / dim
    x_best = lb + rng.uniform(size=dim) * (ub - lb)
    f_best = func(x_best)
    sigma = init_sigma
    adaptation_rate = 1 / (2 * budget)
    temperature = 100

    for i in range(budget):
        y = np.zeros(dim)
        for j in range(dim):
            y[j] = x_best[j] + rng.normal(0, sigma) * (ub - lb) / dim
        y = clip(y)

        delta = func(y) - f_best
        if delta < 0:
            f_best = func(y)
            x_best = y
            temperature *= 0.9999
            if temperature < 1:
                temperature = 1

        elif rng.uniform() < np.exp(-delta / temperature):
            f_best = func(y)
            x_best = y

        sigma = max(sigma - adaptation_rate, 1e-6)

    return x_best
