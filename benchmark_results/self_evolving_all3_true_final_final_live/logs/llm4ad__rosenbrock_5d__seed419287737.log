def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    step_size = 1.0
    best_x = x.copy()

    for _ in range(budget):
        angles = 2 * np.pi * rng.uniform(size=dim)
        d = step_size * np.stack([np.cos(angles), np.sin(angles)], axis=-1).T

        # Clip to bounds
        for i in range(dim):
            if x[i] + d[i, 0] < lb:
                d[i, 0] = (lb - x[i])
            elif x[i] + d[i, 0] > ub:
                d[i, 0] = (ub - x[i])

        # Clip to bounds
        for i in range(dim):
            if x[i] + d[i, 1] < lb:
                d[i, 1] = (lb - x[i])
            elif x[i] + d[i, 1] > ub:
                d[i, 1] = (ub - x[i])

        # Project d onto steepest descent direction
        grad = np.array([func(np.concatenate((x[:i], [x[i] + epsilon if i != j else x[j] for j in range(dim)], x[i+1:]))) - func(x) for i, epsilon in enumerate(rng.uniform(size=dim))])
        d_proj = np.dot(grad / (grad**2).sum(), d)

        # Step update
        x += d_proj * step_size

        if func(x) < func(best_x):
            best_x = x.copy()

        step_size *= 0.99  # Decrease step size

    return best_x
