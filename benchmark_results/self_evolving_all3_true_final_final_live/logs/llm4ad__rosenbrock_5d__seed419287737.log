def algorithm(func, dim, lb, ub, budget, rng):
    def clipped(x):
        return np.minimum(np.maximum(x, lb), ub)

    def objective(x):
        return func(clipped(x))

    x_best = rng.uniform(lb, ub, size=dim)
    population = [clipped(rng.uniform(lb, ub, size=dim)) for _ in range(10*dim)]
    best = min([objective(x) for x in population], key=objective)

    for t in range(budget):
        d = rng.normal(size=dim)
        mutated = np.array(population[np.random.choice(len(population), p=[0.1, 0.9]*len(population))]) + 0.5*d
        mutated = clipped(mutated)
        population.append(mutated)

        if objective(mutated) < best:
            best = objective(mutated)
            x_best = mutated

        population = [x for x in population if objective(x) <= best*1.2]

    return x_best
