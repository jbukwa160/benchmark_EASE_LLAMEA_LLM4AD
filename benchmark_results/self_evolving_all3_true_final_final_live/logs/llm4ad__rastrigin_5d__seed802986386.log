def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    N = 50  # population size
    F = 0.5  # scaling factor
    CR = 0.9  # crossover probability
    x_best = None
    f_best = np.inf

    for _ in range(budget):
        X = rng.uniform(lb, ub, (N, D))
        for i in range(N):
            if func(X[i]) < f_best:
                f_best = func(X[i])
                x_best = X[i]
        
        G1_idx = np.random.choice(N, 2, replace=False)
        G2_idx = np.random.choice(N, 2, replace=False)
        while G1_idx[0] == G2_idx[0]:
            G2_idx = np.random.choice(N, 2, replace=False)

        D1 = X[G1_idx[0]] - X[G1_idx[1]]
        D2 = X[G2_idx[0]] - X[G2_idx[1]]

        for i in range(N):
            if rng.rand() < CR or i == G1_idx[0]:
                u = np.random.choice(G1_idx)
                v = np.random.choice(G2_idx)
                while (u == i) or (v == i) or (np.linalg.norm(D1[u] - D2[v]) < 1e-6):
                    u = np.random.choice(G1_idx)
                    v = np.random.choice(G2_idx)

                X_new = X[i] + F * (D1[u] + D2[v])

            else:
                X_new = X[i]

            for j in range(D):
                if rng.rand() < 0.5:
                    X_new[j] = lb + (X_new[j] - lb) / (ub - lb) * (ub - lb)
                else:
                    X_new[j] = ub - (ub - X_new[j]) / (ub - lb) * (ub - lb)

            X[i] = np.clip(X_new, lb, ub)

    return x_best
