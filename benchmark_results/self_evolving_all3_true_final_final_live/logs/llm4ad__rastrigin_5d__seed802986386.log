def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    x = np.array([random.uniform(lb, ub) for _ in range(dim)])
    T = 1000.0
    sigma = 2 * (ub - lb) / dim

    for i in range(budget):
        y = x + rng.normal(0, sigma, size=dim)
        y = clip(y)

        f_x = func(x)
        f_y = func(y)

        if f_y < f_x:
            x = y
        elif rng.random() < np.exp((f_x - f_y) / T):
            x = y

        T *= 0.9995

    return x
