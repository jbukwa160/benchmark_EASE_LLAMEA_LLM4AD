def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    x_best = np.random.uniform(low=lb, high=ub, size=(dim,))
    f_best = func(x_best)
    
    T_initial = 1000.0
    cooling_rate = 0.99
    
    for _ in range(budget):
        x_new = clip(rng.normal(loc=x_best, scale=1e-3, size=(dim,)))
        
        if rng.rand() < 0.2:
            # Simulated Annealing
            T = max(T_initial * cooling_rate ** _, 1e-10)
            delta_f = func(x_new) - f_best
            
            if delta_f < 0 or np.exp(-delta_f / T) > rng.rand():
                x_best, f_best = x_new, func(x_new)

        else:
            # Differential Evolution
            x_mutant = x_best + rng.uniform(low=-1, high=1, size=(dim,))
            x_cross = (x_mutant + x_best) / 2
            
            if np.any(np.isnan(x_cross)):
                continue
                
            delta_f = func(clip(x_cross)) - f_best
            
            if delta_f < 0:
                x_best, f_best = x_cross, func(clip(x_cross))

    return x_best
