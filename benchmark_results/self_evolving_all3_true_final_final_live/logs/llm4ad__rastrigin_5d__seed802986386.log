def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(mean, sigma, dimension):
        return mean + sigma * rng.normal(size=dimension)

    def clip_candidate(candidate, lower_bound, upper_bound):
        clipped = np.clip(candidate, lower_bound, upper_bound)
        return np.where(clipped < lower_bound, lower_bound, np.where(clipped > upper_bound, upper_bound, clipped))

    def evaluate_fitness(candidate):
        return func(candidate)

    def update_distribution(best_candidate, mean, sigma, covariance_matrix):
        delta = best_candidate - mean
        covariance_matrix += 1 / (len(mean) + 2) * np.outer(delta, delta)
        sigma = np.sqrt(np.dot(np.dot(delta.T, covariance_matrix), delta))
        return mean + delta / len(mean), sigma, covariance_matrix

    mean = rng.uniform(low=lb, high=ub, size=(dim,))
    sigma = 1
    covariance_matrix = np.eye(dim)

    for _ in range(budget):
        candidate = generate_candidate(mean, sigma, dim)
        clipped_candidate = clip_candidate(candidate, lb, ub)
        fitness = evaluate_fitness(clipped_candidate)
        
        if fitness < evaluate_fitness(mean):
            mean, sigma, covariance_matrix = update_distribution(clipped_candidate, mean, sigma, covariance_matrix)

    return mean
