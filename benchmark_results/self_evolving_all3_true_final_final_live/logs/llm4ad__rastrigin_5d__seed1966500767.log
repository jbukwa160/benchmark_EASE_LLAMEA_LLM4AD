def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)
    
    D = dim
    ngen = budget
    
    mu = 1.0 / (D + 2)
    sigma_init = (ub - lb) * 0.5
    x_mean = np.zeros(D)
    x_best = np.zeros(D)
    f_best = 1e+9
    cov = np.eye(D)
    
    for gen in range(ngen):
        # Sample the population from a normal distribution centered at the current mean with covariance matrix adapted using CMA-ES.
        sigma = (ub - lb) * mu**gen
        x = rng.randn(D) * sigma + x_mean
        
        # Clip candidates to [lb, ub].
        np.clip(x, lb, ub, out=x)
        
        # Evaluate the objective function for each candidate.
        f_values = f(x)
        
        # Store the best individual seen so far and its fitness value.
        if any(f_values < f_best):
            i_best = np.argmin(f_values)
            x_best[:] = x[i_best]
            f_best = f_values[i_best]
    
    return x_best
