def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(size, dim):
        population = np.zeros((size, dim))
        for i in range(size):
            population[i] = (ub - lb) * rng.random(dim) + lb
        return population

    def crossover(population, offspring_indices):
        children = np.copy(population[offspring_indices])
        for i in range(len(offspring_indices)):
            idx1, idx2 = offspring_indices[i]
            children[i] += 0.5 * (population[idx1] - population[idx2]) + rng.normal(0, 0.01)
            children[i] = clip(children[i])
        return children

    def mutation(population, children):
        for i in range(len(population)):
            idx = rng.randint(len(children))
            population[i] += 0.5 * (children[idx] - population[i]) + rng.normal(0, 0.01)
            population[i] = clip(population[i])
        return population

    def selection(population):
        fitnesses = func(population)
        idx_best = np.argmin(fitnesses)
        if fitnesses[idx_best] < func(np.zeros(dim)):
            return population[idx_best]
        else:
            return np.zeros(dim)

    population = generate_initial_population(budget, dim)
    for _ in range(1, budget):
        offspring_indices = rng.choice(len(population), size=len(population), replace=False)
        children = crossover(population, offspring_indices)
        mutation(population, children)
    return selection(population)
