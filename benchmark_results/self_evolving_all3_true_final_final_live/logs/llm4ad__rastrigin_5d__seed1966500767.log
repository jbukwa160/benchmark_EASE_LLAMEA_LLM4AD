def algorithm(func, dim, lb, ub, budget, rng):
    def wrapper(x):
        return func(x)

    bounds = [(lb, ub) for _ in range(dim)]
    res = differential_evolution(wrapper, bounds=bounds)
    x_best = res.x
    f_best = func(x_best)

    for i in range(budget - 1):
        step_size = rng.uniform(0.01, 1)
        x_new = x_best + np.random.normal(size=dim) * step_size
        x_new = np.clip(x_new, lb, ub)
        f_new = wrapper(x_new)

        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
