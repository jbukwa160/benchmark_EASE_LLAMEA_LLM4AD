def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    
    for _ in range(budget):
        new_x = x.copy() + 0.01 * rng.randn(dim)
        new_x = np.clip(new_x, lb, ub)
        
        if func(new_x) < func(best_x):
            best_x = new_x
        
        new_x = best_x + 0.1 * rng.randn(dim)
        new_x = np.clip(new_x, lb, ub)
        
        if func(new_x) < func(best_x):
            x = new_x
    
    return best_x
