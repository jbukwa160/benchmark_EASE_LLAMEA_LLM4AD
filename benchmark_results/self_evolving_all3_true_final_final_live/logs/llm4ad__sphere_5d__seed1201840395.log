def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    x = rng.uniform(ub - 1e-3, ub, size=n)
    y = rng.uniform(lb - 1e-3, lb, size=n)
    
    for _ in range(budget):
        simplex = np.vstack([x, y])
        
        f_x = func(simplex)
        idx = np.argsort(f_x)[0]
        
        x[idx] += 1
        x[idx % n] -= 1
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
    
    return x[0]
