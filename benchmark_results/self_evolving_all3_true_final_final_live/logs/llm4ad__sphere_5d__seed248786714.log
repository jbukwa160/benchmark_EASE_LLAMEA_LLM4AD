def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    for _ in range(budget):
        f_x = func(x)
        grad = 2 * (x - np.square(x))
        step_size = 0.1
        new_x = x - step_size * grad
        new_x = np.clip(new_x, lb, ub)
        if func(new_x) < f_x:
            x = new_x
    return x
