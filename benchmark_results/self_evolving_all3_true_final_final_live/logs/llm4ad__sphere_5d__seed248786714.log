def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    population_size = 100
    population = rng.uniform(lb, ub, (population_size, dim))
    best_candidate = None

    for _ in range(budget):
        offspring = np.zeros((population_size, dim))
        
        for i in range(population_size):
            idx1, idx2, idx3 = rng.choice(population_size, 3, replace=False)
            mutation_vector = (ub - lb) * rng.uniform(-1.0, 1.0, dim)
            
            if rng.rand() < 0.9:
                offspring[i] = clip(population[idx1] + mutation_vector)
            else:
                offspring[i] = population[idx3]
        
        distances = np.linalg.norm(offspring[:, None] - population[None], axis=2)
        idxs, _ = np.unravel_index(np.argsort(distances, axis=None), (population_size, population_size))
        idxs = idxs[:population_size]

        best_offspring_idx = np.argmax([func(clip(offspring[i])) for i in range(population_size)])
        
        if func(clip(offspring[best_offspring_idx])) < func(clip(best_candidate)) or best_candidate is None:
            population[idxs] = offspring
            best_candidate = offspring[best_offspring_idx]
    
    return clip(best_candidate)
