def algorithm(func, dim, lb, ub, budget, rng):
    x0 = np.random.uniform(lb, ub, size=dim)
    def objective(x):
        return func(x)
    
    res = minimize(objective, x0, method="SLSQP", bounds=[(lb, ub)]*dim, options={"maxiter": budget})
    return res.x
