def algorithm(func, dim, lb, ub, budget, rng):
    def rand(lb, ub):
        return rng.uniform(lb, ub)

    x = np.array([lb + (ub - lb) * rand(0, 1) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(budget):
        candidates = []
        
        for j in range(dim):
            mu1 = rng.choice(dim, size=4, replace=False)
            mu2 = [x[j] + 0.01 * (ub - lb) * np.sign(rng.uniform(-1, 1)) if k != j else x[k] 
                   for k in mu1]
            
            candidate = x.copy()
            candidate[mu1[0]] = mu2[0]
            candidates.append(candidate)
        
        candidates = np.array(candidates)
        candidates[np.any((candidates < lb) | (candidates > ub), axis=1)] = 0
        
        f_values = func(candidates)
        idx = np.argmin(f_values)
        
        if f_values[idx] < best_f:
            x = candidates[idx].copy()
            best_x = x.copy()
            best_f = f_values[idx]
    
    return best_x
