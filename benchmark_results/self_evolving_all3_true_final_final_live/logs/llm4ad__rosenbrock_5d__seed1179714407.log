def algorithm(func, dim, lb, ub, budget, rng):
    mu = 0.5 * (ub - lb)
    sigma = max(np.abs(ub), np.abs(lb))
    n_evals = 0
    best_x = None
    best_f = np.inf

    for _ in range(budget):
        z = rng.randn(dim) + 1
        x = mu * z / np.linalg.norm(z)
        f = func(x)

        if np.any(np.isnan(x)):
            continue
        
        n_evals += 1

        if f < best_f:
            best_x = x.copy()
            best_f = f

        if n_evals >= budget - 100 or _ == budget - 1:
            break

        # Clip candidates to [lb, ub]
        for i in range(dim):
            x[i] = np.clip(x[i], lb[i], ub[i])

        sigma *= max(np.linalg.norm(z) / mu, 0.001)
        if n_evals % 100 == 0:
            print(f"n_evals: {n_evals}, best_f: {best_f}")

    return best_x
