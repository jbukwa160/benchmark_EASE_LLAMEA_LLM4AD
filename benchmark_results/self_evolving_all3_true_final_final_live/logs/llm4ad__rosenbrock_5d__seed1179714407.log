def algorithm(func, dim, lb, ub, budget, rng):
    T = 1e3  # initial temperature
    alpha = 0.99  # cooling rate
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_new = x_best + rng.normal(size=dim) * 0.1
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)

        delta_f = f_new - f_best

        if delta_f < 0:
            x_best = x_new
            f_best = f_new
        else:
            prob = np.exp(-delta_f / T)
            if rng.random() < prob:
                x_best = x_new
                f_best = f_new

        T *= alpha

    return x_best
