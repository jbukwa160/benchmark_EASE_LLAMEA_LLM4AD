def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(mean, sigma):
        return mean + sigma * rng.randn(dim)

    best = lb + (ub - lb) * rng.rand(dim)
    current_best = func(best)
    for _ in range(budget):
        candidate = generate_candidate(best, 1.0)
        clipped_candidate = np.clip(candidate, lb, ub)
        candidate_fitness = func(clipped_candidate)
        
        if candidate_fitness < current_best:
            best = clipped_candidate
            current_best = candidate_fitness

        elif rng.rand() < np.exp((current_best - candidate_fitness) / (budget - _)):
            best = clipped_candidate
            current_best = candidate_fitness

    return best
