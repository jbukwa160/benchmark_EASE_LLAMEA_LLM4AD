def algorithm(func, dim, lb, ub, budget, rng):
    def wrap_bounds(x):
        return np.clip(x, a_min=lb, a_max=ub)

    pop_size = 50
    x_best = rng.uniform(lb, ub, size=(pop_size, dim))
    v_best = rng.uniform(-1, 1, size=(pop_size, dim))

    for _ in range(budget):
        fitness = func(x_best)
        f_best = np.min(fitness)

        for i in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size-1, size=3)
            while r1 == i or r2 == i or r3 == i:
                r1, r2, r3 = rng.randint(0, pop_size-1, size=3)

            v_i = 0.5 * (v_best[r1] + v_best[r2]) + constants.pi * rng.uniform(-1, 1, size=dim)
            x_new = wrap_bounds(x_best[i] + v_i)

            f_new = func(x_new)
            if f_new < f_best:
                x_best[i] = x_new
                v_best[i] = v_i

        best_idx = np.argmin(func(x_best))
        x_best[best_idx] = wrap_bounds(x_best[best_idx] + 0.1 * rng.uniform(-1, 1, size=dim))

    return x_best[np.argmin(func(x_best))]
