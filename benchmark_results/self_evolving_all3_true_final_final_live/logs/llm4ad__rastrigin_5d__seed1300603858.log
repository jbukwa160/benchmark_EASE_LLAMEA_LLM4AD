def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    D = len(dim)
    X_best = 0.5 * (ub + lb) * rng.rand(D) + lb
    f_best = func(X_best)

    for _ in range(budget):
        X1 = X_best + rng.uniform(-1, 1) * 0.01 * np.ones(D)
        X2 = clip(X1 + rng.normal(size=D))
        X3 = clip(X2 + rng.normal(size=D))

        a = rng.uniform(0, 1)
        f_X2 = func(X2)
        f_X3 = func(X3)

        if a < 0.5 and f_X2 < f_best:
            X_best = X2
            f_best = f_X2

        elif a >= 0.5 and f_X3 < f_best:
            X_best = X3
            f_best = f_X3

    return clip(X_best)
