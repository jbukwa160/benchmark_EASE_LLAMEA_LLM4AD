def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = 50
    pop = rng.uniform(lb, ub, (pop_size, dim))
    best = None

    for _ in range(budget):
        fit_pop = func(clip(pop))
        if best is None or np.min(fit_pop) < np.min([best[1], np.mean(fit_pop)]):
            best = np.array([np.argmin(fit_pop), np.min(fit_pop)])
        
        diffs = pop - best[0]
        for i in range(pop_size):
            trial = clip(pop[i] + rng.uniform(-1, 1, dim) * diffs[i])
            fit_trial = func(trial)
            if fit_trial < best[1]:
                pop[i] = trial
                best = np.array([i, fit_trial])

    return best[0]
