def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, (dim,))
    best_x = x.copy()
    best_fval = func(x)
    mem_size = 10
    mem = [{'fval': best_fval, 'x': best_x}] * mem_size

    for _ in range(budget):
        g = np.zeros((dim,))
        for i in range(mem_size - 1, 0, -1):
            dx = mem[i]['x'] - mem[i-1]['x']
            df = func(mem[i]['x']) - mem[i-1]['fval']
            rho = np.dot(dx, g) / np.dot(dx, dx)
            g -= rho * dx
            mem[i]['g'] = g.copy()
        H_inv = np.eye(dim)
        z = -g

        for _ in range(mem_size):
            s = mem[(_ + 1) % mem_size]['x'] - mem[_ % mem_size]['x']
            y = func(mem[(_ + 1) % mem_size]['x']) - mem[_ % mem_size]['fval']

            if np.dot(s, z) > 0:
                alpha = np.dot(np.dot(y, H_inv), s)
                rho = np.dot(y, z)

                if rho != 0 and alpha < 0:
                    H_inv -= (np.outer(alpha / rho * y, y) + np.outer(1 - alpha / rho, s)) / (mem_size - 1)
                mem[_ % mem_size]['g'] = g.copy()

        x += z
        x = clip_candidate(x, lb, ub)

        new_fval = func(x)
        if new_fval < best_fval:
            best_x = x.copy()
            best_fval = new_fval

    return best_x
