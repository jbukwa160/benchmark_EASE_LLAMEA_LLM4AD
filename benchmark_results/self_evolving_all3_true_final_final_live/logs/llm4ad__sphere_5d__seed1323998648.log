def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([ub] * dim)
    best_x = x.copy()
    best_f = func(x)

    step_size = (ub - lb) / 2.0
    temperature = budget * 10
    cooling_rate = 1 / np.sqrt(budget)

    for i in range(1, int(budget)):
        for j in range(dim):
            x[j] += rng.randn() * step_size

        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)

        f = func(x)
        
        if f < best_f:
            best_x = x.copy()
            best_f = f
        
        temperature *= 1 - cooling_rate
        step_size *= 0.99

    return best_x
