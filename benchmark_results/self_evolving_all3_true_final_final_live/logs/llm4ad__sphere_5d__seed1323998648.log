def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(size, dim):
        return (ub - lb) * rng.rand(size, dim) + lb

    def clip_to_bounds(x, lb, ub):
        return np.clip(x, lb, ub)

    def ensemble_diversity(gradients):
        cov = np.cov(gradients, rowvar=False)
        eigenvalues = np.linalg.eigvals(cov)
        return np.mean(eigenvalues)

    def adaptive_learning_rate(ensemble_diversity):
        if ensemble_diversity < 1e-6:
            return 0.01
        else:
            return 0.1 / (ensemble_diversity + 1e-8)

    population_size = 100
    initial_population = generate_initial_population(population_size, dim)
    
    for i in range(budget):
        # Evaluate fitness of each candidate
        fitnesses = [func(x) for x in initial_population]
        
        # Select best candidate (with lowest fitness)
        best_candidate = np.array([x for _, x in zip(fitnesses, initial_population)])
        best_fitness = min(fitnesses)
        
        if best_fitness < 1e-8:
            return clip_to_bounds(best_candidate[0], lb, ub)

        # Evaluate gradients of each candidate
        gradients = [np.gradient(func(x), axis=axis) for x in initial_population for axis in range(dim)]
        
        # Calculate ensemble diversity of gradients
        ensemble_diversity_value = ensemble_diversity(np.array(gradients).reshape(population_size, -1))
        
        # Update learning rate based on ensemble diversity
        learning_rate = adaptive_learning_rate(ensemble_diversity_value)
        
        # Perform gradient descent update for each candidate
        updated_population = initial_population + learning_rate * np.array(gradients).reshape(population_size, dim)
        
        # Clip candidates to bounds
        updated_population = clip_to_bounds(updated_population, lb, ub)
        
        # Replace worst candidates with new random ones
        worst_indices = np.argsort(fitnesses)[-population_size//5:]
        initial_population[worst_indices] = generate_initial_population(population_size//5, dim)

    return clip_to_bounds(best_candidate[0], lb, ub)
