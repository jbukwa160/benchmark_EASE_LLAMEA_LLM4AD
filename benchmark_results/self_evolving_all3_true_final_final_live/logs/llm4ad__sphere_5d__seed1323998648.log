def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_solution = None
    best_value = float('inf')
    cma_history = []

    for i in range(budget):
        if best_solution is not None and i > 10 and len(cma_history) == 1:
            new_best_solution = clip(best_solution)
            new_best_value = func(new_best_solution)

            if new_best_value < best_value:
                best_solution = new_best_solution
                best_value = new_best_value

        if len(cma_history) >= 2 and i > 10:
            if rng.random() < 0.1:
                cma_history.pop()

        if len(cma_history) == 0 or rng.random() < 0.01:
            # reinitialize
            solution = np.array([rng.uniform(lb, ub) for _ in range(dim)])
        else:
            # use CMA-ES
            mean = clip(np.mean(np.array(cma_history), axis=0))
            cov = np.cov(np.array(cma_history).T)
            new_solution = np.random.multivariate_normal(mean, cov, 1)[0]
            solution = clip(new_solution)

        value = func(solution)
        cma_history.append(solution)

        if value < best_value:
            best_solution = solution
            best_value = value

    return best_solution
