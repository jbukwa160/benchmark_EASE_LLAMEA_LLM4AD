def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    for i in range(budget):
        y = x + 0.1 * rng.randn(dim)
        y = np.clip(y, lb, ub)
        if func(y) < func(best_x):
            best_x = y
        x = (ub - lb) * rng.rand(dim) + lb
    return best_x
