def algorithm(func, dim, lb, ub, budget, rng):
    best = np.inf * np.ones(dim)
    best_x = None
    
    for _ in range(budget):
        x = np.clip(rng.uniform(lb, ub, size=dim), a_min=lb, a_max=ub)
        
        f_x = func(x)
        
        if f_x < best:
            best = f_x
            best_x = x
        
        step_size = 0.1 * (ub - lb)
        direction = np.sign(rng.uniform(-1, 1, size=dim))
        step = step_size * direction
        
        new_x = x + step
        
        new_x = np.clip(new_x, a_min=lb, a_max=ub)
        
        f_new_x = func(new_x)
        
        if f_new_x < best:
            best = f_new_x
            best_x = new_x
    
    return best_x
