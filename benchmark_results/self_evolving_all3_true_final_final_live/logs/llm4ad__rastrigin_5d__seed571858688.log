def algorithm(func, dim, lb, ub, budget, rng):
    n_particles = 50
    w = 0.7
    c1 = 2.05
    c2 = 2.05
    best_pos = None
    best_val = float('inf')

    for _ in range(budget):
        pos = np.random.uniform(lb, ub, (n_particles, dim))
        vel = np.zeros((n_particles, dim))

        for i in range(n_particles):
            if func(pos[i]) < best_val:
                best_pos = pos[i]
                best_val = func(pos[i])

        for i in range(n_particles):
            r1 = rng.uniform(0, 1)
            r2 = rng.uniform(0, 1)
            vel[i] += w * (pos[i] - best_pos) + c1 * r1 * (best_pos - pos[i]) + c2 * r2 * (best_pos - pos[i])
            pos[i] += vel[i]

        for i in range(n_particles):
            pos[i] = np.clip(pos[i], lb, ub)

    return best_pos
