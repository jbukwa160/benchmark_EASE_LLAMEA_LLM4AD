def algorithm(func, dim, lb, ub, budget, rng):
    def sample(lb, ub, rng):
        return rng.uniform(lb, ub)

    def sample_best(x_best, num_samples, rng, lb, ub):
        candidates = np.stack([sample(lb, ub, rng) for _ in range(num_samples)], axis=0)
        scores = func(candidates)
        best_candidate = candidates[np.argmax(scores)]
        return best_candidate

    x_best = 0.5 * (lb + ub) + rng.uniform(-0.5, 0.5, size=dim)

    for _ in range(budget):
        num_samples = max(1, int(np.sqrt(dim)))
        candidate = sample_best(x_best, num_samples, rng, lb, ub)
        score_candidate = func(candidate)
        score_x_best = func(x_best)

        if score_candidate < score_x_best:
            x_best = candidate

    return x_best
