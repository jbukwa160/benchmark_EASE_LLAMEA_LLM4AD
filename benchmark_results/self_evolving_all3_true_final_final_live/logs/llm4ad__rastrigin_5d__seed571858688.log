def algorithm(func, dim, lb, ub, budget, rng):
    D = len(dim)
    n_init_samples = 100
    sigma_init = 2.0 * (ub - lb) / D
    best_solution = None
    best_fitness = np.inf
    
    # Initial sampling
    for _ in range(n_init_samples):
        x_new = lb + rng.uniform(size=D) * (ub - lb)
        f_new = func(x_new)
        
        if f_new < best_fitness:
            best_solution = x_new
            best_fitness = f_new
    
    acquisition_func = 'ucb'
    
    # Bayesian optimization loop
    for _ in range(budget):
        n_samples = 10
        
        # Sample new candidates using the current posterior distribution
        x_new = []
        for _ in range(n_samples):
            if acquisition_func == 'ucb':
                mu, sigma = predict_posterior(best_solution, rng)
                x_new_candidate = sample_gaussian(mu, sigma, lb, ub)
                x_new.append(x_new_candidate)
            elif acquisition_func == 'ei':
                mu, sigma = predict_posterior(best_solution, rng)
                x_new_candidate = sample_entropy_best(lb, ub, mu, sigma, rng)
                x_new.append(x_new_candidate)
        
        # Evaluate new candidates
        fitnesses = [func(x) for x in x_new]
        
        # Update the current best solution and posterior distribution
        idx_best = np.argmin(fitnesses)
        if fitnesses[idx_best] < best_fitness:
            best_solution = x_new[idx_best]
            best_fitness = fitnesses[idx_best]
    
    return best_solution
