def algorithm(func, dim, lb, ub, budget, rng):
    def bounds(x):
        return np.clip(x, lb, ub)

    x_best = np.zeros(dim)
    f_best = float('inf')
    for _ in range(budget):
        x = bounds(rng.normal(size=dim))
        f_x = func(x)
        if f_x < f_best:
            f_best = f_x
            x_best = x
        sigma = 1.0 / np.sqrt(2 * dim) + 1e-6
        x_mut = bounds(x_best + rng.normal(size=dim, scale=sigma))
        f_x_mut = func(x_mut)
        if f_x_mut < f_best:
            x_best = x_mut
            f_best = f_x_mut
    return x_best
