def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for _ in range(budget):
        x = np.random.uniform(lb, ub, size=dim)
        f = func(x)

        if f < best_f:
            best_f = f
            best_x = x

        dx = -np.dot(rng.rand(dim), rng.randn(dim))
        for i in range(1000):
            x_try = best_x + 0.1 * dx
            x_try = np.clip(x_try, lb, ub)
            f_try = func(x_try)

            if f_try < best_f:
                best_f = f_try
                best_x = x_try

                # gradient-based update
                grad = -2 * 100 * (x_try[1:] - best_x[:-1]**2) * (2 * best_x[1:-1] - x_try[:-2])
                dx = -np.dot(rng.rand(dim), rng.randn(dim)) + 0.01 * np.sign(grad)

    return best_x
