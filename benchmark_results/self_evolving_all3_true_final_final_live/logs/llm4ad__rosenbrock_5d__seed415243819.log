def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    x_best = np.random.uniform(lb, ub, size=dim)
    y_best = f(x_best)

    for i in range(budget):
        x_candidate = x_best + rng.normal(size=dim) / 1.0
        x_candidate = np.clip(x_candidate, lb, ub)
        
        f_value = f(x_candidate)
        
        if f_value < y_best:
            y_best = f_value
            x_best = x_candidate
            
        # Local refinement using Pattern Search (PS)-like procedure
        for j in range(dim):
            x_left = np.copy(x_best)
            x_right = np.copy(x_best)
            
            x_left[j] += 0.01 * rng.normal(size=dim) / 1.0
            x_left[j] = np.clip(x_left[j], lb, ub)
            
            x_right[j] -= 0.01 * rng.normal(size=dim) / 1.0
            x_right[j] = np.clip(x_right[j], lb, ub)
            
            f_left = f(x_left)
            f_right = f(x_right)
            
            if f_left < y_best:
                x_best = x_left
                y_best = f_left
                
            if f_right < y_best:
                x_best = x_right
                y_best = f_right
                
    return x_best
