def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(solution, rng):
        noise = rng.randn(dim) * 0.1
        return solution + noise

    def accept(current_solution, new_solution, T):
        if func(new_solution) < func(current_solution):
            return new_solution
        else:
            probability = np.exp(-(func(new_solution) - func(current_solution)) / T)
            return new_solution if rng.random() < probability else current_solution

    solution = lb + (ub - lb) * rng.rand(dim)
    best_solution = solution.copy()
    temperature = 1.0
    cooling_rate = 0.99
    for _ in range(budget):
        candidate = generate_candidate(solution, rng)
        clipped_candidate = np.clip(candidate, lb, ub)
        new_solution = accept(best_solution, clipped_candidate, temperature)
        best_solution = new_solution if func(new_solution) < func(best_solution) else best_solution
        solution = new_solution.copy()
        temperature *= cooling_rate
    return best_solution
