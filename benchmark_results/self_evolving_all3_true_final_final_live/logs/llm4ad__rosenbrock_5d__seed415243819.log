def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    def simplex_step(x0, x1, f1, step_size):
        # Nelder-Mead Simplex update rule
        x2 = 2 * x1 - x0 + step_size * (np.random.rand(dim) - 0.5)
        return bound(x2), func(bound(x2))

    def de_step(population, best):
        # Differential Evolution update rule
        for i in range(len(population)):
            parent_idx = np.random.choice([j for j in range(len(population)) if j != i])
            child = population[parent_idx] + 0.5 * (population[i] - population[np.random.choice([k for k in range(len(population)) if k != i and k != parent_idx])])
            child = bound(child)
            if func(bound(child)) < best[1]:
                best = (child, func(bound(child)))
        return best

    # Initial guess
    initial_guess = np.random.rand(dim) * (ub - lb) + lb

    population = [initial_guess]
    best = (bound(initial_guess), func(bound(initial_guess)))

    step_size = 1.0

    for _ in range(budget):
        new_population = []
        for x in population:
            f, _ = de_step([x] + new_population, best)
            new_population.append(f)
        
        # Simplex step to refine the current best solution
        if len(new_population) > 1:
            simplex_best_idx = np.argmax(new_population[1:])
            new_population = [best[0]] + new_population[:simplex_best_idx+1] + new_population[simplex_best_idx+1:]
        
        for x, f in zip(population, new_population):
            if func(bound(x)) < best[1]:
                best = (bound(x), func(bound(x)))
        
        population = bound(np.array(population) + step_size * np.random.rand(len(population), dim))
        step_size *= 0.9

    return best[0]
