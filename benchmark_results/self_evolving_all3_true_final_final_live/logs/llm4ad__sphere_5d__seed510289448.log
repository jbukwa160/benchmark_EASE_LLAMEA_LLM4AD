def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(budget, dim))
    for i in range(1, budget):
        z = x[i-1] + 0.5 * (rng.rand(dim) - 0.5)
        u = np.copy(x[i-1])
        v = np.copy(x[(i-1) % budget])
        for j in range(dim):
            s = rng.rand()
            if s < 0.2:
                z[j] += 0.5 * (u[j] - x[i-1, j])
            elif s < 0.4:
                z[j] += 0.3 * (v[j] - x[(i-1) % budget, j])
            else:
                z[j] += rng.uniform(-ub + lb, ub - lb)
        x[i] = np.clip(z, lb, ub)
    f_x = func(x)
    idx = np.argmin(f_x)
    return np.copy(x[idx])
