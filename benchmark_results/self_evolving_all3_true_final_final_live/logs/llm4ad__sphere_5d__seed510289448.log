        x_new = x_best + step_size * (ub - lb) * (2 * rng.rand(dim) - 1)
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
        else:
            step_size /= 2.0
    return x_best
