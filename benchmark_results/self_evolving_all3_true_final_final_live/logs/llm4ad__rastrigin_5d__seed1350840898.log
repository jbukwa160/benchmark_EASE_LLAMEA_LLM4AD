def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def evaluate(x):
        return func(x)

    x_best = np.zeros(dim)
    f_best = float('inf')
    N_pop = 50
    for _ in range(budget):
        population = rng.uniform(lb, ub, size=(N_pop, dim))
        for i in range(N_pop):
            x_i = clip(population[i], lb, ub)
            fi = evaluate(x_i)
            if fi < f_best:
                f_best = fi
                x_best = x_i.copy()
        mutation_rate = 0.5 * (1 - np.exp(-_ / budget))
        for i in range(N_pop):
            r1, r2, r3 = rng.choice(N_pop, size=3, replace=False)
            x_i = clip(population[i] + mutation_rate * (
                population[r1] - 2 * population[r2] + population[r3]),
                       lb, ub)
            fi = evaluate(x_i)
            if fi < f_best:
                f_best = fi
                x_best = x_i.copy()
    return x_best
