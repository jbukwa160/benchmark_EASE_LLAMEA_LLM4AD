def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def objective(x):
        return func(x)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = objective(clip(x_best))

    for _ in range(budget):
        pop_size = int(np.sqrt(budget))
        pop = np.random.uniform(lb, ub, size=(pop_size, dim))

        for i in range(pop_size):
            y = clip(pop[i] + rng.normal(size=dim) * 0.1)
            f = objective(y)

            if f < f_best:
                x_best = y
                f_best = f

        pop = np.vstack((x_best[None, :], pop))
        sigma = (ub - lb) / dim

        for i in range(pop_size):
            while True:
                idx = rng.choice(pop_size, size=3, replace=False)
                v = pop[idx] + np.random.normal(size=dim, loc=0, scale=sigma)

                if objective(clip(v)) < f_best:
                    pop[i] = clip(v)
                    break

        x_best = pop[np.argmin([objective(clip(x)) for x in pop])]

    return x_best
