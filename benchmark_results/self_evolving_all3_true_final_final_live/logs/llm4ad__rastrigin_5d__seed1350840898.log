def algorithm(func, dim, lb, ub, budget, rng):
    T = 10.0  # initial temperature
    t = 1e-3  # cooling rate
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    for _ in range(budget):
        x_candidate = rng.uniform(lb, ub, size=dim)
        
        f_candidate = func(x_candidate)
        
        if f_candidate < f_best:
            f_best = f_candidate
            x_best = x_candidate
        
        delta_f = f_candidate - f_best
        
        if delta_f < 0 or np.random.rand() < np.exp(-delta_f / T):
            x_best = x_candidate
            f_best = f_candidate
        
        T *= (1 - t)
        
    return x_best
