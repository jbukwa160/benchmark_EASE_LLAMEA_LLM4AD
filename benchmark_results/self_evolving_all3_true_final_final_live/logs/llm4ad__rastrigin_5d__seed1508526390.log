def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    mutation_rate = 0.01
    elite_count = int(pop_size * 0.2)

    def get_initial_population():
        return rng.uniform(lb, ub, (pop_size, dim))

    def evaluate(candidates):
        values = np.array([func(candidate) for candidate in candidates])
        return candidates, values

    def differential_mutation(parent1, parent2, offspring_index):
        diff = parent1 - parent2
        mutated_diff = rng.normal(0, 1, size=dim) * mutation_rate + diff
        child = parent1 + mutated_diff
        return np.clip(child, lb, ub)

    def selection(population, values):
        idxs = np.argsort(values)[:elite_count]
        elite_population = population[idxs]
        remaining_candidates = pop_size - elite_count
        offspring = []
        for _ in range(remaining_candidates):
            parent1_idx, parent2_idx = rng.choice(elite_count, 2, replace=False)
            parent1, parent2 = elite_population[parent1_idx], elite_population[parent2_idx]
            offspring.append(differential_mutation(parent1, parent2, len(offspring)))
        return np.concatenate((elite_population, np.array(offspring)))

    population = get_initial_population()
    for _ in range(budget):
        population, values = evaluate(population)
        best_candidate = population[np.argmin(values)]
        new_population = selection(population, values)

    return best_candidate
