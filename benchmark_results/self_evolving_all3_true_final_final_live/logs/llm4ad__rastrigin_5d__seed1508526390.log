def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_f = np.inf
    
    for _ in range(budget):
        x = (ub - lb) * rng.rand(dim) + lb
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
            
        direction = 0.1 * (ub - lb) * rng.randn(dim)
        
        improved = True
        
        while improved and np.any(direction != 0):
            new_x = x + direction
            new_x = np.clip(new_x, lb, ub)
            
            new_f = func(new_x)
            
            if new_f < f:
                improved = False
                
                # Update best solution
                if new_f < best_f:
                    best_f = new_f
                    best_x = new_x
                    
                # Update direction
                for i in range(dim):
                    if direction[i] != 0 and (new_f - f) / abs(direction[i]) > 1e-3:
                        direction[i] *= -1
            else:
                improved = False
                
    return best_x
