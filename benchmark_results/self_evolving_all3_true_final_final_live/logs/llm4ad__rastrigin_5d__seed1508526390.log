def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def generate_initial_population(n, dim, lb, ub):
        return rng.uniform(lb, ub, (n, dim))

    def calculate_fitness(individual, func, *args):
        return func(individual, *args)

    def select_parents(population, fitness_values, n):
        indices = np.argsort(fitness_values)[:n]
        return population[indices], fitness_values[indices]

    def crossover(parent1, parent2, rng):
        child = parent1.copy()
        for i in range(len(child)):
            if rng.uniform() < 0.5:
                child[i] += (parent2[i] - parent1[i]) * rng.uniform(-1, 1)
        return child

    def mutation(individual, rng):
        for i in range(len(individual)):
            individual[i] += rng.uniform(-1, 1) * rng.uniform(0.01, 0.1)
        return clip(individual, lb, ub)

    population = generate_initial_population(budget, dim, lb, ub)
    fitness_values = np.array([calculate_fitness(individual, func) for individual in population])

    for _ in range(budget - 1):
        population, fitness_values = select_parents(population, fitness_values, budget // 2)
        new_population = []
        while len(new_population) < budget:
            parent1, parent2 = rng.choice(population, size=2, replace=False)
            child = crossover(parent1, parent2, rng)
            child = mutation(child, rng)
            new_population.append(child)

        population = np.array(new_population + [individual for individual in population if individual not in new_population])
        fitness_values = np.array([calculate_fitness(individual, func) for individual in population])

    best_individual_index = np.argmin(fitness_values)
    return population[best_individual_index]
