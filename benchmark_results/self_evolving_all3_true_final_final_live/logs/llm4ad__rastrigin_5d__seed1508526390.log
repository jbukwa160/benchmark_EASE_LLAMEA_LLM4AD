def algorithm(func, dim, lb, ub, budget, rng):
    best = None
    for _ in range(budget):
        x = np.zeros(dim)
        for i in range(dim):
            if rng.rand() < 0.1:
                x[i] = rng.uniform(lb, ub)
            else:
                x[i] += rng.normal(0, 0.5) * (ub - lb)
                x[i] = max(lb, min(x[i], ub))
        f_x = func(x)
        if best is None or f_x < func(best):
            best = x
    return best
