def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_random_search(bounds):
        x = [rng.uniform(lb, ub) for _ in range(dim)]
        return np.array(x)

    def adaptive_cma_es(bounds, learning_rate, budget, rng):
        n_dim = len(bounds)
        D = 1.0 + (n_dim * (np.sqrt(n_dim) - 1)) / (4 * n_dim)
        mu, sigma = gaussian_random_search(bounds), np.mean([bound[1] - bound[0] for bound in bounds])
        pop_size = int((budget ** 2) ** 0.5)

        for _ in range(pop_size):
            x = [rng.normal(mu[i], sigma) for i in range(n_dim)]
            x = [max(bounds[i][0], min(x[i], bounds[i][1])) for i in range(n_dim)]

        def calculate_fitness(x):
            return func(x)

        fitnesses, new_mu, new_sigma = [], [], []
        for _ in range(pop_size):
            x = gaussian_random_search(bounds)
            f_x = calculate_fitness(x)
            fitnesses.append(f_x)

            if f_x < np.min(fitnesses) - 1e-6:
                new_mu, new_sigma = x, sigma
                fitnesses = [f_x]

        learning_rate *= D * (pop_size ** (-0.5))
        return new_mu, learning_rate

    def restart_cma_es(bounds, budget, rng):
        mu, sigma, best_solution = None, None, None
        while True:
            if mu is not None and len(best_solution) == 1: # global optimum found, terminate
                break
            if budget <= 0:
                return best_solution

            learning_rate = 0.05 + (budget ** 2) * 10e-6
            mu, learning_rate = adaptive_cma_es(bounds, learning_rate, budget, rng)
            new_sigma = np.mean([bound[1] - bound[0] for bound in bounds]) / 5

            def calculate_fitness(x):
                return func(x)

            f_x = calculate_fitness(mu)
            if best_solution is None or f_x < best_solution:
                best_solution = mu
            budget -= learning_rate * (10 ** 4) # assume constant computational cost per iteration

        return best_solution

    bounds = [(lb, ub) for _ in range(dim)]
    best_solution = restart_cma_es(bounds, budget, rng)
    return np.array(best_solution)
