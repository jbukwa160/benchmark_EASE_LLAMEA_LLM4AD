def algorithm(func, dim, lb, ub, budget, rng):
    n = dim  # dimensionality of the problem
    D = 0.9  # scaling factor for differential evolution
    F = 1.0  # mutation factor for differential evolution
    T = 1000.0  # initial temperature for simulated annealing
    alpha = 0.99  # cooling rate for simulated annealing

    x_best = np.array([ub + rng.next() * (lb - ub) for _ in range(n)])  # initial population
    y_best = func(x_best)

    for i in range(budget):
        # differential evolution step
        trial_population = []
        for j in range(n):
            z1, z2, z3 = rng.sample(range(n), 3)
            z = np.array(x_best) + D * (x_best[z1] - x_best[z2]) + F * (np.random.rand(n) - 0.5)
            trial_population.append(z)
        trial_population = [clip_to_bounds(z, lb, ub) for z in trial_population]

        # simulated annealing step
        y_trial = []
        for j in range(len(trial_population)):
            y_trial.append(func(trial_population[j]))
        indices = np.argsort(y_trial)[:int(0.1 * len(trial_population))]
        y_trial = [y_trial[i] for i in indices]
        trial_population = [trial_population[i] for i in indices]

        # acceptance step
        for j in range(len(trial_population)):
            if rng.next() < np.exp(-(y_trial[j] - y_best) / T):
                x_best = trial_population[j]
                y_best = y_trial[j]
        T *= alpha  # anneal temperature

    return x_best
