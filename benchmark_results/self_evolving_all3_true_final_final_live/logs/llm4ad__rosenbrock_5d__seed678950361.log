def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def generate_population(size, dim, rng):
        return rng.uniform(lb, ub, size=(size, dim))

    def differential_evolution(population, func, dim, lb, ub, budget):
        best_candidate = population[0]
        for i in range(1, len(population)):
            candidate = np.copy(best_candidate)
            for j in range(dim):
                diff = population[i][j] - best_candidate[j]
                candidate[j] += 0.5 * rng.uniform(-1, 1) * diff
                candidate[j] = clip(candidate[j], lb, ub)
            if func(candidate) < func(best_candidate):
                best_candidate = candidate
        return best_candidate

    def gradient_descent(population, func, dim, lb, ub, budget):
        best_candidate = population[0]
        learning_rate = 1e-3
        for _ in range(budget):
            gradient = np.zeros(dim)
            for i in range(1, len(population)):
                gradient += (population[i] - best_candidate) * rng.uniform(-1, 1)
            gradient /= len(population)
            candidate = np.copy(best_candidate)
            for j in range(dim):
                candidate[j] -= learning_rate * gradient[j]
                candidate[j] = clip(candidate[j], lb, ub)
            if func(candidate) < func(best_candidate):
                best_candidate = candidate
        return best_candidate

    population_size = 10
    population = generate_population(population_size, dim, rng)
    for _ in range(budget // 2):
        population[0] = differential_evolution(population, func, dim, lb, ub, budget // 4)
        for i in range(1, population_size):
            population[i] = gradient_descent(population[:i], func, dim, lb, ub, budget // 8)
    return differential_evolution(population, func, dim, lb, ub, budget // 2)
