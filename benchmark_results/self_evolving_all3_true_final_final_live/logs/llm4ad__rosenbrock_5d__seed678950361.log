def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    T = 100.0
    alpha = 0.99
    best_x = rng.uniform(lb, ub, size=dim)
    best_f = objective(best_x)

    for i in range(budget):
        x = np.clip(rng.normal(loc=np.zeros(dim), scale=T, size=dim), lb, ub)
        f = objective(x)

        if f < best_f:
            best_f = f
            best_x = x

        T *= alpha

    return best_x
