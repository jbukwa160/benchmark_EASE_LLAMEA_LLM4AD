def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.random.uniform(lb, ub, size=dim)
    best_y = func(best_x)

    for _ in range(budget):
        x = np.copy(best_x)
        p = np.zeros(dim)

        while True:
            # Simulated annealing
            t = 0.5 + rng.rand() * 0.4
            noise = np.sqrt(1 / (budget - _)) * rng.randn(dim)

            # Probabilistic gradient descent
            x_try = x + t * noise
            x_try = np.clip(x_try, lb, ub)
            y_try = func(x_try)
            delta_y = y_try - best_y

            if delta_y < 0:
                best_x = x_try
                best_y = y_try
            elif rng.rand() < np.exp(-delta_y / t):
                best_x = x_try
                best_y = y_try

            # Convergence check
            if np.allclose(x, best_x, atol=1e-6):
                break

            # Update the position and momentum
            p = 0.9 * p + 0.1 * (x_try - x)
            x = x + 0.01 * p

    return best_x
