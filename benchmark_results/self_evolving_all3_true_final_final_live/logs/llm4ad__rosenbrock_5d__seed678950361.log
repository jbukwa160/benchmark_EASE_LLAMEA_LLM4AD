def algorithm(func, dim, lb, ub, budget, rng):
    def func_val(x):
        return func(x)

    x = rng.uniform(lb, ub, size=dim)
    y = func_val(x)
    best_x = x.copy()
    best_y = y

    for _ in range(budget):
        # DE part
        v1 = rng.uniform(0.5, 1.0, size=dim) + x
        v2 = rng.uniform(0.5, 1.0, size=dim) + x
        v3 = (rng.uniform(lb, ub, size=dim) + x)/2

        f_val_v1 = func_val(v1)
        f_val_v2 = func_val(v2)
        f_val_v3 = func_val(v3)

        if f_val_v1 < y:
            y = f_val_v1
            best_x = v1.copy()
        elif f_val_v2 < y:
            y = f_val_v2
            best_x = v2.copy()
        else:
            y = f_val_v3
            best_x = v3

        # SM part
        s = np.array([x, v1, v2, v3])
        s.sort(axis=0)
        x_center = np.mean(s[:, :dim-1], axis=0)

        d = 2 * (best_x - x_center) / (dim + 1)
        new_x = best_x + d

        f_val_new_x = func_val(new_x)

        if f_val_new_x < y:
            y = f_val_new_x
            best_x = new_x.copy()

    return best_x
