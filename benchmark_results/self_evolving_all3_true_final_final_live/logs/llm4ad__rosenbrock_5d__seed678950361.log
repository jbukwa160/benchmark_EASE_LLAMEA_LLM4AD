def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    sigma = (ub - lb) / 5.0
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget - 1):
        y = x + sigma * rng.randn(dim)
        y = np.clip(y, lb, ub)
        fy = func(y)
        
        if fy < best_f:
            best_f = fy
            best_x = y
            
        # Update step size based on performance
        if fy > best_f:
            sigma *= 0.9
        else:
            sigma *= 1.1
        
        x = best_x + (y - best_x) / np.linalg.norm(y - best_x) * rng.randn(dim)
        x = np.clip(x, lb, ub)

    return best_x
