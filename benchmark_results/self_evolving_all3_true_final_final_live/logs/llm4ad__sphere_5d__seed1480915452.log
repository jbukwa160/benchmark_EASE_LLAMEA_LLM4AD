def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    x_best = np.zeros(dim)
    f_best = float('inf')

    for _ in range(budget):
        x_new = x_best + rng.normal(size=(dim,))
        x_new = clip(x_new)
        f_new = func(x_new)

        if f_new < f_best:
            f_best = f_new
            x_best = x_new

        # Local improvement by perturbing the current best solution
        for i in range(dim):
            x_temp = x_best.copy()
            x_temp[i] += rng.normal(size=(1,))[0]
            x_temp = clip(x_temp)
            f_temp = func(x_temp)

            if f_temp < f_best:
                f_best = f_temp
                x_best = x_temp

    return x_best
