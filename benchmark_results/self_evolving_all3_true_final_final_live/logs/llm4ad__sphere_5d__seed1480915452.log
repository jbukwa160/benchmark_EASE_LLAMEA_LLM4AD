def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.array([0.] * dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_new = x_best + np.random.normal(size=dim) * 1e-2
        x_new = np.clip(x_new, lb, ub)
        
        if func(x_new) < f_best:
            x_best = x_new
            f_best = func(x_new)

    return x_best
