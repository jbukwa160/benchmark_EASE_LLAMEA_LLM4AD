def algorithm(func, dim, lb, ub, budget, rng):
    def grad(x):
        return 2 * x

    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    best = np.random.uniform(lb, ub, size=dim)
    min_val = func(best)
    improvement_ratio = 1.0

    for _ in range(budget):
        candidate = best + rng.uniform(-1, 1, size=dim) * 5
        candidate = clip_candidate(candidate)
        gradient = grad(candidate)
        candidate -= 0.01 * gradient
        candidate = clip_candidate(candidate)

        val = func(candidate)
        improvement_ratio *= np.exp(val - min_val)
        if improvement_ratio < 1e-6 or val < min_val:
            best, min_val = candidate, val

    return best
