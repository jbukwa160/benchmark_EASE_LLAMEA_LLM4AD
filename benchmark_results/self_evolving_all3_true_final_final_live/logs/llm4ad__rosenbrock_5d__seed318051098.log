def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x)

    x = rng.uniform(size=dim) * (ub - lb) + lb
    best_x = x.copy()
    best_f = float('inf')
    for i in range(budget):
        if not isinstance(x, np.ndarray):
            x = np.array(x)
        x = clip(x)
        f = evaluate(x)
        if f < best_f:
            best_f = f
            best_x = x.copy()
        step_size = 0.5 / (i + 1) ** 0.2
        y = x + rng.normal(size=dim, scale=step_size) * (ub - lb)
        y = clip(y)
        if evaluate(y) < f:
            x = y
    return best_x
