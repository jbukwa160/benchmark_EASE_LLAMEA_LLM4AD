def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    T = 1.0
    cooling_rate = 0.99
    best_x = x.copy()
    best_f = func(x)
    num_evals = 0

    while num_evals < budget:
        for _ in range(dim):
            i = rng.randint(0, dim)
            delta = np.random.uniform(-1, 1, size=dim)
            delta[i] = 0
            candidate = x + delta
            candidate = clip_candidate(candidate)

            f_candidate = func(candidate)
            num_evals += 1

            if f_candidate < best_f:
                best_x = candidate.copy()
                best_f = f_candidate

        T *= cooling_rate
        alpha = np.exp((best_f - func(x)) / (T + 0.001))
        if rng.uniform(0, 1) > alpha:
            x = best_x.copy()

    return best_x
