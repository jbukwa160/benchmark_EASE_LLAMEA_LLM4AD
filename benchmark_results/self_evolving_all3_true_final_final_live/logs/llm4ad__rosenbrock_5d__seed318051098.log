def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = 20
    x_min = 1e-6 * rng.random((pop_size, dim))
    y_min = np.zeros(pop_size)
    for _ in range(budget):
        diff = rng.normal(size=(pop_size, dim)) / 2.0
        new_pop = clip(x_min + 0.5 * diff + 0.1 * rng.normal(size=(pop_size, dim)))
        y_new = func(new_pop)
        idx_best = np.argmin(y_new)
        if y_new[idx_best] < y_min[idx_best]:
            x_min[idx_best], y_min[idx_best] = new_pop[idx_best], y_new[idx_best]
    return clip(x_min[np.argmin(y_min)])
