def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    pop_size = 100
    num_parents = int(pop_size * 0.2)
    learning_rate = 1.0 / (budget ** 0.5 + 1e-8)
    adaptation_factor = 0.01

    population = rng.uniform(lb, ub, size=(pop_size, dim))

    for _ in range(budget):
        fitness_values = [func(clip(x)) for x in population]
        best_individual = population[np.argmin(fitness_values)]

        if np.mean(np.array(fitness_values) < 1e-6) > 0.9:
            return clip(best_individual)

        parents = population[np.argsort(fitness_values)[:num_parents]]

        velocities = np.zeros((pop_size, dim))
        for i in range(pop_size):
            x_best = best_individual
            if rng.random() < 0.1:
                x_best = population[i]
            elif rng.random() < 0.2:
                idx = rng.randint(0, num_parents)
                x_best = parents[idx]

            velocities[i] += learning_rate * (x_best - population[i]) + adaptation_factor * rng.normal(size=dim)

        population = clip(population + velocities)

    return clip(best_individual)
