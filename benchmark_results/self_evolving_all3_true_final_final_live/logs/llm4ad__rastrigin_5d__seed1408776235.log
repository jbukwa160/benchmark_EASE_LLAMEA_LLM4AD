def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.minimum(np.maximum(candidate, lb), ub)

    n = 0
    population_size = 1
    sigma = 10 * (ub - lb) / 2
    x_best = np.zeros(dim)
    f_best = float('inf')
    while n < budget:
        n += 1
        x_c = rng.normal(size=(population_size, dim))
        for i in range(population_size):
            x_c[i] = clip(x_c[i])
        f_c = func(x_c)
        
        # Update best solution
        idx_best = np.argmin(f_c)
        if f_c[idx_best] < f_best:
            f_best = f_c[idx_best]
            x_best = x_c[idx_best]

        # CMA-ES update
        delta = x_c - x_best[np.newaxis, :]
        cov = (delta * delta.T) / population_size
        mu = np.mean(delta, axis=0)
        sigma_new = 1.1 if np.linalg.norm(mu) > 3 else 0.9
        sigma = (1 + 2) * sigma_new - sigma
        
        # Step-size reduction mechanism
        if n % 10 == 0 and population_size < budget / 5:
            population_size *= 2
            sigma /= np.sqrt(population_size)
        
    return x_best
