def algorithm(func, dim, lb, ub, budget, rng):
    def eval(x):
        return func(x)

    N = 50  # Population size
    D = dim
    L = len(rng)
    M = int(budget / (D * N))
    sigma_init = 1.0
    CR_init = 0.5

    X = np.random.uniform(lb, ub, (N, D))  # Initialize population
    fX = np.zeros(N)

    for t in range(M):
        CR = CR_init + rng[L] * (1 - CR_init)
        sigma = sigma_init + rng[L] * (1 - sigma_init)
        f_best = float('inf')
        x_best = None

        for i in range(N):
            r1, r2, r3 = np.random.choice(N, 3, replace=False)

            v_i = X[r1, :] + sigma * (X[r2, :] - X[r3, :])

            f_v_i = eval(v_i)
            if f_v_i < f_best:
                f_best = f_v_i
                x_best = v_i

            u_i = np.random.uniform(0, 1, D)

            for j in range(D):
                if rng[L] <= CR or u_i[j] < (f_v_i - eval(X[i, :])) / (eval(v_i) - eval(X[i, :]) + 1e-8):
                    v_i[j] = X[i, j]

            v_i = np.clip(v_i, lb, ub)

            f_v_i = eval(v_i)
            if f_v_i < f_best:
                f_best = f_v_i
                x_best = v_i

        X[:] = np.copy(x_best).reshape(-1, D)
        fX[:] = [f_best]

    return np.array(X[0])
