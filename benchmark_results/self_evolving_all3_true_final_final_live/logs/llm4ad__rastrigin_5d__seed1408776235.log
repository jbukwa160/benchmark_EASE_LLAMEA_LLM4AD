def algorithm(func, dim, lb, ub, budget, rng):
    D = rng.uniform(lb, ub, size=(dim,))
    pop = np.stack([D + rng.normal(size=dim, scale=1) for _ in range(budget)], axis=0)
    
    for t in range(1, budget):
        temp = 2 / (t + 10)
        F = rng.uniform(0.5, 1, size=(len(pop),))
        
        for i in np.random.choice(len(pop), len(pop), replace=True):
            ind = pop[i]
            if rng.rand() < temp:
                mutation = F * (ind - pop[rng.randint(0, len(pop) - 1)])
            else:
                mutation = rng.normal(size=dim, scale=2)
            
            candidate = np.clip(np.round(ind + mutation), lb, ub)
            if func(candidate) < func(pop[i]):
                pop[i] = candidate
        D = np.mean(pop, axis=0)
    
    return D
