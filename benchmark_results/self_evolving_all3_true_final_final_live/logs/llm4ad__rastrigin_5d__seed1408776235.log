def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    t = 1.0
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        v = np.zeros(dim)
        i = np.random.choice(dim, size=3, replace=False)
        for j in range(3):
            r = rng.uniform(0, 1)
            if r < 0.5:
                v[i[j]] = best_x[i[j]]
            else:
                v[i[j]] = x[i[(j+1)%dim]]

        u = x + 0.01*t * (v - x) + rng.normal(size=dim) * 0.05

        while True:
            f_u = func(u)
            if f_u < best_f or rng.uniform(0, 1) < np.exp((best_f - f_u) / t):
                x = u.copy()
                if f_u < best_f:
                    best_x = x.copy()
                    best_f = f_u
            if rng.uniform(0, 1) > 0.8 or _ >= budget - 10:
                break

            u[i[2]] += rng.normal(size=1)
            while np.any(u < lb) or np.any(u > ub):
                i = np.random.choice(dim, size=3, replace=False)
                u[i[2]] += rng.normal(size=1)

        t *= 0.995
    return best_x
