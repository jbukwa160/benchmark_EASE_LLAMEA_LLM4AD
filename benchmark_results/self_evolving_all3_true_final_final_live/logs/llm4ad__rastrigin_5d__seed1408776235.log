def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidates(candidates, lb, ub):
        return np.clip(candidates, lb, ub)

    def differential_mutation(population, weights, c1, c2):
        a = population[rng.integers(0, population.shape[0]), :]
        b = population[rng.integers(0, population.shape[0]), :]
        v = weights * (b - a) + c1 * np.random.uniform(-1, 1, size=(dim,)) * a + c2 * np.random.uniform(-1, 1, size=(dim,))
        return clip_candidates(v, lb, ub)

    def crossover(parent, child):
        if rng.uniform(0, 1) < 0.5:
            return child
        else:
            return parent

    population = np.random.uniform(lb, ub, size=(budget, dim))
    weights = rng.uniform(0.2, 0.8, size=budget)
    for i in range(budget):
        v = differential_mutation(population, weights, 0.7, 0.3)
        u = crossover(population[i], v)
        if func(u) < func(population[i]):
            population[i] = u
            weights[i] = rng.uniform(0.2, 0.8)

    return population[np.argmin(func(population)), :]
