    for _ in range(budget):
        x = np.clip(rng.uniform(lb, ub, size=dim), lb, ub)
        
        # Apply a small perturbation to the generated candidate
        delta = 0.01 * rng.normal(size=dim)
        x += delta
        
        f = func(x)
        
        if f < best_f:
            best_x = x
            best_f = f
    
    return best_x
