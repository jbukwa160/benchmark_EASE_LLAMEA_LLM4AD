def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.array([0] * dim)
    best_fx = func(best_x)

    def generate_candidate(x):
        return x + (ub - lb) * rng.uniform(-1, 1, size=dim)

    for _ in range(budget):
        new_x = generate_candidate(best_x)
        new_fx = func(new_x)
        
        if new_fx < best_fx:
            best_x = new_x
            best_fx = new_fx

        # restarts
        if rng.uniform(0, 1) > 0.8 and _ >= budget // 2:
            best_x = np.array([lb + (ub - lb) * rng.uniform(0, 1) for _ in range(dim)])
            best_fx = func(best_x)

    return np.clip(best_x, lb, ub)
