def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.array(rng.uniform(lb, ub, size=dim))
    T = 1.0
    while True:
        y = clip(x + rng.normal(size=dim) * 0.01)
        delta = func(y) - func(x)
        if delta < 0 or np.random.rand() < np.exp(-delta / T):
            x = y
        else:
            T *= 0.99
        budget -= 1
        if budget <= 0:
            break
    return x
