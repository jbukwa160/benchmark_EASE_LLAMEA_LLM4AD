def algorithm(func, dim, lb, ub, budget, rng):
    x_best = None
    f_best = float('inf')
    
    for i in range(budget):
        # Sample a new point from the current posterior distribution
        mean, cov = 0, 1e-8 * np.eye(dim)
        while True:
            x = norm.rvs(size=dim, loc=mean, scale=np.sqrt(cov)).clip(lb, ub)
            if (x != x).any():  # Check for NaNs or infs
                break
        
        # Evaluate the objective function at the new point
        f_x = func(x)
        
        # Update the best solution found so far
        if f_x < f_best:
            f_best = f_x
            x_best = x
        
        # Update the posterior distribution parameters based on the observed data
        cov += np.eye(dim) * 1e-8
        
    return x_best
