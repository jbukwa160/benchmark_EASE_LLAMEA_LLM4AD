def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    min_val = float('inf')
    best_candidate = None
    for _ in range(budget):
        candidate = np.zeros(dim)
        for i in range(dim):
            candidate[i] = rng.uniform(lb, ub)
        clipped_candidate = clip_candidate(candidate)
        val = func(clipped_candidate)
        if val < min_val:
            min_val = val
            best_candidate = clipped_candidate

    return best_candidate
