def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n = 1  # number of initial points
    X_init = np.random.uniform(lb, ub, (n, D))
    Y_init = func(X_init)
    
    for i in range(budget - n):
        m = GaussianProcess(Y_init, X_init, rng=rng)
        EI = AcquisitionFunction(m, Y_init, lb, ub, rng=rng)
        
        x_new = np.clip(EI.query_point(), lb, ub)
        y_new = func(x_new)
        
        X_init = np.vstack((X_init, x_new))
        Y_init = np.concatenate((Y_init, y_new))
    
    idx_best = np.argmin(Y_init)
    return X_init[idx_best]
