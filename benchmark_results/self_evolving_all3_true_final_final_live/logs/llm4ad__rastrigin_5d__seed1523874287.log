def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def mutate_DE(x, best_so_far, rng):
        v = best_so_far + 0.5 * (x - best_so_far) + rng.uniform(-1, 1, dim)
        return clip(v)

    def update_PSO(best_so_far, candidates, rng):
        pbest = np.mean(candidates, axis=0)
        v = best_so_far + 0.01 * (pbest - best_so_far) + rng.uniform(-1, 1, dim)
        return clip(v)

    best_so_far = rng.uniform(lb, ub, dim)
    candidates = [np.zeros(dim), np.ones(dim)]

    for _ in range(budget):
        new_candidates = []
        for x in candidates:
            v = mutate_DE(x, best_so_far, rng)
            new_candidates.append(v)
            new_candidates.append(update_PSO(best_so_far, new_candidates, rng))
        new_candidates = np.array(new_candidates)
        fvals = [func(x) for x in new_candidates]
        idx = np.argmin(fvals)
        if fvals[idx] < func(best_so_far):
            best_so_far = new_candidates[idx]

    return best_so_far
