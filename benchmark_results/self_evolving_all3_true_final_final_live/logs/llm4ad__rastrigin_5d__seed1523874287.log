def algorithm(func, dim, lb, ub, budget, rng):
    def sample_x(dim):
        return [rng.uniform(lb, ub) for _ in range(dim)]

    best_x = None
    best_f = np.inf

    for i in range(budget):
        x = sample_x(dim)
        f = func(x)

        if f < best_f:
            best_f = f
            best_x = x

        # Differential Evolution step
        mutant_x = [x[j] + 0.5 * (np.random.choice([x[(j-1)%dim], x[(j+1)%dim]]) - x[j]) for j in range(dim)]
        mutant_x = np.clip(mutant_x, lb, ub)

        # Gaussian Process surrogate model step
        if i > 0:
            gp = GaussianProcess(x[:i], func(x[:i]))
            mean, var = gp.predict(mutant_x)
            if mean < best_f:
                best_f = mean
                best_x = mutant_x

    return np.array(best_x)
