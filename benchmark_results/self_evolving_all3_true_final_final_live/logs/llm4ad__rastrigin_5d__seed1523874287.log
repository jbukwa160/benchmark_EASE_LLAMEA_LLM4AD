def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    p_best = x.copy()
    g_best = x.copy()

    alpha = 0.1
    beta = 2
    gamma = 0.01

    for _ in range(budget):
        v = np.zeros(dim)
        for i in range(dim):
            r1, r2 = rng.uniform(0, 1), rng.uniform(0, 1)
            v[i] += alpha * (p_best[i] - x[i]) + beta * (g_best[i] - x[i])

        new_x = clip(x + v)

        if func(new_x) < func(g_best):
            g_best = new_x

        if rng.uniform(0, 1) < gamma:
            if func(p_best) > func(g_best):
                p_best = g_best
            else:
                r = rng.uniform(0, 1)
                for i in range(dim):
                    if r < (i / dim):
                        p_best[i] += 0.01 * rng.uniform(-1, 1)

        x = new_x

    return g_best
