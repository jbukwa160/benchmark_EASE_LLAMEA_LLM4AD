def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
        
        # Clip candidates to [lb, ub]
        clipped_x = np.clip(x, lb, ub)
        
        # Randomly perturb current best solution
        noise = rng.uniform(-1, 1, size=dim) / (budget + 1)
        new_x = best_x + noise * (ub - lb)
        
        # Clip candidates to [lb, ub]
        clipped_new_x = np.clip(new_x, lb, ub)
        
        if func(clipped_new_x) < best_f:
            best_f = func(clipped_new_x)
            best_x = clipped_new_x
    
    return best_x
