def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        noise = 0.1 * (ub - lb) * rng.randn(dim)
        new_x = np.clip(best_x + noise, lb, ub)
        new_f = func(new_x)

        if new_f < best_f:
            best_x = new_x
            best_f = new_f

    return best_x
