def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    best_cost = float('inf')

    for _ in range(budget):
        x = np.array([lb + (ub - lb) * rng.rand() for _ in range(dim)])
        cost = func(x)

        if cost < best_cost:
            best_cost = cost
            best = x

        # Hill climbing: perturb the current best solution and check if it's better
        for i in range(dim):
            new_x = best.copy()
            new_x[i] += (ub - lb) * rng.rand() - 0.5 * (ub - lb)
            new_cost = func(new_x)

            if new_cost < best_cost:
                best_cost = new_cost
                best = new_x

        # Clip candidates to [lb, ub]
        best = np.clip(best, lb, ub)

    return best
