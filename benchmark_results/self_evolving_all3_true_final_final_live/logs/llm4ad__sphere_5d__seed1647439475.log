def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    T = 1e5
    cooling_rate = 0.99
    step_size = (ub - lb) / 10
    num_steps = int(budget / dim)

    for _ in range(num_steps):
        i = rng.randint(0, dim)
        x_copy = np.copy(x)
        x[i] += rng.uniform(-step_size, step_size)
        if x[i] < lb:
            x[i] = lb
        elif x[i] > ub:
            x[i] = ub

        f_x = func(x)
        f_x_copy = func(x_copy)

        delta = f_x - f_x_copy
        if delta < 0 or rng.rand() < np.exp(-delta / T):
            x = x_copy

        T *= cooling_rate

    return x
