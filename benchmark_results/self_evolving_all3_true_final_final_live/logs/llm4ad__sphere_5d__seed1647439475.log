def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    step_size = max(ub - lb, 1e-6)
    best_x = x.copy()
    
    for _ in range(budget):
        perturbation = rng.randn(dim) / np.sqrt(np.sum(x**2)) * step_size
        new_x = x + perturbation
        
        # Clip new candidate to bounds
        new_x = np.clip(new_x, lb, ub)
        
        f_new = func(new_x)
        f_best = func(best_x)
        
        if f_new < f_best:
            best_x = new_x
    
    return best_x
