def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    current_solution = np.zeros(dim)
    best_solution = np.zeros(dim)
    for _ in range(budget):
        step_size = 0.1 * (ub - lb) / np.sqrt(_ + 1)
        new_solution = current_solution + rng.normal(size=dim) * step_size
        new_solution = clip(new_solution, lb, ub)
        alpha = 0.9 # acceptance probability for Simulated Annealing
        temperature = (ub - lb) / (np.sqrt(_ + 1))
        if func(new_solution) < func(current_solution):
            current_solution = new_solution
            best_solution = np.copy(new_solution)
            if func(new_solution) == 0:
                break # stop when global minimum is reached
        else:
            p = np.exp(-(func(new_solution) - func(current_solution)) / (temperature * alpha))
            if rng.uniform(0, 1) < p:
                current_solution = new_solution

    return best_solution
