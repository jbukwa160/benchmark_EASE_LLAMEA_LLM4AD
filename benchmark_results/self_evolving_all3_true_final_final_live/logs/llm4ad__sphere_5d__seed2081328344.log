def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    sigma = 5.0 / np.sqrt(dim)
    mu = np.zeros(dim)
    x_best = mu.copy()

    for _ in range(budget):
        candidates = mu + rng.randn(dim) * sigma
        candidates = clip(candidates)

        f_values = func(candidates)
        indices = np.argsort(f_values)[:1]
        new_x = candidates[indices]

        if f_values[indices] < func(x_best):
            x_best = new_x.copy()

    return x_best
