def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        delta = np.zeros(dim)
        for i in range(dim):
            delta[i] = (ub - lb) * np.random.choice([-1, 1]) * rng.rand()

        new_x = best_x + delta
        clip_new_x = np.clip(new_x, lb, ub)

        new_f = func(clip_new_x)
        if new_f < best_f:
            best_x = clip_new_x
            best_f = new_f

    return best_x
