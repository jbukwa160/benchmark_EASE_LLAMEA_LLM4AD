def algorithm(func, dim, lb, ub, budget, rng):
    X = np.random.uniform(lb, ub, (budget, dim))
    Y = np.zeros(budget)
    
    for i in range(1, budget):
        mean, var = func(X[i-1])
        GP = GaussianProcess(mean, var)
        
        x_next = np.array([0.]*dim)
        EI = -np.inf
        
        for j in range(i+1, budget):
            x_candidate = X[j]
            mean_new, var_new = func(x_candidate)
            new_EI = expected_improvement(GP, x_candidate, mean_new, var_new)
            
            if new_EI > EI:
                EI = new_EI
                x_next = x_candidate
                
        X[i] = x_next
        
    return X[np.argmax(Y)]
