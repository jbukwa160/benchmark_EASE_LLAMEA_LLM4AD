def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 1e3
    alpha = 0.99
    learning_rate = 0.01
    for i in range(budget):
        f_x = func(x)
        f_min = np.inf
        min_d = None
        for d in range(dim):
            x_try = np.copy(x)
            x_try[d] += rng.uniform(-1, 1)
            x_try = np.clip(x_try, lb, ub)
            f_try = func(x_try)
            if f_try < f_x:
                x = x_try
                f_x = f_try
            elif rng.random() < np.exp((f_x - f_try) / T):
                x[d] += rng.uniform(-1, 1)
                x[d] = np.clip(x[d], lb, ub)
        if f_x < f_min:
            f_min = f_x
            min_d = d
        if i > budget // 2 and (f_x - f_min) / T < learning_rate * np.log(i + 1):
            T *= alpha
    return x
