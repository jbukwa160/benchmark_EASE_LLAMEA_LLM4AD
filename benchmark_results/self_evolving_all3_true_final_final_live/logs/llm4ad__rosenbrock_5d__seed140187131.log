def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    n = len(lb)
    init_stddev = 0.1
    sigma = np.full(n, init_stddev)
    mu = np.zeros(n)
    lambda_ = 5  # population size
    C = np.eye(n) * init_stddev ** 2
    d = np.zeros((lambda_, n))
    D_inv = np.linalg.inv(C)

    for i in range(budget):
        X = clip(mu + rng.normal(0, sigma, (lambda_, n)))
        fX = func(X)
        idx = np.argsort(fX)[:int(lambda_ / 2)]
        mu = np.mean(X[idx], axis=0)
        sigma = np.std(X[idx], axis=0) * np.sqrt(lambda_) / 3.0
        C = (lambda_ - 1) / lambda_ * C + np.outer(mu, mu)
        D_inv = np.linalg.inv(C)

    return clip(mu)
