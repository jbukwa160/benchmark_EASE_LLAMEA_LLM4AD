def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    x = np.array([0.1 + 4.9 * rng.uniform(0, 1) for _ in range(dim)])
    T = 100
    alpha = 0.99

    while budget > 0:
        budget -= 1
        x_new = x.copy()
        
        # Gaussian perturbation exploration
        for i in range(dim):
            step_size = 2 * rng.uniform(0, 1) - 1
            x_new[i] += step_size
        
        # Clip to bounds
        x_new = np.clip(x_new, lb, ub)

        delta = evaluate(x_new) - evaluate(x)
        
        if delta <= 0:
            x = x_new
        else:
            probability = np.exp(-delta / T)
            if rng.uniform(0, 1) < probability:
                x = x_new
        
        # Adaptive temperature cooling schedule
        T *= alpha

    return x
