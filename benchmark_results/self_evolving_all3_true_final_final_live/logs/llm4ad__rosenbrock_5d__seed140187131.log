def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(size=dim) * (ub - lb) + lb
    T = 1.0
    best_x = x.copy()
    best_func_val = func(x)
    
    for _ in range(budget):
        if np.random.rand() < 0.05:
            # Golden section search to find the better solution
            a, b = x - (ub - lb) / 2.0, x + (ub - lb) / 2.0
            
            def func_val(a, b):
                return func((1 + np.sqrt(5)) * a + ((b - a) / (1 + np.sqrt(5))))
            
            c = b
            for _ in range(budget // 10):
                if func_val(c, b) > func_val(a, c):
                    c = (a + c) / 2.0
                else:
                    a = c
            
            x[a:b] = (1 + np.sqrt(5)) * a + ((b - a) / (1 + np.sqrt(5)))
        
        # Simulated Annealing
        new_x = rng.uniform(size=dim) * (ub - lb) + lb
        
        delta = func(new_x) - func(x)
        if delta < 0 or np.random.rand() < np.exp(-delta / T):
            x = new_x
            
            if func(x) < best_func_val:
                best_x = x.copy()
                best_func_val = func(x)
        
        # Decrease the temperature
        T *= 0.99
        
    return best_x
