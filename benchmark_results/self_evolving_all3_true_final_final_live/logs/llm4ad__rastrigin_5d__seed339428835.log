def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def crossover(x1, x2):
        a = 0.5 * (x1 + x2)
        b = 0.5 * (np.sin(3 * np.pi * (x1 - x2)) + 1)
        return a * b

    def mutation(x):
        f = rng.uniform(-1, 0)
        return x + f * rng.normal(size=dim)

    best_sol = clip(rng.uniform(size=(dim,)))
    best_fit = func(best_sol)

    for _ in range(budget):
        offspring = [mutation(crossover(clip(rng.uniform(size=(dim,))), clip(best_sol))) for _ in range(dim)]
        fitness = np.array([func(sol) for sol in offspring])
        indices = np.argsort(fitness)
        best_offspring = clip(offspring[indices[0]])
        if func(best_offspring) < best_fit:
            best_sol = best_offspring
            best_fit = func(best_sol)

    return best_sol
