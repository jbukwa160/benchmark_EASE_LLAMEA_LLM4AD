def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    best_x = rng.uniform(-5, 5, size=dim)
    best_f = evaluate(best_x)

    pop_size = int(budget ** 0.8)
    pop = np.random.uniform(lb, ub, size=(pop_size, dim))
    for _ in range(pop_size):
        x = pop[_]
        f = evaluate(x)
        if f < best_f:
            best_f = f
            best_x = x

    def adapt_de(c1, c2, f_improvement):
        return 0.9 * c1 + 0.1 * (c2 - np.abs(np.random.normal(0, 1)) * c1)

    def adapt_pso(w, f_improvement):
        return w + 0.5 * (np.random.uniform(-1, 1) if f_improvement > 0 else 0.9 - np.random.uniform(0, 0.1))

    for _ in range(budget - pop_size):
        new_pop = np.zeros((pop_size, dim))
        for i in range(pop_size):
            x = clip(rng.normal(best_x, 1))
            v = rng.normal(np.mean(pop[i], axis=0), 0.5)
            f_improvement = evaluate(x) < best_f
            c1 = adapt_de(0.9, 0.7, f_improvement)
            new_pop[i] = x + c1 * (x - pop[i]) + v

        for i in range(pop_size):
            if rng.uniform(0, 1) > 0.5:
                w = adapt_pso(0.9, f_improvement)
                new_pop[i] += rng.normal(np.mean(new_pop[i], axis=0), w)

        pop = new_pop
        for i in range(pop_size):
            x = pop[i]
            f = evaluate(x)
            if f < best_f:
                best_f = f
                best_x = x

    return best_x
