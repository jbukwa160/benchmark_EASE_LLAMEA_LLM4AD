def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def hybrid_crossover(x, u_best):
        v = x + 0.5 * (u_best - x)
        cr = rng.uniform(0, 1)
        if cr < 0.3:
            v = x
        elif cr < 0.6:
            v = np.random.uniform(lb, ub, dim)
        return v

    pop_size = int(np.ceil(budget ** (1 / 2)))
    u_best = lb + rng.uniform(0, ub - lb, size=dim)

    for _ in range(budget):
        offspring = []
        for i in range(pop_size):
            x = clip(u_best + rng.normal(size=dim))
            v = hybrid_crossover(x, u_best)
            offspring.append(v)
        
        f_values = [func(v) for v in offspring]
        idx = np.argsort(f_values)[:pop_size]
        offspring = [offspring[i] for i in idx]

        if f_values[0] < func(u_best):
            u_best = offspring[0]

    return clip(u_best)
