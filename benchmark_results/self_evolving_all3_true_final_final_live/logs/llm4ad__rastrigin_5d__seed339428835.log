def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(dim, pop_size):
        population = rng.uniform(lb, ub, (pop_size, dim))
        return population

    def evaluate(population):
        scores = [func(ind) for ind in population]
        return np.array(scores)

    def mutation(parent1, parent2, parent3, factor, dim):
        difference1 = parent2 - parent1
        difference2 = parent3 - parent1
        mutant = parent1 + factor * difference1 + rng.uniform(-1, 1) * difference2
        return clip(mutant)

    def crossover(parent, mutant):
        trial = (parent + mutant) / 2
        return clip(trial)

    population_size = int(budget ** 0.5)
    initial_population = generate_initial_population(dim, population_size)
    best_individual = np.inf

    for _ in range(budget):
        scores = evaluate(initial_population)
        current_best = np.argmin(scores)
        if scores[current_best] < best_individual:
            best_individual = scores[current_best]
            best_solution = initial_population[current_best]

        parents = rng.choice(population_size, 3, replace=False)
        mutant = mutation(initial_population[parents[0]], initial_population[parents[1]],
                          initial_population[parents[2]], 0.5, dim)
        trial = crossover(initial_population[parents[0]], mutant)

        scores = evaluate([trial])
        current_best = np.argmin(scores)
        if scores[current_best] < best_individual:
            best_individual = scores[current_best]
            best_solution = trial

    return best_solution
