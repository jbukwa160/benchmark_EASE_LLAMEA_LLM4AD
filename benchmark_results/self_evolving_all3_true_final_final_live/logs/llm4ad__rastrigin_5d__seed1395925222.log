def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    x_best = x.copy()
    best_fitness = func(x)

    for _ in range(budget):
        y = x + 0.1 * (rng.randn(dim) - 0.5)
        y_clipped = clip(y, lb, ub)
        fitness_y = func(y_clipped)
        
        if fitness_y < best_fitness:
            best_fitness = fitness_y
            x_best = y_clipped.copy()
            
        tau = 0.99 * (1 - _ / budget) + np.exp(-_ / budget)
        probability = np.exp((best_fitness - fitness_y) / tau)
        if rng.rand() < probability:
            x = y_clipped

    return x_best
