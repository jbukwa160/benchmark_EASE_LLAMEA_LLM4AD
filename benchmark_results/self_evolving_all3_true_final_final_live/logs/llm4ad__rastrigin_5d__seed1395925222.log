def algorithm(func, dim, lb, ub, budget, rng):
    n = 10 * len(dim)
    sigma = max(0.1, 5 / np.sqrt(budget))
    D = np.eye(dim[0])
    pc = np.zeros((dim[0],))
    mu = np.zeros((dim[0],))

    for i in range(budget):
        z = rng.normal(size=(1, dim[0]))
        x = mu + sigma * z
        for j in range(len(x)):
            if lb[j] < x[j] < ub[j]:
                x[j] = max(lb[j], min(ub[j], x[j]))
            else:
                x[j] = (lb[j] + ub[j]) / 2

        fx = func(x)
        D += np.outer(z, z)
        pc += x
        mu += (x - mu) / (i + 1)

        if i > 10 and abs(func(pc) - n) < 0.01 * sigma:
            break

    return pc
