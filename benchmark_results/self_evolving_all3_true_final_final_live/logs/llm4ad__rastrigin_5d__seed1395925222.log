def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=(dim,))
    x_best = x.copy()
    f_x_best = func(x)
    
    for _ in range(budget):
        v = np.zeros(dim,)
        i1 = rng.randint(0, dim)
        while True:
            i2 = rng.randint(0, dim)
            if i1 != i2:
                break
        j = rng.randint(0, dim)
        while True:
            k = rng.randint(0, dim)
            if j != k and k not in [i1, i2]:
                break
        v[i1] = x_best[i2] + rng.uniform(-1, 1) * (x[i2] - x_best[j])
        v[i2] = x_best[i1] + rng.uniform(-1, 1) * (x[i1] - x_best[k])
        v[j] = x_best[i1] + rng.uniform(-1, 1) * (x[i1] - x_best[k])
        v[k] = x_best[i2] + rng.uniform(-1, 1) * (x[i2] - x_best[j])

        u = clip(v)
        
        f_u = func(u)
        
        if f_u < f_x_best:
            x_best = u.copy()
            f_x_best = f_u
            
    return x_best
