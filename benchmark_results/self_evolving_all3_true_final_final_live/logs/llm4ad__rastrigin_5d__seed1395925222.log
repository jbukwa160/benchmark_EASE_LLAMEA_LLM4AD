def algorithm(func, dim, lb, ub, budget, rng):
    mu = 1.0  # population size
    sigma = 5.0  # initial step size
    d = 0.1  # damping factor
    cc = 2.0 / (dim + 1.25)  # crossover probability
    c1 = 1.0  # learning rate for mean
    c_mu = (mu + 1) / mu  # learning rate for covariance matrix
    c_c = (4 + 2 * np.sqrt(mu)) / (mu + 1 + 2 * np.sqrt(mu))
    
    # Initialize population and best solution
    x_best = rng.uniform(lb, ub, size=(dim,))
    f_best = func(x_best)
    pop = [x_best]
    
    for i in range(budget):
        # Sample new solutions using current distribution
        y = rng.normal(size=(mu, dim))
        
        # Update mean and covariance matrix
        x_new = pop[0] + sigma * np.dot(y, np.diag(1 / np.sqrt(np.diag(covar))))
        f_new = func(x_new)
        
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
        
        # Update covariance matrix and step size
        covar = c_mu * covar + (c_c - 1) * np.outer(y[0], y[0])
        sigma *= np.exp(d * (f_new - f_best))
        
        # Clip candidates to bounds
        pop.append(np.clip(x_new, lb, ub))
        
    return x_best
