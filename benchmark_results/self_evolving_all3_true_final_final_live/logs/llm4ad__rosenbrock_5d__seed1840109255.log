def algorithm(func, dim, lb, ub, budget, rng):
    n = 0
    x = np.random.uniform(lb, ub, size=dim)
    y_best = func(x)
    best_x = x.copy()
    
    T = 1.0  # initial temperature
    cooling_rate = 0.99
    
    for _ in range(budget):
        x_new = x + rng.normal(size=dim) * 0.1
        
        if np.all((x_new >= lb) & (x_new <= ub)):
            f_new = func(x_new)
            
            if f_new < y_best:
                y_best = f_new
                best_x = x_new.copy()
                
            elif np.random.rand() < np.exp(-(f_new - y_best) / T):
                y_best = f_new
                best_x = x_new.copy()
                
        n += 1
        
        # CMA-ES step
        if n % 10 == 0:
            cov = 0.5 * rng.normal(size=(dim, dim)) + np.eye(dim)
            
            for _ in range(100):
                z = rng.normal(size=dim)
                x_new = best_x + np.dot(z, cov)
                
                if np.all((x_new >= lb) & (x_new <= ub)):
                    f_new = func(x_new)
                    
                    if f_new < y_best:
                        y_best = f_new
                        best_x = x_new.copy()
                        
        T *= cooling_rate
        
    return best_x
