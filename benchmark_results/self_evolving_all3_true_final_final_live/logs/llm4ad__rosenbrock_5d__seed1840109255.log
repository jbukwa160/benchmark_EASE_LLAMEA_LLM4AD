def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(x, rng=rng):
        return x + 0.1 * (rng.uniform(-1, 1, size=dim) - 0.5)

    def crossover(x1, x2):
        child = np.zeros_like(x1)
        for i in range(dim):
            if rng.uniform() < 0.5:
                child[i] = x1[i]
            else:
                child[i] = x2[i]
        return child

    population_size = 100
    initial_population = np.random.uniform(lb, ub, size=(population_size, dim))
    best_solution = None
    best_fitness = np.inf

    for _ in range(budget):
        fitnesses = [func(x) for x in initial_population]
        idx = np.argsort(fitnesses)[:int(population_size * 0.2)]
        elite_population = initial_population[idx]

        new_population = []
        while len(new_population) < population_size:
            parent1, parent2 = rng.choice(elite_population, size=2, replace=False)
            child = crossover(parent1, parent2)
            child = mutate(child)
            new_population.append(child)

        if rng.uniform() > 0.5 and best_solution is not None:
            idx = np.argmax([func(x) for x in new_population])
            new_population[idx] = best_solution

        initial_population = np.array(new_population)

        fitnesses = [func(x) for x in initial_population]
        idx = np.argmin(fitnesses)
        if fitnesses[idx] < best_fitness:
            best_solution = initial_population[idx].copy()
            best_fitness = fitnesses[idx]

    return best_solution
