def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    sigma = 1.0
    mu = np.random.uniform(lb, ub, size=dim)
    cov = np.eye(dim) * sigma**2

    for _ in range(budget):
        x_candidate = np.random.multivariate_normal(mu, cov)
        x_candidate = np.clip(x_candidate, lb, ub)

        f_candidate = objective(x_candidate)

        if f_candidate < objective(mu):
            mu = x_candidate
            cov = cov * 0.9 + np.outer((x_candidate - mu), (x_candidate - mu)) / (1 - 0.9)

    return mu
