def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        r = 0.1 * (ub - lb) / np.sqrt(rng.randint(1, 100))
        candidate = best_x + r * rng.normal(size=dim)
        candidate = np.clip(candidate, lb, ub)

        if func(candidate) < best_f:
            best_x = candidate
            best_f = func(candidate)

    return best_x
