def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def generate_candidate(mean, std_dev):
        candidate = mean + rng.normal(size=(dim,), loc=0.0, scale=std_dev)
        return candidate

    best_candidate = np.zeros(dim)
    best_fitness = float('inf')

    for i in range(budget):
        # Generate a new candidate
        new_mean = (best_candidate + clip(generate_candidate(mean=np.zeros(dim), std_dev=5.0))) / 2.0
        std_dev = max(0.1, np.mean(np.abs(new_mean - best_candidate)) * 0.9)  # adapt standard deviation

        candidate = generate_candidate(mean=new_mean, std_dev=std_dev)

        fitness = func(candidate)

        if fitness < best_fitness:
            best_candidate = clip(candidate)
            best_fitness = fitness

    return best_candidate
