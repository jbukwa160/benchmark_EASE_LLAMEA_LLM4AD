def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 1e3
    step_size = 0.01
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        new_x = np.clip(x + rng.normal(0, step_size, size=dim), lb, ub)
        new_f = func(new_x)

        if new_f < best_f:
            best_f = new_f
            best_x = new_x

        elif rng.random() < np.exp((best_f - new_f) / T):
            x = new_x

        T *= 0.99

    return best_x
