def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    
    for _ in range(budget):
        e = rng.uniform(-1, 1, size=dim) * 0.01
        new_x = x + e
        
        # Clip to bounds
        new_x = np.clip(new_x, lb, ub)
        
        if func(new_x) < func(best_x):
            best_x = new_x
            
    return best_x
