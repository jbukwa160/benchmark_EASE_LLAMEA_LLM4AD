def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def objective(x):
        return func(x)

    x0 = rng.uniform(lb, ub, size=dim)
    population_size = 50
    population = np.array([clip(rng.uniform(lb, ub, size=dim), lb, ub) for _ in range(population_size)])

    for t in range(budget):
        # Differential Evolution step
        differential = population[rng.randint(0, population_size, size=(population_size-1))]

        fitness = np.array([objective(x) for x in population])
        diff_fitness = np.array([objective(x + 0.5 * (d1 - d2)) for i, x in enumerate(population) for j, d1 in enumerate(differential) if rng.random() < 0.3] + [objective(x) for x in population])

        fitness_diff = diff_fitness - fitness
        indices = np.argsort(fitness_diff)[::-1][:population_size]

        population[indices[:population_size]] = differential[rng.randint(0, population_size-1, size=population_size)]

        # Local search step using gradient descent
        for i in range(population_size):
            x = clip(population[i] + 0.01 * rng.normal(size=dim), lb, ub)
            for _ in range(10):
                grad = np.array([func(np.append(x[:-1], t)) - func(t) for t in [x[-1] + 0.01]])
                x[-1] -= 0.001 * grad
            population[i] = clip(x, lb, ub)

    best_individual = population[np.argmin([objective(x) for x in population])]
    return best_individual
