def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def de(x0, best):
        v1 = 0.5 * (ub - lb) * rng.randn(dim)
        v2 = 0.5 * (ub - lb) * rng.randn(dim)
        x = x0 + v1
        x = clip(x)
        y = best + v2
        y = clip(y)
        return x, y

    def ps(x):
        c1 = 0.01
        c2 = 0.01
        t = rng.uniform(0, 1)
        if t < c1:
            x += rng.normal(0, 0.5, dim) * (ub - lb)
            x = clip(x)
        elif t < c2:
            x -= rng.normal(0, 0.5, dim) * (ub - lb)
            x = clip(x)

    best_x = np.random.uniform(lb, ub, size=(dim,))
    best_f = func(best_x)
    budget_left = budget
    while budget_left > 1e-6:
        new_x, _ = de(best_x, best_x)
        f_new = func(new_x)
        if f_new < best_f:
            best_x = new_x
            best_f = f_new
        ps(best_x)
        budget_left -= 1e-6
    return best_x
