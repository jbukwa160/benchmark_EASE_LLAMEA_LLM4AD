def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(clip(x_best))

    for _ in range(budget - 1):
        x_new = np.zeros(dim)
        for i in range(dim):
            if rng.rand() < 0.5:
                x_new[i] = clip(rng.uniform(lb, ub))
            else:
                sigma = 10 / (budget - i)
                x_new[i] = clip(x_best + rng.normal(0, sigma, size=1)[0])
        f_new = func(clip(x_new))

        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return clip(x_best)
