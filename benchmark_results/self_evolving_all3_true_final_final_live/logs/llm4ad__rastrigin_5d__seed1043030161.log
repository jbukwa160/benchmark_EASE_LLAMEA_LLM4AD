def algorithm(func, dim, lb, ub, budget, rng):
    def generate_individual():
        return rng.uniform(lb, ub, size=dim)

    def clip(candidate):
        clipped_candidate = np.clip(candidate, lb, ub)
        return clipped_candidate if not np.all(clipped_candidate == lb) else generate_individual()

    def evaluate(individual):
        return func(individual)

    current_solution = generate_individual()
    best_solution = current_solution
    for _ in range(budget):
        offspring = generate_individual()
        while True:
            offspring = clip(offspring)
            if rng.random() < 0.01: # 1% chance to perform DE mutation
                v1, v2, v3 = np.random.choice(dim, size=3, replace=False)
                offspring[v1] += rng.uniform(-5, 5) * (current_solution[v1] - best_solution[v1])
                offspring[v2] += rng.uniform(-5, 5) * (current_solution[v2] - best_solution[v2])
                offspring[v3] += rng.uniform(-5, 5) * (current_solution[v3] - best_solution[v3])
            else: # Perform SA mutation
                for i in range(dim):
                    if rng.random() < 0.1:
                        offspring[i] = current_solution[i] + np.sign(rng.randn()) * rng.uniform(0, 0.5)
            fitness_offspring = evaluate(offspring)
            fitness_current = evaluate(current_solution)
            delta_fitness = fitness_offspring - fitness_current
            if delta_fitness > 0 or (delta_fitness == 0 and not np.all(offspring == current_solution)):
                break
        if fitness_offspring < fitness_current:
            best_solution = offspring
        current_solution = offspring

    return best_solution
