def algorithm(func, dim, lb, ub, budget, rng):
    def get_init_pop():
        return rng.uniform(lb, ub, size=(budget, dim))

    def get_target(x):
        return func(x)

    pop = get_init_pop()
    best_solution = None
    best_value = np.inf

    for i in range(budget):
        candidates = pop.copy()
        targets = np.array([get_target(c) for c in candidates])

        if i % 10 == 0:
            indices = rng.choice(pop.shape[0], size=5, replace=False)
            selected = candidates[indices]
            best_solution = None
            best_value = np.inf

            for j in range(5):
                x1 = selected[j]
                x2 = selected[(j+1) % 5]

                r = rng.uniform(0.5, 1.0)

                diff = (x2 - x1) * r
                c = candidates[rng.choice(pop.shape[0])]

                new_x1 = (1-r)*c + r*x1
                new_x1 = np.clip(new_x1, lb, ub)
                candidates[j] = new_x1

            targets = get_target(candidates)

        indices = rng.choice(targets.shape[0], size=5, replace=False)
        selected = targets[indices]
        winner_index = np.argmin(selected)

        x = pop[winner_index]

        r = rng.uniform(0.5, 1.0)
        c = candidates[rng.choice(pop.shape[0])]

        new_x = (1-r)*c + r*x
        new_x = np.clip(new_x, lb, ub)

        targets[winner_index] = get_target(new_x)

        if targets[winner_index] < best_value:
            best_solution = new_x
            best_value = targets[winner_index]

        pop[winner_index] = new_x

    return best_solution
