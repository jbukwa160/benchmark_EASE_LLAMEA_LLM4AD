def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.sqrt(budget))
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    for _ in range(budget // pop_size):
        mean = x_best
        cov = np.eye(dim)
        for _ in range(pop_size):
            sigma = 1.0
            while True:
                try:
                    x = mean + sigma * rng.multivariate_normal(np.zeros(dim), cov)
                    if lb <= x <= ub: break
                    else: continue
                except Exception as e:
                    print(e)
            f = func(x)
            if f < f_best:
                f_best = f
                x_best = x
            cov = (pop_size - 1) / pop_size * cov + sigma ** 2 * np.outer(rng.multivariate_normal(np.zeros(dim), np.eye(dim)).T, rng.multivariate_normal(np.zeros(dim), np.eye(dim)))
            sigma *= 0.95
    return x_best
