def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def fitness(x):
        return func(x)

    x = rng.uniform(lb, ub, size=(dim,))
    y = x.copy()

    for _ in range(budget):
        for i in range(dim):
            r1, r2 = rng.uniform(0, 1, size=(2,)), rng.randint(0, dim)
            u = y.copy()
            v = y.copy()
            u[r1] += rng.uniform(-1, 1) * (ub - lb)
            v[r2] += rng.uniform(-1, 1) * (ub - lb)

            u = clip(u, lb, ub)
            v = clip(v, lb, ub)

            f1, f2 = fitness(x), fitness(u)
            f3, f4 = fitness(y), fitness(v)

            if f1 < f2 and f1 < f3:
                y[i] = x[i]
                x[i] = u[i]

            elif f3 < f1 and f3 < f2:
                y[r2] = x[r2]
                x[r2] = v[r2]

            else:
                alpha = rng.uniform(0, 1)
                x[i] = alpha * u[i] + (1 - alpha) * v[i]
                y[i] = alpha * clip(y[i] + rng.uniform(-1, 1) * (ub - lb), lb, ub)

        if rng.uniform(0, 1) < 0.2:
            idx = rng.randint(0, dim)
            x[idx] += rng.uniform(-1, 1) * (ub - lb)
            y[idx] += rng.uniform(-1, 1) * (ub - lb)

    return clip(x, lb, ub)
