def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    best_func_value = func(clip(x_best))

    for _ in range(budget):
        x_perturb = x_best + 0.1 * (ub - lb) * rng.normal(size=dim)
        x_new = clip(x_perturb)

        prob_explore = min(1, np.exp(-best_func_value))
        if rng.uniform(0, 1) < prob_explore:
            x_new = rng.uniform(lb, ub, size=dim)

        new_func_value = func(clip(x_new))

        if new_func_value < best_func_value:
            x_best = x_new
            best_func_value = new_func_value

    return clip(x_best)
