def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = x + 0.1 * (rng.uniform(-1, 1, size=dim) - 0.5)
        y = clip(y)
        f_y = func(y)

        if f_y < best_f:
            best_x = y.copy()
            best_f = f_y

        v1 = rng.choice(dim)
        v2 = (v1 + 1) % dim
        z = x.copy()
        z[v1], z[v2] = z[v2], z[v1]
        z = clip(z)
        f_z = func(z)

        if f_z < best_f:
            best_x = z.copy()
            best_f = f_z

    return best_x
