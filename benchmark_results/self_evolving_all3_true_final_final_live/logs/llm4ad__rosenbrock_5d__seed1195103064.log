def algorithm(func, dim, lb, ub, budget, rng):
    def lip_bound(x, step=1e-3):
        x_plus = np.copy(x)
        x_minus = np.copy(x)

        for i in range(dim):
            x_plus[i] += step
            x_minus[i] -= step

        return max(np.abs(func(x_plus) - func(x)) / step for x in [x_plus, x_minus])

    def probe(x, bound):
        if rng.random() < 0.1:
            x_try = np.copy(x)
            try_x = np.copy(x)

            # Try shrinking the bounds
            for i in range(dim):
                x_try[i] = (lb + ub) / 2
                try_x[i] = lb

            return min(lip_bound(x_try, step=1e-6), lip_bound(try_x))

        else:
            return lip_bound(x)

    x = rng.uniform(lb, ub, size=(dim,))
    best_x = np.copy(x)
    best_f = func(x)

    for _ in range(budget):
        bound = probe(x, 5.0)
        new_x = rng.uniform(lb - bound, lb + bound, size=(dim,))
        new_x = np.clip(new_x, lb, ub)

        if func(new_x) < best_f:
            best_f = func(new_x)
            best_x = np.copy(new_x)

        x = new_x

    return best_x
