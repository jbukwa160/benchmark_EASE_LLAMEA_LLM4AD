def algorithm(func, dim, lb, ub, budget, rng):
    def surrogate_model(x, y):
        K = np.zeros((len(y), len(y)))
        for i in range(len(y)):
            for j in range(i+1, len(y)):
                sigma2 = (y[i] - y[j])**2 + 10
                K[i, j] = K[j, i] = np.exp(-np.sqrt(sigma2))
        mean = np.zeros((len(y), dim))
        for i in range(len(y)):
            mean[i] = y[i]
        return K, mean

    def acquisition_function(x):
        mu, _ = surrogate_model(x)
        sigma2 = 10
        return -mu + rng.normal(0, np.sqrt(sigma2))

    x_best = None
    f_best = float('inf')
    for i in range(budget):
        x = rng.uniform(lb, ub, (1, dim))
        while True:
            x_candidate = x.copy()
            for j in range(dim):
                if rng.random() < 0.2:
                    x_candidate[0, j] = np.clip(rng.normal(x[0, j], 0.5), lb, ub)
            K, mean = surrogate_model(x_candidate, [])
            mu = mean[0]
            f_candidate = func(mu)
            if f_candidate < acquisition_function(x_candidate):
                break
        x = x_candidate
        f_value = func(x)
        if f_value < f_best:
            x_best = x
            f_best = f_value
    return x_best
