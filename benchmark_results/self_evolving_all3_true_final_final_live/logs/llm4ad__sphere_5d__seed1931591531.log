def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(-5.0, 5.0, size=dim)
    x = clip(x)

    for _ in range(budget):
        y = rng.normal(size=dim) + x
        y = clip(y)

        if func(y) < func(x):
            x = y

    return x
