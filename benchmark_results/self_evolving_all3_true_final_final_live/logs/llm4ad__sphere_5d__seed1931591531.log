def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.zeros(dim)
    temperature = 1.0
    best_candidate = clip(x.copy())
    best_fitness = func(best_candidate)

    for _ in range(budget):
        step_size = 0.1
        new_x = clip(best_candidate + rng.uniform(-step_size, step_size, size=dim))
        new_fitness = func(new_x)
        
        if new_fitness < best_fitness:
            best_candidate = new_x.copy()
            best_fitness = new_fitness
        
        delta = new_fitness - best_fitness
        if delta < 0 or np.random.rand() < np.exp(-delta / temperature):
            best_candidate = new_x.copy()

        temperature *= 0.999

    return best_candidate
