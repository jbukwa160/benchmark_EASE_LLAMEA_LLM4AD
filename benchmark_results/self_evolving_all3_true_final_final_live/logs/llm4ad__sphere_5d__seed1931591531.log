def algorithm(func, dim, lb, ub, budget, rng):
    n = len(rng)
    mu = np.zeros(dim)
    sigma = 1
    D = np.eye(dim) * (ub - lb)**2
    x_mean = np.zeros((budget + 1, dim))
    x_sigma = np.zeros((budget + 1, dim, dim))
    y = np.zeros(budget + 1)

    for i in range(budget):
        z = rng.normal(mu, sigma)
        z = lb + (ub - lb) * z
        x_mean[i + 1] = mu.copy()
        x_sigma[i + 1] = D.copy()

        for j in range(n):
            if rng.rand() < 0.5:
                z[j] += np.random.normal(0, sigma / 2)

        y[i + 1] = func(z)
        
        x_mean[i + 1] += (z - mu) / (i + 2)**(1/len(rng))
        D += np.outer((z - mu), (z - mu)) / ((i + 2)**(1+len(rng)/(len(rng)+2)))
        sigma = np.sqrt(np.trace(D))

    best_x = mu
    best_f = func(best_x)
    
    for i in range(budget):
        if y[i + 1] < best_f:
            best_f = y[i + 1]
            best_x = x_mean[i + 1, :]

    return best_x
