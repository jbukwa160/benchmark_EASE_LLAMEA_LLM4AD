def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    for _ in range(budget):
        grad = func.gradient(x)
        step_size = 0.1
        x += step_size * grad
        x = np.clip(x, lb, ub)
        if func(x) < func(best_x):
            best_x = x.copy()
    return best_x
