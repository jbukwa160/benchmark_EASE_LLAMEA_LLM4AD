def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    def sample(rng, lb, ub):
        return rng.uniform(lb, ub, size=(dim,))

    population = [sample(rng, lb, ub) for _ in range(budget)]
    best_x = min(population, key=lambda x: func(x))
    best_f = func(best_x)

    for generation in range(1, budget):
        weights = np.array([func(clip(x)) for x in population])
        importance = rng.dirichlet(weights)
        new_population = []
        for _ in range(budget // 2):
            parent_idx = np.random.choice(range(len(population)), p=importance)
            child_idx = np.random.choice(range(len(population)))
            child_x = (population[parent_idx] + population[child_idx]) / 2.0
            new_population.append(clip(child_x))
        population = new_population

        best_f_new = min([func(clip(x)) for x in population])
        if best_f_new < best_f:
            best_x, best_f = clip(min(population, key=lambda x: func(x))), best_f_new

    return best_x
