def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        # Generate a new candidate by perturbing the current best solution
        delta = 0.1 * (ub - lb) * rng.normal(size=dim)
        x_new = x_best + delta

        # Clip the candidate to the bounds
        x_new = np.clip(x_new, lb, ub)

        # Evaluate the new candidate
        f_new = func(x_new)

        # Update the best solution if a better one is found
        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
