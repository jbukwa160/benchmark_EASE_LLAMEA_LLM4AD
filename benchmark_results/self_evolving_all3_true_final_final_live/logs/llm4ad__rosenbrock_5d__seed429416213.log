def algorithm(func, dim, lb, ub, budget, rng):
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)
    sigma = 0.1
    step_size = 1e-2
    cov = np.eye(dim)

    for i in range(budget):
        x_new = x_best + sigma * rng.randn(dim)
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        
        if f_new < f_best:
            x_best = x_new
            f_best = f_new
        
        # SA
        delta = f_new - f_best
        T = 1 / (i + 1) ** 0.5
        accept_prob = np.exp(-delta / T)
        
        if rng.rand() < accept_prob:
            x_best = x_new
            f_best = f_new
        
        # CMA-ES
        cov = 0.5 * cov + 0.01 * (x_new - x_best)[:, None] @ (x_new - x_best)[None, :]
        
    return x_best
