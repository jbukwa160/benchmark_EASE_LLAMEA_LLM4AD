def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    temp = 1.0
    step_size = 1.0

    for i in range(budget):
        new_x = x + rng.normal(0, step_size, size=dim)
        new_x = clip(new_x, lb, ub)

        delta = func(new_x) - func(x)
        if delta < 0 or (delta >= 0 and np.random.rand() < np.exp(-delta / temp)):
            x = new_x
            if func(x) < func(best_x):
                best_x = x

        # Update temperature and step size
        temp *= 0.99
        step_size *= 0.9

    return best_x
