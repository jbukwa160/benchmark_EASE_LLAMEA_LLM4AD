def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = (np.random.rand(dim) * 2 - 1) * ub + lb
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(budget):
        d = np.zeros(dim)
        for j in range(dim):
            if rng.uniform(0, 1) < 0.5:
                d[j] = rng.uniform(-ub, ub)
            else:
                d[j] = rng.uniform(lb - best_x[j], ub - best_x[j])
        
        x_perturbed = clip(x + d)
        f_perturbed = func(x_perturbed)
        
        if f_perturbed < best_f:
            best_x = x_perturbed.copy()
            best_f = f_perturbed
    
    return best_x
