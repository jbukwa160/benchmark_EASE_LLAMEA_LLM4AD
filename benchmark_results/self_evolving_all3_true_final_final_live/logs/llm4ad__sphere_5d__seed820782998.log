def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 1e2
    alpha = 0.99
    for _ in range(budget):
        y = x + np.random.uniform(-T, T, size=dim) / (1 + func(x))
        y = np.clip(y, lb, ub)
        T *= alpha
        if func(y) < func(x):
            x = y
        elif np.random.rand() < np.exp((func(x) - func(y)) / T):
            x = y
    return x
