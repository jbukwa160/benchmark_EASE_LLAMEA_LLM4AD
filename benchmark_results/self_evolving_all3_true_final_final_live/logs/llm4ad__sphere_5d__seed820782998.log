def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(budget):
        N = max(10, int((budget - i) ** 0.5 * (ub - lb)))
        if i < budget // 2:
            new_samples = rng.uniform(lb, ub, size=(N, dim))
        else:
            x_new = np.zeros((N, dim))
            for j in range(N):
                while True:
                    x_t = rng.uniform(lb, ub, size=dim)
                    if all(np.abs(x_t - best_x) < 1e-6):
                        continue
                    x_new[j] = x_t
                    break
            new_samples = x_new
        
        f_values = func(new_samples)
        idx = np.argmin(f_values)
        x[idx] = new_samples[idx]
        
        if f_values[idx] < best_f:
            best_x = x.copy()
            best_f = f_values[idx]
    
    return best_x
