def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(parents, bounds):
        children = []
        for _ in range(len(parents)):
            x1, x2, x3 = np.random.choice(range(dim), 3, replace=False)
            child = parents.copy()
            child[x1] += rng.uniform(-1, 1) * (ub - lb)
            child[x2] += rng.uniform(-1, 1) * (ub - lb)
            child[x3] += rng.uniform(-1, 1) * (ub - lb)
            children.append(child)
        return np.array(children)

    def crossover(parents, children):
        offspring = []
        for parent, child in zip(parents, children):
            x = np.where(np.random.rand(dim) < 0.5, parent, child)
            offspring.append(x)
        return np.array(offspring)

    lb = np.full((dim,), lb)
    ub = np.full((dim,), ub)
    best = None
    for _ in range(budget):
        parents = rng.uniform(lb, ub, size=(10, dim))
        for i in range(1, 100):
            children = mutate(parents, bounds=ub - lb)
            children = crossover(parents, children)
            parents = np.concatenate((parents, children), axis=0)
        parents = parents / (ub - lb) * func.range
        best_candidate = min(parents, key=lambda x: func(x))
        if best is None or func(best_candidate) < func(best):
            best = best_candidate
    return best
