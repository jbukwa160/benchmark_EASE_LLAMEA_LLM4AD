def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Local move: Gaussian perturbation
        dx = 0.1 * rng.randn(dim)
        local_x = x + dx
        local_x = np.clip(local_x, lb, ub)
        local_f = func(local_x)

        if local_f < best_f:
            x = local_x
            best_x = x.copy()
            best_f = local_f

        # Global move: Random restart
        if rng.rand() < 0.1:
            global_x = lb + (ub - lb) * rng.rand(dim)
            global_f = func(global_x)

            if global_f < best_f:
                x = global_x
                best_x = x.copy()
                best_f = global_f

    return best_x
