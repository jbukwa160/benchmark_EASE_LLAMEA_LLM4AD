def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(population):
        idx = rng.choice(dim, size=(len(population), dim))
        candidate = population + 0.7 * (population[idx] - population)
        return candidate.clip(lb, ub)

    def selection(population, candidates):
        fitness = func(candidates)
        mask = np.argsort(fitness)[:len(population)]
        return candidates[mask], fitness[mask]

    population = rng.uniform(lb, ub, size=(budget, dim))
    best = func(population[0])
    for i in range(1, budget):
        candidate = mutate(population)
        candidates, _ = selection(candidate, np.concatenate((population, candidate), axis=0))
        population[i] = candidates[-i]
        if best > candidates[-i]:
            best = candidates[-i]

    return np.argmin(func(np.array([population[i] for i in range(budget)])))
