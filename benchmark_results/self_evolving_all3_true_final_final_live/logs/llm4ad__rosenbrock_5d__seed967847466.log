    pop_size = 100
    population = np.random.rand(pop_size, dim) * (ub - lb) + lb
    
    for _ in range(budget):
        # Evaluate fitness of each solution in the population
        fitnesses = func(clip(population))
        
        # Select the best solution so far
        idx_best = np.argmin(fitnesses)
        if fitnesses[idx_best] < best_fitness:
            best_solution = clip(population[idx_best])
            best_fitness = fitnesses[idx_best]
        
        # Perform Differential Evolution (DE) steps
        for i in range(pop_size):
            r1, r2, r3 = rng.choice(pop_size, 3, replace=False)
            mutant = population[r1] + rng.uniform(-0.5, 0.5) * (population[r2] - population[r3])
            trial = clip(mutant)
            
