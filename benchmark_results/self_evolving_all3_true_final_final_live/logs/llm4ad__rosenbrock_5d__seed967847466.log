def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    pop = np.random.uniform(lb, ub, (pop_size, dim))
    
    # Evolve the population using DE's "rand1exp" strategy
    bounds = [(lb[i], ub[i]) for i in range(dim)]
    res = differential_evolution(func, bounds, args=(dim,), x0=np.mean(pop, axis=0), maxiter=budget)
    
    # Clip candidates to [lb, ub] and return the best one
    clipped_res = np.clip(res.x, lb, ub)
    return clipped_res
