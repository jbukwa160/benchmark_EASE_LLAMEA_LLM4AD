def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best = np.random.uniform(lb, ub, size=dim)
    best_fitness = func(best)

    for _ in range(budget):
        candidate = np.random.uniform(lb, ub, size=dim)
        new_fitness = func(clip(candidate))

        if new_fitness < best_fitness:
            best = clip(candidate)
            best_fitness = new_fitness

        # Local refinement: perform a grid search around the current best
        for i in range(dim):
            step_size = 0.1 * (ub - lb) / rng.rand()
            candidate[i] = best[i] + step_size * rng.choice([-1, 1])

            if clip(candidate)[i] >= lb and clip(candidate)[i] <= ub:
                new_fitness = func(clip(candidate))

                if new_fitness < best_fitness:
                    best = clip(candidate)
                    best_fitness = new_fitness

    return best
