def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    pop_size = 50
    x0 = (ub - lb) * rng.rand(pop_size, dim) + lb

    for _ in range(budget):
        f1, x1 = min(zip(map(evaluate, x0), x0), key=lambda pair: pair[0])
        f2, x2 = min(np.random.choice(x0.shape[0], 3, replace=False), key=lambda i: evaluate(x0[i]), 
                     key=lambda i: (evaluate(x0[i]) - f1) / max(evaluate(x0[i]), 1e-6))

        v = x1 + rng.uniform(-1, 1) * (x2 - x1)

        for i in range(pop_size):
            if evaluate(v) < evaluate(x0[i]):
                x0[i] = v

    f3, best_x = min(zip(map(evaluate, x0), x0), key=lambda pair: pair[0])

    return np.clip(best_x, lb, ub)
