def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best = None
    worst = None
    candidates = np.random.uniform(lb, ub, (budget, dim))

    for i in range(budget):
        f_values = func(candidates)
        idx = np.argmin(f_values)
        x_best = clip(candidates[idx])

        if best is None or f_values[idx] < func(best):
            best = candidates[idx]
        
        if worst is None or f_values[idx] > func(worst):
            worst = candidates[idx]

        if i % (budget // 10) == 0:
            candidates = np.concatenate((x_best[None, :], clip(np.random.uniform(lb, ub, (budget - 1, dim)))), axis=0)

    return best
