def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.array([lb + (ub - lb) * rng.rand(dim)])
    f_best = func(x_best)
    
    for i in range(1, budget):
        population = np.zeros((100, dim))
        
        for j in range(dim):
            tmp = x_best.copy()
            
            for k in range(100):
                idx1, idx2, idx3 = rng.randint(0, 99, size=3)
                
                if k == idx1 or k == idx2 or k == idx3:
                    population[k, j] = tmp[j]
                else:
                    v = lb + (ub - lb) * rng.rand()
                    population[k, j] = v
                    
        f_population = np.zeros(100)
        
        for j in range(100):
            x_new = population[j]
            
            f_new = func(x_new)
            f_population[j] = f_new
            
            if f_new < f_best:
                x_best = x_new
                f_best = f_new
                
        # Clip candidates to [lb, ub]
        x_best[0, :] = np.clip(x_best[0, :], lb, ub)
        
    return x_best
