def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    # Initialize parameters
    pop_size = 50
    max_iter = int(budget / (dim * pop_size))
    F = 0.5  # mutation factor
    CR = 0.9  # crossover rate

    # Initialize population
    x = rng.uniform(lb, ub, (pop_size, dim))

    for _ in range(max_iter):
        v = np.copy(x)
        for i in range(pop_size):
            idx1, idx2, idx3 = np.random.choice(range(pop_size), 3, replace=False)
            if idx1 != i:
                v[i] += F * (x[idx1] - x[idx3])
            v[i] = np.clip(v[i], lb, ub)

        for i in range(pop_size):
            u = v[i]
            for j in range(dim):
                r = rng.uniform(0, 1)
                if r < CR or j == rng.randint(0, dim - 1):
                    u[j] = x[i, j] + rng.uniform(-1, 1) * (v[i, j] - x[i, j])
            u = np.clip(u, lb, ub)

        x = v.copy()

    best_x = x[np.argmin([f(x_i) for x_i in x])]
    return best_x
