def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(clip(x_best))

    for i in range(budget):
        x_random = np.random.uniform(lb, ub, size=dim)
        x_simplex = clip(np.array([x_best] + [np.array(x_random) + 0.1 * rng.randn(dim)] * (dim - 1)))
        
        f_simplex = func(x_simplex)

        if f_simplex < f_best:
            x_best = x_simplex
            f_best = f_simplex

        x_simplex = np.sort(x_simplex)
        y_simplex = np.array([func(clip(np.mean(x_simplex[:i] + x_simplex[i+1:]))) for i in range(dim)])

        if np.min(y_simplex) < f_best:
            index = np.argmin(y_simplex)
            x_best = clip(np.mean(x_simplex[:index] + x_simplex[index+1:], axis=0))
            f_best = func(x_best)

    return x_best
