def algorithm(func, dim, lb, ub, budget, rng):
    def wrap_func(x):
        return func(np.clip(x, lb, ub))

    bounds = [(lb, ub) for _ in range(dim)]
    
    # Differential Evolution
    de_result = differential_evolution(wrap_func, bounds, maxiter=budget // 2)
    
    # L-BFGS-B local search
    x0 = np.random.uniform(lb, ub, dim)
    result = minimize(wrap_func, x0, method="L-BFGS-B", bounds=bounds)
    
    if result.fun < de_result.fun:
        return result.x
    else:
        return de_result.x
