def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(dim, pop_size):
        return rng.uniform(lb, ub, (pop_size, dim))

    def differential_evolution(population, func, dim, lb, ub, budgets_left):
        if budgets_left == 0:
            return None
        best = np.min(np.sum((population[:, :, np.newaxis] - population[:, np.newaxis, :]) ** 2, axis=1) * rng.uniform(0.5, 1.5, size=(pop_size, dim)), axis=0)
        x_new = population[np.argmin(best)]
        x_new = clip(x_new, lb, ub)
        budgets_left -= 1
        return func(x_new), (x_new, budgets_left)

    def gradient_free_search(population, func, dim, lb, ub, budget):
        pop_size = len(population)
        best = np.min(func(population))
        for _ in range(budget):
            idx = rng.choice(pop_size, size=10, replace=False)
            x_new = population[idx].mean(axis=0)
            x_new = clip(x_new, lb, ub)
            new_best = func(x_new)
            if new_best < best:
                best = new_best
        return best

    population = generate_initial_population(dim, 50)
    best_x, budgets_left = differential_evolution(population, func, dim, lb, ub, budget)

    while budgets_left > 0:
        best_x, budgets_left = differential_evolution(best_x[np.newaxis], func, dim, lb, ub, budgets_left)

    return best_x
