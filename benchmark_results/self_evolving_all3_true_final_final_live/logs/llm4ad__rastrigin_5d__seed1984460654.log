def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population():
        population = rng.uniform(-5, 5, (budget, dim))
        return [clip(x) for x in population]

    def evaluate(population):
        return [func(x) for x in population]

    def adapt_step_size(step_size, evaluations, best_candidate, best_fitness):
        sigma = step_size
        if evaluations % 10 == 0 and np.std([func(clip(x)) for x in population]) > 1e-3:
            sigma *= 2.4
        elif evaluations % 20 == 0 and np.std([func(clip(x)) for x in population]) < 1e-5:
            sigma /= 2.4
        return min(max(sigma, 1e-10), 100)

    def restart(population):
        new_population = rng.uniform(-5, 5, (budget, dim))
        return [clip(x) for x in new_population]

    population = generate_initial_population()
    evaluations = 0

    while evaluations < budget:
        fitnesses = evaluate(population)
        best_candidate_index = np.argmin(fitnesses)
        best_candidate = population[best_candidate_index]
        best_fitness = fitnesses[best_candidate_index]

        if best_fitness > 1e-3:
            new_population = [clip(x + rng.normal(0, step_size)) for x in population]
        else:
            step_size = adapt_step_size(step_size, evaluations, best_candidate, best_fitness)
            new_population = population

        if np.std([func(clip(x)) for x in population]) < 1e-5 or np.random.rand() < 0.01:
            return best_candidate
        elif evaluations > budget // 2 and len(set([tuple(x) for x in population])) == len(population):
            new_population = restart(population)
        else:
            pass

        population = new_population
        evaluations += len(new_population)

    return best_candidate
