def algorithm(func, dim, lb, ub, budget, rng):
    def sample(lb, ub):
        return rng.uniform(lb, ub, size=dim)

    def kernel(x1, x2, theta):
        sqdist = np.sum((x1 - x2)**2)
        distsq = sqdist / (2 * theta**2)
        if distsq < 0.5:
            return 1 + distsq * norm.cdf(distsq) / norm.pdf(distsq)
        else:
            return np.exp(-distsq)

    def kdtree_nn(x, X, y, tree):
        dist, idx = tree.query(x)
        return dist, idx

    def log_likelihood(params, x, y):
        theta = params[0]
        alpha = params[1]
        beta = params[2]

        kernel_values = np.zeros((len(x), len(y)))
        for i in range(len(x)):
            for j in range(len(y)):
                kernel_values[i, j] = kernel(x[i], y[j], theta)

        L = np.linalg.cholesky(alpha * np.eye(len(y)) + beta * np.dot(y[:, None], y[None, :]))
        f = np.dot(L, y)
        return -0.5 * len(y) * np.log(2 * np.pi) - 0.5 * np.sum(np.log(np.diag(L**2))) - 0.5 * np.sum(kernel_values)

    def predict(params, x):
        theta = params[0]
        alpha = params[1]
        beta = params[2]

        kernel_values = np.zeros(len(x))
        for i in range(len(x)):
            kernel_values[i] = kernel(x[i], 0, theta)

        L = np.linalg.cholesky(alpha * np.eye(len(x)) + beta * np.dot(np.dot(x[:, None], x[None, :]), kernel_values[:, None]))
        f = np.dot(L, np.sqrt(kernel_values))
        return -f

    X = []
    y = []
    tree = None
    best_x = sample(lb, ub)
    best_y = func(best_x)

    for t in range(budget):
        # Sample new points
        x_new = sample(lb, ub)
        while np.any(np.abs(x_new - best_x) < 1e-3):
            x_new = sample(lb, ub)

        # Evaluate the function at the new point
        y_new = func(x_new)

        # Update the dataset and the k-d tree
        X.append(x_new)
        y.append(y_new)
        if len(X) > 100:
            X.pop(0)
            y.pop(0)
        if tree is None or len(X) < 10:
            tree = rng.choice(X, size=10)

        # Update the best point found so far
        if y[-1] < best_y:
            best_x = x_new
            best_y = y[-1]

        # Perform Bayesian optimization
        params_init = np.array([0.5, 1e-3, 1e-6])
        params = params_init
        for _ in range(10):
            dist, idx = kdtree_nn(params[:2], X, tree=tree)
            ll = log_likelihood(params, x=np.array(X[idx]), y=np.array(y[idx]))
            predict_val = predict(params, np.array(x_new))
            if ll + predict_val < -1e6:
                params += rng.normal(0, 1e-3, size=3)

        # Refine the parameters using gradient descent
        for _ in range(10):
            dist, idx = kdtree_nn(params[:2], X, tree=tree)
            ll = log_likelihood(params, x=np.array(X[idx]), y=np.array(y[idx]))
            predict_val = predict(params, np.array(x_new))
            grad_ll = (ll + predict_val) * rng.normal(0, 1e-3, size=3)
            params -= 0.01 * grad_ll

    return best_x
