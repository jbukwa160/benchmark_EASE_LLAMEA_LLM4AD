def algorithm(func, dim, lb, ub, budget, rng):
    n = int(np.sqrt(budget))
    x_best = -np.ones(dim)
    f_best = 1e10
    mu = 0.01 * (ub - lb)
    
    for _ in range(n):
        x_new = np.clip(rng.normal(loc=0, scale=mu, size=(dim)), a_min=lb, a_max=ub)
        
        f_new = func(x_new)
        if f_new < f_best:
            x_best = x_new
            f_best = f_new
            
        mu *= 1.1
        
    return x_best
