    x = rng.uniform(lb, ub, size=(dim,))
    T = 1.0
    alpha = 0.99
    beta = 0.01
    n_iter_local_search = 1000 // (2 * dim)

    for _ in range(budget):
        y = x + rng.normal(size=x.shape)
        y = np.clip(y, lb, ub)

        delta_f = func(y) - func(x)
        if delta_f < 0:
            x = y
        else:
            if rng.uniform(0, 1) < np.exp(-delta_f / (T * 1e-2)):
                x = y
            else:
                T *= alpha

    for _ in range(n_iter_local_search):
        res = nelder_mead(func, x, lb, ub)
        if func(res) < func(x):
            x = res

    return x
