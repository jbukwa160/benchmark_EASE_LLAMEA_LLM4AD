def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    # Initialize particles with random positions and velocities
    pop_size = 100
    positions = rng.uniform(lb, ub, (pop_size, dim))
    velocities = rng.uniform(-1, 1, (pop_size, dim))

    # Objective function evaluation
    fitnesses = np.array([func(clip(position)) for position in positions])

    # Differential Evolution phase
    for _ in range(budget // 2):
        for i in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size, size=3)
            if rng.uniform() < 0.5:
                velocities[i] += rng.uniform(-1, 1) * (positions[r1] - positions[i])
            else:
                velocities[i] += rng.uniform(-1, 1) * (positions[r2] + positions[r3]) / 2 - positions[i]
            positions[i] += velocities[i]

    # Particle Swarm Optimization phase
    for _ in range(budget // 2):
        for i in range(pop_size):
            r1 = rng.randint(0, pop_size)
            if rng.uniform() < 0.5:
                velocities[i] = 0.729 * velocities[i] + 1.49618 * (positions[r1] - positions[i]) / np.linalg.norm(positions[r1] - positions[i])
            else:
                velocities[i] = 0.729 * velocities[i] + 1.49618 * (np.mean(positions, axis=0) - positions[i]) / np.linalg.norm(np.mean(positions, axis=0) - positions[i])
        positions += velocities
        fitnesses = np.array([func(clip(position)) for position in positions])

    best_position = positions[np.argmin(fitnesses)]
    return best_position
