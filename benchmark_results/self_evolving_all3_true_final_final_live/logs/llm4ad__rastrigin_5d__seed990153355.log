def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 0.5 * (ub - lb)
    mu = rng.uniform(lb, ub, size=dim)
    D = np.eye(dim)
    
    for _ in range(budget):
        y = func(mu) + 1e-6
        lambda_ = 10
        
        while True:
            Z = rng.normal(size=(lambda_, dim))
            X = mu + sigma * Z @ D
            
            fX = np.array([func(np.clip(x, lb, ub)) for x in X])
            
            if np.min(fX) < y:
                y = np.min(fX)
                mu = X[np.argmin(fX)]
                
                # update covariance matrix
                sigma_ = 0.5 * (sigma + 1 / rng.uniform(1, 100))
                D = (1 - 1 / lambda_) * D + 1 / lambda_ * np.outer(Z, Z) @ D
                
            else:
                if rng.random() < 0.5:
                    sigma *= 2
                else:
                    sigma /= 2
                    
    return mu
