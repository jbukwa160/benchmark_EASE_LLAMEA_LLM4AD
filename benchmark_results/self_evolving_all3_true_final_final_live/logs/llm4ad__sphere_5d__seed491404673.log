def algorithm(func, dim, lb, ub, budget, rng):
    best = None
    min_f = float('inf')
    
    for _ in range(budget):
        x = np.random.uniform(lb, ub, size=dim)
        
        while True:
            f = func(x)
            
            if f < min_f:
                min_f = f
                best = x
                
            new_x = np.clip(x + rng * (x - lb), lb, ub)
            
            if not np.all(new_x == x):
                f_new = func(new_x)
                
                if f_new < f:
                    x = new_x
                    
        best = np.clip(best, lb, ub)
        
    return best
