def algorithm(func, dim, lb, ub, budget, rng):
    candidates = np.random.uniform(lb, ub, (budget, dim))
    for i in range(budget - 1):
        scores = func(candidates[i, :])
        best_idx = np.argmin(scores)
        if scores[best_idx] < func(candidates[-1, :]):
            candidates[-1, :] = candidates[best_idx, :]
    return candidates[np.argmin(func(candidates)), :]
