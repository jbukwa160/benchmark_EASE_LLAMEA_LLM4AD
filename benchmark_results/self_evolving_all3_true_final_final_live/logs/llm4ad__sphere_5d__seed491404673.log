def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        g = np.zeros(dim)
        for i in range(dim):
            e = np.array([x[j] if j != i else 1e-8 for j in range(dim)])
            gi = (func(x + e) - best_f) / e[i]
            g[i] = gi
        alpha = 0.01 * rng.exponential(1)
        x -= alpha * g

        x = np.clip(x, lb, ub)

        if func(x) < best_f:
            best_x = x.copy()
            best_f = func(x)

    return best_x
