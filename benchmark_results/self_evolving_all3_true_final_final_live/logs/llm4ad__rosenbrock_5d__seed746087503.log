def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(n, bounds):
        x = np.random.uniform(bounds[0], bounds[1], (n, dim))
        return x

    def evaluate(x):
        return func(x)

    def mutate(x, sigma):
        noise = rng.normal(0, 1, x.shape)
        return clip(x + sigma * noise)

    def gradient_step(x, step_size):
        grad = np.zeros_like(x)
        for i in range(dim - 1):
            grad[i] += 2 * 100 * (x[i+1] - x[i]**2) * 2 * (x[i+1] - x[i]**2)
            grad[i+1] -= 2 * 100 * (x[i+1] - x[i]**2)
        grad = clip(grad + rng.normal(0, 1e-6, grad.shape))
        return x - step_size * grad

    n = 20
    population = generate_initial_population(n, [lb, ub])
    best_x = population[0]
    best_f = evaluate(best_x)

    for _ in range(budget):
        # Simulated Annealing
        sigma = np.exp(-0.01)
        new_pop = []
        for x in population:
            new_x1 = mutate(x, sigma)
            new_x2 = mutate(x, -sigma)
            new_f1 = evaluate(new_x1)
            new_f2 = evaluate(new_x2)
            if (new_f1 < best_f) or (np.random.rand() < np.exp(-(new_f1 - best_f) / 0.01)):
                new_pop.append(new_x1)
            else:
                new_pop.append(x)

        # Gradient-based optimization
        for i in range(n):
            x = population[i]
            grad_step = gradient_step(x, 0.05)
            if evaluate(grad_step) < best_f:
                best_f = evaluate(grad_step)
                best_x = grad_step

        population = new_pop

    return best_x
