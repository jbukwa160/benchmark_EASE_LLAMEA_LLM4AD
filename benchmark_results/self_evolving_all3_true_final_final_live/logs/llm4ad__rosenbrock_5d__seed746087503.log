def algorithm(func, dim, lb, ub, budget, rng):
    def clipped_candidate(x):
        return np.clip(x, lb, ub)

    def evaluate(candidate):
        if not np.all(np.isfinite(candidate)):
            return 1e10
        return func(candidate)

    def mutation(population, weights, c1, c2):
        mutated_population = population + weights * (c1 * rng.normal(size=dim) +
                                                     c2 * rng.normal(size=dim))
        return clipped_candidate(mutated_population)

    def crossover(parent, child):
        index = np.random.choice(dim)
        child[index] = parent[index]
        return child

    num_candidates = 50
    population_size = 1000
    initial_temperature = budget / np.log(num_candidates)
    cooling_rate = 0.99

    population = rng.uniform(lb, ub, size=(population_size, dim))
    current_best = np.inf

    for generation in range(budget):
        weights = rng.uniform(0.5, 1.5, size=dim)
        mutated_population = mutation(population, weights, 0.9, 0.1)

        candidates = mutated_population.copy()
        for i in range(num_candidates - 1):
            candidate = crossover(mutated_population[i], mutated_population[i + 1])
            candidates = np.vstack((candidates, clipped_candidate(candidate)))

        probabilities = np.exp(-(evaluate(candidates) - evaluate(population)) / initial_temperature)
        probabilities /= np.sum(probabilities)

        population = rng.choice(num_candidates, size=population_size, p=probabilities)
        current_best = min(current_best, evaluate(population))

    best_candidate = clipped_candidate(population[np.argmin(np.array([evaluate(x) for x in population]))])
    return best_candidate
