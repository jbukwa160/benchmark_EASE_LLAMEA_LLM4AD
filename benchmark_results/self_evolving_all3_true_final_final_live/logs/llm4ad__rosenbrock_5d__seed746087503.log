    best_solution = result.x
    best_fitness = result.fun

    population_size = 50
    temperature = 1.0
    cooling_rate = 0.99
    iteration = 0

    while iteration < budget:
        iteration += 1
        candidates = np.random.uniform(lb, ub, (population_size, dim))
        fitnesses = [func(candidate) for candidate in candidates]

        mean_fitness = np.mean(fitnesses)
        std_fitness = np.std(fitnesses)

        accepted_solutions = []
        for i in range(population_size):
            if func(candidates[i]) < best_fitness:
                best_solution = candidates[i]
                best_fitness = func(candidates[i])
            elif rng.uniform(0, 1) < np.exp((best_fitness - fitnesses[i]) / temperature):
                accepted_solutions.append(candidates[i])

        if len(accepted_solutions) > population_size // 2:
            candidates = accepted_solutions
            fitnesses = [func(candidate) for candidate in candidates]

        temperature *= cooling_rate

    clipped_solution = np.clip(best_solution, lb, ub)
