def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    sigma = 5.0
    best_x = None
    best_fval = np.inf
    
    for _ in range(budget):
        X = rng.uniform(lb, ub, (pop_size, dim))
        
        F = func(X)
        idx = np.argsort(F)[:int(pop_size/2)]
        X = X[idx]
        
        for i in range(pop_size//2):
            x_mut = X[i] + sigma * rng.normal(size=dim)
            fval = func(x_mut)
            
            if fval < F[i]:
                X[i] = x_mut
                F[i] = fval
        
        idx = np.argsort(F)[:1]
        best_x = X[idx]
        best_fval = F[idx]
        
        if best_fval <= 0.01:
            break
    
    return best_x
