def algorithm(func, dim, lb, ub, budget, rng):
    def fitness(x):
        return func(x)

    x = np.zeros(dim)
    for _ in range(budget):
        y = np.copy(x)
        z = np.copy(y)
        for i in range(dim):
            if rng.random() < 0.5:
                z[i] += rng.uniform(-1, 1) * (ub - lb)
            else:
                y[i] -= x[i]
                y[i] *= rng.uniform(0.8, 1.2)
                y[i] += x[i]

        if fitness(z) < fitness(y):
            x = z
        else:
            x = y

    return np.clip(x, lb, ub)
