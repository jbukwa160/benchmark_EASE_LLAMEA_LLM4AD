def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 10 * (ub - lb)
    t = 0
    best_x = x.copy()
    best_f = func(x)

    while t < budget:
        new_x = np.clip(rng.normal(size=dim), a_min=lb, a_max=ub)
        delta_f = func(new_x) - best_f

        if delta_f <= 0 or rng.uniform(0, 1) < np.exp(-delta_f / T):
            x = new_x.copy()
            if func(x) < best_f:
                best_x = x.copy()
                best_f = func(x)

        T *= 0.99
        t += 1

    return best_x
