def algorithm(func, dim, lb, ub, budget, rng):
    def clipped(candidate):
        return np.clip(candidate, lb, ub)

    population = rng.uniform(lb, ub, size=(budget, dim))
    for _ in range(budget - 1):
        z = population[rng.randint(0, budget)]
        v = clipped(population[rng.randint(0, budget)] + rng.uniform(-1, 1) * (ub - lb))
        u = clipped(z + rng.uniform(-1, 1) * (ub - lb))
        w = np.where(rng.uniform(size=dim) < 0.5, v, z)
        x_new = clipped(0.5 * w + 0.5 * u)
        fitness = func(x_new)
        if fitness < func(clipped(z)):
            population[rng.randint(0, budget)] = x_new
    return np.argmin(func(population), axis=0) * (ub - lb) + lb
