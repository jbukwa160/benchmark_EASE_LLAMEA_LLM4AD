def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    pop_size = 20
    F = 0.8
    CR = 0.5
    t = 1
    pop = np.random.uniform(lb, ub, (pop_size, n))
    
    while t < budget:
        for i in range(pop_size):
            target = np.copy(pop[i])
            
            idx = np.random.choice(range(n), size=3, replace=False)
            donor = pop[np.random.choice(range(pop_size), p=np.ones(pop_size)/pop_size)]
            donor[idx] += F * (target[idx] - donor[idx]) + rng.normal(0, 1e-2, n)
            
            for j in range(n):
                if rng.random() < CR or target[j] == donor[j]:
                    target[j] = donor[j]
                    
        new_pop = np.clip(target, lb, ub)
        
        fit_target = func(new_pop)
        fit_donor = np.sum([func(np.copy(pop[i]).astype(float)) for i in range(pop_size)])
        
        if fit_target < fit_donor:
            pop = new_pop
        else:
            pop[np.random.choice(range(pop_size), size=pop_size, p=np.ones(pop_size)/pop_size)] = target
            
        t += 1
        
    return np.argmin([func(np.clip(x, lb, ub)) for x in pop])
