def algorithm(func, dim, lb, ub, budget, rng):
    n = int(np.ceil(budget / 1e4)) + 1
    x0 = (ub - lb) * rng.rand(dim) + lb
    sa = Simulated_Annealing(func, dim, lb, ub, 1000)
    simplex = NelderMead_Simplex(func, dim, lb, ub)
    
    candidates = []
    for i in range(n):
        if i == 0:
            candidate = x0
        elif i % 10 == 0:
            candidate = sa.run()
        else:
            candidate = simplex.run()
        
        candidates.append(candidate)
    
    return np.array(min(candidates, key=func))
