def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    n = len(lb)
    sigma = 0.5 * (ub[0] - lb[0])
    mean = 0.5 * np.array([lb[i] + ub[i]] for i in range(n))
    cov = sigma ** 2 * np.eye(dim)

    best_x = None
    best_y = float('inf')

    for _ in range(budget):
        z = rng.multivariate_normal(mean, cov)
        x = mean + sigma * z

        # Clip candidates to [lb, ub]
        for i in range(n):
            x[i] = max(lb[i], min(x[i], ub[i]))

        y = evaluate(x)

        if y < best_y:
            best_x = x
            best_y = y

    return best_x
