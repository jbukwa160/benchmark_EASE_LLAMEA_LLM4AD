def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(pop, xbest):
        n = pop.shape[0]
        F = 1 + (1 - (budget / n)) * 0.5
        CR = 1 - (budget / n)
        diff = np.random.rand(n, dim) * 2 - 1
        for i in range(dim):
            if rng.uniform() < CR:
                diff[i] = xbest[i]
        return F * pop + diff

    def crossover(pop, xbest):
        n = pop.shape[0]
        CR = 1 - (budget / n)
        child = np.zeros((n, dim))
        for i in range(n):
            if rng.uniform() < CR:
                child[i] = rng.uniform(0, 1) * xbest + rng.uniform(0, 1) * pop[i]
            else:
                child[i] = pop[i]
        return child

    def select(pop, child, best):
        n = pop.shape[0]
        new_pop = np.concatenate((pop, child))
        return new_pop[np.argpartition(new_pop[:, None], -n)[-n:, :]]

    xbest = rng.uniform(lb, ub, size=dim)
    pop = np.array([xbest for _ in range(budget)])

    for t in range(1, budget):
        mutant = mutate(pop, xbest)
        child = crossover(mutant, xbest)
        new_pop = select(pop, child, xbest)
        pop = new_pop[t-1, :]
        xbest = new_pop[-t, :]

        if (func(new_pop[0]) < func(xbest)):
            xbest = new_pop[0]
        if (np.all(new_pop[:, None] <= ub) and np.all(new_pop[:, None] >= lb)):
            pop[t-1] = new_pop[np.argmin(func(new_pop))]

    return xbest
