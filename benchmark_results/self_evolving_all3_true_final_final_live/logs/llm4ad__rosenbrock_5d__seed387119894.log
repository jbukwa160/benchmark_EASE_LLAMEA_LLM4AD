def algorithm(func, dim, lb, ub, budget, rng):
    def neg_func(x): return -func(x)
    
    x_best = np.random.uniform(lb, ub, (1, dim))
    y_best = func(x_best)
    
    gp_model = {'x': [], 'y': []}
    
    for i in range(1, budget+1):
        x = np.clip(np.array([rng.normal(loc=0, scale=5, size=(1, dim)) + 3 for _ in range(10)]).T, lb, ub)
        
        y_pred = gp_model['y']
        
        if len(gp_model['x']) == 0:
            y = [neg_func(x_i) for x_i in x]
        else:
            with np.errstate(divide='ignore', invalid='ignore'):
                mu, sigma = predict_gp(np.array(gp_model['x']), x)
                
                y_pred += np.exp(-((np.array(x) - gp_model['x']) ** 2).sum(axis=1)) / ((sigma + 1e-8) ** (dim+1))
        
        idx = np.argmax(y)
        
        if y[idx] > y_best:
            x_best = x[idx]
            y_best = y[idx]
        
        gp_model['x'].append(x[idx])
        gp_model['y'].append(y[idx])
    
    return x_best
