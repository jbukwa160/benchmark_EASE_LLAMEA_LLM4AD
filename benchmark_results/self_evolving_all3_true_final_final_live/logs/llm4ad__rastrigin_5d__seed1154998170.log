def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def f(params):
        params = clip(params)
        return func(params)

    best_x = np.zeros(dim)
    best_f = float('inf')
    cma_es = CMAES(budget * 1000)  # adjust the budget here
    for i in range(1, budget + 1):
        x_new, f_new = cma_es.ask_and_eval(f, rng.randint(np.iinfo(np.int32).max, size=dim))
        if f_new < best_f:
            best_x = x_new
            best_f = f_new
    return best_x
