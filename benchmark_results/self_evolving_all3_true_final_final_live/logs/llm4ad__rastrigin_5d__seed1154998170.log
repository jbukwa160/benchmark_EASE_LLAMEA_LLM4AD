def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def gradient_descent(population, x_best):
        step_size = 0.01
        for i in range(dim):
            x_i = population[i]
            if rng.uniform(0, 1) < 0.1:
                x_i -= step_size * rng.uniform(-1, 1)
                x_i = clip(x_i)
            population[i] = x_i

    def differential_evolution(population, bounds):
        F = 0.5
        CR = 0.9
        for _ in range(budget // 2):
            for i in range(dim):
                a, b, c = rng.choice(range(len(population)), size=3, replace=False)
                u = population[a] + F * (population[b] - population[c])
                if rng.uniform(0, 1) < CR or func(u) < func(population[i]):
                    population[i] = clip(u)

    population = np.array([rng.uniform(lb, ub) for _ in range(budget)])

    for _ in range(budget // 2):
        differential_evolution(population, [lb, ub])
        gradient_descent(population, np.argmin(np.array([func(x) for x in population])))

    return clip(population[np.argmin(np.array([func(x) for x in population]))])
