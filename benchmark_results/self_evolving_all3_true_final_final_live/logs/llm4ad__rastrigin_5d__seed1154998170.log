def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def gaussian_mutate(parent, sigma):
        mutated = parent + rng.normal(size=dim) * sigma
        return clip(mutated)

    def differential_evolution(population, cost_func, bounds, mutpb, crosspb, strategy, max_iter, budget):
        npop = len(population)
        ngen = max_iter

        for gen in range(ngen):
            for i in range(npop):
                if rng.random() < mutpb:
                    parents = np.random.choice(population, size=2, replace=False)
                    child1 = population[i] + strategy(parents[0], parents[1])
                    child2 = population[i] + strategy(parents[1], parents[0])

                    mutated_child1 = gaussian_mutate(child1, 0.5)
                    mutated_child2 = gaussian_mutate(child2, 0.5)

                    cost_child1 = cost_func(mutated_child1)
                    cost_child2 = cost_func(mutated_child2)

                    if (cost_child1 < population[i]) and (cost_child1 < cost_child2):
                        population[i] = mutated_child1
                    elif (cost_child1 > cost_child2) and (cost_child2 < population[i]):
                        population[i] = mutated_child2

                else:
                    parents = np.random.choice(population, size=2, replace=False)
                    child = population[i] + strategy(parents[0], parents[1])

                    mutated_child = gaussian_mutate(child, 0.5)

                    cost_child = cost_func(mutated_child)

                    if cost_child < population[i]:
                        population[i] = mutated_child

            if np.all(np.array(population) == population[0]):
                break
        return population[0]

    bounds = [(lb, ub)] * dim
    strategy = lambda parent1, parent2: (parent1 - parent2)
    mutpb = 0.5
    crosspb = 0.8
    max_iter = budget

    initial_population = rng.uniform(size=(100, dim)) * (ub - lb) + lb
    best_individual = differential_evolution(initial_population, func, bounds, mutpb, crosspb, strategy, max_iter, budget)

    return best_individual
