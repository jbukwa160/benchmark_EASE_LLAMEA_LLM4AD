def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    n = 10  # initial population size
    pop = rng.uniform(lb, ub, (n, dim))
    best = None

    for _ in range(budget):
        fvals = func(pop)
        idx = np.argsort(fvals)[:1]
        best_f = fvals[idx]
        if best is None or best_f < best:
            best = best_f
            best_pop = pop[idx]

        for i in range(n):
            v1, v2, v3 = rng.choice(range(n), 3, replace=False)
            u = clip(pop[v1] + 0.5 * (pop[v2] - pop[v3]))
            fvals_u = func(u.reshape(1, dim))
            if fvals_u < best_f:
                pop[i] = u
        n = max(n // 2, 10)

    return best_pop
