def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    num_parents = int(pop_size * 0.1)
    F = 0.8
    CR = 0.9
    T_max = budget // (2 * dim + 1)

    x = rng.uniform(lb, ub, size=(pop_size, dim))
    y = func(x)

    for t in range(1, T_max+1):
        z = np.copy(x)
        
        for i in range(pop_size):
            idx = rng.choice(pop_size, num_parents, replace=False)
            u = x[idx, :]
            v = rng.uniform(lb, ub, size=dim)
            
            z[i] = lb + (ub - lb) * (u[rng.randint(0, num_parents-1), :] + F * (v - u[rng.randint(0, num_parents-1), :]) + CR * (np.random.rand(dim) - 0.5))
        
        w = func(z)
        
        idx = np.argsort(w)[:num_parents]
        x[idx] = z[idx]

    return x[np.argmin(y)]
