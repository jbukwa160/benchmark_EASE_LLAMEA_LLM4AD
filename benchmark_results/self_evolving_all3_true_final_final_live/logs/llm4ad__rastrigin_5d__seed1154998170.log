def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(candidate):
        candidate = clip(candidate)
        return func(candidate), candidate

    class Particle:
        def __init__(self):
            self.position = rng.uniform(lb, ub, size=dim)
            self.velocity = rng.uniform(-1.0, 1.0, size=dim)
            self.best_position = self.position.copy()
            self.best_fitness = np.inf

        def update_velocity(self, global_best):
            c1, c2 = 2.05, 2.05
            r1, r2 = rng.uniform(0, 1), rng.uniform(0, 1)
            self.velocity = (c1 * r1 * (self.best_position - self.position) +
                            c2 * r2 * (global_best - self.position) +
                            rng.uniform(-1.0, 1.0, size=dim)) / np.sqrt(dim + 1)

        def update_position(self):
            self.position += self.velocity

    class DifferentialEvolution:
        def __init__(self, population_size, mutation_factor):
            self.population = [Particle() for _ in range(population_size)]
            self.mutation_factor = mutation_factor
            self.global_best = np.inf

        def evolve(self):
            for particle in self.population:
                particle.update_velocity(self.population[0].position)
                particle.update_position()

                fitness, position = evaluate(particle.position)
                if fitness < particle.best_fitness:
                    particle.best_fitness = fitness
                    particle.best_position = position
                if fitness < self.global_best:
                    self.global_best = fitness

            for i in range(len(self.population)):
                candidate1, candidate2, candidate3 = np.copy(self.population[i].position), np.copy(self.population[(i+1)%len(self.population)].position), np.copy(self.population[(i+2)%len(self.population)].position)
                for j in range(dim):
                    delta = (candidate2[j] - candidate1[j]) * self.mutation_factor + (candidate3[j] - candidate1[j])
                    candidate2[j] += delta
                fitness, position = evaluate(candidate2)
                if fitness < particle.best_fitness:
                    particle.best_fitness = fitness
                    particle.best_position = position

        def get_best(self):
            best_particle = max(self.population, key=lambda p: p.best_fitness)
            return best_particle.best_position

    de = DifferentialEvolution(population_size=50, mutation_factor=0.5)
    for _ in range(budget):
        de.evolve()

    return de.get_best()
