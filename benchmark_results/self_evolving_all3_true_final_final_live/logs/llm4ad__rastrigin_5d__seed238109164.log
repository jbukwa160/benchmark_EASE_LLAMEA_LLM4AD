def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_initialization(dim, lb, ub, rng):
        return (ub - lb) * rng.random((dim)) + lb

    def gaussian_mutation(distribution, mean, std_dev):
        return distribution + rng.normal(0, std_dev, size=distribution.shape)

    x = gaussian_initialization(dim, lb, ub, rng)
    distribution = np.mean(np.abs(x))
    std_dev = 1.0
    mu = 2

    for i in range(budget):
        y = gaussian_mutation(distribution, x, std_dev)
        y = np.clip(y, lb, ub)

        f_y = func(y)
        if f_y < func(x):
            x = y
            distribution = np.mean(np.abs(x))
            std_dev *= 0.5
        else:
            z = gaussian_mutation(distribution, x, mu * std_dev)
            z = np.clip(z, lb, ub)

            f_z = func(z)
            if f_z < func(y):
                y = z

            if f_y < func(x):
                x = y
                distribution = np.mean(np.abs(x))
                std_dev *= 0.5

    return x
