def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        step_size = 0.1 / np.sqrt(i + 1)
        grad = np.zeros(dim)
        for j in range(10): # approximate gradient with multiple evaluations
            e = rng.rand(dim) - 0.5
            x_e = x + step_size * e
            clip_x_e = np.clip(x_e, lb, ub)
            grad += (func(clip_x_e) - func(x)) / (step_size * 10) * e
        x -= step_size * grad
        x = np.clip(x, lb, ub)

        if func(x) < best_f:
            best_x = x.copy()
            best_f = func(x)

    return best_x
