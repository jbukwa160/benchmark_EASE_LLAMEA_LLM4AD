def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.zeros(dim)
    sigma = 0.5 * (ub - lb) / 1.4
    ngen = 0
    best_x = x.copy()
    best_f = func(x)

    while True:
        y = clip(x + sigma * rng.normal(size=dim))
        f = func(y)
        
        if f < best_f:
            best_f = f
            best_x = y.copy()

        ngen += 1

        if ngen >= budget or np.linalg.norm(best_x) == 0:
            break

        x += sigma * rng.normal(size=dim)

    return best_x
