    beta_c = 1 / (1 + np.sqrt(i))
    for i in range(budget):
        y = clip(x + rng.normal(0, sigma, size=dim))
        f_y = func(y)
        if i == 0 or f_y < func(x):
            x = y
        elif rng.uniform(0, 1) > np.exp(-f_y / (func(x) - f_y)):
            x = y
        z = rng.normal(0, sigma, size=dim)
        for j in range(dim):
            if rng.uniform(0, 1) < 0.5:
                z[j] *= -1
