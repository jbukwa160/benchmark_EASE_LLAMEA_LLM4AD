def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    x = np.random.uniform(lb, ub, (pop_size, dim))
    y = func(x)
    best_sol = x[np.argmin(y)]
    best_obj = np.min(y)

    for i in range(budget):
        v = x + 0.5 * rng.normal(size=(pop_size, dim))
        v = np.clip(v, lb, ub)
        f = func(v)
        idx = np.argsort(f)[:int(pop_size/2)]
        x[idx] = v[idx]
        y[idx] = f[idx]

        if np.min(y) < best_obj:
            best_sol = x[np.argmin(y)]
            best_obj = np.min(y)

    return best_sol
