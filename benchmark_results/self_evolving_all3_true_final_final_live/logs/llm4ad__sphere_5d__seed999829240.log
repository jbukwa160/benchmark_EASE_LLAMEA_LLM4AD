def algorithm(func, dim, lb, ub, budget, rng):
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    N = 1000
    alpha = 1e-3
    radius = np.linalg.norm(x_best) / N

    for _ in range(budget):
        x_candidate = x_best + radius * rng.randn(dim)
        x_candidate = np.clip(x_candidate, lb, ub)
        
        f_candidate = func(x_candidate)

        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate

        radius *= (1 - alpha)

    return x_best
