def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    def lcg_optimizer(initial_point, budget):
        x = initial_point.copy()
        g = func.gradient(x)
        d = -g
        beta = 0.5 * (np.dot(g.T, g) / np.dot(d.T, d)) + 1e-6

        for _ in range(budget):
            alpha = -beta * np.dot(g.T, d)

            if alpha < 0:
                break

            x += alpha * d
            g_new = func.gradient(x)
            gamma = (np.linalg.norm(g_new) ** 2 / np.linalg.norm(g) ** 2).item()
            beta *= gamma
            d = -g_new + gamma * d
            g = g_new

        return x

    best_x = None
    best_f = float('inf')

    for _ in range(budget):
        initial_point = rng.uniform(lb, ub, size=dim)
        candidate_x = clip_candidate(initial_point)

        if func(candidate_x) < best_f:
            local_optimizer_budget = 1000
            best_local_x = lcg_optimizer(candidate_x, local_optimizer_budget)
            local_best_f = func(best_local_x)

            if local_best_f < best_f:
                best_x = best_local_x
                best_f = local_best_f

    return clip_candidate(best_x)
