def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(mean, sigma, rng=rng):
        candidate = mean + sigma * rng.normal(size=(dim,))
        return clip(candidate)

    def update_mean(candidates, mean):
        return (candidates.sum(axis=0) / len(candidates))

    def update_covariance(cov, candidates, mean):
        delta = candidates - mean
        covariance_update = (delta.T @ delta) / len(candidates)
        cov += 1.1 * (covariance_update - np.outer(mean, mean))
        return 1.01 * cov

    mean = rng.normal(size=(dim,))
    cov = np.eye(dim)

    for _ in range(budget):
        candidate = generate_candidate(mean, np.sqrt(np.diag(cov)), rng=rng)
        value = func(candidate)

        new_mean = update_mean([candidate], mean)
        cov = update_covariance(cov, [candidate], new_mean)

        mean = new_mean

    return mean
