def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 1000.0
    alpha = 0.95
    sigma = 2.0
    min_val = float('inf')
    best_x = None

    for _ in range(budget):
        candidate = x + rng.normal(0, sigma, size=dim)
        candidate = np.clip(candidate, lb, ub)

        f_candidate = func(candidate)
        f_current = func(x)

        if f_candidate < f_current:
            x = candidate
            min_val = f_candidate

            if f_candidate < min_val:
                min_val = f_candidate
                best_x = candidate

        else:
            delta = f_current - f_candidate
            prob_accept = np.exp(-delta / T)
            r = rng.uniform(0, 1)

            if r < prob_accept or rng.uniform(0, 1) < 0.01: # 1% chance of accepting worse solution
                x = candidate

        T *= alpha

    return best_x
