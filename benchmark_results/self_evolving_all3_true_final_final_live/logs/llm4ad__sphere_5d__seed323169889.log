def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(dim,))
    t = 1.0
    s = 0.01 * (ub - lb)
    sigma = s / 2

    for _ in range(budget):
        c = np.clip(x + sigma * rng.normal(size=(dim,)), lb, ub)
        f_c = func(c)
        f_x = func(x)

        if f_c < f_x:
            x = c
        else:
            t *= 0.98
            s *= min(1 - 1e-6, np.exp(-t * (f_c - f_x) / sigma))
            sigma = s

    return x
