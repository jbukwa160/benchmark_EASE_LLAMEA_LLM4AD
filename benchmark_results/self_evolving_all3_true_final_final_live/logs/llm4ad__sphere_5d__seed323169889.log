def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def sample():
        return np.random.uniform(lb, ub, size=dim)

    best_x = None
    best_y = float('inf')

    for _ in range(budget):
        x = sample()
        y = func(x)
        
        if rng.random() < 0.1:
            x += 0.5 * np.random.uniform(-ub, ub, size=dim)

        x = clip(x)
        if y < best_y:
            best_x = x
            best_y = y

    return best_x
