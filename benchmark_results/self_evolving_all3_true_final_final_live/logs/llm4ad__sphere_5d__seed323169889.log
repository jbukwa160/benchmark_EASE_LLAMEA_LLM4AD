def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    step_size = 10.0 / (2 ** int(np.log10(budget)))
    for _ in range(int(1e6)):
        if _ >= budget:
            break
        
        step = rng.uniform(-step_size, step_size, size=dim)
        
        x_candidate = np.clip(x_best + step, lb, ub)
        
        f_candidate = func(x_candidate)
        
        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate
            
        step_size /= 2
        
    return x_best
