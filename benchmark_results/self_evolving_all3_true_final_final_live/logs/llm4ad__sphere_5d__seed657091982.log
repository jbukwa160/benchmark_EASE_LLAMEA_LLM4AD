def algorithm(func, dim, lb, ub, budget, rng):
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    for _ in range(budget):
        step_size = (ub - lb) / 10.0
        sigma = 0.1
        while True:
            x_candidate = x_best + step_size * np.clip(rng.randn(dim), -sigma, sigma)
            x_candidate = np.clip(x_candidate, lb, ub)

            f_candidate = func(x_candidate)
            if f_candidate < f_best:
                x_best = x_candidate
                f_best = f_candidate

            step_size *= 0.9
            sigma /= 1.1

            if step_size <= 1e-6 or sigma <= 1e-3:
                break

    return x_best
