def algorithm(func, dim, lb, ub, budget, rng):
    bounds = [(lb, ub) for _ in range(dim)]
    
    def posterior(x):
        return -func(x)
    
    best_x = None
    best_y = float('inf')
    
    for i in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        # Clip to bounds
        x = np.clip(x, *bounds)
        
        y = posterior(x)
        
        if y < best_y:
            best_x = x
            best_y = y
    
    return best_x
