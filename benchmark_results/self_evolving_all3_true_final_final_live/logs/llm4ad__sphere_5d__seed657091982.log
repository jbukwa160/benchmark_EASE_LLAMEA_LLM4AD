def algorithm(func, dim, lb, ub, budget, rng):
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    T = 1.0
    alpha = 0.99
    beta = 0.05
    delta = 1e-6

    for _ in range(budget):
        x_new = x_best + (ub - lb) * rng.randn(dim)
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)

        if f_new < f_best:
            x_best = x_new
            f_best = f_new

        T *= alpha

        delta_f = f_new - f_best

        if delta_f > 0 and rng.rand() < np.exp(-delta_f / T):
            x_best = x_new
            f_best = f_new

    return x_best
