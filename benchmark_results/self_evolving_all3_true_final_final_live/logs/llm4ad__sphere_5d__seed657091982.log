def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    T = 1.0
    alpha = 0.99
    step_size = 5.0

    for _ in range(budget):
        new_x = clip(x + rng.randn(dim) * step_size)
        f_new = func(new_x)
        f_best = func(best_x)

        if f_new < f_best:
            best_x = new_x.copy()
            x = new_x
        else:
            delta = f_new - f_best
            prob = np.exp(-delta / T)
            if rng.rand() < prob:
                x = new_x

        step_size *= alpha
        T *= alpha

    return best_x
