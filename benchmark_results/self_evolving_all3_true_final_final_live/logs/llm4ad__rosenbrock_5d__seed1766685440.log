def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    delta = 5.0  # initial step size
    while budget > 0:
        min_f = float('inf')
        for i in range(dim):
            new_delta = delta * np.exp(-budget / 100)
            new_x = x.copy()
            new_x[0, i] += rng.uniform(-new_delta, new_delta)
            new_x = np.clip(new_x, lb, ub)  # clip to bounds
            f_new = func(new_x)
            if f_new < min_f:
                min_f = f_new
                best_x = new_x.copy()
        x = best_x.copy()  # update current candidate with best found so far
        budget -= 1
    return best_x[0]
