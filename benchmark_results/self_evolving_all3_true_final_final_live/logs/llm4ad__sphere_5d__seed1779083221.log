def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def rand_var(lb, ub, rng=rng):
        return rng.uniform(lb, ub)

    x = clip(np.zeros(dim))
    best_x = np.copy(x)
    best_value = func(clip(best_x))

    temperature = 1.0
    cooling_rate = 0.99

    for _ in range(budget):
        new_x = clip(x + (ub - lb) * (rand_var(-1, 1) + rand_var(-1, 1)))
        new_value = func(clip(new_x))

        if new_value < best_value:
            best_x = np.copy(new_x)
            best_value = new_value
            x = np.copy(new_x)

        elif rng.random() < (np.exp((best_value - new_value) / temperature)):
            x = np.copy(new_x)

        temperature *= cooling_rate

    return best_x
