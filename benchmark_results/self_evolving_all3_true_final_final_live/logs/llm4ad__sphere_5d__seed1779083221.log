def algorithm(func, dim, lb, ub, budget, rng):
    n = len(rng)

    for _ in range(n):
        x = np.clip(np.random.uniform(lb, ub, size=dim), lb, ub)
        f_x = func(x)
        
        if _ < 5:
            alpha = 0.1
        else:
            alpha = 0.01
            
        x_new = x - alpha * (func(x + np.finfo(float).eps) - f_x) / np.sum(func(x + np.finfo(float).eps) - f_x)
        x_new = np.clip(x_new, lb, ub)

        if func(x_new) < f_x:
            x = x_new

    return np.array([x])
