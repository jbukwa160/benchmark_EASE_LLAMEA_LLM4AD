def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_candidate = np.zeros(dim)
    best_value = float('inf')
    step_size = 5.0
    iteration = 0

    while iteration < budget:
        candidate = clip(best_candidate + rng.normal(0, step_size, dim))
        value = func(candidate)
        
        if value < best_value:
            best_candidate = candidate
            best_value = value
        
        # reduce step size by 50% after each 100 iterations
        if (iteration + 1) % 100 == 0 and iteration != budget - 1:
            step_size *= 0.5
        
        iteration += 1
    
    return best_candidate
