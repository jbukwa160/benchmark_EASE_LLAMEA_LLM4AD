def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def mutate(candidate):
        for i in range(dim):
            if rng.random() < 0.1:
                candidate[i] += rng.uniform(-0.5, 0.5)
                candidate[i] = clip(candidate)[i]
        return candidate

    def crossover(parent1, parent2):
        child = np.zeros(dim)
        for i in range(dim):
            if rng.random() < 0.5:
                child[i] = parent1[i]
            else:
                child[i] = parent2[i]
        return clip(child)

    population_size = int(budget / dim)
    population = np.random.uniform(lb, ub, (population_size, dim))

    for _ in range(int(budget)):
        fitness = [func(individual) for individual in population]

        indices = np.argsort(fitness)[:int(population_size * 0.2)]
        parents = population[indices]
        children = []
        while len(children) < population_size - len(parents):
            parent1, parent2 = rng.choice(parents, size=2, replace=False)
            child = crossover(parent1, parent2)
            children.append(child)

        population = np.vstack([parents, mutate(children)])

    best_individual = min(population, key=func)
    return best_individual
