def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    N = budget
    
    # Initialize the list to store function values
    y = [0] * N
    x = [np.zeros(D)] * N
    
    # Random search for initial points
    X = np.random.uniform(lb, ub, size=(N, D))
    
    # Evaluate the objective function at the initial points
    for i in range(N):
        y[i] = func(X[i])
        
    # Main loop of Bayesian optimization
    for n in range(1, N):
        # Compute the matrix to store kernel values
        K = np.zeros((n + 1, n + 1))
        
        # Initialize the lower and upper bounds for the next point
        lb_next = ub
        
        # Update the matrix of kernel values
        for i in range(n + 1):
            for j in range(i, n + 1):
                K[i, j] = norm.pdf(X[i].dot(X[j]), loc=0, scale=1.5)
                K[j, i] = K[i, j]
        
        # Compute the Cholesky decomposition of the kernel matrix
        F = cho_factor(K[:n, :n])
        
        # Draw a sample from the posterior distribution using the inverse GP
        m = np.dot(cho_solve(F, np.mean(X[:n], axis=0)), K[n, n - 1] / K[n, n])
        
        # Compute the next point by sampling from the Gaussian process with mean and variance computed at the current point
        X_next = m + rng.normal(loc=m, scale=np.sqrt(1.5))
        
        # Clip the candidate to the bounds
        X_next = np.clip(X_next, lb, ub)
        
        # Evaluate the objective function at the next point
        y_next = func(X_next)
        
        # Update the list of points and their corresponding function values
        x[n] = X_next
        y[n] = y_next
        
    # Return the best 1-D numpy array found
    return np.argmin(y) if y else np.zeros(D)
