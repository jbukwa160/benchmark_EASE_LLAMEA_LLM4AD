def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidates, lb, ub):
        return np.clip(candidates, a_min=lb, a_max=ub)

    def func_wrapper(x):
        return func(x) + 1e-32  # Avoid negative infinity

    def differential_evolution(func_wrapper, bounds, dim, budget):
        pop_size = int(np.sqrt(budget))
        x0 = rng.uniform(bounds[:, 0], bounds[:, 1], size=(pop_size, dim))
        np.random.shuffle(x0)
        for _ in range(int(budget / pop_size)):
            y = x0.copy()
            for i in range(pop_size):
                c = rng.uniform(-1.0, 1.0, size=dim)
                v = clip(y[i] + c * (x0 - y[i]), bounds[:, 0], bounds[:, 1])
                if func_wrapper(v) < func_wrapper(y[i]):
                    y[i] = v
            x0 = y.copy()
        return x0[np.argmin([func_wrapper(x) for x in x0])]

    def simulated_annealing(func_wrapper, x, bounds, budget):
        T = 1e3
        t = 0
        while t < budget and T > 1e-32:
            delta = rng.uniform(-T * 2.0, T * 2.0)
            y = clip(x + delta, bounds[:, 0], bounds[:, 1])
            if func_wrapper(y) < func_wrapper(x):
                x = y
            else:
                p = np.exp(-(func_wrapper(y) - func_wrapper(x)) / (T * rng.uniform(1e-32)))
                if rng.rand() < p:
                    x = y
            T *= 0.99
            t += 1
        return x

    bounds = np.array([lb] * dim + [ub] * dim).reshape(-1, 2)
    x0 = differential_evolution(func_wrapper, bounds, dim, budget)
    return simulated_annealing(func_wrapper, x0, bounds, int(budget / 10))
