def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        # Gradient-based step
        grad = np.zeros(dim)
        eps = 1e-6
        for i in range(dim):
            x_plus_eps = clip(best_x + eps * rng.uniform(-1, 1))
            x_minus_eps = clip(best_x - eps * rng.uniform(-1, 1))
            grad[i] = (func(x_plus_eps) - func(x_minus_eps)) / (2 * eps)
        step_size = 0.01
        x_new = best_x - step_size * grad
        
        # Evolutionary strategy step
        noise = rng.normal(size=(dim,))
        x_evolution = clip(best_x + 0.1 * noise)
        
        # Choose the better of the two new candidates
        f_new = func(x_new)
        if f_new < best_f:
            best_x, best_f = x_new, f_new
        else:
            x_new = x_evolution
            f_new = func(x_new)
            if f_new < best_f:
                best_x, best_f = x_new, f_new
    
    return best_x
