def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.minimum(np.maximum(x, lb), ub)

    def evaluate(x):
        return func(x) + 1e10 * (np.sum(np.abs(x)) - 5.0 * dim)

    DE_config = {
        'pop_size': 20,
        'num_generations': int(budget / dim),
        'F': 0.7,
        'CR': 0.9
    }

    PSO_config = {
        'pop_size': 10,
        'num_iterations': int(budget / (dim * 2)),
        'c1': 2.0,
        'c2': 2.0,
        'w': 0.7
    }

    x_best_DE = np.random.uniform(lb, ub, size=(DE_config['pop_size'], dim))
    x_best_PSO = np.random.uniform(lb, ub, size=(PSO_config['pop_size'], dim))

    for i in range(DE_config['num_generations']):
        y_best_DE = x_best_DE.copy()
        for j in range(DE_config['pop_size']):
            r1, r2, r3 = rng.randint(0, DE_config['pop_size'], size=3)
            while r1 == j or r2 == j or r3 == j:
                r1, r2, r3 = rng.randint(0, DE_config['pop_size'], size=3)

            y = x_best_DE[r1] + DE_config['F'] * (x_best_DE[r2] - x_best_DE[r3])
            y = clip(y, lb, ub)
            f_y = evaluate(y)
            if f_y < evaluate(x_best_DE[j]):
                x_best_DE[j] = y

        for j in range(PSO_config['pop_size']):
            v_PSO = np.random.uniform(-1.0, 1.0, size=(dim,))
            x_PSO_new = x_best_PSO[j] + PSO_config['w'] * v_PSO + \
                        PSO_config['c1'] * rng.rand() * (x_best_DE[rng.randint(0, DE_config['pop_size'])] - x_best_PSO[j]) + \
                        PSO_config['c2'] * rng.rand() * (x_best_DE[rng.randint(0, DE_config['pop_size'])] - x_best_PSO[j])
            x_PSO_new = clip(x_PSO_new, lb, ub)
            f_x_PSO_new = evaluate(x_PSO_new)

            if f_x_PSO_new < evaluate(x_best_PSO[j]):
                x_best_PSO[j] = x_PSO_new

    best_solution = np.inf
    for i in range(DE_config['pop_size']):
        f_x = evaluate(x_best_DE[i])
        if f_x < best_solution:
            best_solution = f_x
            best_candidate = x_best_DE[i]

    for j in range(PSO_config['pop_size']):
        f_x_PSO = evaluate(x_best_PSO[j])
        if f_x_PSO < best_solution:
            best_solution = f_x_PSO
            best_candidate = x_best_PSO[j]

    return best_candidate
