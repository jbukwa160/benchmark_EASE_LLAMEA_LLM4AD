def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best = np.full(dim, 0)
    best_fitness = float('inf')
    
    step_size = (ub - lb) / 10
    num_restarts = int(budget * 0.1)
    
    for _ in range(num_restarts):
        x = clip(rng.uniform(lb, ub, size=dim))
        x_best = x.copy()
        
        for _ in range(int(budget * 0.9)):
            x_new = x + rng.uniform(-step_size, step_size, size=dim)
            x_new = clip(x_new)
            
            fitness = func(x_new)
            if fitness < func(x_best):
                x_best = x_new
        
        if func(x_best) < best_fitness:
            best_fitness = func(x_best)
            best = x_best
    
    return best
