def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(clip(x_best))

    T = 1.0
    learning_rate = 0.01

    for _ in range(budget):
        x_new = clip(x_best + learning_rate * rng.randn(dim))
        f_new = func(x_new)

        if f_new < f_best:
            x_best = x_new
            f_best = f_new

        elif np.random.rand() < np.exp((f_best - f_new) / T):
            x_best = x_new
            f_best = f_new

        T *= 0.99  # Decrease temperature schedule

    return x_best
