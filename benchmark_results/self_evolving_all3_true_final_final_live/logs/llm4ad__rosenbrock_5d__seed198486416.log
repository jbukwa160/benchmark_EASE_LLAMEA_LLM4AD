def algorithm(func, dim, lb, ub, budget, rng):
    num_samples = int(np.sqrt(budget))
    sigma0 = 1.5 / dim
    sigma = [sigma0] * (num_samples + 1)
    pmean = np.zeros(dim)
    pcov = np.eye(dim) * sigma0**2

    for i in range(num_samples):
        samples, weights = rng.multivariate_normal(pmean, pcov, num_samples), np.ones(num_samples) / num_samples
        samples = np.clip(samples, lb, ub)

        evaluations = func(samples)
        best_idx = np.argmax(evaluations)
        pmean += (weights[best_idx] * samples[best_idx] - pmean) / i

        for j in range(i):
            delta = samples[j] - pmean
            tr_deltaTdelta = np.dot(delta, np.dot(pcov, delta))
