def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = 100
    mutation_prob = 0.1
    pop = rng.uniform(lb, ub, (pop_size, dim))

    for _ in range(budget):
        fitness = [func(clip(x)) for x in pop]
        best_idx = np.argmin(fitness)
        best_x = clip(pop[best_idx])

        new_pop = []
        for i in range(pop_size):
            parent1_idx = rng.randint(pop_size)
            parent2_idx = rng.randint(pop_size)
            child = 0.5 * (pop[parent1_idx] + pop[parent2_idx]) + \
                    rng.uniform(-1, 1) * mutation_prob
            new_pop.append(clip(child))

        pop = np.array(new_pop)

    return best_x
