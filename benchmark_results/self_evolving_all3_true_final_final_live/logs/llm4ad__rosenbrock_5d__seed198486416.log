def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    D = dim
    n_pop = 100
    step_size = 2.0
    cov_mat = np.eye(D) * 1e-5

    for _ in range(budget):
        pop = rng.normal(clip(np.ones(D), lb, ub), step_size, (n_pop, D))
        fitness = np.array([func(x) for x in pop])
        idx = np.argsort(fitness)
        pop = pop[idx[:int(n_pop/2)]]
        
        if len(pop) < n_pop:
            cov_mat = 0.5 * (cov_mat + np.eye(D))
        else:
            cov_mat += 0.1 * ((pop.mean(axis=0, keepdims=True) - cov_mat.dot(rng.normal(0, 1, (D, D)))) @ rng.normal(0, 1, (D, D)))

        step = cov_mat.dot(rng.normal(0, 1, (D, 1)))
        best_candidate = pop[0] + step
        best_fitness = func(best_candidate)

    return clip(best_candidate, lb, ub)
