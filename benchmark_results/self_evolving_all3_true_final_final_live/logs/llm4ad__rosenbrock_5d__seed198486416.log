def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def neighborhood_search(current, sigma):
        noise = rng.uniform(-1, 1, size=dim)
        neighbor = current + sigma * noise
        return clip(neighbor)

    def simulated_annealing(current, schedule, budget_remaining):
        temperature = schedule.next()
        for _ in range(budget_remaining):
            neighbor = neighborhood_search(current, temperature)
            if func(neighbor) < func(current):
                current = neighbor
            elif rng.random() < np.exp((func(current) - func(neighbor)) / temperature):
                current = neighbor
        return current

    def differential_evolution(population, budget_remaining):
        for _ in range(budget_remaining):
            distances = np.linalg.norm(population[:, np.newaxis] - population, axis=2)
            neighbors = np.argmin(distances, axis=1)
            parent1 = population[neighbors]
            parent2 = np.random.choice(population, size=len(parent1), replace=False)
            offspring = 0.5 * (parent1 + parent2) + rng.uniform(-1, 1, size=(len(parent1), dim))
            offspring = clip(offspring)
            if func(offspring) < func(parent1):
                population[neighbors] = offspring
        return population

    def optimize():
        population = np.random.uniform(lb, ub, size=(int(budget / (dim + 1)) ** 2, dim))
        for _ in range(dim):
            population = differential_evolution(population, int(budget / (dim + 1)))
        current = simulated_annealing(population[0], schedule, budget - dim)
        return current

    class Schedule:
        def __init__(self, initial_temperature, cooling_rate, final_temperature):
            self.initial_temperature = initial_temperature
            self.cooling_rate = cooling_rate
            self.final_temperature = final_temperature
            self.temperature = initial_temperature

        def next(self):
            self.temperature *= self.cooling_rate
            return self.final_temperature if self.temperature < self.final_temperature else self.temperature

    schedule = Schedule(10, 0.9, 1e-6)
    best_solution = optimize()
    return best_solution
