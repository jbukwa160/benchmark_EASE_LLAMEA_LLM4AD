def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    n_particles = int(np.sqrt(budget))
    particles = np.random.uniform(lb, ub, (n_particles, dim))

    best_glo = np.zeros(dim)
    best_glo_f = float('inf')

    for _ in range(budget):
        velocities = np.zeros((n_particles, dim))
        personal_best = particles.copy()
        global_best = particles.copy()

        for i in range(n_particles):
            velocities[i] = 0.5 * rng.uniform(-1, 1, size=dim)
            personal_best[i] += velocities[i]

        for i in range(n_particles):
            if evaluate(personal_best[i]) < evaluate(global_best[i]):
                global_best[i] = personal_best[i]

        for i in range(n_particles):
            if evaluate(global_best[i]) < best_glo_f:
                best_glo = global_best[i]
                best_glo_f = evaluate(best_glo)

        inertia = 0.7298
        c1 = c2 = 1.49618

        for i in range(n_particles):
            velocities[i] += inertia * rng.uniform(-1, 1, size=dim)
            personal_best[i] += c1 * rng.uniform(0, 1) * (global_best[i] - particles[i])
            personal_best[i] += c2 * rng.uniform(0, 1) * (best_glo - particles[i])

            velocities[i] = np.clip(velocities[i], -5, 5)
            personal_best[i] = np.clip(personal_best[i], lb, ub)

        particles = personal_best

    return best_glo
