def algorithm(func, dim, lb, ub, budget, rng):
    def _rand(xmin, xmax):
        return xmin + rng.uniform() * (xmax - xmin)

    x = [_rand(lb, ub) for _ in range(dim)]
    t = 1.0
    best_x = np.array(x)
    best_f = func(best_x)

    for i in range(budget):
        v = [x[j] + rng.uniform(-1, 1) * (x[j] - lb) for j in range(dim)]

        # Clip candidates to [lb, ub]
        for j in range(dim):
            if v[j] < lb:
                v[j] = lb
            elif v[j] > ub:
                v[j] = ub

        f = func(np.array(v))
        if f < best_f:
            best_x = np.array(v)
            best_f = f

        # Simulated Annealing (SA) step
        p = rng.uniform(0, 1)
        if p < np.exp((best_f - f) / t):
            x = v
            t *= 0.99  # Decrease temperature

    return best_x
