def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(pop, best, f):
        n = len(best)
        w = 0.5 * (ub - lb) / (1 + np.log10(1 + n))
        u = np.random.uniform(lb, ub, size=n)
        v = np.random.uniform(lb, ub, size=n)
        z = best + w * (u - v)
        z = [min(max(x, lb), ub) for x in z]
        return func(z)

    def local_search(pop):
        best = pop[0]
        improved = False
        for _ in range(100):
            i = np.random.randint(len(pop))
            new = pop[i] + 0.1 * (best - pop[i])
            new = [min(max(x, lb), ub) for x in new]
            if func(new) < func(best):
                best = new
                improved = True
        return best

    pop = np.random.uniform(lb, ub, size=(budget, dim))
    for _ in range(budget - 1):
        f_values = [func(x) for x in pop]
        best_idx = np.argmin(f_values)
        best = pop[best_idx]
        mutants = [mutate(pop[i], best, func) for i in range(len(pop))]
        pop = np.array([local_search(mutants + pop[i]) if func(mutants[i]) < func(pop[i]) else pop[i] for i in range(len(pop))])
    return best
