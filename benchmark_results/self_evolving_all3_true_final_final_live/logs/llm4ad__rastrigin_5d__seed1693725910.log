def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    pop = rng.uniform(lb, ub, (pop_size, dim))
    
    # DE parameters
    F = 0.5
    CR = 0.9
    
    # SA parameters
    T = budget * 10
    alpha = 1e-3
    
    for t in range(budget):
        # Perform DE operation
        temp = pop + rng.uniform(-F, F, (pop_size, dim))
        
        for i in range(pop_size):
            r1, r2, r3 = np.random.choice(pop_size, size=3, replace=False)
            if (rng.rand() < CR) or (temp[i] == pop[r1]):
                temp[i] = 0.5 * (pop[i] + temp[i])
        
        # Apply SA operation
        for i in range(pop_size):
            delta = rng.uniform(-alpha, alpha)
            new_x = pop[i] + delta
            new_x = np.clip(new_x, lb, ub)
            if func(new_x) < func(temp[i]):
                temp[i] = new_x
        
        # Update population
        pop = temp.copy()
        
    return np.argmin(func(pop))
