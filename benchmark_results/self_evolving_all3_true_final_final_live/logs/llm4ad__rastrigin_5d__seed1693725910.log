def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    x = 2 * rng.rand(dim) - 1 + lb
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        # Differential Evolution step
        mutation_factor = 0.5
        crossover_prob = 0.9
        
        candidate_x = bound(best_x + mutation_factor * (x[rng.choice(dim, dim)] - x[rng.choice(dim, dim)]))
        
        if rng.rand() < crossover_prob:
            for i in range(dim):
                if rng.rand() < 0.5 and candidate_x[i] != best_x[i]:
                    candidate_x[i] = np.mean([candidate_x[i], best_x[i]])
        
        # Local Search step
        delta = 1e-6 * (ub - lb)
        for _ in range(20):
            for i in range(dim):
                candidate_x[i] += rng.choice([-1, 1]) * delta[rng.randint(0, dim)]
                if func(candidate_x) < best_f:
                    best_x = candidate_x.copy()
                    best_f = func(best_x)
                candidate_x[i] -= rng.choice([-1, 1]) * delta[rng.randint(0, dim)]
        
        x = candidate_x
    
    return best_x
