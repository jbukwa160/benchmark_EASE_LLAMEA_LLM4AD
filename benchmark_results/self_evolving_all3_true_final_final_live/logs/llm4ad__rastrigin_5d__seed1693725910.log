def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    sigma_init = 0.5 * (ub - lb) / np.sqrt(dim)
    best = x.copy()
    for t in range(budget):
        sigma = sigma_init / (1 + t/budget)**2
        new_x = x + rng.normal(size=x.shape, loc=0, scale=sigma)
        new_x = np.clip(new_x, lb, ub)
        if func(new_x) < func(best):
            best = new_x
        x = 0.5 * (best + new_x)
    return best
