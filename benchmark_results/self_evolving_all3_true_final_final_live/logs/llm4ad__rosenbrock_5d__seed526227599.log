def algorithm(func, dim, lb, ub, budget, rng):
    def sample(rng, n, lb, ub):
        return rng.uniform(lb, ub, size=(n, dim))

    def clip(x, lb, ub):
        return np.minimum(np.maximum(x, lb), ub)

    x = sample(rng, 1, lb, ub)
    sigma = (ub - lb) / 3.0
    step_size = 1e-6

    for _ in range(budget):
        y = clip(func(x), float('-inf'), float('inf'))
        if np.isnan(y).any():
            x = sample(rng, 1, lb, ub)
            continue
        sigma = sigma * (1 + rng.normal(0, 0.01) / rng.normal(0, 0.01))
        step_size = sigma * rng.normal(0, 1)

        for _ in range(int(budget / 5)):
            x_new = clip(x + step_size * rng.normal(0, 1, size=dim), lb, ub)
            y_new = func(x_new)
            if np.isnan(y_new):
                continue
            if y_new < y:
                y = y_new
                x = x_new

    return x
