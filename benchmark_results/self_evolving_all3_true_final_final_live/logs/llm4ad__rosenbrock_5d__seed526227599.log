def algorithm(func, dim, lb, ub, budget, rng):
    def levy_flight(current, step_size):
        u = rng.uniform(0, 1)
        v = rng.uniform(0, 1)
        s = (np.sin(u) / (u**2 + 0.01)) * np.exp(v)
        return current + step_size * s

    def adapt_rate(failure_count):
        return min(max(0.05 + failure_count / 100, 0.001), 1)

    def crossover(parent1, parent2, rate):
        u = rng.uniform(0, 1)
        if u < rate:
            return np.minimum(np.maximum(parent1, lb), ub)
        else:
            return np.minimum(np.maximum(parent2, lb), ub)

    def mutation(child, parent1, parent2, step_size, rate):
        u = rng.uniform(0, 1)
        if u < rate:
            child += levy_flight(parent1, step_size)
        else:
            child += (parent1 - parent2) * np.random.uniform(-1, 1)
        return np.minimum(np.maximum(child, lb), ub)

    current_best = np.fromiter((ub + rng.uniform(0, 1)) for _ in range(dim))
    history = [current_best]
    failure_count = 0
    step_size = 1

    for i in range(budget):
        new_candidate = current_best.copy()
        for j in range(dim):
            parent1 = current_best if rng.uniform(0, 1) < 0.5 else history[rng.randint(i)]
            parent2 = current_best if rng.uniform(0, 1) < 0.5 else history[rng.randint(i)]
            new_candidate[j] = crossover(parent1[j], parent2[j], adapt_rate(failure_count))
            new_candidate[j] = mutation(new_candidate[j], parent1[j], parent2[j], step_size, adapt_rate(failure_count))
        new_candidate = func(new_candidate)
        if new_candidate < func(current_best):
            current_best = new_candidate
            history.append(current_best)
            failure_count = 0
        else:
            failure_count += 1
        step_size *= 0.9999

    return current_best
