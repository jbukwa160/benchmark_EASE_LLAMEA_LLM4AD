def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_y = func(x)

    for _ in range(budget):
        n = len(best_x)
        p = rng.choice(n, size=n-1, replace=False)
        m = np.setdiff1d(np.arange(n), p)

        u = rng.normal(size=n)
        v = x[p] + 0.5 * u
        w = best_x[m] + 0.5 * u

        for i in range(n):
            new_x = v.copy()
            new_x[i] = np.clip(w[i], lb, ub)

            new_y = func(new_x)
            if new_y < best_y:
                best_x = new_x
                best_y = new_y

    return best_x
