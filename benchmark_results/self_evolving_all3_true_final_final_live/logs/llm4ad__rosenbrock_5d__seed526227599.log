def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return func(x)

    def clip(candidate):
        clipped_candidate = np.clip(candidate, a_min=lb, a_max=ub)
        return clipped_candidate

    x_best = 1.0 * np.ones(dim)  # Initialize the best solution
    f_best = float('inf')  # Initialize the best objective value

    for _ in range(budget):
        # Differential Evolution (DE) part
        x_new = x_best + rng.uniform(-2, 2, size=dim)
        x_clipped = clip(x_new)
        f_value = Rosenbrock(x_clipped)

        if f_value < f_best:
            f_best = f_value
            x_best = x_clipped

        # Simulated Annealing (SA) part
        acceptance_probability = 0.8  # Decrease this value to increase exploitation and decrease exploration
        delta_f = f_value - f_best

        if delta_f < 0:
            x_best = x_clipped
        else:
            probability = np.exp(-delta_f / (budget * rng.uniform(1e-4, 1e-3)))
            if rng.random() < probability * acceptance_probability:
                x_best = x_clipped

    return x_best
