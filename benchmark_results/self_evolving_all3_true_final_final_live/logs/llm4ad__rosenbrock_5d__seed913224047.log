def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    D = dim
    M = pop_size
    F = 0.5
    CR = 0.9
    
    # Initialize population with random candidates
    X = rng.uniform(lb, ub, (M, D))
    
    for t in range(budget):
        # Evaluate fitness values
        fX = np.array([func(X[i]) for i in range(M)])
        
        # Sort population based on fitness values
        idx = np.argsort(fX)
        X[idx[:int(0.2*M)]] = rng.uniform(lb, ub, (int(0.2*M), D))
        
        # Mutation operator
        V = np.zeros((M, D))
        for i in range(M):
            r1 = np.random.randint(0, M)
            while r1 == i:
                r1 = np.random.randint(0, M)
            r2 = np.random.randint(0, M)
            while r2 == i or r2 == r1:
                r2 = np.random.randint(0, M)
            V[i] = X[r1] + F * (X[r2] - X[r1])
        
        # Crossover operator
        U = np.zeros((M, D))
        for i in range(M):
            for j in range(D):
                u = rng.uniform(0, 1)
                if u < CR or j == rng.randint(0, D-1):
                    U[i, j] = V[i, j]
                else:
                    U[i, j] = X[i, j]
        
        # Selection operator
        for i in range(M):
            if fX[i] > func(U[i]):
                X[i] = U[i]
