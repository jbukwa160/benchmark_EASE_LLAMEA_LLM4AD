def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(current, sigma):
        candidate = current + rng.normal(size=dim) * sigma
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x)

    current = rng.uniform(lb, ub, size=dim)
    best = current.copy()
    temperature = 1.0

    for _ in range(budget):
        candidate = generate_candidate(current, temperature)
        delta = evaluate(candidate) - evaluate(current)
        
        if delta < 0 or (delta >= 0 and rng.rand() < np.exp(-delta / temperature)):
            current = candidate
            if evaluate(current) < evaluate(best):
                best = current

        temperature *= 0.99  # adaptive cooling schedule

    return best
