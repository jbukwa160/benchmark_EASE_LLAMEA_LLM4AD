def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    def evaluate(x):
        return func(x), x

    def polynomial_mutation(x, sigma, rng):
        x_mutated = x + rng.normal(0, 1, size=(dim,))
        for i in range(dim):
            if rng.uniform(0, 1) < 0.01:
                x_mutated[i] += (rng.uniform(-1, 1)) * (ub - lb)
        return clip(x_mutated)

    def cma_es_step(population, sigma, iteration):
        mean = np.mean(population, axis=0)
        cov = np.cov(population, rowvar=False)
        eigenvalues, eigenvectors = np.linalg.eig(cov)
        weights = 1 / (eigenvalues + 1e-8)
        weights /= np.sum(weights)
        mutation_step = sigma * np.sqrt(2 / dim) * np.dot(eigenvectors, np.diag(np.sqrt(weights)))
        return polynomial_mutation(mean, mutation_step, rng)

    best_individual = None
    best_fitness = float('inf')

    for _ in range(budget):
        population = [evaluate(polynomial_mutation(rng.uniform(lb, ub, size=(dim,)), 1.0, rng))[1] for _ in range(10)]
        mean, _ = np.mean(population, axis=0), None
        sigma = np.std(population, axis=0).mean()
        new_mean = cma_es_step(population, sigma, iteration=budget - _)
        fitness, individual = evaluate(new_mean)

        if fitness < best_fitness:
            best_individual, best_fitness = individual, fitness

    return best_individual
