def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        n = 0
        while n < dim:
            c = np.zeros(dim)
            for i in range(n, dim):
                c[i] = 2 * (x[i] - x[i-1]) / (func([*x[:i], x[i-1]+(ub-x[i-1])*rng.rand(), *x[i:]]).flatten() + 0.00001) 
                if rng.rand() < 0.5:
                    c[i] *= -1
            new_x = x + 0.5 * (c - x)
            new_x = np.clip(new_x, lb, ub)
            
            f_new = func(new_x)
            if f_new < best_f or rng.rand() < 0.01:
                best_f = f_new
                best_x = new_x.copy()
                
            n += 1
            
        x = best_x.copy()
    
    return best_x
