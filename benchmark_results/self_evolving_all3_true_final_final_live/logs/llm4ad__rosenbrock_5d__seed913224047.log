def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(mean, step_size):
        candidate = mean + step_size * np.random.randn(dim)
        return np.clip(candidate, lb, ub)

    def adapt_step_size(step_size, x, y):
        return 0.5 * (step_size - 0.1) + 0.05 * (y - func(x))

    def restart(mean, step_size, budget_remaining):
        if rng.rand() < 0.01 or np.linalg.norm(mean - 1) > 10:
            return 1, mean, step_size
        else:
            new_mean = mutate(mean, step_size)
            new_step_size = adapt_step_size(step_size, mean, func(new_mean))
            budget_remaining -= 1
            return budget_remaining, new_mean, new_step_size

    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for _ in range(budget):
        step_size = 0.5 * (np.max(ub - lb) + np.min(ub - lb)) / dim
        budget_remaining = budget

        while True:
            mean = mutate(best_x, step_size)
            f = func(mean)
            if f < best_f:
                best_x = mean
                best_f = f
            elif rng.rand() > 0.1 and np.linalg.norm(mean - best_x) > 5 * step_size:
                budget_remaining, best_x, step_size = restart(best_x, step_size, budget_remaining)
            else:
                step_size = adapt_step_size(step_size, best_x, func(best_x))

    return best_x
