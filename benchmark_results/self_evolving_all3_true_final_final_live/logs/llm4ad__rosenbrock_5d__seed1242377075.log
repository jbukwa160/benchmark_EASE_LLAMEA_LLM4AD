def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        y = x + 0.5 * rng.normal(size=dim)
        y = clip(y)
        
        f_y = func(y)
        delta_f = f_y - best_f
        
        if delta_f < 0 or (delta_f >= 0 and np.random.rand() < np.exp(-delta_f)):
            x = y
            best_x = y.copy()
            best_f = f_y
            
    return best_x
