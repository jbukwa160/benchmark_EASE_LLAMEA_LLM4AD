def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def objective(params):
        return func(params)

    pop_size = 50
    elite_size = int(pop_size * 0.2)
    crossover_prob = 0.9

    x = np.random.uniform(lb, ub, (pop_size, dim))
    y = [objective(clip(x[i], lb, ub)) for i in range(pop_size)]

    for _ in range(budget):
        u = rng.randint(pop_size, size=pop_size)
        v = rng.randint(pop_size, size=pop_size)

        F = 0.5 + 0.3 * rng.random()
        w = x[u] + F * (x[v] - x[rng.randint(0, pop_size)])

        for i in range(pop_size):
            if objective(clip(w[i], lb, ub)) < y[i]:
                x[i] = clip(w[i], lb, ub)
                y[i] = objective(clip(x[i], lb, ub))

        top_indices = np.argsort(y)[:elite_size]
        x[top_indices] = clip(x[top_indices], lb, ub)

    best_idx = np.argmin(y)
    return clip(x[best_idx], lb, ub)
