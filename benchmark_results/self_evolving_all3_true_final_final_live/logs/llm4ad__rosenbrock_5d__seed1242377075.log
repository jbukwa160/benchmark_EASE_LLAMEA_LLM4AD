def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        v = rng.normal(size=dim)
        u = 0.5 * (x + rng.uniform(-1, 1, size=dim))
        w = 0.5 * (u + rng.uniform(-1, 1, size=dim))

        new_x = clip(w, lb, ub)

        f_new = func(new_x)
        prob = np.exp(-(best_f - f_new) / 10)

        if f_new < best_f or rng.random() < prob:
            best_x = new_x.copy()
            best_f = f_new

        x = new_x.copy()

    return clip(best_x, lb, ub)
