def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 1e3
    alpha = 0.99
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        x_new = x + rng.normal(size=dim) * 0.01
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)
        
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new
        
        delta = f_new - best_f
        if delta < 0 or rng.uniform(0, 1) < np.exp(-delta / T):
            x = x_new

        T *= alpha
    
    return best_x
