def algorithm(func, dim, lb, ub, budget, rng):
    best = np.inf * np.ones(dim)
    for _ in range(budget):
        candidate = rng.uniform(lb, ub, size=dim)
        new_value = func(candidate)
        if new_value < func(best) and all(np.isfinite(new_value)):
            best = candidate
    return best
