def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def func_wrapper(x):
        x = clip(x)
        return func(x)

    pop_size = 10 * dim
    x0 = np.random.uniform(lb, ub, (pop_size, dim))
    y_best = np.inf

    for _ in range(budget):
        F = 0.5 + rng.rand() / 2
        Cr = 0.9 + rng.rand() / 10
        V = rng.randn(pop_size, dim)
        X = x0 + F * V

        for i in range(pop_size):
            u = rng.uniform(0, 1, (dim,))
            X[i] += u * (X[i] - x0[i])

        X = clip(X)

        f_X = func_wrapper(X)
        y_best = np.min([y_best, np.mean(f_X)])

        idx = np.argmin(f_X)
        if f_X[idx] < y_best:
            x0 = X[idx]

    return x0
