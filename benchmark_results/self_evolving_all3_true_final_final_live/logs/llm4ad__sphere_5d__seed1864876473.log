def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_y = func(x)

    for _ in range(budget):
        y = func(x)

        if y < best_y:
            best_x = x.copy()
            best_y = y

        d = 0.5 * (ub - lb) * rng.truncated_normal(size=dim, loc=0, scale=1)
        x = x + d
        x = np.clip(x, lb, ub)

    return best_x
