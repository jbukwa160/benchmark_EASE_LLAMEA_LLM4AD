def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(np.clip(x, lb, ub))

    x = [np.random.uniform(lb[i], ub[i]) for i in range(dim)]
    T0 = 1.0
    alpha = 0.99
    cooling_rate = 0.999

    for _ in range(budget):
        y = np.array(x) + rng.normal(0, 1, dim)
        if f(y) < f(x):
            x = y
        else:
            delta = f(x) - f(y)
            if np.exp(-delta/T0) > rng.uniform(0, 1):
                x = y

        T0 *= alpha * cooling_rate
    return np.array(x)
