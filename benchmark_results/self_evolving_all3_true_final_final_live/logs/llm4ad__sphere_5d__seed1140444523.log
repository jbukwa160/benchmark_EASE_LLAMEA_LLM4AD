def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = 5 * (rng.rand(dim) - 0.5) + lb
    best_x = x.copy()
    best_f = func(best_x)
    
    T = 1e3
    
    for _ in range(budget):
        new_x = clip(x + rng.randn(dim) / np.sqrt(T))
        new_f = func(new_x)
        
        if new_f < best_f:
            best_f = new_f
            best_x = new_x
            
        delta = new_f - best_f
        
        if delta <= 0 or rng.rand() * T * (1 + delta/best_f) > np.exp(-delta/T):
            x = new_x
            
        T *= 0.99
    
    return best_x
