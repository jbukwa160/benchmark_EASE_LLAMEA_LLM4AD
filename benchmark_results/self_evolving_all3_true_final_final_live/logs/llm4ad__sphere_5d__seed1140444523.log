def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    D = 10  # initial population size
    x = np.random.uniform(lb, ub, (D, dim))
    for _ in range(budget):
        y = x + 0.1 * rng.rand(D, dim)
        y = clip(y)
        f_y = func(y)
        idx = np.argsort(f_y)[:int(0.2*D)]
        x[idx] = y[idx]
        D = len(idx)
    return clip(x[np.argmin([func(xi) for xi in x])])
