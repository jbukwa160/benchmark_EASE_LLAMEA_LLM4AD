def algorithm(func, dim, lb, ub, budget, rng):
    T = 10.0 * (ub - lb) ** 2
    x_best = np.zeros(dim)
    f_best = func(x_best)

    for t in range(budget):
        x_new = x_best + rng.uniform(-1, 1, size=dim) * (ub - lb)
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        
        if f_new < f_best:
            f_best = f_new
            x_best = x_new

        step_size = T / (t + 1)
        probability = np.exp((f_best - f_new) / step_size)
        accept = rng.rand() < probability
        
        if not accept:
            x_new = x_best + rng.uniform(-1, 1, size=dim) * (ub - lb)
            x_new = np.clip(x_new, lb, ub)

    return x_best
