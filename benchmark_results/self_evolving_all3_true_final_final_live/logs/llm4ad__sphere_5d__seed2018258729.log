def algorithm(func, dim, lb, ub, budget, rng):
    n_evals = 0
    min_point = None
    min_val = float('inf')

    while n_evals < budget:
        x = (ub - lb) * rng.rand(dim) + lb
        val = func(x)
        n_evals += 1

        if val < min_val:
            min_val = val
            min_point = x

    return np.clip(min_point, lb, ub)
