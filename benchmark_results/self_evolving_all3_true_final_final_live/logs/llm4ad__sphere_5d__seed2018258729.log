def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def fitness(x):
        return func(clip(x))

    sigma = 1.0
    x_mean = np.zeros(dim)
    pop_size = 10 * dim

    for i in range(budget):
        offspring = rng.normal(loc=x_mean, scale=sigma, size=(pop_size, dim))
        fvals = np.array([fitness(offspring[j]) for j in range(pop_size)])

        argmin_idx = np.argmin(fvals)
        x_new = offspring[argmin_idx]

        # Update mean and sigma
        delta = (x_new - x_mean) / sigma
        x_mean += 0.1 * delta

        if i % dim == 0:
            sigma *= 1 + 1e-6 * rng.uniform(-1, 1)

    return clip(x_mean)
