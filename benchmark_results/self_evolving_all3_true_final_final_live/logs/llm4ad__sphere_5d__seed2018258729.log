def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget - 1):
        new_x = clip(rng.uniform(lb, ub, size=dim))
        new_f = func(new_x)
        
        if new_f < best_f:
            best_f = new_f
            best_x = new_x.copy()
    
    return best_x
