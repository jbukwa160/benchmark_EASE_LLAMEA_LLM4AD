def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def evaluate(x):
        return func(x)

    init_x = rng.uniform(lb, ub, size=(dim,))
    best_x = init_x.copy()

    de_crossover_prob = 0.5
    sa_temp_init = 1e4
    sa_temp_decay = 0.99
    sa_accept_prob = 0.8

    for i in range(budget):
        x_de = clip(best_x + rng.uniform(-3, 3, size=(dim,)), lb, ub)
        f_de = evaluate(x_de)

        if f_de < evaluate(best_x):
            best_x = x_de

        sa_temp = max(sa_temp_init * (sa_temp_decay ** i), 1e-6)
        r = rng.uniform(0, 1)
        if r < sa_accept_prob:
            x_sa = clip(best_x + rng.normal(0, sa_temp, size=(dim,)), lb, ub)
            f_sa = evaluate(x_sa)
            if f_sa < evaluate(best_x):
                best_x = x_sa

    return best_x
