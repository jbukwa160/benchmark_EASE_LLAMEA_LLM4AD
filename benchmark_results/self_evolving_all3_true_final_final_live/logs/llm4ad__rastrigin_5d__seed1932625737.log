def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    x = np.random.uniform(lb, ub, size=dim)
    T = 10 * (ub - lb)  # initial temperature
    best_x = x.copy()
    best_obj = objective(best_x)

    for _ in range(budget):
        y = x + rng.normal(size=x.shape) / 1e3
        y = np.clip(y, lb, ub)
        y_obj = objective(y)

        if y_obj < best_obj:
            best_obj = y_obj
            best_x = y.copy()

        alpha = 0.9 * (ub - lb) + rng.uniform(0, (ub - lb))
        delta_T = T * np.exp(-alpha / budget)
        p = 1.5 * np.exp(-_ / budget)

        if rng.uniform(0, 1) < p:
            x = best_x + rng.normal(size=x.shape) * delta_T
            x = np.clip(x, lb, ub)

        T *= 0.999

    return best_x
