def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best = None
    num_restarts = 0
    num_no_improvement = 0
    while True:
        population_size = int(budget / (num_restarts + 1))
        candidates = rng.uniform(lb, ub, size=(population_size, dim))
        scores = [func(candidate) for candidate in candidates]
        best_candidate = clip(candidates[np.argmin(scores)])
        if best is None or np.min(scores) < func(best):
            num_no_improvement = 0
            best = best_candidate
        else:
            num_no_improvement += 1

        if num_no_improvement >= population_size // 2:
            num_restarts += 1
            if num_restarts > 10:  # Early stopping criterion
                break
            num_no_improvement = 0

    return best
