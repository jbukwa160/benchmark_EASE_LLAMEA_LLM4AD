def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_obj = objective(best_x)

    for i in range(budget):
        a, b, c = rng.choice(dim, replace=False, size=3)
        y = x.copy()
        y[a], y[b] = np.random.uniform(lb, ub), np.random.uniform(lb, ub)
        z = y.copy()
        z[c] = 0.5 * (y[c] + np.random.uniform(-1, 1) * best_x[c])

        y_obj = objective(y)
        z_obj = objective(z)

        if y_obj < best_obj:
            x = y.copy()
            best_obj = y_obj

        T = 100
        alpha = 0.99
        u = rng.uniform(0, 1)
        if u < np.exp(-(z_obj - best_obj) / T):
            x = z.copy()
            best_obj = z_obj
            T *= alpha

    return best_x
