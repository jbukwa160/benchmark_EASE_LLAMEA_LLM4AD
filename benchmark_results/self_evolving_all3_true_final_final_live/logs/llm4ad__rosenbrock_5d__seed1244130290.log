def algorithm(func, dim, lb, ub, budget, rng):
    def get_bounds():
        return [(lb[i], ub[i]) for i in range(dim)]

    def generate_candidate(bounds):
        candidate = [np.random.uniform(bounds[i][0], bounds[i][1]) for i in range(dim)]
        return np.array(candidate)

    def clip_candidate(candidate, bounds):
        clipped_candidate = np.clip(candidate, *bounds)
        return clipped_candidate

    def evaluate_candidate(func, candidate):
        value = func(candidate)
        return value

    def generate_initial_population(bounds, population_size):
        population = [generate_candidate(bounds) for _ in range(population_size)]
        return population

    def get_distance(candidate1, candidate2):
        distance = np.linalg.norm(candidate1 - candidate2)
        return distance

    def update_bounds(bounds, best_candidate, new_best_candidate):
        if evaluate_candidate(func, new_best_candidate) < evaluate_candidate(func, best_candidate):
            bounds[-1] = (new_best_candidate[-1], bounds[-1][1])
        for i in range(dim-1):
            lower_bound = max(bounds[i][0], best_candidate[i])
            upper_bound = min(bounds[i][1], best_candidate[i])
            bounds[i] = (lower_bound, upper_bound)
        return bounds

    def bayesian_optimization(func, bounds, budget):
        population_size = 10
        num_iterations = int(budget / population_size)
        population = generate_initial_population(bounds, population_size)
        for _ in range(num_iterations):
            candidates = [generate_candidate(bounds) for _ in range(population_size)]
            values = [evaluate_candidate(func, candidate) for candidate in candidates]
            best_candidate = np.array([val + rng.random() * (ub[i] - lb[i]) for i, val in enumerate(values)])
            clipped_best_candidate = clip_candidate(best_candidate, bounds)
            population.append(clipped_best_candidate)
        return population

    def local_search(func, population):
        num_iterations = 10
        best_candidate = np.copy(population[0])
        for _ in range(num_iterations):
            candidate = [best_candidate + rng.uniform(-1, 1) * (ub[i] - lb[i]) for i in range(dim)]
            clipped_candidate = clip_candidate(np.array(candidate), get_bounds())
            value = evaluate_candidate(func, clipped_candidate)
            if value < func(best_candidate):
                best_candidate = np.copy(clipped_candidate)
        return best_candidate

    def run():
        bounds = get_bounds()
        population = bayesian_optimization(func, bounds, budget)
        best_candidate = local_search(func, population)
        return clip_candidate(best_candidate, bounds)

    result = run()
    return result
