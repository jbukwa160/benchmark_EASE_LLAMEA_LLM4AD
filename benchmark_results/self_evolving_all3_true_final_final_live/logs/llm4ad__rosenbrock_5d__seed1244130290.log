def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    x = np.random.uniform(lb, ub, size=dim)
    sigma = 1.0
    c1 = 1.0
    c2 = 1.0

    for _ in range(budget):
        x_new = x + rng.normal(size=dim) * sigma
        x_new = np.clip(x_new, lb, ub)

        f_new = f(x_new)
        alpha = np.exp(-f_new / (func(x) + 1e-16))
        if f_new < func(x) or np.random.rand() < alpha:
            x = x_new

        sigma *= c1 * np.exp(-(f(x)**2 - f_new**2) / (2 * (func(x)**2 + 1e-16)))
        sigma = max(0.01, min(sigma, ub - lb))

    return x
