def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lower, upper):
        return np.clip(candidate, lower, upper)

    def generate_initial_population(dim, population_size, lb, ub, rng):
        return lb + (ub - lb) * rng.uniform(size=(population_size, dim))

    def evaluate_candidates(candidates, func, dim, lb, ub):
        return func(clip(candidates, lb, ub))

    def differential_evolution(population, target_func, dim, bounds, budget):
        population_size = len(population)
        while budget > 0:
            for i in range(population_size):
                x1 = population[i]
                x2_idx = np.random.choice(population_size, replace=False, size=3)
                idxs = [i] + list(x2_idx)
                vector_diff = population[x2_idx[0]] - population[x2_idx[1]]
                mutation = 0.5 * (population[x2_idx[2]] - population[x2_idx[0]]) + vector_diff
                crossover_idx = np.random.choice(dim, replace=False, size=dim)
                child_candidate = x1.copy()
                for j in range(dim):
                    if rng.uniform() < 0.5:
                        child_candidate[j] += mutation[j]
                candidate = clip(child_candidate, bounds[0], bounds[1])
                new_fitness = target_func(candidate)
                if new_fitness < evaluate_candidates(x1, target_func, dim, bounds)[i]:
                    population[i] = candidate
            budget -= 1
        return np.argmin(evaluate_candidates(population, target_func, dim, bounds))

    initial_population = generate_initial_population(dim, 50, lb, ub, rng)
    best_idx = differential_evolution(initial_population, func, dim, [lb, ub], budget)
    return clip(initial_population[best_idx], lb, ub)
