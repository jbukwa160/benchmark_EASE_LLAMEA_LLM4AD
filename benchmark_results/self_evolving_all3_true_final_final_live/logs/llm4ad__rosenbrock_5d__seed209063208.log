def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        c1 = 0.5
        c2 = 0.3

        # Random search
        if np.random.rand() < 0.05:
            new_x = rng.uniform(lb, ub, size=dim)
        else:
            # Gradient-based update
            grad = np.zeros(dim)
            for i in range(dim):
                x_plus = np.copy(x)
                x_plus[i] += 1e-4
                grad[i] = (func(x_plus) - best_f) / 1e-4

            new_x = x + c1 * rng.uniform(-1, 1, size=dim) + c2 * grad

        # Clip to bounds
        new_x = np.clip(new_x, lb, ub)

        new_f = func(new_x)
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f

    return best_x
