def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([0.5 * (lb + ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Sort dimensions by function values
        fvals = [func(np.array(x[:i] + [x[i] + 1e-6] + x[i+1:])) if i < dim - 1 else func(np.array(x[:i] + [x[i] - 1e-6]))
                 for i in range(dim)]
        order = np.argsort(fvals)

        # Cyclic updates
        for i in order:
            new_x = x.copy()
            new_x[i] += rng.uniform(-1, 1) * (ub - lb)
            new_f = func(new_x)
            if new_f < best_f:
                best_f = new_f
                best_x = new_x

        # Successive update
        for i in range(dim):
            new_x = x.copy()
            new_x[i] += rng.uniform(-1, 1) * (ub - lb)
            new_f = func(new_x)
            if new_f < best_f:
                best_f = new_f
                best_x = new_x

        # Clip candidates to bounds
        for i in range(dim):
            x[i] = np.clip(x[i], lb, ub)

    return best_x
