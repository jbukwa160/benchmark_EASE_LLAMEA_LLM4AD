def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    T = 1.0
    cooling_rate = 0.99

    for _ in range(budget):
        y = x_best + 0.2 * rng.normal(size=dim)
        y = clip(y)
        fy = func(y)
        alpha = np.exp(-(fy - f_best) / T)

        if rng.uniform() < alpha:
            x_best = y
            f_best = min(fy, f_best)
        
        T *= cooling_rate

    return x_best
