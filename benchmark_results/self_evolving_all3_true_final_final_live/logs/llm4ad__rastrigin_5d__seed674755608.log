def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        # Local search
        for i in range(dim):
            x_loc = clip(best_x + 0.1 * (ub - lb) * rng.uniform(-1, 1, size=dim))
            f_loc = func(x_loc)
            if f_loc < best_f:
                best_f = f_loc
                best_x = x_loc
        
        # Global move
        x_glob = clip(best_x + 0.5 * (ub - lb) * rng.uniform(-1, 1, size=dim))
        f_glob = func(x_glob)
        
        if f_glob < best_f:
            best_f = f_glob
            best_x = x_glob
    
    return best_x
