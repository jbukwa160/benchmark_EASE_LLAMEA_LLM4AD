def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(x_best, sigma):
        return x_best + sigma * rng.randn(dim)

    def update_sigma(sigma, adaptation_rate, step_size):
        new_sigma = max(1e-8, min(1e8, sigma * np.exp(adaptation_rate * step_size)))
        return new_sigma

    def cma_es(x_best, sigma, dim, lb, ub, budget):
        adaptation_rate = 0.01
        step_size = 1 / (2 + x_best.shape[0])
        for _ in range(budget):
            candidate = generate_candidate(x_best, sigma)
            candidate = np.clip(candidate, lb, ub)
            fitness = func(candidate)
            if fitness < func(x_best):
                x_best = candidate
            new_sigma = update_sigma(sigma, adaptation_rate, step_size)
            return x_best, new_sigma

    rng = np.random.default_rng(rng)
    x_best = np.zeros(dim)
    sigma = 1.0
    for _ in range(budget):
        x_best, sigma = cma_es(x_best, sigma, dim, lb, ub, budget // (dim + 1))
    return x_best
