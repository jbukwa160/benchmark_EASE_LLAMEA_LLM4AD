def algorithm(func, dim, lb, ub, budget, rng):
    X = np.random.uniform(lb, ub, (budget, dim))
    Y = func(X)
    idx_sorted = np.argsort(Y)
    
    for i in range(budget - 1):
        x_curr = X[idx_sorted[i]]
        score_diff = np.zeros(dim)
        
        for j in range(budget):
            if j != i:
                x_nei = X[j]
                score_diff += np.exp(-0.5 * np.sum((x_curr - x_nei)**2))
        
        score_avg = np.mean(score_diff)
        prob_rank = 1 / (score_avg + 1e-8)
        prob_sample = np.random.rand()
        
        if prob_sample < prob_rank:
            X[idx_sorted[i]] = np.clip(np.random.uniform(lb, ub, dim), lb, ub)
    
    idx_best = np.argmin(Y)
    return np.clip(X[idx_best], lb, ub)
