def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best = np.zeros(dim)
    best_score = float('inf')

    for _ in range(budget // 2):
        x = np.random.uniform(lb, ub, size=dim)
        x = clip(x)
        score = func(x)

        if score < best_score:
            best_score = score
            best = x

        for _ in range(5): # number of iterations to refine the current solution
            step_size = 0.01 * (ub - lb) * rng.rand(dim)
            x = clip(best + step_size)
            score = func(x)

            if score < best_score:
                best_score = score
                best = x

    return best
