def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T0 = 10.0
    alpha = 0.99
    T_min = 1e-6
    current_best = func(x)
    for _ in range(budget):
        perturb_size = 2 * np.power(T0 / (_ + 1), 0.5) * rng.uniform(-1, 1, size=dim)
        x_new = np.clip(x + perturb_size, lb, ub)
        new_score = func(x_new)
        if new_score < current_best:
            current_best = new_score
            x = x_new
        elif rng.rand() < np.exp((current_best - new_score) / T0):
            x = x_new
        T0 *= alpha
    return x
