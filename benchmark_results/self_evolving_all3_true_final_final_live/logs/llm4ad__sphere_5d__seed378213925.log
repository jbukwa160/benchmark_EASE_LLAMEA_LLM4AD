def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.zeros(dim)
    best_x = np.copy(x)
    best_f = func(best_x)
    
    for _ in range(budget):
        r1, r2, r3 = rng.randint(0, dim, size=3), rng.randint(0, dim, size=3), rng.randint(0, dim, size=3)
        
        while (r1 == r2) or (r2 == r3) or (r1 == r3):
            r2, r3 = rng.randint(0, dim, size=2)
        
        a = clip(best_x + 0.5 * np.sign(x[r1] - x[r2]) * (x[r1] - x[r2]))
        b = clip(a + 0.5 * np.sign(x[r1] - x[r3]) * (x[r1] - x[r3]))
        
        f_a = func(clip(a))
        f_b = func(clip(b))
        
        if (f_a < best_f) or ((f_a == best_f) and (np.linalg.norm(a - best_x) > np.linalg.norm(x - best_x))):
            x = a
            best_f = f_a
            
        if (f_b < best_f):
            x = b
            best_f = f_b
            
    return best_x
