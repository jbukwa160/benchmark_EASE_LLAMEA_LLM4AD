def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = None
    best_val = float('inf')
    
    for _ in range(budget):
        sol = np.zeros(dim)
        
        # Randomly sample a solution from the distribution of previous solutions
        for i in range(dim):
            mean = (lb + ub) / 2 if best_sol is None else np.mean(best_sol[:i])
            sigma = 1.0 if best_sol is None else np.std(best_sol[:i])
            sol[i] = rng.gauss(mean, sigma)
            
            # Clip the solution to the bounds
            sol[i] = max(lb, min(sol[i], ub))
        
        val = func(sol)
        print(f'Iteration {_}: {sol}, {val}')
        
        if val < best_val:
            best_sol = sol.copy()
            best_val = val
    
    return best_sol
