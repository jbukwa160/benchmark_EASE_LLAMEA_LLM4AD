def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    sigma = 1.0
    lambda_ = 2 * dim + 5
    mu = lambda_ // 2
    weights = [1 / (lambda_ - i) for i in range(lambda_)]

    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = np.random.randn(dim, lambda_)
        for j in range(lambda_):
            c = rng.uniform(lb, ub)
            y[:, j] *= sigma * (ub - lb) / 2 + c
            y[:, j] += x

        f = func(y)
        indices = np.argsort(f)[:mu]
        new_x = np.mean(y[:, indices], axis=1)

        for i in range(dim):
            if new_x[i] < lb:
                new_x[i] = (lb - x[i]) / sigma + x[i]
            elif new_x[i] > ub:
                new_x[i] = (ub - x[i]) / sigma + x[i]

        x = new_x
        f = func(x)

        if f < best_f:
            best_f = f
            best_x = x.copy()

    return best_x
