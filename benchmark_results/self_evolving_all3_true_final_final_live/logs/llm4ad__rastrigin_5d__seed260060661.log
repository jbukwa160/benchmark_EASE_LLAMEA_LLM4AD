def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.sqrt(budget))
    x = rng.uniform(lb, ub, size=(pop_size, dim))
    y = rng.uniform(lb, ub, size=(pop_size, dim))
    fval = np.zeros(pop_size)
    
    for i in range(pop_size):
        fval[i] = func(x[i])
        
    def adaptive_crossover():
        crossover_rate = 0.5 + (np.sin(np.sum(fval)) / np.sum(fval)) * 2
        return np.random.choice([True, False], pop_size, p=[crossover_rate, 1 - crossover_rate])
    
    def adaptive_mutation():
        mutation_rate = 0.1 + (np.mean(fval) / np.min(fval)) * 0.9
        return np.random.choice([True, False], pop_size, p=[mutation_rate, 1 - mutation_rate])
    
    for _ in range(budget):
        c = adaptive_crossover()
        m = adaptive_mutation()
        
        y[c & ~m] = x[c & ~m]
        y[~c & m] = x[~c & m] + rng.uniform(-0.5, 0.5, size=(pop_size, dim))
        
        for i in range(pop_size):
            if func(y[i]) < fval[i]:
                fval[i] = func(y[i])
                x[i] = y[i]
                
    return x[np.argmin(fval)]
