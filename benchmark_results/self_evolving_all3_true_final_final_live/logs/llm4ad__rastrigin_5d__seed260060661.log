def algorithm(func, dim, lb, ub, budget, rng):
    n = len(dim)
    D = 10 * n
    C1 = 2.05
    F = 0.5
    w_max = 0.9
    w_min = 0.4
    c1 = rng.uniform(0.1, 0.3)
    c2 = rng.uniform(c1, 0.5)
    d = (ub - lb) / 2

    best_solution = np.zeros(dim)
    best_fitness = func(best_solution)

    for _ in range(budget):
        w = w_max - (_ / budget) * (w_max - w_min)

        for i in range(n):
            x_i = best_solution[i] + rng.uniform(-d, d)
            v_i = (rng.uniform(0, 1) < c2) * (best_solution[i] - lb) + (rng.uniform(0, 1) > c2) * (ub - best_solution[i])
            u_i = w * x_i + (1 - w) * (v_i + rng.uniform(-d, d))

            if func(u_i) < best_fitness:
                best_solution[i] = u_i
                best_fitness = func(best_solution)

        for i in range(n):
            r1 = rng.uniform(0, 1)
            if r1 > c1:
                v_i = (rng.uniform(0, 1) < c2) * (best_solution[i] - lb) + (rng.uniform(0, 1) > c2) * (ub - best_solution[i])
                u_i = w * x_i + (1 - w) * (v_i + rng.uniform(-d, d))
                if func(u_i) < best_fitness:
                    best_solution[i] = u_i
                    best_fitness = func(best_solution)

            r2 = rng.uniform(0, 1)
            if r2 > C1:
                v_i = (rng.uniform(0, 1) < c2) * (best_solution[i] - lb) + (rng.uniform(0, 1) > c2) * (ub - best_solution[i])
                u_i = w * x_i + (1 - w) * (v_i + rng.uniform(-d, d))
                if func(u_i) < best_fitness:
                    best_solution[i] = u_i
                    best_fitness = func(best_solution)

        # clip solution to bounds
        best_solution = np.clip(best_solution, lb, ub)

    return best_solution
