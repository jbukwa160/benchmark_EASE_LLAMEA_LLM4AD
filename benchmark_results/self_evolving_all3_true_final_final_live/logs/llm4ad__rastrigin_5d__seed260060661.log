def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    n_starts = 10
    pop_size = 50
    max_iter = int(budget / n_starts)
    sigma = 1.0
    clusters = []

    for _ in range(n_starts):
        init_x = rng.uniform(lb, ub, size=(pop_size, dim))
        x_best = np.inf

        for _ in range(max_iter):
            y = bound(init_x + rng.normal(0, sigma, size=init_x.shape))

            # Apply Nelder-Mead optimization
            x_best_new = nelder_mead(y, func, lb, ub)

            if func(x_best_new) < x_best:
                init_x = y
                x_best = func(x_best_new)
            else:
                break

        clusters.append(init_x)

    # Adaptive clustering of initial points
    kmeans_init = np.vstack(clusters)
    kmeans = rng.choice(len(clusters), size=len(clusters))
    centroids = kmeans_init[kmeans]
    labels = np.argmin(np.linalg.norm(kmeans_init[:, None] - centroids, axis=2), axis=1)

    # Restart Nelder-Mead optimization
    for _ in range(5):
        init_x = centroids[labels]

        x_best = np.inf

        for i in range(max_iter * 2):
            y = bound(init_x + rng.normal(0, sigma, size=init_x.shape))

            # Apply Nelder-Mead optimization
            x_best_new = nelder_mead(y, func, lb, ub)

            if func(x_best_new) < x_best:
                init_x = y
                x_best = func(x_best_new)
            else:
                break

        centroids[labels] = init_x

    return x_best_new
