def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    bounds = [(lb, ub)] * D
    init_stddev = (ub - lb) / 3.0
    init_mean = [(ub + lb) / 2.0] * D
    
    def evaluate(population):
        return np.array([func(x) for x in population])

    def generate_samples(mean, stddev, popsize):
        return mean + stddev * rng.normal(size=(popsize, D))

    def clip_population(population, bounds):
        return np.clip(population, [b[0] for b in bounds], [b[1] for b in bounds])

    mu = 10
    popsize = 100
    lambda_ = int(popsize * (mu / D))
    
    population = generate_samples(np.array(init_mean), init_stddev, popsize)
    best_solution = np.inf
    
    for _ in range(budget):
        clipped_population = clip_population(population, bounds)
        
        fitness_values = evaluate(clipped_population)
        
        idx = np.argsort(fitness_values)[:lambda_]
        new_population = clipped_population[idx]
        
        mean = np.mean(new_population, axis=0)
        cov = np.cov(new_population.T) / (new_population.shape[0] - 1)
        
        # CMA-ES update
        for i in range(D):
            cov[i, i] += (ub - lb)**2 / 100.0  # dampening
        
        sample = mean + special.sqrtm(cov).dot(rng.normal(size=(D,)))
        new_solution = clip_population(sample.reshape(1, D), bounds)[0]
        
        if func(new_solution) < best_solution:
            best_solution = func(new_solution)
    
    return np.array([best_solution])
