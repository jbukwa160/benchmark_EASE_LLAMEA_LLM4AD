def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = 5 * rng.rand(dim) - 2.5
    best = func(x)
    for _ in range(budget-1):
        y = x + 0.1*rng.randn(dim)
        z = y + np.dot(np.linalg.inv(10*np.eye(dim)), (y-x))
        w = clip(z)
        new_best = func(w)
        if new_best < best:
            best = new_best
            x = w
    return x
