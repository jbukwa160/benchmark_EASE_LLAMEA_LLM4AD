def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = (np.random.rand(dim) * 2 - 1) * 5 + lb
    best_x = x.copy()
    best_f = func(x)
    f = best_f

    for _ in range(budget):
        y = x.copy() + rng.normal(size=dim, scale=0.01)
        y = clip(y)

        delta_f = func(y) - f

        if delta_f < 0:
            x = y
            f = func(x)
            best_x = np.where(best_f > f, x, best_x)
            best_f = np.where(best_f > f, f, best_f)

        elif rng.uniform(0, 1) < np.exp(-delta_f):
            x = y
            f = func(x)

    return best_x
