def algorithm(func, dim, lb, ub, budget, rng):
    def get_init_solution(rng, bounds):
        solution = np.zeros(dim)
        for i in range(dim):
            solution[i] = bounds[0][i] + (bounds[1][i] - bounds[0][i]) * rng.uniform()
        return solution

    def perturb(solution, sigma, lb, ub):
        perturbed_solution = np.copy(solution)
        for i in range(dim):
            perturbed_solution[i] += (rng.normal(0, 1) + 1) * sigma * (ub[i] - lb[i])
            if perturbed_solution[i] < lb[i]:
                perturbed_solution[i] = lb[i]
            elif perturbed_solution[i] > ub[i]:
                perturbed_solution[i] = ub[i]
        return perturbed_solution

    def accept_probability(current_fitness, previous_fitness, temperature):
        return np.exp((previous_fitness - current_fitness) / temperature)

    def simulated_annealing(solution, temperature, lb, ub, func, rng, budget):
        best_solution = solution
        best_fitness = func(solution)
        
        iteration = 0
        while iteration < budget:
            perturbed_solution = perturb(solution, 1, lb, ub)
            perturbed_fitness = func(perturbed_solution)
            
            if perturbed_fitness <= best_fitness or rng.uniform() < accept_probability(best_fitness, perturbed_fitness, temperature):
                solution = perturbed_solution
                best_solution = solution
                best_fitness = perturbed_fitness
                
            temperature *= 0.99
            
            iteration += 1
        
        return best_solution
    
    init_solution = get_init_solution(rng, [[-5]*dim, [5]*dim])
    best_solution = simulated_annealing(init_solution, 100, [-5]*dim, [5]*dim, func, rng, budget)
    
    return best_solution
