def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    gp_model = GaussianProcess(kernel=np.squared_exponential(length_scale=1),
                               noise_var=1e-8)
    gp_model.fit(x, func(x))
    
    for _ in range(budget - 1):
        mu, sigma = gp_model.predict(np.atleast_2d(x), return_std=True)
        x_new = x + rng.normal(size=x.shape) * np.sqrt(sigma)
        
        # Clip to bounds
        x_new = np.clip(x_new, lb, ub)
        
        y_new = func(x_new)
        
        if y_new < func(x):
            gp_model.fit(np.vstack((x, x_new)), np.hstack((func(x), y_new)))
            x = x_new
            
    return x
