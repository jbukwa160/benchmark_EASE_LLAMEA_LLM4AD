def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    step_size = 1.0
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
        
        if np.linalg.norm(best_x - lb) > 1e-6 and budget - _ <= 10000 * dim:
            step_size *= 0.9
            
        elif np.linalg.norm(best_x - ub) > 1e-6 and budget - _ <= 10000 * dim:
            step_size *= 0.9
        
        x = best_x + rng.uniform(-step_size, step_size, size=dim)
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
    
    return best_x
