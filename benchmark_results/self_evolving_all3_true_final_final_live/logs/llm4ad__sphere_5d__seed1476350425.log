def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(x):
        return x + rng.randn(dim)

    def clip(candidate, lb, ub):
        clipped = np.clip(candidate, lb, ub)
        if not np.all(clipped == candidate):
            return clipped
        return candidate

    def evaluate(candidate):
        return func(candidate), None  # No gradient information needed

    population_size = 50
    step_size = 1.0 / dim

    x = rng.uniform(lb, ub, size=dim)
    best_x = np.copy(x)

    for i in range(budget):
        candidates = [generate_candidate(np.copy(x)) for _ in range(population_size)]
        clipped_candidates = [clip(candidate, lb, ub) for candidate in candidates]
        scores, _ = map(evaluate, clipped_candidates)

        x = np.array([c for _, c in sorted(zip(scores, clipped_candidates))[:1]])
        best_x = np.minimum(best_x, x)
        step_size *= 0.9995

    return best_x
