def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 32
    sigma = 1.0
    mu = 0.5 * pop_size
    lambda_ = 10
    pc = 1. / (3 + 2 * np.log(pop_size))

    x = np.random.uniform(lb, ub, [pop_size, dim])
    y = func(x)
    best_idx = np.argmin(y)

    for i in range(budget):
        z = x[np.random.choice(pop_size, lambda_, replace=False)]
        v = 0.5 * (np.random.rand(lambda_, dim) - 0.5)
        w = sigma * v
        u = x[best_idx] + mu * w

        for j in range(lambda_):
            z[j] = np.clip(u + z[j], lb, ub)

        y = func(z)
        best_idx = np.argmin(y)

        if i % 100 == 0:
            print(f"Iteration {i+1}, Best value: {np.min(y)}")

    return x[best_idx]
