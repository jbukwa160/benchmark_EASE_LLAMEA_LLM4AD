def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    r = 5.0  # initial perturbation radius
    
    for i in range(budget):
        if i > 10 and abs(f_best) < 1e-4:
            break
        
        x = x_best + rng.uniform(-r, r, size=dim)
        
        # clip to bounds
        x = np.clip(x, lb, ub)
        
        f = func(x)
        
        if f < f_best:
            f_best = f
            x_best = x
    
    return x_best
