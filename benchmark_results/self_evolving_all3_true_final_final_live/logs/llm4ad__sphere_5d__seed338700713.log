def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.ones(dim)
    f_best = float('inf')
    
    for _ in range(budget):
        while True:
            x_new = x_best + rng.normal(size=dim) * 0.1
            x_new = np.clip(x_new, lb, ub)
            
            if func(x_new) < f_best or _ % 100 == 0:  # accept new candidate every 100 iterations
                x_best = x_new
                f_best = func(x_best)
                
    return x_best
