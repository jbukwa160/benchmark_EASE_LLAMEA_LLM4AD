def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        x_new = x + 0.1 * (ub - lb) * np.random.normal(size=dim)
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new

        alpha = rng.uniform(0.01, 1.0)
        x_mix = alpha * x + (1 - alpha) * best_x
        x_mix = np.clip(x_mix, lb, ub)

        f_mix = func(x_mix)
        if f_mix < best_f:
            best_x = x_mix.copy()
            best_f = f_mix

    return best_x
