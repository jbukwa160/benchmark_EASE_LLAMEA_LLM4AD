def algorithm(func, dim, lb, ub, budget, rng):
    def objective(params):
        params = np.clip(params, lb, ub)
        return func(params)

    def expected_improvement(current_best, X, y, x_new):
        mu, sigma = gaussian_process.predict(np.array([x_new]), 
                                            eval_MSE=True)
        with np.errstate(divide='ignore', invalid='ignore'):
            improvement = (mu - current_best) * np.exp(-((x_new - gaussian_process.X).T @ gaussian_process.K_inv @ (x_new - gaussian_process.X)) / 2)
            var = mu**2 * sigma + np.exp(-(x_new - gaussian_process.X).T @ gaussian_process.K @ (x_new - gaussian_process.X))
        return improvement

    def acquisition_function(X, y, x_new):
        mu, sigma = gaussian_process.predict(np.array([x_new]), 
                                            eval_MSE=True)
        with np.errstate(divide='ignore', invalid='ignore'):
            pi = 1 / (1 + ((x_new - X).T @ np.linalg.inv(sigma) @ (x_new - X)) / len(X))
            return pi * expected_improvement(np.max(y), X, y, x_new)

    def add_candidate(x_new):
        nonlocal current_best
        new_x = np.array([x_new])
        new_y = np.array([objective(new_x)])
        gaussian_process.update(new_x, new_y)
        current_best = max(current_best, new_y[0])

    dim = int(dim)
    lb = np.repeat(lb, dim)
    ub = np.repeat(ub, dim)

    budget = int(budget)
    rng = np.random.default_rng(rng)

    X = []
    y = []

    current_best = -np.inf

    gaussian_process = GaussianProcess(kernel=Matern52(), 
                                       noise_var=1e-10, 
                                       fit_gpr=True)

    for _ in range(budget):
        x_new = rng.uniform(lb, ub, size=dim)
        acquisition_value = acquisition_function(np.array(X), np.array(y), x_new)
        if acquisition_value > 0:
            add_candidate(x_new)

    best_x = X[np.argmax(y)]
    return best_x
