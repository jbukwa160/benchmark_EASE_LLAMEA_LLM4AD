def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        f = 0.5 * func(x)
        e = np.zeros(dim)
        for i in range(1, dim):
            e[i] += (x[i-1]**2 - x[i])**3
        for i in range(dim):
            if rng.rand() < 0.01:
                alpha = 0.05
            else:
                alpha = 0.02
            step = alpha * e / np.linalg.norm(e)
            x_i = x.copy()
            x_i[i] += step[i]
            x_i = np.clip(x_i, lb, ub)
            f_i = func(x_i)
            if f_i < f:
                x = x_i
                f = f_i
            else:
                step *= -1
                x_i = x.copy()
                x_i[i] += step[i]
                x_i = np.clip(x_i, lb, ub)
                f_i = func(x_i)
                if f_i < f:
                    x = x_i
                    f = f_i

        if f < best_f:
            best_f = f
            best_x = x.copy()

    return best_x
