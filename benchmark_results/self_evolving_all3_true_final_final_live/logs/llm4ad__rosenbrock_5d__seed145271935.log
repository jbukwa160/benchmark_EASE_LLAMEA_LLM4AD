def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.array([1.0]*dim)
    best_x = np.copy(x)
    best_y = func(x)
    grad = np.zeros(dim)

    for _ in range(budget):
        for i in range(dim):
            x_new = clip(x + 0.01 * rng.randn(dim))
            if func(x_new) < best_y:
                best_y = func(x_new)
                best_x = np.copy(x_new)
            grad[i] = (func(clip(x + 1e-6 * np.eye(i))) - func(clip(x - 1e-6 * np.eye(i)))) / (2.0 * 1e-6)
        step_size = 0.01
        for i in range(dim):
            x[i] -= step_size * grad[i]
    return best_x
