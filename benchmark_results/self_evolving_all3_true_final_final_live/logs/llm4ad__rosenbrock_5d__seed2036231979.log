def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    lr = 2.0
    
    for _ in range(budget - 1):
        s = np.zeros(dim)
        
        for i in range(dim):
            if rng.random() < 0.5:
                s[i] += rng.normal(0, lr / (i + 1))
            else:
                s[i] -= rng.normal(0, lr / (i + 1))
        
        x_new = x[0] + s
        for i in range(dim):
            if x_new[i] < lb:
                x_new[i] = lb
            elif x_new[i] > ub:
                x_new[i] = ub
        
        f_new = func(x_new)
        
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new
            lr *= 0.9
        
        x[0] += rng.normal(0, 1) * s / np.linalg.norm(s)
    
    return best_x
