def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    y_best = np.inf
    for _ in range(budget):
        X = rng.uniform(lb, ub, size=(dim,))
        Y = func(X)
        if Y < y_best:
            x_best = X
            y_best = Y
        mu, sigma = 0.1 * np.ones(dim), 0.5 * np.ones(dim) + 0.2 * rng.uniform(-1, 1, size=dim)
        PI = norm.cdf((func(X) - y_best)/(sigma))
        pi = PI.mean()
        if pi > 0.05:
            X_new = x_best + sigma * rng.normal(size=dim)
            Y_new = func(np.clip(X_new, lb, ub))
            if Y_new < y_best:
                x_best = X_new
                y_best = Y_new
    return np.clip(x_best, lb, ub)
