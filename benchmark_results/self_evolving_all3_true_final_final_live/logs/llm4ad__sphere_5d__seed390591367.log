def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(dim, pop_size):
        return rng.uniform(lb, ub, size=(pop_size, dim))

    def simulate_annealing(population, temperature, func, dim):
        best_candidate = population[np.argmin([func(clip(x)) for x in population])]
        new_population = population.copy()
        
        for i in range(len(new_population)):
            mutation = rng.normal(size=dim)
            new_population[i] += 0.1 * mutation
            if np.random.rand() < np.exp(-(func(clip(new_population[i])) - func(best_candidate)) / temperature):
                new_population[i] = clip(new_population[i])
        
        return new_population, best_candidate

    def differential_evolution(population, dim):
        populations = [population]
        for _ in range(budget // len(populations)):
            offspring = population.copy()
            for i in range(len(offspring)):
                indices = np.random.choice(len(populations), 3, replace=False)
                parent1, parent2, parent3 = populations[indices[0]], populations[indices[1]], populations[indices[2]]
                mutation = (np.random.uniform(ub, lb) + rng.normal(size=dim)) * 0.5
                offspring[i] += mutation * np.random.choice([parent1[i], parent2[i], parent3[i]])
            offspring = clip(offspring)
            population = np.concatenate((population, offspring))
        return population

    def optimize(func, dim, lb, ub, budget):
        pop_size = int(np.sqrt(budget))
        temperature = 100
        initial_population = generate_initial_population(dim, pop_size)
        
        for _ in range(pop_size):
            new_population, best_candidate = simulate_annealing(initial_population, temperature, func, dim)
            temperature *= 0.99
            initial_population = new_population
        
        return differential_evolution(initial_population, dim)

    optimized_solution = optimize(func, dim, lb, ub, budget)
    return np.array([np.min(optimized_solution)])
