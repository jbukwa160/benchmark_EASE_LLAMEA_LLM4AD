def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    y_best = float('inf')
    
    for _ in range(budget):
        idx = rng.randint(0, dim)
        step = (rng.uniform(lb[idx], ub[idx]) - x[idx]) / np.sqrt(_ + 1)
        x[idx] += step
        x = np.clip(x, lb, ub)
        
        y = func(x)
        
        if y < y_best:
            y_best = y
            x_best = x.copy()
    
    return x_best
