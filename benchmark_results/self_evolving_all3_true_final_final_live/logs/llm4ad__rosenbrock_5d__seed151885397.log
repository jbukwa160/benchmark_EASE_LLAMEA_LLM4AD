def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.array([1.0]*dim)
    v = np.zeros(dim)
    g = np.zeros(dim)

    for _ in range(budget):
        if rng.random() < 0.5:
            v = (v + rng.uniform(-1, 1, dim)) / 2
            x = clip(x + v)
        else:
            g = -np.ones(dim)
            for i in range(1, dim):
                g[i-1] += func(np.insert(clip(x), i, [x[i]+0.01]))
            v = (v + 0.5 * np.dot(g, np.linalg.solve(np.eye(dim) - np.outer(v, v)/dim**2, g))) / 2
            x = clip(x + v)

    return x
