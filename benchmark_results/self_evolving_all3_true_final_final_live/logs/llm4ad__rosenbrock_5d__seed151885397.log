def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)
    temperature = 1.0

    for _ in range(budget):
        # Simulated annealing
        new_x = clip(x + rng.normal(size=dim, loc=0, scale=np.sqrt(temperature)))
        new_f = func(new_x)

        if new_f < best_f:
            x = new_x.copy()
            best_f = new_f
            best_x = x.copy()

        # Decrease temperature
        temperature *= 0.999

    return best_x
