def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    initial_population = np.random.uniform(lb, ub, size=(budget, dim))
    current_best = func(initial_population)
    best_so_far = current_best
    temperature = 10

    for i in range(budget - 1):
        new_population = rng.normal(loc=initial_population[i], scale=0.1 * (ub - lb), size=(dim,))
        new_population = clip(new_population.reshape(-1, dim))
        
        new_cost = func(new_population)
        acceptance_probability = np.exp((current_best - new_cost) / temperature)

        if new_cost < current_best:
            initial_population[i+1] = new_population
            current_best = new_cost
            best_so_far = min(best_so_far, current_best)
        else:
            if rng.random() < acceptance_probability:
                initial_population[i+1] = new_population
                current_best = new_cost

        temperature *= 0.9999

    return clip(initial_population[np.argmin(func(initial_population))])
