def algorithm(func, dim, lb, ub, budget, rng):
    def is_feasible(x):
        return np.all(lb <= x) and np.all(x <= ub)

    def generate_candidate(current_solution, dithering_factor):
        candidate = current_solution + dithering_factor * (ub - lb)
        return np.clip(candidate, lb, ub)

    def cooling_schedule(budget_used):
        # Simple adaptive cooling schedule
        if budget_used < 0.5 * budget:
            return 1
        elif budget_used < 0.8 * budget:
            return 0.5
        else:
            return 0.01

    current_solution = rng.uniform(lb, ub, size=dim)
    best_solution = current_solution.copy()
    best_fitness = func(current_solution)

    for _ in range(budget):
        dithering_factor = np.random.normal(loc=1, scale=0.2)  # Dithering factor
        candidate = generate_candidate(current_solution, dithering_factor)
        new_fitness = func(candidate)
        
        if is_feasible(candidate) and new_fitness < best_fitness:
            current_solution = candidate.copy()
            best_solution = current_solution.copy()
            best_fitness = new_fitness

        temperature = cooling_schedule(budget - _)

        # Simulated annealing
        accept_prob = np.exp((best_fitness - new_fitness) / temperature)
        if rng.random() < accept_prob:
            current_solution = candidate.copy()

    return best_solution
