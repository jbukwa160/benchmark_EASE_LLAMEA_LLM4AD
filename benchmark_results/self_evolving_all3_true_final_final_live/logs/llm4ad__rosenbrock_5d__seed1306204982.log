def algorithm(func, dim, lb, ub, budget, rng):
    def rosenbrock(x):
        return func(x)

    sigma = 0.5 * (ub - lb)
    mu = (ub + lb) / 2
    x = np.random.uniform(lb, ub, size=(dim,))
    lambda_ = int(1e-3 * dim)
    c1 = 1
    c2 = 2
    weights = [c1 if i == 0 else c2 for i in range(lambda_)]

    for _ in range(budget):
        y = np.random.multivariate_normal(mu, sigma ** 2 * np.eye(dim), size=lambda_)
        f_y = rosenbrock(y)
        u = np.random.uniform(0, 1, size=dim)

        for i in range(lambda_):
            z = mu + (y - mu) * u
            if not np.any(z < lb) and not np.any(z > ub):
                f_z = rosenbrock(z)
                if f_z < f_y:
                    y = z
                    f_y = f_z

        for i in range(lambda_):
            x_i = mu + (y - mu) * weights[i]
            if not np.any(x_i < lb) and not np.any(x_i > ub):
                f_xi = rosenbrock(x_i)
                if f_xi < f_y:
                    y = x_i
                    f_y = f_xi

        sigma *= 0.1 + (ub - lb) / (2 * lambda_)
        mu = mu + (y - mu) / (1 + np.sqrt(np.sum((y - mu) ** 2) / (sigma ** 2)))

    return y
