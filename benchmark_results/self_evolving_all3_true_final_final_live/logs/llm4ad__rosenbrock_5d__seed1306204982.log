def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    def simulate_annealing():
        x = rng.uniform(low=lb, high=ub, size=(dim,))
        T = 1e4
        alpha = 0.9
        beta = 0.9995
        t = 0

        while t < budget:
            y = rng.uniform(low=lb, high=ub, size=(dim,))
            delta_f = objective(y) - objective(x)
            if delta_f <= 0:
                x = y
            else:
                p = np.exp(-delta_f / T)
                r = rng.uniform(0, 1)
                if r < p:
                    x = y

            T *= beta
            t += 1

        return x

    best_x = None
    best_f = float('inf')

    for _ in range(10):
        x = simulate_annealing()
        f = objective(x)

        if f < best_f:
            best_f = f
            best_x = x

    return np.clip(best_x, lb, ub)
