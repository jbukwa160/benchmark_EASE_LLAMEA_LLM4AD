def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    x_best = x.copy()
    best_fitness = func(x)

    for _ in range(budget):
        v = rng.uniform(lb, ub, size=dim) + rng.normal(size=dim)
        y = x + 0.5 * (v - x)

        # Clip candidates to [lb, ub]
        y = np.clip(y, lb, ub)

        fitness_y = func(y)
        if fitness_y < best_fitness:
            x_best = y.copy()
            best_fitness = fitness_y

        # Simulated Annealing
        T = 1.0
        alpha = 0.9
        delta_fitness = fitness_y - best_fitness
        if delta_fitness < 0 or np.random.rand() < np.exp(-delta_fitness / T):
            x = y.copy()

        # Local Search (DE)
        for i in range(dim):
            v[i] = rng.uniform(lb, ub) + rng.normal(size=dim)
            y[i] = x_best[i] + 0.5 * (v[i] - x_best[i])
            fitness_y = func(y)

            if fitness_y < best_fitness:
                x_best = y.copy()
                best_fitness = fitness_y

        T *= alpha

    return x_best
