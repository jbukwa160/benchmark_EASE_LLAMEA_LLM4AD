def algorithm(func, dim, lb, ub, budget, rng):
    def init_gp(x):
        return np.random.uniform(-1, 1, size=dim)

    def acquisition(x):
        return np.sum((x[:-1] - x[1:]**2)**2) + np.sum((1-x)**2)

    best_x = np.array([np.random.uniform(lb, ub)] * dim)
    best_f = func(best_x)

    gp = init_gp(best_x)

    for _ in range(budget):
        X = [best_x]
        Y = [best_f]

        for _ in range(10):  # Number of iterations
            x = gp.predict(np.array([rng.uniform(lb, ub) for _ in range(dim)]))
            x = np.clip(x, lb, ub)

            f = func(x)
            X.append(x)
            Y.append(f)

            gp = init_gp(x)

        x = gp.predict(np.array([rng.uniform(lb, ub) for _ in range(dim)]))
        x = np.clip(x, lb, ub)

        f = func(x)
        if f < best_f:
            best_x = x
            best_f = f

    return best_x
