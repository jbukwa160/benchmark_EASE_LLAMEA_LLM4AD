def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    x0 = (np.random.uniform(lb, ub) for _ in range(dim))
    best_x = np.array(list(x0))

    T = 10000
    t = 0

    while t < budget:
        x = np.array([np.clip(i, lb, ub) for i in list(np.add(best_x, rng.normal(0, 1, dim)))])
        fx = evaluate(x)

        if t > 0 and np.random.rand() < np.exp(-(fx - evaluate(best_x)) / T):
            best_x = x

        t += 1
        T *= 0.99

    return best_x
