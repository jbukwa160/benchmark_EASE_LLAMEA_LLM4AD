def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 10 + int(budget * 0.1)
    x_best = np.random.uniform(lb, ub, (pop_size, dim))
    y_best = func(x_best)

    for _ in range(budget):
        f_x = func(np.clip(x_best, lb, ub))
        if f_x < np.min(y_best):
            y_best = f_x
            best_idx = np.argmin(y_best)
            x_best[best_idx] = np.random.uniform(lb, ub, dim)

        for i in range(pop_size):
            v = np.clip(x_best[i], lb, ub) + rng.normal(0, 1, (dim,))
            u = np.random.randint(0, pop_size, size=3)
            a = x_best[u[0]]
            b = x_best[u[1]]
            c = x_best[u[2]]

            f_v = func(np.clip((a * 0.5) + v, lb, ub)) if rng.uniform(0, 1) < 0.7 else \
                  func(np.clip((b - c + a * 0.3) + v, lb, ub))

            if f_v < y_best[i]:
                x_best[i] = np.clip(v, lb, ub)
                y_best[i] = f_v

    return np.argmin(y_best)
