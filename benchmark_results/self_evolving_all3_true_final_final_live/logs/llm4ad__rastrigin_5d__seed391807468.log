def algorithm(func, dim, lb, ub, budget, rng):
    best_x = rng.uniform(lb, ub, size=dim)
    best_y = func(best_x)
    
    T = 10.0
    cooling_rate = 0.99
    
    for _ in range(budget):
        new_x = best_x + (ub - lb) * rng.normal(size=dim)
        new_x = np.clip(new_x, lb, ub)
        
        new_y = func(new_x)
        
        if new_y < best_y:
            best_x = new_x
            best_y = new_y
            
        elif rng.uniform(0, 1) < np.exp((best_y - new_y) / T):
            best_x = new_x
            best_y = new_y
        
        T *= cooling_rate
    
    return best_x
