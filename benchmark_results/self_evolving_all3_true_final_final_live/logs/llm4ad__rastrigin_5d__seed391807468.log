def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(budget):
        population = np.zeros((budget, dim))
        for i in range(dim):
            x_i = (ub - lb) * rng.rand(budget) + lb
            population[:, i] = x_i
        return population

    best_solution = None
    best_value = 1e9

    population = generate_initial_population(budget)

    for generation in range(budget):
        f_values = np.array([func(x) for x in bound(population)])
        best_idx = np.argmin(f_values)
        if f_values[best_idx] < best_value:
            best_solution = bound(population[best_idx])
            best_value = f_values[best_idx]

        mutation_strategies = [
            lambda x, population: (x + 0.5 * rng.randn(dim)),
            lambda x, population: (x + 1.0 * rng.randn(dim)),
            lambda x, population: (x - 2.0 * rng.randn(dim))
        ]

        for i in range(budget):
            mutation = np.random.choice(mutation_strategies)
            candidate = bound(population[i] + mutation(population[i], population))

            f_value = func(candidate)

            if f_value < best_value:
                population[i] = candidate

    return best_solution
