def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(current_solution, step_size):
        candidate = current_solution + step_size * rng.normal(size=dim)
        return np.clip(candidate, lb, ub)

    best_solution = rng.uniform(lb, ub, size=dim)
    best_fitness = func(best_solution)

    for _ in range(budget):
        step_size = 0.1 / (0.9 ** (_ // 100))  # Adaptively decrease the step size
        candidate = generate_candidate(best_solution, step_size)
        candidate_fitness = func(candidate)
        
        if candidate_fitness < best_fitness:
            best_solution = candidate
            best_fitness = candidate_fitness

    return best_solution
