def algorithm(func, dim, lb, ub, budget, rng):
    x0 = (ub - lb) * rng.rand(dim) + lb
    gp = GaussianProcess(x0, func, 1e-6)
    best_x, best_f = None, np.inf
    while True:
        if budget <= 0:
            break
        alpha, sigma, mu = gp.predict(x0)
        x_new = x0 + (ub - lb) * norm.rvs(loc=mu/sigma**2, scale=sigma, size=(dim,), rng=rng)
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)
        if f_new < best_f:
            best_x, best_f = x_new, f_new
        gp.update(x0, f_new)
        budget -= 1
        x0 += (ub - lb) * norm.rvs(loc=mu/sigma**2, scale=sigma, size=(dim,), rng=rng)
        x0 = np.clip(x0, lb, ub)
    return best_x
