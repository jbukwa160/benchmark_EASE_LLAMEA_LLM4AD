def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(x, s, p, c1, c2):
        x_new = x + s * (p[0] - 2*c1*x[0] + c2*np.random.uniform(-1, 1))
        for i in range(1, dim):
            x_new[i] += s * (p[i] - 2*c1*x[i] + c2*np.random.uniform(-1, 1))
        return np.clip(x_new, lb, ub)

    def crossover(u, v, cr):
        if np.random.rand() < cr:
            u = mutate(v, rng.randn(), u, 0.6, 0.3)
        return u

    population_size = 50
    pop = rng.uniform(lb, ub, (population_size, dim))
    budget_left = budget
    best_solution = None
    best_fitness = float('inf')

    while budget_left > 0:
        for i in range(population_size):
            x_new = crossover(pop[i], np.zeros(dim), 0.5)
            fitness = func(x_new)
            if fitness < best_fitness:
                best_fitness = fitness
                best_solution = x_new
            pop[i] = x_new

        budget_left -= 1

    return best_solution
