def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array(rng.uniform(lb, ub, size=dim))
    best = func(x)
    step_size = max(ub - lb, 1e-5)

    for _ in range(budget - 1):
        while True:
            candidate = x + rng.uniform(-step_size, step_size, size=dim)
            candidate = np.clip(candidate, lb, ub)
            if not np.allclose(x, candidate) and func(candidate) < best:
                x = candidate
                best = func(x)
                break
            elif np.linalg.norm(step_size) < 1e-8:
                step_size *= 0.5
            else:
                step_size /= 2

    return x
