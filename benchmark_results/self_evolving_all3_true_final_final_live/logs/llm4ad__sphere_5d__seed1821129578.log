def algorithm(func, dim, lb, ub, budget, rng):
    def wrapper(x):
        return func(x)

    result = differential_evolution(wrapper, [(lb, ub)]*dim, x0=rng.uniform(lb, ub, size=dim), polish=True)
    
    best_x = np.clip(result.x, a_min=lb, a_max=ub)
    best_f = wrapper(best_x)
    
    for _ in range(budget-1):
        result = differential_evolution(wrapper, [(lb, ub)]*dim, x0=np.clip(best_x + rng.uniform(-1, 1, size=dim), a_min=lb, a_max=ub), polish=True)
        
        candidate_x = np.clip(result.x, a_min=lb, a_max=ub)
        candidate_f = wrapper(candidate_x)

        if candidate_f < best_f:
            best_x = candidate_x
            best_f = candidate_f

    return best_x
