def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 10 * dim
    sigma = 1.0
    mu = np.zeros(dim)
    cov = np.eye(dim)
    x_best = np.zeros(dim)

    for _ in range(budget):
        # Generate new candidates by sampling from the multivariate normal distribution
        noise = rng.randn(pop_size, dim) * sigma
        x_new = mu + np.dot(np.linalg.cholesky(cov), noise.T).T

        # Clip candidates to bounds
        x_new = np.clip(x_new, lb, ub)

        # Evaluate new candidates
        y_new = func(x_new)

        # Update the population's performance and adapt the step size
        pop_perf = np.min(y_new)
        if pop_perf < func(mu):
            mu = x_new[np.argmin(y_new)]
            cov = (1 - 2 / (len(y_new) + 1)) * cov + 1 / (len(y_new) + 1) * noise @ noise.T
            sigma *= np.exp((pop_perf - func(mu)) / (4 * dim))
        else:
            sigma /= np.exp((func(mu) - pop_perf) / (4 * dim))

    return mu
