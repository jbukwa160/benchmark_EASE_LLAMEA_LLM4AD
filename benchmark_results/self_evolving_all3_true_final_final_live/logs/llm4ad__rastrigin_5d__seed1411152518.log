def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    pop = np.random.uniform(lb, ub, (budget, dim))
    best = None

    for t in range(budget):
        # Select three random solutions
        a, b, c = rng.choice(pop, 3, replace=False)
        
        # Calculate the trial solution using Differential Evolution formula
        trial = bound(a + 0.5 * (b - c))
        
        # Evaluate the objective function at the trial solution and best solution
        f_trial = func(trial)
        if best is None or f_trial < func(best):
            best = trial
        
    return best
