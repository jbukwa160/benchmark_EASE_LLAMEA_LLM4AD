def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def rastrigin(x):
        return func(10 * x.shape[0]) + np.sum(x**2 - 10 * np.cos(2 * np.pi * x))

    pop_size = int(np.sqrt(budget))
    pop = rng.uniform(lb, ub, (pop_size, dim))
    best = np.inf
    archive = []
    
    for i in range(budget):
        if len(archive) < pop_size:
            f_values = [rastrigin(x) for x in pop]
            idx = np.argsort(f_values)
            archive.extend(pop[idx])
            archive = archive[:pop_size]

        # Mutation
        mutated_pop = []
        for _ in range(pop_size):
            parent1, parent2, parent3 = rng.choice(archive, 3, replace=False)
            v = 0.5 * (parent1 + parent2) + 0.5 * rng.uniform(-1, 1) * (parent3 - parent1)
            mutated_pop.append(clip(v, lb, ub))

        # Crossover
        crossover_rate = np.random.rand(pop_size)
        children = []
        for x, m in zip(pop, mutated_pop):
            if rng.random() < crossover_rate:
                c = 0.5 * (x + m)
            else:
                c = x
            children.append(clip(c, lb, ub))

        # Selection
        f_values = [rastrigin(x) for x in children]
        idx = np.argsort(f_values)
        pop = np.array(children[idx])
        
        if i % 100 == 0 or f_values[0] < best:
            best = f_values[0]
            archive = []
        if len(archive) < pop_size and f_values[0] < best:
            archive.append(pop[0])
    
    return pop[0]
