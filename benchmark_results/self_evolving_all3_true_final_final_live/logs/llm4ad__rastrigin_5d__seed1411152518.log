def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    x = 0.5 * (ub - lb) * rng.rand(dim) + lb
    sigma = 2.1
    lambda_ = int(np.ceil(4 * np.sqrt(dim)))
    mu = int(lambda_ / 2)
    best_x = x.copy()
    best_f = evaluate(x)

    for i in range(budget):
        y = x + rng.randn(dim) * sigma
        y = np.clip(y, lb, ub)
        f_y = evaluate(y)
        
        if f_y < best_f:
            best_f = f_y
            best_x = y.copy()
            
        u = rng.rand(mu)
        u = np.sort(u)
        u = u[1:lambda_-1]  # remove the two smallest values
        indices = np.argsort(np.abs(y - x))
        
        for j in range(lambda_):
            k = indices[j]
            if u[j % (lambda_-2)] < 0.5:
                y[k] += rng.randn() * sigma * 0.01
            else:
                y[k] -= rng.randn() * sigma * 0.01
        
        y = np.clip(y, lb, ub)
        
    return best_x
