def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def generate_initial_population(size, bounds):
        population = np.zeros((size, dim))
        for i in range(dim):
            population[:, i] = rng.uniform(lb, ub, size)
        return population

    def differential_evolution(population, func, lb, ub, budget):
        for _ in range(budget // 2):
            differences = np.random.permutation(population) - population
            indices = np.argsort(np.linalg.norm(differences, axis=1))
            population[indices[:int(0.1 * size)]] += 0.01 * differences[indices[:int(0.1 * size)]]
        return population

    def random_search(population, func, lb, ub, budget):
        for _ in range(budget // 2):
            new_candidate = clip(rng.uniform(lb, ub, dim))
            if func(new_candidate) < func(population[np.random.choice(size), :]):
                population[np.random.choice(size)] = new_candidate
        return population

    size = 50  # initial population size
    population = generate_initial_population(size, (lb, ub))
    for _ in range(budget // 2):
        population = differential_evolution(population, func, lb, ub, budget // 4)
        population = random_search(population, func, lb, ub, budget // 4)

    best_candidate = clip(population[np.argmin([func(candidate) for candidate in population]), :])
    return best_candidate
