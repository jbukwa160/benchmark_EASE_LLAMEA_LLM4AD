def algorithm(func, dim, lb, ub, budget, rng):
    def wrapper(x):
        return func(x)

    bounds = [(lb, ub) for _ in range(dim)]
    res_de = differential_evolution(wrapper, bounds, x0=np.random.uniform(lb, ub, (1, dim)))[0]
    
    pop_size = 10 * dim
    mu = np.zeros(dim)
    sigma = 1.0
    lambda_ = int(pop_size / 2)
    weights = [1.0 / lambda_ for _ in range(lambda_)]

    best_x = res_de
    best_f = wrapper(best_x)

    for i in range(budget):
        offspring = []
        for j in range(int(pop_size/2)):
            z = rng.normal(mu, sigma, dim)
            x_new = np.array(best_x) + z
            y_new = func(x_new)
            
            if y_new < best_f:
                best_f = y_new
                best_x = x_new
            
            offspring.append(np.array([best_x, x_new]))
        
        # Covariance Matrix Adaptation Evolution Strategy (CMA-ES)
        for k in range(lambda_):
            z = norm.rvs(loc=mu, scale=sigma, size=(1, dim))
            x_new = mu + sigma * np.exp(z)
            
            y_new = func(x_new)
            
            if y_new < best_f:
                best_f = y_new
                best_x = x_new
        
        # Update CMA-ES parameters
        sigma += 0.05 * rng.normal(0, 1)  # increase standard deviation with probability 0.05

    return np.clip(best_x, lb, ub)
