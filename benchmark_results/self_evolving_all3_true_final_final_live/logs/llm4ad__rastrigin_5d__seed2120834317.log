def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    C1 = 0.5 + (rng.rand() - 0.5) * 0.3
    C2 = 0.5 + (rng.rand() - 0.5) * 0.3
    F = rng.uniform(0.9, 1.1)
    M = np.random.choice(dim, size=dim, replace=False)

    for i in range(budget):
        x_new = x_best + C1*(x_best - x_best[M]) + C2*np.random.uniform(-1, 1, size=dim)
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)

        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
