def algorithm(func, dim, lb, ub, budget, rng):
    def acceptance_probability(new_fitness, old_fitness, T):
        if new_fitness < old_fitness:
            return 1.0
        else:
            return np.exp((old_fitness - new_fitness) / T)

    def simulated_annealing(x0, T, max_iter, func):
        x = x0.copy()
        for i in range(max_iter):
            y = rng.normal(size=x.shape)
            if i == 0 or rng.rand() < np.exp(-(func(y) - func(x)) / T):
                x = y
            T *= 0.999
        return x

    def cma_es(x0, dim, lb, ub, budget, rng):
        mu = rng.randn(dim)
        lambda_ = 10
        sigma = 1e-3 + rng.rand() * 2e-3
        mean_history = [mu]
        std_history = [sigma]

        for i in range(budget - dim):
            new_mu = mu.copy()
            y = np.zeros(lambda_)
            for j in range(lambda_):
                y[j] = new_mu + sigma * rng.randn(dim)
                y[j] = np.clip(y[j], lb, ub)

            new_mu = np.mean(y[:int(0.1 * lambda_)], axis=0) if i < 10 else np.mean(y, axis=0)
            new_sigma = (np.sum(np.dot((y - new_mu[:, None]), (y - new_mu[:, None]).T)) / lambda_ + sigma**2) ** 0.5

            mean_history.append(new_mu.copy())
            std_history.append(new_sigma)

            if rng.rand() < 1e-3:
                mu = new_mu
                sigma = new_sigma

        return np.mean(mean_history[-10:], axis=0), np.mean(std_history[-10:])

    x0 = (ub - lb) * rng.rand(dim) + lb
    cma_es_solution, _ = cma_es(x0, dim, lb, ub, budget // 2, rng)
    sa_solution = simulated_annealing(cma_es_solution, 1e5 * np.mean(std_history[-10:]), budget // 2, func)

    return np.clip(sa_solution, lb, ub)
