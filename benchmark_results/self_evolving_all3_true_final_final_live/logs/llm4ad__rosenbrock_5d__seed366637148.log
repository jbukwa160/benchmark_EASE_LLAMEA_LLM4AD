def algorithm(func, dim, lb, ub, budget, rng):
    best = np.random.uniform(lb, ub, size=dim)
    for _ in range(budget):
        x = np.clip(np.random.normal(loc=best, scale=np.max(ub-lb)/2, size=dim), a_min=lb, a_max=ub)
        f_x = func(x)
        if rng.rand() < (f_x / func(best)) ** 0.7:
            best = x
    return best
