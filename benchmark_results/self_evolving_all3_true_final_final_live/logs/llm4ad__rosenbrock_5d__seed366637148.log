def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return func(x)

    x = np.array([random.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = Rosenbrock(best_x)
    
    T0 = 1.0
    alpha = 0.9
    beta = 0.01
    
    for t in range(budget):
        new_x = best_x + rng.normal(0, 1, size=dim) / np.sqrt(t + 1)
        
        # Clip to bounds
        new_x = np.clip(new_x, lb, ub)
        
        new_f = Rosenbrock(new_x)
        
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f
            
        elif T0 * (1 - alpha) ** 2 * rng.uniform(0, 1) + beta > np.exp((best_f - new_f) / T0):
            best_x = new_x.copy()
            best_f = new_f
        
        T0 *= alpha
    
    return best_x
