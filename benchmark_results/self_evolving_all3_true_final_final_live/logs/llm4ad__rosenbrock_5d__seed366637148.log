def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    t = 1.0
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        new_x = x + rng.normal(size=dim) * (ub - lb) / 2
        new_x = clip(new_x)
        
        delta = func(new_x) - best_f
        if delta < 0:
            x = new_x.copy()
            best_f = func(x)
            best_x = x.copy()
        else:
            prob = np.exp(-delta / (t * (ub - lb)**2))
            if rng.uniform(0, 1) < prob:
                x = new_x.copy()
        
        t *= 0.99
    return best_x
