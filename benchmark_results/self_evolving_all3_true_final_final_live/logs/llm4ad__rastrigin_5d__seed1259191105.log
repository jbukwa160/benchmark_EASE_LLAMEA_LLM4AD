def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    max_iter = 1000
    cr = 1.0
    
    x = rng.uniform(lb, ub, (pop_size, dim))
    
    for i in range(max_iter):
        v = np.zeros((pop_size, dim))
        
        for j in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size, 3)
            if rng.rand() < cr:
                v[j] = x[r1] + rng.uniform(-1, 1) * (x[r2] - x[r1])
            else:
                mu = rng.uniform(lb, ub)
                v[j] = x[r1] + mu
        
        f_x = func(x)
        f_v = func(v)
        
        for j in range(pop_size):
            if f_v[j] < f_x[j]:
                x[j] = v[j]
        
        x[np.where(x < lb)] = lb
        x[np.where(x > ub)] = ub
        
    return x[np.argmin(func(x))][0]
