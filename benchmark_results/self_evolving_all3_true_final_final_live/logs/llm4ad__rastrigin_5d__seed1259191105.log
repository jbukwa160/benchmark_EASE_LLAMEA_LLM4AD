def algorithm(func, dim, lb, ub, budget, rng):
    def is_feasible(x):
        return (lb <= x).all() and (x <= ub).all()

    best_x = None
    best_y = np.inf
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        if not is_feasible(x):
            continue
        
        y = func(x)
        
        if y < best_y:
            best_x = x
            best_y = y
            
        step_size = 0.1 + (ub - lb) * np.random.uniform(0, 1, size=dim)
        x_prime = x + rng.normal(size=dim) * step_size
        
        if is_feasible(x_prime):
            y_prime = func(x_prime)
            
            if y_prime < best_y:
                best_x = x_prime
                best_y = y_prime
                
    return best_x
