def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50  # population size
    num_generations = budget // (dim * pop_size) + 1  # number of generations
    mutation_factor = 0.5  # mutation factor for DE
    crossover_rate = 0.9  # crossover rate for DE

    def generate_initial_population(size, lb, ub):
        return np.clip(rng.uniform(lb, ub, size=(size, dim)), lb, ub)

    initial_population = generate_initial_population(pop_size, lb, ub)
    population_best = initial_population[np.argmin([func(x) for x in initial_population])]

    for _ in range(num_generations):
        offspring = np.zeros((pop_size, dim))
        for i in range(pop_size):
            rand_idx1, rand_idx2, rand_idx3 = rng.choice(pop_size, 3, replace=False)
            mutation_direction = initial_population[rand_idx1] - initial_population[rand_idx2]
            if rng.random() < crossover_rate:
                offspring[i] = population_best + mutation_factor * mutation_direction
            else:
                offspring[i] = population_best

        offspring = np.clip(offspring, lb, ub)

        for i in range(pop_size):
            if rng.random() < 0.5:
                offspring[i] = initial_population[rand_idx1]

        new_population_best = np.zeros((pop_size,))
        for i in range(pop_size):
            new_population_best[i] = func(offspring[i])

        population_idx = np.argmin(new_population_best)
        if new_population_best[population_idx] < np.min([func(x) for x in initial_population]):
            initial_population[population_idx] = offspring[population_idx]

        population_best = initial_population[np.argmin(new_population_best)]

    best_solution = initial_population[np.argmin([func(x) for x in initial_population])]
    return best_solution
