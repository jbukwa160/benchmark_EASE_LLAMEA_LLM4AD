def algorithm(func, dim, lb, ub, budget, rng):
    def get_fitness(x):
        x = np.clip(x, lb, ub)
        return func(x)

    def de(pop_size, bounds, max_iter, noise_scale=0.1):
        x_best = np.random.uniform(bounds[:, 0], bounds[:, 1])
        pop = np.random.uniform(bounds[:, 0], bounds[:, 1], size=(pop_size, dim))
        for _ in range(max_iter):
            for i in range(pop_size):
                r = rng.choice(pop_size, size=3, replace=False)
                u = rng.uniform(0, 1)
                v = rng.uniform(0, 1)
                x_new = pop[r[0]] + u * (pop[r[1]] - pop[r[2]])
                noise = rng.normal(size=dim) * noise_scale
                x_new += noise
                if get_fitness(x_new) < get_fitness(pop[i]):
                    pop[i] = x_new
            x_best = np.argmin(get_fitness(np.array([x_best] + [p for p in pop])))
            pop[x_best] = np.random.uniform(bounds[:, 0], bounds[:, 1])
        return pop[np.argmin(get_fitness(pop))]

    def cma_es(bounds, budget):
        x_mean = np.zeros(dim)
        sigma = 10
        for _ in range(budget):
            x_new = np.clip(x_mean + rng.normal(size=dim) * sigma, bounds[:, 0], bounds[:, 1])
            if get_fitness(x_new) < get_fitness(x_mean):
                x_mean = x_new

    pop_size = int(np.sqrt(dim))
    budget_per_iteration = int(budget / 10)
    iteration = 0
    while True:
        pop = de(pop_size, [[lb]*dim, [ub]*dim], budget_per_iteration)
        if get_fitness(pop[np.argmin(get_fitness(pop))]) > get_fitness(x_best):
            x_mean = pop[np.argmin(get_fitness(pop))]
            sigma = 1 / (iteration + 1)
            for _ in range(budget_per_iteration):
                noise = rng.normal(size=dim) * sigma
                new_x = np.clip(x_mean + noise, lb, ub)
                if get_fitness(new_x) < get_fitness(x_mean):
                    x_mean = new_x
        else:
            cma_es([[lb]*dim, [ub]*dim], budget_per_iteration)
        iteration += 1
        if iteration >= 10:
            break

    return pop[np.argmin(get_fitness(pop))]
