def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.ones(dim)
    f_best = float('inf')
    
    for _ in range(budget):
        x_cand = rng.uniform(lb, ub, size=dim)
        
        # Clip candidates to [lb, ub]
        x_cand = np.clip(x_cand, lb, ub)
        
        f_cand = func(x_cand)
        
        if f_cand < f_best:
            x_best = x_cand
            f_best = f_cand
    
    return x_best
