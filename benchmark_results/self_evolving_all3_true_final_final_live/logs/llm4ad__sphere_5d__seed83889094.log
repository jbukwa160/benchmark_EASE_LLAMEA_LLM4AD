def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    for _ in range(budget):
        x_new = x + 0.1 * rng.normal(size=dim)
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)
        f_best = func(best_x)
        if f_new < f_best:
            best_x = x_new.copy()
        alpha = 0.01
        grad = (f_new - f_best) * rng.normal(size=dim)
        x += alpha * grad
    return best_x
