def algorithm(func, dim, lb, ub, budget, rng):
    x = (np.random.uniform(lb, ub, size=dim) - lb) / (ub - lb)
    best_x = np.copy(x)
    learning_rate = 0.1
    
    for _ in range(budget):
        grad = func(np.clip(x, lb, ub))
        
        # gradient is the function value itself
        dx = np.zeros(dim)
        
        for i in range(dim):
            x_try = np.copy(x)
            x_try[i] += learning_rate * (ub - lb) / 2
            grad_try = func(np.clip(x_try, lb, ub))
            
            if grad_try < grad:
                dx[i] += (ub - lb) / 2
                
        x -= dx
        
        if np.all(np.abs(dx) == 0):
            learning_rate *= 0.5
            
        if np.sum(x**2) < np.sum(best_x**2):
            best_x = np.copy(x)
    
    return best_x
