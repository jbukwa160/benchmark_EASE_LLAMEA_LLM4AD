def algorithm(func, dim, lb, ub, budget, rng):
    n_iter = int(budget)
    dim_range = ub - lb
    n_restart = 5
    
    for i in range(n_restart):
        x_best = None
        f_best = float('inf')
        
        for _ in range(n_iter // n_restart):
            x_candidate = np.clip(lb + rng.uniform(size=dim) * dim_range, a_min=lb, a_max=ub)
            
            if func(x_candidate) < f_best:
                f_new = func(x_candidate)
                
                if f_new < f_best and not np.any(np.isclose(x_candidate, x_best)):
                    f_best = f_new
                    x_best = x_candidate
                    
        yield x_best
    
    for _ in range(n_iter % n_restart):
        x_candidate = np.clip(lb + rng.uniform(size=dim) * dim_range, a_min=lb, a_max=ub)
        
        if func(x_candidate) < f_best:
            f_new = func(x_candidate)
            
            if f_new < f_best and not np.any(np.isclose(x_candidate, x_best)):
                f_best = f_new
                x_best = x_candidate
                
        yield x_best
