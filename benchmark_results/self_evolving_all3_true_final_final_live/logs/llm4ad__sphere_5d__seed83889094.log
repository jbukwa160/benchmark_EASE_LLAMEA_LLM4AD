def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(x, lb, ub):
        return np.clip(x + rng.normal(0, 1e-2), lb, ub)

    x = np.zeros(dim)
    T = 10.0
    learning_rate = 1e-4

    for _ in range(budget):
        y = get_candidate(x, lb, ub)
        f_y = func(y)
        f_x = func(x)

        if f_y < f_x:
            x = y
        else:
            T *= 0.99
            alpha = np.exp(-(f_y - f_x) / (learning_rate * T))
            prob_accept = rng.uniform(0, 1)
            if prob_accept < alpha or rng.uniform(0, 1) < 0.01:  # accept with some probability to avoid getting stuck
                x = y

    return x
