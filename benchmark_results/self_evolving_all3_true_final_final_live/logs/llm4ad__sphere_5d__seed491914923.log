def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    x_best = x.copy()
    best_value = func(x)

    for i in range(budget):
        y = x.copy()
        indices = rng.choice(range(dim), size=3, replace=False)
        for j in range(3):
            y[indices[j]] = x[indices[(j + 1) % 3]] + (x[indices[j]] - x[indices[(j + 2) % 3]]) * rng.uniform(-1, 1)

        # Clip to bounds
        y = np.clip(y, lb, ub)
        
        value = func(y)

        if value < best_value:
            best_value = value
            x_best = y.copy()

    return x_best
