def algorithm(func, dim, lb, ub, budget, rng):
    init_samples = 10 * dim + 1
    X_init = np.random.uniform(lb, ub, (init_samples, dim))
    Y_init = np.array([func(x) for x in X_init])

    def gp_mean(X_new):
        K = np.exp(-np.sum((X_new[:, None] - X_init[None]) ** 2, axis=2) / 0.5)
        return np.dot(K, Y_init) / np.sum(np.diag(K))

    def gp_var(X_new):
        K = np.exp(-np.sum((X_new[:, None] - X_init[None]) ** 2, axis=2) / 0.5)
        cov = np.diag(np.dot(K, K.T)) - np.diag(K)
        return np.sqrt(cov)

    def sample_gp():
        mu = gp_mean(rng.uniform(lb, ub, (1, dim)))
        sigma = gp_var(rng.uniform(lb, ub, (1, dim)))
        return rng.normal(mu, sigma)

    for _ in range(budget):
        X_new = sample_gp()
        Y_new = func(X_new)
        X_init = np.vstack((X_init, X_new))
        Y_init = np.append(Y_init, Y_new)

    best_x = X_init[np.argmin(Y_init)]
    return best_x
