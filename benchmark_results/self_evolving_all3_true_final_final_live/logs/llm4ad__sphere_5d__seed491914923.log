def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_recombination(parents, mutation_stepsize):
        children = np.zeros((len(parents), dim))
        for i in range(dim):
            mu = 0
            sigma = (ub - lb) / 5.0
            noise = np.random.randn(len(parents)) * sigma + mu
            children[:, i] = parents[:, i] + noise * mutation_stepsize
            children = np.clip(children, lb, ub)
        return children

    def objective(x):
        return func(x)

    population_size = 10
    budget_counter = 0
    while budget_counter < budget:
        if rng.random() > 0.9:  # restart every 10% of the budget
            x_best = np.zeros(dim)
            for i in range(population_size):
                x_new = lb + (ub - lb) * rng.random((1, dim))
                if objective(x_new[0]) < objective(x_best):
                    x_best = x_new[0]
        else:
            x_parents = np.clip(lb + (ub - lb) * rng.random((population_size, dim)), lb, ub)
            for i in range(population_size):
                noise = np.random.randn(dim) * 1e-3
                x_new = x_parents[i] + noise * (ub - lb) / 10.0
                if objective(x_new) < objective(x_parents[i]):
                    x_parents[i] = x_new

            children = gaussian_recombination(x_parents, 1e-2)
            for i in range(population_size):
                if objective(children[i]) < objective(x_parents[i]):
                    x_parents[i] = children[i]

        best_so_far_x = np.zeros(dim)
        for i in range(population_size):
            if objective(x_parents[i]) < objective(best_so_far_x):
                best_so_far_x = x_parents[i]
        budget_counter += population_size
    return best_so_far_x
