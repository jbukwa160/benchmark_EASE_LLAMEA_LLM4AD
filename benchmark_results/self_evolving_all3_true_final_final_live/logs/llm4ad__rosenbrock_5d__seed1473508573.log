def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def generate_candidate(parents, sigma):
        candidate = np.array([np.random.normal(mu, sigma) for mu in parents])
        return clip(candidate, lb, ub)

    def mutate(parents, step_size):
        mutated_parents = parents + np.random.uniform(-step_size, step_size, size=(dim,))
        return clip(mutated_parents, lb, ub)

    def evaluate(x):
        return func(x)

    best_x = rng.uniform(lb, ub, size=dim)
    best_f = evaluate(best_x)

    for _ in range(budget):
        parents = np.array([best_x] * 2)  # Select the current best individual as parent
        candidate = generate_candidate(parents, 0.1)  # Generate a new candidate
        candidate_f = evaluate(candidate)
        
        if candidate_f < best_f:
            best_x = candidate
            best_f = candidate_f

    return best_x
