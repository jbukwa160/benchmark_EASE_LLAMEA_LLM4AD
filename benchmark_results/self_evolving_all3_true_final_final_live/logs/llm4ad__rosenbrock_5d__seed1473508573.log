def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, (1, dim))
    s = 0.5 * (ub - lb)
    for i in range(1, budget):
        y = x + rng.uniform(-s, s, (1, dim))
        for j in range(dim):
            if y[0, j] < lb:
                y[0, j] = lb
            elif y[0, j] > ub:
                y[0, j] = ub
        f_y = func(y)
        if f_y < func(x):
            x = y
        s *= 0.99
    return x
