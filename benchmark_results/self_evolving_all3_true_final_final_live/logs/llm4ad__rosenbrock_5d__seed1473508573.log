def algorithm(func, dim, lb, ub, budget, rng):
    N = 10 * dim  # number of particles
    D = dim + 1  # dimensionality of the covariance matrix
    sigma = 0.2  # initial standard deviation
    T = 10000  # temperature schedule parameter
    tau = np.log(T / (T - 1)) / budget

    positions = rng.uniform(lb, ub, size=(N, dim))
    velocities = rng.normal(size=(N, dim))
    covariance_matrix = np.eye(D)
    step_size = sigma * np.sqrt(1 + tau)

    for _ in range(budget):
        distance_to_global_minimum = func(positions) - 0
        fitness = np.array([func(x) for x in positions])

        # update velocities and positions using CMA-ES
        covariance_matrix, velocities = update_cma(covariance_matrix, velocities, step_size)
        new_positions = positions + velocities

        # clip candidates to [lb, ub]
        new_positions = np.clip(new_positions, lb, ub)

        # select the next generation of particles
        probabilities = 1 / (1 + np.exp(-distance_to_global_minimum))
        selected_indices = rng.choice(N, size=N, p=probabilities)
        positions[selected_indices] = new_positions[selected_indices]
        velocities[selected_indices] = velocities[selected_indices]

    best_position = positions[np.argmin(fitness)]
    return best_position
