def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def evaluate(x):
        return func(x)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = evaluate(best_x)

    for _ in range(budget):
        mutation_prob = 0.1
        perturbation_std = 1e-3

        for i in range(dim):
            if rng.rand() < mutation_prob:
                v = rng.uniform(-perturbation_std, perturbation_std)
                x[i] += v

        f = evaluate(x)

        if f < best_f:
            best_x = x.copy()
            best_f = f

        alpha = 0.99
        temp = rng.uniform(1e-6, 1.0)
        if evaluate(best_x) > best_f + (evaluate(x) - best_f) * np.exp((best_f - evaluate(x)) / temp):
            x = clip(best_x + (x - best_x) * np.random.rand(dim), lb, ub)

    return best_x
