def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_candidate(current_solution, rng=rng):
        noise = 0.1 * rng.normal(size=dim)
        new_solution = current_solution + noise
        new_solution = clip(new_solution)
        return new_solution

    current_solution = rng.uniform(lb, ub, size=dim)
    best_solution = current_solution.copy()
    best_value = func(current_solution)

    for _ in range(budget):
        candidate = generate_candidate(current_solution)
        value = func(candidate)
        
        if value < best_value:
            best_solution = candidate.copy()
            best_value = value

        temperature = 0.99 * rng.uniform(0, 1) + 0.01
        acceptance_probability = np.exp((best_value - value) / temperature)
        if rng.uniform() < acceptance_probability:
            current_solution = candidate.copy()

    return best_solution
