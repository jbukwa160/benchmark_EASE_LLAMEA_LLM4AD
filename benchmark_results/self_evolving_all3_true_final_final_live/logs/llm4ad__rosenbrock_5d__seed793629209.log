def algorithm(func, dim, lb, ub, budget, rng):
    n = len(dim)
    x0 = np.random.uniform(lb, ub, size=n)
    T_max = 1e4
    T_min = 1e-2
    T_initial = 1000
    alpha = 0.9999

    x_best = x0.copy()
    f_best = func(x_best)

    for _ in range(budget):
        # Simulated annealing step
        T = max(T_min, T_initial * (alpha ** (_ / budget)))

        for _ in range(n):
            # Gaussian perturbation step
            dx = rng.normal(size=n)
            x_new = x_best + 0.1 * dx

            # Clip candidates to [lb, ub]
            x_new = np.clip(x_new, lb, ub)

            f_new = func(x_new)

            if f_new < f_best:
                x_best = x_new.copy()
                f_best = f_new
        yield x_best

    return x_best
