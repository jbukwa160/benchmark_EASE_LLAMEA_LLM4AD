def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_candidate = np.clip(rng.uniform(lb, ub, size=dim), a_min=lb, a_max=ub)
        
        if func(x_candidate) < f_best:
            x_best = x_candidate
            f_best = func(x_candidate)

    return x_best
