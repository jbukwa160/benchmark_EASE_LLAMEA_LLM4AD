def algorithm(func, dim, lb, ub, budget, rng):
    D = 0.5 * (ub - lb)
    x_best = lb + rng.uniform(size=dim) * D
    y_temp = x_best.copy()
    t = budget / np.log(1 + budget)

    for i in range(budget):
        if i < dim:
            v = y_temp.copy() 
            for j in range(dim):
                u = rng.randint(j, dim)
                v[j], v[u] = v[u], v[j]
            f_v = func(v)
            alpha = (ub - lb) * rng.uniform()
            w = x_best + alpha * (v - x_best)

        else:
            f_y_temp = func(y_temp)
            if rng.uniform() < 0.2:  # mutation rate
                v = y_temp.copy() 
                for j in range(dim):
                    u = rng.randint(j, dim)
                    v[j], v[u] = v[u], v[j]
                f_v = func(v)
            else:
                sigma = (ub - lb) * rng.uniform()
                w = x_best + sigma * (y_temp - x_best)

        f_w = func(w)
        if f_w < f_y_temp or rng.uniform() < np.exp((f_y_temp - f_w) / t):
            y_temp = w.copy()

        x_best = np.clip(y_temp, lb, ub)
        if i % 100 == 0:
            print(f'Iteration {i+1}, Best: {func(x_best)}')

    return np.clip(x_best, lb, ub)
