def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(x):
        return x + 0.1 * rng.uniform(-1, 1, size=dim)

    def crossover(p1, p2):
        c = (p1 + p2) / 2
        return np.clip(c, lb, ub)

    x_best = -np.inf
    population = [rng.uniform(lb, ub, dim) for _ in range(20)]
    temperature = budget

    while temperature > 0:
        for i in range(len(population)):
            p1, p2 = population[i], mutate(population[(i+1)%len(population)])
            c = crossover(p1, p2)
            f_c, f_p1, f_p2 = func(c), func(p1), func(p2)

            if f_c < f_p1 and f_c < f_p2:
                population[i] = c
                if f_c > x_best:
                    x_best = c

        temperature *= 0.99

    return x_best
