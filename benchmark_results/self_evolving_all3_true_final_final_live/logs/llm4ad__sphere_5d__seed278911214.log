def algorithm(func, dim, lb, ub, budget, rng):
    best = None
    for _ in range(budget):
        x = np.random.uniform(lb, ub, size=dim)
        f_x = func(x)
        
        if best is None or f_x < func(best):
            best = x
            
        x1 = np.copy(x)
        x2 = np.copy(x)
        for i in range(dim):
            x1[i] = lb
            x2[i] = ub
            f_x1 = func(x1)
            f_x2 = func(x2)
            
            if f_x1 < f_x and (best is None or f_x1 < func(best)):
                best = np.copy(x1)
                
            elif f_x2 < f_x and (best is None or f_x2 < func(best)):
                best = np.copy(x2)
                
            x1[i] = x[i]
            x2[i] = x[i]
            
    return np.clip(best, lb, ub)
