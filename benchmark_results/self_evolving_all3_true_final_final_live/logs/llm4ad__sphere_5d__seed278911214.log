def algorithm(func, dim, lb, ub, budget, rng):
    n = len(rng)
    x = np.zeros((n, dim))
    for i in range(n):
        x[i] = lb + (ub - lb) * rng[i]

    f_best = float('inf')
    best = None
    cma_size = 0.1

    for _ in range(budget):
        # Selection
        scores = [func(x_i) for x_i in x]
        idx = np.argsort(scores)[:int(0.2 * n)]
        new_x = x[idx]

        # Crossover
        mu = np.mean(new_x, axis=0)
        c = (ub - lb) * rng[n: 2 * n]
        new_x += 0.5 * c

        # Mutation
        sigma = 1 / cma_size
        new_c = sigma * c
        x[:] = mu + new_c

        # Clip candidates to [lb, ub]
        for i in range(n):
            for j in range(dim):
                if x[i][j] < lb:
                    x[i][j] = lb
                elif x[i][j] > ub:
                    x[i][j] = ub

        scores = [func(x_i) for x_i in x]
        idx = np.argmin(scores)
        f_new = scores[idx]

        if f_new < f_best:
            f_best = f_new
            best = x[idx]

    return best
