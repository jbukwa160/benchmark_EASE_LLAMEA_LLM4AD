def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return func(x)

    x = np.random.uniform(lb, ub, size=dim)
    T = 1.0
    alpha = 0.9
    best_x = x.copy()
    best_f = Rosenbrock(best_x)
    
    for i in range(budget):
        new_x = best_x + rng.normal(size=dim) * 0.01
        new_x = np.clip(new_x, lb, ub)
        
        new_f = Rosenbrock(new_x)
        delta = new_f - best_f
        
        if delta < 0 or rng.rand() < np.exp(-delta / T):
            best_x = new_x
            best_f = new_f
            
        T *= alpha
        
    return best_x
