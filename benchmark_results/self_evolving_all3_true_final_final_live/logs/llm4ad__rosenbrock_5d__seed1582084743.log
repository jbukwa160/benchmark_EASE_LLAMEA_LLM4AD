def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x0 = (ub - lb) * rng.rand(dim) + lb
    x_best = x0.copy()
    for t in range(budget):
        x1 = clip(x0 + 0.5 * rng.randn(dim))
        x2 = clip(x0 + 0.5 * rng.randn(dim))
        x3 = clip(x0 + 0.5 * rng.randn(dim))
        f1, f2, f3 = func(x1), func(x2), func(x3)
        
        # Choose the best of the three candidates
        if np.any([f1 < f2, f1 < f3]):
            x_best = x1
            y_best = f1
        elif np.any([f2 < f1, f2 < f3]):
            x_best = x2
            y_best = f2
        else:
            x_best = x3
            y_best = f3
        
        # Update the current solution with the best found so far
        if y_best < func(x0):
            x0 = x_best.copy()
    
    return x_best
