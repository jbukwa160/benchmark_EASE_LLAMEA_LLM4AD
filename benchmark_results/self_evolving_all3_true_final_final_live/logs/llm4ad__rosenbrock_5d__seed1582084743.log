def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        z = np.copy(x_best)
        idx = np.random.choice(dim, 3, replace=False)
        u = np.random.normal(size=dim)
        v1, v2, v3 = rng.uniform(0, 1, size=3)
        w = clip(z + v1 * u[idx[0]] + v2 * u[idx[1]] + v3 * u[idx[2]])
        f_w = func(w)

        if f_w < f_best:
            x_best = w
            f_best = f_w

    return x_best
