def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    sigma = 0.5
    N = int(budget / (dim * pop_size))
    
    x = lb + rng.uniform(size=(pop_size, dim)) * (ub - lb)
    
    for _ in range(N):
        y = np.copy(x)
        
        for i in range(pop_size):
            j = rng.randint(0, pop_size, size=3)
            
            v = x[j[1]] + sigma * (x[j[2]] - x[j[0]])
            
            for d in range(dim):
                if rng.rand() < 0.5:
                    y[i, d] = x[i, d]
                else:
                    y[i, d] = v[d]
                    
        f_y = func(y)
        
        idx = np.argsort(f_y)[:pop_size]
        
        x = y[idx]
        
    return x[0]
