def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(rng):
        population = rng.uniform(lb, ub, (budget, dim))
        return population

    def fitness(population):
        return func(population)

    def selection(population, fitness_values, best_individual, best_fitness):
        indices = np.argsort(fitness_values)[:int(budget * 0.1)]
        new_population = population[indices]
        for i in range(int(budget * 0.9)):
            donor_index = rng.choice(indices)
            donor = new_population[donor_index]
            donor_mutated = clip(donor + rng.uniform(-1, 1, dim))
            new_population[i] = np.where(rng.uniform(0, 1, dim) < 0.5, best_individual, donor_mutated)
        return new_population

    population = generate_initial_population(rng)
    fitness_values = fitness(population)

    for _ in range(int(budget * 0.9)):
        new_population = selection(population, fitness_values, clip(population[np.argmin(fitness_values)]), np.min(fitness_values))
        fitness_values_new = fitness(new_population)
        if np.min(fitness_values_new) < np.min(fitness_values):
            population = new_population
            fitness_values = fitness_values_new

    best_individual = clip(population[np.argmin(fitness_values)])
    return best_individual
