def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 10 * dim
    sigma = 1.0
    lambda_ = int(pop_size / 2)
    mu = lambda_
    weights = [1 / (2 ** i) for i in range(lambda_)]
    mean = np.zeros(dim)
    cov = np.eye(dim)

    for _ in range(budget):
        if rng.rand() < 0.5:
            sigma *= 1 + 0.05 * rng.randn()
        
        candidates = np.clip(mean + rng.randn(pop_size, dim) @ cov, lb, ub).astype(np.float32)
        scores = [func(c) for c in candidates]

        best_idx = np.argmax([s - func(0) for s in scores])
        if scores[best_idx] < func(0):
            mean += (candidates[best_idx] - mean) / lambda_
            cov += ((candidates[best_idx] - mean) * (candidates[best_idx] - mean).T) / (lambda_ ** 2)
    
    return candidates[np.argmax([s - func(0) for s in scores])]
