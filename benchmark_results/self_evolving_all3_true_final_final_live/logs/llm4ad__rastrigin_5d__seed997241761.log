def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    pop_size = 50
    n_iter = int(budget / pop_size)
    best_x = np.zeros(dim)
    best_f = float('inf')

    for i in range(n_iter):
        X = np.random.uniform(lb, ub, (pop_size, dim))
        y = func(X)

        for j in range(pop_size):
            mu = bound(np.mean(X, axis=0))
            sigma = 1.5 * rng.rand(dim)
            z = mu + sigma * rng.randn(dim)
            X[j] = bound(z)

            if y[j] < best_f:
                best_x = X[j]
                best_f = y[j]

    return best_x
