def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    max_iter = int(budget / (dim * pop_size))
    sigma = 0.5
    F = 1
    CR = 0.9
    
    for _ in range(max_iter):
        population = np.random.uniform(lb, ub, size=(pop_size, dim))
        
        for i in range(pop_size):
            while True:
                trial = population[i] + rng.normal(0, sigma, size=dim)
                
                trial[trial < lb] = lb
                trial[trial > ub] = ub
                
                if np.random.rand() < CR or np.all(trial == population[i]):
                    for j in range(dim):
                        if np.random.rand() < F:
                            trial[j] = population[np.random.choice(pop_size, size=1)[0], j]
                    
                    fit_trial = func(trial)
                    fit_population = func(population[i])
                    
                    if fit_trial <= fit_population:
                        population[i] = trial
                        break
                
    best_candidate = np.argmin([func(x) for x in population])
    
    return population[best_candidate]
