def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
            
        # local search
        while True:
            y = np.copy(x)
            for i in range(dim):
                delta = 0.1 * rng.choice([-1, 1])
                y[i] += delta
                
                if lb <= y[i] <= ub:  # clip to bounds
                    f_y = func(y)
                    
                    if f_y < best_f:
                        best_f = f_y
                        best_x = y
                        
            if not np.any(delta != 0):  # stop local search when no more improvements are found
                break
                
    return best_x
