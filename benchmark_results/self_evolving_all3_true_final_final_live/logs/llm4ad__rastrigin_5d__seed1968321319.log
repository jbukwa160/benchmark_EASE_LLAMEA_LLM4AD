def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    bounds = [(lb, ub) for _ in range(dim)]
    pop = np.random.uniform(lb, ub, (pop_size, dim))
    g_best = None
    t_best = np.inf
    gen = 0

    while gen < budget:
        for i in range(pop_size):
            candidate = pop[i]
            mutation_factor = 1.0 + 0.5 * (gen / budget)
            trial = candidate + mutation_factor * rng.choice(pop, size=dim, replace=True) - lb
            trial = np.clip(trial, a_min=lb, a_max=ub)

            objective = func(trial)
            if objective < t_best:
                g_best = trial.copy()
                t_best = objective

        pop[:] = g_best + mutation_factor * (rng.choice(pop, size=dim, replace=True) - lb)
        pop = np.clip(pop, a_min=lb, a_max=ub)

        gen += 1

    return g_best
