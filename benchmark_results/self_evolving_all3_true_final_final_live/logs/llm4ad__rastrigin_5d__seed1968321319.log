def algorithm(func, dim, lb, ub, budget, rng):
    x_best = (ub - lb) * rng.rand(dim) + lb
    f_best = func(x_best)
    T = 1.0
    alpha = 0.98
    for i in range(budget):
        x_new = x_best + (ub - lb) * np.array(rng.randn(dim))
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)
        if f_new < f_best:
            x_best = x_new
            f_best = f_new
        elif rng.rand() < np.exp((f_best - f_new) / T):
            x_best = x_new
            f_best = f_new
        T *= alpha
    return x_best
