def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_pop = 50
    F = 0.5
    CR = 0.9
    pop = np.zeros((n_pop, D))
    for i in range(n_pop):
        for j in range(D):
            pop[i][j] = lb + (ub - lb) * rng.random()

    best_x = None
    best_y = float('inf')
    for _ in range(budget):
        fit = np.zeros((n_pop,))
        for i in range(n_pop):
            x_i = np.copy(pop[i])
            y_i = func(x_i)
            fit[i] = -y_i

        idx_best = np.argmax(fit)
        if best_x is None or fit[idx_best] < best_y:
            best_x = pop[idx_best]
            best_y = fit[idx_best]

        for i in range(n_pop):
            r1, r2, r3 = rd.sample(range(n_pop), 3)
            while r1 == idx_best or r2 == idx_best or r3 == idx_best:
                r1, r2, r3 = rd.sample(range(n_pop), 3)

            p = (F * np.abs(pop[r1] - pop[idx_best]) + pop[r1])
            u = CR * rng.random() + 0.1
            v = CR * rng.random() + 0.1

            for j in range(D):
                if rng.random() < u:
                    p[j] = pop[i][j]
                if rng.random() < v:
                    p[j] = pop[r3][j]

                p[j] = lb + (ub - lb) * np.clip(p[j], lb, ub)

            fit_p = func(p)
            idx_best_p = np.argmax(fit)
            if fit[idx_best_p] > fit[i]:
                pop[i] = p

    return best_x
