def algorithm(func, dim, lb, ub, budget, rng):
    def gradient(x):
        grad = np.zeros(dim)
        for i in range(dim - 1):
            grad[i] -= 400 * (x[i + 1] - x[i]**2) * (2*x[i] + (x[i + 1] - x[i]**2))
            grad[i+1] += 200 * (x[i + 1] - x[i]**2)
        return grad

    def step(x, s):
        n = len(x)
        x_new = np.copy(x)
        for i in range(n):
            x_new[i] += rng.uniform(-s, s)
            if lb <= x_new[i] <= ub:
                x_new[i] = min(max(x_new[i], lb), ub)
        return x_new

    def gradient_descent(x0, budget):
        learning_rate = 0.01
        step_size = 1.0
        for _ in range(budget):
            x = np.copy(x0)
            grad = gradient(x)
            while step_size > 1e-6:
                s = rng.uniform(0, step_size)
                x_new = step(x, s)
                grad_new = gradient(x_new)
                if func(x_new) < func(x):
                    x = x_new
                    grad = grad_new
                else:
                    if np.dot(grad_new - grad, x_new - x) >= 0 and rng.uniform(0, 1) > np.exp(-step_size / (2 * learning_rate**2)):
                        x = x_new
                        grad = grad_new
                step_size *= 0.99
            yield x

    def simulated_annealing(x0, budget):
        initial_temperature = 1000
        cooling_rate = 0.99
        for _ in range(budget):
            temperature = max(initial_temperature * cooling_rate**_, 1)
            x = np.copy(x0)
            while True:
                x_new = step(x, rng.uniform(0, 1))
                if func(x_new) < func(x):
                    x = x_new
                else:
                    if rng.uniform(0, 1) > np.exp((func(x) - func(x_new)) / temperature):
                        x = x_new
                yield x

    best_x = None
    for _ in range(budget):
        x0 = rng.uniform(lb, ub, dim)
        x_generator = gradient_descent(x0, 100) if rng.uniform(0, 1) > 0.5 else simulated_annealing(x0, 100)
        for x in x_generator:
            if best_x is None or func(x) < func(best_x):
                best_x = x
    return best_x
