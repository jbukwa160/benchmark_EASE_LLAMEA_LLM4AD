def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=(1, dim))
    best_x = x.copy()
    best_f = func(x)
    for i in range(budget):
        v = np.zeros((1, dim))
        for j in range(dim):
            r1, r2, r3 = rng.randint(0, i+1), rng.randint(0, i+1), rng.randint(0, i+1)
            while r1 == r2 or r1 == r3:
                r2, r3 = rng.randint(0, i+1), rng.randint(0, i+1)
            z = x[r1] + 0.5 * (x[r2] - x[r3])
            v[0, j] = clip(z)
        w = x + 0.8 * (v - x) + np.random.normal(size=(1, dim))
        w = clip(w)
        f_w = func(w)
        if f_w < best_f:
            best_x = w.copy()
            best_f = f_w
        elif rng.rand() < 0.5:
            v[0, j] = x[r1]
            w = v
        x = np.where(rng.rand(dim) < 0.5, w, best_x)
    return best_x
