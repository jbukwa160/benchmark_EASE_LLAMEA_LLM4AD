def algorithm(func, dim, lb, ub, budget, rng):
    def gp_optimise(model, X, Y, x_new):
        mean, var = model.predict(X[:, None], eval_Mean=True, eval_Cov=True)
        f_mean = mean[0]
        f_var = var[0, 0]
        
        pred_mean = (x_new - X) / np.linalg.norm(X, axis=1)[:, None] * mean
        pred_var = np.dot((x_new - X) ** 2, np.diag(var)) + f_var
        
        return pred_mean.sum(), pred_var

    def sample_from_gp(model, x):
        mean, var = model.predict(x[None])
        return norm.rvs(loc=mean[0], scale=np.sqrt(var[0]))

    def clip_to_bounds(candidate, lb, ub):
        return np.clip(candidate, a_min=lb, a_max=ub)

    X_init = rng.uniform(lb, ub, (10, dim))
    Y_init = [func(x) for x in X_init]
    
    model = None
    budget_left = budget
    
    while budget_left > 0:
        if model is None or np.any(Y_init < model.predict(X_init[:, None], eval_Mean=True).flatten()):
            model = None
        
        if model is None:
            x_new = rng.uniform(lb, ub)
        else:
            f_mean, f_var = gp_optimise(model, X_init[:, None], Y_init, x_new)
            if budget_left > 1 and f_var < 1000:
                a = np.inf
                while True:
                    u = rng.uniform(0, 1)
                    q = norm.ppf(u, loc=f_mean, scale=np.sqrt(f_var))
                    if q < func(x_new):
                        a = min(a, q)
                    else:
                        break
        
        x_best = clip_to_bounds(x_new, lb, ub)
        
        Y_new = [func(x_best)]
        
        X_init = np.vstack((X_init, x_best[:, None]))
        Y_init.extend(Y_new)
        
        model = None if len(X_init) < 10 else self.model
        budget_left -= 1
    
    best_x = clip_to_bounds(np.argmax(Y_init), lb, ub)
    
    return best_x
