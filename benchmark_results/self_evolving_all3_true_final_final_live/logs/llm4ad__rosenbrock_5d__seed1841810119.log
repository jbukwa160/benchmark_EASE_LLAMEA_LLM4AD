def algorithm(func, dim, lb, ub, budget, rng):
    def bounded_cma_es(bounds, func, max_iter=1000, popsize=20, sigma=0.1):
        n = len(bounds)
        X = np.random.uniform(bounds[:, 0], bounds[:, 1], (popsize, n))
        for _ in range(max_iter):
            Y = func(X)
            s = np.cov(X.T, bias=False)
            m = np.mean(Y)
            d = np.dot(Y - m, Y - m) / popsize
            X += sigma * np.random.multivariate_normal(np.zeros(n), s)
        return X[np.argmin(Y)], Y.min()

    def simulated_annealing(bounds, func, T=1000, alpha=0.9):
        x = rng.uniform(bounds[:, 0], bounds[:, 1])
        for _ in range(int(T)):
            dx = np.random.normal(size=len(x))
            y = func(x + dx)
            if y < func(x):
                x += dx
            else:
                p = np.exp(-(y - func(x)) / T)
                if rng.uniform(0, 1) < p:
                    x += dx
        return x

    def differential_evolution_bounds(bounds, func):
        res = differential_evolution(func, bounds)
        return res.x

    best_x = None
    best_f = np.inf
    for _ in range(budget):
        new_x, new_f = bounded_cma_es(np.array([list(lb), list(ub)]), func)
        if new_f < best_f:
            best_f = new_f
            best_x = new_x
        new_x, new_f = simulated_annealing(np.array([list(lb), list(ub)]), func)
        if new_f < best_f:
            best_f = new_f
            best_x = new_x
        new_x = differential_evolution_bounds(list(zip(lb, ub)), func)
        if np.all(new_x >= lb) and np.all(new_x <= ub):
            if func(new_x) < best_f:
                best_f = func(new_x)
                best_x = new_x

    return best_x
