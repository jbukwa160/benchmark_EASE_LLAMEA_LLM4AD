def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_x = rng.uniform(size=dim)
    best_f = func(best_x)
    for _ in range(budget):
        x = clip(rng.uniform(size=dim))
        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x
        delta = 0.1 * (ub - lb) / np.sqrt(_ + 2)
        if rng.rand() < 0.5:  # adaptively increase or decrease the learning rate
            for i in range(dim):
                if rng.rand() < 0.05:
                    if rng.rand() < 0.5:
                        best_x[i] += delta
                    else:
                        best_x[i] -= delta
        else:
            for i in range(dim):
                if rng.rand() < 0.05:
                    if rng.rand() < 0.5:
                        best_x[i] -= delta
                    else:
                        best_x[i] += delta
    return best_x
