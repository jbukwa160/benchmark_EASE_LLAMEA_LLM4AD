def algorithm(func, dim, lb, ub, budget, rng):
    x = [np.array([random.uniform(lb, ub) for _ in range(dim)])] * budget
    v = [np.array([0.0 for _ in range(dim)])] * budget
    step_size = 1.0

    for i in range(1, budget):
        y = np.copy(x[i-1])
        for j in range(dim):
            r1 = random.randint(0, i-1)
            r2 = random.randint(0, i-1)
            if r1 != r2:
                v[i] += step_size * (x[r1] - x[r2]) + rng.normal(0.0, 0.01, size=dim)
        y += v[i]
        for j in range(dim):
            y[j] = max(lb, min(y[j], ub))
        f_y = func(y)
        if f_y < func(x[i-1]):
            x[i] = y
    return x[-1]
