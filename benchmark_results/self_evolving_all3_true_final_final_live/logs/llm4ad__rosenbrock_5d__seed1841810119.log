def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.sqrt(budget))
    x0 = (ub - lb) * rng.rand(pop_size, dim) + lb
    best = None
    for _ in range(budget):
        y = func(x0)
        if best is None or np.any(y < best):
            best = y
        x1 = np.copy(x0)
        for i in range(dim - 1):
            dx = 0.01 * rng.randn(pop_size, dim) + (ub - lb) / 10 * rng.rand(pop_size, dim)
            x1[:, i] += dx[:, i]
            x1[:, i+1] -= 2 * dx[:, i]
        x1 = np.clip(x1, lb, ub)
        if _ < budget // 5:
            x0 = (ub - lb) * rng.rand(pop_size, dim) + lb
        else:
            x0 = x1.copy()
    return np.argmin(np.sum((x0[:, 1:] - x0[:, :-1]**2)**2 + (1 - x0[:, :-1])**2, axis=1))
