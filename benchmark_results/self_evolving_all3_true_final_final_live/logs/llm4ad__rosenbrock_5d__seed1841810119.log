def algorithm(func, dim, lb, ub, budget, rng):
    def fitness(x):
        return func(x)

    bounds = [(lb, ub) for _ in range(dim)]
    
    x0 = [np.random.uniform(lb, ub) for _ in range(dim)]
    best_x = x0
    best_f = np.inf
    
    for t in range(budget):
        # Simulated Annealing phase
        T = 100.0
        alpha = 0.99
        while T > 1e-6:
            x = [np.clip(np.copy(xi) + rng.uniform(-T, T), lb, ub) for xi in best_x]
            f = fitness(x)
            if f < best_f:
                best_f = f
                best_x = x[:]
            elif np.random.rand() < np.exp((best_f - f) / T):
                best_f = f
                best_x = x[:]
            T *= alpha
        
        # Differential Evolution phase
        F = 0.5
        CR = 1.0
        while True:
            x = [np.copy(xi) for xi in best_x]
            for i in range(dim):
                r1, r2 = rng.randint(0, dim), rng.randint(0, dim)
                if i != r1 and i != r2:
                    x[i] += F * (best_x[r1] - best_x[r2]) + CR * (rng.uniform(lb, ub) - 1.0)
            f = fitness(x)
            if f < best_f:
                best_f = f
                best_x = x[:]
            else:
                break
        
        # Local search refinement phase
        x = [np.copy(xi) for xi in best_x]
        for i in range(dim):
            r1, r2 = rng.randint(0, dim), rng.randint(0, dim)
            if i != r1 and i != r2:
                dx = np.clip(np.random.normal(0.0, 0.01), -5e-3, 5e-3)
                x[i] += dx
        f = fitness(x)
        if f < best_f:
            best_f = f
            best_x = x[:]
    
    return np.array(best_x)
