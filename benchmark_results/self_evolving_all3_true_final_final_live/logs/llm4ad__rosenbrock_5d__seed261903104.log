def algorithm(func, dim, lb, ub, budget, rng):
    X_init = rng.uniform(lb, ub, size=(budget // 2 + 1, dim))
    y_init = func(X_init)

    # Define the model and kernel parameters
    theta0 = np.array([1.0, 1e-3])  # Initial values for log(theta) in GP model

    # Bayesian Optimization loop
    X_best = None
    y_best = np.inf

    for t in range(budget):
        # Sample from the current GP posterior
        mu, var = gp_model(X_init, y_init, theta0)
        x_next = sample_from_gp(mu, var, rng)

        # Evaluate the function at the new point
        y_next = func(x_next)

        # Update the model parameters and history
        X_init = np.vstack((X_init, x_next))
        y_init = np.hstack((y_init, y_next))

        # Check for early stopping (convergence)
        if y_best - y_next < 1e-6:
            break

        # Update the best solution found so far
        if y_next < y_best:
            X_best = x_next
            y_best = y_next

    return X_best
