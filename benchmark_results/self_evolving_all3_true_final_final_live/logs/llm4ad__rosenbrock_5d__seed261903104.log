def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_f = float('inf')
    
    step_size = (ub - lb) / 10
    temp = 1
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
        
        sigma = step_size * np.exp(-(f - best_f) / temp)
        epsilon = rng.normal(size=dim)
        
        new_x = best_x + sigma * epsilon
        
        # Clip new_x to [lb, ub]
        new_x = np.clip(new_x, lb, ub)
        
        f_new = func(new_x)
        
        delta = f_new - f
        if delta < 0 or rng.uniform() < np.exp(-delta / temp):
            best_f = f_new
            best_x = new_x
        
        # Decrease temperature
        temp *= 0.999
    
    return best_x
