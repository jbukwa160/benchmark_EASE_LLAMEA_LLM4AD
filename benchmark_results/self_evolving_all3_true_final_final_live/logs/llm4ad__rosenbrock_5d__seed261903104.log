def algorithm(func, dim, lb, ub, budget, rng):
    def rosenbrock(x):
        return func(x)

    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_y = rosenbrock(x)
    
    for _ in range(budget):
        # GP step
        y = rosenbrock(x)
        gp_samples = np.random.multivariate_normal(np.zeros(dim), 1e-5 * np.eye(dim), size=10)
        y_gp_samples = [rosenbrock(gp_sample) for gp_sample in gp_samples]
        
        mean, cov = norm.fit(y_gp_samples)
        sigma = cov[0] + 1e-6
        mu = np.zeros(dim)
        cov_matrix = np.eye(dim) * (sigma ** 2)

        # DE step
        child_x = x.copy()
        for i in range(dim):
            if rng.uniform(0, 1) < 0.5:
                child_x[i] += 0.1 * rng.normal(0, 1)
            else:
                child_x[i] -= 0.1 * rng.normal(0, 1)

        child_x = np.clip(child_x, lb, ub)
        
        # GP selection
        y_child = rosenbrock(child_x)
        gp_prob = norm.cdf(y_child, loc=mean, scale=sigma)
        if rng.uniform(0, 1) < gp_prob:
            x = child_x.copy()
            y = y_child
            
        # Update best solution
        if y < best_y:
            best_x = x.copy()
            best_y = y
    
    return best_x
