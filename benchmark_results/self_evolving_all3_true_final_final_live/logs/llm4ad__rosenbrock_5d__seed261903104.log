def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    best_solution = np.full(dim, 0)
    best_fitness = float('inf')
    gp_model = None

    for i in range(budget):
        if i == 0:
            # Initial random exploration phase
            candidate = rng.uniform(lb, ub, size=dim)
            fitness = func(candidate)

        elif i % 10 == 0:
            # Rebuild GP model every 10 iterations
            X = np.vstack([best_solution.reshape(1, -1), gp_model.X])
            y = np.hstack([best_fitness, gp_model.y])
            gp_model = GaussianProcessRegressor(kernel=gp_model.kernel, alpha=0)
            gp_model.fit(X, y)

        else:
            # Adaptive step size and gradient-free exploration
            if gp_model is not None:
                mean, std = gp_model.predict(candidate)
                fitness = func(mean + 1.5 * std * rng.randn())
            else:
                fitness = func(candidate)

        candidate = clip(candidate, lb, ub)

        if fitness < best_fitness:
            best_solution = candidate
            best_fitness = fitness

    return best_solution
