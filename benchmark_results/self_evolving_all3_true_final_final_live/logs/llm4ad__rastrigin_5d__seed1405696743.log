def algorithm(func, dim, lb, ub, budget, rng):
    def get_bounds(i):
        return (lb[i], ub[i])

    def func_value(x):
        return func(np.array(x))

    def clip(candidate, bounds):
        clipped_candidate = []
        for i in range(dim):
            if candidate[i] < bounds[i][0]:
                clipped_candidate.append(bounds[i][0])
            elif candidate[i] > bounds[i][1]:
                clipped_candidate.append(bounds[i][1])
            else:
                clipped_candidate.append(candidate[i])
        return np.array(clipped_candidate)

    def crossover(parent1, parent2):
        child = []
        for i in range(dim):
            if rng.random() < 0.5:
                child.append(parent1[i])
            else:
                child.append(parent2[i])
        return np.array(child)

    def mutate(candidate):
        mutated_candidate = candidate.copy()
        for i in range(dim):
            mutated_candidate[i] += rng.uniform(-1, 1)
        return clip(mutated_candidate, get_bounds(0))

    def selection(population, fitnesses, budget):
        idx = np.argsort(fitnesses)[:budget]
        population = [population[i] for i in idx]
        fitnesses = [fitnesses[i] for i in idx]
        return population, fitnesses

    mean = np.array([np.mean(get_bounds(i)) for i in range(dim)])
    population = [mean + rng.uniform(-5, 5, dim) for _ in range(budget)]
    fitnesses = [func_value(candidate) for candidate in population]

    for t in range(1, budget):
        mean = np.array([np.mean([candidate[i] for candidate in population]) for i in range(dim)])
        sigma = np.mean(np.abs(np.array(population) - mean))
        perturbations = [(rng.randn(*mean.shape)) * sigma for _ in range(budget)]
        children = []
        fitnesses_children = []
        for j in range(budget):
            parent1, parent2 = rng.choice(population, 2, replace=False)
            child = crossover(parent1, parent2) + perturbations[j]
            child = clip(child, get_bounds(0))
            children.append(child)
            fitnesses_children.append(func_value(child))
        population, fitnesses = selection(population + children, fitnesses + fitnesses_children, budget)

    return np.array([population[0]])
