def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    D = 0.5 * (ub - lb)
    F = 1.0
    CR = 0.9

    x_best = lb + rng.uniform(size=n) * (ub - lb)
    f_best = func(x_best)

    pop_size = int(budget / n)
    for t in range(pop_size):
        pop = []
        for _ in range(n):
            x_i = lb + rng.uniform(size=n) * (ub - lb)
            pop.append(x_i)

        diff_pop = np.zeros((n, n))
        for i in range(n):
            for j in range(i+1, n):
                if rng.rand() < 0.5:
                    diff_pop[i, j] = pop[j][i]
                else:
                    diff_pop[j, i] = pop[i][j]

        f_pop = []
        for x in pop:
            f_pop.append(func(x))
        idx_best = np.argsort(f_pop)[:int(n/2)]
        best_x = [pop[i] for i in idx_best]

        for j in range(n):
            r1, r2, r3 = rng.randint(0, n), rng.randint(0, n), rng.randint(0, n)
            while r1 == j or r2 == j or r3 == j:
                r1, r2, r3 = rng.randint(0, n), rng.randint(0, n), rng.randint(0, n)

            x_new = best_x[j] + F * (diff_pop[r1, r2] - diff_pop[r3, j]) + D * rng.uniform(-1, 1)
            x_new = lb + CR * (ub - lb) if rng.rand() < CR else x_best
            x_new = np.clip(x_new, lb, ub)

            f_new = func(np.array(x_new))

            if f_new < f_pop[j]:
                pop[j] = x_new.tolist()
                f_pop[j] = f_new

        x_best = [x for _, x in sorted(zip(f_pop, pop))][0]
        f_best = min(f_pop)

    return np.array(x_best)
