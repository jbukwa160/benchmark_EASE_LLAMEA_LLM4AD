def algorithm(func, dim, lb, ub, budget, rng):
    def surrogate(x, X, Y, K):
        mean = np.zeros(dim)
        var = np.exp(np.random.uniform(-1, 0))
        for i in range(dim):
            mean[i] += K(X[:, i], x[i]) + var
        return mean

    def differential_evolution(f, bounds, n_population=50, mutation=0.5, crossover=0.5, seed=None):
        np.random.seed(seed)
        pop = np.random.uniform(bounds[0], bounds[1], (n_population, dim))
        for _ in range(100):
            fit = f(pop)
            fit = -fit
            idx_best = np.argmax(fit)
            best = pop[idx_best]
            pop2 = np.copy(pop)
            for i in range(n_population):
                v1, v2 = pop[np.random.choice([j for j in range(n_population) if j != i], 2, replace=False)]
                trial = v1 + mutation * (v1 - v2)
                if rng.rand() < crossover:
                    trial = (v1 + v2) / 2
                trial = np.clip(trial, bounds[0], bounds[1])
                pop2[i] = trial
            pop = pop2
        return best

    def gaussian_process(X, Y):
        K = np.zeros((len(X), len(X)))
        for i in range(len(X)):
            for j in range(len(X)):
                K[i, j] = np.exp(-np.sum(np.square(X[i] - X[j])))
        l = np.linalg.cholesky(K)
        mean = np.mean(Y)
        var = np.mean(np.square(Y - mean))
        Y_pred = []
        for x in X:
            y_mean = mean
            y_var = var + 1e-6
            for i in range(dim):
                y_mean += l[i, i] * (x[i] - mean)
                y_var += l[i, i]**2
            y_pred = norm.rvs(loc=y_mean, scale=np.sqrt(y_var))
            Y_pred.append(y_pred)
        return np.array(Y_pred)

    X = []
    Y = []
    best = None

    for _ in range(budget):
        x = differential_evolution(func, [[lb], [ub]], n_population=50, seed=_)
        f_x = func(x)
        Y.append(f_x)
        X.append(x)

        if len(Y) > 1:
            K = np.zeros((len(X), len(X)))
            for i in range(len(X)):
                for j in range(len(X)):
                    K[i, j] = np.exp(-np.sum(np.square(X[i] - X[j])))
            Y_pred = gaussian_process(X, Y)
            idx_best = np.argmin(Y_pred)
            if Y_pred[idx_best] < f_x:
                x_best = X[idx_best]
        else:
            x_best = x

        # Clip candidates to [lb, ub]
        x_best = np.clip(x_best, lb, ub)

        if best is None or func(x_best) < func(best):
            best = x_best

    return best
