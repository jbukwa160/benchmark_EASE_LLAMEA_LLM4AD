def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def polynomial_mutation(x, sigma):
        mutation = np.zeros(dim)
        for i in range(dim):
            if rng.rand() < 0.5:
                mutation[i] += rng.normal(0, sigma * (ub - lb))
            else:
                mutation[i] -= rng.normal(0, sigma * (ub - lb))
        return x + mutation

    def simulated_annealing(x0, T, budget):
        current = x0
        best = x0
        for _ in range(budget):
            new = polynomial_mutation(current, 1)
            delta = func(new) - func(current)
            if delta < 0:
                current = new
                if func(current) < func(best):
                    best = current
            elif rng.rand() < np.exp(-delta / T):
                current = new
        return best

    x0 = lb + (ub - lb) * rng.rand(dim)
    T = 10.0
    budget *= 2
    for _ in range(budget // 2):
        best = simulated_annealing(x0, T, budget // 2)
        x0 = clip(best)
        T *= 0.99

    return clip(simulated_annealing(x0, T, budget))
