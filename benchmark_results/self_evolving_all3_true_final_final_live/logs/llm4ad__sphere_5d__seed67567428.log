def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    sigma = 0.5 * (ub - lb)
    c1 = 2 / (dim + 1.27)
    c2 = 2 / ((dim + 1.27) ** 2)
    cmu = 1
    F = np.eye(dim)
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        y = x + sigma * rng.randn(dim)
        y = np.clip(y, lb, ub)
        f = func(y)

        if f < best_f:
            best_f = f
            best_x = y

        delta = y - x
        s2 = (delta ** 2).sum()
        if s2 > 0:
            F += c1 * np.outer(delta, delta) / s2
            sigma *= 1 + c2 * np.sqrt(s2) * cmu

        v = rng.randn(dim)
        while True:
            z = v @ F
            w = (sigma ** 2) * z
            u = x + w
            u = np.clip(u, lb, ub)

            if func(u) < best_f:
                x = u.copy()
                break

    return best_x
