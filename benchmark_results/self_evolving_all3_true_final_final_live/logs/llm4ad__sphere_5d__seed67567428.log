def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    c = np.sum(x ** 2)
    best_x = x.copy()
    best_f = c

    for _ in range(budget):
        s = np.random.randn(dim) / rng
        x_plus_s = clip(best_x + s)
        f = func(x_plus_s)

        if f < best_f:
            best_f = f
            best_x = x_plus_s.copy()

        mu = (1 - 1 / (budget + 1)) * s + (best_x - x) / rng
        C += np.outer(mu, mu)
        m = C @ np.random.randn(dim) / (C[0][0] ** 0.5 if C.shape == (dim, dim) else 1)
        x = clip(best_x + m)

    return best_x
