def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 5.0
    x = np.random.uniform(lb, ub, (1, dim))
    c = np.zeros(dim)
    D = np.eye(dim) * 2
    cumsum = np.cumsum(np.square(x))

    for _ in range(budget):
        y = func(x) + 1e-8
        d = x.copy()
        f = y

        if rng.rand() < 0.2:
            sigma *= 0.9
        elif rng.rand() < 0.2:
            sigma /= 0.9

        for _ in range(10):
            z = np.random.randn(dim)
            s = sigma * (D @ z + c)

            w = np.clip(x + s, lb, ub)
            fw = func(w) + 1e-8
            if fw < y:
                y = fw
                d = w

        cumsum += np.square(d - x)
        D = (cumsum / _ + 1) ** (-0.5)

        c = c + rng.randn(dim) * sigma
        x = d
        if func(x) < f:
            f = func(x)

    return x
