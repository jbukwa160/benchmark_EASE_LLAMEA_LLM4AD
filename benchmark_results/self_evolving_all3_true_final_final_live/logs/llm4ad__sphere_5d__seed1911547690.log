def algorithm(func, dim, lb, ub, budget, rng):
    D = 1e-7 * (ub - lb)
    
    def simulated_annealing(x0, T_init=10, alpha=0.9, num_iter=1000):
        x = x0.copy()
        T = T_init
        for _ in range(num_iter):
            step_size = np.random.uniform(-D, D, dim)
            new_x = x + step_size
            
            if all(lb <= new_x) and all(new_x <= ub):
                new_x_eval = func(new_x)
                x_eval = func(x)
                
                if new_x_eval < x_eval:
                    x = new_x
                else:
                    delta = new_x_eval - x_eval
                    prob = np.exp(-delta / T)
                    if rng.random() < prob:
                        x = new_x
            T *= alpha
            
    def pattern_search(x0, max_iter=100):
        x = x0.copy()
        
        for _ in range(max_iter):
            best_x = x.copy()
            for i in range(dim):
                step_size = D / 2 ** np.random.randint(1, dim + 1)
                new_x = x.copy()
                new_x[i] += step_size
                
                if all(lb <= new_x) and all(new_x <= ub):
                    new_x_eval = func(new_x)
                    best_x_eval = func(best_x)
                    
                    if new_x_eval < best_x_eval:
                        best_x = new_x
            x = best_x
            
    budget_iter = 0
    while True:
        iter_budget = rng.choice([SimulatedAnnealing, PatternSearch], p=[budget / (budget + 1), 1 - budget / (budget + 1)])
        
        if iter_budget == SimulatedAnnealing:
            simulated_annealing(x0=np.zeros(dim))
        else:
            pattern_search(x0=np.zeros(dim))
        
        budget_iter += 1
        if budget_iter >= budget:
            break
    
    return np.array([0.])
