def algorithm(func, dim, lb, ub, budget, rng):
    best = None
    radius = 1e10
    while budget > 0:
        x = np.clip(lb + (ub - lb) * rng.uniform(size=dim), a_min=lb, a_max=ub)
        f_x = func(x)
        
        if f_x < (radius ** 2):
            best = x
            radius = np.sqrt(f_x)
        
        budget -= 1
    
    return best
