def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    x = rng.uniform(-5.0, 5.0, size=n)
    T = 1.0
    alpha = 0.9
    gamma = 0.1
    delta_best = np.inf

    for i in range(budget):
        y = x + rng.normal(size=n) * (ub - lb) / 2.0
        y = np.clip(y, lb, ub)
        
        f_x = func(x)
        f_y = func(y)

        if f_y < f_x:
            delta_best = min(delta_best, f_y - f_x)
            x = y.copy()
        elif rng.uniform(0, 1) > np.exp((f_x - f_y) / T):
            x = y.copy()

        T *= alpha
        sigma = gamma * (ub - lb) / 2.0
        if delta_best < sigma:
            delta_best = sigma

    return x
