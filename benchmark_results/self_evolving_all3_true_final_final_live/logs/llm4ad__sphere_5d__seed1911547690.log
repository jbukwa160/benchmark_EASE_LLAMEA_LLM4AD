def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    n = 10
    pop_size = 20
    best_solution = None
    best_fitness = float('inf')

    for i in range(budget):
        population = rng.uniform(lb, ub, (pop_size, dim))
        fitnesses = [func(clip(x)) for x in population]

        idx_best = np.argmin(fitnesses)
        if fitnesses[idx_best] < best_fitness:
            best_solution = clip(population[idx_best])
            best_fitness = fitnesses[idx_best]

        if i % n == 0 and i != 0:
            if pop_size > 10:
                pop_size -= 2
                population = rng.uniform(lb, ub, (pop_size, dim))
                fitnesses = [func(clip(x)) for x in population]
                idx_best = np.argmin(fitnesses)
                best_solution = clip(population[idx_best])
            else:
                break

    return best_solution
