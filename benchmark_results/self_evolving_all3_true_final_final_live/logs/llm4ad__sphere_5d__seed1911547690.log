def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    current_solution = rng.uniform(low=lb, high=ub, size=(dim,))
    best_solution = current_solution.copy()
    best_fitness = func(current_solution)

    for _ in range(budget):
        noise = rng.uniform(low=-1.0, high=1.0, size=(dim,))
        candidate = current_solution + 0.001 * noise
        candidate = clip(candidate)
        candidate_fitness = func(candidate)

        if candidate_fitness < best_fitness:
            best_solution = candidate.copy()
            best_fitness = candidate_fitness

        if rng.uniform(low=0.0, high=1.0) > 0.5:
            current_solution = best_solution + 0.001 * noise
            current_solution = clip(current_solution)
        else:
            current_solution = candidate + 0.001 * (candidate - current_solution)

    return best_solution
