def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    def mutation(x_best, x1, x2, x3):
        v = 0.5 * (x_best + x1)
        for i in range(dim):
            if rng.random() < 0.05:
                v[i] += rng.uniform(-ub, ub) / np.sqrt(i+1)
        return clip(v)

    x = lb + rng.uniform(size=dim) * (ub - lb)
    f_best = func(x)

    for _ in range(budget):
        y = mutation(x, rng.uniform(size=dim), rng.uniform(size=dim), rng.uniform(size=dim))
        fy = func(y)
        if fy < f_best:
            x_best = y
            f_best = fy

    return x_best
