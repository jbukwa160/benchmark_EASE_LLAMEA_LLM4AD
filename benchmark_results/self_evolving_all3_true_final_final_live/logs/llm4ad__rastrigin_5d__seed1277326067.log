def algorithm(func, dim, lb, ub, budget, rng):
    def generate_samples(mean, cov, num_samples):
        samples = np.random.multivariate_normal(mean, cov, num_samples)
        return np.clip(samples, lb, ub)

    def update_mean(mean, population):
        return np.mean(population, axis=0)

    def update_cov(cov, mean, population, lambda_, rho):
        numerator = np.dot((population - mean).T, (population - mean))
        denominator = num_samples * cov
        covariance_update = (1 - 1 / (num_samples + lambda_)) * cov + rho * (denominator - cov)
        return np.maximum(covariance_update, 0)

    def sample(func, dim, lb, ub, mean, cov, population_size):
        samples = generate_samples(mean, cov, population_size)
        scores = func(samples)
        best_index = np.argmin(scores)
        if scores[best_index] < func(population[-1]):
            return samples[best_index], scores[best_index]
        else:
            return population[-1], func(population[-1])

    mean = rng.uniform(lb, ub, dim)
    cov = np.eye(dim) * 10
    population_size = int(0.2 * budget)

    for _ in range(budget):
        num_samples = min(population_size, len(mean))
        samples, scores = sample(func, dim, lb, ub, mean, cov, num_samples)
        mean = update_mean(mean, samples)
        cov = update_cov(cov, mean, samples, 1.0, 0.5)

    return mean
