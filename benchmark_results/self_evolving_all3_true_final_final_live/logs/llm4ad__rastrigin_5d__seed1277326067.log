def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    n = int(np.sqrt(budget))
    population_size = 100
    best_x = np.zeros(dim)
    best_fval = float('inf')
    
    for k in range(n):
        x = rng.uniform(lb, ub, (population_size, dim))
        
        for _ in range(population_size):
            y = clip(x[_] + rng.normal(size=dim) * 0.1)
            if func(y) < func(clip(best_x)):
                best_x = y
                best_fval = func(clip(best_x))
                
        x_deviation = (x - best_x[:, np.newaxis]) / n
        for _ in range(population_size):
            idx = rng.choice(range(population_size), 3, replace=False)
            child = clip(best_x + rng.normal(size=dim) * 0.1 +
                         x_deviation[idx, :] * rng.uniform(-2., 2.))
            if func(child) < best_fval:
                best_x = child
                best_fval = func(clip(best_x))

    return best_x
