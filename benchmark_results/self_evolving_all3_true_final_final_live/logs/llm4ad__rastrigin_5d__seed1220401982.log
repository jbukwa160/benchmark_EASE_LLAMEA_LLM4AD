def algorithm(func, dim, lb, ub, budget, rng):
    def sample(rng, n):
        return rng.uniform(lb, ub, size=(n, dim))

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def fitness(x):
        return func(x)

    pop_size = 50
    restart_threshold = 0.1 * budget
    cma_init_sigma = 10
    cma_decay_rate = 0.01

    best_solution = None
    best_fitness = np.inf
    iteration = 0
    while True:
        if iteration >= budget or (best_solution is not None and (iteration - np.sum(rng.random(pop_size) < restart_threshold)) >= restart_threshold):
            break
        
        population = sample(rng, pop_size)
        population = clip(population, lb, ub)

        fitness_values = np.array([fitness(x) for x in population])
        
        if best_solution is None or np.min(fitness_values) < best_fitness:
            best_solution = population[np.argmin(fitness_values)]
            best_fitness = np.min(fitness_values)
            
        iteration += 1

        sigma = cma_init_sigma * (1 - cma_decay_rate) ** iteration
        sigma = max(sigma, 0.001)

        for i in range(pop_size):
            noise = rng.normal(0, sigma, size=dim)
            population[i] += noise

        population = clip(population, lb, ub)

    return best_solution
