def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(budget ** (1 / 2))
    population = rng.uniform(lb, ub, size=(pop_size, dim))

    for generation in range(pop_size):
        for i in range(pop_size):
            candidate = population[i]
            mutation_index = np.random.choice(np.delete(range(pop_size), i), replace=False, size=dim)
            mutant = candidate + 0.5 * rng.uniform(-1, 1, size=(1, dim)) @ (population[mutation_index] - candidate)

            for j in range(dim):
                if mutant[j] < lb:
                    mutant[j] = lb
                elif mutant[j] > ub:
                    mutant[j] = ub

            crossover_index = np.random.choice(np.delete(range(pop_size), i), replace=False, size=dim)
            trial = (1 - rng.uniform(0, 1, size=(1, dim))) * candidate + rng.uniform(0, 1, size=(1, dim)) @ mutant[crossover_index]

            for j in range(dim):
                if trial[j] < lb:
                    trial[j] = lb
                elif trial[j] > ub:
                    trial[j] = ub

            trial_value = func(trial)
            candidate_value = func(candidate)

            if trial_value < candidate_value:
                population[i] = trial

    best_candidate = np.min(population, axis=0)
    return best_candidate
