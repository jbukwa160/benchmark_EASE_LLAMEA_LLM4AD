def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    x_best = None
    f_best = float('inf')
    
    for _ in range(budget):
        # Initialize population
        pop = rng.uniform(lb, ub, size=(pop_size, dim))
        
        # Evaluate population
        fs = np.array([func(x) for x in pop])
        
        # Update best solution
        if np.any(fs < f_best):
            f_best = np.min(fs)
            x_best = pop[np.argmin(fs)]
        
        # Hybrid perturbation mechanism
        p = 0.1
        for i in range(pop_size):
            if rng.random() < p:
                # Adaptive sampling strategy
                sigma = 1 / (1 + np.exp(-(fs[i] - f_best) / (f_best * 1e-6)))
                x_new = pop[i] + rng.normal(0, sigma, size=dim)
                x_new = np.clip(x_new, lb, ub)
            else:
                # Simple perturbation
                x_new = pop[i] + rng.uniform(-1, 1, size=dim)
                x_new = np.clip(x_new, lb, ub)
            
            # Evaluate new solution
            f_new = func(x_new)
            
            # Replace old solution with new one if better
            if f_new < fs[i]:
                pop[i] = x_new
                fs[i] = f_new
                
    return x_best
