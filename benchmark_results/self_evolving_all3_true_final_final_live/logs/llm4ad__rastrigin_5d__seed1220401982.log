def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    t = 1.0
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        # Differential Evolution (DE) step
        v = rng.normal(size=dim)
        u = np.clip(best_x + t * v, lb, ub)
        f_u = func(u)
        if f_u < best_f:
            best_x = u.copy()
            best_f = f_u

        # Simulated Annealing (SA) step
        v = rng.normal(size=dim)
        u = np.clip(x + t * v, lb, ub)
        f_u = func(u)
        if f_u <= best_f or rng.rand() < np.exp((best_f - f_u) / t):
            x = u.copy()
        else:
            t *= 0.99

    return best_x
