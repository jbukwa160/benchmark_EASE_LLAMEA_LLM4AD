def algorithm(func, dim, lb, ub, budget, rng):
    def get_cost(x):
        return func(x)

    def clip_x(x):
        return np.clip(x, lb, ub)

    x_current = rng.uniform(lb, ub, size=dim)
    best_x = x_current
    best_cost = get_cost(clip_x(best_x))
    population_size = 10

    for stage in range(int(np.log2(budget)) + 1):
        if budget < population_size:
            break

        candidate_pool = rng.uniform(lb, ub, size=(population_size, dim))
        costs = [get_cost(clip_x(x)) for x in candidate_pool]
        ranked_indices = np.argsort(costs)

        for i in range(population_size - 1):
            if get_cost(clip_x(candidate_pool[ranked_indices[i]])) < get_cost(
                clip_x(best_x)
            ):
                best_x = candidate_pool[ranked_indices[i]]
                best_cost = costs[ranked_indices[i]]

        budget -= population_size
        population_size //= 2

    return best_x
