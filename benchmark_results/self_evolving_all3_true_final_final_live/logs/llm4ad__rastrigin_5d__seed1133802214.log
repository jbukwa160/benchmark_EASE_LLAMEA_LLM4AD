def algorithm(func, dim, lb, ub, budget, rng):
    def get_initial_solution():
        return rng.uniform(lb, ub, size=dim)

    def clip(x):
        return np.clip(x, lb, ub)

    def compute_fitness(x):
        return func(x)

    def simulated_annealing(solution, temperature, cooling_rate):
        for _ in range(budget // 10):
            new_solution = solution + rng.uniform(-temperature, temperature, size=dim)
            new_solution = clip(new_solution)
            new_fitness = compute_fitness(new_solution)
            if new_fitness < solution[-1]:
                solution[-1] = new_fitness
                solution[:-1] = new_solution
        return solution

    def differential_evolution(solution, population_size):
        for _ in range(budget // 2):
            population = [get_initial_solution() for _ in range(population_size)]
            for i in range(population_size):
                vector_difference = np.mean(np.array([population[j] for j in range(population_size) if j != i]), axis=0) - population[i]
                new_solution = solution + 1e-5 * rng.uniform(-1, 1, size=dim) + vector_difference
                new_solution = clip(new_solution)
                new_fitness = compute_fitness(new_solution)
                if new_fitness < solution[-1]:
                    solution[-1] = new_fitness
                    solution[:-1] = new_solution
        return solution

    def main():
        solution = get_initial_solution()
        temperature = 10.0
        cooling_rate = 0.99
        population_size = 50

        for i in range(budget):
            if rng.random() < 0.1:
                solution = simulated_annealing(solution, temperature, cooling_rate)
            else:
                solution = differential_evolution(solution, population_size)

        return solution[:-1]

    return main()
