def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def local_search(x0, budget):
        x = np.copy(x0)
        for _ in range(budget):
            i = rng.randint(0, dim)
            delta = rng.uniform(-1, 1)
            x[i] += delta
            x = clip(x)
            if func(x) < func(x0):
                return x
        return x0

    def simulated_annealing(x0, budget):
        T = 100.0
        alpha = 0.99
        x = np.copy(x0)
        for _ in range(budget):
            i = rng.randint(0, dim)
            delta = rng.uniform(-1, 1)
            new_x = np.copy(x)
            new_x[i] += delta
            new_x = clip(new_x)
            delta_f = func(new_x) - func(x)
            if delta_f < 0 or rng.random() < np.exp(delta_f / T):
                x = new_x
            T *= alpha
        return x

    x = np.zeros(dim)
    for _ in range(budget // 2):
        x = local_search(x, budget // 2)
        x = simulated_annealing(x, budget // 2)

    return x
