def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    x = np.random.uniform(lb, ub, size=(n,))
    sigma = 0.5 * (ub - lb)
    t = 10000
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        if rng.rand() < 0.1: # 10% chance of Simulated Annealing step
            alpha = 0.9
            T = 1000 * sigma
            new_x = np.copy(x)
            new_f = best_f + 1e6

            for j in range(n):
                if rng.rand() < 0.5: # 50% chance of increasing or decreasing
                    delta = alpha * (rng.rand() - 0.5) * sigma
                    new_x[j] += delta
                    new_x = np.clip(new_x, lb, ub)

                    if new_f > func(new_x):
                        new_x = x.copy()
                        new_f = best_f + 1e6

            x = new_x
        else: # CMA-ES step
            c = rng.rand(n)
            delta = sigma * np.exp(c) / (1 + np.sum(np.exp(c)))
            new_x = np.copy(x)

            for j in range(n):
                if rng.rand() < 0.5: # 50% chance of increasing or decreasing
                    new_x[j] += delta[j]

                new_x = np.clip(new_x, lb, ub)

            f_new = func(new_x)
            t -= 1

            if f_new < best_f:
                x = new_x.copy()
                best_f = f_new
                best_x = x.copy()

        sigma *= 0.9999 # decrease sigma to increase exploration-exploitation trade-off

    return best_x
