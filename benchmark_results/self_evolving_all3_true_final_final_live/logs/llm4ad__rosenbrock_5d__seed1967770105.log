def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_x = rng.uniform(-5, 5, size=dim)
    best_y = func(best_x)
    best_x = clip(best_x)

    for _ in range(budget - 1):
        x = clip(rng.uniform(lb, ub, size=dim))
        y = func(x)

        if y < best_y:
            best_y = y
            best_x = x

    return best_x
