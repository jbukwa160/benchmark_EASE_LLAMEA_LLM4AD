def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 1000
    cooling_rate = 0.99
    for _ in range(budget):
        new_x = x + rng.normal(size=dim) / np.sqrt(T)
        new_x = np.clip(new_x, lb, ub)
        f_new = func(new_x)
        f_current = func(x)
        
        if f_new < f_current:
            x = new_x
        else:
            delta_f = f_new - f_current
            T *= cooling_rate
            
            if delta_f > 0 and rng.uniform() < np.exp(-delta_f / T):
                x = new_x
                
    return x
