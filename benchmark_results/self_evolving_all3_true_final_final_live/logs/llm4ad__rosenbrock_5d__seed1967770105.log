def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        return func(x).item()

    x_best = np.random.uniform(lb, ub, size=(dim,))
    f_best = evaluate(clip(x_best))

    pop_size = int(np.ceil(budget ** 0.5))
    population = [np.random.uniform(lb, ub, size=(dim,)) for _ in range(pop_size)]

    alpha = 1.0
    beta = 2.0

    for i in range(budget):
        F = np.abs(rng.normal(0, alpha))

        for j in range(pop_size):
            target = population[j]
            mutant = clip(target + F * (np.random.choice(population) - target))
            crossover_prob = rng.uniform(0, 1)
            trial = target.copy()
            if rng.rand() < crossover_prob:
                trial[rng.choice(dim)] = mutant[rng.choice(dim)]
            trial[rng.choice(dim)] = mutant[rng.choice(dim)]

            f_trial = evaluate(clip(trial))
            if f_trial < f_best:
                x_best = trial
                f_best = f_trial

        for j in range(pop_size):
            if evaluate(clip(population[j])) > evaluate(clip(x_best)):
                population[j] = x_best.copy()
            else:
                population[j] += rng.normal(0, beta)
                population[j] = clip(population[j])

    return x_best
