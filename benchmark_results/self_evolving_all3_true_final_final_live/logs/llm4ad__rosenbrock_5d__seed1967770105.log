def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, (1, dim))
    f_best = func(x_best)
    grid_size = 10
    for _ in range(budget):
        x_cand = np.clip(np.random.uniform(lb, ub, (grid_size**dim, dim)), lb, ub)
        fs = [func(x) for x in x_cand]
        idxs = np.argsort(fs)[:int(grid_size**dim*0.1)]
        x_cands = x_cand[idxs]
        f_cands = fs[idxs]
        if len(f_cands) > 1:
            idxs = rng.choice(len(x_cands), min(10, len(x_cands)), replace=False)
            for i in idxs:
                x = x_cands[i]
                fx = f_cands[i]
                x_new = np.copy(x)
                x_new += rng.uniform(-0.01, 0.01, (1, dim))
                x_new = np.clip(x_new, lb, ub)
                fx_new = func(x_new)
                if fx_new < f_best:
                    f_best = fx_new
                    x_best = x_new
        else:
            x = x_cands[0]
            fx = f_cands[0]
            x_new = np.copy(x)
            x_new += rng.uniform(-0.01, 0.01, (1, dim))
            x_new = np.clip(x_new, lb, ub)
            fx_new = func(x_new)
            if fx_new < f_best:
                f_best = fx_new
                x_best = x_new
    return x_best
