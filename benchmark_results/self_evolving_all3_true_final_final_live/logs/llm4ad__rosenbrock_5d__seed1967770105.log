def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    n = len(lb)
    sigma_init = 1.0
    mu = np.random.uniform(lb, ub, size=n)
    cm = np.eye(n) * sigma_init**2

    for i in range(budget):
        if rng.rand() < 0.1:
            # Simple random search with local refinement
            x_new = clip(mu + rng.randn(n), lb, ub)
            f_new = f(x_new)
            if f_new < f(mu):
                mu = x_new

        else:
            # CMA-ES
            cm_new = (i/(i+1))*cm + (1/(i+1))*np.eye(n)*sigma_init**2
            sigma_new = np.sqrt(np.trace(cm_new))
            e_new = rng.randn(n)
            e_new /= np.linalg.norm(e_new, axis=0)
            x_new = clip(mu + e_new * sigma_new, lb, ub)
            f_new = f(x_new)

            if f_new < f(mu):
                mu = x_new
                cm = cm_new

    return mu
