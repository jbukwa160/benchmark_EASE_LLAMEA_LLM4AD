def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, (1, dim))
    f_best = func(x_best[0])
    
    T = 100
    a = 0.99
    
    for _ in range(budget):
        n_iter = 0
        
        while n_iter < budget:
            step_size = rng.rand(dim)
            x_new = x_best + step_size * (ub - lb)
            
            # Clip candidates to [lb, ub]
            x_new = np.clip(x_new, lb, ub)
            
            f_new = func(x_new)
            
            if f_new < f_best:
                x_best = x_new
                f_best = f_new
                
            if rng.rand() > 1 - a**n_iter/T:
                n_iter += 1
            else:
                T *= a
    return x_best
