def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(x, mu):
        sigma = 1 / np.sqrt(2 * rng.uniform(-mu, mu))
        return x + sigma * np.random.normal(size=dim)

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    n_parents = int(budget ** (1/3)) + 5
    mu = budget / n_parents

    x = rng.uniform(lb, ub, size=(n_parents, dim))
    y = func(x)
    best_x = x[np.argmin(y)]
    best_y = np.min(y)

    for _ in range(budget - n_parents):
        new_x = mutate(x, mu)
        new_y = func(new_x)

        if rng.uniform(0, 1) < (new_y - best_y) / (func(best_x) - best_y):
            x[np.argmin(new_y)] = new_x[np.argmin(new_y)]
            y[np.argmin(new_y)] = new_y[np.argmin(new_y)]

        best_x = clip(x[np.argmin(y)], lb, ub)
        best_y = np.min(y)

    return best_x
