def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)
    for _ in range(budget):
        parents = [clip(rng.uniform(lb, ub, size=dim)) for _ in range(dim)]
        children = [parents[0]]
        while len(children) < dim:
            parent1, parent2 = rng.choice(parents, 2, replace=False)
            child = clip(parent1 + 0.5 * (parent2 - parent1))
            if func(child) < f_best:
                f_best = func(child)
                x_best = child
            children.append(child)
        parents.extend(children)
    return x_best
