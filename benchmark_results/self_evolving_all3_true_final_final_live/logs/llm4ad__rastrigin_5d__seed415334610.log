def algorithm(func, dim, lb, ub, budget, rng):
    population_size = 10 * dim
    pop = np.random.uniform(lb, ub, (population_size, dim))
    best = None
    for _ in range(budget):
        distances = np.linalg.norm(pop[:, np.newaxis] - pop[np.newaxis, :], axis=2)
        for i in range(distances.shape[0]):
            for j in range(i+1, distances.shape[0]):
                if rng.rand() < 0.5 and distances[i, j] > 0:
                    trial = pop[j] + 0.5 * (pop[i] - pop[j]) + rng.uniform(-1, 1)
                    trial = np.clip(trial, lb, ub)
                    fitness = func(trial)
                    if best is None or fitness < func(pop[i]):
                        pop[i] = trial
                        if best is None or fitness < func(best):
                            best = trial
    return best
