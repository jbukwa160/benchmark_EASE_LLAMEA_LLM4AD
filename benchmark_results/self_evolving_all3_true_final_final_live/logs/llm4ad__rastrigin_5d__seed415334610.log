def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    candidates = np.random.uniform(lb, ub, size=(budget, dim))

    for i in range(budget):
        scores = func(candidates[i]) + 0.1 * np.linalg.norm(candidates[i] - x_best)**2
        idx = rng.choice(len(scores), p=np.array(scores) / sum(scores))
        candidate = candidates[idx]
        
        if func(candidate) < f_best:
            f_best = func(candidate)
            x_best = candidate

    return x_best
