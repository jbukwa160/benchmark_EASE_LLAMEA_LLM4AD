def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    pop_size = 20
    gamma = 0.99
    T = 1000
    sigma = 1e-2
    
    for _ in range(budget):
        # Initialize population with random points
        x = rng.uniform(lb, ub, (pop_size, dim))
        
        # Evaluate initial population and find best point so far
        f = func(x)
        idx_best = np.argmin(f)
        if f[idx_best] < best_f:
            best_x = x[idx_best]
            best_f = f[idx_best]
        
        # Simulated Annealing step
        for t in range(T, 0, -1):
            i, j = rng.choice(pop_size, size=2, replace=False)
            delta_x = rng.normal(size=dim, loc=0, scale=sigma)
            new_x = x[i] + delta_x
            
            # Clip to bounds
            new_x = np.clip(new_x, lb, ub)
            
            f_new = func(new_x)
            if f_new < f[i]:
                x[i] = new_x
            else:
                p = np.exp(-(f_new - f[i]) / (t * constants.k))
                if rng.uniform(0, 1) < p:
                    x[i] = new_x
        
        # Differential Evolution step
        for i in range(pop_size):
            j, k, l = rng.choice([x.shape[0]]*3, size=3, replace=False)
            delta_x = rng.normal(size=dim, loc=0, scale=sigma)
            new_x = x[j] + 0.5 * (x[k] - x[l]) + delta_x
            
            # Clip to bounds
            new_x = np.clip(new_x, lb, ub)
            
            f_new = func(new_x)
            if f_new < f[i]:
                x[i] = new_x
        
        # Update best point and population temperature
        idx_best = np.argmin(func(x))
        if func(x[idx_best]) < best_f:
            best_x = x[idx_best]
            best_f = func(x[idx_best])
        
    return best_x
