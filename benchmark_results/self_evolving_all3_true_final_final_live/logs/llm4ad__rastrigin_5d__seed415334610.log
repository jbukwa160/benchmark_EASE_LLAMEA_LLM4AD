def algorithm(func, dim, lb, ub, budget, rng):
    def rastrigin(x):
        return func(x)

    D = dim
    Np = 50  # population size
    F = 0.5  # scaling factor for mutation
    CR = 1.0  # crossover rate

    x = np.random.uniform(lb, ub, (Np, D))
    y = x.copy()

    while True:
        for i in range(Np):
            r1, r2, r3 = rng.choice(range(Np), size=3, replace=False)
            if rng.random() < CR or np.linalg.norm(x[r1] - x[i]) == 0:
                u = x[r1] + F * (x[r2] - x[r3])
            else:
                u = y[i]

            v = np.clip(u, lb, ub)

            f_x = rastrigin(x[i])
            f_v = rastrigin(v)

            if f_v < f_x:
                x[i] = v

        if budget <= 0:
            return x[np.argmin(rastrigin(x))]

        budget -= 1
