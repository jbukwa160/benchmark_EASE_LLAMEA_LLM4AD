def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    x_best = np.random.uniform(lb, ub, size=(1, dim))
    f_best = func(x_best)
    temp = 10.0

    for i in range(1, budget+1):
        y = x_best + rng.normal(size=x_best.shape) / np.sqrt(i)
        y = clip(y)

        f_y = func(y)

        if f_y < f_best:
            x_best = y
            f_best = f_y
        else:
            prob = np.exp((f_best - f_y) / temp)
            if rng.random() < prob:
                x_best = y
                f_best = f_y

        temp *= 0.9999

    return x_best
