def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_solution(dim):
        return [random.uniform(lb, ub) for _ in range(dim)]

    def calculate_temperature(iteration, initial_temperature, cooling_rate):
        return initial_temperature * np.exp(-cooling_rate * iteration)

    def simulated_annealing(func, x, dim, lb, ub, temperature, rng):
        new_x = generate_initial_solution(dim)
        delta = func(new_x) - func(x)
        if delta < 0:
            return new_x
        else:
            if rng.random() < np.exp(-delta / temperature):
                return new_x
            else:
                return x

    initial_temperature = 1.0
    cooling_rate = 1e-4
    solution = generate_initial_solution(dim)
    best_solution = solution[:]

    for iteration in range(budget):
        temperature = calculate_temperature(iteration, initial_temperature, cooling_rate)
        new_solution = simulated_annealing(func, solution, dim, lb, ub, temperature, rng)

        if func(new_solution) < func(best_solution):
            best_solution = new_solution

        solution = [max(lb, min(ub, x + 0.1 * (new_x - x))) for x, new_x in zip(solution, new_solution)]

    return np.array(best_solution)
