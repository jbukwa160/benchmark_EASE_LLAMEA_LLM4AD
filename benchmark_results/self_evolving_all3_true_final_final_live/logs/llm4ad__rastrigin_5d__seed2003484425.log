def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def rastrigin(x):
        x = clip(x)
        return func(x)

    pop_size = 50
    n_iter = int(budget / (dim * pop_size))
    T = 1000.0

    for _ in range(n_iter):
        # Differential Evolution step
        X = rng.uniform(lb, ub, size=(pop_size, dim))
        V = np.zeros((pop_size, dim))
        for i in range(pop_size):
            j = np.random.choice(range(pop_size), replace=False)
            k = np.random.choice(range(pop_size), replace=False)
            V[i] = 0.5 * (X[j] + X[k]) + rng.uniform(-1, 1, size=dim)

        # Simulated Annealing step
        best_x = None
        best_f = float('inf')
        for i in range(pop_size):
            f = rastrigin(V[i])
            if f < best_f:
                best_f = f
                best_x = V[i]

            T *= 0.99

            # Accept or reject candidate based on probability
            if rng.rand() < np.exp(-(best_f - f) / T):
                X[i] = V[i]
                V[i] = np.copy(best_x)

    return clip(best_x)
