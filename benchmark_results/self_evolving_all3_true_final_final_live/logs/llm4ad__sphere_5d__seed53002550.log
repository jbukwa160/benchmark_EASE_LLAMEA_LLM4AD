def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for i in range(1, budget):
        learning_rate = 0.5 / (i + 1)**0.3
        s = rng.normal(size=dim)
        step_size = np.max(np.abs(s)) * learning_rate

        c = x + step_size * s
        c = np.clip(c, lb, ub)

        f = func(c)
        if f < best_f:
            best_x = c.copy()
            best_f = f

        x = rng.uniform(lb, ub, size=dim)

    return best_x
