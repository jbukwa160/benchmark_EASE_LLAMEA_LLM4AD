def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for i in range(budget - 1):
        x_candidate = np.clip(rng.normal(loc=x_best, scale=0.5, size=dim), lb, ub)
        f_candidate = func(x_candidate)

        if f_candidate < f_best:
            f_best = f_candidate
            x_best = x_candidate

    return x_best
