def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidates):
        return np.clip(candidates, lb, ub)

    def generate_candidates(mu, sigma):
        return mu + sigma * (rng.randn(dim) - 0.5)

    def update_step_size(sigma, step_size_adaptation_rate, population_spread):
        return sigma * np.exp(step_size_adaptation_rate * (np.mean(population_spread) / population_spread[0]))

    def sequential_cma_es(func, dim, lb, ub, budget, rng):
        mu = np.zeros(dim)
        population_spread = np.ones(dim) * 10
        step_size_adaptation_rate = 0.1

        for i in range(budget):
            candidates = generate_candidates(mu, population_spread)
            clipped_candidates = clip(candidates)
            fitnesses = func(clipped_candidates)

            # Update the best candidate
            idx_best = np.argmin(fitnesses)
            if fitnesses[idx_best] < func(mu):
                mu = clipped_candidates[idx_best]

            # Update population spread and step size
            population_spread = update_step_size(population_spread, step_size_adaptation_rate,
                                                 np.mean(np.abs(candidates - clipped_candidates)))
        return mu

    best_candidate = sequential_cma_es(func, dim, lb, ub, budget, rng)
    return best_candidate
