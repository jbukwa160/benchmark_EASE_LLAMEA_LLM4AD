def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def sample(bounds, best, rng=rng):
        x = np.random.uniform(-5.0, 5.0, size=dim)
        for i in range(dim):
            if rng.rand() < 0.1:
                x[i] += (ub - lb) * rng.rand()
            elif rng.rand() < 0.2 and best[i] != 0:
                x[i] = ub if rng.rand() < 0.5 else lb
        return clip(x)

    def differential_evolution(bounds, budget):
        pop_size = int(np.sqrt(budget))
        population = np.zeros((pop_size, dim))
        for i in range(pop_size):
            population[i] = sample(bounds, None)
        
        for _ in range(budget - pop_size):
            best = population[np.argmin([func(clip(x)) for x in population])]
            new_candidate = sample(bounds, best)
            if func(clip(new_candidate)) < func(clip(best)):
                population[np.argmax([func(clip(x)) for x in population])] = new_candidate
        
        return population[np.argmin([func(clip(x)) for x in population])]

    best = differential_evolution((lb, ub), budget)
    return best
