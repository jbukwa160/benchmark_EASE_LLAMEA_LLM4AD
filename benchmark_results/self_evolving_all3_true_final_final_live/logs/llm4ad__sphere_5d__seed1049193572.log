def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def sample(mu, sigma):
        return mu + sigma * rng.randn(dim)

    mu = np.zeros(dim)
    sigma = 1.0
    population_size = int(np.ceil(budget / dim))
    iteration = 0

    while True:
        iteration += 1
        candidates = np.array([clip(sample(mu, sigma)) for _ in range(population_size)])

        fitnesses = [func(candidate) for candidate in candidates]
        best_candidate = candidates[np.argmin(fitnesses)]
        mu = (iteration - 1) / iteration * mu + 1 / iteration * best_candidate

        if np.linalg.norm(mu) > sigma:
            sigma *= 0.5
        else:
            break

    return clip(mu)
