def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidates):
        return np.clip(candidates, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    def sa_step(x, T, alpha):
        delta_x = rng.uniform(-1, 1, size=dim) * T
        new_x = x + delta_x
        if evaluate(new_x) < evaluate(x):
            return new_x
        else:
            return x

    def de_step(x, y1, y2, c1, c2, f):
        v = c1 * (y1 - x) + c2 * (y2 - x)
        w = clip(v)
        new_x = x + f * w
        return new_x

    best_x = np.zeros(dim)
    best_y = float('inf')

    for _ in range(budget):
        T = 10.0  # initial temperature
        alpha = 0.99  # cooling factor

        x = rng.uniform(lb, ub, size=dim)

        while T > 1e-6:
            y1 = rng.choice(np.random.choice(dim, dim))
            y2 = rng.choice([i for i in range(dim) if i != y1])

            c1 = rng.uniform(0.5, 1)
            c2 = rng.uniform(0.5, 1)

            new_x = de_step(x, y1, y2, c1, c2, T)

            p = np.random.choice([True, False])
            if p:
                x = sa_step(new_x, T, alpha)
            else:
                x = new_x

            y = evaluate(x)

            if y < best_y:
                best_x = x
                best_y = y

            T *= alpha

    return best_x
