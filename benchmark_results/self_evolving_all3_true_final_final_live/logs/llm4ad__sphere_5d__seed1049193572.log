    def wrapper(x):
        return func(np.clip(x, *bounds[0]))
    
    res = differential_evolution(wrapper, bounds, tol=1e-10)
    
    best_x = np.array(res.x)
    min_val = res.fun
    
    for i in range(budget - 1):
        new_x = best_x + rng.uniform(-5.0, 5.0) * (rng.rand(dim) * 2 - 1)
        new_x = np.clip(new_x, *bounds[0])
        
        if func(new_x) < min_val:
            best_x = new_x
            min_val = func(best_x)
    
    return best_x
