def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def get_candidate(parent=None, temperature=1.0):
        if parent is not None:
            candidate = parent + (rng.rand(dim) - 0.5) * 2 * temperature
        else:
            candidate = rng.uniform(lb, ub, size=dim)
        return clip(candidate)

    best_solution = np.inf * np.ones(dim)
    current_solution = get_candidate()
    current_fitness = func(current_solution)

    for i in range(budget):
        neighbor_solution = get_candidate(current_solution, temperature=0.99**i)
        neighbor_fitness = func(neighbor_solution)
        
        if rng.rand() < np.exp((current_fitness - neighbor_fitness) / (temperature * 1e-2)):
            current_solution = neighbor_solution
            current_fitness = neighbor_fitness

        if current_fitness < func(best_solution):
            best_solution = current_solution

    return best_solution
