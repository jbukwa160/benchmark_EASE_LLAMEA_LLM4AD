def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        step_size = 0.1
        noise_level = 0.5
        candidates = np.zeros((dim,))

        # Random walk mechanism
        if rng.rand() < 0.2:
            noise_dir = (ub - lb) * rng.rand(dim)
            x += noise_dir

        # Probabilistic hill climbing strategy
        for i in range(dim):
            candidate = x.copy()
            candidate[i] += step_size
            if func(candidate) < best_f:
                x = candidate
                best_x = x.copy()
                best_f = func(x)

        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
        for i in range(dim):
            candidate = x.copy()
            candidate[i] -= step_size
            if func(candidate) < best_f:
                x = candidate
                best_x = x.copy()
                best_f = func(x)

    return best_x
