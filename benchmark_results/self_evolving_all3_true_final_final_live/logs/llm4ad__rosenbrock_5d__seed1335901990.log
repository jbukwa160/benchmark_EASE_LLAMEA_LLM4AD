def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(current, step_size, rng=rng):
        return current + step_size * (ub - lb) * rng.uniform(-1, 1, size=dim)

    def evaluate(candidate):
        candidate = np.clip(candidate, lb, ub)
        return func(candidate)

    current_solution = rng.uniform(lb, ub, size=dim)
    best_solution = current_solution.copy()
    current_value = evaluate(current_solution)
    best_value = current_value
    step_size = 0.1

    for _ in range(budget):
        new_candidate = get_candidate(current_solution, step_size, rng=rng)
        new_value = evaluate(new_candidate)

        if new_value < best_value:
            best_value = new_value
            best_solution = new_candidate.copy()

        temperature = 0.99 ** (_ + 1)  # adaptive cooling schedule

        if np.random.rand() < np.exp((best_value - current_value) / temperature):
            current_value = new_value
            current_solution = new_candidate.copy()

        step_size *= 0.999  # adjust step size for better convergence

    return best_solution
