def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    current = np.array([0.5*(ub-lb) + rng.random()*(ub-lb) for _ in range(dim)])
    current_best = func(current)
    local_optima_count = 0

    temperature = 1
    while budget > 0:
        budget -= 1
        next_candidate = clip(np.array(current) + temperature*rng.normal(size=dim))
        next_value = func(next_candidate)

        if next_value < current_best:
            current_best = next_value
            current = next_candidate

        # Adapt the temperature schedule based on the number of local optima found
        if np.mean([func(clip(np.array(current) + 1e-6*rng.normal(size=dim))) for _ in range(100)]) < current_best:
            local_optima_count += 1
            temperature *= 0.99
        else:
            local_optima_count = 0

    return current
