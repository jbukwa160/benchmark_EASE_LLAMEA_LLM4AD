def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    D = 1.0 if dim == 1 else (ub - lb) / np.sqrt(dim)
    c1, c2 = 0.5 * D, 0.3
    F = 0.8

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        y = x_best + c1 * rng.normal(size=dim) + c2 * (rng.choice(x_best, dim, replace=False) - x_best)
        y = clip(y)
        y = y + F * (x_best - rng.choice(x_best, dim, replace=False))
        y = clip(y)

        fy = func(y)
        if fy < f_best:
            f_best = fy
            x_best = y

    return x_best
