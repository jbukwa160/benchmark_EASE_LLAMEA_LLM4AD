def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(budget ** 0.5)
    x0 = (ub - lb) * rng.rand(pop_size, dim) + lb
    best_x = None
    best_fval = float('inf')
    
    for i in range(int(0.8 * budget)):
        F = 0.5
        Cr = 0.9
        x = np.zeros((pop_size, dim))
        
        for j in range(pop_size):
            v = x0[j] + F * (x0[j] - x0[(j-1)%pop_size]) + F * (x0[(j+1)%pop_size] - x0[j])
            
            for k in range(dim):
                u = rng.rand()
                if u < Cr or k == np.random.choice(dim, 1)[0]:
                    x[j,k] = v[k]
        
        fval = func(x)
        
        for j in range(pop_size):
            if fval[j] < best_fval:
                best_fval = fval[j]
                best_x = x[j]
    
    for _ in range(int(0.2 * budget)):
        alpha = 1 - (budget - i) / budget
        epsilon = rng.uniform(-5, 5)
        
        new_x = best_x + epsilon
        
        new_fval = func(new_x)
        
        if new_fval < best_fval:
            best_fval = new_fval
            best_x = new_x
    
    return np.clip(best_x, lb, ub)
