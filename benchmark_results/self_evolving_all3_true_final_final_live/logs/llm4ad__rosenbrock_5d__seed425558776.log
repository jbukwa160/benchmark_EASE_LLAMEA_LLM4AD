def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    step_size = 0.1
    
    for _ in range(budget):
        y = x + (np.random.rand(dim) - 0.5) * 2 * step_size
        y = np.clip(y, lb, ub)
        
        f_y = func(y)
        f_x = func(x)
        
        if f_y < f_x:
            x = y.copy()
            best_x = x.copy()
        else:
            step_size *= 0.9
    
    return best_x
