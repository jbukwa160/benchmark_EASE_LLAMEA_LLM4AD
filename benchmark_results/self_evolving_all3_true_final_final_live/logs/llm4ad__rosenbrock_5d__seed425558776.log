def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    # Initialize the simplex
    simplex = np.array([rng.uniform(lb, ub) for _ in range(dim + 1)])

    for iteration in range(budget):
        # Calculate function values at all points in the simplex
        y = [func(clip(point)) for point in simplex]

        # Sort the points by their function value and identify the worst point
        sorted_indices = np.argsort(y)
        worst_point_index = sorted_indices[0]
        worst_point_value = y[worst_point_index]

        if worst_point_value < 1e-6:
            break

        # Calculate the centroid of all but the worst points in the simplex
        centroid = np.mean(simplex[sorted_indices[1:]], axis=0)

        # Generate a new candidate by moving from the worst point towards the centroid
        candidate = simplex[worst_point_index] + 0.5 * (centroid - simplex[worst_point_index])

        # Refine the candidate using the Nelder-Mead method
        for _ in range(10):
            # Calculate function values at points that are reflections of the candidate
            reflected_value = func(clip(candidate + 1.05 * (centroid - candidate)))
            expanded_value = func(clip(candidate + 1.05 * (candidate - centroid)))

            if reflected_value < worst_point_value and reflected_value < expanded_value:
                candidate += (centroid - candidate) / 2
            elif expanded_value < reflected_value and expanded_value < worst_point_value:
                candidate = clip(candidate + (candidate - centroid))
            else:
                break

        # Replace the worst point with the refined candidate
        simplex[worst_point_index] = candidate

    return np.array([func(clip(point)) for point in simplex]).argmin()
