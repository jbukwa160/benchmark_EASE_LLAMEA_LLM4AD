def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    bounds = [(lb, ub) for _ in range(dim)]
    pop_size = 10 * dim
    mutation_factor = 0.8
    crossover_prob = 0.5

    population = []
    for _ in range(pop_size):
        individual = [rng.uniform(lb, ub) for _ in range(dim)]
        population.append(clip(individual))

    for _ in range(budget):
        objective_values = [func(individual) for individual in population]
        best_individual = np.argmin(objective_values)
        best_value = objective_values[best_individual]

        if rng.uniform(0, 1) < 0.01:
            # Simulated Annealing
            new_individual = clip(population[best_individual] + rng.normal(size=dim))
        else:
            # Differential Evolution
            indices = [i for i in range(pop_size) if i != best_individual]
            select_indices = np.random.choice(indices, 3, replace=False)
            trial_individual = population[best_individual] + mutation_factor * (population[select_indices[0]] - population[select_indices[1]]) + \
                               rng.uniform(-1, 1) * (population[select_indices[2]] - population[select_indices[1]])
            trial_individual = clip(trial_individual)

        if rng.uniform(0, 1) < crossover_prob:
            # Crossover
            trial_individual = (trial_individual + population[best_individual]) / 2

        objective_value = func(trial_individual)
        if objective_value < best_value:
            population[best_individual] = trial_individual

    return np.argmin(objective_values)
