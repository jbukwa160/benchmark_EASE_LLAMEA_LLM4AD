def algorithm(func, dim, lb, ub, budget, rng):
    n = len(rng)
    D = [np.random.uniform(lb, ub, size=dim) for _ in range(n)]
    best_sol = None
    best_fval = float('inf')
    
    for it in range(budget):
        F = np.random.uniform(0.5, 1.5, size=n)
        Cr = [np.random.uniform(0, 1, size=dim) for _ in range(n)]
        
        for i in range(n):
            trial_sol = D[i] + F[i] * (D[np.random.choice([j for j in range(n) if j != i])] - D[i])
            
            for d in range(dim):
                if np.random.rand() < Cr[i][d]:
                    a, b = lb[d], ub[d]
                    trial_sol[d] = a + (b-a)*rng[d]
                    
            trial_fval = func(trial_sol)
            trial_fval = np.clip(trial_fval, None, float('inf'))
            
            if trial_fval < best_fval:
                best_fval = trial_fval
                best_sol = trial_sol
                
        D[i] = (1 - F) * D[i] + F * (best_sol - D[i])
        
    return np.array(best_sol)
