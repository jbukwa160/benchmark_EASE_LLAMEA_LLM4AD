def algorithm(func, dim, lb, ub, budget, rng):
    def penalty(x):
        return func(x) + 1e10 * sum(max(0, xi-lb[i])**2 + max(0, ui-ub[i])**2 for i, (xi, ui) in enumerate(zip(x, ub)))

    def mutation(mean, step_size, covariance):
        new_mean = mean + np.random.multivariate_normal(np.zeros(dim), step_size**2 * covariance)
        return clip(new_mean, lb, ub)

    mu = rng.uniform(lb, ub, size=dim)
    step_size = 1.0
    covariance = np.eye(dim)

    for _ in range(budget):
        variation = rng.normal(size=dim)
        offspring = mutation(mu + step_size * variation, step_size, covariance)
        fitness = penalty(offspring)
        if fitness < penalty(mu):
            mu = offspring

    return mu
