def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        x = np.clip(x, lb, ub)
        return func(x)

    D = dim
    popsize = 10 * D
    mu = popsize / 2
    weights = np.log(mu + 0.5) - np.log(D * mu + 1)
    weights /= np.sum(weights)
    cum_weights = np.cumsum(weights)
    c1, cmu, csigma = 0.8, 1.6, 0.5

    x = rng.uniform(lb, ub, size=(popsize, D))
    sigma = 0.1 * (ub - lb)

    for _ in range(budget):
        F = np.zeros((popsize, D))
        for i in range(popsize):
            F[i] = evaluate(x[i])

        z = rng.normal(size=(popsize, D))
        v = np.dot(np.linalg.cholesky(cov), z)
        x_new = x + sigma * v

        u = rng.uniform(0, 1, size=popsize)
        F_new = np.zeros(popsize)
        for i in range(popsize):
            j = np.searchsorted(cum_weights, u[i])
            y = x[j] + weights[j] * (x_new[i] - x[j]) / sigma
            y = evaluate(y)
            if y < F_new[i]:
                F_new[i] = y
                x_new[i] = y

        z = rng.normal(size=(popsize, D))
        v = np.dot(np.linalg.cholesky(cov), z)
        x += c1 * (x_new - x) + cmu / mu * (np.dot(v.T, (F_new - F).T)).T
        sigma *= csigma

    best_x = x[np.argmin(F)]
    return best_x
