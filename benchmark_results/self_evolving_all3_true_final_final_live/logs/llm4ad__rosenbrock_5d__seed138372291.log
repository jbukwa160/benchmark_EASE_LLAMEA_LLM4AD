def algorithm(func, dim, lb, ub, budget, rng):
    def sample_candidate(bounds):
        return [rng.uniform(lb[i], ub[i]) for i in range(dim)]

    def evaluate_candidate(candidate):
        return func(candidate)

    best_so_far = None
    current_best_fitness = float('inf')
    for _ in range(budget):
        candidate = sample_candidate([(lb[i], ub[i]) for i in range(dim)])
        fitness = evaluate_candidate(candidate)
        if fitness < current_best_fitness:
            current_best_fitness = fitness
            best_so_far = candidate

        # clip candidates to [lb, ub]
        candidate = [max(lb[i], min(ub[i], x)) for i, x in enumerate(candidate)]

    return np.array(best_so_far)
