def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def crossover(mu, m1, m2):
        chi = mu + 0.5 * (m1 - m2)
        if rng.random() < 0.5:
            chi = mu + 0.5 * (m2 - m1)
        return chi

    def mutation(mu, delta):
        z = rng.randn(dim) / np.sqrt(rng.randint(1, 100))
        new_mu = mu + delta
        new_delta = delta + 0.9 * (z - 0.5 * rng.randn(dim)) * mu
        return new_mu, new_delta

    def hybrid_search(population, best, budget):
        if len(best) < budget // 2:
            # Global search phase
            for i in range(budget // 10):
                m1 = population[rng.randint(0, len(population))]
                m2 = population[rng.randint(0, len(population))]
                child = crossover(best[-1], m1, m2)
                child = clip(child, lb, ub)
                func(child)
                best.append(child)

            # Local search phase
            for i in range(budget // 10):
                mu = best[-i]
                delta = rng.uniform(-5.0, 5.0, dim)
                new_mu, new_delta = mutation(mu, delta)
                child = clip(new_mu + new_delta, lb, ub)
                func(child)
                best.append(child)

        else:
            # Converged to local minimum, perform local search
            mu = best[-1]
            for i in range(budget // 10):
                delta = rng.uniform(-0.5, 0.5, dim)
                new_mu, new_delta = mutation(mu, delta)
                child = clip(new_mu + new_delta, lb, ub)
                func(child)
                best.append(child)

        return best

    population = np.random.uniform(lb, ub, (budget, dim))
    for i in range(budget):
        population[i] = clip(population[i], lb, ub)
        func(population[i])

    best = []
    for _ in range(budget // 2):
        m1 = population[rng.randint(0, len(population))]
        m2 = population[rng.randint(0, len(population))]
        child = crossover(np.array([1] * dim), m1, m2)
        child = clip(child, lb, ub)
        func(child)
        best.append(child)

    best = hybrid_search(best, best, budget)
    return np.array(best[-1])
