def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    X = 1 + rng.normal(0, 1e-2, (budget, dim))
    Y = func(clip(X))

    for _ in range(budget - 1):
        idx = np.random.choice(Y.shape[0], p=np.exp(-Y) / np.sum(np.exp(-Y)))
        X_new = X[idx] + rng.normal(0, 1e-2, dim)
        Y_new = func(clip(X_new))
        
        if Y_new < Y[idx]:
            X[idx] = X_new
            Y[idx] = Y_new

    best_idx = np.argmin(Y)
    return clip(X[best_idx])
