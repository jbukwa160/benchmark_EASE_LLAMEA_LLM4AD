def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(size):
        return rng.uniform(lb, ub, (size, dim))

    def evaluate_population(population):
        return np.array([func(ind) for ind in population])

    def global_optimization():
        x = generate_initial_population(100)
        f_values = evaluate_population(x)
        best_ind = x[np.argmin(f_values)]
        best_f_value = np.min(f_values)
        
        for _ in range(budget // 10):
            new_x = generate_initial_population(1)
            new_f_value = func(new_x[0])
            if new_f_value < best_f_value:
                best_ind = new_x[0]
                best_f_value = new_f_value
        
        return best_ind, best_f_value

    def local_search(best_ind):
        step_size = 0.01
        for _ in range(budget // 10):
            ind = clip(best_ind + rng.uniform(-step_size, step_size, dim))
            f_value = func(ind)
            if f_value < func(best_ind):
                best_ind = ind
        
        return best_ind

    best_ind, _ = global_optimization()
    local_search(best_ind)

    return clip(best_ind)
