def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    lambda_ = int(np.ceil(budget**(1/dim)))
    mu = 0.5 * lambda_
    sigma = 1.0
    c_c = 2 / (dim + 1.25)
    c_m = 2 / ((dim + 1.25) ** 2)
    c_damp = 0.5

    for _ in range(budget):
        y = func(x)
        if np.isnan(y):
            return np.array([np.nan])
        
        z = x + sigma * rng.normal(size=dim)
        z = np.clip(z, lb, ub)

        y_z = func(z)
        if np.isnan(y_z):
            continue
        
        f_z = y_z - y
        f_x = 0.5 * (f_z ** 2) / lambda_

        a_x = np.zeros(dim)
        x_diff = z - x
        for i in range(lambda_):
            idx = rng.randint(1, mu+1)
            if idx == 1:
                a_x += f_x * c_c * (x_diff / (lambda_*sigma))
            elif idx <= mu:
                u = np.random.uniform(size=dim)
                idx_u = np.argsort(-u)[:idx]
                a_x[idx_u] += f_x * c_c * (x_diff[idx_u] / (lambda_*sigma))

        x -= a_x
        x = np.clip(x, lb, ub)

    return x
