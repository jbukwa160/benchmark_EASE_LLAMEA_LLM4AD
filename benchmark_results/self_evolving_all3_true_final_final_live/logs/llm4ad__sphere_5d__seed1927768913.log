def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    for _ in range(budget):
        sigma = 2 / (1 + _/budget)**0.9
        distribution = rng.normal(0, sigma, size=(dim,))
        candidate = lb + (ub-lb) * distribution
        candidate = np.clip(candidate, lb, ub)
        f_candidate = func(candidate)
        if f_candidate < x_best[-np.inf]:
            x_best = candidate
    return x_best
