def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_y = func(x)
    
    for _ in range(budget):
        noise = 0.1 * (ub - lb) * np.random.randn(dim)
        x += noise
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, a_min=lb, a_max=ub)
        
        y = func(x)
        
        if y < best_y:
            best_x = x.copy()
            best_y = y
    
    return best_x
