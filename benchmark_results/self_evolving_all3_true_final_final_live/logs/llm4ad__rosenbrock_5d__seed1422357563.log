def algorithm(func, dim, lb, ub, budget, rng):
    def bounds_check(x):
        return np.clip(x, lb, ub)

    x = bounds_check(np.random.rand(dim))
    y_best = func(x)
    for _ in range(budget - 1):
        F = rng.uniform(0.4, 0.9) # scaling factor
        Cr = rng.uniform(0.5, 1.0) # crossover probability
        x_new = bounds_check(x + F * (rng.choice([x]) - x))
        y_new = func(bounds_check(x_new))
        if y_new < y_best:
            x = x_new
            y_best = y_new
        else:
            beta = rng.uniform(0.1, 10)
            x_trial = bounds_check(x + beta * (x_new - x))
            y_trial = func(bounds_check(x_trial))
            if y_trial < y_best:
                x = x_trial
                y_best = y_trial
    return x
