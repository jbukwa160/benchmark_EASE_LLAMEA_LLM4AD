def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=(dim,))
    T = 100.0
    iters = 0

    while iters < budget:
        iters += 1
        f_x = func(clip(x))
        
        # Simulated Annealing step
        if rng.rand() < np.exp(-(f_x - func(clip(x + 0.1 * rng.randn(dim)))) / T):
            x = clip(x + 0.1 * rng.randn(dim))

        # Nelder-Mead optimization step
        y = clip(x + 0.5 * rng.randn(dim))
        f_y = func(y)
        
        if f_y < f_x:
            x = y

        # Cooling schedule for temperature
        T *= 0.99
        
    return clip(x)
