def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(budget):
        return [clip(rng.uniform(lb, ub, size=dim)) for _ in range(int(budget/2))]

    def adaptive_differential_evolution(population, budget, dim):
        children = []
        for _ in range(int(budget)):
            parents = np.random.choice(population, 3, replace=False)
            child = clip(parents[0] + rng.uniform(-1, 1) * (parents[1]-parents[2]))
            children.append(child)
        return children

    def simulated_annealing(children, population, budget):
        T = 10
        for _ in range(int(budget)):
            i = np.random.choice(len(population))
            j = np.random.choice(len(children))
            if func(children[j]) < func(population[i]):
                population[i] = children[j]
            else:
                r = rng.uniform(0, 1)
                T *= 0.99
                if r < np.exp((func(population[i])-func(children[j]))/T):
                    population[i] = children[j]

    initial_population = generate_initial_population(budget)
    for _ in range(int(budget*2)):
        children = adaptive_differential_evolution(initial_population, budget, dim)
        simulated_annealing(children, initial_population, budget)

    return min(initial_population, key=func)
