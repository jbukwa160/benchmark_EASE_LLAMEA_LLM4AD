def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(x, F, Cr):
        x_new = x.copy()
        for i in range(dim):
            if rng.random() < Cr:
                u = rng.uniform(lb, ub)
                v = rng.uniform(lb, ub)
                mu = x_new[i] + F * (v - u)
                x_new[(i+1)%dim] = mu
        return np.clip(x_new, lb, ub)

    def differential_evolution(x0, F, Cr):
        x_best = x0.copy()
        f_best = func(x0)
        for i in range(budget):
            x_mutated = mutate(x0, F, Cr)
            fx_mutated = func(x_mutated)
            if fx_mutated < f_best:
                x_best = x_mutated
                f_best = fx_mutated
            x0 = x_mutated
        return x_best

    # Initial population
    x0 = rng.uniform(lb, ub, size=dim)

    # Differential Evolution parameters
    F_max = 1.2
    F_min = 0.5
    Cr_max = 0.9
    Cr_min = 0.1

    F = np.linspace(F_max, F_min, budget)[0]
    Cr = np.random.uniform(Cr_min, Cr_max)

    # Run Differential Evolution
    x_best = differential_evolution(x0, F, Cr)
    
    return x_best
