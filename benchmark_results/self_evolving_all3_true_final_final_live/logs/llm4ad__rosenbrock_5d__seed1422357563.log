def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def polynomial_chaos_expansion(x, mean, cov):
        x = clip(x)
        k = 2 * dim - 1
        pc_x = np.zeros(dim)
        for i in range(dim):
            pc_x[i] = mean[i]
            for j in range(1, k+1):
                pc_x[i] += (x[j]**j) * cov[i, j]
        return pc_x

    def generate_candidates(mean, cov, budget):
        x_new = np.zeros((budget, dim))
        for i in range(budget):
            if rng.random() < 0.5:  # 50% chance of using PC expansion
                x_new[i] = polynomial_chaos_expansion(rng.normal(size=2*dim), mean, cov)
            else:
                x_new[i] = clip(mean + np.dot(rng.randn(dim), np.sqrt(cov)))
        return x_new

    def cma_es(func, dim, lb, ub, budget):
        mu = 0.1 * rng.rand(dim)
        sigma = 10
        cov = np.eye(dim) * (sigma ** 2)
        for _ in range(budget):
            candidates = generate_candidates(mu, cov, 100)
            scores = [func(x) for x in candidates]
            best_idx = np.argmin(scores)
            mean = mu + np.dot(rng.randn(dim), np.sqrt(cov))
            mean = clip(mean)
            if scores[best_idx] < func(clip(mu)):
                mu = candidates[best_idx]
                cov += 0.1 * (candidates[best_idx] - mu) * (candidates[best_idx] - mu).T
        return mu

    best_x = cma_es(func, dim, lb, ub, budget)
    return best_x
