def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for i in range(budget):
        step_size = 1 / (i + 1) ** 0.5
        std_dev = step_size * (ub - lb) / 3

        x_new = np.copy(x_best)
        for j in range(dim):
            noise = rng.uniform(-1, 1) * rng.normal(0, std_dev)
            x_new[j] += noise

        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
