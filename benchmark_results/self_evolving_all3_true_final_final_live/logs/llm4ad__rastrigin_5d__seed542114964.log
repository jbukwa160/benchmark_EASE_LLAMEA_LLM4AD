def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    sigma = 0.5
    mu = 1 / (2 * pop_size)
    n_gen = 0
    best_sol = None
    best_eval = float('inf')
    
    while n_gen < budget:
        if n_gen == 0:
            init = np.random.uniform(lb, ub, (pop_size, dim))
        else:
            mean = (mu * (best_sol + init)) / (1 + mu)
            cov = sigma ** 2 * np.eye(dim)
            pop_size_new = int(pop_size * (1 - mu))
            new_init = np.random.multivariate_normal(mean.flatten(), cov, size=pop_size_new) + np.random.uniform(lb, ub, (pop_size_pop_size_new, dim))
            init = np.vstack((init, new_init))
        
        scores = func(init)
        n_gen += 1
        
        idx_best = np.argmin(scores)
        if scores[idx_best] < best_eval:
            best_sol = init[idx_best]
            best_eval = scores[idx_best]
        
        init = clip_to_bounds(init, lb, ub)
    
    return best_sol
