def algorithm(func, dim, lb, ub, budget, rng):
    D = len(lb)
    X = rng.uniform(lb, ub, (1, D))
    best_X = X.copy()
    best_f = func(X)
    
    for t in range(1, budget + 1):
        mean, var = compute_gp_mean_var(X)
        
        ucb = np.inf
        x_new = None
        
        for i in range(D):
            mu, sigma = mean[i], np.sqrt(var[i])
            x_new_i = X[0, i] + 0.01 * rng.normal(0, 1) if np.random.rand() < 0.5 else lb[i] + (ub[i] - lb[i]) * rng.uniform(0, 1)
            f_new = func(np.array([x_new_i] + [X[0, j] for j in range(D) if i != j]))
            
            if f_new < best_f:
                x_new = np.array([x_new_i] + [X[0, j] for j in range(D) if i != j])
                ucb = 1 / (var[i] * t)
        
        if ucb == np.inf:
            x_new = X.copy()
        
        X = np.array([x_new] + [X[0, i] for i in range(D)])
        f_new = func(X)
        
        if f_new < best_f:
            best_X = X.copy()
            best_f = f_new
    
    return best_X
