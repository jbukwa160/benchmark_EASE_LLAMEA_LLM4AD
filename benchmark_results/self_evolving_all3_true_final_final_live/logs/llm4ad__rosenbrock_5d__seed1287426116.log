def algorithm(func, dim, lb, ub, budget, rng):
    def modified_func(x):
        return func(np.clip(x, a_min=lb, a_max=ub))

    n_pop = 50
    bounds = [(lb, ub) for _ in range(dim)]
    pop = np.random.uniform(lb, ub, size=(n_pop, dim))
    best_sol = None

    for _ in range(budget):
        fitnesses = [modified_func(x) for x in pop]
        idx_best = np.argmin(fitnesses)
        if fitnesses[idx_best] < 1e-6:  # convergence criterion
            break

        F = 0.5
        CR = 0.9
        v = rng.uniform(0, 1, size=(n_pop, dim))
        u = rng.uniform(0, 1, size=n_pop)
        x_new = pop.copy()

        for i in range(n_pop):
            x_rand = np.random.choice(pop, size=dim, replace=False)
            for j in range(dim):
                if u[i] < CR or j == 0:
                    x_new[i, j] = v[i, j] * (x_rand[j] - pop[idx_best, j]) + pop[idx_best, j]
                else:
                    x_new[i, j] = pop[i, j]

        pop = np.clip(x_new, a_min=lb, a_max=ub)

        if best_sol is None or modified_func(pop[idx_best]) < modified_func(best_sol):
            best_sol = pop[idx_best].copy()

    return best_sol
