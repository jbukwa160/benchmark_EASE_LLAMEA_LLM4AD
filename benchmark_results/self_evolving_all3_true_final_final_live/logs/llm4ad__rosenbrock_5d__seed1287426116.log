def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    n = 5
    pop_size = int(np.sqrt(budget))
    iter_count = 0
    best_candidate = np.random.uniform(lb, ub, size=(dim,))
    
    while iter_count < budget:
        population = np.vstack([clip(np.random.uniform(lb, ub, size=(dim,))) for _ in range(pop_size)])
        
        fit_vals = np.array([func(candidate) for candidate in population])
        
        best_idx = np.argmin(fit_vals)
        if fit_vals[best_idx] < func(best_candidate):
            best_candidate = population[best_idx]
            
        for i in range(pop_size):
            parent1_idx, parent2_idx = rng.choice(pop_size, size=2, replace=False)
            child = population[parent1_idx] + 0.5 * (population[parent2_idx] - population[i]) + 0.5 * np.random.uniform(-1, 1, size=(dim,))
            fit_val_child = func(clip(child))
            
            if fit_val_child < fit_vals[best_idx]:
                population[i] = child
                fit_vals[i] = fit_val_child
                
        iter_count += 1
        
    return best_candidate
