def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(-5.0, 5.0, size=dim)
    current_best = func(clip(x))
    temperature = 1.0
    step_size = 0.01

    for _ in range(budget):
        new_x = clip(x + rng.normal(size=dim) * np.sqrt(step_size))
        new_cost = func(new_x)

        if new_cost < current_best:
            x = new_x
            current_best = new_cost

        temperature *= 0.99
        step_size *= 0.9995

    return x
