def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best = np.random.uniform(lb, ub, size=dim)
    best_fitness = func(best)

    for _ in range(budget):
        new_candidate = best + 0.1 * (ub - lb) * rng.randn(dim)
        new_candidate = clip(new_candidate)
        new_fitness = func(new_candidate)

        if new_fitness < best_fitness:
            best = new_candidate
            best_fitness = new_fitness

    return best
