def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    pop_size = int(np.sqrt(budget))
    pop = np.random.uniform(lb, ub, (pop_size, dim))

    best = pop[0]
    for _ in range(pop_size - 1):
        new_pop = np.copy(pop)
        for i in range(pop_size):
            trial = clip(new_pop[i] + rng.normal(0, 1, size=dim) * 5 / (i + 2))
            if func(trial) < func(best):
                best = trial
            elif rng.uniform(0, 1) > np.exp(-func(trial) - func(best)):
                new_pop[i] = trial
        pop = new_pop

    return best
