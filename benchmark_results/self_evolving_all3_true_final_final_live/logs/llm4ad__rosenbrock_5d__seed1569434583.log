def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    D = dim
    n_iter = budget // pop_size
    x_min = -5.0
    x_max = 5.0
    
    # Initialize population
    pop = (ub - lb) * rng.rand(pop_size, D) + lb
    best_pop = np.copy(pop)
    
    for _ in range(n_iter):
        for i in range(pop_size):
            # Select three random individuals and their indices
            idxs = np.random.choice(np.delete(np.arange(pop_size), i), 3, replace=False)
            x1, x2, x3 = pop[idxs]
            
            # Create a mutant vector
            mutant = (x1 + rng.uniform(-1, 1) * (x2 - x1)) + (x3 + rng.uniform(-1, 1) * (x1 - x3))
            
            # Clip the mutant to bounds
            mutant = np.clip(mutant, lb, ub)
            
            # Apply adaptive mutation strategy
            if func(mutant) < func(best_pop[i]):
                best_pop[i] = np.copy(mutant)
        
        # Update population with the best individuals
        pop = np.copy(best_pop)
    
    # Find the best individual in the final population
    idx_best = np.argmin([func(x) for x in pop])
    return pop[idx_best]
