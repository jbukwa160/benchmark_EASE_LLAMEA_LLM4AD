def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (dim,))
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Step 1: Large jump
        s = np.zeros((dim,))
        for i in range(dim):
            if rng.rand() < 0.2:
                s[i] = rng.uniform(-5, 5)
        x_new = x + s

        # Clip to bounds
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)

        # Step 2: Local refinement
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new

            for _ in range(10):
                s = rng.uniform(-1, 1, (dim,))
                x_new = np.clip(best_x + s, lb, ub)
                f_new = func(x_new)

                if f_new < best_f:
                    best_x = x_new.copy()
                    best_f = f_new

    return best_x
