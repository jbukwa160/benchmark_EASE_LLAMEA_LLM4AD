def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget - 1):
        x_try = rng.uniform(lb, ub, (1, dim))
        
        if rng.random() < 0.01:
            std_dev = 1
        else:
            std_dev = np.std(func(np.clip(x_try, lb, ub)) - best_f)
            
        noise = rng.normal(0, std_dev, (1, dim))
        x_try += noise
        
        f_try = func(np.clip(x_try, lb, ub))
        
        if f_try < best_f:
            best_x = x_try.copy()
            best_f = f_try
    
    return best_x
