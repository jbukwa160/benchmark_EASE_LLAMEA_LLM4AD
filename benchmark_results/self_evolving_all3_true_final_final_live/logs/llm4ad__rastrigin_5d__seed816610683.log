def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def eval(x):
        return func(x)

    x = clip(rng.uniform(lb, ub, size=dim))
    x_best = x.copy()
    f_best = eval(x)
    for _ in range(budget):
        v = x + rng.normal(size=dim) * 0.1
        v = clip(v)
        f_v = eval(v)
        if f_v < f_best:
            f_best = f_v
            x_best = v.copy()
        y = x_best + rng.normal(size=dim) * 0.01
        y = clip(y)
        f_y = eval(y)
        if f_y < f_best:
            f_best = f_y
            x_best = y.copy()
    return x_best
