def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    n = dim
    x_best = np.random.uniform(lb, ub, (1, n))
    f_best = func(x_best)
    num_no_improvement = 0

    for _ in range(budget):
        if num_no_improvement >= 100:
            x_best = np.random.uniform(lb, ub, (1, n))
            num_no_improvement = 0
            f_best = func(x_best)

        candidate = clip(rng.normal(loc=x_best[0], scale=3.0, size=(1, n)))
        f_candidate = func(candidate)

        if f_candidate < f_best:
            x_best = candidate
            f_best = f_candidate
            num_no_improvement = 0
        else:
            num_no_improvement += 1

    return x_best
