def algorithm(func, dim, lb, ub, budget, rng):
    def bounds(x):
        return [min(max(i, lb), ub) for i in x]

    def generate_population(pop_size):
        return [bounds([rng.uniform(lb, ub) for _ in range(dim)]) for _ in range(pop_size)]

    def evaluate(population):
        return np.array([func(individual) for individual in population])

    population = generate_population(100)
    for _ in range(budget - 1):
        population = np.array(population)
        fitness = evaluate(population)

        # Find the best individual
        best_individual = population[np.argmin(fitness)]

        # Perform crossover
        crossover_rate = 0.5 + 0.3 * (np.sin(_ / budget) + 1) / 2
        children = []
        for _ in range(pop_size):
            parent1, parent2 = rng.choice(population, size=2, replace=False)
            child = bounds([(crossover_rate * parent1[i] + (1 - crossover_rate) * parent2[i]) for i in range(dim)])
            children.append(child)

        # Perform mutation
        mutation_rate = 0.1 + 0.3 * np.sin(_ / budget)
        for i, individual in enumerate(population):
            for j in range(dim):
                if rng.uniform(0, 1) < mutation_rate:
                    population[i][j] += mutation_rate * (ub - lb) * rng.uniform(-1, 1)

        # Replace worst individuals with new ones
        population = np.array([individual for individual in children[:pop_size]] + [bounds([rng.uniform(lb, ub) for _ in range(dim)]) for _ in range(pop_size - pop_size)])

    return bounds([np.argmin(evaluate(population))])
