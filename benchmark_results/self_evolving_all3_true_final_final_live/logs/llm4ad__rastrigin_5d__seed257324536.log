def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    n = 20  # population size
    T = 1.0  # initial temperature
    sigma = 0.5  # initial standard deviation
    x_best = np.zeros(dim)
    f_best = float('inf')

    for _ in range(budget):
        X = np.random.uniform(lb, ub, (n, dim))
        F = func(X)

        for i in range(n):
            if F[i] < f_best:
                f_best = F[i]
                x_best = X[i]

        sigma *= 0.99  # decrease standard deviation

        # Simulated Annealing
        for _ in range(int(n * 0.1)):
            i, j = random.sample(range(n), 2)
            dx = np.random.normal(0, sigma, dim)

            x_new = clip(x_best + dx)
            f_new = func(np.array([x_new]))

            if f_new < f_best:
                f_best = f_new
                x_best = x_new

        # Evolution Strategies
        for _ in range(int(n * 0.9)):
            i = random.randint(0, n - 1)
            dx = np.random.normal(0, sigma, dim)

            x_new = clip(x_best + dx)
            f_new = func(np.array([x_new]))

            if f_new < f_best:
                f_best = f_new
                x_best = x_new

    return x_best
