def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    def objective(params):
        return func(params)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_y = objective(x)

    for _ in range(budget):
        y = objective(x)
        if y < best_y:
            best_y = y
            best_x = x.copy()

        for i in range(dim):
            v = np.clip(x + 0.1 * rng.uniform(-1, 1), lb, ub)
            w = np.clip(x + 0.2 * rng.uniform(-1, 1), lb, ub)

            y_v = objective(v)
            y_w = objective(w)

            if y_v < best_y:
                best_y = y_v
                x = v.copy()
            elif y_w < best_y:
                best_y = y_w
                x = w.copy()

        x = clip(x)

    return best_x
