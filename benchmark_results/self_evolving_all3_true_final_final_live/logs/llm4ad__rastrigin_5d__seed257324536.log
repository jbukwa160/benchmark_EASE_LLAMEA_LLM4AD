def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    def objective(x):
        return func(x)

    x = np.random.uniform(lb, ub, size=(dim,))
    T = 10.0
    cooling_rate = 0.99

    for _ in range(budget):
        x_new = x + rng.normal(0, 1, size=(dim,))
        x_new = clip(x_new)

        f_x = objective(x)
        f_x_new = objective(x_new)

        if f_x_new < f_x:
            x = x_new
        else:
            delta = f_x_new - f_x
            prob = np.exp(-delta / T)
            if rng.random() < prob:
                x = x_new

        T *= cooling_rate

    return clip(x)
