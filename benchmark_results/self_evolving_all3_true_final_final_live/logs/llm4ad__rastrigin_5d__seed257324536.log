def algorithm(func, dim, lb, ub, budget, rng):
    def gp_model(params):
        x = params.reshape(-1, dim)
        return func(x) + 1e-9 * np.sum(np.abs(params))
    
    x0 = (ub - lb) * rng.rand(dim) + lb
    best_x = x0.copy()
    best_f = gp_model(best_x)
    
    for _ in range(budget):
        y, cov = gp_model(best_x), 1e-9 * np.eye(dim)
        
        def posterior(params):
            k = np.exp(-(np.sum((params - best_x)**2, axis=0)) / (2 * cov))
            return y + k * rng.normal(0, 1e-3) * params
        
        x_new = clip(posterior(best_x), lb, ub)
        
        f_new = gp_model(x_new)
        if f_new < best_f:
            best_f = f_new
            best_x = x_new.copy()
    
    return best_x
