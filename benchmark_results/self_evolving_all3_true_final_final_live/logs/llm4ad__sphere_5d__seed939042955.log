def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')

    for _ in range(budget):
        r = 5.0 / (1 + 0.99 * (_ / budget))
        x_new = x_best + r * rng.normal(size=dim)
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)

        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
