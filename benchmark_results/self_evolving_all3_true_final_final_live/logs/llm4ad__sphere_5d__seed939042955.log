def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(-5.0, 5.0, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    learning_rate = 1.0
    for _ in range(budget):
        new_x = clip(best_x + learning_rate * (rng.uniform(-1.0, 1.0, size=dim)))
        new_f = func(new_x)
        
        if new_f < best_f:
            best_x = new_x
            best_f = new_f
        
        learning_rate *= 0.99
    
    return best_x
