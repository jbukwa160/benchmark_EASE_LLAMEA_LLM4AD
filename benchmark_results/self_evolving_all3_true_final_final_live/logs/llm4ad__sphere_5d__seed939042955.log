def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best = None
    best_evals = float('inf')

    for _ in range(budget // 2): # random restarts
        x = rng.uniform(lb, ub, size=dim)
        while True:
            y = x + rng.normal(size=dim)
            y = clip(y)
            if func(y) < best_evals:
                best_evals = func(y)
                best = y
            elif np.random.rand() > 0.9: # probability of stopping
                break
            x = y

    return best
