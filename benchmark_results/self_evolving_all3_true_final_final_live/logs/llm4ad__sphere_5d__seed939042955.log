def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Select top 10% of dimensions with largest improvement
        grad_idx = np.argsort(np.abs([func(x + 1e-6 * lb[i] * rng.random()) - best_f for i in range(dim)]))[::-1]
        select_dim = grad_idx[:int(0.1*dim)]

        # Perform grid search over selected dimensions
        new_x = x.copy()
        for i in select_dim:
            new_x[i] = ub if func(new_x + 1e-6 * (ub - lb[i]) * rng.random()) < best_f else lb

        # Clip candidates to [lb, ub]
        new_x = np.clip(new_x, lb, ub)

        # Update best solution
        f_new = func(new_x)
        if f_new < best_f:
            best_f = f_new
            best_x = new_x.copy()

    return best_x
