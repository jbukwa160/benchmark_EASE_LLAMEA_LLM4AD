def algorithm(func, dim, lb, ub, budget, rng):
    def sample_gaussian(mean, cov):
        return mean + cov @ np.random.multivariate_normal(np.zeros(dim), np.eye(dim))

    def adapt_distribution(dist, x_best, t):
        for i in range(len(dist)):
            dist[i] = 0.1 * np.exp(- (np.linalg.norm(x_best - dist[i]) / (t + 1))**2)
        return dist / sum(dist)

    best_x = None
    best_f = float('inf')
    distribution = [sample_gaussian(np.zeros(dim), np.eye(dim)) for _ in range(100)]
    
    for t in range(budget):
        x = adapt_distribution(distribution, best_x if best_x is not None else sample_gaussian(np.zeros(dim), np.eye(dim)), t)
        x = lb + (ub - lb) * rng.uniform(size=dim)
        x = np.clip(x, lb, ub)
        
        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x.copy()
        
        distribution = adapt_distribution(distribution, best_x, t)
    
    return best_x
