def algorithm(func, dim, lb, ub, budget, rng):
    def fitness(x):
        return func(x)

    bounds = [(lb, ub) for _ in range(dim)]
    pop_size = 100
    de_maxiter = int(budget / pop_size)
    de_popsize = min(pop_size, 2 * dim + 1)
    de_strategy = 'rand1exp'
    de_jitter = 0.01

    result_de = differential_evolution(fitness, bounds=bounds, maxiter=de_maxiter, population_size=de_popsize,
                                       strategy=de_strategy, mutation=(1.0, 2), jitter=de_jitter)
    x_best_de = result_de.x

    def obj_func(x):
        return func(x)

    cons = ({'type': 'ineq', 'fun': lambda x: ub - x}, 
            {'type': 'ineq', 'fun': lambda x: x - lb})
    res = minimize(obj_func, x_best_de, method='SLSQP', constraints=cons)
    
    return np.clip(res.x, a_min=lb, a_max=ub)
