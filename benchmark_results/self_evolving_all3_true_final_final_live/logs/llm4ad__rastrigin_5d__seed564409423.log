def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    N = 50  # Population size
    F = 1  # Scale factor for mutation
    CR = 0.9  # Crossover probability
    P = int(np.sqrt(D))  # Number of populations to use in each generation

    x = np.random.uniform(lb, ub, (N, D))
    y = func(x)

    best_x = np.zeros((1, D))
    best_y = float('inf')

    for i in range(budget):
        z = np.zeros((P, D))
        w = np.zeros(P)
        for p in range(P):
            idx = rng.choice(N, D, replace=False)
            z[p] = x[idx]
            w[p] = func(z[p])
            if w[p] < best_y:
                best_x[0] = z[p]
                best_y = w[p]

        for p in range(P):
            v = np.zeros(D)
            u = np.random.uniform(0, 1, D)

            if rng.random() < CR or w[p] == best_y:
                v[u < CR] = x[rng.choice(N, int(CR * D), replace=False)][u < CR]
                v[u >= CR] = z[p][u >= CR]

            else:
                idx = np.argsort(w[:p] + w[p+1:])[:2]
                for d in range(D):
                    if rng.random() < 0.5:
                        if u[d] < CR:
                            v[d] = x[idx[0]][d]
                        else:
                            v[d] = z[p][d]
                    else:
                        if u[d] < CR:
                            v[d] = x[idx[1]][d]
                        else:
                            v[d] = z[p][d]

            v = lb + (ub - lb) * v
            y = func(v)
            if y < w[p]:
                z[p] = v
                w[p] = y

        x = np.clip(z, lb, ub)

    return best_x
