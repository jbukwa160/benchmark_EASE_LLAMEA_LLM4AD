def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    sigma = 0.1
    T = 100.0
    cooling_rate = 0.99
    
    x_best = np.random.uniform(lb, ub, size=(pop_size, dim))
    f_best = np.inf
    for i in range(budget):
        x_new = x_best.copy()
        
        # DE mutation
        v = rng.normal(size=x_best.shape)
        z = x_best + sigma * v
        
        # Clip to bounds
        z = np.clip(z, lb, ub)
        
        # SA acceptance
        f_new = func(z)
        if f_new < f_best:
            f_best = f_new
            x_best = z
        elif rng.uniform(0, 1) < np.exp((f_best - f_new) / T):
            x_best = z
        
        # Cooling schedule
        T *= cooling_rate
    
    return x_best[np.argmin([func(x) for x in x_best])]
