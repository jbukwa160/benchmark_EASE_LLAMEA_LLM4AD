def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    def generate_initial_population(dim, pop_size):
        return rng.uniform(lb, ub, size=(pop_size, dim))

    def select_parents(population, fitness_values, pop_size):
        indices = np.argsort(fitness_values)[:pop_size]
        return population[indices], fitness_values[indices]

    def crossover(parents, trial_populations, pop_size):
        children = np.zeros((pop_size, dim))
        for i in range(pop_size):
            parent1, parent2 = parents[i], parents[np.random.choice(pop_size-1, p=rng.uniform(0, 1, size=pop_size))]
            crossover_rate = rng.uniform(0, 1)
            if crossover_rate < 0.5:
                children[i] = (parent1 + parent2) / 2
            else:
                children[i] = (parent1 - parent2) / 2
        return children

    def mutate(children, pop_size):
        mutated_children = np.copy(children)
        for i in range(pop_size):
            mutation_rate = rng.uniform(0, 1)
            if mutation_rate < 0.01:
                index = rng.choice(dim)
                mutated_children[i, index] += rng.uniform(-1, 1) * (ub - lb)
        return mutated_children

    def differential_evolution(population, fitness_values, pop_size):
        trial_populations = np.copy(population)
        for i in range(budget):
            children = crossover(population, trial_populations, pop_size)
            mutated_children = mutate(children, pop_size)
            trial_fitness_values = np.array([evaluate(x) for x in mutated_children])
            population, fitness_values = select_parents(mutated_children, trial_fitness_values, pop_size)

    def initialize_population():
        return generate_initial_population(dim, 100)

    population = initialize_population()
    for _ in range(10): # 10 generations
        differential_evolution(population, np.array([evaluate(x) for x in population]), 100)

    best_individual_index = np.argmin(np.array([evaluate(x) for x in population]))
    return population[best_individual_index]
