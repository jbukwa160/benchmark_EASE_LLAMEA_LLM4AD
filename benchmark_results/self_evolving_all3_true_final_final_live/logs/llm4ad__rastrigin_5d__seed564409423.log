def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    x = np.zeros(dim)
    cov = np.eye(dim) * 0.1
    n_evals = 0
    best_x = x.copy()
    best_f = func(x)

    while n_evals < budget:
        for _ in range(10):
            z = rng.randn(dim)
            y = x + cov @ z
            y = bound(y)
            f_y = func(y)
            if f_y < best_f:
                best_x = y.copy()
                best_f = f_y

        sigma = np.sqrt(np.linalg.det(cov))
        mu = 1 / (sigma ** 2)

        z = rng.randn(dim)
        y = x + cov @ z
        y = bound(y)
        f_y = func(y)

        cov += mu * (np.outer(z, z) - cov)
        n_evals += 1

    return best_x
