def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return func(x)

    def gradient(x):
        g = np.zeros(dim)
        for i in range(dim - 1):
            g[i] += 400 * (x[i + 1] - x[i]**2) * (2 * x[i] - 1)
            g[i + 1] += 200 * (x[i + 1] - x[i]**2)
        return g

    def clip(x):
        return np.clip(x, lb, ub)

    best = np.random.uniform(lb, ub, dim)
    best_f = Rosenbrock(best)

    for _ in range(budget):
        candidate = best + rng.normal(0, 1e-2, size=dim)
        candidate = clip(candidate)

        f_candidate = Rosenbrock(candidate)

        if f_candidate < best_f:
            best = candidate
            best_f = f_candidate

        gradient_step = -gradient(best) * 1e-3
        local_best = best + gradient_step
        local_best = clip(local_best)
        local_best_f = Rosenbrock(local_best)

        if local_best_f < best_f:
            best = local_best
            best_f = local_best_f

    return best
