def algorithm(func, dim, lb, ub, budget, rng):
    def prob_dist(x):
        return np.exp(-func(x)) / sum(np.exp(-func(y)) for y in x_list)

    x_list = [np.random.uniform(lb, ub, size=dim) for _ in range(budget)]
    x_best = x_list[0]
    best_func_val = func(x_best)
    
    for i in range(1, budget):
        prob = prob_dist(x_list[i-1])
        r = rng.uniform(0, 1)
        new_x = x_list[i-1] + r * (ub - lb) * np.random.normal(size=dim)
        
        # clip new_x to [lb, ub]
        new_x = np.clip(new_x, lb, ub)
        
        if func(new_x) < best_func_val:
            x_best = new_x
            best_func_val = func(new_x)
            
        # adaptive sampling around promising areas
        if r > 0.5 and rng.uniform(0, 1) < (best_func_val - func(x_list[i-1])) / (func(x_list[i]) - func(x_list[i-1])):
            x_list.append(new_x)
    
    return x_best
