def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    def mutate(x):
        v = np.random.uniform(lb, ub, size=dim)
        for i in range(dim):
            if rng.random() < 0.1:
                x[i] += (v[i] - x[i]) * rng.uniform(0, 1)
        return x

    def crossover(x, y):
        v = np.zeros(dim)
        for i in range(dim):
            v[i] = x[i] + (y[i] - x[i]) * rng.uniform(0, 1)
            if rng.random() < 0.5:
                v[i], x[i] = x[i], v[i]
        return v

    x = np.array([ub] * dim)
    temperature = 100
    best_x = x.copy()
    for _ in range(budget):
        y = mutate(x)
        z = crossover(y, best_x)
        fy = evaluate(y)
        fz = evaluate(z)
        if fy < fz:
            x = y
        elif np.random.uniform(0, 1) < np.exp((fy - fz) / temperature):
            x = z
        temperature *= 0.9999
        if evaluate(best_x) > evaluate(x):
            best_x = x.copy()
    return best_x
