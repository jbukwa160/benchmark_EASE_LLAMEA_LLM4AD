def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    x_best = 1e10 * np.ones(n)
    y_best = func(x_best)

    for i in range(budget):
        x = rng.uniform(lb, ub, size=n)
        if func(x) < y_best:
            x_best = x
            y_best = func(x)

        # GRS part
        alpha = 1.4
        sigma = 0.1
        beta = np.sqrt(2 * np.log(budget / (i + 1)))
        x_new = x_best + alpha * beta * rng.normal(size=n)
        if func(x_new) < y_best:
            x_best = x_new
            y_best = func(x_new)

        # ADE part
        mu = 0.8
        gamma = 2 / (i + 1)
        v = np.copy(x_best)
        for j in range(n):
            u = rng.uniform(lb, ub)
            if rng.rand() < gamma:
                x_new[j] = u
            else:
                x_new[j] = mu * v[j] + rng.normal(size=1)[0]
                if func(x_new[:j]) < y_best and np.all(np.abs(x_new[:j]) <= 5):
                    v = x_new[:j]

        # Clip candidates to [lb, ub]
        x_best = np.clip(x_best, lb, ub)
        x_new = np.clip(x_new, lb, ub)

    return x_best
