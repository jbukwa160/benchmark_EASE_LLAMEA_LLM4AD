def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_process(X, Y):
        cov = np.eye(len(Y)) + 0.1 * np.outer(np.ones(len(Y)), np.ones(len(Y)))
        return (cov ** -1) @ np.linalg.lstsq(cov, Y, rcond=None)[0]

    def surrogate(x):
        x = np.clip(x, lb, ub)
        mu = [0] * dim
        for i in range(5):
            if rng.random() < 0.1:
                mu[i] = func(np.array([x[j] for j in range(dim) if j != i])) - 1e-2
            else:
                mu[i] = np.mean([func(x[:i]) + norm.rvs(size=1), func(x[:i+1]), func(x[:i+2])])
        return sum(mu)

    def differential_evolution(pop, budget):
        pop = np.clip(pop, lb, ub)
        for _ in range(budget):
            parents = [min(pop[i] for i in rng.choice(len(pop), 5)) for _ in range(15)]
            children = []
            for p1, p2 in zip(parents[:7], parents[7:]):
                child = (p1 + p2) / 2
                child[:] += rng.normal(size=dim)
                children.append(child)
            pop = np.concatenate([parents, children])
        return min(pop)

    X = rng.uniform(lb, ub, size=(100, dim))
    Y = [func(x) for x in X]
    gp_params = gaussian_process(X, Y)
    best_x = differential_evolution(np.clip(differential_evolution(np.clip(gaussian_process(X, np.array(Y)), lb, ub), budget // 2), lb, ub), budget // 2)
    return best_x
