def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x), x

    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = float('inf')

    iterations = 0
    while iterations < budget:
        X = np.clip(best_x + rng.randn(dim)*1e-2, lb, ub)

        if iterations % (budget // 10) == 0:
            # Restart with a new Gaussian process
            gp_mean = np.zeros(dim)
            gp_var = 1e-6 * np.ones(dim)
            for _ in range(5):
                new_x = np.clip(gp_mean + rng.randn(dim)*gp_var, lb, ub)
                f_new, new_x = evaluate(new_x)

                gp_mean += (new_x - gp_mean) / (_+1)**2
                gp_var *= 0.9

        else:
            # Regular evolution strategy step
            f_X, X = evaluate(X)
            if f_X < best_f:
                best_f = f_X
                best_x = X

        iterations += 1

    return best_x
