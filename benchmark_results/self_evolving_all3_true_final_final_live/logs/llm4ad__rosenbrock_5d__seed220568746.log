def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    pop = np.random.uniform(lb, ub, (pop_size, dim))

    # Define genetic operators
    def mutate(x, sigma=0.1):
        return x + rng.normal(0, sigma, size=dim)

    def crossover(x, y):
        c = 0.5 * (x + y)
        return np.clip(c, lb, ub)

    for _ in range(budget):
        # Evaluate population
        fitness = [func(x) for x in pop]

        # Selection and replacement
        idx = np.argsort(fitness)[:pop_size//2]
        pop[:len(idx), :] = pop[idx, :]

        # Genetic differential search
        for i in range(pop_size // 2, pop_size):
            parent1_idx = random.randint(0, i)
            parent2_idx = random.randint(0, i)

            if fitness[parent1_idx] < fitness[parent2_idx]:
                p1, p2 = pop[parent1_idx], pop[parent2_idx]
            else:
                p1, p2 = pop[parent2_idx], pop[parent1_idx]

            child = crossover(p1, p2)
            child = mutate(child)

            pop[i, :] = np.clip(child, lb, ub)

    # Return best solution
    idx_best = np.argmin([func(x) for x in pop])
    return pop[idx_best, :]
