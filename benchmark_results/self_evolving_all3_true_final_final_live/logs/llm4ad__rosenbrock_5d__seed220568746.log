def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    def evaluate(X):
        fX = func(X)
        return fX

    best_X = np.full(dim, 1.0)
    best_fX = float('inf')
    avg_improved = 0
    step_size = 10.0

    for _ in range(budget):
        X = rng.normal(size=(dim,))
        X = clip(X + best_X)

        fX = evaluate(X)

        if fX < best_fX:
            best_X, best_fX = X, fX
            avg_improved = 1
        elif np.isclose(fX, best_fX):
            avg_improved += 1

        if avg_improved > budget // 5:
            step_size /= np.sqrt(dim)
            for i in range(dim):
                best_X[i] += rng.normal(0, step_size)
                best_X[i] = clip(best_X[i])
            avg_improved = 0

    return best_X
