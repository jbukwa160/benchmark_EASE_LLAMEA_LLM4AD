def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 10.0
    alpha = 0.99
    crossover_prob = 0.05
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        new_x = np.copy(x)
        idx1, idx2 = rng.choice(dim, size=2, replace=False)

        if rng.rand() < crossover_prob:
            # Simulated Annealing inspired crossover
            mu = 0.5 * (x[idx1] + x[idx2])
            sigma = 0.05 * abs(x[idx1] - x[idx2])
            new_x[idx1] = mu + sigma * rng.randn()
            new_x[idx2] = mu - sigma * rng.randn()

        new_x = np.clip(new_x, lb, ub)
        new_f = func(new_x)

        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f
            T *= alpha

        elif rng.rand() < np.exp((best_f - new_f) / T):
            x = new_x.copy()

    return best_x
