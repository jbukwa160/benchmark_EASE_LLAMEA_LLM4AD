def algorithm(func, dim, lb, ub, budget, rng):
    def gp_model(X, Y, kernel=None):
        if kernel is None:
            from GPy.models.GPRegression import GPRegression
            model = GPRegression(X, Y)
        else:
            model = GPRegression(X, Y, kernel=kernel)
        return model

    def optimize(model):
        # Sample a new point based on the EI acquisition function
        mu, var = model.predict(np.array([[0.5] * dim]))
        X_new = np.zeros((1, dim))
        for i in range(dim):
            mu_i = mu[0][i]
            std_i = np.sqrt(var[0][i])
            sigma = rng.uniform(0, 1)
            X_new[0][i] = mu_i + std_i * norm.ppf(sigma)
            # Clip to bounds
            X_new[0][i] = max(lb[i], min(X_new[0][i], ub[i]))
        return X_new

    def evaluate(model):
        X_new = optimize(model)
        Y_new = func(X_new)
        model.update_model(Y_new)
        return X_new, Y_new

    # Initialize the GP model
    X_init = np.random.uniform(lb, ub, (1, dim))
    Y_init = func(X_init)
    kernel = 'rbf'
    model = gp_model(X_init, Y_init)

    for i in range(budget):
        X_best, Y_best = evaluate(model)
        if Y_best < Y_init:
            X_init = X_best
            Y_init = Y_best

    return X_init
