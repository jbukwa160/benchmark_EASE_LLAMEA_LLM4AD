def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return func(x)

    pop_size = 50
    F = 0.5  # initial mutation factor
    CR = 0.9  # initial crossover probability
    sigma = 1

    population = np.random.uniform(lb, ub, (pop_size, dim))
    convergence_count = [0] * pop_size
    diversity = [0] * pop_size

    for _ in range(budget):
        fitness_values = Rosenbrock(population)

        for i in range(pop_size):
            best_idx = np.argmin(fitness_values)
            if i == best_idx:
                continue

            target = population[best_idx]
            donor = population[i] + F * (target - population[i]) + rng.normal(0, sigma, dim)
            crossover_idx = np.random.choice(dim, replace=False, size=dim)

            for j in range(dim):
                if np.random.rand() < CR or donor[j] > target[j]:
                    donor[j] = population[i][j]

            donor = np.clip(donor, lb, ub)
            new_fitness = Rosenbrock(donor)

            if new_fitness < fitness_values[i]:
                population[i] = donor
                convergence_count[i] += 1
                diversity[i] = np.std(population[:, j])

        if _ % (budget // 5) == 0:
            F *= 0.95
            CR *= 0.98

        if np.any(np.array(convergence_count) > budget * 0.8):
            break

    best_idx = np.argmin(Rosenbrock(population))
    return population[best_idx]
