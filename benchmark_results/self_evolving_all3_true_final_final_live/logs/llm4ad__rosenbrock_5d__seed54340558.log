def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = clip(rng.uniform(lb, ub, size=dim))
    best_x = x.copy()
    
    for _ in range(budget):
        x = clip(x + 0.1 * rng.normal(size=dim))
        fx = func(x)
        
        if fx < func(best_x):
            best_x = x
            
        x = (x + best_x) / 2
        fx = func(clip(x))
        
        if fx < func(best_x):
            best_x = x
            
    return best_x
