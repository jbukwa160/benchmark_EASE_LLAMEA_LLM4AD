def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.ceil(budget / dim))
    x = np.random.uniform(lb, ub, (pop_size, dim))
    best_x = None
    best_fval = float('inf')

    for _ in range(budget):
        F = 0.5
        Cr = 0.9

        mutated_pop = rng.normal(size=(pop_size, dim))

        for i in range(pop_size):
            mu = np.random.randint(0, pop_size, size=dim)
            u = x[mu]
            v = x[(mu + 1) % pop_size]

            z = u + F * (v - u)

            mutated_pop[i] += z

        trial_pop = mutated_pop.copy()
        for i in range(pop_size):
            for j in range(dim):
                if rng.rand() < Cr:
                    a, b = np.random.randint(0, dim), np.random.randint(0, dim)
                    trial_pop[i, j] = max(lb, min(ub, trial_pop[i, j] + rng.uniform(-1, 1) * (x[i, a] - x[i, b])))

        fval = func(trial_pop)

        for i in range(pop_size):
            if fval[i] < best_fval:
                best_x = trial_pop[i]
                best_fval = fval[i]

    return np.clip(best_x, lb, ub)
