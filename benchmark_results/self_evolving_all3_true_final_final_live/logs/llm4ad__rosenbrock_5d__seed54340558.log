def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 1000
    alpha = 0.99
    beta = 1e-3

    for _ in range(budget):
        f_x = func(x)

        # Simulated Annealing (SA) phase:
        for i in range(dim - 1):
            x_new = x.copy()
            delta = rng.uniform(-1, 1)
            x_new[i + 1] += delta
            x_new[i] -= delta * 0.01

            f_x_new = func(np.clip(x_new, lb, ub))
            if f_x_new < f_x:
                x = x_new
                f_x = f_x_new
        # End of SA phase

        # Gradient Descent (GD) phase:
        for i in range(dim - 1):
            grad_i = (func(np.clip(x.copy() + np.array([0, 2]))) -
                      func(np.clip(x.copy() + np.array([-2, 0])))) / 4
            x[i] -= beta * grad_i
            x[i + 1] += 200 * beta * (x[i] ** 2 - x[i + 1])
        # End of GD phase

        T *= alpha

    return np.clip(x, lb, ub)
