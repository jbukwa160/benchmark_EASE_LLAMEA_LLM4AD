def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    x = np.array(rng.uniform(lb, ub, (1, dim)))
    T = 1000
    alpha = 0.99

    for _ in range(budget):
        y = clip_candidate(x + rng.normal(size=x.shape))
        f_y = func(y)
        f_x = func(x)

        if np.random.rand() < np.exp((f_x - f_y) / T):
            x = y
        else:
            pass

        if _ % 100 == 0:
            T *= alpha

    return clip_candidate(x)
