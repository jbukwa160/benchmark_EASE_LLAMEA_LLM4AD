def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    x = rng.uniform(lb, ub, size=dim)
    T = 1000
    step_size = 1e-3
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Simulated Annealing (SA) phase
        new_x = clip(best_x + rng.normal(size=dim) * step_size)
        new_f = func(new_x)

        if new_f < best_f:
            best_f = new_f
            best_x = new_x

        # Differential Evolution (DE) phase
        if rng.uniform() > 0.9:  # adapt with probability 10%
            x1, x2, x3 = rng.choice(budget), rng.choice(budget), rng.choice(budget)
            new_x = clip(best_x + rng.normal(size=dim) * step_size +
                         (best_x[x1] - best_x[x2]) * rng.uniform(-0.5, 0.5))
        else:
            new_x = clip(best_x)

        new_f = func(new_x)

        if T > 1 and new_f < best_f:
            best_f = new_f
            best_x = new_x

        # Annealing schedule
        T *= 0.99
        step_size *= 0.9999

    return best_x
