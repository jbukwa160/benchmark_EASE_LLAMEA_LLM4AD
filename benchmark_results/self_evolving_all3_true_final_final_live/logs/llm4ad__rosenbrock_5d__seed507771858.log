def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    v = np.zeros(dim)

    for _ in range(budget):
        gradient = np.array([func(1, *x[:i]) - func(-1, *x[:i]) for i in range(dim)])
        v = 0.9 * v + 0.1 * rng.uniform(low=-1, high=1, size=dim) * gradient
        x = x + v

    return np.clip(x, lb, ub)
