def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    for _ in range(budget):
        delta = np.zeros((dim,))
        for i in range(dim):
            if rng.rand() < 0.1:
                delta[i] = rng.uniform(-ub, ub)
            else:
                delta[i] = rng.normal(0, 0.5)
        x_perturbed = best_x + delta
        x_perturbed = np.clip(x_perturbed, lb, ub)
        if func(x_perturbed) < func(best_x):
            best_x = x_perturbed
    return best_x
