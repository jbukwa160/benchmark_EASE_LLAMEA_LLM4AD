def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.ones(dim)
    for _ in range(budget):
        x_curr = x_best.copy()
        for i in range(dim):
            noise = rng.uniform(-1, 1)
            x_curr[i] += noise * (ub - lb) / 2
            if x_curr[i] < lb:
                x_curr[i] = lb
            elif x_curr[i] > ub:
                x_curr[i] = ub
        f_curr = func(x_curr)
        if f_curr < func(x_best):
            x_best = x_curr.copy()
    return x_best
