def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    best_f = func(x)

    step_size = 1.0 / (dim + 1)
    learning_rate = 0.5
    for _ in range(budget):
        while True:
            direction = rng.randn(dim) * step_size
            candidate = x + direction

            # Clip candidates to [lb, ub]
            candidate = np.clip(candidate, lb, ub)

            new_f = func(candidate)
            if new_f < best_f:
                best_x = candidate.copy()
                best_f = new_f

            if rng.rand() < learning_rate and _ > budget // 2:  # early stopping
                break

            step_size *= 0.9  # reduce step size by a factor of 0.9 each iteration

        x = best_x.copy()

    return best_x
