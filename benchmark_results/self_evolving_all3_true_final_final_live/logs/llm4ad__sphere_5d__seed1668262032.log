def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    grid_size = (ub - lb) / 10.0
    x_best = np.array([lb + i * grid_size for i in range(int((ub - lb) / grid_size))])[:, None]
    
    for _ in range(budget):
        grid_sizes = [grid_size * 0.9 ** i for i in range(5)]
        
        new_x_best = x_best.copy()
        for i, size in enumerate(grid_sizes):
            x = np.random.uniform(lb, lb + size, (int(size / grid_size), dim))[:, None]
            f_values = func(np.clip(x, a_min=lb, a_max=ub))
            
            idx = np.argsort(f_values)[:1]
            new_x_best[idx] = clip(x[idx])
        
        if func(new_x_best).sum() < func(x_best).sum():
            x_best = new_x_best.copy()
    
    return x_best
