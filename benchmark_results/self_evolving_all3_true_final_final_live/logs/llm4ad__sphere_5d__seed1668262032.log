def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    x_best = np.zeros(dim)
    f_best = float('inf')
    sigma = 1.0
    n_restarts = dim * 5

    for i in range(budget):
        if rng.random() < 0.2:
            n_restarts += 10

        c_m = rng.normal(size=(dim, dim))
        x_new = x_best + sigma * np.dot(c_m, rng.normal(size=dim))

        f_new = evaluate(x_new)
        if f_new < f_best:
            f_best = f_new
            x_best = x_new

        sigma *= 0.99 ** (1 / (i + 1)) * (f_new > f_best)

    return x_best
