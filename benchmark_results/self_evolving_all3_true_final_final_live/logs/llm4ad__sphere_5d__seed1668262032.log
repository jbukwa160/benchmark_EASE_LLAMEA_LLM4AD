def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(budget):
        N = int(np.sqrt(budget - i) + 1e-6)
        mu = np.zeros((N, dim))
        sigma = 0.5 * rng.uniform(0, 0.9, (N,))[:, None]
        
        for j in range(N):
            y = clip(x + rng.normal(size=(1, dim)))
            mu[j] = y
        cov = np.cov(mu.T)
        
        if np.any(np.diag(cov) < 0):
            sigma = 0.5 * rng.uniform(0, 0.9, (N,))
            
        for j in range(N):
            x_new = mu[j] + np.sqrt(sigma[j]) * rng.normal(size=(1, dim))
            f_new = func(clip(x_new))
            
            if f_new < best_f:
                best_x = x_new.copy()
                best_f = f_new
        x = best_x.copy()
    return best_x
