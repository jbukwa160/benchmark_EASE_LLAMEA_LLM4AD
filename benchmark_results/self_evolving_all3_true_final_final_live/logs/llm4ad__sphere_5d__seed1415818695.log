def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    t = 1.0
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        new_x = x + np.random.normal(size=dim) * (ub - lb) / 2
        new_x = np.clip(new_x, lb, ub)
        
        new_f = func(new_x)
        delta = new_f - best_f
        
        if delta < 0 or rng.uniform(0, 1) < np.exp(-delta / t):
            x = new_x.copy()
            best_x = new_x.copy()
            best_f = new_f
            t *= 0.99  # Decrease temperature by a factor of 0.99

    return best_x
