def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    # Random Search initialization
    candidates = rng.uniform(lb, ub, size=(budget, dim))
    
    for i in range(budget):
        # Evaluate each candidate
        y_i = func(candidates[i])
        
        # Update the best candidate if a better solution is found
        if y_i < f_best:
            x_best = candidates[i]
            f_best = y_i
        
        # Gaussian Process regression model update (simplified for brevity)
        sigma = 0.1 * np.ones(dim)
        mu = np.zeros(dim)
        S = np.eye(dim) + sigma[:, None] @ sigma[None, :]
        
        # Update the mean and variance of the GP
        mu += 0.5 / (S[0, 0]) * candidates[i]
        for j in range(1, i):
            mu += 0.25 / S[j, j] * (candidates[i] - candidates[j])
        
        # Select the next candidate using the updated GP model
        x_next = np.zeros(dim)
        for k in range(dim):
            sigma_k = 1 / S[k, k]
            x_next[k] = mu[k] + np.sqrt(sigma_k) * rng.normal(0, 1)
    
    # Clip candidates to [lb, ub]
    clipped_candidates = np.clip(candidates, lb, ub)
    
    return x_best
