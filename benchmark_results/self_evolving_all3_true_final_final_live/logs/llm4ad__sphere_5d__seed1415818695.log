def algorithm(func, dim, lb, ub, budget, rng):
    best_x = lb + (ub - lb) * rng.rand(dim)
    best_f = func(best_x)

    for _ in range(budget):
        x = lb + (ub - lb) * rng.rand(dim)
        f = func(x)

        if f < best_f:
            best_f = f
            best_x = x

    return best_x
