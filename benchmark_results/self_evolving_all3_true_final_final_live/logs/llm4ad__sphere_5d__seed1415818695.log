def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.maximum(np.minimum(candidate, ub), lb)

    x_best = rng.uniform(lb, ub, size=(1, dim))
    f_best = func(x_best)
    
    for _ in range(budget):
        x1 = rng.uniform(lb, ub, size=(1, dim))
        x2 = rng.uniform(lb, ub, size=(1, dim))
        x3 = rng.uniform(lb, ub, size=(1, dim))
        
        x_new = (x1 + x2 + x3) / 3.0
        
        f_new = func(clip(x_new, lb, ub))
        
        if f_new < f_best:
            x_best = clip(x_new, lb, ub)
            f_best = f_new
    
    return x_best
