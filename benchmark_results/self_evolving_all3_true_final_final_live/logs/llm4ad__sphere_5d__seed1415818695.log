def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    best_solution = np.zeros(dim)
    best_value = float('inf')
    
    for i in range(budget):
        step_size = (ub - lb) / (budget + 1)
        
        if rng.random() < 0.5:
            new_solution = clip_candidate(best_solution + rng.uniform(-step_size, step_size, size=dim))
        else:
            new_solution = clip_candidate(best_solution - rng.uniform(-step_size, step_size, size=dim))
        
        value = func(new_solution)
        
        if value < best_value:
            best_value = value
            best_solution = new_solution
    
    return best_solution
