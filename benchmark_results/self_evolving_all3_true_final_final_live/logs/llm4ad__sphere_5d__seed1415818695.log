def algorithm(func, dim, lb, ub, budget, rng):
    best_x = rng.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for i in range(budget):
        x = np.clip(rng.choice(ub - lb + 1e-9, size=dim) + lb, lb, ub)
        
        # Gaussian mutation
        x += rng.normal(size=dim) * 0.01
        
        f = func(x)
        
        if f < best_f:
            best_x = x
            best_f = f

    return best_x
