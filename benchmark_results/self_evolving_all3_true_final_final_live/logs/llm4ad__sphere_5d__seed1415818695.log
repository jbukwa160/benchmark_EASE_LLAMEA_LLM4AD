def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    best_candidate = np.random.uniform(lb, ub, size=dim)
    best_value = func(clip(best_candidate))

    for _ in range(budget - 1):
        new_candidate = clip(np.add(best_candidate, rng.normal(loc=0.0, scale=np.sqrt(1 / dim), size=dim)))
        new_value = func(new_candidate)

        if new_value < best_value:
            best_candidate = new_candidate
            best_value = new_value

    return best_candidate
