def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = np.eye(dim)
    lambda_ = 32
    mu = 1 / lambda_
    sigma = 0.5
    cmu = np.zeros(dim)
    ccmu = np.eye(dim) * (lambda_ - 1) / (lambda_ + 2)

    pop_size = int(0.25 * budget)
    x = clip(rng.uniform(lb, ub, size=(pop_size, dim)))
    y = np.zeros((budget,))

    for t in range(budget):
        for i in range(pop_size):
            z = clip(x[i] + sigma * (D @ cmu) + ccmu @ rng.normal(size=dim))
            if func(z).item() < func(x[i]).item():
                x[i] = z
        y[t] = np.min(func(x))

    return x[np.argmin(y)]
