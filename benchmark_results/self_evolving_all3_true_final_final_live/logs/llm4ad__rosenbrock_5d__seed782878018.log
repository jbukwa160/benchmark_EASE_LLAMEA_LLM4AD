def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(dim, lb, ub):
        return rng.uniform(lb, ub, size=dim)

    best_x = get_candidate(dim, lb, ub)
    best_f = func(best_x)
    current_f = best_f
    temperature = 1.0

    for _ in range(budget):
        new_x = get_candidate(dim, lb, ub)
        new_f = func(new_x)

        delta = new_f - current_f
        if delta < 0:
            current_f = new_f
            if new_f < best_f:
                best_f = new_f
                best_x = np.copy(new_x)
        else:
            temperature *= np.exp(-delta / (temperature + 1e-6))
            if rng.uniform(0, 1) < np.exp(-delta / temperature):
                current_f = new_f

    return best_x
