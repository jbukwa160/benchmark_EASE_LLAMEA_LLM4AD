def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.maximum(np.minimum(x, ub), lb)

    pop_size = 50
    max_iter = budget // pop_size + 1
    sigma_init = 0.5

    x0 = (ub - lb) * rng.rand(dim) + lb
    for _ in range(max_iter):
        sigma = sigma_init * np.exp(-_ / 10)
        x_best = np.copy(x0)

        for i in range(pop_size):
            z = clip(np.copy(x0) + sigma * rng.randn(dim), lb, ub)
            f_z = func(z)
            if f_z < func(x_best):
                x_best = z

        x0 = (1 - 0.5 / (max_iter - _)) * np.copy(x_best)

    return clip(x_best, lb, ub)
