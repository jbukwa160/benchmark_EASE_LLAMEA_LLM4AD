def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.minimum(np.maximum(x, lb), ub)

    def differential_evolution_step(pop_size, bounds, budget):
        pop = rng.uniform(lb, ub, (pop_size, dim))
        best = np.inf
        for _ in range(budget):
            new_pop = np.zeros((pop_size, dim))
            for i in range(pop_size):
                index1, index2 = rng.randint(0, pop_size, 2)
                if index1 != index2:
                    new_pop[i] = clip(pop[index1], lb, ub) + rng.uniform(-1, 1) * (pop[index2] - pop[index1])
            new_best = np.min(func(new_pop))
            if new_best < best:
                best = new_best
                pop = new_pop
        return pop, best

    def simulated_annealing_step(pop_size, bounds, budget):
        T = 1000.0
        pop = rng.uniform(lb, ub, (pop_size, dim))
        best = np.inf
        for _ in range(budget):
            new_T = max(1, T / (1 + _ / budget))
            new_pop = np.zeros((pop_size, dim))
            for i in range(pop_size):
                index = rng.randint(0, pop_size)
                new_pop[i] = clip(pop[index], lb, ub) + rng.uniform(-new_T, new_T)
            new_best = np.min(func(new_pop))
            if new_best < best:
                best = new_best
                pop = new_pop
        return pop, best

    def local_search_step(x0, bounds):
        x = clip(x0, lb, ub)
        budget = 1000
        for _ in range(budget):
            dx = rng.uniform(-1e-3, 1e-3, dim)
            new_x = x + dx
            new_x = clip(new_x, lb, ub)
            if func(new_x) < func(x):
                x = new_x
        return x

    pop_size = 100
    best_x = np.inf
    for _ in range(10):
        new_pop, new_best = differential_evolution_step(pop_size, (lb, ub), budget // 3)
        if new_best < best_x:
            best_x = new_best
            best_x_new = local_search_step(new_pop[np.argmin(func(new_pop))], (lb, ub))
        new_pop, new_best = simulated_annealing_step(pop_size, (lb, ub), budget // 3)
        if new_best < best_x:
            best_x = new_best
            best_x_new = local_search_step(new_pop[np.argmin(func(new_pop))], (lb, ub))
    return clip(best_x_new, lb, ub)
