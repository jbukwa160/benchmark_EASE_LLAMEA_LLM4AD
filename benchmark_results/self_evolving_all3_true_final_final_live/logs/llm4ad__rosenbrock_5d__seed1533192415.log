def algorithm(func, dim, lb, ub, budget, rng):
    def clip(c):
        return np.clip(c, lb, ub)

    n_vars = dim
    pop_size = int(1.2 * n_vars)
    x0 = rng.uniform(lb, ub, size=(pop_size, n_vars))
    fvals = np.zeros(pop_size)

    for _ in range(budget):
        for i in range(pop_size):
            x = clip(x0[i])
            fvals[i] = func(x)

        idx_best = np.argmin(fvals)
        best_x = x0[idx_best]
        x0 = rng.uniform(lb, ub, size=(pop_size, n_vars))

        # Differential Evolution (DE) mutation
        for i in range(pop_size):
            r1 = rng.randint(0, pop_size)
            r2 = rng.randint(0, pop_size)
            while r2 == r1 or r2 == idx_best:
                r2 = rng.randint(0, pop_size)

            v_i = 0.5 * (x0[r1] + x0[r2]) + 0.5 * np.sin(rng.uniform(-np.pi, np.pi))
            if rng.random() < 0.5:
                v_i *= -1

            x0[i] = clip(best_x + 0.8 * (v_i - best_x))

    return best_x
