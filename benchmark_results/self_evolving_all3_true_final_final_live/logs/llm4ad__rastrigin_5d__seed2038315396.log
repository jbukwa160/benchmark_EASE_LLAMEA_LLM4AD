def algorithm(func, dim, lb, ub, budget, rng):
    def bounds(x):
        return np.maximum(np.minimum(x, ub), lb)

    pop_size = 100
    x = rng.uniform(lb, ub, size=(pop_size, dim))

    for _ in range(budget):
        f_x = func(bounds(x))
        idx_best = np.argmin(f_x)
        best_x = bounds(x[idx_best])

        y = x.copy()
        mask = rng.choice(pop_size, size=dim, replace=False)

        for i in range(dim):
            r1, r2, r3 = rng.uniform(lb, ub), rng.uniform(lb, ub), rng.uniform(lb, ub)
            u = r1 * best_x + r2 * (y[mask[i]] - best_x) + r3 * bounds(rng.uniform(lb, ub, size=dim))
            y[mask[i], i] = u[i]

        f_y = func(bounds(y))
        idx_new_best = np.argmin(f_y)

        if f_y[idx_new_best] < f_x[idx_best]:
            x[idx_best] = y[idx_new_best]
        else:
            x[idx_best] = best_x

    return bounds(x[np.argmin(func(bounds(x)))])
