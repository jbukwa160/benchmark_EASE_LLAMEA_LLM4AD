def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    bounds = [(lb, ub) for _ in range(dim)]
    
    pop_size = 50
    best_sol = None
    
    for i in range(budget):
        if i == 0:
            init_pop = np.random.uniform(lb, ub, (pop_size, dim))
        else:
            new_pop = np.zeros((pop_size, dim))
            for j in range(pop_size):
                parent1, parent2, parent3 = rng.choice(init_pop, size=3, replace=False)
                child = clip(parent1 + 0.5 * (parent2 - parent3) + rng.uniform(-1, 1, dim))
                new_pop[j] = child
            init_pop = new_pop
        
        fitness_values = [func(x) for x in init_pop]
        
        best_idx = np.argmin(fitness_values)
        if i == 0 or (fitness_values[best_idx] < best_sol['value']):
            best_sol = {'x': clip(init_pop[best_idx]), 'value': fitness_values[best_idx]}
    
    return best_sol['x']
