def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def evaluate(x):
        return func(clip(x, lb, ub))

    init_sigma = 1.0
    step_size = 0.5

    best_x = rng.uniform(lb, ub, size=(dim,))
    best_f = evaluate(best_x)
    num_evals = 1

    while True:
        # Differential Evolution
        parents = np.array([best_x] * 4)
        for i in range(4):
            parent_idx = (i + 1) % 4
            child_idx = (parent_idx + rng.randint(0, 3)) % 4
            mutation_idx = rng.choice(4, size=(dim,), replace=True)
            parents[i] += step_size * (parents[parent_idx][mutation_idx] - parents[child_idx][mutation_idx])
        child_x = np.mean(parents, axis=0)

        # CMA-ES
        cov_matrix = init_sigma ** 2 * np.eye(dim)
        for _ in range(10):
            perturbation = rng.multivariate_normal(mean=np.zeros((dim,)), cov=cov_matrix)
            child_x += perturbation

        child_f = evaluate(child_x)

        if child_f < best_f:
            num_evals += 1
            best_x = child_x
            best_f = child_f

        if num_evals >= budget:
            break

    return np.array([best_f])
