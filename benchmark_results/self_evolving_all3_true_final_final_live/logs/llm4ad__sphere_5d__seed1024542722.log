def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.array([0.0] * dim)
    best_x = x.copy()
    best_f = func(clip(best_x))

    for _ in range(budget):
        n1 = x + 0.5 * rng.normal(size=dim)
        n2 = x - 0.5 * rng.normal(size=dim)

        f1 = func(clip(n1))
        f2 = func(clip(n2))

        if f1 < best_f:
            best_x = n1.copy()
            best_f = f1
        elif f2 < best_f:
            best_x = n2.copy()
            best_f = f2

    return clip(best_x)
