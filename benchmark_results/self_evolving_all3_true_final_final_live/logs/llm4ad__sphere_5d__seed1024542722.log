def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    population_size = int(budget ** 0.5)
    population = np.random.uniform(lb, ub, (population_size, dim))
    
    for _ in range(int(budget)):
        fitnesses = [func(clip(x)) for x in population]
        best_idx = np.argmin(fitnesses)
        best_candidate = clip(population[best_idx])
        
        if func(best_candidate) == 0:
            return best_candidate
        
        noise = rng.normal(size=(population_size, dim))
        candidates = best_candidate + noise * (ub - lb) / 2
        population[:] = np.clip(candidates, lb, ub)
        
    # Return the best candidate found after the budget is exhausted
    fitnesses = [func(clip(x)) for x in population]
    return clip(population[np.argmin(fitnesses)])
