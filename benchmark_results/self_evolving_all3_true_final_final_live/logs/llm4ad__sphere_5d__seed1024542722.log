def algorithm(func, dim, lb, ub, budget, rng):
    x_init = 5 * (ub - lb) * rng.rand(dim) + lb
    y_init = func(x_init)
    
    # Main loop
    for t in range(1, budget+1):
        # Gaussian Process optimization
        gp_mean, gp_std = gaussian_process(x_init, y_init, t, dim, ub-ub, rng=rng)
        
        # Explore new points using Random Search
        x_new = 5 * (ub - lb) * rng.randn(dim) + lb
        
        # Predictive mean and variance at the new point
        pred_mean, pred_var = gaussian_process(x_new, y_init, t, dim, ub-ub, rng=rng)
        
        # Choose between exploration and exploitation based on a probability of 0.5
        if rng.rand() < 0.5:
            x_next = x_new
            y_next = func(x_next)
        else:
            x_next = gp_mean + (ub - lb) * rng.randn(dim)
            y_next = func(x_next)
        
        # Update the current point and its function value
        x_init = x_next
        y_init = y_next
        
        # Clip to bounds
        x_init = np.clip(x_init, lb, ub)
    
    return x_init
