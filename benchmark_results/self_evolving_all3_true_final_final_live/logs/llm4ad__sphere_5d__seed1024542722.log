def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x0 = np.zeros(dim)
    sigma = 2
    c1 = 1
    c_mu = (dim + 1) / dim
    lambda_ = 100

    for _ in range(budget):
        x = clip(rng.normal(loc=x0, scale=sigma, size=(lambda_, dim)))
        fx = func(x)

        y = np.zeros((lambda_, dim))
        fyt = np.zeros(lambda_)
        for i in range(lambda_):
            yi = clip(x[i] + rng.normal(loc=0, scale=c1*sigma, size=dim))
            yfyt_i = func(yi)
            if yfyt_i < fx[i]:
                y[i] = yi
                fyt[i] = yfyt_i

        z = np.zeros((lambda_, dim))
        for i in range(lambda_):
            zi = x[i] + rng.normal(loc=0, scale=sigma, size=dim)
            z[i] = clip(zi)

        mean = (x * fx[:, None] + z * fyt[:, None]).sum(axis=0) / budget
        sigma *= np.exp(-c1/2 * ((fx - fyt).mean()**2 / lambda_))
        x0 = mean

    return x0
