def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    n = 0
    t = 1
    x_best = np.array([lb] * dim)
    f_best = float('inf')
    while n < budget:
        new_x = x_best + (ub - lb) * rng.uniform(-1, 1, size=dim)
        new_x = clip(new_x)
        new_f = func(new_x)
        
        if new_f < f_best:
            f_best = new_f
            x_best = new_x
        
        if n > 0 and np.random.rand() < np.exp(-(f_best - new_f) / t):
            x_best = new_x
            f_best = new_f
        
        t *= 1 - (n + 1) / budget
        n += 1
    
    return x_best
