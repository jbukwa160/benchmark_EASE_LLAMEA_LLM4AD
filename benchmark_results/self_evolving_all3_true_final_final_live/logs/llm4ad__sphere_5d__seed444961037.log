def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    max_iter = int(budget / (dim * 1e-4))
    F = 0.5
    CR = 0.9
    
    x_best = rng.uniform(lb, ub, size=(pop_size, dim))
    f_best = np.array([func(x) for x in x_best])
    
    for iter in range(max_iter):
        for i in range(pop_size):
            u = rng.choice(range(pop_size), p=np.exp(-f_best))
            v = rng.choice(range(pop_size), p=np.exp(-f_best))
            
            if rng.rand() < CR or func(x_best[u]) > func(x_best[v]):
                x_new = np.clip(x_best[i] + F * (x_best[u] - 2*x_best[v] + rng.uniform(lb, ub)), lb, ub)
            else:
                x_new = x_best[i]
            
            f_new = func(x_new)
            
            if f_new < f_best[i]:
                x_best[i] = x_new
                f_best[i] = f_new
                
    return np.min(x_best, axis=0)
