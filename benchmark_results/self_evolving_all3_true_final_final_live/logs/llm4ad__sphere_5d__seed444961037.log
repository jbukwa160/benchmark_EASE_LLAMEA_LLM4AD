def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def mutation_stepsize_adaptation(sigma, mu):
        sigma_new = 1.01 * (sigma + 0.5 * (np.random.rand(dim) - 0.5) * sigma)
        for i in range(dim):
            if np.random.rand() < 0.5:
                mu[i] += np.random.randn() * sigma
        return sigma_new, mu

    def cma_es(x, sigma, budget, rng):
        x_best = x
        f_best = func(clip(x))
        
        for _ in range(budget):
            z = np.random.randn(dim)
            offspring = clip(x + sigma * z)
            f_offspring = func(offspring)
            
            if f_offspring < f_best:
                x_best = offspring
                f_best = f_offspring
                
            sigma, mu = mutation_stepsize_adaptation(sigma, rng.uniform(size=dim))
        
        return x_best

    x_init = np.zeros(dim) + 2 * (rng.rand(dim) - 0.5) * (ub - lb)
    sigma_init = ub - lb
    x_best = cma_es(x_init, sigma_init, budget // 10, rng)

    for _ in range(budget // 10):
        budget_remaining = budget // 10
        x_best = cma_es(x_best, sigma_init / np.sqrt(_ + 1), budget_remaining, rng)
    
    return clip(x_best)
