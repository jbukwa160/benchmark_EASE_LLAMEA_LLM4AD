def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = 50
    max_iter = budget // (dim * 2)
    c1 = 0.5
    c2 = 0.3

    pos = np.random.uniform(lb, ub, size=(pop_size, dim))
    vel = np.zeros((pop_size, dim))

    for _ in range(max_iter):
        fitness = func(clip(pos))
        g_best_pos = pos[np.argmin(fitness)]
        g_best_fitness = np.min(fitness)

        for i in range(pop_size):
            r1 = rng.uniform(0, 1)
            r2 = rng.uniform(0, 1)
            vel[i] = c1 * r1 * (g_best_pos - pos[i]) + c2 * r2 * (pos[i] - clip(np.random.uniform(lb, ub, size=dim)))
            pos[i] += vel[i]

        if _ % (max_iter // 10) == 0:
            pos[np.argmin(fitness)] = np.random.uniform(lb, ub, size=dim)

    return g_best_pos
