def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(clip(x))

    x = np.random.uniform(-5.0, 5.0, (1, dim))
    c = np.eye(dim)
    mu = np.zeros((1, dim))
    sigma = 1.0
    n_evals = 0

    while n_evals < budget:
        y = evaluate(x)

        for i in range(dim):
            c[i, i] = (dim - 2) * c[i, i] / dim + np.sqrt(1 + ((dim - 2) ** 2) * c[i, i] / (dim * dim))
            mu[0, i] += (y - evaluate(mu)) * c[i, i]

        sigma *= np.exp(np.sum((mu - x) ** 2) / (2 * dim) + 1)
        x = mu + np.random.normal(0, sigma, (1, dim))

        n_evals += 1

    return clip(x[0])
