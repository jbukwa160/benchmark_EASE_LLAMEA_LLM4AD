def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = evaluate(x_best)

    for i in range(budget):
        sigma = 1.0 / np.sqrt(i + 1)
        z = sigma * rng.randn(dim)
        x_cand = x_best + z
        f_cand = evaluate(x_cand)
        
        if f_cand < f_best:
            x_best = x_cand
            f_best = f_cand

    return x_best
