def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def eval(x):
        x = clip(x)
        return func(x)

    best_x = rng.uniform(lb, ub, size=dim)
    best_f = eval(best_x)
    step_size = 1.0
    budget_used = 0

    while budget_used < budget:
        for _ in range(100): # number of iterations per batch
            candidate = np.copy(best_x) + rng.uniform(-step_size, step_size, size=dim)
            candidate_f = eval(candidate)

            if candidate_f < best_f:
                best_x = candidate
                best_f = candidate_f

        if best_f < 1e-3: # early stopping when solution is good enough
            break

        if rng.uniform(0, 1) > 0.5: # adaptive step size update rule
            step_size *= 0.9
        else:
            step_size /= 0.9

        budget_used += 100 # increment budget usage for each batch

    return best_x
