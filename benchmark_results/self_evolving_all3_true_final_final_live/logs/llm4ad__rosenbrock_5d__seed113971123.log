def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    T = 1000.0
    alpha = 0.99
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = f(x)
    
    for i in range(budget):
        delta_x = (ub - lb) * rng.randn(dim) + lb
        new_x = x + delta_x
        
        if np.all(new_x >= lb) and np.all(new_x <= ub):
            new_f = f(new_x)
            
            if new_f < best_f:
                best_x = new_x.copy()
                best_f = new_f
                
            if new_f > best_f or rng.rand() < np.exp((best_f - new_f) / T):
                x = new_x.copy()
                
        T *= alpha
    
    return best_x
