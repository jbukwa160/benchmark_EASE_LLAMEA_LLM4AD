def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = 10 * dim
    x = (ub - lb) * rng.rand(pop_size, dim) + lb
    p_best_x = x.copy()

    for _ in range(budget):
        y = x.copy()
        for i in range(dim):
            z = np.random.choice(x.shape[0], pop_size, replace=False)
            delta = (x[z] - x) / np.abs(x[z])
            y[z, i] += 0.1 * rng.randn(pop_size)
            y[z, i] += 0.9 * delta[:, i]
        y = clip(y)

        f_y = func(y)
        f_x = func(x)

        if f_y < f_x:
            x = y
            p_best_x = np.copy(y)
        else:
            for i in range(pop_size):
                lambda_ = rng.rand()
                z = i + (np.random.choice(pop_size, 1) * pop_size) % pop_size
                delta = (p_best_x[z] - p_best_x[i]) / np.abs(p_best_x[z])
                x[i] += lambda_ * delta

    return clip(np.array([func(p_best_x[0])], dtype=np.float32))
