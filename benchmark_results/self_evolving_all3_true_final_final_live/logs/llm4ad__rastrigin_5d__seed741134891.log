def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    
    # Initial solution
    f_x = func(x)
    
    # Temperature schedule
    T_max = 100.0
    T_min = 1e-5
    alpha = 0.99
    
    for _ in range(budget):
        # Perturbation step
        x_perturbed = x + (ub - lb) * rng.randn(dim)
        
        # Clip to bounds
        x_perturbed = np.clip(x_pertured, lb, ub)
        
        # Fitness evaluation
        f_x_perturbed = func(x_perturbed)
        
        # Acceptance step
        delta = f_x_perturbed - f_x
        
        if delta < 0 or rng.rand() < np.exp(-delta / T_max):
            x = x_perturbed
            f_x = f_x_perturbed
        
        # Temperature update
        T_max *= alpha
    
    return x
