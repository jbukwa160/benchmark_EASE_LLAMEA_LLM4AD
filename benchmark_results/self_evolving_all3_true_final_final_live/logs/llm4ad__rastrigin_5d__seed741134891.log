def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.maximum(np.minimum(x, ub), lb)

    x_best = np.zeros(dim)
    y_best = func(x_best)
    temp = 1.0
    alpha = 0.01
    sigma = 3.0

    for _ in range(budget):
        v = bound(rng.uniform(-sigma, sigma, size=dim) + rng.uniform(0, 1, size=dim))
        y = func(v)
        if y < y_best:
            x_best = v.copy()
            y_best = y
        elif np.random.rand() < np.exp((y_best - y) / temp):
            x_best = v.copy()
            y_best = y
        temp *= 1 - alpha

    return bound(x_best)
