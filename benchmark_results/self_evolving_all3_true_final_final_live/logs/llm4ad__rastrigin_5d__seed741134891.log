def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    D = 1e-7 * np.eye(n)
    mean = np.zeros(n)
    sigma = 0.5
    lambda_ = int(4 + (dim * dim) ** 0.5)

    for _ in range(budget):
        x = mean + rng.randn(lambda_, n) * sigma
        x = np.clip(x, lb, ub)

        fitness = func(x)
        if fitness < func(mean):
            mean = x[np.argmin(fitness)]
            D = 0.1 * (D - np.outer((x - mean), (x - mean)) / lambda_ + D)

    return mean
