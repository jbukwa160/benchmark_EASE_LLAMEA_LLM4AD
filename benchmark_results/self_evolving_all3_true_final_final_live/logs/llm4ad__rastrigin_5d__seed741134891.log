def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(dim, lb, ub):
        return [lb + (ub - lb) * rng.rand(dim) for _ in range(budget)]

    def calculate_fitness(x, func):
        return func(x)

    def differential_evolution(population, func, dim, lb, ub, budget):
        parents = population[:budget//2]
        offspring = []
        while len(offspring) < budget:
            parent1, parent2 = rng.choice(parents, 2, replace=False)
            mutation_index = rng.randint(0, dim)
            child = np.copy(parent1)
            child[mutation_index] += 0.5 * (parent2[mutation_index] - parent1[mutation_index]) + \
                                    0.5 * rng.uniform(-1, 1) * (ub - lb)
            child = np.clip(child, lb, ub)
            offspring.append(child)
        return parents + offspring

    def simulated_annealing(population, func, dim, lb, ub, budget):
        temperature = 10
        for _ in range(budget):
            i = rng.randint(0, len(population))
            j = rng.randint(0, len(population))
            new_individual = np.copy(population[i])
            new_individual += 0.5 * (population[j] - population[i]) + \
                              0.5 * rng.uniform(-1, 1) * (ub - lb)
            new_individual = np.clip(new_individual, lb, ub)
            if calculate_fitness(new_individual, func) < calculate_fitness(population[i], func):
                population[i] = new_individual
            else:
                delta = calculate_fitness(new_individual, func) - calculate_fitness(population[i], func)
                temperature *= 0.99
                if rng.rand() < np.exp(-delta / temperature):
                    population[i] = new_individual
        return population

    def hybrid_algorithm(func, dim, lb, ub, budget, rng):
        population = generate_initial_population(dim, lb, ub)
        for _ in range(budget//2):
            population = differential_evolution(population, func, dim, lb, ub, budget)
            population = simulated_annealing(population, func, dim, lb, ub, budget)
        return np.argmin([calculate_fitness(x, func) for x in population], axis=0)

    best_individual = hybrid_algorithm(func, dim, lb, ub, budget, rng)
    return best_individual
