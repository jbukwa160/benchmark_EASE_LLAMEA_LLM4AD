def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    for _ in range(budget):
        x_cand = np.clip(rng.uniform(lb, ub, size=dim), a_min=lb, a_max=ub)
        
        f_cand = func(x_cand)
        
        if f_cand < f_best:
            f_best = f_cand
            x_best = x_cand
            
        for _ in range(dim):
            x_temp = np.clip(x_best + rng.uniform(-1, 1, size=dim), a_min=lb, a_max=ub)
            
            f_temp = func(x_temp)
            
            if f_temp < f_best:
                f_best = f_temp
                x_best = x_temp
                
    return x_best
