def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def mutate(population):
        for i in range(len(population)):
            r1, r2, r3 = rng.choice(len(population), 3, replace=False)
            mutation = population[r1] + 0.5 * (population[r2] - population[r3])
            return clip(mutation)

    def crossover(parent, mutant):
        for i in range(dim):
            if rng.random() < 0.5:
                child[i] = mutant[i]
            else:
                child[i] = parent[i]
        return child

    dim = int(np.sqrt(budget)) + 1
    population = np.random.uniform(lb, ub, (dim, dim))
    personal_best = np.inf
    global_best = np.inf

    for _ in range(budget):
        new_population = []
        for i in range(dim):
            mutant = mutate(population)
            child = np.zeros(dim)
            crossover(population[i], mutant, child)
            new_population.append(child)

        for candidate in new_population:
            func_value = func(candidate)
            if func_value < global_best:
                global_best = func_value
                best_candidate = candidate

            if func_value < personal_best:
                personal_best = func_value
                personal_best_candidate = candidate

        population = np.array(new_population)

    return best_candidate
