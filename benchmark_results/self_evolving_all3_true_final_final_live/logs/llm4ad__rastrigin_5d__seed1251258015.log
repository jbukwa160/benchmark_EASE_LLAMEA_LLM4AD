def algorithm(func, dim, lb, ub, budget, rng):
    x = 0.1 * (ub - lb) + lb
    sigma = (ub - lb) / 5.0
    best_x = x
    best_y = func(x)

    for _ in range(budget):
        y = np.zeros(dim)
        for i in range(dim):
            y[i] = rng.uniform(-1, 1)
        z = best_x + sigma * y

        # Clip to bounds
        z = np.clip(z, lb, ub)

        y_new = func(z)

        if y_new < best_y:
            best_y = y_new
            best_x = z

        x = (0.9 * x + 0.1 * z)

    return best_x
