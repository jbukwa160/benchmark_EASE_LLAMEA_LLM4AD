def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    best = None
    best_val = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        val = func(x)
        if val < best_val:
            best_val = val
            best = clip(x)
            
        step_size = (ub - lb) / 2.0**np.floor(np.log2(_ + 1))
        perturb = rng.normal(0, step_size, size=dim)
        
        x_new = clip(x + perturb)
        
        val_new = func(x_new)
        if val_new < best_val:
            best_val = val_new
            best = x_new
            
    return best
