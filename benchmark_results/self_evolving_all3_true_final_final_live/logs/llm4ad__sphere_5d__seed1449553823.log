def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    for i in range(budget):
        y = x + 0.1 * rng.normal(size=dim)
        y = np.clip(y, lb, ub)
        if func(y) < func(best_x):
            best_x = y
        else:
            gradient = 2 * (y - x)
            x += 0.01 * gradient
    return best_x
