def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = clip(rng.uniform(lb, ub, size=dim))
    mu, sigma = 1e-3 * (ub - lb), 0.2 * (ub - lb)
    
    for _ in range(budget):
        offspring = np.random.multivariate_normal(x, sigma ** 2 * np.eye(dim) + mu ** 2 * np.outer(x, x))
        
        offspring = clip(offspring)
        f_offspring = func(offspring)
        
        if f_offspring < func(x):
            x, f_x = offspring, f_offspring
    
    return x
