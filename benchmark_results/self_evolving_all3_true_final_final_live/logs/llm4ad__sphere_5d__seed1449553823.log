def algorithm(func, dim, lb, ub, budget, rng):
    init = 10 * np.random.rand(dim) + 5
    x_best = clip(init, lb, ub)
    f_best = func(x_best)

    for _ in range(budget - 1):
        gp = GaussianProcessRegressor(kernel=np.sqrt(1.0 * np.exp(-1)),
                                      alpha=1e-6,
                                      random_state=rng)
        gp.fit(np.expand_dims(x_best, axis=0), f_best)

        mu, sigma = gp.predict(np.random.rand(dim))
        xi = np.argmax(mu - sigma + 1e-8) if dim == 1 else np.argmax(mu - sigma + 1e-8 * np.sqrt(sigma**2))

        x_new = clip(np.array([xi] * dim), lb, ub)
        f_new = func(x_new)

        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
