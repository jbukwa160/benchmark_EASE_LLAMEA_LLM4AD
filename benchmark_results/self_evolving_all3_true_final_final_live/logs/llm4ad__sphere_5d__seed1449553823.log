def algorithm(func, dim, lb, ub, budget, rng):
    x0 = 5 * rng.rand(dim)
    sigma = 1.0
    lambda_ = 10 + int(np.sqrt(budget / 2))
    mu = lambda_ // 2
    weights = np.array([mu] + [lambda_ - mu] * (lambda_ - 1))

    for _ in range(budget):
        x = x0 + sigma * rng.randn(dim, lambda_)
        x = np.clip(x, lb, ub)

        f_x = func(x)
        f_x_best = func(x0)

        if f_x < f_x_best:
            x0 = x
            f_x_best = f_x

    return x0
