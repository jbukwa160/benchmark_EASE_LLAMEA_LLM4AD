def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = np.copy(x)
    best_f = func(x)

    for _ in range(budget):
        i = np.argmax(np.abs(x))
        delta = rng.uniform(-1, 1) * (x[i] - lb)
        x[i] += delta
        x = np.clip(x, lb, ub)
        f = func(x)
        
        if f < best_f:
            best_x = np.copy(x)
            best_f = f

    return best_x
