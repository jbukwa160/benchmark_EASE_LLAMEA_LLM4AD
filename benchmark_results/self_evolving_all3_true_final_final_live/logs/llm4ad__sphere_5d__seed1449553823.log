def algorithm(func, dim, lb, ub, budget, rng):
    N = 1000
    mu = (ub - lb) * rng.rand(dim)
    cov = np.eye(dim) * (ub - lb)**2 / 10.
    while True:
        x = np.random.multivariate_normal(mu, cov)
        for i in range(dim):
            x[i] = max(lb, min(ub, x[i]))
        f_x = func(x)
        if f_x < func(mu):
            mu = x
            cov *= 0.9
        elif np.linalg.det(cov) > (ub - lb)**2 / N:
            cov += np.eye(dim) * (ub - lb)**2 / N
        budget -= 1
        if budget <= 0 or f_x < func(mu):
            break
    return mu
