def algorithm(func, dim, lb, ub, budget, rng):
    min_val = float('inf')
    best_candidate = None
    candidates = [lb] * dim
    
    for _ in range(budget):
        candidate = tuple(np.clip(candidates + np.random.uniform(-0.1, 0.1, dim), lb, ub))
        value = func(candidate)
        
        if value < min_val:
            min_val = value
            best_candidate = candidate
            
        # Adaptive sampling: focus on most promising region
        if candidates[0] > lb and np.random.rand() < 0.5:
            candidates[0] -= (candidates[0] - lb) / budget
        
        for i in range(1, dim):
            if candidates[i] > lb and np.random.rand() < 0.5:
                candidates[i] -= (candidates[i] - lb) / budget
            elif candidates[i] < ub and np.random.rand() < 0.5:
                candidates[i] += (ub - candidates[i]) / budget
    
    return best_candidate
