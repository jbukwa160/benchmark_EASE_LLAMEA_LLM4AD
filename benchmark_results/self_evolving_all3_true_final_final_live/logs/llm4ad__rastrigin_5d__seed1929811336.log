def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n = 1000
    t = int(np.ceil(budget / n))

    x_best = -np.inf * np.ones(D)
    f_best = np.inf

    for _ in range(t):
        cands = []
        for _ in range(n):
            cand = rng.uniform(lb, ub, size=D)
            cands.append(cand)

        for i in range(len(cands)):
            x_cand = cands[i]
            f_cand = func(x_cand)
            if f_cand < f_best:
                f_best = f_cand
                x_best = x_cand

    return np.clip(x_best, lb, ub)
