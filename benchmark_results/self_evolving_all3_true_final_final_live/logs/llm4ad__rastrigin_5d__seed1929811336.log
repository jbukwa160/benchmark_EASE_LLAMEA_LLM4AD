def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    n = int(budget ** 0.5)
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(clip(x_best))
    
    for i in range(n):
        x1 = clip(rng.normal(loc=x_best, scale=np.sqrt(ub - lb), size=dim))
        x2 = clip(rng.normal(loc=x_best, scale=np.sqrt(ub - lb), size=dim))
        x3 = clip(rng.normal(loc=x_best, scale=np.sqrt(ub - lb), size=dim))

        F = rng.uniform(low=0.5, high=1.0)
        CR = rng.uniform(low=0.1, high=1.0)

        v = (x1 + F * (x2 - x3))
        u = np.zeros(dim)
        
        for j in range(dim):
            if rng.rand() < CR or rng.rand() < 0.1:
                u[j] = v[j]
            else:
                u[j] = x_best[j]

        f_u = func(clip(u))

        if f_u < f_best:
            x_best = u
            f_best = f_u

    return clip(x_best)
