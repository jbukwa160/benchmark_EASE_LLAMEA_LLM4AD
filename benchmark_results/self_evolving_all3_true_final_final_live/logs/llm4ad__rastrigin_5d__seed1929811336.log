def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    mean = np.zeros(n)
    cov = np.eye(n) * 10.0
    D = 1.0 + 2/(n+1)

    for _ in range(budget):
        if rng.rand() < 0.1:
            cov *= 0.9

        x_new = mean + (np.sqrt(D)*rng.randn(n)).reshape(-1)
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        f_mean = func(mean)

        if f_new < f_mean:
            mean = x_new
            cov += 0.01 * (x_new - mean).outer(x_new - mean)

    return mean
