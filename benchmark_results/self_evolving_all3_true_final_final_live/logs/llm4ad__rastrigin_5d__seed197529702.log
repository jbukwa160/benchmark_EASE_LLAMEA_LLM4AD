def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 0.5 * (ub - lb)
    lambda_ = 20
    mu = int(lambda_ / 2)
    x_mean = np.zeros(dim)
    cov = np.eye(dim) * (sigma ** 2)
    f_min = np.inf

    for _ in range(budget):
        z = rng.multivariate_normal(x_mean, cov)
        x = lb + (ub - lb) * np.clip(z, -1, 1)

        f = func(x)
        if f < f_min:
            f_min = f
            best_x = x

        if _ % mu == 0 and _ != 0:
            c = rng.uniform(0, 2, size=dim)
            cov += (c - 1) * np.outer(z, z) / lambda_

    return best_x
