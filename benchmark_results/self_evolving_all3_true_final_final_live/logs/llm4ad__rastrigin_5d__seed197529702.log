def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    D = 0.7
    CR = 0.9
    
    x = rng.uniform(lb, ub, (pop_size, dim))
    best_x = x[np.argmin([func(x_i) for x_i in x])]

    for _ in range(budget):
        for i in range(pop_size):
            v = x[(i-1)%pop_size] + D * (x[(i+1)%pop_size] - x[i])
            v = np.clip(v, lb, ub)
            
            if rng.rand() < CR:
                u = np.copy(x[i])
                for j in range(dim):
                    if rng.rand() < 0.5:
                        u[j] = v[j]
                v = u
            
            f_v = func(v)
            f_best_x = func(best_x)
            
            if f_v < f_best_x:
                best_x = np.copy(v)

        x[(pop_size-1)%pop_size] = rng.uniform(lb, ub, dim)
    
    return best_x
