def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_process(x_train, y_train):
        from scipy.stats import multivariate_normal
        mean = np.mean(y_train)
        cov = 0.1 * np.eye(dim) + (x_train[:, None] - x_train[None, :]).dot((x_train[:, None] - x_train[None, :]).T) / len(x_train)
        return mean, multivariate_normal(mean=mean, cov=cov)

    def expected_improvement(mean, std, best_y, x):
        ei = (np.max([0, mean - best_y]) * np.exp(-((x - mean) ** 2) / (2 * std ** 2)))
        return ei

    def probability_of_improvement(mean, std, best_y, x):
        poi = (1 + erf((mean - best_y) / (std * np.sqrt(2)))) * 0.5
        return poi

    from scipy.stats import norm, erf

    x_best = np.zeros(dim)
    y_best = float('inf')

    for _ in range(budget):
        x_train, y_train = [], []
        if len(x_train) > 1:
            mean_gp, gp = gaussian_process(np.array(x_train), np.array(y_train))
            x_next = np.argmax([expected_improvement(mean_gp, gp.pdf(x), y_best, x) + probability_of_improvement(mean_gp, gp.pdf(x), y_best, x) for x in rng.uniform(lb, ub, (10000, dim))])
        else:
            x_next = rng.uniform(lb, ub, dim)

        x_train.append(x_next)
        y_train.append(func(x_next))

        if np.min(y_train) < y_best:
            y_best = np.min(y_train)
            x_best = x_train[y_train.index(y_best)]

    return x_best
