def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def de(func, dim, lb, ub, pop_size=50, max_iter=1000, mutation_rate=0.8, crossover_rate=0.5, rng=rng):
        population = rng.uniform(lb, ub, size=(pop_size, dim))
        for _ in range(max_iter):
            mutated_population = population + mutation_rate * (population - population[rng.randint(0, pop_size, size=(pop_size, 1))])
            crossed_population = np.where(rng.random((pop_size, dim)) < crossover_rate, mutated_population, population)
            fitness = func(crossed_population)
            best_idx = np.argmin(fitness)
            if fitness[best_idx] < func(population):
                population[best_idx] = crossed_population[best_idx]
        return population[np.argmin(func(population))]

    def local_search(func, solution, lb, ub, rng=rng):
        step_size = 0.1
        best_solution = solution
        while True:
            for i in range(dim):
                new_solution = np.copy(solution)
                new_solution[i] += rng.uniform(-step_size, step_size)
                new_solution = clip(new_solution)
                if func(new_solution) < func(best_solution):
                    best_solution = new_solution
            if (solution - best_solution).max() < 1e-6:
                break
            solution = best_solution
        return solution

    best_solution = de(func, dim, lb, ub, rng=rng)
    for _ in range(budget - 1):
        best_solution = local_search(func, best_solution, lb, ub, rng=rng)
    return clip(best_solution)
