def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.sqrt(budget))
    bounds = [(lb, ub) for _ in range(dim)]
    
    def generate_initial_population():
        return rng.uniform(lb, ub, (pop_size, dim))

    def differential_evolution(population, x_best):
        offspring = np.zeros((pop_size, dim))
        for i in range(pop_size):
            rand_idx1, rand_idx2, rand_idx3 = rng.choice(range(pop_size), 3, replace=False)
            perturbation = 0.5 * rng.normal(0, 1, (dim,))
            v = population[rand_idx1] + perturbation
            u = np.copy(x_best)
            if rng.random() < 0.1: # Gaussian restart
                u = rng.uniform(lb, ub, dim)
            offspring[i] = np.clip((u + v) / 2, *bounds)
        return np.copy(offspring)

    def evaluate_population(population):
        fitness = func(np.array([p for p in population]))
        return np.argsort(fitness)[:1]

    population = generate_initial_population()
    x_best = evaluate_population(population)[0]
    
    for _ in range(budget - 1):
        offspring = differential_evolution(population, x_best)
        f_offspring = func(offspring)
        idx_sorted = np.argsort(f_offspring)
        population[idx_sorted[:pop_size]] = offspring[idx_sorted[:pop_size]]
        x_best = evaluate_population(population)[0]
    
    return np.copy(x_best)
