def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def objective(params):
        return func(params) + 1e6 * (np.abs(np.max(ub - params)) + np.abs(np.min(lb - params)))

    x0 = rng.uniform(-5.0, 5.0, dim)
    best_x = clip(x0)
    best_f = objective(best_x)

    sa_temp = 100
    sa_step = 2 * (ub - lb) / budget

    for _ in range(budget):
        new_params = best_x + rng.uniform(-1, 1, dim) * sa_step
        new_params = clip(new_params)
        new_f = objective(new_params)

        if np.random.rand() < np.exp((best_f - new_f) / sa_temp):
            best_x = new_params
            best_f = new_f

    return best_x
