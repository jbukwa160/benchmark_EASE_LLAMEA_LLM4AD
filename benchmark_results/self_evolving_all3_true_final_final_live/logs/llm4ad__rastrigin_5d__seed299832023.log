def algorithm(func, dim, lb, ub, budget, rng):
    n = 0
    T = 100.0
    alpha = 0.99
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    while n < budget:
        x_candidate = x_best + np.random.uniform(-1, 1, size=dim) * (ub - lb)
        
        # Clip candidates to [lb, ub]
        x_candidate = np.clip(x_candidate, lb, ub)
        
        f_candidate = func(x_candidate)
        
        if f_candidate < f_best:
            f_best = f_candidate
            x_best = x_candidate
            
        if n > 0 and rng.random() < np.exp((f_best - f_candidate) / T):
            x_best = x_candidate
            
        if n % (budget // 100) == 0:
            T *= alpha
            
        n += 1
        
    return x_best
