def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    iteration = 0
    while iteration < budget:
        iteration += 1
        
        # Local search with adaptive radius
        sigma = (ub - lb) / np.sqrt(iteration + 1)
        
        for _ in range(100):
            new_x = x.copy() + rng.normal(size=dim, scale=sigma)
            new_x = np.clip(new_x, lb, ub)
            
            if func(new_x) < best_f:
                x = new_x
                best_x = new_x
                best_f = func(new_x)
    
    return best_x
