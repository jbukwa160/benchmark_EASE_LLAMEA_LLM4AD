def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    nq = 10 * D
    nmu = 0.5 * D
    nu = (D + 1) / D
    cmu = 2
    c1 = 1
    ccov = 2

    xmean = np.zeros(D)
    sigma = 2.1
    cov = np.eye(D)

    for _ in range(budget):
        z = rng.randn(nq, D)
        y = xmean + sigma * z @ cov
        fy = func(y)
        idx = np.argsort(fy)[:nmu]

        xnew = (sigma / cmu) * z[idx] @ cov + (xmean / cmu)

        xmean = nmu / (D + 1) * xnew
        sigma *= (0.5 - 1.6 / (D + 3)) ** 2

        cov += ccov * np.outer(xnew - xmean, xnew - xmean) - nu * cov @ np.eye(D)

    return xmean
