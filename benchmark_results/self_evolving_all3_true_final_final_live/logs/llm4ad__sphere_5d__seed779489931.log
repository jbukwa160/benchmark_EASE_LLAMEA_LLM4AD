def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def objective(params):
        return func(clip(params))

    best_params = np.zeros(dim)
    best_value = float('inf')

    for _ in range(budget):
        temperature = 1.0
        current_params = rng.uniform(lb, ub, size=dim)

        while temperature > 1e-6:
            new_params = current_params + rng.normal(size=dim) * 0.01

            if objective(new_params) < objective(current_params):
                current_params = new_params
            else:
                delta = objective(new_params) - objective(current_params)
                probability = np.exp(-delta / temperature)

                if rng.uniform(0, 1) < probability:
                    current_params = new_params

            temperature *= 0.99
        else:
            current_value = objective(current_params)

            if current_value < best_value:
                best_value = current_value
                best_params = current_params

    return best_params
