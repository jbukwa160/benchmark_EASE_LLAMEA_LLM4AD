def algorithm(func, dim, lb, ub, budget, rng):
    X = np.random.uniform(lb, ub, size=(budget, dim))
    GP = np.zeros((budget, 1))

    for i in range(budget):
        mu, sigma = gp_posterior(X[:i+1], X[i])
        EI = expected_improvement(mu, sigma, func)
        next_point = sampleEI(EI, rng)

        # Clip to bounds
        next_point[next_point < lb] = lb
        next_point[next_point > ub] = ub

        X[i+1] = next_point
        GP[i+1] = func(next_point)

    best_idx = np.argmin(GP)
    return X[best_idx]
