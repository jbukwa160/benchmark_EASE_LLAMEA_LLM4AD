def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def crossover(parent1, parent2, f):
        alpha = 0.5 + (np.random.rand() - 0.5) * 0.8
        child = parent1 + alpha * (parent2 - parent1)
        if np.any(child < lb) or np.any(child > ub):
            return parent1
        else:
            return child

    def mutation(x, f):
        mu = 20 / dim
        for i in range(dim):
            if rng.random() < mu:
                x[i] += rng.uniform(-5.0, 5.0)
                x[i] = clip(x[i])
        return x

    population_size = int(np.sqrt(budget))
    population = np.zeros((population_size, dim))
    for i in range(population_size):
        population[i] = ub + (ub - lb) * rng.rand(dim)

    best_solution = None
    best_fitness = float('inf')

    for _ in range(budget):
        offspring = np.copy(population)
        for i in range(population_size):
            parent1, parent2 = rng.choice(population_size, 2, replace=False), rng.choice(population_size, 2, replace=False)
            if rng.random() < 0.5:
                child = crossover(offspring[parent1], offspring[parent2], func)
            else:
                child = mutation(offspring[parent1], func)
            offspring[i] = child
        population = np.copy(offspring)

        for i in range(population_size):
            x = population[i]
            fitness = func(x)
            if fitness < best_fitness:
                best_solution = x
                best_fitness = fitness

    return best_solution
