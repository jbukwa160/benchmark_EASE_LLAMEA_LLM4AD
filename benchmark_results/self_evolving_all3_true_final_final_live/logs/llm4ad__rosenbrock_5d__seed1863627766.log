def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    x = rng.uniform(lb, ub, size=dim)
    best_x = np.copy(x)
    best_f = f(best_x)

    for _ in range(budget):
        # DE
        mu = 0.7 + 1.6 * rng.uniform()
        sigma = 0.3 + 0.4 * rng.uniform()
        v = x + mu * (ub - lb) * rng.randn(dim)
        f_v = f(v)

        if f_v < best_f:
            best_x = np.copy(v)
            best_f = f_v

        # L-BFGS
        H = np.eye(dim)
        g = np.zeros(dim)
        for _ in range(10):
            g[:] = -np.dot(H, x - lb) + (ub - lb) * rng.randn(dim)
            v[:] = x + g
            f_v = f(v)

            if f_v < best_f:
                best_x = np.copy(v)
                best_f = f_v

            s = v - x
            y = f_v - best_f
            H += np.outer(s, s) / (np.dot(y, s)) * (1 + np.dot(np.dot(H, s), s) / (np.dot(y, s)))
            g += y / np.dot(y, s) * (1 + np.dot(np.dot(H, s), s) / (np.dot(y, s)))

        # CMA-ES
        c = 1.60217657e-4
        d = 0.3
        cov = np.eye(dim)
        for _ in range(10):
            z = rng.randn(dim)
            w = z / np.sqrt(np.sum(z**2))
            x += c * (np.sqrt(cov) @ w + d * (ub - lb) * rng.randn(dim))
            f_x = f(x)

            if f_x < best_f:
                best_x = np.copy(x)
                best_f = f_x

            cov += 1 / (dim + 1) * (z[:, None] @ z[None, :]) * (f_x - best_f)

    return best_x
