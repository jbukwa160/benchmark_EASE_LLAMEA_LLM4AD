def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    bounds = [(lb[i], ub[i]) for i in range(dim)]
    pop_size = int(1.5 * dim)
    ngen = budget // pop_size
    x_best = np.random.uniform(lb, ub, size=(pop_size, dim))
    f_best = [objective(x) for x in x_best]

    for g in range(ngen):
        trial_pop = np.copy(x_best)
        
        for i in range(pop_size):
            idx1, idx2, idx3 = rng.choice(range(pop_size), size=3, replace=False)
            
            u = rng.uniform(-1, 1, size=dim)
            v = (np.random.uniform(lb, ub, size=(dim)) - x_best[idx1]) / np.linalg.norm(x_best[idx1] - x_best[idx2])
            trial_pop[i] = x_best[idx3] + u * v
            
            # clip to bounds
            for j in range(dim):
                trial_pop[i, j] = min(max(trial_pop[i, j], lb[j]), ub[j])

        f_trial = [objective(x) for x in trial_pop]
        
        for i in range(pop_size):
            if f_trial[i] < f_best[i]:
                x_best[i] = trial_pop[i]
                f_best[i] = f_trial[i]

    best_idx = np.argmin(f_best)
    return x_best[best_idx]
