def algorithm(func, dim, lb, ub, budget, rng):
    init_x = np.random.uniform(lb, ub, (1, dim))
    
    x_best = init_x.copy()
    f_best = func(init_x)
    
    for i in range(budget):
        gp = GaussianProcessRegressor(kernel=Matern(n_restarts=10), alpha=rng)
        gp.fit(np.array([x_best]), np.array([f_best]))
        
        x_new = gp.predict(np.random.randn(1, dim))
        f_new = func(x_new)
        
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
        
        x_best_clipped = np.clip(x_best, lb, ub)
        f_best_clipped = func(x_best_clipped)
        
        if f_best_clipped < f_best:
            f_best = f_best_clipped
            x_best = x_best_clipped
    
    return x_best
