    n = int(np.ceil(budget / (dim + 1)))
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    for i in range(n):
        for j in range(dim):
            x_plus = np.copy(x_best)
            x_plus[j] += 0.1
            if all(lb <= x_plus <= ub):
                f_plus = func(x_plus)
                if f_plus < f_best:
                    x_best = x_plus
                    f_best = f_plus

        x_min = np.clip(x_best - 0.5, lb, ub)
        for j in range(dim):
            x_minus = np.copy(x_best)
            x_minus[j] -= 0.1
            if all(lb <= x_minus <= ub):
                f_minus = func(x_minus)
                if f_minus < f_best:
                    x_best = x_minus
                    f_best = f_minus

    return x_best
