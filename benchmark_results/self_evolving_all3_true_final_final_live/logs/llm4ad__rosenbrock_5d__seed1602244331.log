def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    n_iter = 0
    while n_iter < budget:
        # Random Search step
        new_x = rng.uniform(lb, ub, size=dim)
        f_new = func(new_x)
        if f_new < best_f:
            best_f = f_new
            best_x = new_x.copy()

        # CMA-ES step
        cov_mat = np.eye(dim) * 1e-4
        mean = best_x
        for i in range(n_iter):
            x_old = rng.multivariate_normal(mean, cov_mat)
            f_old = func(x_old)
            if f_old < best_f:
                best_f = f_old
                best_x = x_old.copy()
            cov_mat = 0.1 * (cov_mat + np.outer(best_x - mean, best_x - mean))
        n_iter += 1

    return best_x
