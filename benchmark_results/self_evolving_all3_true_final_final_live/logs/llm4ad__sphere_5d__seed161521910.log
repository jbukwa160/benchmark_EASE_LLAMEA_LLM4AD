def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)

    def clip(candidate):
        return np.clip(candidate, lb, ub)

    for i in range(budget):
        # Random Search
        new_x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
        
        # Pattern Search (Local Refinement)
        if rng.random() < 0.5:
            step_size = 0.1 * (ub - lb)
            new_x += rng.normal(0, step_size, size=dim)

        new_x = clip(new_x)
        new_f = func(new_x)

        # Update best solution
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f

    return best_x
