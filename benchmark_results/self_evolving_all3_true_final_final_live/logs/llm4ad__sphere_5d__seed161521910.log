def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    best_f = float('inf')

    for _ in range(budget):
        while True:
            z = np.random.normal(size=dim)
            x_candidate = lb + (ub - lb) * 0.5 * (1 + np.sign(z)) * rng.rand(dim)

            if all(lb <= x <= ub for x, l, u in zip(x_candidate, lb, ub)):
                break

        f = func(x_candidate)

        if f < best_f:
            best_x = x_candidate
            best_f = f

    return best_x
