def algorithm(func, dim, lb, ub, budget, rng):
    if not isinstance(rng, np.random.RandomState):
        rng = np.random.default_rng(rng)

    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def latin_hypercube_sampling(dim, bounds):
        samples = rng.uniform(low=bounds[0], high=bounds[1], size=(dim, budget))
        samples[:, 0] = (samples[:, 0] + bounds[0]) / 2
        return np.sort(samples, axis=0)

    def polynomial_mutation(candidate, dim, sigma):
        mutated_candidate = candidate.copy()
        for i in range(dim):
            if rng.random() < 0.1:
                mutated_candidate[i] += rng.normal(0, sigma)
        return clip(mutated_candidate)

    population_size = int(np.sqrt(budget))
    initial_population = latin_hypercube_sampling(dim, (lb, ub))

    for t in range(population_size - 1):
        fitness_values = func(initial_population[t])
        best_individual = initial_population[np.argmin(fitness_values)]
        mutated_candidates = np.zeros((dim, budget))
        for i in range(budget):
            sigma = 0.5 * (ub - lb) / np.sqrt(t + 1)
            mutated_candidates[:, i] = polynomial_mutation(best_individual, dim, sigma)

        new_population = latin_hypercube_sampling(dim, (lb, ub))
        for i in range(population_size):
            new_population[i] = clip(mutated_candidates[:, i])

        initial_population = np.concatenate((initial_population, new_population))

    fitness_values = func(initial_population)
    best_individual = initial_population[np.argmin(fitness_values)]
    return best_individual
