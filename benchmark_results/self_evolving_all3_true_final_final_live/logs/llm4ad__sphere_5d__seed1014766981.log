def algorithm(func, dim, lb, ub, budget, rng):
    n = 10 * dim**2
    mu = 0.5 + 1.49 / (n + 1)
    sigma = 0.1
    c_c = 0.8
    c_m = 2 / (n + 3)
    c_w = 1 - 4 / n

    y = np.zeros(dim)
    x = rng.uniform(lb, ub, size=dim)

    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        z = rng.normal(size=dim) * sigma
        p = c_w * (y - mu * np.dot(c_c * z + np.sqrt(1 - c_c**2) * y, z)) / np.linalg.norm(z)
        x_new = best_x + c_m * p

        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        if f_new < best_f:
            best_x = x_new
            best_f = f_new

        y = (1 - mu) * y + c_m * (x_new - best_x)
        sigma *= 1.01**(-0.5)

    return best_x
