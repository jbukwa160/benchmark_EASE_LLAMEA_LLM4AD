def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    mutation_factor = 0.5
    crossover_prob = 1.0
    bounds = [(lb, ub)] * dim
    
    x_pop = rng.uniform(lb, ub, (pop_size, dim))
    
    for i in range(budget):
        fitness = np.array([func(x) for x in x_pop])
        
        y_pop = x_pop.copy()
        idx = fitness.argmin()
        best_x = x_pop[idx]
        
        for j in range(pop_size):
            if rng.rand() < crossover_prob:
                z = y_pop[j] + mutation_factor * (best_x - y_pop[j]) + rng.uniform(-1, 1, dim)
                z = np.clip(z, lb, ub)
            else:
                z = y_pop[j]
            
            y_pop[j] = 0.5 * (y_pop[j] + z) + rng.uniform(-1, 1, dim)
            y_pop[j] = np.clip(y_pop[j], lb, ub)
        
        x_pop = y_pop
        
    return best_x
