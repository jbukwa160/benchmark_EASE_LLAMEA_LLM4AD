def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.sqrt(budget))
    particles = np.random.uniform(lb, ub, (pop_size, dim))

    pbest = np.copy(particles)
    gbest = np.min(func(particles))

    for _ in range(budget):
        for i in range(pop_size):
            r1 = rng.rand(dim)
            r2 = rng.rand(dim)

            alpha = 0.5 * (pbest[i] + func(pbest[i]) - gbest) / func(pbest[i])
            beta = np.sqrt(np.sum(r1)) * lb + (np.sqrt(np.sum(r1)) - 1) * ub

            particles[i] = beta + alpha * (particles[i] - pbest[i])

        for i in range(pop_size):
            if func(particles[i]) < gbest:
                gbest = func(particles[i])
                pbest[i] = particles[i]

    best_particle = np.argmin(func(particles))
    return np.clip(particles[best_particle], lb, ub)
