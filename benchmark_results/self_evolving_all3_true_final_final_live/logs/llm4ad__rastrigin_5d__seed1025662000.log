def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = 50
    x = lb + (ub - lb) * rng.rand(pop_size, dim)
    best = np.inf
    for _ in range(budget):
        y = np.zeros((pop_size, dim))
        for i in range(dim):
            v1 = rng.randn(pop_size, dim)
            v2 = rng.randn(pop_size, dim)
            v3 = rng.randn(pop_size, dim)
            y[:, i] = x + 0.5 * (v1 - v2) / np.sqrt(np.sum(v1**2 + v2**2)) + v3
        y = clip(y)
        f_y = func(y)
        idx = np.argsort(f_y)[:pop_size//2]
        x[idx] = y[idx]
        best_f_x = func(x)
        if best_f_x < best:
            best = best_f_x
            best_idx = np.argmin(best_f_x)
            best_x = x[best_idx]
        else:
            idx = np.random.choice(pop_size, size=10, replace=False)
            for i in idx:
                y = x[i] + 0.1 * rng.randn(dim) / (ub - lb)
                y = clip(y)
                f_y = func(y)
                if f_y < best_f_x[i]:
                    x[i] = y
    return best_x
