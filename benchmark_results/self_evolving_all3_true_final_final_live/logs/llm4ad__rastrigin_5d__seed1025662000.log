def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_next_population(population, mean, cov):
        new_population = np.zeros((dim, population.shape[0]))
        for i in range(population.shape[0]):
            new_individual = mean + np.dot(cov, rng.normal(size=(dim,)))
            new_population[:, i] = clip(new_individual)
        return new_population

    def update_cma(population, fitness):
        mu = 1 / (population.shape[0])
        cov_update = np.eye(dim) * np.mean(fitness)
        for i in range(population.shape[0]):
            cov_update += mu * np.outer(population[:, i] - mean, population[:, i] - mean)
        return cov_update

    def update_mean(cov):
        mean = 5.0 if rng.uniform() < 0.5 else -5.0
        return mean

    mean = (ub + lb) / 2
    cov = np.eye(dim) * 10
    population_size = 100
    iteration_count = 0

    while iteration_count < budget:
        new_population = generate_next_population(np.zeros((dim, population_size)), mean, cov)
        fitness = func(new_population)
        best_individual_index = np.argmin(fitness)

        if iteration_count % 10 == 0:  # occasionally update the covariance matrix
            cov = update_cma(new_population[:, best_individual_index:], fitness[best_individual_index:])

        mean = update_mean(cov)
        iteration_count += 1

    return clip(mean)
