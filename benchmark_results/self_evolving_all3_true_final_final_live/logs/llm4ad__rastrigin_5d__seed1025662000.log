def algorithm(func, dim, lb, ub, budget, rng):
    n = int(np.ceil(np.sqrt(budget)))
    mean = np.zeros(dim)
    sigma = 1.0
    cov = np.eye(dim) * 10.0 ** 4
    best_x = np.copy(mean)
    best_f = func(mean)

    for _ in range(n):
        z = rng.randn(dim)
        x = mean + sigma * np.dot(np.linalg.cholesky(cov), z)
        f = func(x)

        if f < best_f:
            best_f = f
            best_x = np.copy(x)

        if f > 0 and _ >= n // 2:
            sigma *= np.exp(1 - (f / best_f))
            cov = (1 + 2 / (_ + 1)) * cov + sigma ** 2 * z.reshape(-1, 1) @ z

        x = np.clip(x, lb, ub)

    return best_x
