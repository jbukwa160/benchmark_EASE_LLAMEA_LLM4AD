def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian(x, mu, sigma):
        return (1 / (sigma * np.sqrt(2 * np.pi))) * np.exp(-((x - mu) ** 2) / (2 * sigma ** 2))

    best = None
    for i in range(budget):
        x = np.zeros(dim)
        for j in range(dim):
            mean = 0 if rng.random() < 0.5 else ub[j]
            std_dev = max(1e-3, abs(ub[j] - lb[j]) / 10)
            x[j] = mean + std_dev * gaussian(rng.uniform(lb[j], ub[j]), mean, std_dev)
        x = np.clip(x, lb, ub)
        f_x = func(x)
        if best is None or f_x < func(best):
            best = x
    return best
