def algorithm(func, dim, lb, ub, budget, rng):
    n = 1000
    num_restart = int(budget / n)

    best = None
    for _ in range(num_restart):
        x = rng.uniform(lb, ub, size=dim)
        f_x = func(x)
        
        if best is None or f_x < np.sum(best**2):
            best = x

    return best
