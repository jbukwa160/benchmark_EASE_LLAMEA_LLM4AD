def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (dim,))
    
    for _ in range(budget):
        f_x = func(x)
        
        if f_x == 0:
            return x
        
        step_size = 1 / (rng.rand() * 100 + 1)
        delta = rng.randn(dim) * step_size
        new_x = np.clip(x + delta, lb, ub)
        f_new_x = func(new_x)
        
        if f_new_x < f_x:
            x = new_x
    
    return x
