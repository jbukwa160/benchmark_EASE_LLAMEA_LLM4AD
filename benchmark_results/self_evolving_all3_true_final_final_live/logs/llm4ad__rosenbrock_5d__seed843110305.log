def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    x_best = np.random.uniform(lb, ub, size=n)
    f_best = func(x_best)

    for _ in range(budget):
        # Randomised search
        x_search = x_best + rng.normal(size=(n,))
        while not (lb <= x_search <= ub).all():
            x_search = x_best + rng.normal(size=(n,))

        # Probabilistic trust region update
        f_search = func(x_search)
        if f_search < f_best:
            x_best = x_search
            f_best = f_search

    return x_best
