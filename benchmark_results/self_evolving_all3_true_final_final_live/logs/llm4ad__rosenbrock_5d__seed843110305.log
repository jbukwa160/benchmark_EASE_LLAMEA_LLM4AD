def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    d = 1e-5 * np.ones(n)
    c = 2.0 / (n + 1.25)
    cmu = 1 / (n + 3 / 4)
    ccov = 2 / ((n - 1) + 2)
    step_size = 10
    popsize = 100

    mean = rng.rand(n)
    for i in range(n):
        mean[i] = (ub[i] - lb[i]) * rng.uniform(0, 1) + lb[i]

    best_candidate = mean.copy()
    best_fitness = func(mean)

    for _ in range(budget):
        offspring = np.zeros((popsize, n))
        for i in range(popsize):
            noise = d * rng.randn(n)
            offspring[i] = mean + step_size * noise

        # Clip candidates to [lb, ub]
        clipped_offspring = np.clip(offspring, lb, ub)

        fitness = func(clipped_offspring)
        idx = np.argsort(fitness)

        for i in range(popsize):
            if i < popsize / 2:
                mean[i] = clipped_offspring[idx[i]]
            else:
                # Update the step-size
                noise = d * rng.randn(n)
                mu = (1 - c) * mean + c * clipped_offspring[idx[popsize-i-1]] + cmu * np.sum((clipped_offspring[idx[popsize-i-1]] - mean)**2, axis=0) / popsize
                cov = ccov * np.sum((mu - clipped_offspring[idx[popsize-i-1]])**2, axis=0)
                d *= 1 + c / (n + 1.25) - 1 / (n + 3 / 4)

                mean[i] = mu
                if i < popsize / 2:
                    offspring[i] = mu + step_size * noise
                else:
                    # Update the covariance matrix
                    cov += np.outer((mu - clipped_offspring[idx[popsize-i-1]]), (mu - clipped_offspring[idx[popsize-i-1]]))
                    d = np.linalg.cholesky(cov)

        # Clip candidates to [lb, ub]
        clipped_offspring = np.clip(offspring, lb, ub)
        fitness = func(clipped_offspring)
        idx = np.argsort(fitness)

        for i in range(popsize):
            if i < popsize / 2:
                mean[i] = clipped_offspring[idx[i]]
            else:
                # Update the step-size
                noise = d * rng.randn(n)
                mu = (1 - c) * mean + c * clipped_offspring[idx[popsize-i-1]] + cmu * np.sum((clipped_offspring[idx[popsize-i-1]] - mean)**2, axis=0) / popsize
                cov = ccov * np.sum((mu - clipped_offspring[idx[popsize-i-1]])**2, axis=0)
                d *= 1 + c / (n + 1.25) - 1 / (n + 3 / 4)

                mean[i] = mu
                if i < popsize / 2:
                    offspring[i] = mu + step_size * noise
                else:
                    # Update the covariance matrix
                    cov += np.outer((mu - clipped_offspring[idx[popsize-i-1]]), (mu - clipped_offspring[idx[popsize-i-1]]))
                    d = np.linalg.cholesky(cov)

        # Update best candidate and fitness
        if fitness[-1] < best_fitness:
            best_candidate = mean.copy()
            best_fitness = fitness[-1]

    return best_candidate
