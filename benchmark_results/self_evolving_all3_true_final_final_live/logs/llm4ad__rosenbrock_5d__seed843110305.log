def algorithm(func, dim, lb, ub, budget, rng):
    def rand(a, b):
        return rng.uniform(a, b)

    def cauchy(x, s):
        u = 1 / (s * (1 + abs(x) ** (1/s)))
        v = np.sign(x) * np.exp(-u)
        return v

    def f(x):
        x = np.clip(x, lb, ub)
        return func(x)

    best = np.array([0.5] * dim)
    for _ in range(budget):
        z = np.zeros(dim)
        for i in range(dim):
            v1, v2, v3 = rand(-1, 1), rand(-1, 1), rand(-1, 1)
            z[i] = best[(i-1)%dim] + v1 * (best[i%dim] - best[(i-1)%dim]) + \
                   v2 * cauchy(best[i%dim] - best[(i-1)%dim], 0.5) + \
                   v3 * np.random.normal(0, 1)
        x = best + z
        if f(x) < f(best):
            best = x

    return best
