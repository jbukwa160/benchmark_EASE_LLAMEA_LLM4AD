def algorithm(func, dim, lb, ub, budget, rng):
    best_x = lb + (ub - lb) * rng.rand(dim)
    best_f = func(best_x)

    for _ in range(budget):
        x = lb + (ub - lb) * rng.rand(dim)
        f = func(x)
        
        if f < best_f:
            best_x = x
            best_f = f
        
        alpha = 0.1
        beta = 0.5
        for i in range(dim):
            step_size = np.sqrt(np.prod(ub - lb)) * rng.randn()
            new_x = best_x.copy()
            new_x[i] += (x[i] - best_x[i]) * step_size
            clipped_new_x = np.clip(new_x, lb, ub)
            
            new_f = func(clipped_new_x)
            
            if new_f < f:
                f = new_f
                x = clipped_new_x
            
            if rng.rand() < alpha and f > best_f:
                break
            
            if rng.rand() < beta and np.linalg.norm(x - best_x) < 1e-6:
                break
    
    return best_x
