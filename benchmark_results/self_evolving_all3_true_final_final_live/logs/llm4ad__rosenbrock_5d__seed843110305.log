def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Adaptive step size
        std_dev = 2.5 - (_ / budget) * 2.5

        # Sample new point using Gaussian distribution
        noise = np.random.normal(0, std_dev, (1, dim))
        x_new = best_x + noise

        # Clip candidate to bounds
        x_new = np.clip(x_new, lb, ub)

        # Evaluate new point
        f_new = func(x_new)

        if f_new < best_f:
            best_f = f_new
            best_x = x_new.copy()

    return best_x
