def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = np.zeros(dim)
    best_fitness = float('inf')
    
    for _ in range(budget):
        sol = rng.uniform(lb, ub, size=dim)
        for i in range(10 * dim):  # 10 iterations per dimension
            step_size = rng.uniform(1e-6, 0.1)
            idx = rng.randint(dim)
            new_sol = sol.copy()
            new_sol[idx] += rng.uniform(-step_size, step_size)
            new_sol = np.clip(new_sol, lb, ub)
            if func(new_sol) < func(sol):
                sol = new_sol
        if func(sol) < best_fitness:
            best_sol = sol
            best_fitness = func(sol)
    
    return best_sol
