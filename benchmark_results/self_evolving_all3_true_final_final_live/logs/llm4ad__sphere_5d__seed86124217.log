def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_cand = np.clip(np.random.uniform(lb, ub, size=dim), lb, ub)
        f_cand = func(x_cand)

        prob_accept = 1 / (f_cand / f_best + 1e-6)  # adjust acceptance probability based on current best
        if rng.random() < prob_accept:
            x_best = x_cand
            f_best = f_cand

    return x_best
