def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    for _ in range(budget):
        r = np.mean(np.abs(x_best)) * 0.1 + 0.01
        for _ in range(int(10**6 / budget)):
            while True:
                x_candidate = x_best + r * (rng.uniform(size=dim) - 0.5)
                x_candidate = np.clip(x_candidate, lb, ub)
                if np.all(np.abs(x_candidate - x_best) > 1e-3):
                    break
            f_candidate = func(x_candidate)
            if f_candidate < f_best:
                f_best = f_candidate
                x_best = x_candidate
        r *= 0.9
    return x_best
