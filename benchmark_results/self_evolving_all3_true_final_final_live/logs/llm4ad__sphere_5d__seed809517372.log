def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    x_best = np.zeros(dim)
    f_best = float('inf')
    T = 1.0
    iter_count = 0
    no_improve = 0

    for i in range(budget):
        if f_best <= func(clip(x_best)):
            no_improve += 1
        else:
            no_improve = 0
            f_best = func(clip(x_best))

        if no_improve >= budget // 10 and T < 1e-6:
            break

        d = rng.uniform(-5.0, 5.0, dim)
        x_new = clip(x_best + np.sqrt(T) * d)

        delta_f = func(x_new) - f_best
        if delta_f < 0 or rng.rand() < np.exp(-delta_f / T):
            x_best = x_new
            iter_count += 1

        T *= 0.99

    return x_best
