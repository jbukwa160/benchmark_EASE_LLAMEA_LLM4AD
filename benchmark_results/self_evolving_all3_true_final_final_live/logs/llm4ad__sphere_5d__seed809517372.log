def algorithm(func, dim, lb, ub, budget, rng):
    def sample_lhs(bounds, num_samples, rng=np.random):
        samples = []
        for i in range(num_samples):
            sample = [rng.uniform(b[0], b[1]) for b in bounds]
            samples.append(sample)
        return np.array(samples)

    def anneal(current_solution, current_value, temperature, step_size, func):
        new_solution = current_solution + np.random.normal(0, step_size, dim)
        new_solution = np.clip(new_solution, lb, ub)
        new_value = func(new_solution)
        if new_value < current_value:
            return new_solution, new_value
        else:
            probability = np.exp((current_value - new_value) / temperature)
            if rng.uniform(0, 1) < probability:
                return new_solution, new_value
            else:
                return current_solution, current_value

    bounds = [(lb, ub)] * dim
    initial_solution = sample_lhs(bounds, 1)[0]
    initial_value = func(initial_solution)

    temperature = 100.0
    step_size = 5.0
    num_samples = int(budget / (dim + 1))

    for _ in range(num_samples):
        solution, value = anneal(initial_solution, initial_value, temperature, step_size, func)
        if value < initial_value:
            initial_solution = solution
            initial_value = value

        temperature *= 0.99
        step_size *= 0.995

    return initial_solution
