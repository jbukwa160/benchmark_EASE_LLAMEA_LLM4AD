def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    best_obj = float('inf')
    
    for i in range(budget):
        candidate = lb + (ub - lb) * rng.rand(dim)
        
        obj = func(candidate)
        
        if obj < best_obj:
            best_obj = obj
            best = candidate
            
        if budget - i <= 1000 and rng.rand() < 0.1:
            break
    
    return best
