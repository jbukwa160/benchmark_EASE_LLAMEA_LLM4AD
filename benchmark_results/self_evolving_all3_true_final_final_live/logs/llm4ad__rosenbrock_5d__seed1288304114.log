def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_x = np.random.uniform(lb, ub, size=dim)
    best_y = func(best_x)

    for _ in range(budget - 1):
        candidates = np.zeros((1000, dim))
        for i in range(5):
            if rng.random() < 0.2:
                candidates[:, i] = np.random.uniform(lb, ub)
            else:
                candidates[:, i] = best_x + (rng.uniform(-1, 1) * (ub - lb)) / (i+1)

        candidates = clip(candidates)
        candidates_y = func(candidates)
        idxs = np.argsort(candidates_y)[:100]
        new_candidates = candidates[idxs]

        new_best_idx = np.argmin(new_candidates_y[:100])
        if new_candidates_y[new_best_idx] < best_y:
            best_x = new_candidates[new_best_idx]
            best_y = new_candidates_y[new_best_idx]

    return best_x
