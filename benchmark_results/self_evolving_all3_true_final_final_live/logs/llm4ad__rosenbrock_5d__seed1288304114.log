def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(size, dim, rng):
        return rng.uniform(lb, ub, (size, dim))

    def differential_evolution(population, func, bounds, budget):
        for _ in range(budget // 2):
            # Select parents
            parents = np.array([population[rng.randint(0, population.shape[0]), :] for _ in range(size)])

            # Generate offspring
            offspring = np.zeros((size, dim))
            for i in range(size):
                diff = parents[np.random.choice(range(size), size=3, replace=False), :]
                offspring[i] = clip(parents[i] + 0.5 * rng.uniform(-1, 1) * (diff[0] - 2 * diff[1] + diff[2]))

            # Update population
            for i in range(size):
                if func(offspring[i]) < func(population[i]):
                    population[i] = offspring[i]

        return population

    def local_search(population, func, bounds, budget):
        for _ in range(budget // 4):
            # Select a random individual from the population
            index = rng.randint(0, population.shape[0])
            candidate = clip(population[index])

            # Perform local search around the candidate
            for i in range(dim):
                step_size = 0.1 * (ub - lb)
                new_candidate = np.copy(candidate)
                new_candidate[i] += step_size * rng.uniform(-1, 1)
                if func(new_candidate) < func(candidate):
                    candidate = new_candidate

            # Update the population
            population[index] = candidate

        return population

    size = 50
    population = generate_initial_population(size, dim, rng)

    for _ in range(budget // 4):
        population = differential_evolution(population, func, (lb, ub), budget)
        population = local_search(population, func, (lb, ub), budget)

    best_candidate = clip(np.argmin([func(candidate) for candidate in population], axis=0))
    return best_candidate
