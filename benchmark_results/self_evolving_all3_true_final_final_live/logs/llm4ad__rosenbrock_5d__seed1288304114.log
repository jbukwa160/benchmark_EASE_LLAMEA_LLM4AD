def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_f = float('inf')
    num_restarts = 0
    while num_restarts < 10 and budget > 0:
        mean = np.zeros(dim)
        sigma = 5.0 * (ub - lb) / dim
        cov = np.eye(dim) * (sigma ** 2)
        for _ in range(budget):
            x = rng.multivariate_normal(mean, cov)
            x = np.clip(x, lb, ub)
            f = func(x)
            if f < best_f:
                best_f = f
                best_x = x.copy()
            if f == 0.0:
                break
        if mean is not None and np.any(np.abs(rng.multivariate_normal(mean, cov)) > sigma):
            num_restarts += 1
        budget -= 1
    return best_x
