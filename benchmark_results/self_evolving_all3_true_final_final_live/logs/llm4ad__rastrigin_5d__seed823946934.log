def algorithm(func, dim, lb, ub, budget, rng):
    T = 10  # initial temperature
    alpha = 0.99  # cooling rate
    n_iter = int(budget / (dim * 2))
    
    x = rng.uniform(lb, ub, size=dim)
    best_x = np.copy(x)
    best_f = func(x)
    
    for _ in range(n_iter):
        delta = rng.normal(0, 1, size=dim) / 10
        new_x = x + delta
        
        # Clip candidates to [lb, ub]
        new_x = np.clip(new_x, lb, ub)
        
        new_f = func(new_x)
        if new_f < best_f:
            best_x = np.copy(new_x)
            best_f = new_f
            
        if rng.random() < 0.9:  # 90% probability of accepting a worse solution
            if new_f >= best_f:
                delta = rng.normal(0, 1, size=dim) / 10
                new_x = x + delta
                
                # Clip candidates to [lb, ub]
                new_x = np.clip(new_x, lb, ub)
                
                new_f = func(new_x)
                if new_f < best_f:
                    x = np.copy(new_x)
        else:
            x = np.copy(new_x)
        
        T *= alpha
        
    return best_x
