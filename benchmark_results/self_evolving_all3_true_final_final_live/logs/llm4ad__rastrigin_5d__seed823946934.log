def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidates(mu, sigma, num_candidates):
        return mu + sigma * (rng.normal(size=(num_candidates, dim))[:, None] * 
                            np.sqrt(np.maximum(0, 1 - np.square(rng.uniform(size=num_candidates)))))
    
    best = np.inf
    best_candidate = None
    
    for _ in range(budget // 100):
        population_size = min(100, budget // 10)
        
        mu = (ub + lb) / 2 * rng.uniform(size=dim)
        sigma = ub - lb
        
        candidates = generate_candidates(mu, sigma, population_size)
        clipped_candidates = np.clip(candidates, lb, ub)
        
        scores = func(clipped_candidates).flatten()
        sorted_scores, sorted_candidates = zip(*sorted(zip(scores, clipped_candidates), reverse=True))
        top_scores, top_candidates = sorted_scores[:population_size], sorted_candidates[:population_size]
        
        if min(top_scores) < best:
            best = min(top_scores)
            best_candidate = np.mean(top_candidates, axis=0)
            
        for i in range(population_size):
            next_mu = (ub + lb) / 2 * rng.uniform(size=dim) + top_candidates[i]
            next_sigma = max(1e-5, sigma - rng.normal(size=dim))
            candidates = generate_candidates(next_mu, next_sigma, population_size)
            clipped_candidates = np.clip(candidates, lb, ub)
            
            scores = func(clipped_candidates).flatten()
            sorted_scores, sorted_candidates = zip(*sorted(zip(scores, clipped_candidates), reverse=True))
            top_scores, top_candidates = sorted_scores[:population_size], sorted_candidates[:population_size]
            
            if min(top_scores) < best:
                best = min(top_scores)
                best_candidate = np.mean(top_candidates, axis=0)
                
    return best_candidate
