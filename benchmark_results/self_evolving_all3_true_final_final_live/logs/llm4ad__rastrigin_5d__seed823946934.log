def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    def generate_initial_population(n, dim):
        population = rng.uniform(lb, ub, size=(n, dim))
        return population

    def calculate_convergence(population, best_fitness):
        current_best_fitness = func(clip(population[np.argmin(np.array([func(clip(x)) for x in population]))]))
        convergence_rate = np.abs((current_best_fitness - best_fitness) / best_fitness)
        return convergence_rate

    def adapt_mutation_strategy(convergence_rate):
        if convergence_rate < 0.01: # adjust threshold as needed
            mutation_strategy = 'rand1exp'
        elif convergence_rate > 0.5:
            mutation_strategy = 'rand2bin'
        else:
            mutation_strategy = 'best/1/exp' # default strategy
        return mutation_strategy

