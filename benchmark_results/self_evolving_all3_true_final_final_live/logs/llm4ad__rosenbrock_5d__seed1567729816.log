def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_iter = int(budget)
    
    # Initialize the model with random points
    X_init = rng.uniform(lb, ub, size=(10,D))
    Y_init = np.array([func(x) for x in X_init])
    
    sigma2 = 1e-5
    
    for i in range(n_iter):
        print(f"Iteration {i+1}/{n_iter}")
        
        # Model update
        K = np.zeros((len(X_init), len(X_init)))
        for j in range(len(X_init)):
            for k in range(j, len(X_init)):
                if j == k:
                    K[j,k] = 1 + rng.normal(0, 1e-2)
                else:
                    K[j,k] = np.exp(-np.sum((X_init[j]-X_init[k])**2))
        alpha = Y_init / (K * sigma2)
        L = np.linalg.cholesky(K + np.eye(len(X_init)) * rng.uniform(0, 1e-3))
        
        # Predict the next point
        x_new = X_init[-1] + rng.normal(size=D)
        mu = np.dot(np.dot(L.T, alpha), (K[:,-1] / (K[:,-1]**2 + sigma2)))
        s2 = 1 / (K[:,-1]**2 + sigma2) * (1 - np.dot(K[:,-1], L[-1,:]))
        nu = norm.cdf(mu/s2)
        
        # Acquisition function
        pi = rng.uniform(0, 1)
        if pi < nu:
            x_new = X_init[np.argmax(Y_init)]
        else:
            x_new = x_new + np.dot(np.linalg.inv(L), rng.normal(size=D))
            x_new = (x_new - lb) / (ub - lb)
        
        # Clip candidate to bounds
        for j in range(D):
            x_new[j] = max(lb, min(ub, x_new[j]))
            
        # Evaluate the function at the new point
        Y_new = func(x_new)
        
        # Update the model and candidates
        X_init = np.vstack((X_init, x_new))
        Y_init = np.append(Y_init, Y_new)
        
    return X_init[-1]
