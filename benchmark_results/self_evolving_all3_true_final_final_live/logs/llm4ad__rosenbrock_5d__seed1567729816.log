def algorithm(func, dim, lb, ub, budget, rng):
    def func_with_bounds(x):
        return func(np.clip(x, lb, ub))

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func_with_bounds(x_best)

    cma_es_stepsize = 0.5
    sa_temperature = 1.0
    cma_es_dim_count = 10

    for i in range(budget):
        if rng.rand() < 0.01:
            x_new = np.random.uniform(lb, ub, size=dim)
        else:
            g = np.eye(dim)
            for _ in range(cma_es_dim_count):
                g += np.outer(rng.randn(dim), rng.randn(dim))
            D, v = np.linalg.eigh(g)
            step = cma_es_stepsize * np.sqrt(D)[:, None] * rng.randn(dim)
            x_new = x_best + step

        f_new = func_with_bounds(x_new)

        delta_f = f_new - f_best
        accept_prob = np.exp(-delta_f / sa_temperature)

        if rng.rand() < accept_prob:
            x_best = x_new
            f_best = f_new

    return x_best
