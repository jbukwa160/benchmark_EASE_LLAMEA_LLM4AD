def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    current_best = np.random.uniform(lb, ub, size=dim)
    for _ in range(budget):
        new_candidate = np.random.normal(loc=current_best, scale=rng, size=dim)
        new_candidate = clip(new_candidate)
        
        if func(new_candidate) < func(current_best):
            current_best = new_candidate
    
    return current_best
