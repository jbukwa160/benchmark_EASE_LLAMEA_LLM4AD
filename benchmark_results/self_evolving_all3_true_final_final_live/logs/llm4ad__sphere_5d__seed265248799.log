def algorithm(func, dim, lb, ub, budget, rng):
    def sample_gaussian(loc, scale):
        return loc + scale * rng.normal(size=dim)

    x = sample_gaussian(np.zeros(dim), 0.5)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        new_x = sample_gaussian(best_x, 1.0)
        clipped_new_x = np.clip(new_x, lb, ub)
        new_f = func(clipped_new_x)

        if rng.uniform() < np.exp((best_f - new_f) / (new_f + 1e-8)):
            best_x = clipped_new_x
            best_f = new_f

    return best_x
