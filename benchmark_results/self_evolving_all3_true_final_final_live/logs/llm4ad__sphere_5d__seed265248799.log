def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    min_val = float('inf')
    
    for _ in range(budget):
        candidate = np.clip(best + rng.normal(size=dim), a_min=lb, a_max=ub)
        new_val = func(candidate)
        
        if new_val < min_val:
            min_val = new_val
            best = candidate
            
    return best
