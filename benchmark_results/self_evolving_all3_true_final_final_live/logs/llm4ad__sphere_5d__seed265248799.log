def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    f_history = [func(clip(x))]
    best_x = clip(x.copy())
    best_f = f_history[0]

    for _ in range(budget):
        y = x + rng(np.zeros(dim), 1) * (ub - lb)
        f_y = func(clip(y))
        if f_y < best_f:
            best_f = f_y
            best_x = clip(y.copy())
        
        # Simulated Annealing
        t = budget - _
        delta = f_y - best_f
        if delta < 0 or np.random.rand() < np.exp(-delta / (t + 1)):
            x = y

    return best_x
