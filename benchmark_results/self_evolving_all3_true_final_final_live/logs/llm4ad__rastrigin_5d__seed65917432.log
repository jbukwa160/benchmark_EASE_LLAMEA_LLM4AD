def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.zeros(dim)
    s = 0.1 * rng.uniform(-1, 1, size=dim) + 1
    mu = np.zeros(dim)
    C = np.eye(dim)

    for _ in range(budget):
        z = clip(mu + np.dot(np.sqrt(C), rng.normal(size=(dim))))
        f_z = func(z)
        x_new = clip(x + s * (z - x))

        f_x_new = func(x_new)
        if f_x_new < f_z:
            mu = x_new
            C = C / 1.1 + np.outer((x_new - mu), (x_new - mu))
            s *= 0.9
            x = x_new
        else:
            mu += 2 * rng.normal(size=(dim)) * s
            C = C * 1.01 + np.outer(rng.normal(size=(dim)), rng.normal(size=(dim)))
            s *= 0.99

    return clip(mu)
