def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(pop_size):
        return np.random.uniform(lb, ub, size=(pop_size, dim))

    def calculate_fitness(population):
        return func(population)

    def select_parents(population, fitness, pop_size):
        idx = np.argsort(fitness)[:int(pop_size/2)]
        parents = population[idx]
        return parents

    def generate_offspring(parents, pop_size):
        offspring = np.zeros((pop_size, dim))
        for i in range(pop_size):
            parent_idx = rng.randint(0, len(parents), size=1)[0]
            offspring[i] = parents[parent_idx] + 0.5 * rng.normal(size=(1, dim)) / (func(np.array([1]*dim)))
        return offspring

    def clip_population(population, lb, ub):
        return np.clip(population, a_min=lb, a_max=ub)

    pop_size = int(budget**0.5)
    population = generate_initial_population(pop_size)
    fitness = calculate_fitness(population)
    parents = select_parents(population, fitness, pop_size)
    for i in range(1, budget):
        offspring = generate_offspring(parents, pop_size)
        clipped_offspring = clip_population(offspring, lb, ub)
        new_fitness = calculate_fitness(clipped_offspring)
        idx = np.argsort(new_fitness)[:int(pop_size/2)]
        parents = clipped_offspring[idx]
    best_individual = population[np.argmin(fitness)]
    return best_individual
