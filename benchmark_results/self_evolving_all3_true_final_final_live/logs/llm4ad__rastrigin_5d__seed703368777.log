def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    pop_size = int(budget / (dim + 1))
    n_iter = min(pop_size, budget)

    x = rng.uniform(lb, ub, size=(pop_size, dim))

    for _ in range(n_iter):
        g = np.mean(x, axis=0)
        y = x + 0.5 * rng.normal(size=x.shape)
        y = clip(y)
        f_y = func(y)

        x_best = np.copy(x)
        f_x_best = func(x_best)

        for i in range(pop_size):
            if f_y[i] < f_x_best[i]:
                x_best[i] = y[i]
                f_x_best[i] = f_y[i]

        f_g = func(g)
        for i in range(pop_size):
            if f_g < f_x_best[i]:
                x_best[i] = g
                f_x_best[i] = f_g

        x = np.copy(x_best)

    best_idx = np.argmin(f_x_best)
    return clip(x[best_idx])
