def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def sample(bounds):
        return rng.uniform(bounds[0], bounds[1], size=dim)

    def evaluate(x):
        return func(x)

    def compute_gradients(x):
        gradient = np.zeros_like(x)
        step_size = 1e-2
        for i in range(dim):
            x_i = clip(x + step_size * (rng.uniform(-1, 1) * rng.normal(size=dim)))
            gradient[i] = evaluate(x_i) - evaluate(x)
        return gradient

    best_x = sample([[-5.0, -5.0], [5.0, 5.0]])
    best_f = evaluate(best_x)

    for _ in range(budget):
        # Differential Evolution
        x1, x2, x3 = best_x + rng.uniform(-1, 1) * np.array([[-5.0, -5.0], [5.0, 5.0]]), \
                     best_x + rng.uniform(-1, 1) * np.array([[-5.0, -5.0], [5.0, 5.0]]), \
                     best_x + rng.uniform(-1, 1) * np.array([[-5.0, -5.0], [5.0, 5.0]])
        x4 = (x1 + x2 + x3) / 3
        x5 = (x1 + rng.uniform(0, 1) * (x2 - x3)) + \
             (x2 + rng.uniform(0, 1) * (x3 - x1)) + \
             (x3 + rng.uniform(0, 1) * (x1 - x2))
        x4 = clip((3 * x4 - x5) / 2)
        # Conjugate Gradient
        gradient = compute_gradients(best_x)
        alpha = 1.0
        while evaluate(best_x + alpha * gradient) < best_f:
            alpha *= 0.99
        best_x = best_x + alpha * gradient

    return clip(best_x)
