def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
        
        # Update with gradient information
        dx = np.zeros(dim)
        for i in range(dim):
            x_ = np.copy(x)
            x_[i] += 1e-3
            
            f_ = func(x_)
            
            if f_ < f:
                dx[i] = 1
            else:
                f_ = func(np.copy(x).astype(np.float64) - 1e-3)
                
                if f_ < f:
                    dx[i] = -1
        
        x += 0.01 * dx
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
    
    return best_x
