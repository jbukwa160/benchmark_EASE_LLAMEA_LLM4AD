def algorithm(func, dim, lb, ub, budget, rng):
    def sample_candidate(rng, dim, lb, ub):
        return (ub - lb) * rng.rand(dim) + lb

    best_x = sample_candidate(rng, dim, lb, ub)
    best_f = func(best_x)

    for _ in range(budget):
        x = sample_candidate(rng, dim, lb, ub)
        f = func(x)
        
        if f < best_f:
            best_x = x
            best_f = f

    return best_x
