def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate():
        candidate = rng.uniform(lb, ub, size=dim)
        return candidate

    def mutate(candidate, rng):
        mutant = candidate + rng.uniform(-1, 1, size=dim)
        return mutant

    def crossover(parent, mutant, rng):
        if rng.rand() < 0.5:
            crossed = parent
        else:
            crossed = (parent + mutant) / 2
        return crossed

    def evaluate(x):
        return func(x)

    population_size = 50
    population = [get_candidate() for _ in range(population_size)]
    best_so_far = np.inf
    best_solution = None

    for _ in range(budget):
        new_population = []
        for candidate in population:
            mutated = mutate(candidate, rng)
            crossed = crossover(candidate, mutated, rng)
            clipped = np.clip(crossed, lb, ub)
            new_candidate = evaluate(clipped)
            if new_candidate < best_so_far:
                best_so_far = new_candidate
                best_solution = clipped

        population = [best_solution] + [get_candidate() for _ in range(population_size - 1)]

    return best_solution
