def algorithm(func, dim, lb, ub, budget, rng):
    n = int(np.ceil(budget / (dim + 1)))
    
    pop_size = int((ub - lb) * 2)
    step = (ub - lb) / pop_size
    
    x_best = np.zeros(dim)
    f_best = float('inf')
    f_avg = float('inf')
    
    for _ in range(n):
        pop = rng.uniform(lb, ub, size=(pop_size, dim))
        
        for i in range(pop_size):
            if func(pop[i]) < f_best:
                x_best = pop[i]
                f_best = func(pop[i])
        
        step_size = 0.1 * (ub - lb) / np.sqrt(_ + 1)
        
        while _ < budget:
            mutated_pop = np.copy(pop)
            
            for i in range(pop_size):
                j = rng.randint(0, pop_size, size=dim)
                
                for k in range(dim):
                    if rng.random() < 0.5 and mutated_pop[i, k] + step_size * (pop[j, k] - pop[(j - 1) % pop_size, k]) > lb:
                        mutated_pop[i, k] += step_size * (pop[j, k] - pop[(j - 1) % pop_size, k])
                    elif rng.random() < 0.5 and mutated_pop[i, k] - step_size * (pop[j, k] - pop[(j - 1) % pop_size, k]) < ub:
                        mutated_pop[i, k] -= step_size * (pop[j, k] - pop[(j - 1) % pop_size, k])
            
            for i in range(pop_size):
                if func(mutated_pop[i]) < f_best and func(mutated_pop[i]) < func(x_best):
                    x_best = mutated_pop[i]
                    f_best = func(mutated_pop[i])
                
                if func(mutated_pop[i]) < f_avg:
                    f_avg = func(mutated_pop[i])
            
            pop = mutated_pop
            
            _ += 1
    
    return x_best
