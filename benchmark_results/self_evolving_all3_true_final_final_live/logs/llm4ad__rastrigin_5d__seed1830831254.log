def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lower, upper):
        return np.clip(candidate, lower, upper)

    pop_size = 50
    pop = rng.uniform(lb, ub, size=(pop_size, dim))
    best = None

    for _ in range(budget):
        fitness = func(pop)
        if best is None or np.min(fitness) < np.min(best):
            best = fitness

        r1, r2, r3 = rng.randint(0, pop_size, size=3)
        while r1 == r2 or r2 == r3 or r1 == r3:
            r1, r2, r3 = rng.randint(0, pop_size, size=3)

        mutation = 0.5 * (pop[r1] - pop[r2]) + 0.5 * (rng.uniform(lb, ub) * (pop[r3] - pop[r1]))
        new_pop = clip(pop + 0.1 * mutation, lb, ub)
        if rng.rand() < 0.05:
            idx = rng.randint(0, pop_size)
            new_pop[idx] = rng.uniform(lb, ub)

        pop = new_pop

    best_idx = np.argmin(func(pop))
    return pop[best_idx]
