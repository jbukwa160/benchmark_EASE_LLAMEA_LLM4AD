def algorithm(func, dim, lb, ub, budget, rng):
    candidates = np.random.uniform(lb, ub, size=(dim,))
    best_candidate = candidates.copy()
    
    for i in range(budget):
        candidate = candidates + rng.normal(0, 1, size=(dim,))
        clipped_candidate = np.clip(candidate, lb, ub)
        
        if func(clipped_candidate) < func(best_candidate):
            best_candidate = clipped_candidate
            candidates = clipped_candidate + rng.normal(0, 0.5, size=(dim,))
        else:
            probability = min(1, np.exp(-func(clipped_candidate) + func(best_candidate)))
            if rng.random() < probability:
                candidates = clipped_candidate
                
    return best_candidate
