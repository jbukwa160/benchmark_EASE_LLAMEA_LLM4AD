def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    current_best = np.zeros(dim)
    current_best_fitness = float('inf')
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        x_clipped = clip(x)
        new_fitness = func(x_clipped)
        
        if new_fitness < current_best_fitness:
            current_best = x_clipped
            current_best_fitness = new_fitness

        step_size = 0.01 + (ub - lb) * rng.uniform(0, 1)
        for i in range(dim):
            noise = rng.uniform(-1, 1)
            x[i] += noise * step_size
            x_clipped = clip(x)
            new_fitness = func(x_clipped)
            
            if new_fitness < current_best_fitness:
                current_best = x_clipped
                current_best_fitness = new_fitness
                
        # Adaptive cooling schedule
        sigma = (ub - lb) / np.sqrt(_ + 1)
        
    return current_best
