def algorithm(func, dim, lb, ub, budget, rng):
    if dim == 0:
        return np.zeros(1)

    best_x = None
    best_y = float('inf')

    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        y = func(x)

        if y < best_y:
            best_y = y
            best_x = x

        if np.random.rand() < 0.1:  # 10% chance of exploring new subspace
            indices_to_restart = rng.choice(dim, size=int(0.2*dim), replace=False)
            x[indices_to_restart] = rng.uniform(lb, ub, size=len(indices_to_restart))

    return best_x.clip(np.min, [lb]*dim, [ub]*dim)
