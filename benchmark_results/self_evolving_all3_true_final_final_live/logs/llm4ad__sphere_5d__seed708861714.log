def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    x = rng.uniform(lb, ub, size=dim)
    sigma = 1.0
    lambda_ = int(budget * (1 + np.sqrt(dim)) / dim)
    iteration = 0
    while iteration < budget:
        iteration += 1
        for _ in range(lambda_):
            x_trial = clip(x + rng.normal(0, sigma, size=dim))
            fitness_trial = func(x_trial)
            if fitness_trial < func(x):
                x = x_trial
        sigma *= np.exp(min(iteration / (budget + 2) - 1, 0.5))
    return x
