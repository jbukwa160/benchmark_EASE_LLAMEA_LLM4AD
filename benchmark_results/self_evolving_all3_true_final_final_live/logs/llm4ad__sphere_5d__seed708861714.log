def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        s = 0.5 * (ub - lb) * rng.randn(dim)
        y = x + s
        y = np.clip(y, lb, ub)
        fy = func(y)
        
        if fy < best_f:
            best_f = fy
            best_x = y.copy()

    return best_x
