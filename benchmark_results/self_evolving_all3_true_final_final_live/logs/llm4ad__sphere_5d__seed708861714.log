def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 10
    mu = np.zeros(dim)
    sigma = np.eye(dim) * 0.5
    best = np.inf
    while budget > 0 and best != 0:
        X = np.clip(rng.normal(loc=mu, scale=sigma, size=(pop_size, dim)), a_min=lb, a_max=ub)
        Y = func(X)
        for i in range(pop_size):
            if Y[i] < best:
                best = Y[i]
                mu = X[i]
                sigma[(sigma * 2) > 0] *= 1.01
                budget -= 1
    return np.clip(mu, a_min=lb, a_max=ub)
