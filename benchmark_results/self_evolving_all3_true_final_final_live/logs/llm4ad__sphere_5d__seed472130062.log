def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    candidates = np.random.uniform(lb, ub, (budget, dim))

    for i in range(budget - 1):
        scores = func(candidates[i])
        threshold = np.mean(scores) + rng * np.std(scores)
        
        new_candidates = []
        for candidate in candidates:
            score = func(candidate)
            if score < threshold:
                new_candidates.append(candidate)
        candidates = new_candidates
        
        if len(candidates) == 0:
            break
        
        candidates = np.vstack((candidates, clip(np.random.uniform(lb, ub, (1, dim)))))
    
    best_candidate = candidates[np.argmin(func(candidates))]
    return best_candidate
