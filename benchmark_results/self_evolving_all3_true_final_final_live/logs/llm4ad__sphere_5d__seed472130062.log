def algorithm(func, dim, lb, ub, budget, rng):
    T = 1000
    
    # Initialize population with random candidates within bounds
    pop_size = int(np.sqrt(budget))
    x = (ub - lb) * rng.random((pop_size, dim)) + lb
    f_x = func(x)
    
    # Simulated Annealing to find initial best candidate
    for _ in range(int(0.1 * budget)):
        idx = np.random.randint(pop_size)
        new_x = x[idx] + (ub - lb) * rng.uniform(-1, 1)
        new_f_x = func(new_x)
        
        if new_f_x < f_x[idx]:
            x[idx] = new_x
            f_x[idx] = new_f_x
            
    # Differential Evolution for global search
    for i in range(pop_size):
        for j in range(dim):
            idx1, idx2, idx3 = np.random.choice(range(pop_size), 3, replace=False)
            delta = (x[idx2, j] - x[idx3, j]) * rng.uniform(-1, 1) + x[i, j]
            new_x = x[i, j] + 0.5 * (delta - x[i, j])
            
            # Clip to bounds
            if lb <= new_x <= ub:
                x[i, j] = new_x
                f_x[i] = func(x[i])
        
        # Simulated Annealing for global search
        for _ in range(int(0.01 * budget)):
            idx = np.random.randint(pop_size)
            new_x = x[idx] + (ub - lb) * rng.uniform(-1, 1)
            
            if func(new_x) < f_x[idx]:
                x[idx] = new_x
                f_x[idx] = func(new_x)
    
    # Return best candidate found
    return x[np.argmin(f_x)]
