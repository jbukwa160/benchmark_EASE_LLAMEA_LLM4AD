def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = (ub - lb) * rng.rand(dim) + lb
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
    
    return best_x
