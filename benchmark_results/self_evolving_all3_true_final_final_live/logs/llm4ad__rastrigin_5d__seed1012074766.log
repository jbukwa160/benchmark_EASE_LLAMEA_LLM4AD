def algorithm(func, dim, lb, ub, budget, rng):
    best_x = rng.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    num_restarts = 0
    max_attempts = int(budget * 1.5)  # Allow for some overhead

    while True:
        attempts = 0
        for _ in range(int(max_attempts)):
            x = rng.uniform(lb, ub, size=dim)
            f = func(x)

            if f < best_f:
                best_x = x
                best_f = f
                num_restarts = 0

        if num_restarts >= int(budget / max_attempts):
            break

        num_restarts += 1

    return best_x
