def algorithm(func, dim, lb, ub, budget, rng):
    n = int(budget ** (1 / dim))
    pop_size = n * (n - 1) // 2 + n
    x_min = np.zeros(dim)
    x_max = np.ones(dim) * 1000.0

    for _ in range(pop_size):
        x = rng.uniform(lb, ub, size=dim)
        f_x = func(x)

        if f_x < func(x_min):
            x_min = x.copy()

        for i in range(dim):
            gradient = -2 * np.pi * 10 * np.sin(2 * np.pi * x[i])
            step_size = rng.uniform(-1, 1)
            new_x = x.copy()
            new_x[i] += step_size
            new_f_x = func(new_x)

            if new_f_x < f_x:
                x = new_x

        x_max[rng.uniform(0, dim) < 0.5] *= rng.uniform(-1, 1)
        x_min[rng.uniform(0, dim) < 0.5] *= rng.uniform(-1, 1)

    return np.clip(x_min, lb, ub)
