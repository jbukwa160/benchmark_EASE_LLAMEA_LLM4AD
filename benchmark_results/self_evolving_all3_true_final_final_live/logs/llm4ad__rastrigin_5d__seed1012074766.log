def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def f(x):
        return func(x)

    x = rng.uniform(lb, ub, size=(1, dim))
    best_x = x
    best_f = f(x)
    budget_used = 1

    while budget_used < budget:
        v = rng.normal(size=x.shape)
        for i in range(dim):
            v[:, i] *= np.abs(np.sin(2 * np.pi * x[:, i]))

        u = rng.uniform(lb, ub, size=(1, dim))
        z = clip(x + 0.5 * (v + u))

        f_z = f(z)
        budget_used += 1

        if f_z < best_f:
            best_x = z
            best_f = f_z

        x = np.where(rng.uniform(size=x.shape) < 0.1, clip(x + rng.normal(size=x.shape)), x)

    return best_x
