def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def generate_initial_population(dim, population_size):
        x = rng.uniform(-5, 5, (population_size, dim))
        return clip(x, lb, ub)

    def differential_evolution(population, func, dim, lb, ub, budget):
        for _ in range(budget):
            y = np.zeros((len(population), dim))
            for i in range(len(population)):
                r1, r2, r3 = rng.randint(0, len(population)), rng.randint(0, len(population)), rng.randint(0, len(population))
                if r1 != i and r2 != i and r3 != i:
                    x = population[r1] + 0.5 * (population[r2] - population[r3])
                    y[i] = clip(x, lb, ub)
            population[:] = func(y)
        return population

    def local_search(population, func, dim, lb, ub, budget):
        for _ in range(budget):
            for i in range(len(population)):
                x = rng.uniform(lb, ub, (dim,))
                y = func(clip(x, lb, ub))
                if y < population[i]:
                    population[i] = y
        return population

    def hybrid_de_local_search(func, dim, lb, ub, budget):
        initial_population = generate_initial_population(dim, 50)
        best_solution = differential_evolution(initial_population, func, dim, lb, ub, int(budget * 0.7))
        local_search(best_solution, func, dim, lb, ub, int(budget * 0.3))
        return np.min(best_solution)

    return hybrid_de_local_search(func, dim, lb, ub, budget).reshape(-1)
