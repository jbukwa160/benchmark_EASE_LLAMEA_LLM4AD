def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def rand_vec():
        return rng.uniform(lb, ub, size=dim)

    x_best = rand_vec()
    f_best = func(clip(x_best))

    step_size = 1e-3
    for _ in range(budget):
        x_new = clip(x_best + rng.normal(size=dim) * step_size)
        f_new = func(x_new)
        
        if f_new < f_best:
            x_best = x_new
            f_best = f_new
        
        step_size *= 0.9

    return x_best
