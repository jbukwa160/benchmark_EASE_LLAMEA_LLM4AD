def algorithm(func, dim, lb, ub, budget, rng):
    def sample_gaussian(mean, cov, num_samples=1):
        return np.random.multivariate_normal(mean, cov, size=num_samples)

    class Gaussian:
        def __init__(self, mean, cov):
            self.mean = mean
            self.cov = cov

    class GaussianMixtureModel:
        def __init__(self):
            self.components = []

        def add_component(self, component):
            self.components.append(component)

        def sample(self, num_samples=1):
            samples = np.zeros((num_samples, dim))
            for i in range(num_samples):
                samples[i] = np.random.choice(len(self.components), p=[c.prob for c in self.components])
                samples[i] += np.random.multivariate_normal(self.components[samples[i]].mean, self.components[samples[i]].cov)
            return samples

        def update_components(self, best_x, func_value):
            new_component = Gaussian(best_x, 0.1 * np.eye(dim))
            self.components.append(new_component)

    model = GaussianMixtureModel()
    best_x = np.random.uniform(lb, ub, size=dim)
    best_func_value = func(best_x)
    for i in range(budget):
        x = model.sample(100).mean(axis=0)
        x = (x - lb) / (ub - lb)
        x = rng.uniform(lb, ub, size=(1, dim))[0]
        func_value = func(x)
        if func_value < best_func_value:
            best_x = x
            best_func_value = func_value
            model.components = []
            model.add_component(Gaussian(best_x, 0.1 * np.eye(dim)))
        else:
            for j in range(len(model.components)):
                model.components[j].cov += 0.01 * np.eye(dim)
    return best_x
