def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = [random.uniform(lb, ub) for _ in range(dim)]
    f_best = func(clip(np.array(x_best)))
    step_size = 1.0

    for i in range(budget):
        if rng.random() < 0.5:
            x_new = clip([x_best[j] + rng.uniform(-step_size, step_size) for j in range(dim)])
        else:
            x_new = clip(np.array(x_best) + rng.uniform(-step_size, step_size, size=dim))

        f_new = func(clip(x_new))
        if f_new < f_best:
            x_best = x_new
            f_best = f_new

        if i % 100 == 0 and i > 0:
            step_size /= np.sqrt(rng.uniform(1.0, 2.0))

    return np.array(x_best)
