def algorithm(func, dim, lb, ub, budget, rng):
    def gp_model(x_train, y_train):
        from scipy.stats import norm
        from sklearn.gaussian_process import GaussianProcessRegressor
        from sklearn.gaussian_process.kernels import Matern
        
        kernel = Matern(n_jobs=-1)
        gpr = GaussianProcessRegressor(kernel=kernel, n_restarts_optimizer=9)
        gpr.fit(x_train, y_train)
        
        def predict_mean(x):
            return np.mean(gpr.predict(np.atleast_2d(x).T), axis=0)
        
        def predict_std(x):
            return np.std(gpr.predict(np.atleast_2d(x).T), axis=0)
        
        def sample_gp(x, sigma):
            return np.random.normal(predict_mean(x), predict_std(x) * sigma)
        
        return predict_mean, predict_std, sample_gp
    
    def ei(sample_gp, x_best, mean_func, std_func, sigma):
        mu = mean_func(x_best)
        std = std_func(x_best)
        z = (sample_gp - mu) / std
        phi = norm.cdf(z)
        eta = np.exp(-((z**2)/2))
        return (phi * std + eta * sample_gp - mu)
    
    x_best = lb + rng.uniform(0, 1) * (ub - lb)
    y_best = func(x_best)
    budget -= 1
    x_train = [x_best]
    y_train = [y_best]
    
    while budget > 0:
        mean_func, std_func, sample_gp = gp_model(np.array(x_train), np.array(y_train))
        sigma = 1e-5
        
        def ei_wrapper(x):
            return -ei(sample_gp, x_best, mean_func, std_func, sigma)
        
        for _ in range(1000):
            x_new = lb + rng.uniform(0, 1) * (ub - lb)
            
            try:
                y_new = func(x_new)
                
                if y_new < y_best:
                    x_best = x_new
                    y_best = y_new
                    
                x_train.append(x_best)
                y_train.append(y_best)
                
                mean_func, std_func, sample_gp = gp_model(np.array(x_train), np.array(y_train))
                sigma *= 1e-5
                
            except Exception as e:
                continue
        
        budget -= 1
    
    return x_best
