def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = lb + (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    best_f = func(x)
    
    alpha = 0.1
    cooling_rate = 0.999
    
    for _ in range(budget):
        new_x = clip(x + alpha * rng.randn(dim))
        
        if np.random.rand() < 0.5:
            # Random search
            new_x = clip(lb + (ub - lb) * rng.rand(dim))
            
        f_new = func(new_x)
        if f_new < best_f:
            x = new_x
            best_x = new_x
            best_f = f_new
            
        else:
            delta = f_new - best_f
            prob = np.exp(-delta / (10 * alpha))
            if rng.rand() < prob or rng.rand() < 0.01:
                x = new_x
                
    return best_x
