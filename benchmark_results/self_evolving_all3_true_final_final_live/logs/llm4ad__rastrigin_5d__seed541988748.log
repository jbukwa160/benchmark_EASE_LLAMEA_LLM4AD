def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_individual():
        return rng.uniform(lb, ub, size=dim)

    def evaluate(individual):
        return func(clip(individual))

    def selection(population, fitnesses):
        sorted_indices = np.argsort(fitnesses)
        selected_indices = sorted_indices[:int(len(sorted_indices)/2)]
        return population[selected_indices]

    def crossover(parent1, parent2):
        child = 0.5 * (parent1 + parent2)
        return child

    def mutation(child, rng):
        mask = rng.uniform(0, 1, size=dim) < 0.01
        mutated_child = np.where(mask, child + 1e-6*rng.normal(size=len(child)), child)
        return clipped_mutated_child

    def clip_and_mutate(individual):
        clipped_individual = clip(individual)
        mutated_individual = individual + 1e-6 * rng.normal(size=dim)
        return np.clip(mutated_individual, lb, ub)

    population_size = int(budget / (func.__name__ == 'Rastrigin'))
    population = [generate_individual() for _ in range(population_size)]

    fitnesses = [evaluate(individual) for individual in population]
    best_individual = population[np.argmin(fitnesses)]

    for generation in range(1, budget):
        selected_population = selection(population, fitnesses)
        offspring = []

        while len(offspring) < population_size:
            parent1 = selected_population[rng.integers(len(selected_population))]
            parent2 = selected_population[rng.integers(len(selected_population))]
            child = crossover(parent1, parent2)
            mutated_child = clip_and_mutate(child)
            offspring.append(mutated_child)

        population = [individual for individual in selected_population + offspring]
        fitnesses = [evaluate(individual) for individual in population]

        best_individual = np.argmin(fitnesses)
        if evaluate(population[best_individual]) < 1e-6:
            break

    return population[best_individual]
