def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def sample_candidate(mean, sigma):
        return mean + sigma * rng.randn(dim)

    def local_search(candidate, mean, sigma):
        for _ in range(1000):
            candidate = clip(sample_candidate(mean, sigma))
            if func(candidate) < func(mean):
                mean = candidate
                sigma *= 1.01
            else:
                sigma /= 1.1
                if sigma < 1e-3:
                    break
        return mean

    def cma_es():
        mean = rng.uniform(lb, ub, dim)
        sigma = 0.5 * (ub - lb) / np.sqrt(dim)
        for _ in range(budget):
            candidate = clip(sample_candidate(mean, sigma))
            if func(candidate) < func(clip(local_search(candidate, mean, sigma))):
                mean = candidate
                sigma *= 1.01
        return local_search(mean, mean, sigma)

    best_candidate = cma_es()
    return best_candidate
