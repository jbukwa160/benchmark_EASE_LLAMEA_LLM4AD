def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidates(mu, sigma):
        candidates = mu + sigma * rng.normal(size=(pop_size, dim))
        return np.array([clip(c) for c in candidates])

    x_best = None
    f_best = float('inf')

    pop_size = 1
    sigma = 5.0

    for i in range(budget):
        if i > 10:
            pop_size *= 2
            sigma /= 2

        mu = np.zeros(dim)
        candidates = generate_candidates(mu, sigma)

        fs = [func(c) for c in candidates]

        idx_best = np.argmin(fs)
        f_candidate = fs[idx_best]
        x_candidate = clip(candidates[idx_best])

        if f_candidate < f_best:
            f_best = f_candidate
            x_best = x_candidate

    return x_best
