def algorithm(func, dim, lb, ub, budget, rng):
    n = 10  # initial population size
    pop_size = n * (dim + 1)
    x = np.zeros((pop_size, dim))
    for i in range(pop_size):
        x[i] = lb + (ub - lb) * rng.rand(dim)

    for _ in range(budget):
        F = 0.5  # scaling factor
        CR = 0.9  # crossover probability

        pop_new = np.copy(x)
        for i in range(pop_size):
            idx1, idx2, idx3 = rng.choice(range(pop_size), 3, replace=False)

            u = x[idx1] + F * (x[idx2] - x[idx3])
            for j in range(dim):
                if rng.rand() < CR or abs(u[j]) > 0.01:
                    pop_new[i][j] = min(max(u[j], lb), ub)
                else:
                    pop_new[i][j] = x[i][j]

        x = pop_new

    idx_best = np.argmin([func(xi) for xi in x])
    return x[idx_best]
