def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    max_steps = budget // pop_size
    sigma = 0.1
    alpha = 0.01
    beta = 2.0

    x_best = None
    f_best = np.inf

    for _ in range(max_steps):
        pop = rng.uniform(lb, ub, size=(pop_size, dim))
        f_pop = func(pop)

        y_best = pop[np.argmin(f_pop)]
        f_y_best = np.min(f_pop)

        if f_y_best < f_best:
            x_best = y_best
            f_best = f_y_best

        s = rng.normal(size=dim, loc=0.0, scale=sigma)
        for i in range(pop_size):
            x_new = pop[i] + alpha * s
            x_new = np.clip(x_new, lb, ub)

            f_new = func(np.array([x_new]))

            if f_new < f_y_best:
                y_best = x_new
                f_y_best = f_new

        sigma *= beta

    return x_best
