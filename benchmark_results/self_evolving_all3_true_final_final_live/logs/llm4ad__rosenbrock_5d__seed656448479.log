def algorithm(func, dim, lb, ub, budget, rng):
    num_dim = dim
    initial_temp = 1000
    cooling_rate = 1 - (1 / (budget + 1))
    pop_size = int(np.sqrt(budget) * 2)
    
    X = np.random.uniform(lb, ub, [pop_size, num_dim])
    T = initial_temp
    
    for _ in range(1, budget):
        new_X = X.copy()
        
        for i in range(pop_size):
            p1, p2, p3 = rng.choice(range(pop_size), 3, replace=False)
            mutant = X[p1] + 0.5 * (X[p2] - X[p3])
            
            if np.random.uniform(0, 1) < 0.01:
                new_X[i] += np.random.normal(0, initial_temp / (budget + 1), num_dim)
            else:
                trial = mutant
                for j in range(num_dim):
                    delta = np.clip(trial[j], lb, ub) - X[i][j]
                    if delta != 0 and rng.uniform(0, 1) < abs(delta) / initial_temp:
                        trial[j] += rng.normal(0, initial_temp / (budget + 1))
                new_X[i] = trial
        
        new_X = np.clip(new_X, lb, ub)
        
        f_values_new = func(new_X)
        f_values_best = func(X)
        
        for i in range(pop_size):
            if f_values_new[i] < f_values_best[i]:
                X[i] = new_X[i]
                f_values_best[i] = f_values_new[i]
        
        if np.mean(f_values_best) < initial_temp / (budget + 1):
            T *= cooling_rate
            initial_temp = min(initial_temp, np.mean(f_values_best))
    
    return X[np.argmin(func(X))]
