def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(clip(x_best))

    x_current = x_best.copy()
    for _ in range(budget):
        n_samples = 5
        while True:
            # Sample new points around the current best point
            step_sizes = np.abs(rng.uniform(-1, 1, size=dim))
            sample_points = clip(x_best + rng.normal(0, step_sizes, size=(n_samples, dim)))

            # Evaluate function at sampled points and get the best one
            f_values = func(sample_points)
            next_point_idx = np.argmin(f_values)

            if f_values[next_point_idx] < f_best:
                x_best = sample_points[next_point_idx]
                f_best = f_values[next_point_idx]

            if rng.uniform(0, 1) > 0.8 or _ == budget - 1:  # 20% chance to accept new point
                break

        x_current = x_best.copy()

    return clip(x_best)
