def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        x = np.clip(x, lb, ub)
        return func(x)

    # initialization
    mean = np.zeros(dim)
    sigma = 2.
    lambda_ = int(np.ceil(4 + 3 * dim**0.5))
    mu = lambda_ // 2
    weights = np.ones(lambda_) / lambda_
    weights[:mu] *= 1 + 2 * (np.arange(mu) % 2)
    cov = np.eye(dim)

    best = None

    for i in range(budget):
        # sampling
        z = np.random.randn(lambda_, dim)
        x = mean + sigma * np.dot(z, cov)
        
        # evaluation and update
        y = evaluate(x)
        
        if best is None or y < evaluate(best):
            best = x
        
        # covariance update
        f_best = evaluate(best)
        for j in range(lambda_):
            delta = (x[j] - mean) / sigma
            old_cov = cov.copy()
            cov += np.dot(delta, delta.T) * 1/(lambda_-mu)
            if rng.random() < 0.05:
                cov = old_cov
                weights[j] *= 2
        # reweighting
        weights /= sum(weights)

    return best
