def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    mut_rate = 0.1
    cr = 0.9
    best_x = None
    best_y = float('inf')

    for _ in range(budget):
        pop = np.random.uniform(lb, ub, (pop_size, dim))
        pop[np.arange(pop_size), rng.choice(dim, size=pop_size)] += mut_rate

        for x in pop:
            y = func(x)
            if y < best_y:
                best_x = x
                best_y = y

        pop = np.clip(pop, lb, ub)

    return best_x
