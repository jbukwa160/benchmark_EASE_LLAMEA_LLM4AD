def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    def clip(x):
        return np.clip(x, lb, ub)

    pop = rng.uniform(lb, ub, (budget, dim))
    x_best = pop[np.argmin([f(clip(x)) for x in pop])]

    T0 = 1.0
    alpha = 0.99

    for t in range(budget - 1):
        v = clip(pop[rng.randint(0, budget)] + rng.uniform(-1, 1) * (pop[rng.randint(0, budget)] - pop[rng.randint(0, budget)]))
        u = x_best + rng.uniform(-1, 1) * v
        new_x = np.where(rng.uniform(size=dim) < 0.5, u, x_best)

        if f(clip(new_x)) < f(clip(x_best)):
            x_best = new_x

        T = alpha * T0 * (budget - t) ** 2 / budget
        if rng.uniform() < np.exp((f(clip(x_best)) - f(clip(new_x))) / T):
            x_best = new_x

    return x_best
