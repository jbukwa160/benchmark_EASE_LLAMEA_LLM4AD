def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=(dim,))
    T = 1e3
    alpha = 0.99
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        new_x = clip(x + rng.normal(size=x.shape) * 5e-2)
        
        f_new = func(new_x)
        delta = f_new - best_f
        
        if delta < 0:
            x = new_x
            best_x = new_x
            best_f = f_new
        else:
            prob = np.exp(-delta / T)
            if rng.uniform(0, 1) < prob:
                x = new_x
                
        T *= alpha
        
    return best_x
