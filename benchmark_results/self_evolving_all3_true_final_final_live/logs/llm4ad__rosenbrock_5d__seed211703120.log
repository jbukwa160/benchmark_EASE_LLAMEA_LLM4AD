def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = int(1.2 * (budget ** (1 / 3)))
    num_offsprings = int(budget / 10)
    
    # Initialization
    x0 = np.zeros((pop_size, dim))
    for i in range(pop_size):
        x0[i] = clip(lb + rng.rand(dim) * (ub - lb))

    # Differential Evolution (DE) optimization with adaptive strategy selection
    strategies = ['rand1exp', 'best1exp', 'rand2exp']
    de_strategy = rng.choice(strategies)
    
    for t in range(budget):
        if de_strategy == 'rand1exp':
            F = 0.5 + 0.3 * np.random.rand(pop_size)
            v = x0[rng.randint(0, pop_size), :] + F * (x0[rng.randint(0, pop_size), :] - x0[rng.randint(0, pop_size), :])
        elif de_strategy == 'best1exp':
            best_idx = np.argmin([func(x) for x in x0])
            v = x0[best_idx] + 2 * rng.rand(dim)
        else:
            F = 0.5
            r1 = rng.randint(0, pop_size)
            r2 = rng.randint(0, pop_size)
            r3 = rng.randint(0, pop_size)
            v = x0[r1] + F * (x0[r2] - x0[r3])

        x0[rng.randint(0, pop_size), :] = clip(v)

    # Replacement
    for _ in range(num_offsprings):
        idx = np.argmin([func(x) for x in x0])
        x0[idx] = clip(x0[idx] + 2 * rng.rand(dim))

    return np.min([x for x in x0 if func(clip(x)) < budget], key=lambda x: func(clip(x)))
