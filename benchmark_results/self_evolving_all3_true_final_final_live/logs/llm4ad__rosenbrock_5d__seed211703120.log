def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def mutate(x, std_dev):
        noise = rng.normal(size=x.shape)
        return x + std_dev * noise

    def local_search(x0, func, dim, lb, ub, max_evals=100, tol=1e-6):
        x = np.copy(x0)
        for _ in range(max_evals):
            dx = rng.uniform(-tol, tol, size=(dim,))
            new_x = clip(x + dx, lb, ub)
            if func(new_x) < func(x):
                x = new_x
        return x

    pop_size = 100
    std_dev = 1.0
    offspring_size = int(pop_size * 0.2)

    population = rng.uniform(lb, ub, size=(pop_size, dim))
    fitnesses = np.array([func(x) for x in population])

    for _ in range(budget):
        parents = np.argsort(fitnesses)[:offspring_size]
        offspring = []
        for i in parents:
            parent1 = population[i]
            child = mutate(parent1, std_dev)
            offspring.append(child)

        population[offspring_size:] = np.array(offspring)
        fitnesses[offspring_size:] = np.array([func(x) for x in population[offspring_size:]])

        new_population = []
        for i in range(pop_size):
            parent1_idx = rng.choice(parents, p=np.array(fitnesses[:offspring_size])/np.sum(fitnesses[:offspring_size]))
            parent2_idx = rng.choice(parents, p=np.array(fitnesses[:offspring_size])/np.sum(fitnesses[:offspring_size]))
            if rng.uniform(0, 1) < 0.5:
                child = (population[parent1_idx] + population[parent2_idx]) / 2
            else:
                child = mutate((population[parent1_idx] + population[parent2_idx]) / 2, std_dev)
            new_population.append(child)

        population[:] = np.array(new_population)
        fitnesses[:] = np.array([func(x) for x in population])

    best_x = local_search(np.mean(population, axis=0), func, dim, lb, ub)
    return clip(best_x, lb, ub)
