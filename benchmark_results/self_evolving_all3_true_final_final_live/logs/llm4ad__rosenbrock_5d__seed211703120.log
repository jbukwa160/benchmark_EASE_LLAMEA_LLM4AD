def algorithm(func, dim, lb, ub, budget, rng):
    def surrogate(x):
        return 1e9 * (np.random.rand() - 0.5)

    def sample_lhs(bounds, num_samples):
        samples = np.zeros((num_samples, len(bounds)))
        for i in range(len(bounds)):
            samples[:, i] = bounds[i][0] + (bounds[i][1] - bounds[i][0]) * rng.uniform(0, 1, size=num_samples)
        return samples

    def get_candidate(bounds, surrogate):
        x = sample_lhs(bounds, 1)[0]
        f_x = func(x)
        surrogate(x, f_x)
        return x, f_x

    bounds = [(lb, ub) for _ in range(dim)]
    candidate, best_candidate, best_f = None, None, 1e9
    num_candidates = 0

    while budget > 0:
        if num_candidates == 0 or rng.uniform(0, 1) < 0.5:
            x, f_x = get_candidate(bounds, surrogate)
            candidate, num_candidates = x, 1
        else:
            candidates = sample_lhs(bounds, budget * dim)
            for x in candidates:
                f_x = func(x)
                if f_x < best_f:
                    best_candidate, best_f = x, f_x
                    candidate, num_candidates = best_candidate, 0
                num_candidates += 1

        budget -= 1
        surrogate(candidate, func(candidate))

    return np.clip(best_candidate, lb, ub)
