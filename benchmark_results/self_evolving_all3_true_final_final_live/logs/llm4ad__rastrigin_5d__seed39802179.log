def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(rng, dim, pop_size):
        return rng.uniform(lb, ub, size=(pop_size, dim))

    def differential_evolution(population, func, dim, lb, ub, budget):
        while budget > 0:
            for i in range(len(population)):
                mutation_index = np.random.choice(range(len(population)), replace=False)
                trial = population[i] + rng.uniform(-1, 1) * (population[mutation_index] - population[i])
                trial = clip(trial)
                if func(trial) < func(population[i]):
                    population[i] = trial
            budget -= 1
        return population

    def particle_swarm_optimization(population, func, dim, lb, ub):
        while True:
            for i in range(len(population)):
                x_best = np.argmax([func(individual) for individual in population])
                v = rng.uniform(-1, 1)
                if func(population[i] + v * (population[x_best] - population[i])) < func(population[i]):
                    population[i] = population[i] + v * (population[x_best] - population[i])
            if np.all(np.diff([func(individual) for individual in population]) == 0):
                break
        return population

    def hybrid_algorithm(func, dim, lb, ub, budget, rng):
        population_size = int(np.ceil(budget ** (1/3)))
        population = generate_initial_population(rng, dim, population_size)
        de_budget = int(2/3 * budget)
        pso_budget = int(1/3 * budget)

        population = differential_evolution(population, func, dim, lb, ub, de_budget)
        population = particle_swarm_optimization(population, func, dim, lb, ub)
        return np.argmin([func(individual) for individual in population])

    best_individual_index = hybrid_algorithm(func, dim, lb, ub, budget, rng)
    return generate_initial_population(rng, dim, 1)[best_individual_index]
