def algorithm(func, dim, lb, ub, budget, rng):
    def rastrigin(x):
        return func(np.array([x]))

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def l2_norm(x):
        return np.linalg.norm(x)

    def generate_random_solution(dim):
        x = rng.uniform(lb, ub, size=dim)
        return x

    def differential_evolution(pop_size, max_iter, cr, f):
        pop = [generate_random_solution(dim) for _ in range(pop_size)]
        best_x = np.zeros(dim)

        for _ in range(max_iter):
            for i in range(pop_size):
                x1, x2, x3 = rng.choice(pop, 3, replace=False)
                v = cr * (x2 - x1) + (1 - cr) * (x3 - x1)
                candidate = clip(x1 + v, lb, ub)
                if f(candidate) < f(best_x):
                    best_x = candidate

        return best_x

    def simulated_annealing(pop_size, max_iter, T0, cooling_rate):
        pop = [generate_random_solution(dim) for _ in range(pop_size)]
        best_x = np.zeros(dim)

        for _ in range(max_iter):
            for i in range(pop_size):
                x1, x2 = rng.choice(pop, 2, replace=False)
                candidate = clip(x1 + rng.uniform(-T0, T0, size=dim), lb, ub)
                dE = f(candidate) - f(best_x)

                if dE < 0 or rng.rand() < np.exp(-dE / (T0 * cooling_rate)):
                    best_x = candidate

        return best_x

    def hybrid_algorithm(budget):
        pop_size = int(np.sqrt(budget))
        max_iter = budget // pop_size
        cr = 0.5
        T0 = 10
        cooling_rate = 1e-4

        for _ in range(max_iter):
            x1, x2, best_x = differential_evolution(pop_size, max_iter, cr, rastrigin)
            if rastrigin(best_x) < rastrigin(x1) or rastrigin(best_x) < rastrigin(x2):
                best_x = np.array([best_x])

        T = T0
        for _ in range(max_iter):
            x1, best_x = simulated_annealing(pop_size, max_iter, T, cooling_rate)
            if rastrigin(best_x) < rastrigin(x1):
                best_x = np.array([best_x])
            T *= (1 - cooling_rate)

        return best_x

    return hybrid_algorithm(budget)[0]
