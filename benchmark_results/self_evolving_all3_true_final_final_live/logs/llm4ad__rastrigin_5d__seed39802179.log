def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    D = dim
    N = int(budget / pop_size)
    G = N
    Cr = 0.9
    F = 0.5
    
    x = np.random.uniform(lb, ub, (pop_size, D))
    
    for g in range(G):
        y = np.copy(x)
        
        for i in range(pop_size):
            r1, r2, r3 = rng.choice(pop_size, size=3, replace=False)
            
            if rng.rand() < Cr:
                z = x[r1] + F * (x[r2] - x[r3])
                
                for j in range(D):
                    if rng.rand() < 0.5:
                        z[j], x[i][j] = x[i][j], z[j]
                    
                y[i] = z
            
            else:
                y[i] = x[i]
        
        f_y = np.array([func(yi) for yi in y])
        f_x = func(x)
        
        mask = (f_y < f_x) & (y >= lb) & (y <= ub)
        
        if np.any(mask):
            x[mask] = y[mask]
    
    return x[np.argmin(func(x))][np.newaxis, :]
