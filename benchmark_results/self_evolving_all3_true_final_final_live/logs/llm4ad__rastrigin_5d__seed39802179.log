def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Adaptive radius of exploration and exploitation
        r_explore = (ub - lb) * 0.1 + 0.9 * (ub - lb) / np.sqrt(1 + rng.uniform(-10, 10))

        noise = rng.uniform(-r_explore, r_explore, size=dim)
        new_x = x + noise
        new_x = np.clip(new_x, lb, ub)

        # Probabilistic hill climbing
        prob_exploit = (ub - lb) / (ub - lb) * 0.5 + 0.3 * rng.uniform(-10, 10)
        if rng.rand() < prob_exploit:
            new_f = func(new_x)
        else:
            new_f = best_f

        # Update best solution
        if new_f < best_f:
            best_f = new_f
            best_x = new_x.copy()

        x = new_x.copy()

    return best_x
