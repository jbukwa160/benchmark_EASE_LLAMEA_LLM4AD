def algorithm(func, dim, lb, ub, budget, rng):
    def wrapper(x):
        return func(np.array([x]))

    bounds = [(lb, ub) for _ in range(dim)]
    result = differential_evolution(wrapper, bounds, maxiter=budget)

    best_x = np.clip(result.x, a_min=lb, a_max=ub)
    if not np.allclose(func(best_x), 0):
        # Local search
        local_budget = int(0.1 * budget)
        def wrapper(x):
            return func(np.array([x]))

        bounds = [(lb, ub) for _ in range(dim)]
        result = differential_evolution(wrapper, bounds, maxiter=local_budget)

        best_x = np.clip(result.x, a_min=lb, a_max=ub)
    return best_x
