def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = len(dim)
    x_best = np.array([rng.uniform(lb[i], ub[i]) for i in range(D)])
    f_best = func(clip(x_best))
    
    for _ in range(budget - 1):
        for i in range(D):
            x = clip(np.copy(x_best))
            v = rng.normal(size=D)
            while np.any(v < -3) or np.any(v > 3):
                v = rng.normal(size=D)
            u = np.array([rng.uniform(0, 1) if j != 2 else 0.5 for j in range(D)])
            x[i] += 0.01 * (ub[i] - lb[i]) * u[i] + (ub[i] - lb[i]) * v[i]
            f = func(clip(x))
            
            if f < f_best:
                f_best = f
                x_best = np.copy(x)
    
    return x_best
