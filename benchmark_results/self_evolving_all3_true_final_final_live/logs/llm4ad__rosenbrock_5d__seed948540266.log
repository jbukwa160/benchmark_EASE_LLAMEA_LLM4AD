def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def cma_es_step(x, step_size, popsize):
        x_new = x + rng.normal(size=(popsize, dim)) * step_size
        x_new = clip(x_new)
        f_values = [func(x) for x in x_new]
        sorted_indices = np.argsort(f_values)
        return x_new[sorted_indices[:popsize]]

    def simulated_annealing_step(x, T):
        delta_f = rng.uniform(-1, 1)
        new_x = clip(x + rng.normal(size=dim) * (delta_f / T))
        if func(new_x) < func(x):
            return new_x
        else:
            p = np.exp((func(x) - func(new_x)) / T)
            return new_x if rng.uniform(0, 1) < p else x

    def objective(x):
        return func(x)

    x = lb + (ub - lb) * rng.random(size=dim)
    step_size = 0.5
    popsize = 50
    T = 100
    t = 0
    while t < budget:
        x_new = cma_es_step(x, step_size, popsize)
        if objective(x_new) < objective(x):
            x = x_new
        t += 1
        step_size *= 0.99
        T *= 0.999

        for _ in range(popsize):
            new_x = simulated_annealing_step(x, T)
            if objective(new_x) < objective(x):
                x = new_x

    return x
