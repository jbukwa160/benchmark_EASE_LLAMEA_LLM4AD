def algorithm(func, dim, lb, ub, budget, rng):
    x = (np.random.uniform(lb, ub, dim)).astype(np.float32)
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        step_size = 0.01 / (1 + i / budget)
        x_try = x + np.clip(rng.normal(0, step_size, size=dim), -step_size * 2, step_size * 2).astype(np.float32)
        try_x = np.clip(x_try, lb, ub)

        f_try = func(try_x)
        
        if f_try < best_f:
            best_f = f_try
            best_x = try_x

        x = (best_x + rng.normal(0, 1e-3, size=dim)).astype(np.float32)
        x = np.clip(x, lb, ub)

    return best_x
