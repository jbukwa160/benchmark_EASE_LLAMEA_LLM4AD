def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(budget, dim, lb, ub, rng):
        population = rng.uniform(lb, ub, size=(budget, dim))
        return population

    def simplex_search(population, func, dim, lb, ub, budget):
        current_best = np.inf
        for i in range(budget):
            candidate = population[i]
            candidate[0] += 1e-3 * rng.uniform(-1, 1)
            value = func(candidate)
            if value < current_best:
                current_best = value
        return current_best

    def genetic_algorithm(population, func, dim, lb, ub, budget):
        for _ in range(budget):
            population = np.array([clip(p, lb, ub) for p in population])
            values = [func(p) for p in population]
            indices = np.argsort(values)
            population = population[indices[:budget//2]]
            new_population = np.zeros((budget // 2, dim))
            for i in range(budget // 2):
                p1 = population[i]
                p2 = population[(i + 1) % (budget // 2)]
                child = p1 + rng.uniform(-1, 1) * (p2 - p1)
                new_population[i] = clip(child, lb, ub)
            population = np.concatenate((population, new_population))
        return population

    def simulate_annealing(population, func, dim, lb, ub, budget):
        T = 1000
        for _ in range(budget):
            T *= 0.99
            indices = np.random.choice(len(population), size=2, replace=False)
            p1 = population[indices[0]]
            p2 = population[indices[1]]
            child = p1 + rng.uniform(-1, 1) * (p2 - p1)
            value = func(clip(child, lb, ub))
            if np.random.rand() < np.exp((func(p1) - value) / T):
                population[indices[0]] = child

    def crossover(parents, budget, rng):
        children = np.zeros((budget, dim))
        for i in range(budget):
            p1 = parents[i % len(parents)]
            p2 = parents[(i + 1) % len(parents)]
            child = p1 + rng.uniform(-1, 1) * (p2 - p1)
            children[i] = clip(child, lb, ub)
        return children

    def mutation(children, budget, rng):
        for i in range(budget):
            children[i] += rng.uniform(-1e-3, 1e-3)

    population = generate_initial_population(budget, dim, lb, ub, rng)
    simplex_search(population, func, dim, lb, ub, budget // 10)
    genetic_algorithm(population, func, dim, lb, ub, (budget * 9) // 10)
    for _ in range((budget * 1)// 10):
        simulate_annealing(population, func, dim, lb, ub, (budget * 1) // 10)
    best_candidate = population[np.argmin([func(clip(c, lb, ub)) for c in population])]
    return clip(best_candidate, lb, ub)
