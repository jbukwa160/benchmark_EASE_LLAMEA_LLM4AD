def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_y = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        # Iterative Local Search
        y = func(x)
        if y < best_y:
            best_y = y
            best_x = x
            
        for _ in range(1000):  # Number of iterations for local search
            idx = rng.choice(dim)
            
            # Perturb the current solution by making a random swap
            x[idx] += rng.uniform(-1, 1)
            x = np.clip(x, lb, ub)  # Clip to bounds
            
            y = func(x)
            if y < best_y:
                best_y = y
                best_x = x
                
    return best_x
