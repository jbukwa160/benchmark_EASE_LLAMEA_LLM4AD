def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(x):
        return (ub - lb) * x + lb
    
    def rastrigin(x):
        return func(x) if isinstance(func, str) else func(x)
    
    N = 50
    T = 1000.0
    tau = 0.99
    C = 1e-3
    best_x = np.zeros(dim)
    best_f = float('inf')
    x = rng.uniform(-5, 5, dim)
    
    for i in range(budget):
        f = rastrigin(x)
        
        if f < best_f:
            best_f = f
            best_x = x.copy()
        
        v1 = get_candidate(rng.uniform(0, 1, dim))
        v2 = get_candidate(rng.uniform(0, 1, dim))
        v3 = get_candidate(rng.uniform(0, 1, dim))
        
        y = x + C * (v1 - x) + C * (v2 - x)
        y = np.clip(y, lb, ub)
        
        f_new = rastrigin(y)
        
        if f_new < f:
            x = y
        else:
            u = rng.uniform(0, 1)
            if u <= np.exp(-(f_new - f) / T):
                x = y
        
        T *= tau
    
    return best_x
