def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(np.clip(x, lb, ub))

    x_best = np.zeros(dim)
    f_best = float('inf')
    T = 0.1
    N = int(budget / dim)

    for i in range(N):
        x_candidate = np.array([lb + (ub - lb) * rng.uniform() for _ in range(dim)])
        f_candidate = f(x_candidate)
        
        delta_f = f_candidate - f_best
        
        if delta_f < 0:
            f_best = f_candidate
            x_best = x_candidate
        else:
            prob = np.exp(-delta_f / T)
            r = rng.uniform()
            
            if r < prob:
                f_best = f_candidate
                x_best = x_candidate
                
            T *= 0.99  # adaptive temperature schedule

    return x_best
