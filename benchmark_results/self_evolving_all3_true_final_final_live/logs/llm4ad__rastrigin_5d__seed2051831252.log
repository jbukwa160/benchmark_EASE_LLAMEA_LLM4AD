def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget - 1):
        F = np.random.normal(0, 1, size=dim)
        y = x + 0.5 * (ub - lb) * F
        y = np.clip(y, lb, ub)
        
        F2 = rng.uniform(size=(1, dim))
        z = best_x + 0.5 * (ub - lb) * F2
        z = np.clip(z, lb, ub)
        
        y_new = 0.7 * y + 0.3 * z
        
        f_y = func(y)
        f_z = func(z)
        f_y_new = func(y_new)
        
        if f_y_new < best_f:
            x = y_new
            best_x = x.copy()
            best_f = f_y_new
            
    return best_x[0]
