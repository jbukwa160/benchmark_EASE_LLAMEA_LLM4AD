def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x0 = np.zeros(dim)
    pop_size = 50
    lambda_ = int(pop_size * 0.2)
    mu = lambda_
    c1 = 1 + (ub - lb) / 5

    def f(x):
        return func(clip(x))

    def get_child(parent, sigma):
        child = parent + rng.normal(size=dim) * sigma
        if np.random.rand() < 0.05:
            child += np.random.uniform(-c1, c1, size=dim)
        return child

    x = [x0 + rng.normal(size=dim)]
    fvals = [f(x[-1])]

    for _ in range(budget):
        if len(x) > mu:
            del x[0]
            del fvals[0]

        sigma = np.mean([np.linalg.norm(xi - x0) for xi in x])

        for i in range(lambda_):
            child = get_child(np.random.choice(x, p=np.array(fvals)/sum(fvals)), sigma)
            fx = f(child)

            if fx < min(fvals):
                x.append(child)
                fvals.append(fx)

    return np.array(min(x, key=f))
