def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_fval = f(x)
    pop_size = 50
    population = np.zeros((pop_size, dim))
    pop_best_x = np.zeros((pop_size, dim))
    pop_best_fval = np.zeros(pop_size)

    for i in range(budget):
        for j in range(pop_size):
            u = rng.uniform(0, 1)
            v = rng.uniform(0, 1)
            w = rng.uniform(0, 1)
            trial_x = clip(x + u * (best_x - x) + v * (population[j] - x) + w * (ub - lb), lb, ub)
            trial_fval = f(trial_x)

            if trial_fval < pop_best_fval[j]:
                population[j] = trial_x.copy()
                pop_best_fval[j] = trial_fval
                pop_best_x[j] = trial_x.copy()

        for k in range(pop_size):
            r1, r2, r3 = np.random.choice(range(pop_size), 3, replace=False)
            if f(pop_best_x[r1]) < f(pop_best_x[r2]):
                x1 = pop_best_x[r1].copy()
            else:
                x1 = pop_best_x[r2].copy()

            if f(pop_best_x[r3]) < f(x1):
                x1 = pop_best_x[r3].copy()

            u = rng.uniform(0, 1)
            v = rng.uniform(0, 1)
            w = rng.uniform(0, 1)
            trial_x = clip(x + u * (best_x - x) + v * (x1 - x) + w * (ub - lb), lb, ub)
            trial_fval = f(trial_x)

            if trial_fval < best_fval:
                best_x = trial_x.copy()
                best_fval = trial_fval

    return best_x
