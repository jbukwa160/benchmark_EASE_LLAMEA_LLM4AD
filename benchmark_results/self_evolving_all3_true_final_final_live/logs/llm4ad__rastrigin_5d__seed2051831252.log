def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    def differential_evolution(pop_size=50, crossover_prob=0.5, mutation_prob=0.1):
        population = rng.uniform(lb, ub, (pop_size, dim))
        best_x = np.copy(population[0])
        best_f = evaluate(best_x)

        for i in range(budget // 10):
            for _ in range(pop_size):
                x_i = population[np.random.randint(0, pop_size)]
                v = rng.uniform(lb, ub, dim)
                u = rng.uniform(lb, ub, dim)
                child = clip(x_i + mutation_prob * (u - x_i) + crossover_prob * (v - x_i))
                f_child = evaluate(child)

                if f_child < best_f:
                    best_x = np.copy(child)
                    best_f = f_child

            population[np.random.randint(0, pop_size)] = best_x

        return best_x, best_f

    def simulated_annealing(best_x, step_size=1e-3, cooling_rate=0.99):
        current_x = np.copy(best_x)

        for _ in range(budget // 10):
            x_i = rng.uniform(lb, ub, dim)
            child = clip(current_x + step_size * (x_i - current_x))

            if evaluate(child) < evaluate(current_x):
                current_x = np.copy(child)
            else:
                if rng.random() > cooling_rate:
                    current_x = np.copy(child)

        return current_x

    best_x, _ = differential_evolution()
    best_x = simulated_annealing(best_x)

    return best_x
