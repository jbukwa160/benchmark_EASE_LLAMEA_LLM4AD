def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def generate_initial_population(dim, lb, ub, rng):
        population = np.zeros((budget, dim))
        for i in range(budget):
            for j in range(dim):
                population[i, j] = (ub - lb) * rng.rand() + lb
        return population

    def differential_evolution(population, func, dim, lb, ub, budget, rng):
        F = 0.5  # Scaling factor
        CR = 1.0  # Crossover rate
        for i in range(budget - 1):
            new_population = np.copy(population)
            for j in range(budget):
                trial_vector = population[j]
                indices = rng.choice([k for k in range(budget) if k != j], size=3, replace=False)
                mutation_vector = F * (population[indices[0]] - 2 * population[indices[1]] + population[indices[2]])
                crossover_mask = np.random.rand(dim) < CR
                trial_vector[crossover_mask] = clip(trial_vector[crossover_mask] + mutation_vector[crossover_mask], lb, ub)
                new_population[j] = func(trial_vector)
            population = new_population

    def local_search(population, func, dim, lb, ub, rng):
        for i in range(budget):
            x = population[i]
            for _ in range(10):
                step_size = 0.1 * (ub - lb)
                delta = np.zeros(dim)
                indices = rng.choice(range(dim), size=dim, replace=False)
                delta[indices] = rng.uniform(-step_size, step_size, size=len(indices))
                new_x = clip(x + delta, lb, ub)
                if func(new_x) < func(x):
                    x = new_x
            population[i] = x

    population = generate_initial_population(dim, lb, ub, rng)
    differential_evolution(population, func, dim, lb, ub, budget, rng)
    local_search(population, func, dim, lb, ub, rng)

    best_individual = np.zeros(dim)
    best_fitness = float('inf')
    for i in range(budget):
        fitness = population[i]
        if fitness < best_fitness:
            best_fitness = fitness
            best_individual = population[i]

    return best_individual
