def algorithm(func, dim, lb, ub, budget, rng):
    n_pop = 100
    n_gen = int(budget / (dim * n_pop))
    cr = 0.9
    f = 0.5
    pbest = np.random.uniform(lb, ub, size=(n_pop, dim))
    gbest = np.zeros(dim)
    best_obj = float('inf')

    for t in range(n_gen):
        for i in range(n_pop):
            r1, r2, r3 = rng.choice(n_pop, 3, replace=False)
            mutant = pbest[r1] + f * (pbest[r2] - pbest[r3])
            crossover = pbest[i]
            for j in range(dim):
                if rng.random() < cr:
                    u = rng.uniform(lb[j], ub[j])
                    v = rng.uniform(lb[j], ub[j])
                    if mutant[j] + u > ub[j]:
                        crossover[j] = ub[j]
                    elif mutant[j] + u < lb[j]:
                        crossover[j] = lb[j]
                    else:
                        crossover[j] = mutant[j] + u
                else:
                    crossover[j] = pbest[i][j]

            candidate = np.clip(crossover, lb, ub)
            obj = func(candidate)

            if obj < best_obj:
                gbest = candidate
                best_obj = obj

            if obj < func(pbest[i]):
                pbest[i] = candidate

        if t % 10 == 0 and t != 0:
            cr = max(0.1, cr - 0.01)
            f = max(0.5, f - 0.005)

    return gbest
