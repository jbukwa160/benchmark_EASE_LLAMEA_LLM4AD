def algorithm(func, dim, lb, ub, budget, rng):
    def sample_gaussian(mean, cov):
        return mean + rng.normal(size=dim) @ np.linalg.cholesky(cov)

    def cauchy_step(x, s):
        c = 0.1
        d = x + c * (x - lb) / (ub - lb)
        p = rng.uniform(0, 1, dim)
        e = (d - x) / np.linalg.norm(d - x, axis=1, keepdims=True)
        return x + s * np.log(np.maximum(p, e))

    best_x = np.full(dim, (lb + ub) / 2)
    best_f = func(best_x)

    for _ in range(budget):
        step_size = 0.1
        s = sample_gaussian(0, np.eye(dim))
        while True:
            x_new = cauchy_step(best_x, step_size * np.linalg.norm(s))
            f_new = func(x_new)
            if f_new < best_f:
                best_x = x_new
                best_f = f_new
            elif rng.uniform(0, 1) > 0.5:
                break
            else:
                s = sample_gaussian(s, np.eye(dim))

        best_x = np.clip(best_x, lb, ub)

    return best_x
