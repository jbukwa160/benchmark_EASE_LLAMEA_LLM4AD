def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(dim, lb, ub, rng):
        return (ub - lb) * rng.uniform(size=(dim)) + lb

    def evaluate_population(population, func):
        scores = [func(candidate) for candidate in population]
        return scores

    def select_parents(scores):
        parents_idx = np.argsort(scores)[:budget // 2]
        return [population[i] for i in parents_idx]

    def generate_offspring(parents, dim, lb, ub, rng):
        offspring = []
        while len(offspring) < budget:
            parent1, parent2 = rng.choice(parents, size=2, replace=False)
            child = (parent1 + parent2) / 2
            child += rng.normal(size=(dim))
            child = clip_candidate(child)
            if func(child) < np.inf:
                offspring.append(child)
        return offspring

    def update_parents(offspring, population):
        parents = select_parents(evaluate_population(population + offspring, func))
        return parents

    def cma_es_step(dim, lb, ub, budget, rng, iteration=1):
        population = generate_initial_population(dim, lb, ub, rng)
        for _ in range(budget // 2):
            scores = evaluate_population(population, func)
            if min(scores) == 0:
                return np.zeros((dim))
            parents = select_parents(scores)
            offspring = generate_offspring(parents, dim, lb, ub, rng)
            population = update_parents(offspring, parents)

    restart_budget = budget // 10
    for i in range(budget):
        if i % restart_budget == 0:
            best_candidate = cma_es_step(dim, lb, ub, restart_budget * 2, rng)
        else:
            best_candidate = cma_es_step(dim, lb, ub, budget - i, rng)

        candidate = clip_candidate(best_candidate)
        score = func(candidate)
        if score < np.inf and score < min(evaluate_population(population, func)):
            population.append(candidate)
    return np.array(min(population, key=lambda x:func(x)))
