def algorithm(func, dim, lb, ub, budget, rng):
    D = rng.rand(dim)
    for _ in range(budget):
        p = np.clip(D + 0.1 * rng.randn(dim), lb, ub)
        f_p = func(p)
        if f_p < func(D):
            D = p
    return D
