def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(-5.0, 5.0, size=dim)
    f_best = func(x)
    
    for _ in range(budget - 1):
        x_new = rng.uniform(lb, ub, size=dim)
        
        if np.linalg.norm(x_new) > np.linalg.norm(x):
            x = x_new
            f_best = func(x)
            
        if abs(f_best) < 0.01:
            break
            
    return x
