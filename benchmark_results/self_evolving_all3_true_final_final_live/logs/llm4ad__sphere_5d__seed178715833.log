def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.maximum(np.minimum(candidate, ub), lb)

    best = np.full(dim, 0)
    best_value = float('inf')

    for _ in range(budget):
        candidate = np.zeros(dim)
        for i in range(dim):
            candidate[i] = rng.uniform(lb, ub)
        
        candidate = clip(candidate)

        value = func(candidate)

        if value < best_value:
            best = candidate
            best_value = value

    return best
