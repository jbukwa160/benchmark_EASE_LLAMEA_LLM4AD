def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    def generate_candidate(mean, cov):
        candidate = np.random.multivariate_normal(mean, cov)
        return clip(candidate)

    def func_call(x):
        return func(x)

    dim = int(dim)
    x = rng.uniform(-5.0, 5.0, size=(dim,))
    best_x = x.copy()
    best_f = float('inf')

    for i in range(budget):
        cov = np.identity(dim) * 1e-4
        sigma = 1

        for _ in range(100):
            candidate = generate_candidate(x, cov)
            f = func_call(candidate)

            if f < best_f:
                best_x = candidate.copy()
                best_f = f

            delta = candidate - x
            ro = np.dot(delta, delta) / (2 * sigma ** 2)
            alpha = rng.uniform(0.0, 1.0)
            if np.log(alpha) < ro:
                x = candidate.copy()

        step_size = np.sqrt(sigma)
        cov = cov + np.outer(step_size * delta, step_size * delta)

    return best_x
