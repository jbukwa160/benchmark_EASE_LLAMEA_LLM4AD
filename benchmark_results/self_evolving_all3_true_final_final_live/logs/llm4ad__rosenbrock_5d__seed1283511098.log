def algorithm(func, dim, lb, ub, budget, rng):
    best_candidate = None
    best_fitness = float('inf')
    
    for _ in range(budget // 10):
        pop_size = int(np.sqrt(dim))
        
        population = np.random.uniform(lb, ub, (pop_size, dim))
        candidate = population[0]
        fitness = func(candidate)
        
        if fitness < best_fitness:
            best_candidate = candidate
            best_fitness = fitness
        
        for _ in range(pop_size - 1):
            mutation_factor = rng.uniform(0.5, 1.5)
            crossover_prob = rng.uniform(0.0, 1.0)
            
            parent_idx = np.random.choice(pop_size, size=3, replace=False)
            parents = population[parent_idx]
            
            for i in range(dim):
                if rng.uniform(0.0, 1.0) < crossover_prob:
                    candidate[i] = parents[0, i] * mutation_factor + \
                        (parents[1, i] - parents[2, i]) / np.sqrt(np.sum((parents[1, :] - parents[2, :])**2))
            
            candidate = clip(candidate, lb, ub)
            fitness = func(candidate)
            
            if fitness < best_fitness:
                best_candidate = candidate
                best_fitness = fitness
        
        population[:, 0] = best_candidate
    
    return np.array(best_candidate)
