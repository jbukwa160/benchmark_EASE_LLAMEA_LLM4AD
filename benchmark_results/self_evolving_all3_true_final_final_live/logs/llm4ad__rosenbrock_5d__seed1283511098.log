def algorithm(func, dim, lb, ub, budget, rng):
    def get_1d(x, i):
        return x[i] if i < dim else 0

    def gaussian_mutate(x, sigma=1e-2):
        return x + np.random.normal(size=(dim,), loc=0.0, scale=sigma)

    def polynomial_mutate(x, eta=20, p=5):
        return [max(min(get_1d(x, i) + np.power(np.random.uniform(-eta, eta), 1/p)*np.random.normal(0, sigma),
                       ub), lb) for i in range(dim)]

    x_best = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    f_best = func(x_best)

    while budget > 0:
        budget -= 1

        # Gaussian mutation
        mu_gauss = gaussian_mutate(np.copy(x_best))
        f_gauss = func(mu_gauss)
        
        if f_gauss < f_best or np.random.rand() < 0.5:
            x_best = mu_gauss
            f_best = f_gauss

        # Polynomial mutation
        mu_poly = polynomial_mutate(np.copy(x_best))
        f_poly = func(mu_poly)

        if f_poly < f_best:
            x_best = mu_poly
            f_best = f_poly

    return np.clip(x_best, lb, ub)
