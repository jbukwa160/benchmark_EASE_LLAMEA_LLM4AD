    for _ in range(budget):
        x = rng.normal(mean, cov**0.5)
        x = np.clip(x, lb, ub)

        fitness = func(x)
        cov += 1 / n * (x[:, None] @ x[None, :] - cov)
        mean += 1 / n * (x - mean)
        
