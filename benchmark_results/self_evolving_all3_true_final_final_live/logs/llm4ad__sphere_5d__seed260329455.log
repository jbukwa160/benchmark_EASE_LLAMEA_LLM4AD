def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = len(lb)
    x0 = rng.uniform(size=D) * (ub - lb) + lb
    c1 = 1.4 / D
    c2 = 2.05 / D

    best_x = x0.copy()
    best_f = func(clip(x0))

    n_evals = 0
    while n_evals < budget:
        y = rng.normal(size=D)
        s = np.linalg.norm(y)

        x_c = clip(best_x + c1 * y / s)
        f_c = func(x_c)
        n_evals += 1

        if f_c < best_f:
            best_f = f_c
            best_x = x_c

        s2 = rng.normal(size=D, loc=0, scale=s) / np.sqrt(s**2 + c2)
        s_new = np.linalg.norm(s2)

        x_p = clip(best_x + (s * y - s2 * best_x) / s_new)

        f_p = func(x_p)
        n_evals += 1

        if f_p < best_f:
            best_f = f_p
            best_x = x_p

    return best_x
