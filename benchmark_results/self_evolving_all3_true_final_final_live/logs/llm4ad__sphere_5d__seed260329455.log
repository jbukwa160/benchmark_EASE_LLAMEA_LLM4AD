def algorithm(func, dim, lb, ub, budget, rng):
    n = int(np.ceil(budget / 2))
    candidates = rng.uniform(lb, ub, (n, dim))

    for _ in range(n - 1):
        best_candidate = candidates[np.argmin([func(candidate) for candidate in candidates])]
        new_candidate = rng.uniform(lb, ub, size=dim)
        candidates = np.vstack((candidates, new_candidate))
        candidates = np.clip(candidates, lb, ub)

    return np.min([func(candidate) for candidate in candidates], axis=0)
