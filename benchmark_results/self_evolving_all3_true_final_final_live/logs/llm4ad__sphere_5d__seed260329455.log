def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
        
        # Adaptive clustering
        sigma = 0.1 * (ub - lb)
        std_devs = np.random.uniform(0, sigma, size=dim)
        new_x = best_x + std_devs
        
        # Clip candidates to [lb, ub]
        new_x = np.clip(new_x, lb, ub)
        
        f_new = func(new_x)
        
        if f_new < best_f:
            best_f = f_new
            best_x = new_x
    
    return best_x
