def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    N = int(budget)
    T = 0.9 * (ub - lb) / np.sqrt(np.log(N))
    x = np.array([np.random.uniform(lb, ub) for _ in range(D)])
    
    best_x = x.copy()
    best_f = func(x)
    
    for n in range(N):
        y = x + T * rng.randn(D)
        y = np.clip(y, lb, ub)
        
        f_y = func(y)
        if f_y < best_f:
            best_f = f_y
            best_x = y.copy()
            
            if n > 0 and f_y <= best_f / (n ** 1.5):
                T *= 0.9
                
        elif rng.rand() < np.exp((best_f - f_y) / T):
            x = y
            
    return best_x
