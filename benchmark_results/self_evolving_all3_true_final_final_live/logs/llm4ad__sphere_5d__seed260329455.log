def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        delta = np.random.normal(size=dim) * 0.1
        new_x = best_x + delta

        # Clip to bounds
        new_x = np.clip(new_x, lb, ub)
        
        new_f = func(new_x)
        
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f
    
    return best_x
