def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (1, dim))
    sigma = 0.5 * (ub - lb)
    mu = np.zeros(dim)

    for i in range(budget):
        y = func(x)
        
        if np.isnan(y):
            x += np.random.uniform(-sigma, sigma, (1, dim))
            continue

        offspring = np.zeros((20, dim))

        for j in range(20):
            z = norm.rvs(size=dim)
            offspring[j] = x + sigma * z

        clipped_offspring = np.clip(offspring, lb, ub)

        y_offspring = func(clipped_offspring)

        best_idx = np.argmin(y_offspring)

        if y < y_offspring[best_idx]:
            mu += 0.1 * (clipped_offspring[best_idx] - x)
            sigma *= 0.99

        x += mu
    return x
