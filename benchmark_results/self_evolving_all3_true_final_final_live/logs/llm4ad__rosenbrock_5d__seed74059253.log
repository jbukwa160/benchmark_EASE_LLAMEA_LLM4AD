def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    best_candidate = rng.uniform(lb, ub, size=dim)
    best_fitness = func(best_candidate)

    learning_rate = 1.0
    for i in range(1, budget+1):
        candidate = rng.normal(loc=best_candidate, scale=np.exp(-i/10), size=dim)
        candidate = clip(candidate, lb, ub)
        
        fitness = func(candidate)
        if fitness < best_fitness:
            best_fitness = fitness
            best_candidate = candidate
        
        learning_rate *= np.exp(-1.0/(i+1))
    
    return best_candidate
