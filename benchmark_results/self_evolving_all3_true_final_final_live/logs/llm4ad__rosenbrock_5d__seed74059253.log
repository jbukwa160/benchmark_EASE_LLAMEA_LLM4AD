def algorithm(func, dim, lb, ub, budget, rng):
    def get_distance(x1, x2):
        return np.sum(np.abs(x1 - x2))

    def evaluate(population):
        fitness = np.zeros(len(population))
        for i in range(len(population)):
            fitness[i] = func(population[i])
        return fitness

    def clip_population(population, lb, ub):
        clipped_pop = population.copy()
        for i in range(len(clipped_pop)):
            clipped_pop[i] = np.clip(clipped_pop[i], lb, ub)
        return clipped_pop

    def binary_tournament_selection(population, fitness, rng):
        idx1 = rng.randint(0, len(population))
        idx2 = rng.randint(0, len(population))
        if fitness[idx1] < fitness[idx2]:
            return population[idx1]
        else:
            return population[idx2]

    def crossover(x1, x2):
        offspring = np.zeros(dim)
        for i in range(dim):
            offspring[i] = (x1[i] + x2[i]) / 2.0
        return offspring

    def mutation(offspring, rng):
        for i in range(dim):
            if rng.random() < 0.5:
                offspring[i] += rng.uniform(-ub, ub)
            else:
                offspring[i] -= rng.uniform(0, ub)
        return offspring

    population = np.zeros((budget, dim))
    population[0] = rng.uniform(lb, ub, size=dim)

    for i in range(1, budget):
        parent1 = binary_tournament_selection(population[:i], evaluate(population[:i]), rng)
        parent2 = binary_tournament_selection(population[:i], evaluate(population[:i]), rng)
        offspring = crossover(parent1, parent2)
        clipped_offspring = clip_population([offspring], lb, ub)[0]
        mutated_offspring = mutation(clipped_offspring, rng)
        population[i] = mutated_offspring

    best_individual = np.zeros(dim)
    best_fitness = float('inf')
    for i in range(budget):
        clipped_pop_i = clip_population(population[:i+1], lb, ub)[i]
        fitness_i = func(clipped_pop_i)
        if fitness_i < best_fitness:
            best_fitness = fitness_i
            best_individual = clipped_pop_i

    return best_individual
