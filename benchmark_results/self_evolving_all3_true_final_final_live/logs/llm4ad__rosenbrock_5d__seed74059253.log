def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.maximum(np.minimum(candidate, ub), lb)

    def adapt_crossover_rate(x_best, x_current, iteration, budget):
        rate = 0.1 + (iteration / budget) * (x_best - x_current).sum()
        return np.clip(rate, 0, 1)

    def adapt_mutation_rate(iteration, budget):
        rate = 0.5 + (iteration / budget)
        return np.clip(rate, 0, 1)

    def generate_initial_population(dim, lb, ub, rng):
        population = np.random.uniform(lb, ub, size=(budget, dim))
        return population

    def differential_evolution(population, func, dim, lb, ub, iteration, budget, rng):
        x_best = population[np.random.choice(range(budget))]

        for _ in range(budget - 1):
            mutation_rate = adapt_mutation_rate(iteration, budget)
            crossover_rate = adapt_crossover_rate(x_best, np.mean(population, axis=0), iteration, budget)

            z = np.zeros((budget, dim))
            for i in range(budget):
                r1, r2, r3 = rng.choice(range(budget), 3, replace=False)
                u = population[r2] + mutation_rate * (population[r1] - population[r3])

                # DE crossover
                if np.random.rand() < crossover_rate:
                    z[i] = clip(0.5 * x_best + 0.5 * u, lb, ub)
                else:
                    z[i] = clip(u, lb, ub)

            f_z = func(z)

            new_population_idx = np.argmin(f_z)
            if f_z[new_population_idx] < func(population[np.random.choice(range(budget))]):
                population[new_population_idx] = z[new_population_idx]
                x_best = population[np.argmin(f_z)]

        return population

    population = generate_initial_population(dim, lb, ub, rng)
    best_candidate = differential_evolution(population, func, dim, lb, ub, 0, budget, rng)
    return clip(best_candidate[np.argmin(func(best_candidate))], lb, ub)
