def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    adam_lr = 0.001
    adam_beta1 = 0.9
    adam_beta2 = 0.999

    m = np.zeros(dim)
    v = np.zeros(dim)

    for i in range(budget):
        if rng.random() < 0.5:
            g = np.zeros(dim)
            for j in range(dim-1):
                g[j] = 200 * (2 * x[j+1] - x[j]**2) * (x[j+1] - x[j]**2)
                g[j+1] += 2 * (x[j+1] - x[j]**2)
            g[-1] = 2 * (x[-1] - x[-2]**2)
            m = adam_beta1 * m + (1-adam_beta1) * g
            v = adam_beta2 * v + (1-adam_beta2) * g**2
            x -= adam_lr * m / np.sqrt(v + 1e-8)

        if rng.random() < 0.5:
            x = np.clip(x + rng.uniform(-1, 1, size=dim), lb, ub)
        
        f = func(x)
        if f < best_f:
            best_x = x.copy()
            best_f = f

    return best_x
