def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 1000
    tau = 0.99
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        delta_x = rng.normal(size=dim) * 0.01
        new_x = np.clip(x + delta_x, lb, ub)
        new_f = func(new_x)

        if new_f < best_f:
            x = new_x.copy()
            best_x = new_x.copy()
            best_f = new_f

        elif rng.uniform(0, 1) < np.exp((best_f - new_f) / T):
            x = new_x.copy()

        T *= tau
    return best_x
