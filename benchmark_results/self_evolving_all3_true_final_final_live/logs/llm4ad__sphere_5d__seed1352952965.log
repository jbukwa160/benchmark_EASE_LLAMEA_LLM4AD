def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=dim)
    best_val = func(x_best)

    for _ in range(budget - 1):
        if rng.rand() < 0.5:
            step_size = rng.uniform(0.01, 0.1)
            x_new = np.clip(x_best + rng.normal(size=dim) * step_size, lb, ub)
        else:
            x_new = rng.uniform(lb, ub, size=dim)

        new_val = func(np.array(x_new))
        if new_val < best_val:
            best_val = new_val
            x_best = np.copy(x_new)

    return x_best
