def algorithm(func, dim, lb, ub, budget, rng):
    n_restart = int(budget * 0.1)
    best = None
    for _ in range(n_restart + 1):
        candidate = rng.uniform(lb, ub, size=dim)
        current_best = func(candidate)
        if best is None or current_best < func(best):
            best = candidate
    return np.clip(best, lb, ub)
