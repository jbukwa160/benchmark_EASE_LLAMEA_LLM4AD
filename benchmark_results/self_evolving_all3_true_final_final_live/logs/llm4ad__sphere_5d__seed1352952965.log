def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(dim, rng):
        return rng.uniform(lb, ub, size=(dim, budget))

    def clip(bounds, x):
        clipped = np.clip(x, bounds[0], bounds[1])
        return np.minimum(np.maximum(clipped, bounds[0]), bounds[1])

    def compute_gradient(func, x):
        return 2.0 * x

    def update_cma(population, gradient, lambda_, budget):
        mean = np.mean(population, axis=1)
        cov = np.cov(population.T) / (len(budget) - 1)
        sigma = np.sqrt(np.diag(cov))
        new_population = np.zeros((dim, len(budget)))
        for i in range(len(budget)):
            z = rng.standard_normal(size=(dim,))
            mu_i = mean + np.outer(z, sigma)
            new_population[:, i] = mu_i
        return new_population

    def select_parents(population):
        return population[:, -budget:]

    def compute_fitness(func, x):
        return func(x)

    initial_population = generate_initial_population(dim, rng)
    population = clip((lb, ub), initial_population)
    gradient = compute_gradient(func, population[0])
    for iteration in range(budget):
        parents = select_parents(population)
        new_population = update_cma(parents, gradient, 1.0, budget)
        new_population = clip((lb, ub), new_population)
        fitness = compute_fitness(func, new_population.T)
        best_index = np.argmin(fitness)
        if iteration % 100 == 0:
            print("Iteration: {}, Best Fitness: {}".format(iteration + 1, fitness[best_index]))
    return population[:, -1]
