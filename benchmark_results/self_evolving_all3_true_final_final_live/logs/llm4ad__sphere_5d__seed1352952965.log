def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        new_x = x + rng.uniform(-1.0, 1.0, size=dim)
        new_x = np.clip(new_x, lb, ub)
        
        if func(new_x) < best_f:
            best_x = new_x
            best_f = func(new_x)

        delta = rng.uniform(-5.0, -0.01, size=dim)
        new_x = best_x + delta
        new_x = np.clip(new_x, lb, ub)

        if func(new_x) < best_f:
            best_x = new_x
            best_f = func(new_x)

    return best_x
