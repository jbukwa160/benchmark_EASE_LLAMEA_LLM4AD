def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -1e300 * np.ones(dim)
    f_best = 1e300

    for _ in range(budget):
        p = np.random.rand()
        if p < 0.3:
            # Exploitation: select a point close to the best found so far
            x = x_best + rng.uniform(-5, 5, size=dim)
        else:
            # Exploration: propose a random point
            x = rng.uniform(lb, ub, size=dim)

        f_x = func(x)
        if np.any((x < lb) | (x > ub)):
            continue

        if f_x <= f_best:
            x_best = x
            f_best = f_x

    return x_best
