def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 20
    sigma = 0.5
    x_best = np.zeros(dim)
    f_best = float('inf')
    for _ in range(budget):
        pop = np.clip(rng.normal(loc=0, scale=sigma, size=(pop_size, dim)), lb, ub)
        f_pop = func(pop)
        idx = np.argmin(f_pop)
        x_new = pop[idx]
        f_new = f_pop[idx]
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
        delta = x_new - x_best
        sigma_new = (sigma + 0.1 * delta) / np.sqrt(1 + 0.2 ** 2)
        sigma = max(sigma, sigma_new)
    return x_best
