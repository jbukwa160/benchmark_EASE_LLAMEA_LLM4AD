def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    x = 5 * (ub - lb) * rng.randn(dim) + (lb + ub) / 2
    cov = 1e-3 * np.eye(dim)
    step_size = 0.5

    for _ in range(budget):
        candidates = clip(x + step_size * rng.randn(dim, budget))
        fitnesses = func(candidates)

        if np.any(np.isclose(fitnesses, 0)):
            return clip(candidates[np.argmin(np.abs(fitnesses))])

        x += (step_size ** 2) * np.dot(cov, np.corrcoef(fitnesses.T).T)
        cov *= 1 - step_size

    return clip(x)
