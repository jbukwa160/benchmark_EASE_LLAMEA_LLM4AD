def algorithm(func, dim, lb, ub, budget, rng):
    x_best = lb + (ub - lb) * rng.uniform(size=dim)
    
    for _ in range(budget):
        # Generate a new candidate by adding Gaussian noise to the current best
        x_new = x_best + 0.1 * rng.normal(size=dim)
        
        # Clip the new candidate to bounds
        x_new = np.clip(x_new, lb, ub)
        
        # Evaluate the new candidate using the fitness function
        f_new = func(x_new)
        
        # Update the best candidate if the new one is better
        if f_new < func(x_best):
            x_best = x_new
    
    return x_best
