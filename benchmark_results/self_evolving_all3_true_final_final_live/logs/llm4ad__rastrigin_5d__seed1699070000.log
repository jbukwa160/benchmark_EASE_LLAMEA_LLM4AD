def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(dim, bounds, rng):
        population = np.zeros((budget, dim))
        for i in range(budget):
            for j in range(dim):
                population[i, j] = (ub - lb) * rng.rand() + lb
        return population

    def differential_evolution(population, func, dim, bounds, budget):
        for _ in range(budget // 2):
            differences = np.zeros((budget, dim))
            for i in range(1, budget):
                for j in range(dim):
                    differences[i, j] = (population[0, j] - population[i, j]) / abs(population[0, j])
            population_new = np.copy(population)
            indices = rng.choice(budget, size=budget-1, replace=False)
            for i in range(1, budget):
                weights = np.random.normal(size=dim)
                weighted_sum = np.sum(weights * differences[indices[i], :])
                for j in range(dim):
                    population_new[i, j] += weighted_sum
        return population_new

    def cma_es(population, func, dim, bounds, budget):
        mean = np.mean(population, axis=0)
        cov_matrix = np.cov(population.T)
        sigma = 1.0
        for _ in range(budget // 2):
            sigma += 0.1
            new_population = np.copy(population) + np.random.multivariate_normal(mean, sigma * (cov_matrix))
            for i in range(len(new_population)):
                if any(np.isnan(new_population[i])):
                    new_population[i] = population[i]
        return new_population

    population = generate_initial_population(dim, [lb, ub], rng)
    for _ in range(budget // 2):
        population = differential_evolution(population, func, dim, [lb, ub], budget)
        population = cma_es(population, func, dim, [lb, ub], budget)

    best_solution = np.copy(population[np.argmin([func(x) for x in population])])
    return np.clip(best_solution, lb, ub)
