def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.minimum(np.maximum(x, lb), ub)

    pop_size = 50
    n_generations = int(budget / (dim * pop_size))
    best_sol = None
    best_fitness = float('inf')

    for generation in range(n_generations):
        population = rng.uniform(lb, ub, size=(pop_size, dim))
        fitnesses = [func(x) for x in population]

        while True:
            idx1, idx2, idx3 = rng.choice(pop_size, 3, replace=False)
            trial_vector = bound(0.5 * (population[idx1] + population[idx2]) +
                                 0.5 * rng.uniform(-ub, ub, size=dim))

            if rng.random() < 0.5:
                mutation_factor = rng.uniform(1 - 1e-3, 1)
            else:
                mutation_factor = rng.uniform(1, 10)

            trial_vector += mutation_factor * (population[idx2] - population[idx3])

            trial_fitness = func(trial_vector)
            if trial_fitness < fitnesses[idx1]:
                population[idx1], fitnesses[idx1] = trial_vector, trial_fitness
            elif trial_fitness < fitnesses[idx2]:
                population[idx2], fitnesses[idx2] = trial_vector, trial_fitness

        best_sol = bound(population[np.argmin(fitnesses)])
        best_fitness = min(best_fitness, np.min(fitnesses))

    return best_sol
