def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.sqrt(budget))
    pop = rng.uniform(lb, ub, (pop_size, dim))

    best_x = pop[np.argmin([func(x) for x in pop])]
    best_f = func(best_x)

    for _ in range(budget - pop_size):
        mutation_factor = 0.5
        crossover_prob = 0.5

        mutants = np.zeros((pop_size, dim))
        for i in range(pop_size):
            idx = rng.choice(pop_size, size=3, replace=False)
            mutant = best_x + mutation_factor * (pop[idx[0]] - pop[idx[1]] + pop[idx[2]])
            mutants[i] = mutant

            # Clip to bounds
            mutants[i] = np.clip(mutants[i], lb, ub)

        for i in range(pop_size):
            if rng.rand() < crossover_prob:
                x = mutants[i]
                j = rng.choice(pop_size)
                x[j] = pop[j]

                # Clip to bounds
                x = np.clip(x, lb, ub)

                new_f = func(x)
                if new_f < best_f:
                    best_x = x
                    best_f = new_f

    return best_x
