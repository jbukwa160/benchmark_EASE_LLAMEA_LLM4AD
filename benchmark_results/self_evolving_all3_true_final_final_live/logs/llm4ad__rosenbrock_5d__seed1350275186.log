def algorithm(func, dim, lb, ub, budget, rng):
    N = 2 * dim + 1
    x_best = np.array([0.5 * (ub - lb) + lb] * dim)
    f_best = func(x_best)

    T0 = 1e6
    alpha = 0.99

    for i in range(budget):
        t = T0 * math.exp(-i / budget)
        if rng.uniform(0, 1) < np.exp(-(f_best - func(np.array([rng.uniform(lb, ub) for _ in range(dim)]))) / t):
            x_new = np.array([rng.uniform(lb, ub) for _ in range(dim)])
        else:
            grad = np.zeros(dim)
            for j in range(1, dim):
                eps = 0.01 * (ub - lb)
                grad[j-1] += (func(np.array([x_best[k] + eps if k == j-1 else x_best[k]] for k in range(dim))) - f_best) / eps
            grad *= t
            x_new = np.clip(x_best - 0.01 * grad, lb, ub)

        f_new = func(x_new)
        if f_new < f_best:
            f_best = f_new
            x_best = x_new

    return x_best
