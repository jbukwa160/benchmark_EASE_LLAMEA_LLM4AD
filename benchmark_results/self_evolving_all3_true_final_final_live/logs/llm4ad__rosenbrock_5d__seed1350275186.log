def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 20 + int(np.sqrt(budget))
    mu = 1 / (5 * np.sqrt(dim))
    sigma = 0.25
    x_best = None
    f_best = float('inf')
    
    for i in range(pop_size):
        x_i = lb + rng.uniform(0, 1) * (ub - lb)
        
        for j in range(budget // pop_size):
            sigma_j = sigma / np.sqrt(j + 1)
            z_j = rng.normal(0, 1, dim)
            
            x_ij = x_i + mu * z_j * sigma_j
            
            # Clip bounds
            x_ij = np.clip(x_ij, lb, ub)
            
            f_ij = func(x_ij)
            
            if f_ij < f_best:
                x_best = x_ij.copy()
                f_best = f_ij
                
    return x_best
