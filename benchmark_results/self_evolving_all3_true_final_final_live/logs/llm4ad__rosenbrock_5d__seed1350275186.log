def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    pop_size = int(0.1 * budget)
    population = (ub - lb) * rng.random((pop_size, dim)) + lb
    best_sol = population[np.argmin([evaluate(x) for x in population])]
    temperature = 100

    for _ in range(budget):
        new_pop = np.zeros((pop_size, dim))
        
        for i in range(pop_size):
            r1, r2, r3 = rng.choice(range(pop_size), size=3, replace=False)
            
            # DE step
            mutation = population[r1] + 0.5 * (population[r2] - population[r3])
            new_pop[i] = mutation
            
        for i in range(pop_size):
            if evaluate(new_pop[i]) < evaluate(best_sol):
                best_sol = new_pop[i]
                
            # Simulated Annealing step
            else:
                prob = np.exp((evaluate(best_sol) - evaluate(new_pop[i])) / temperature)
                if rng.random() < prob:
                    new_pop[i] = best_sol
                    
        population, best_sol = new_pop, best_sol
                
        temperature *= 0.99
        
    return best_sol
