def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(dim,))
    
    for _ in range(budget - 1):
        # Step 2: Sampling from a multivariate normal distribution
        mu = x.copy()
        sigma = 0.1 * (ub - lb)
        std = np.diag([sigma] * dim)
        
        new_x = rng.multivariate_normal(mu, std)
        
        # Clip candidates to [lb, ub]
        new_x = np.clip(new_x, lb, ub)
        
        # Step 3: Evaluation
        fx_new = func(new_x)
        fx = func(x)
        
        if fx_new < fx:
            x = new_x
        
    return x
