def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.sqrt(budget))
    population = rng.uniform(lb, ub, (pop_size, dim))
    best_candidate = None
    best_fitness = float('inf')

    for _ in range(pop_size * 10):  # 10 generations
        fitnesses = np.array([func(x) for x in population])
        idx = np.argsort(fitnesses)[:2]  # Select the fittest candidates
        parents = population[idx]

        if best_candidate is None or fitnesses[idx].min() < best_fitness:
            best_candidate = parents[np.argmin(fitnesses[idx])]
            best_fitness = fitnesses[idx].min()

        offspring = np.empty((pop_size, dim))
        for i in range(pop_size):
            idx1, idx2 = rng.choice(2, 2, replace=False)
            c1, c2 = parents[idx1], parents[idx2]
            r = rng.uniform(lb, ub)
            j = rng.randint(dim)

            offspring[i] = np.copy(c1)
            offspring[i, j] = c2[j]

        mutation_probability = 0.01
        for i in range(pop_size):
            if rng.rand() < mutation_probability:
                idx = rng.randint(dim)
                offspring[i, idx] += rng.uniform(-1, 1)

        population = np.clip(offspring, lb, ub)  # Clip to bounds

    return best_candidate
