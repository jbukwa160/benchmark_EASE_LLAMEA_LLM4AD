def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(low=lb, high=ub, size=dim)
    for _ in range(budget):
        x_new = x_best + rng.uniform(low=-1, high=1, size=dim) * 0.5
        x_new = np.clip(x_new, lb, ub)
        if func(x_new) < func(x_best):
            x_best = x_new.copy()
    return x_best
