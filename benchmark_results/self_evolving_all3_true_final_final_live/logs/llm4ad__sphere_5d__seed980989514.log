def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    step_size = 1.0
    success_rate = 0.5
    for i in range(budget):
        while True:
            x_cand = lb + (ub - lb) * rng.rand(dim)
            f_cand = func(x_cand)
            if f_cand < func(x_best):
                x_best = x_cand
            if np.random.rand() > success_rate or i == budget - 1:
                break
            step_size *= 0.9 + (np.random.rand() * 2) / 100
        if rng.rand() < 0.01:
            step_size /= 2
        if rng.rand() < 0.01 and i > 10:
            success_rate += 0.1
    return x_best
