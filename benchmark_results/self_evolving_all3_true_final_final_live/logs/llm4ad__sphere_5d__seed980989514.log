def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(-5, 5, size=dim)
    T = 1e6
    alpha = 0.99
    T_min = 1e-3
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        new_x = x + rng.uniform(-1, 1, size=dim) / T
        new_x = np.clip(new_x, lb, ub)
        
        new_f = func(new_x)

        if new_f < best_f:
            best_f = new_f
            best_x = new_x.copy()

        if new_f <= best_f:
            x = new_x

        T *= alpha

    return best_x
