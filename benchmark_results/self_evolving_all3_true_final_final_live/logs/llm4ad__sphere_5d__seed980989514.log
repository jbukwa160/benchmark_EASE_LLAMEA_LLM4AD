def algorithm(func, dim, lb, ub, budget, rng):
    def accept(current, new, T):
        return new < current or np.random.rand() < np.exp((current - new) / T)

    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best = np.zeros(dim)
    best_f = float('inf')
    T = 1.0
    restarts = 0

    while budget > 0:
        candidate = rng.uniform(lb, ub, size=dim)
        new_f = func(candidate)
        
        if new_f < best_f or accept(best_f, new_f, T):
            best_f = new_f
            best = candidate
            
        if np.random.rand() < 0.1 and budget > 100: # random restarts
            best = rng.uniform(lb, ub, size=dim)
            best_f = func(best)

        T *= 0.99
        budget -= 1

    return clip(best)
