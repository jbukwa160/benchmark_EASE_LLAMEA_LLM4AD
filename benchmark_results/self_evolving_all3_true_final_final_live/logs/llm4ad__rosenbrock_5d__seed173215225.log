def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(1, dim))
    t = 1000
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget - 1):
        while True:
            x = rng.uniform(lb, ub, size=(1, dim))
            f = func(x)
            if f < best_f or np.random.rand() < np.exp((best_f - f) / t):
                best_x = x
                best_f = f
                break

        for _ in range(dim):
            while True:
                y = best_x.copy()
                for j in range(dim):
                    if rng.randint(0, 2):
                        y[j] += (ub[j] - lb[j]) * np.random.uniform(-1, 1)
                    else:
                        y[j] -= (ub[j] - lb[j]) * np.random.uniform(-1, 1)
                y = np.clip(y, lb, ub)
                fy = func(y)

                if fy < best_f or np.random.rand() < np.exp((best_f - fy) / t):
                    best_x = y
                    best_f = fy
                    break

        t *= 0.99

    return best_x
