def algorithm(func, dim, lb, ub, budget, rng):
    def gp_model(X, Y):
        cov_func = lambda x, y: np.exp(-((x-y)**2).sum(axis=1))
        K = np.zeros((len(X), len(X)))
        for i in range(len(X)):
            for j in range(len(X)):
                K[i,j] = cov_func(X[i], X[j])
        L = np.linalg.cholesky(K)
        return L

    def sample_from_gp(gp_model, rng):
        n = 10
        X = np.array([rng.uniform(lb, ub) for _ in range(dim)])
        while True:
            K = gp_model(X)
            mu = K.dot(np.random.normal(size=(n,1)))
            sigma2 = 1e-3 + np.exp(rng.uniform(-5, 0))
            Y = mu + rng.normal(scale=np.sqrt(sigma2), size=(n,))
            if (Y >= 0).all():
                break
        return X[np.argmax(Y)]

    def clip_candidates(X):
        return np.clip(X, lb, ub)

    best_x = None
    best_f = np.inf

    for _ in range(budget):
        X = [sample_from_gp(gp_model, rng) for _ in range(10)]
        Y = [func(x) for x in X]
        gp_model = gp_model(np.array(X), np.array(Y))
        new_x = sample_from_gp(gp_model, rng)
        new_f = func(new_x)

        if new_f < best_f:
            best_x = clip_candidates(new_x)
            best_f = new_f

    return best_x
