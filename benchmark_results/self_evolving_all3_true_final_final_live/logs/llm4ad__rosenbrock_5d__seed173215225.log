def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    num_parents = int(pop_size * 0.2)
    sigma = [1.0 for _ in range(dim)]
    best_candidate = None
    best_fitness = float('inf')

    candidates = np.random.uniform(lb, ub, (pop_size, dim))

    for _ in range(budget):
        fitnesses = func(candidates)

        idx = np.argsort(fitnesses)[:num_parents]
        parents = candidates[idx]

        new_candidates = np.copy(parents)
        for i in range(pop_size - num_parents):
            parent1_idx = rng.randint(0, num_parents)
            parent2_idx = rng.randint(0, num_parents)

            c = rng.uniform(0.1, 0.9)
            child = parents[parent1_idx] + c * (parents[parent2_idx] - parents[parent1_idx])

            for j in range(dim):
                if rng.rand() < 0.5:
                    new_candidates[i, j] = np.clip(child[j], lb, ub)
                else:
                    new_candidates[i, j] = candidates[rng.randint(0, pop_size), j]

        candidates = np.copy(new_candidates)

        # clip
        for i in range(pop_size):
            candidates[i] = np.clip(candidates[i], lb, ub)

        best_idx = np.argmin(fitnesses)
        if fitnesses[best_idx] < best_fitness:
            best_candidate = candidates[best_idx]
            best_fitness = fitnesses[best_idx]

    return best_candidate
