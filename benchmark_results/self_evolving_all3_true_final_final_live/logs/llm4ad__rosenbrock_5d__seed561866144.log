def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    x0 = rng.uniform(lb, ub, (1, dim))
    best_x = x0.copy()
    best_f = func(clip(x0))

    t = 100
    sigma = 10.0
    restart = False

    while budget > 0:
        if restart:
            x0 = rng.uniform(lb, ub, (1, dim))
            best_x = x0.copy()
            best_f = func(clip(x0))
            restart = False
            t = 100

        sigma *= np.exp(-t / (budget + 10))
        t -= 1
        budget -= 1

        n_child = rng.normal(size=(1, dim), loc=best_x, scale=sigma)
        child = clip(best_x + n_child)

        fc = func(clip(child))

        if fc < best_f:
            best_f = fc
            best_x = child.copy()

        if rng.uniform() < np.exp((best_f - fc) / sigma**2):
            best_x = child.copy()
            best_f = fc

    return best_x
