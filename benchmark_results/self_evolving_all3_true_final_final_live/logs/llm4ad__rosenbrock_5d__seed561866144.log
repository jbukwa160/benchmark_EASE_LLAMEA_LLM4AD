def algorithm(func, dim, lb, ub, budget, rng):
    n = int(np.ceil(budget / 1000))  # number of iterations for ES
    pop_size = 50
    step_size = (ub - lb) / 2.
    
    x_best = np.random.uniform(lb, ub, size=(1, dim))
    f_best = func(x_best)
    
    for i in range(n):
        z = rng.normal(size=(pop_size, dim)) * step_size + x_best
        c = np.clip(z, lb, ub)
        y = func(c)
        
        # Select the best individuals using Grid Search
        grid_step = (ub - lb) / 10.
        for j in range(-5, 6):
            for k in range(-5, 6):
                x_grid = c + j * grid_step * np.eye(dim)
                f_grid = func(np.clip(x_grid, lb, ub))
                
                if f_grid < y:
                    c[j % pop_size] = x_grid
                    y = f_grid
        
        x_best = c[np.argmin(y)]
        f_best = func(x_best)
        
        # Terminate if budget is reached or improvement is minimal
        if i > 0 and np.abs(f_best - f_best_prev) < 1e-3:
            break
        f_best_prev = f_best
    
    return x_best
