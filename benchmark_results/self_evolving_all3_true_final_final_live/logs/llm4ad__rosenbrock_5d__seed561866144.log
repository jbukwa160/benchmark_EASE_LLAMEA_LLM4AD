def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    x = np.random.rand(dim) * (ub - lb) + lb
    t = 1.0
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        y = clip(x + rng.randn(dim))
        
        f_y = func(y)
        if f_y < best_f:
            best_f = f_y
            best_x = y
            
        alpha = 0.95
        beta = 1.05
        
        delta_f = f_y - best_f
        p = np.exp(-delta_f / t)
        
        if rng.rand() < p or delta_f <= 0:
            x = y.copy()
            
        t *= alpha * rng.uniform(0.9, 1.1)
    
    return best_x
