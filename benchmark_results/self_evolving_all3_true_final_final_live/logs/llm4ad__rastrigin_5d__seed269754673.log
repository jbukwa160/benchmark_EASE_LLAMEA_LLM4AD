def algorithm(func, dim, lb, ub, budget, rng):
    def clipped_candidate(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_y = func(x)

    for _ in range(budget):
        n1 = rng.choice(dim, replace=False, size=3)
        y1 = func(clipped_candidate(best_x + 0.5 * (x[n1[0]] - x[n1[1]]) + 0.5 * (x[n1[2]] - best_x[n1[0]])))
        if rng.uniform(0, 1) < np.exp((best_y - y1)):
            best_x = clipped_candidate(best_x + 0.5 * (x[n1[0]] - x[n1[1]]) + 0.5 * (x[n1[2]] - best_x[n1[0]]))
            best_y = y1

    return best_x
