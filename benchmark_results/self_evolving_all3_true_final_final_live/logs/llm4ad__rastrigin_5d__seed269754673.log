def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(dim, lb, ub, population_size):
        return (ub - lb) * rng.uniform(size=(population_size, dim)) + lb
    
    def clip_candidates(candidates, lb, ub):
        return np.clip(candidates, a_min=lb, a_max=ub)
    
    def evaluate_fitness(population, func):
        fitness = np.array([func(x) for x in population])
        return fitness
    
    def update_mean(mean, step_size, new_mean):
        return mean + (new_mean - mean) * step_size
    
    def adapt_step_size(step_size, learning_rate, adaptation_rate, delta):
        return step_size * (1 + learning_rate * np.sqrt(delta / (dim + 1)) + adaptation_rate * np.mean(np.fabs(delta)))
    
    population_size = 100
    initial_population = generate_initial_population(dim, lb, ub, population_size)
    mean = np.mean(initial_population, axis=0)
    step_size = rng.uniform(low=0.01, high=10.0) ** (1 / dim)
    learning_rate = rng.uniform(low=0.5, high=2.0)
    adaptation_rate = rng.uniform(low=0.1, high=1.0)
    
    for _ in range(budget):
        clipped_population = clip_candidates(initial_population, lb, ub)
        fitness = evaluate_fitness(clipped_population, func)
        
        mean = update_mean(mean, step_size, np.mean(clipped_population, axis=0))
        delta = clipped_population - mean
        adaptation = np.sum(np.fabs(delta), axis=1)
        
        step_size = adapt_step_size(step_size, learning_rate, adaptation_rate, adaptation)
        
        initial_population = clipped_population + (np.eye(dim) * step_size).dot(rng.normal(size=(population_size, dim)))
    
    best_solution = mean
    return best_solution
