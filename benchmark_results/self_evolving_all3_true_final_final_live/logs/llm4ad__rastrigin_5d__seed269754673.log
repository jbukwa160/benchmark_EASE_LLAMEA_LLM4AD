def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def rastrigin(x):
        return func(x) + 10 * len(x)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = rastrigin(x)

    for _ in range(budget):
        y = x.copy()
        for i in range(dim):
            r1 = rng.randint(0, dim)
            while r1 == i:
                r1 = rng.randint(0, dim)
            r2 = rng.randint(0, dim)
            while r2 == i or r2 == r1:
                r2 = rng.randint(0, dim)

            mu = 0.5
            y[i] += (ub - lb) * np.random.uniform(-mu, mu)
        y = clip(y, lb, ub)

        f = rastrigin(y)

        if f < best_f:
            best_x = y.copy()
            best_f = f

        alpha = 0.1
        beta = 0.5
        p = np.random.uniform(0, 1)
        if p < alpha:
            for i in range(dim):
                r3 = rng.randint(0, dim)
                while r3 == i:
                    r3 = rng.randint(0, dim)
                y[i] += (ub - lb) * np.power(np.random.uniform(-beta, beta), 1 / (len(x) + 10))
            y = clip(y, lb, ub)

        x = y.copy()

    return best_x
