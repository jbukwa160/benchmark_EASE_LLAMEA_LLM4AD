def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    pso_params = {
        'c1': 2,
        'c2': 2,
        'w': 0.7,
        'v_max': 10,
        'v_min': -10,
        'num_particles': pop_size,
        'max_iter': budget // pop_size
    }
    
    sa_params = {
        'T_init': 100,
        'T_final': 1e-6,
        'alpha': 0.99,
        'beta': 20,
        'num_steps': int(budget * 0.2)
    }

    def initialize_particles():
        particles = np.random.uniform(lb, ub, size=(pso_params['num_particles'], dim))
        velocities = np.zeros((pso_params['num_particles'], dim))
        return particles, velocities

    def pso_step(particles, velocities):
        for i in range(pso_params['num_particles']):
            r1 = rng.uniform(0, 1)
            r2 = rng.uniform(0, 1)
            v = w * velocities[i] + c1 * r1 * (pbest[i] - particles[i]) + c2 * r2 * (gbest - particles[i])
            v = np.clip(v, pso_params['v_min'], pso_params['v_max'])
            particles[i] += v
        return particles

    def sa_step(particles):
        T = sa_params['T_init']
        for step in range(sa_params['num_steps']):
            idx = rng.randint(0, pso_params['num_particles'] - 1)
            x_new = particles[idx] + np.random.uniform(-sa_params['beta'], sa_params['beta']) / (T ** 0.5)
            x_new = np.clip(x_new, lb, ub)
            if func(x_new) < func(particles[idx]):
                particles[idx] = x_new
            else:
                T *= sa_params['alpha']
        return particles

    def calculate_pbest_gbest(particles):
        pbest = particles.copy()
        gbest = np.inf
        for i in range(pso_params['num_particles']):
            if func(particles[i]) < func(gbest):
                gbest = particles[i]
        return pbest, gbest

    particles, velocities = initialize_particles()
    best_particle = None
    for _ in range(budget):
        pbest, gbest = calculate_pbest_gbest(particles)
        for i in range(pso_params['num_particles']):
            if func(particles[i]) < func(gbest):
                gbest = particles[i]
        particles = sa_step(particles)

    return gbest
