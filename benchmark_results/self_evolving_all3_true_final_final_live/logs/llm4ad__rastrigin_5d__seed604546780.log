def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 1000
    elite_size = int(0.2 * pop_size)
    mut_rate = [0.01] * pop_size
    num_parents_mating = pop_size - elite_size
    num_generations = budget

    pop = np.random.uniform(lb, ub, (pop_size, dim))

    for gen in range(num_generations):
        fitness = np.array([func(x) for x in pop])

        if rng.rand() < 0.1:
            idxs = rng.choice(pop_size, elite_size, replace=False)
            pop[idxs] = np.random.uniform(lb, ub, (elite_size, dim))

        parents = np.empty((num_parents_mating, dim), dtype=np.float32)
        for i in range(num_parents_mating):
            idx1, idx2 = rng.choice(pop_size, 2, replace=False)
            if fitness[idx1] < fitness[idx2]:
                parents[i] = pop[idx1]
            else:
                parents[i] = pop[idx2]

        children = np.empty((num_parents_mating, dim), dtype=np.float32)

        for i in range(num_parents_mating):
            idx = rng.choice(pop_size)
            child = (parents[i] + pop[idx]) / 2.0
            children[i] = child

        for i in range(num_parents_mating):
            if rng.rand() < mut_rate[i]:
                children[i] += rng.normal(0, 1)

        new_pop = np.empty((pop_size, dim), dtype=np.float32)
        new_pop[:elite_size] = pop[:elite_size]
        new_pop[elite_size:] = children

        for i in range(num_parents_mating):
            idx = rng.choice(pop_size - elite_size, p=np.exp(-fitness / 10000.0))
            if fitness[idx] < func(new_pop[pop_size-i-1]):
                new_pop[pop_size-i-1] = pop[idx]

        mut_rate[:num_parents_mating] *= 0.99
        for i in range(num_parents_mating):
            idx = rng.choice(pop_size - elite_size)
            if rng.rand() < 0.05:
                mut_rate[i] += 0.01

        pop = new_pop

    best_idx = np.argmin([func(x) for x in pop])
    return pop[best_idx]
