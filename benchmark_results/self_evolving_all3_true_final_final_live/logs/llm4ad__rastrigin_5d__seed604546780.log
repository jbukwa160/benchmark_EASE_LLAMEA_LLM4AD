def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def objective(x):
        return func(x)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_obj = objective(x)

    for i in range(budget):
        y = clip(best_x + 0.5 * rng.normal(size=dim), lb, ub)
        alpha = np.random.choice([1.0, 0.9])
        z = clip(y + alpha * (y - x), lb, ub)

        if objective(z) < best_obj:
            best_x = z.copy()
            best_obj = objective(z)

    return best_x
