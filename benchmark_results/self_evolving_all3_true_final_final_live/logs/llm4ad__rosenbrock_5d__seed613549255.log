def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return func(x)

    def clip_candidate(candidate, lb, ub):
        clipped = []
        for i in range(dim):
            if candidate[i] < lb:
                clipped.append(lb)
            elif candidate[i] > ub:
                clipped.append(ub)
            else:
                clipped.append(candidate[i])
        return np.array(clipped)

    def differential_evolution(population, func, lb, ub, budget):
        for _ in range(budget):
            offspring = population + 0.5 * rng.randn(dim)
            fitness = [func(clip_candidate(individual, lb, ub)) for individual in offspring]
            indices = np.argsort(fitness)[:len(population)]
            population = [offspring[i] for i in indices]
        return population

    def cma_es(population, func, lb, ub, budget):
        weights = 0.5 * rng.randn(dim)
        weights /= np.linalg.norm(weights)

        for _ in range(budget):
            offspring = [population[0] + weights * rng.randn()]
            fitness = [func(clip_candidate(individual, lb, ub)) for individual in offspring]
            indices = np.argsort(fitness)[:len(population)]
            population = [offspring[i] if i == 0 else population[i] for i in indices]

        return population

    def hybrid_algorithm(func, dim, lb, ub, budget, rng):
        initial_population = lb + (ub - lb) * rng.rand(dim)

        population = differential_evolution(initial_population.tolist(), func, lb, ub, int(budget / 2))
        population = cma_es(population, func, lb, ub, int(budget / 2))

        return clip_candidate(np.array([np.mean(individual) for individual in population]), lb, ub)

    best_solution = hybrid_algorithm(Rosenbrock, dim, lb, ub, budget, rng)
    return best_solution
