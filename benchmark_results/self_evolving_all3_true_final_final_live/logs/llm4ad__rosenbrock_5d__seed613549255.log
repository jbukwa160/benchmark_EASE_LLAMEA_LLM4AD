    D = np.prod([ub[i] - lb[i] for i in range(dim)])
    n_samples = int(np.floor(budget / (1 + 0.1 * np.log(D))))
    
    sobol = qmc.Sobol(d=dim, scramble=True)
    samples = sobol.draw(n_samples) * D + lb
    
    best_x = None
    best_f = float('inf')
    
    for i in range(budget - n_samples):
        x_new = np.clip(samples[i % n_samples] + 0.1 * (ub - lb), a_min=lb, a_max=ub)
        
        f_new = func(x_new)
        
        if f_new < best_f:
            best_x = x_new
            best_f = f_new
            
        T = 10 / np.log(i/n_samples + 2)
        alpha = 0.95 * (1 - np.exp(-1/T))
        
        delta = func(x_new) - func(best_x)
        if delta < 0 or np.random.rand() < np.exp(-delta/T):
            samples[i % n_samples] = x_new
            
    return best_x
