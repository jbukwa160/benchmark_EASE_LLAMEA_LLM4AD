def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = 100
    cr = 0.9
    f = 1.5
    T = 10.0
    cooling_rate = 0.99

    x = rng.uniform(lb, ub, size=(pop_size, dim))
    best_x = np.min(x, axis=0)
    best_f = func(best_x)

    for i in range(budget):
        new_pop = []
        for _ in range(pop_size):
            idx1 = rng.randint(0, pop_size)
            idx2 = rng.randint(0, pop_size)
            idx3 = rng.randint(0, pop_size)
            v = clip(x[idx1] + cr * (x[idx2] - x[idx3]))
            new_pop.append(v)

        new_pop = np.array(new_pop)
        new_f = func(new_pop)

        for j in range(pop_size):
            if new_f[j] < best_f:
                best_x = new_pop[j]
                best_f = new_f[j]

            u = rng.uniform(0, 1)
            if u < 0.01:
                s = clip(best_x + np.sqrt(T) * rng.normal(size=dim))
                f_new = func(s)
                if f_new < best_f:
                    best_x = s
                    best_f = f_new

        T *= cooling_rate
        x = new_pop

    return best_x
