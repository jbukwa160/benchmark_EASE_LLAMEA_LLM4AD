def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for t in range(budget):
        # Sample a new point using LCMC acquisition function
        x = np.clip(lb + (ub - lb) * rng.uniform(size=dim), a_min=lb, a_max=ub)
        
        # Evaluate the objective function at the new point
        f = func(x)
        
        # Update best_x and best_f if a better solution is found
        if f < best_f:
            best_x = x.copy()
            best_f = f
        
    return best_x
