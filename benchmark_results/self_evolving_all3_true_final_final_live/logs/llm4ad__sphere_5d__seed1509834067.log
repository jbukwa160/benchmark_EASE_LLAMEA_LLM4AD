def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_f = float('inf')
    step_size = 1.0
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x
        if np.linalg.norm(x) > 5:
            step_size /= 2.0
        else:
            step_size *= 1.1
        if rng.random() > 0.9:
            step_size /= 1.1
    return np.clip(best_x, lb, ub)
