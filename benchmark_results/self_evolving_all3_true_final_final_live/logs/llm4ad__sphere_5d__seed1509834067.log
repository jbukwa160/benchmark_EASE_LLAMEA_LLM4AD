def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    T0 = 1e6
    alpha = 0.9

    for _ in range(budget):
        x_current = np.clip(x_best + (ub - lb) * rng.rand(dim), lb, ub)
        
        if rng.uniform(0, 1) < np.exp(-(func(x_current) - f_best) / T0):
            x_best = x_current
            f_best = func(x_best)

        T0 *= alpha

    return x_best
