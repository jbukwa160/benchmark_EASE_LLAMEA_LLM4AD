def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)
    
    for i in range(budget):
        x_new = x_best + (ub - lb) * (rng.rand(dim) - 0.5) * 2
        
        # Clip to bounds
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
            
    return x_best
