def algorithm(func, dim, lb, ub, budget, rng):
    def _check_bounds(x):
        return np.maximum(np.minimum(x, ub), lb)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        v = rng.uniform(-1, 0.5, size=dim) + _check_bounds(rng.uniform(lb, ub, size=dim))
        u = rng.permutation(dim)

        for j in range(dim):
            v[u[j]] += 0.7 * (best_x[u[j]] - x[u[j]])

        w = _check_bounds(x + v)
        f_w = func(w)

        if f_w < best_f:
            best_f = f_w
            best_x = w.copy()

    return best_x
