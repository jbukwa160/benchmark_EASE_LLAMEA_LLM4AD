def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        y = x + 0.1 * rng.randn(dim)
        y = clip(y, lb, ub)
        f = func(y)
        
        if f < best_f:
            best_f = f
            best_x = y.copy()
        
        sigma = 0.1 / np.sqrt(_ + 1)  # decay the standard deviation over time
        u = rng.randn(dim)
        z = best_x + sigma * u
        
        # update x with a non-uniform probability based on the local covariance matrix estimation
        prob = 1 / (dim * np.dot(u, np.linalg.solve(np.diag(sigma**2), u)))
        r = rng.rand()
        
        if r < prob:
            x = z.copy()
    
    return best_x
