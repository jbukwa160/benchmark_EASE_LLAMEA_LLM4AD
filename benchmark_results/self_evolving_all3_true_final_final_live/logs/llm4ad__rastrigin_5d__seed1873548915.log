def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=(1, dim))
    f_best = func(x_best)
    n_evals = 0

    while n_evals < budget:
        for _ in range(budget - n_evals):
            x_cand = rng.uniform(lb, ub, size=(1, dim))
            if func(x_cand) < f_best or np.random.rand() < (budget - n_evals) / (budget - 0):
                x_best = x_cand
                f_best = func(x_best)
        n_evals += budget - n_evals

    return x_best
