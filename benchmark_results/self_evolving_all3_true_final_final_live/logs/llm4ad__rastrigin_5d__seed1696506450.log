def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    D = np.array([1] * dim)
    mu = np.zeros(dim)
    sigma = 10.0
    C = np.eye(dim)
    best_x = None
    best_f = float('inf')

    for _ in range(budget):
        x = bound(mu + sigma * rng.randn(dim))
        f = func(x)

        if f < best_f:
            best_f = f
            best_x = x

        C = (1 - 2 / dim) * C + (1 / dim) * np.outer((x - mu), (x - mu))
        D = (1 - 0.1) * D + 0.1 * rng.randn(dim)
        sigma *= np.exp(1 / (4 + np.sqrt(_)))
        mu += sigma ** 2 * C @ D

    return best_x
