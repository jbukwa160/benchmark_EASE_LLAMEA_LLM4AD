def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x), x

    x_best = np.zeros(dim)
    f_best = float('inf')

    grid_size = 10
    step_size = (ub - lb) / grid_size
    num_grid_points = grid_size ** dim

    candidates = rng.uniform(lb, ub, size=(num_grid_points, dim))
    for i in range(num_grid_points):
        f, x = evaluate(candidates[i])
        if f < f_best:
            f_best = f
            x_best = x

    while budget > 0 and f_best > 0:
        grid_size *= 1.01
        step_size = (ub - lb) / grid_size
        num_grid_points = grid_size ** dim

        new_candidates = rng.uniform(lb, ub, size=(num_grid_points, dim))
        for i in range(num_grid_points):
            f, x = evaluate(new_candidates[i])
            if f < f_best:
                f_best = f
                x_best = x

        budget -= num_grid_points

    return x_best
