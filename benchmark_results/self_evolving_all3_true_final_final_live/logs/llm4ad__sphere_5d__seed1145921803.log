def algorithm(func, dim, lb, ub, budget, rng):
    def sample(bounds):
        return rng.uniform(bounds[0], bounds[1], (1, dim))

    def gp_mean(x):
        if x.shape[0] == 0:
            return None
        mean = np.zeros((x.shape[0],))
        for i in range(dim):
            mean += x[:, i]
        return mean / dim

    def lipschitz_optimize(gp_gp, bounds, budget):
        def gp(x):
            return -gp_gp.predict(np.atleast_2d(x).T)[0]

        best_x = None
        best_f = np.inf
        for _ in range(budget):
            x = sample(bounds)
            f = gp(x[0])
            if f < best_f:
                best_f = f
                best_x = x[0]
        return best_x, best_f

    x_best = sample((lb, ub))
    f_best = func(x_best)

    for _ in range(budget):
        x_new = sample((lb, ub))

        gp_gp = None
        if len(x_best) > 10:
            gp_gp = GaussianProcessRegressor(
                kernel=Matern(n_restarts_optimizer=5),
                n_restarts_optimizer=5,
                random_state=rng)

            gp_gp.fit(np.vstack(x_best), np.hstack([-func(xi) for xi in x_best]))

        if gp_gp is not None:
            f_new = -gp_gp.predict(np.atleast_2d(x_new).T)[0]
        else:
            f_new = func(x_new)

        if f_new < f_best:
            x_best = [x_new]
            f_best = f_new
        elif rng.uniform(0, 1) > np.exp(-f_new - f_best):
            x_best.append(x_new)
            f_best = min(f_best, f_new)

        x_best = [[clip(xi, lb, ub) for xi in x] for x in x_best]
        f_best = np.min([-func(xi) for xi in x_best])

    return np.array([x[0] for x in x_best])
