def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    for _ in range(budget):
        c = rng.uniform(-1, 1, size=dim)
        new_x = x + c * (ub - lb) / 2
        new_x = np.clip(new_x, lb, ub)
        if func(new_x) < func(x):
            x = new_x
    return x
