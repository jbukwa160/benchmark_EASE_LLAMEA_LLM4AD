def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        step_size = 1.0 / (1 + np.exp(-np.log(2) * (budget - _)/budget))
        new_x = rng.normal(loc=x, scale=step_size)
        new_x = np.clip(new_x, lb, ub)
        
        new_f = func(new_x)
        
        if new_f < best_f:
            x = new_x
            best_x = new_x.copy()
            best_f = new_f

    return best_x
