def algorithm(func, dim, lb, ub, budget, rng):
    best_x = rng.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        f = func(x)

        if f < best_f:
            best_f = f
            best_x = x

        step_size = 0.01 * (ub - lb)
        n_steps = int(np.sqrt(budget))
        for i in range(n_steps):
            for j in range(dim):
                x_plus_epsilon = best_x.copy()
                x_minus_epsilon = best_x.copy()

                if rng.random() < 0.5:
                    x_plus_epsilon[j] += step_size * rng.uniform(-1, 1)
                    f_plus = func(x_plus_epsilon)
                    if f_plus < best_f:
                        best_f = f_plus
                        best_x = x_plus_epsilon
                else:
                    x_minus_epsilon[j] -= step_size * rng.uniform(-1, 1)
                    f_minus = func(x_minus_epsilon)
                    if f_minus < best_f:
                        best_f = f_minus
                        best_x = x_minus_epsilon

    return best_x
