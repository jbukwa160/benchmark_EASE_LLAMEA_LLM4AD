def algorithm(func, dim, lb, ub, budget, rng):
    def rand(lb, ub):
        return lb + (ub - lb) * rng.uniform(0, 1)

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    best = np.zeros(dim)
    best_f = float('inf')
    for _ in range(budget):
        x = np.array([rand(lb, ub) for _ in range(dim)])
        f_x = func(x)
        if f_x < best_f:
            best_f = f_x
            best = x

        y = clip(best + 0.1 * rng.normal(size=dim), lb, ub)
        f_y = func(y)
        if f_y < best_f:
            alpha = rng.uniform(0, 1)
            beta = rng.uniform(0, 1)
            gamma = np.exp(-beta)
            x_new = clip(alpha * y + (1 - alpha) * best + gamma * rng.normal(size=dim), lb, ub)
            f_x_new = func(x_new)
            if f_x_new < best_f:
                best_f = f_x_new
                best = x_new

    return best
