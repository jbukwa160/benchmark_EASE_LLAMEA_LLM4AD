def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def rastrigin(x):
        x = [float(xi) for xi in x]
        return func(x) + 10 * len(x)

    pop_size = int(np.sqrt(budget))
    initial_guess = (ub - lb) * rng.rand(pop_size, dim) + lb

    best_candidate = clip(initial_guess[0])
    best_fitness = rastrigin(best_candidate)
    population = [clip(candidate) for candidate in initial_guess]

    iteration = 0
    while True:
        if iteration >= budget:
            break

        for i in range(pop_size):
            mutation_factor = rng.uniform(0.5, 1.5)
            crossover_prob = rng.uniform(0, 1)

            mutated_candidate = population[i]
            trial_candidate = clip(mutated_candidate + mutation_factor * (population[(i-1)%pop_size] - mutated_candidate))

            if rng.rand() < crossover_prob:
                for j in range(dim):
                    if rng.rand() < 0.5:
                        trial_candidate[j], mutated_candidate[j] = mutated_candidate[j], trial_candidate[j]

            trial_fitness = rastrigin(trial_candidate)

            if trial_fitness < best_fitness:
                best_candidate = trial_candidate
                best_fitness = trial_fitness

            population[i] = best_candidate if rng.rand() < 0.1 else trial_candidate

        iteration += 1

    return np.array(best_candidate)
