def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(budget):
        return rng.uniform(lb, ub, (budget, dim))

    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        return func(x)

    pop = generate_initial_population(budget)
    best = None
    for _ in range(budget):
        pop = clip(pop)
        fit = evaluate(pop)
        if budget == 1:
            break
        idx = rng.choice(len(fit), replace=False, size=len(fit))
        fit[idx] += 0.01 * rng.randn(len(idx))  # Add noise to avoid degenerate solutions
        idx_best = np.argmin(fit, axis=0)
        if best is None or fit[idx_best] < evaluate(clip(best)):
            best = pop[idx_best]
    return clip(best)
