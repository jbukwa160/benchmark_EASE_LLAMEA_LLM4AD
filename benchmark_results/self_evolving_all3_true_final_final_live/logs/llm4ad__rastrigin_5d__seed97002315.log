def algorithm(func, dim, lb, ub, budget, rng):
    def negative_func(x):
        return -func(x)

    x = lb + (ub - lb) * rng.uniform(size=dim)
    best_x = x.copy()
    best_f = func(best_x)
    
    for _ in range(budget):
        gp = GaussianProcessRegressor(kernel=1.0 * RBF(length_scale=1.0), alpha=1e-10)
        gp.fit(negative_func(np.array([best_x])), np.full(dim, 1))
        
        x_new = best_x + (ub - lb) * rng.normal(size=dim)
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        if f_new < best_f:
            best_x = x_new
            best_f = f_new
            
        X = np.vstack((negative_func(np.array([best_x])), negative_func(np.array([x_new]))))
        gp.fit(X, np.full(dim+1, 1))
        
        mu, sigma = gp.predict(negative_func(np.array([[0.0]*dim])), return_std=True)
        x_new = best_x + (ub - lb) * rng.normal(size=dim) * sigma
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        if f_new < best_f:
            best_x = x_new
            best_f = f_new
            
    return best_x
