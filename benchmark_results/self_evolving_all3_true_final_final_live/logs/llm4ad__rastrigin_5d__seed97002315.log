def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(1, dim))
    pop_size = 50
    sigma = 0.5
    for _ in range(budget):
        children = []
        for _ in range(pop_size):
            idx = random.sample(range(dim), 3)
            parent = x[0]
            child = parent.copy()
            for i in range(3):
                child[idx[i]] += rng.gauss(0, sigma)
            child = np.clip(child, lb, ub)
            children.append(child)
        scores = [func(child) for child in children]
        idx = np.argsort(scores)[:1]
        x[0] = children[idx[0]]
    return x[0]
