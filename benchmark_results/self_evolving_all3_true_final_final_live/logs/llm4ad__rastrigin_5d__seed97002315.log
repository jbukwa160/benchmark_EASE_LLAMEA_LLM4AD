def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 10 * dim
    x_best = -np.inf
    best_candidate = None
    pop = np.clip(rng.uniform(lb, ub, (pop_size, dim)), lb, ub)
    
    for _ in range(budget):
        y = pop.copy()
        
        for i in range(pop_size):
            r1, r2, r3 = rng.choice(pop_size, 3, replace=False)
            
            u = np.clip(pop[r1] + rng.uniform(-0.5, 0.5), lb, ub)
            v = np.clip(pop[r2] + rng.uniform(-0.5, 0.5), lb, ub)
            w = np.clip(pop[r3] + rng.uniform(-0.5, 0.5), lb, ub)
            
            y[i] = u + (v - u) * np.cos(2 * np.pi * rng.uniform(0, 1)) + (w - v) * np.cos(2 * np.pi * rng.uniform(0, 1))
        
        pop = np.clip(y, lb, ub)
        
        for i in range(pop_size):
            f_pop_i = func(pop[i])
            
            if f_pop_i < x_best:
                x_best = f_pop_i
                best_candidate = pop[i].copy()
                
            elif rng.uniform(0, 1) < 0.01 and f_pop_i < func(best_candidate):
                best_candidate = pop[i].copy()
    
    return np.array(best_candidate)
