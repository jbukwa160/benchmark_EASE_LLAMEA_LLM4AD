def algorithm(func, dim, lb, ub, budget, rng):
    def func_wrapper(x):
        return func(x)

    best_solution = np.random.uniform(lb, ub, size=dim)
    best_value = func_wrapper(best_solution)
    population_size = int(budget / (10 * dim))
    
    for i in range(1, int(budget)):
        new_population = np.zeros((population_size, dim))
        for j in range(population_size):
            new_population[j] = rng.uniform(lb, ub, size=dim)
        
        values = func_wrapper(new_population)
        solutions = np.argsort(values)[:int(population_size/10)]
        
        best_solution = new_population[solutions[0]]
        best_value = values[solutions[0]]

    return best_solution
