def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(budget):
        # Probabilistic global search
        if rng.rand() < 0.5:
            sigma = 1 / (i + 1)**(2/3) * rng.uniform(0, 1)
            new_x = x.copy()
            j = rng.randint(dim)
            new_x[j] += rng.normal(0, sigma)
            new_x = clip(new_x)
            f_new = func(new_x)
            
            # Update best solution
            if f_new < best_f:
                x = new_x
                best_x = new_x.copy()
                best_f = f_new
        
        # Deterministic local search
        else:
            for j in range(dim):
                alpha = rng.uniform(-1, 1)
                new_x = x.copy()
                new_x[j] += 0.01 * alpha
                new_x = clip(new_x)
                f_new = func(new_x)
                
                # Update best solution
                if f_new < best_f:
                    x = new_x
                    best_x = new_x.copy()
                    best_f = f_new
                    
    return best_x
