def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_pop = 50
    mu = n_pop / D
    sigma0 = (ub - lb) / 2.378
    lambda_ = int(n_pop * 1.16)
    c_c = 1 + 2 / (n_pop + 1.3)

    x = np.clip(rng.uniform(lb, ub, size=(D, n_pop)), a_min=lb, a_max=ub)[:, None]
    mu_x = np.mean(x, axis=0)[None, :]
    cov = sigma0 ** 2 * np.eye(D)
    ccov = np.zeros((D, D))

    for _ in range(budget):
        y = func(x)

        fbest = np.min(y)
        idx_best = np.argmin(y)
        x_best = x[:, idx_best]

        for _ in range(lambda_):
            e = rng.normal(size=(D,))
            z = mu_x + cov @ e
            z = np.clip(z, a_min=lb, a_max=ub)[None, :]
            yz = func(z)

            if np.min(yz) < fbest:
                idx_best = np.argmin(yz)
                x_best = z[:, idx_best]
                fbest = np.min(yz)

        cov = c_c * (1 - 1 / (D + lambda_)) * cov + e[idx_best] @ e[idx_best].T
        mu_x = (1 - 1 / (D + lambda_)) * mu_x + 1 / (D + lambda_) * x_best

    return x_best
