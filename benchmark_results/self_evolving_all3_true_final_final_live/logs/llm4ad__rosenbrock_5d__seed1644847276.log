def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_process(x, X, Y):
        sigma2 = 1e-8 + np.mean((Y - np.dot(X, x))**2)
        k = 1 / (sigma2 + np.sqrt(sigma2))
        return k * np.exp(-0.5 * np.sum(((X[:, None] - x[None, :])**2) / sigma2))

    def differential_evolution(x, X, Y):
        f_best = float('inf')
        best_idx = -1
        for i in range(len(X)):
            k = gaussian_process(x, X[i], Y[i])
            if k < 0.5:
                x_new = (X[i] * k + x) / (k + 1)
                f_new = func(x_new)
                if f_new < f_best:
                    f_best = f_new
                    best_idx = i
        return X[best_idx], Y[best_idx]

    X = rng.uniform(lb, ub, size=(budget, dim))
    Y = np.array([func(x) for x in X])
    for _ in range(budget):
        X_new, Y_new = differential_evolution(np.mean(X, axis=0), X, Y)
        Y = np.vstack((Y, func(X_new)))
        X = np.vstack((X, X_new))
    best_idx = np.argmin(Y[-budget:])
    return X[best_idx]
