def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    pop_size = 100
    pop = rng.uniform(lb, ub, (pop_size, dim))
    fitnesses = [func(bound(individual)) for individual in pop]

    for _ in range(budget):
        parents = []
        for _ in range(pop_size):
            idx1, idx2 = np.random.choice(pop_size, 2, replace=False)
            parent = bound(0.5 * pop[idx1] + 0.5 * pop[idx2])
            parents.append(parent)
        
        next_gen = []
        for parent in parents:
            child = parent.copy()
            for i in range(dim):
                if rng.random() < 0.01:  # mutation probability
                    child[i] += rng.uniform(-1, 1)
                if rng.random() < 0.05:  # crossover probability
                    idx2 = np.random.choice(pop_size)
                    parent2 = bound(0.5 * pop[idx2] + 0.5 * parent)
                    child[i] = (parent[i] + parent2[i]) / 2
            next_gen.append(bound(child))
        
        fitnesses = [func(individual) for individual in next_gen]
        idx_best = np.argmin(fitnesses)
        if fitnesses[idx_best] < fitnesses[np.argmin(fitnesses)]:
            pop = next_gen
            fitnesses = fitnesses
    return bound(pop[np.argmin(fitnesses)])
