def algorithm(func, dim, lb, ub, budget, rng):
    def crossover(x1, x2, v):
        return lb + (ub - lb) * 0.5 * (x1 + x2 + v)

    def mutate(x, v):
        return x + (ub - lb) * 0.01 * np.random.uniform(-1, 1, dim) * rng

    x = np.random.uniform(lb, ub, (budget, dim))
    y = np.zeros((budget, dim))

    for i in range(budget):
        v = np.zeros(dim)
        for j in range(budget):
            v += np.random.uniform(0, 1, dim) * rng
        x[i] = crossover(x[i], y[i], v)

        if i > 0:
            y[i-1] = mutate(x[i], v)

    return np.argmin(np.apply_along_axis(func, 1, x))
