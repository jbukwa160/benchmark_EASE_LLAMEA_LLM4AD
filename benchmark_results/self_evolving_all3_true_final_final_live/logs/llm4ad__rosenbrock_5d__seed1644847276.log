def algorithm(func, dim, lb, ub, budget, rng):
    def bound(candidates):
        return np.clip(candidates, lb, ub)

    def evaluate(candidate):
        return func(candidate)

    # Initial population
    pop_size = 50
    init_candidates = rng.uniform(lb, ub, (pop_size, dim))
    
    best_candidate = None
    best_fitness = float('inf')
    
    for _ in range(budget):
        fitnesses = np.array([evaluate(c) for c in bound(init_candidates)])
        
        if np.any(fitnesses < best_fitness):
            idxs = np.where(fitnesses < best_fitness)[0]
            init_candidates[idxs] = rng.uniform(lb, ub, (len(idxs), dim))
            
        # Differential Evolution
        mutants = init_candidates + 0.5 * rng.normal(0, 1, (pop_size, dim))[:, None] * \
                  (init_candidates[rng.randint(pop_size, size=(pop_size, 1)), :] - 
                   init_candidates[rng.randint(pop_size, size=(pop_size, 1)), :])
        
        # Simulated Annealing
        for i in range(pop_size):
            mutant = mutants[i]
            current_fitness = evaluate(bound(mutant))
            
            if current_fitness < fitnesses[i]:
                fitnesses[i] = current_fitness
                init_candidates[i] = mutant
                
            elif rng.rand() < np.exp((fitnesses[i] - current_fitness) / 10.0):
                fitnesses[i] = current_fitness
                init_candidates[i] = mutant
        
        if np.any(fitnesses < best_fitness):
            best_idx = np.argmin(fitnesses)
            best_candidate = bound(init_candidates[best_idx])
            best_fitness = fitnesses[best_idx]
    
    return best_candidate
