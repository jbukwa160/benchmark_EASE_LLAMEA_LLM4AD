def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(bounds):
        candidate = np.zeros(dim)
        for i in range(dim):
            candidate[i] = (ub - lb) * rng.uniform(0, 1) + lb
        return candidate
    
    def gaussian_process(X, Y, n_samples):
        mean = np.mean(Y)
        cov = np.cov(np.vstack([np.array(x).reshape(-1) for x in X]))
        
        K = np.zeros((len(X), len(X)))
        for i in range(len(X)):
            for j in range(i+1, len(X)):
                dist = np.linalg.norm(np.array(X[i]) - np.array(X[j]))
                covar = (np.exp(-dist**2) + 0.001)
                K[i, j] = covar
                K[j, i] = covar
        
        alpha = np.linalg.solve(K, Y - mean * np.ones(len(Y)))
        
        samples = []
        for _ in range(n_samples):
            sample = np.zeros(dim)
            for i in range(dim):
                dists = [np.linalg.norm(np.array(X[i]) - sample) for i in range(len(X))]
                covar = sum([K[i, j] * (1 + 0.001)**2 for i, j in enumerate(dists)])
                sample[i] = mean + np.sqrt(covar) * rng.gauss(0, 1)
            samples.append(sample)
        
        return samples
    
    X = []
    Y = []
    
    candidate = generate_candidate([(lb, ub)]*dim)
    X.append(candidate.tolist())
    Y.append(func(candidate))
    
    for _ in range(budget - 1):
        samples = gaussian_process(X, Y, 10)
        best_sample = min(samples, key=lambda x: func(np.array(x)))
        
        candidate = generate_candidate([(lb, ub)]*dim)
        if rng.uniform(0, 1) < 0.05:
            X.append(candidate.tolist())
            Y.append(func(candidate))
        else:
            X.append(best_sample)
            Y.append(func(best_sample))
    
    best_idx = np.argmin(Y)
    return np.array(X[best_idx])
