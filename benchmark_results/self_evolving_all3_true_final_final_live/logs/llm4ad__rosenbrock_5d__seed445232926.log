def algorithm(func, dim, lb, ub, budget, rng):
    n_iter = int(budget / (dim + 1))
    n_samples = 100 * dim
    
    # Define the acquisition function (expected improvement)
    def acqui(x):
        mean, var = func(x)
        return mean - np.sqrt(var) * norm.cdf(0)

    # Initialize BO
    x_best = lb + rng.uniform(size=dim) * (ub - lb)
    
    for _ in range(n_iter):
        # Draw samples from the GP
        x_samples = lb + rng.uniform(size=(n_samples, dim)) * (ub - lb)
        
        # Evaluate the acquisition function at these points
        y_acqui = np.array([acqui(x) for x in x_samples])
        
        # Select the point with the highest acquisition value
        idx_max = np.argmax(y_acqui)
        x_next = x_samples[idx_max]
        
        # Update the BO parameters (mean and variance)
        mean, var = func(x_next)
        
        # Update the best solution found so far
        if mean < func(x_best)[0]:
            x_best = x_next
    
    # Perform local search around the current best solution
    res_de = differential_evolution(func, [(lb, ub)] * dim, x0=x_best, maxiter=budget - n_iter * (dim + 1))
    
    return res_de.x
