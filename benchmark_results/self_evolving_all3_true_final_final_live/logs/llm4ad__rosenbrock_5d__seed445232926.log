def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        g = np.zeros(dim)
        for i in range(dim):
            x_copy = x.copy()
            x_copy[i] += 0.1
            g[i] = (func(x_copy) - best_f) / 0.1

        step_size = 0.01
        new_x = x + step_size * g / np.linalg.norm(g)
        new_x = np.clip(new_x, lb, ub)

        if func(new_x) < best_f:
            best_f = func(new_x)
            best_x = new_x.copy()

        # Grid search augmentation
        for i in range(dim):
            x_copy = x.copy()
            x_copy[i] += 0.01 * (g[i] / np.linalg.norm(g))
            if func(x_copy) < best_f:
                best_f = func(x_copy)
                best_x = x_copy.copy()

    return best_x
