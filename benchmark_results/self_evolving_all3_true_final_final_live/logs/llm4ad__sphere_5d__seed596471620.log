def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop = rng.uniform(lb, ub, (budget, dim))
    pop_best = np.array([func(clip(pop[0]))])

    for _ in range(budget - 1):
        diff = pop[np.random.choice(range(budget), size=3, replace=False)] - pop_best
        new_pop = pop + 0.5 * rng.uniform(-1, 1, (budget, dim))[:, np.newaxis] @ diff.T
        new_pop_best = func(clip(new_pop))
        idx = np.argsort(new_pop_best)[:1]
        pop[idx] = new_pop[idx]
        pop_best = np.min(np.append(pop_best, new_pop_best), axis=0)
    
    return clip(pop[np.argmin(pop_best)])
