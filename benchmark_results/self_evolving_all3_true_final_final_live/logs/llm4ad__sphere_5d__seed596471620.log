def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_fval = float('inf')
    
    for _ in range(budget):
        x = best_x + 0.1 * (ub - lb) * (rng.rand(dim) - 0.5)
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
        
        fval = func(x)
        
        if fval < best_fval:
            best_x = x
            best_fval = fval
            
        # Random restart with probability 0.1
        if rng.rand() < 0.1 and _ > budget // 10:
            best_x = np.zeros(dim)
            
    return best_x
