def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    max_iter = int(budget / pop_size)
    bounds = [(lb, ub)] * dim
    
    def mutation(x1, x2, x3):
        y = x1 + rng.uniform(-1, 1) * (x2 - x1)
        z = y + rng.uniform(-1, 1) * (x3 - y)
        return np.clip(z, lb, ub)
    
    pop = [rng.uniform(lb, ub) for _ in range(pop_size)]
    best = func(np.array([0.0] * dim))
    
    for i in range(max_iter):
        new_pop = []
        for j in range(pop_size):
            x1, x2, x3 = np.random.choice(pop, 3, replace=False)
            new_x = mutation(x1, x2, x3)
            new_pop.append(new_x)
        
        pop = new_pop
        for x in pop:
            if func(x) < best:
                best = func(x)
    
    return np.array([best])
