def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(-5, 5, size=dim)
    mean = x.copy()
    cov = 1.0 * np.eye(dim)
    lambda_ = 4 + dim
    sigma = 10

    for _ in range(budget):
        offspring = np.zeros((lambda_, dim))
        noise = rng.normal(size=(lambda_, dim))

        for i in range(lambda_):
            offspring[i] = mean + np.sqrt(cov).dot(noise[i])

        candidates = clip(offspring)
        fitnesses = func(candidates)

        indices = np.argsort(fitnesses)[:int(0.5 * lambda_)]

        new_mean = np.mean(candidates[indices], axis=0)
        new_cov = 1 + (lambda_ - 2) / (4 + dim) * cov

        for i in range(lambda_):
            if i not in indices:
                noise[i] *= np.sqrt((cov.dot(noise[i])**2).sum() / (new_cov.dot(noise[i]**2).sum()))
                new_mean += candidates[i][indices.sum():]

        mean = new_mean
        cov = new_cov

    return clip(mean)
