def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(dim, pop_size):
        return rng.uniform(lb, ub, (pop_size, dim))

    def differential_evolution(population, func, dim, bounds, budget):
        population = sorted(population, key=lambda x: func(x))
        best_candidate = population[0]
        
        for _ in range(budget):
            for i in range(len(population)):
                indices = np.random.choice(np.delete(range(len(population)), i), 3, replace=False)
                mutant = clip(best_candidate + rng.uniform(-1, 1, (dim,)) * 
                              (population[indices[0]] - population[indices[1]]))
                trial = clip(mutant + 0.5 * rng.uniform(0, 1, (dim,)))
                if func(trial) < func(best_candidate):
                    best_candidate = trial
            population[0] = best_candidate
        
        return population[0]
    
    initial_population = generate_initial_population(dim, budget*10)
    best_solution = differential_evolution(initial_population, func, dim, (lb, ub), budget)
    return best_solution
