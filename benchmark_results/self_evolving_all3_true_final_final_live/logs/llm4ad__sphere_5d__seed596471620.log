def algorithm(func, dim, lb, ub, budget, rng):
    def log_prior(x):
        return -0.5 * np.sum(np.log(2*np.pi)) - 0.5 * (x**2).sum()

    def log_likelihood(x):
        return func(x)

    def log_posterior(x):
        return log_likelihood(x) + log_prior(x)

    n = dim
    D = 1e-3  # initial step size
    T = budget
    x_best = np.zeros(n)
    f_best = float('inf')

    for t in range(T):
        for i in range(n):
            sigma = min(D, (t + 1) ** (-0.5))
            new_x = np.copy(x_best)
            new_x[i] += rng.normal(0, sigma)
            new_x = np.clip(new_x, lb, ub)

            f_new = log_posterior(new_x)
            if t == T-1 and i == n-1:  # last iteration, return best candidate
                return new_x

            alpha = np.exp(max(0, f_new - log_posterior(x_best)))
            if rng.uniform(0, 1) < alpha:
                x_best = new_x
                f_best = log_posterior(new_x)
        D *= 0.9

    return x_best
