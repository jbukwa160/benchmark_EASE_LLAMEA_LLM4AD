def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def objective(params):
        return func(clip(params))

    mean = np.zeros(dim)
    sigma = 5.0 * (ub - lb) / np.sqrt(np.log(budget))
    cov = np.eye(dim) * sigma**2

    for _ in range(budget):
        x = rng.multivariate_normal(mean, cov)
        y = objective(x)

        # Update covariance matrix
        mean = mean + 1/np.sqrt(budget) * (x - mean)
        cov = (1-1/budget)*cov + 1/np.sqrt(budget)*(x-mean)@(x-mean).T

    return clip(mean)
