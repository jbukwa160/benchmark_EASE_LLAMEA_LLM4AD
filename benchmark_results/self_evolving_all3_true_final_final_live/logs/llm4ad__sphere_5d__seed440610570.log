def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for _ in range(budget):
        x = np.clip(rng.normal(loc=np.zeros(dim), scale=1.0, size=dim), a_min=lb, a_max=ub)
        f = func(x)

        if f < best_f:
            best_f = f
            best_x = x

    return best_x
