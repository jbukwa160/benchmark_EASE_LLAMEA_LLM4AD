def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(-5.0, 5.0, size=dim)
    T = 10.0
    alpha = 0.99
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        new_x = x + rng.normal(size=dim) * 0.1
        new_x = np.clip(new_x, lb, ub)
        
        delta = func(new_x) - best_f
        
        if delta < 0:
            x = new_x.copy()
            best_x = new_x.copy()
            best_f = func(new_x)
        else:
            p = np.exp(-delta / T)
            r = rng.uniform(0.0, 1.0)
            
            if r < p:
                x = new_x.copy()
                
            T *= alpha

    return best_x
