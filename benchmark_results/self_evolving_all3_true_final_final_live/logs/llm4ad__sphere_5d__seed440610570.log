def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = func(x)
    for _ in range(budget):
        delta = 0.1 * (ub - lb)
        n_x = best_x + delta * rng.randn(dim)
        n_n_x = np.clip(n_x, lb, ub)
        n_n_f = func(n_n_x)
        if n_n_f < best_f:
            best_x = n_n_x
            best_f = n_n_f
        x = (ub - lb) * rng.rand(dim) + lb
    return best_x
