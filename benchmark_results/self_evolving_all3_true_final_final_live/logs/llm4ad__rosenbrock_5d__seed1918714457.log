            best_x = y
            best_f = f_y

        # Update step-size adaptation scheme
        sigma = max(1e-6, min(sigma_0 * (1 + step_size_adaptation_rate) ** (i / budget), sigma_0))

        # Compute CMA update
        for j in range(n):
            z_j = y[j] - x_mean[j]
            d[j] = np.sum(z * z_j)
            if abs(d[j]) > 1e-6:
                C[j, j] += (z_j ** 2) / d[j]

        # Update population
