def algorithm(func, dim, lb, ub, budget, rng):
    def gp_mean(x):
        return 0.0

    def gp_std(x):
        return 1.0

    def gp_sample(x):
        return rng.normal(loc=gp_mean(x), scale=gp_std(x))

    x_best = np.array([ub] * dim)
    f_best = float('inf')

    for _ in range(budget):
        X = []
        Y = []

        for i in range(dim):
            x = np.linspace(lb, ub, 100)[np.newaxis, :]

            if i > 0:
                x[:, :-1] = x_best[:-1]
            elif i == 0:
                x[:, 1:] = x_best[1:]

            X.append(x)
            Y.append(gp_sample(x))

        X = np.concatenate(X, axis=1)
        Y = np.concatenate(Y, axis=0)

        for _ in range(10):
            idx = rng.choice(budget + 1, size=min(100, budget - (_ + 1) * 10))
            x_new = np.array([X[i, idx] for i in range(dim)])

            f_new = func(x_new)
            if f_new < f_best:
                f_best = f_new
                x_best = x_new

        best_candidate = np.clip(x_best, lb, ub)

    return best_candidate
