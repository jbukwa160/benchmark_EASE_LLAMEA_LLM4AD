    n = dim
    D = 1.0 / (ub - lb)
    sigma_0 = 10 * D ** 2
    lam = int(np.sqrt(budget))
    mu = n
    step_size_adaptation_rate = 0.01

    # Initialize CMA-ES
    x_mean = np.array([lb + rng.random() * (ub - lb) for _ in range(n)])
    C = np.eye(n)
    d = np.zeros(n)

    for i in range(budget):
        # Sample candidates
        z = np.dot(C, rng.randn(n))
        y = x_mean + sigma_0 * z

        # Clip to bounds
        y = np.clip(y, lb, ub)

        # Evaluate function values and store best solution so far
        f_y = func(y)
