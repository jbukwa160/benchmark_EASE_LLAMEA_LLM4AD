def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_iter = 0
    T = 10000
    alpha = 1.05
    cooling_schedule = 'exponential'

    x = np.array(rng.random(D))
    x = np.clip(x, lb, ub)

    best_x = x.copy()
    best_y = func(x)
    current_best = True

    while n_iter < budget:
        if cooling_schedule == 'exponential':
            T *= alpha ** (n_iter / 1000)
        
        dx = rng.normal(size=D) * np.sqrt(T)
        x_new = x + dx
        x_new = np.clip(x_new, lb, ub)

        y_new = func(x_new)
        current_best = False

        if y_new < best_y:
            best_x = x_new.copy()
            best_y = y_new
            current_best = True

        if rng.random() < np.exp((best_y - y_new) / T):
            x = x_new.copy()

        n_iter += 1

    return best_x
