def algorithm(func, dim, lb, ub, budget, rng):
    def wrapper(x):
        return func(np.array([x]).T)

    bounds = [(lb, ub) for _ in range(dim)]
    result_de = differential_evolution(wrapper, bounds)
    x0 = result_de.x
    T = 1000.0
    alpha = 0.99

    for i in range(1, budget):
        y = np.clip(x0 + rng.uniform(-5, 5, dim), lb, ub)
        f_y = func(y)
        delta = (f_y - wrapper(x0)) / T

        if delta < 0 or rng.random() < np.exp(delta):
            x0 = y
        else:
            alpha *= rng.uniform(0.9, 1.1)
            T *= alpha

    return np.array([x0])
