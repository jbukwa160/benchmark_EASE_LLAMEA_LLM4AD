def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(size, dim):
        return np.random.uniform(lb, ub, (size, dim))

    def update_velocity(population, velocities, personal_best, global_best, c1, c2, lr):
        for i in range(len(population)):
            r1, r2 = rng.uniform(0, 1), rng.uniform(0, 1)
            velocities[i] += c1 * r1 * (personal_best[i] - population[i]) + c2 * r2 * (global_best - population[i])
        return velocities

    def update_position(population, velocities):
        for i in range(len(population)):
            population[i] += velocities[i]
            # Clip candidates to [lb, ub]
            np.clip(population[i], lb, ub, out=population[i])

    def calculate_fitness(population):
        fitness = np.zeros(len(population))
        for i in range(len(population)):
            fitness[i] = func(population[i])
        return fitness

    def update_personal_best(population, personal_best, fitness):
        for i in range(len(population)):
            if fitness[i] < fitness[np.argmin(fitness)]:
                personal_best[i] = population[i]

    def update_global_best(global_best, fitness):
        global_best[0] = np.argmin(fitness)
        return population[global_best[0]]

    def adaptive_lr(best_fitness, prev_best_fitness):
        if best_fitness < 1.5 * prev_best_fitness:
            return 0.5
        else:
            return 2

    # Initialize parameters
    num_particles = int(np.sqrt(budget))
    c1, c2 = 2, 2
    learning_rate = 0.5
    velocities = np.zeros((num_particles, dim))

    population = generate_initial_population(num_particles, dim)
    personal_best = population.copy()
    global_best = update_global_best(global_best=np.zeros(dim), fitness=calculate_fitness(population))
    prev_best_fitness = calculate_fitness([global_best])[0]

    for _ in range(budget):
        velocities = update_velocity(population, velocities, personal_best, global_best, c1, c2, learning_rate)
        population = update_position(population, velocities)

        fitness = calculate_fitness(population)
        best_fitness = np.min(fitness)
        if best_fitness < prev_best_fitness:
            global_best = update_global_best(global_best=np.zeros(dim), fitness=fitness)
            personal_best[best_fitness.argmin()] = population[best_fitness.argmin()]
            learning_rate = adaptive_lr(best_fitness, prev_best_fitness)

        prev_best_fitness = best_fitness

    return global_best
