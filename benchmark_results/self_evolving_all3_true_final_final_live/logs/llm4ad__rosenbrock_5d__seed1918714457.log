    x = np.random.uniform(lb, ub, size=(dim,))
    sigma = 1e-3 * (ub - lb)
    c_c = 2 / (dim + 1.25)
    c_m = (4 + 2/dim) / (dim + 1.25)
    c_1 = 1/(dim + 2)
    c_d = (5 + 8/dim)/len(func(x))
    
    cmu = np.zeros(dim)
    pc = np.eye(dim)
    d = np.diag(pc)
    mu = x
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = mu + sigma * rng.normal(size=mu.shape)
        z = np.clip(y, lb, ub)  # Clip to bounds

        f = func(z)
        
        if f < best_f:
            best_x = z.copy()
            best_f = f
        
        d = (1 - c_c) * d + c_c * pc
        cmu = (1 - c_m) * cmu + c_m * z
        mu = cmu / np.linalg.norm(cmu)
        
        delta_mu = z - mu
        sigma *= np.exp(c_d * (f - best_f))
        sigma = max(1e-5, min(sigma, 10))

    return best_x
