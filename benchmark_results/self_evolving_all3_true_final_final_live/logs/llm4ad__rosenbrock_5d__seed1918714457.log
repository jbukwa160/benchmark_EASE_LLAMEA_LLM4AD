def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def objective(params):
        clipped_params = clip(params, lb, ub)
        return func(clipped_params), clipped_params

    initial_guess = 0.5 * (ub + lb) + rng.uniform(size=dim) * (ub - lb)
    params = [initial_guess]
    scores = [objective(initial_guess)[0]]

    for _ in range(budget):
        new_params = []
        new_scores = []

        for param in params:
            noise = 0.1 * rng.uniform(size=dim)
            new_param = param + noise
            score, new_param = objective(clip(new_param, lb, ub))
            new_params.append(new_param)
            new_scores.append(score)

        scores.extend(new_scores)

        # Simulated Annealing (SA) part
        if len(params) < 10:
            for i in range(len(new_params)):
                if rng.uniform() < np.exp((scores[-1] - scores[i]) / len(scores)):
                    params[i] = new_params[i]
        else:
            # CMA-ES part with adaptive step size based on population diversity
            scores_diff = [score - min(scores[:-10]) for score in scores[-10:]]
            std_devs = np.std(scores_diff)
            if std_devs > 0.1 and len(params) >= 20:
                cma_step_size = 0.5 * (ub - lb) / std_devs
                new_params = [clip(param + rng.normal(loc=0, scale=cma_step_size, size=dim), lb, ub)
                              for param in params]
            else:
                new_params = new_scores

        params = new_params

    best_score_idx = np.argmin(scores)
    return params[best_score_idx], scores[best_score_idx]
