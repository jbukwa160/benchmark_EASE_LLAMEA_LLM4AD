def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return sum(100*(x[i+1]-x[i]**2)**2 + (1-x[i])**2 for i in range(dim))

    def f(x):
        x = np.clip(x, lb, ub)
        return func(x)

    D = dim
    mu = 0.5 * (ub - lb) / (1 + np.sqrt(D))
    s = mu * rng.normal(size=D)
    while budget > 0:
        x = np.clip(s, lb, ub)
        f_x = Rosenbrock(x)
        budget -= 1
        if f_x < func(s):
            s = x
        sigma = 1.01 ** (f_x - Rosenbrock(s)) * mu
        s += rng.normal(size=D, scale=sigma)
    return s
