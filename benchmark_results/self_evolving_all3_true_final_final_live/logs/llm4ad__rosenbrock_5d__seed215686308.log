def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        # Generate a new candidate solution by perturbing the current best
        x_new = x_best + rng.normal(0, 1e-2, size=dim)

        # Clip to bounds
        x_new = np.clip(x_new, lb, ub)

        # Evaluate new candidate and check if it's better than the current best
        f_new = func(x_new)
        if f_new < f_best:
            f_best = f_new
            x_best = x_new

    return x_best
