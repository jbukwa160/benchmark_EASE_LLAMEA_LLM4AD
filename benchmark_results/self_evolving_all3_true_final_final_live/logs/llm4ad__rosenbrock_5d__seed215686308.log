def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(size):
        return rng.uniform(lb, ub, size=(size, dim))

    def evaluate(population):
        scores = func(population)
        best_score = np.min(scores)
        best_candidate = population[np.argmin(scores)]
        return scores, best_score, best_candidate

    def update_variance(variance, step_size, improvement):
        if improvement:
            variance *= 1 + 0.01 * (np.linalg.norm(step_size) / np.sqrt(np.sum(variance)))
        return variance

    def cma_step(population, variances):
        scores, _, _ = evaluate(population)
        best_score = np.min(scores)
        mean = np.mean(population, axis=0)
        step_size = np.random.normal(0, 1, size=(dim,))
        new_population = population + step_size * (np.sqrt(variances)[:, None] * rng.randn(*population.shape))
        scores_new, best_score_new, _ = evaluate(new_population)
        improvement = best_score_new < best_score
        variance_update = update_variance(variances, step_size, improvement)
        return new_population, variance_update

    population_size = 10
    variances = np.ones(dim) * 1e-5
    restarts = 0
    while True:
        initial_population = clip(generate_initial_population(population_size))
        _, best_score, _ = evaluate(initial_population)
        for i in range(budget // population_size):
            new_population, variances = cma_step(initial_population, variances)
            _, best_score, _ = evaluate(new_population)
            if rng.uniform(0, 1) < 0.01: # small chance to restart
                break
        else:
            return clip(_[np.argmin(best_score)])

        initial_population = new_population
        restarts += 1

    return np.array([1] * dim)
