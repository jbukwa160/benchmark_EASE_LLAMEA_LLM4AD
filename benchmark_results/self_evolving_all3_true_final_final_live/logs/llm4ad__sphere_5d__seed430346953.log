def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        # Probability of exploration
        if rng.rand() < 0.5:
            # Random perturbation
            x_perturb = x + rng.uniform(-1, 1, (1, dim)) * 0.01
            x_perturb = np.clip(x_perturb, lb, ub)
            f_perturb = func(x_perturb)
        else:
            # Adaptive step size and direction
            grad = rng.uniform(size=dim) - 0.5
            step_size = 0.1 / (1 + np.linalg.norm(grad))
            x_new = x + step_size * grad
            x_new = np.clip(x_new, lb, ub)
            f_new = func(x_new)
        
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new
        
        # Update current solution with the better one
        if rng.rand() < 0.1 or f_perturb < best_f:
            x = x_perturb.copy()
        else:
            x = x_new.copy()
    
    return best_x[0]
