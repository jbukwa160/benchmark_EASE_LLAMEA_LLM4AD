def algorithm(func, dim, lb, ub, budget, rng):
    N = 10 * dim
    T = 1000 * N
    alpha = 0.99
    best_x = np.array([lb + (ub - lb) * rng.rand(dim)])
    best_y = func(best_x)
    
    for _ in range(budget):
        x_new = best_x.copy()
        
        # Simulated Annealing
        for i in range(N):
            step = alpha ** (_ / T) * np.array([lb + (ub - lb) * rng.rand(dim)])
            x_new += step
            
            # Clip candidates to [lb, ub]
            x_new = np.clip(x_new, lb, ub)
            
            y_new = func(x_new)
            
            if y_new < best_y:
                best_x, best_y = x_new, y_new
        
        # Pattern Search
        for i in range(dim):
            step = 0.5 * (ub - lb) * rng.choice([-1, 1])
            x_new = best_x.copy()
            x_new[i] += step
            
            # Clip candidates to [lb, ub]
            x_new[i] = np.clip(x_new[i], lb, ub)
            
            y_new = func(x_new)
            
            if y_new < best_y:
                best_x, best_y = x_new, y_new
                
    return best_x
