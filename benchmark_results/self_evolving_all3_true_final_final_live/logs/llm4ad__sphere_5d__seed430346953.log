def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(-5.0, 5.0, size=dim)
    x = clip(x)
    best_x = x.copy()
    best_f = func(x)
    current_budget = budget

    while current_budget > 0:
        for i in range(dim):
            candidate = clip(x + rng.normal(0, 2, size=dim))
            f = func(candidate)
            if f < best_f:
                best_x = candidate.copy()
                best_f = f
            acceptance_probability = np.exp((best_f - f) / current_budget)
            u = rng.uniform(0, 1)
            if u < acceptance_probability or (u >= acceptance_probability and rng.uniform(0, 1) < 0.01):
                x = candidate.copy()
        current_budget -= 1
    return best_x
