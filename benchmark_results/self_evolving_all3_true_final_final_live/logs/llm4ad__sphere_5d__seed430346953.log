def algorithm(func, dim, lb, ub, budget, rng):
    x = 5 * np.random.rand(dim) - 5
    T = 1000
    alpha = 0.99

    for _ in range(budget):
        f_x = func(x)
        e = np.zeros(dim)
        for i in range(dim):
            while True:
                noise = rng.normal(0, 1)
                y_i = x[i] + noise * (ub - lb) / 2
                if lb <= y_i <= ub:
                    e[i] = y_i
                    break
                elif y_i < lb:
                    e[i] = lb
                else:
                    e[i] = ub

            f_y = func(e)
            if f_y < f_x or rng.uniform(0, 1) < np.exp(-(f_y - f_x) / T):
                x = e.copy()
                f_x = f_y

        T *= alpha

    return x
