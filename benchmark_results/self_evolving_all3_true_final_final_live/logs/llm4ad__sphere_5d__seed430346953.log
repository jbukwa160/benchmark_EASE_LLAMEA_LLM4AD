def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(x):
        return x + 0.1 * np.random.uniform(-rng, rng, dim)

    def clip(candidate, lb, ub):
        clipped = np.clip(candidate, lb, ub)
        return np.where(np.isnan(clipped), 0, clipped)

    def sa_step(x, T):
        for _ in range(budget // 10):
            candidate = generate_candidate(x)
            candidate_clipped = clip(candidate, lb, ub)
            if func(candidate_clipped) < func(x):
                x = candidate_clipped
                T *= 0.9
            elif np.random.uniform(0, 1) < np.exp((func(x) - func(candidate_clipped)) / T):
                x = candidate_clipped
        return x

    x_best = np.zeros(dim)
    for _ in range(budget // 10):
        x_candidate = generate_candidate(x_best)
        x_candidate_clipped = clip(x_candidate, lb, ub)
        if func(x_candidate_clipped) < func(x_best):
            x_best = x_candidate_clipped
    T = 1.0
    for _ in range(9 * budget // 10):
        x_current = sa_step(x_best, T)
        if func(x_current) < func(x_best):
            x_best = x_current

    return x_best
