def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    x = np.zeros(dim)
    best_x = x.copy()
    best_f = float('inf')

    for i in range(budget):
        p = (i + 1) / budget
        step_size = rng.uniform(0.01, 2.5)
        if rng.random() < p:
            step_size *= 10

        new_x = clip(x + rng.normal(size=dim, loc=0, scale=step_size))

        f_new = func(new_x)

        if f_new < best_f:
            best_f = f_new
            best_x = new_x.copy()

        x = best_x.copy() + rng.normal(size=dim, loc=0, scale=0.1) * (rng.random(size=dim) - 0.5) * 2

    return best_x
