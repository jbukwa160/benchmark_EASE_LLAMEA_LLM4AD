def algorithm(func, dim, lb, ub, budget, rng):
    bounds = [(lb, ub) for _ in range(dim)]
    X = [rng.uniform(lb, ub) for _ in range(budget)]
    Y = [func(x) for x in X]
    GP = np.array(Y)
    
    for i in range(budget - 1):
        mean, var = norm.cdf(GP), (GP - mean)**2 / budget
        sigma = np.sqrt(var + 0.01)
        
        x_new = [(bounds[j][0] + bounds[j][1]) / 2 for j in range(dim)]
        for j in range(dim):
            if rng.uniform(0, 1) < (mean[j] - GP[j]) / (np.sqrt(sigma[j]**2 * np.exp(-GP[j]**2 / (2*sigma[j]**2)))) + 0.5:
                x_new[j] = rng.uniform(bounds[j][0], bounds[j][1])
        
        X.append(x_new)
        Y.append(func(x_new))
        GP = np.vstack((GP, Y[-1]))
    
    idx_best = np.argmin(GP)
    return np.array(X[idx_best])
