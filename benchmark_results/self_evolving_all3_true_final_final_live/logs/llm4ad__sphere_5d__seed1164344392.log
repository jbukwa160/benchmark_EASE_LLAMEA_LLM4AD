def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)
    while budget > 0:
        x_rand = np.random.uniform(lb, ub, size=dim)
        f_rand = func(x_rand)
        if f_rand < f_best:
            x_best = x_rand
            f_best = f_rand
        elif rng.rand() < (f_rand - f_best) / max(f_rand, 1e-6):
            x_best = (x_best + x_rand) / 2.0
            f_best = func(x_best)
        budget -= 1
    return x_best
