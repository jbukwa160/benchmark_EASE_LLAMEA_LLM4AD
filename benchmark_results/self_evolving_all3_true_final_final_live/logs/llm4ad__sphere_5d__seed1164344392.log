def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def sample_gaussian(mean, cov):
        return mean + rng.normal(size=dim) @ np.linalg.cholesky(cov)

    def evaluate(x):
        return func(clip(x))

    best_x = np.zeros(dim)
    best_f = float('inf')

    population_size = 100
    for i in range(budget // population_size):
        samples = sample_gaussian(np.zeros(dim), np.eye(dim))
        candidates = np.concatenate([np.expand_dims(sample, axis=0) for sample in samples])

        # Adapt the covariance matrix to the new samples
        cov = np.cov(candidates.T)
        adaptation_rate = 1 / (i + 1)

        # Update the best solution found so far
        current_best_f = min(evaluate(candidate) for candidate in candidates)
        if current_best_f < best_f:
            best_x = clip(np.mean(candidates, axis=0))
            best_f = current_best_f

    return best_x
