def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    y = x.copy()
    best_x = x
    best_y = func(x)

    for _ in range(budget):
        v = x + 0.5 * rng.uniform(-1, 1, size=dim)
        u = clip(v)
        z = (u + y) / 2

        f_z = func(z)
        if f_z < best_y:
            best_x = z
            best_y = f_z

        v = x + 0.5 * rng.uniform(-1, 1, size=dim)
        u = clip(v)
        w = (u + y) / 2

        f_w = func(w)
        if f_w < best_y:
            best_x = w
            best_y = f_w

        x = y.copy()
        for i in range(dim):
            v = rng.uniform(-1, 1)
            u = clip(best_x + v * (best_x - y))
            f_u = func(u)
            if f_u < best_y:
                y[i] = u
                break

    return best_x
