def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    def DE(pop_size, F, CR):
        pop = rng.uniform(lb, ub, size=(pop_size, dim))
        for _ in range(budget // 2):
            for i in range(pop_size):
                r1, r2, r3 = np.random.choice(pop_size, size=3, replace=False)
                u = clip(pop[r1] + F * (pop[r2] - pop[r3]))
                if rng.rand() < CR:
                    pop[i] = u
        return pop

    def SA(temp, cooling_rate):
        x = clip(rng.uniform(lb, ub, size=dim))
        for _ in range(budget // 4):
            temp *= cooling_rate
            y = clip(x + rng.normal(0, temp, size=dim))
            if func(y) < func(x):
                x = y
        return x

    pop_size = 20
    F = 0.5
    CR = 0.9
    temp = 10
    cooling_rate = 0.99

    pop = DE(pop_size, F, CR)
    best_x = np.min(pop, axis=0)

    for _ in range(budget // 4):
        x = SA(temp, cooling_rate)
        if func(x) < func(best_x):
            best_x = x

    return best_x
