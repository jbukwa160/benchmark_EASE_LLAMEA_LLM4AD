def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(pop_size, dim, lb, ub):
        return (ub - lb) * rng.rand(pop_size, dim) + lb

    def calculate_fitness(population, func):
        fitness = np.zeros((population.shape[0],))
        for i in range(population.shape[0]):
            fitness[i] = func(population[i])
        return fitness

    def select_parents(fitness, population, pop_size):
        indices = np.argsort(fitness)[:pop_size]
        return population[indices]

    def crossover(parents, pop_size):
        children = np.zeros((pop_size, dim))
        for i in range(pop_size):
            parent1_idx = rng.randint(0, parents.shape[0])
            parent2_idx = rng.randint(0, parents.shape[0])
            while parent2_idx == parent1_idx:
                parent2_idx = rng.randint(0, parents.shape[0])
            children[i] = (parents[parent1_idx] + parents[parent2_idx]) / 2
        return children

    def adaptive_mutation(children, fitness, population):
        mutation_rate = np.mean(fitness) / 100
        for i in range(children.shape[0]):
            if rng.rand() < mutation_rate:
                idx = rng.randint(0, dim - 1)
                children[i, idx] += (ub[idx] - lb[idx]) * rng.randn()
                children[i, idx] = np.clip(children[i, idx], lb, ub)
        return children

    population = generate_initial_population(budget, dim, lb, ub)
    for _ in range(100):
        fitness = calculate_fitness(population, func)
        parents = select_parents(fitness, population, int(budget / 2))
        children = crossover(parents, int(budget / 2))
        children = adaptive_mutation(children, fitness, population)
        population = np.concatenate((parents, children))

    best_individual_idx = np.argmin(calculate_fitness(population, func))
    return population[best_individual_idx]
