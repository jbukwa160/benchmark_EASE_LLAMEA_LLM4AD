def algorithm(func, dim, lb, ub, budget, rng):
    x_best = 0.5 * (ub + lb) * np.ones(dim)
    f_best = func(x_best)

    alpha_max = 1e-3
    alpha_min = 1e-6
    gamma = 0.9
    for t in range(budget):
        x_cand = x_best - alpha_max / (t + 2) * rng.uniform(-1, 1, dim)
        f_cand = func(np.clip(x_cand, lb, ub))
        
        if f_cand < f_best:
            x_best = np.copy(x_cand)
            f_best = f_cand
            
        alpha_max *= gamma

    return x_best
