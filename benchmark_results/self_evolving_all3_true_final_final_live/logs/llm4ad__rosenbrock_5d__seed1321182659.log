def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def func_eval(x):
        return func(x)[0]

    pop_size = 50
    X = rng.uniform(lb, ub, size=(pop_size, dim))
    Y = np.array([func_eval(clip(x)) for x in X])

    best_x = X[np.argmin(Y)]
    best_y = np.min(Y)

    sigma = 1.0
    t = budget

    while t > 0:
        for i in range(pop_size):
            z = rng.uniform(lb, ub, size=dim)
            v = np.clip(best_x + sigma * (z - best_x), lb, ub)
            y = func_eval(clip(v))

            if y < best_y:
                best_x = v
                best_y = y

        sigma *= 0.95
        t -= 1

    return best_x
