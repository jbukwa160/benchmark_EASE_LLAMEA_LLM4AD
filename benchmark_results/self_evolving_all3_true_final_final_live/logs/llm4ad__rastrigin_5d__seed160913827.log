def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    pop_size = 50
    pop = rng.uniform(lb, ub, (pop_size, dim))
    best = pop[np.argmin([func(clip(x)) for x in pop])]

    for i in range(budget):
        D = rng.normal(size=(pop_size, dim))
        new_pop = pop + 0.5 * D

        # BO part: sample around the best
        for j in range(pop_size):
            candidate = best + rng.normal(size=dim) / 10
            candidate = clip(candidate)
            new_pop[j] = np.where(rng.rand(dim) < 0.1, candidate, new_pop[j])

        # DE part: crossover and selection
        new_pop = np.array([clip(x) if func(clip(x)) < func(clip(y)) else y for x, y in zip(new_pop, pop)])
        new_best = new_pop[np.argmin([func(clip(x)) for x in new_pop])]

        # update best
        if func(clip(new_best)) < func(clip(best)):
            best = new_best

    return clip(best)
