def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    x_best = -np.ones(dim)
    f_best = 1e10
    alpha = 0.1
    step_size = 0.01
    iteration = 0

    while iteration < budget:
        iteration += 1
        x_current = x_best + rng.normal(0, step_size, dim)

        # clip to bounds
        x_current = np.clip(x_current, lb, ub)

        f_current = f(x_current)

        if f_current < f_best:
            x_best = x_current
            f_best = f_current

        # adaptive learning rate
        std_dev = 0.1 * (ub - lb)
        step_size *= np.exp(alpha * (f_current - f_best))

    return x_best
