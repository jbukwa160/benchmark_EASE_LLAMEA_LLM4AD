def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    n_gen = int(budget / pop_size)
    D = dim
    x_best = np.random.uniform(lb, ub, (pop_size, D))
    f_val = func(x_best)

    for _ in range(n_gen):
        for i in range(pop_size):
            u_idx, v_idx, w_idx = rng.choice(pop_size, size=3, replace=False)
            if rng.rand() < 0.1:
                x_new = x_best[u_idx] + rng.uniform(-1, 1) * (x_best[v_idx] - x_best[w_idx])
            else:
                x_new = x_best[i] + rng.uniform(0.5, 1.5) * (x_best[u_idx] - x_best[v_idx])

            x_new = np.clip(x_new, lb, ub)
            f_new = func(x_new)

            if f_new < f_val[i]:
                x_best[i] = x_new
                f_val[i] = f_new

    return x_best[np.argmin(f_val)]
