def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    for _ in range(budget):
        x_rand = lb + (ub - lb) * rng.rand(dim)
        f_rand = func(x_rand)
        if f_rand < func(x_best):
            x_best = x_rand
        delta = 0.1 * (x_best - x_rand)
        x_candidate = x_best + delta
        for i in range(dim):
            if np.random.rand() > 0.5:
                x_candidate[i] += rng.uniform(-1, 1) * delta[i]
        x_candidate = np.clip(x_candidate, lb, ub)
        f_candidate = func(x_candidate)
        if f_candidate < func(x_best):
            x_best = x_candidate
    return x_best
