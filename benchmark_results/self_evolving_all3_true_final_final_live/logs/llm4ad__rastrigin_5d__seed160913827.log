def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    f_best = float('inf')
    
    for i in range(budget):
        x_new = (ub - lb) * rng.rand(dim) + lb
        f_new = func(x_new)
        
        if f_new < f_best:
            x_best = x_new
            f_best = f_new
            
        # Stochastic Optimization via Unimodal Sampling
        delta = 2 / (i + 1)
        r = rng.rand(dim)
        s = (ub - lb) * np.sqrt(delta) * np.cos(np.pi*r) + lb
        
        x_s = (1 - delta) * x_best + delta * s
        f_s = func(x_s)
        
        if f_s < f_new:
            x_new = x_s
            f_new = f_s
            
    return x_best
