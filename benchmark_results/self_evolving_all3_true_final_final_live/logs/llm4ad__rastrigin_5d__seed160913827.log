def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def distance(x1, x2):
        return np.linalg.norm(x1 - x2)

    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(best_x)
    radius = 10 * (ub - lb) / dim

    for _ in range(budget):
        new_x = clip(best_x + rng.uniform(-radius, radius, size=dim))
        new_f = func(new_x)

        if new_f < best_f:
            best_x = new_x
            best_f = new_f

        radius *= 0.9

    return best_x
