def algorithm(func, dim, lb, ub, budget, rng):
    N = 5  # population size
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for i in range(budget):
        y = np.zeros(dim)
        for j in range(N):
            idx = rng.choice([k for k in range(N) if k != j])
            y[j] = x_best[idx] + 0.1 * (x_best[j] - x_best[idx]) * rng.uniform(-1, 1)

        y_clipped = np.clip(y, lb, ub)
        f_y = func(y_clipped)

        alpha = np.exp(-(i / budget)**2)
        if f_y < f_best:
            x_best = y_clipped
            f_best = f_y
        elif rng.uniform(0, 1) > alpha:
            x_best[j] = y_clipped[j]

    return x_best
