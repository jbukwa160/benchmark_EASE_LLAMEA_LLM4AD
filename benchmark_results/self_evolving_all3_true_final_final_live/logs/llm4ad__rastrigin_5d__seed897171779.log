def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 10  # initial population size
    population = [np.random.uniform(lb, ub, dim) for _ in range(pop_size)]
    best_individual = None
    best_fitness = float('inf')
    iterations = 0

    while iterations < budget:
        iteration_population = []
        iteration_best_fitness = float('inf')

        for individual in population:
            mutation_strategies = ['rand1', 'best1exp']
            chosen_strategy = rng.choice(mutation_strategies)

            if chosen_strategy == 'rand1':
                mutant_individual = individual + rng.uniform(-0.5, 0.5, dim)
                mutant_fitness = func(mutant_individual)
            elif chosen_strategy == 'best1exp':
                best_index = np.argmin([func(individual) for individual in population])
                best_individual_chosen = population[best_index]
                mutant_individual = best_individual_chosen + rng.uniform(-0.5, 0.5, dim)
                mutant_fitness = func(mutant_individual)

            iteration_mutant_individual = clip(mutant_individual, lb, ub)
            iteration_mutant_fitness = func(iteration_mutant_individual)

            if iteration_mutant_fitness < iteration_best_fitness:
                iteration_best_fitness = iteration_mutant_fitness
                iteration_best_individual = iteration_mutant_individual

            iteration_population.append(iteration_mutant_individual)

        population = [clip(individual, lb, ub) for individual in iteration_population]
        best_individual_chosen = np.argmin([func(individual) for individual in population])
        best_individual = population[best_individual_chosen]

        if func(best_individual) < best_fitness:
            best_fitness = func(best_individual)

        iterations += 1

    return best_individual
