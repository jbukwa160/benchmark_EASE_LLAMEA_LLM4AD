def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = 50
    x = (ub - lb) * rng.rand(pop_size, dim) + lb
    y = func(x)
    best_x = x[np.argmin(y)]
    best_y = np.min(y)

    for _ in range(budget):
        r1, r2, r3 = rng.randint(0, pop_size, 3)
        while r1 == r2 or r1 == r3 or r2 == r3:
            r1, r2, r3 = rng.randint(0, pop_size, 3)

        p = (ub - lb) * rng.rand(dim) + lb
        for i in range(dim):
            p[i] += (x[r1, i] - x[r2, i]) / np.abs(x[r1, i] - x[r2, i])
            if np.random.rand() < 0.5:
                p[i], x[r3, i] = x[r3, i], p[i]

        p = clip(p)
        y_p = func(p)
        if y_p < best_y:
            best_x = p
            best_y = y_p

    return best_x
