def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def fitness(x):
        return func(x)

    x = np.array([0] * dim)
    best_x = np.array([0] * dim)
    best_fitness = float('inf')

    for i in range(budget):
        # DE phase
        population_size = 10
        population = rng.uniform(lb, ub, size=(population_size, dim))
        population = clip(population)

        fitness_values = np.array([fitness(individual) for individual in population])
        best_individual = population[np.argmin(fitness_values)]

        if fitness(best_individual) < best_fitness:
            best_x = best_individual
            best_fitness = fitness(best_individual)

        # Nelder-Mead Simplex Search phase
        simplex_size = 15
        simplex = rng.uniform(lb, ub, size=(simplex_size, dim))
        simplex = clip(simplex)

        centroid = np.mean(simplex, axis=0)
        centroid = clip(centroid)

        for j in range(simplex.shape[0]):
            if fitness(simplex[j]) < best_fitness:
                best_x = simplex[j]
                best_fitness = fitness(best_x)

    return best_x
