def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    init_x = rng.uniform(lb, ub, size=dim)
    x = clip(init_x.copy())
    
    T = 1.0
    alpha = 0.99
    
    for _ in range(budget):
        y = x + rng.normal(0, 0.5, size=dim)
        y = clip(y)
        
        delta_f = func(y) - func(x)
        if delta_f < 0:
            x = y
        else:
            T *= alpha
            prob = np.exp(-delta_f / T)
            if rng.rand() < prob:
                x = y
                
    return x
