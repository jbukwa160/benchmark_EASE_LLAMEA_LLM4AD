def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    
    for _ in range(budget):
        improvement = 0
        idx = None
        
        for i in range(dim):
            x_new = np.copy(x)
            
            # Clip candidate to [lb, ub]
            x_candidate = lb + (ub - lb) * rng.uniform(size=1)[0] if rng.uniform(size=1)[0] < 0.5 else ub - (ub - lb) * rng.uniform(size=1)[0]
            
            x_new[i] = x_candidate
            f_new = func(x_new)
            
            # Clip new candidate to [lb, ub]
            x_new = np.clip(x_new, lb, ub)
            
            if f_new < func(x):
                improvement = 10 ** rng.uniform(size=1)[0] * (f_new - func(x))
                idx = i
        
        if improvement > 0:
            x[idx] = x_candidate
            # Clip new candidate to [lb, ub]
            x = np.clip(x, lb, ub)
    
    return np.array([np.round(i, 5) for i in x])
