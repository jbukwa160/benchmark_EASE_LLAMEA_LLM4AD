def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    x = np.random.uniform(low=lb, high=ub, size=(dim,))
    T = 1.0
    alpha = 0.99

    for _ in range(budget):
        new_x = clip(x + rng.randn(dim) * 0.01)
        f_new = func(new_x)
        f_curr = func(x)

        if f_new < f_curr:
            x = new_x
        else:
            prob = np.exp((f_curr - f_new) / T)
            if prob > rng.uniform():
                x = new_x

        T *= alpha

    return clip(x)
