def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 0.5 * (ub - lb)
    n_dim = dim
    n_init = 1
    n_max = 10000
    t = 0
    pop_size = int(n_init + min(1, t / n_max) * (n_max - n_init))
    x_best = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    f_best = func(x_best)
    pop = [x_best]
    
    while t < budget and len(pop) <= pop_size:
        y = []
        
        for _ in range(pop_size - len(pop)):
            x = np.array(pop[-1])
            mu = rng.uniform(-sigma, sigma)
            
            if rng.random() > 0.5:
                # local random search
                x += np.array([rng.uniform(lb, ub) for _ in range(dim)])
                
                # clip to bounds
                x = np.clip(x, lb, ub)
                
            else:
                # adaptive radius mutation
                mu *= 2 ** rng.gauss(0, 1)
                x += np.array([mu * rng.uniform(-1, 1) for _ in range(dim)])
                
                # clip to bounds
                x = np.clip(x, lb, ub)
                
            y.append(x)
        
        pop.extend(y)
        z = sorted(pop, key=func)[:pop_size]
        pop = z
        
        t += len(z) - len(pop)
        
        if func(z[0]) < f_best:
            x_best = z[0]
            f_best = func(z[0])
    
    return x_best
