def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.minimum(np.maximum(x, lb), ub)

    class Particle:
        def __init__(self, pos, vel, best_pos):
            self.pos = pos
            self.vel = vel
            self.best_pos = best_pos

    def generate_particles(num_particles, dim, rng):
        particles = []
        for _ in range(num_particles):
            particle = Particle(
                np.clip(rng.uniform(lb, ub, size=dim), lb, ub),
                np.zeros(dim),
                np.clip(rng.uniform(lb, ub, size=dim), lb, ub)
            )
            particles.append(particle)
        return particles

    def update_particles(particles, c1, c2):
        for particle in particles:
            r1, r2 = rng.uniform(0, 1, size=2)
            vel = (c1 * rng.uniform(0, 1) * (particle.best_pos - particle.pos)) + \
                  (c2 * rng.uniform(0, 1) * (global_best.pos - particle.pos))
            particle.vel = clip(particle.vel + vel, -5.0, 5.0)
            particle.pos = clip(particle.pos + particle.vel, lb, ub)

    def evaluate_particles(particles):
        scores = [func(particle.pos) for particle in particles]
        return np.array(scores), np.argmax(scores)

    num_particles = 50
    c1, c2 = 2.0, 2.0

    global_best = Particle(np.zeros(dim), np.zeros(dim), np.clip(rng.uniform(lb, ub, size=dim), lb, ub))
    particles = generate_particles(num_particles, dim, rng)

    for i in range(budget):
        update_particles(particles, c1, c2)
        scores, best_idx = evaluate_particles(particles)
        if scores[best_idx] < global_best.best_pos.fun:
            global_best.pos = particles[best_idx].pos
            global_best.best_pos = particles[best_idx].pos

    return global_best.best_pos
