def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(dim,))
    pop_size = 10 * dim
    sigma = 0.5
    cov = np.eye(dim)
    mu = np.zeros((dim,))
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        z = rng.normal(size=(pop_size, dim))
        y = mu + sigma * np.dot(z, np.linalg.cholesky(cov))

        # Clip to bounds
        y = np.clip(y, lb, ub)

        f_values = func(y)
        idxs = np.argsort(f_values)[:1]

        for i in range(pop_size):
            if i in idxs:
                x = y[i]
                best_f = min(best_f, f_values[i])
                mu = 0.2 * (x - mu) + 0.8 * mu
                cov = (0.3 * np.eye(dim)) + 0.7 * np.dot((x - mu), (x - mu).T)
            else:
                x_candidate = y[i]
                f_candidate = func(x_candidate)

                # Adaptive mutation strategy
                if f_candidate < best_f:
                    sigma *= 1.2
                    x = x_candidate
                    best_f = min(best_f, f_values[i])
                    mu = 0.2 * (x - mu) + 0.8 * mu
                    cov = (0.3 * np.eye(dim)) + 0.7 * np.dot((x - mu), (x - mu).T)
                else:
                    sigma *= 0.5

    return best_x
