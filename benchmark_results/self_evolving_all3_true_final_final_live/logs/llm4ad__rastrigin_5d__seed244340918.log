def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 10 / np.sqrt(dim)
    mu = np.zeros(dim)

    for i in range(budget):
        if i % 100 == 0:
            # Global restart every 100 iterations
            sigma *= 1.2
            mu = np.clip(rng.normal(size=dim, loc=ub + (ub - lb) / 2, scale=sigma), lb, ub)

        offspring = np.clip(mu + rng.normal(size=(10 * dim, dim), loc=0, scale=sigma), lb, ub)
        fitness = func(offspring)

        if i == 0 or np.any(fitness < func(np.clip(mu, lb, ub))):
            mu = offspring[np.argmin(fitness)]
            sigma *= 0.2

    return np.clip(mu, lb, ub)
