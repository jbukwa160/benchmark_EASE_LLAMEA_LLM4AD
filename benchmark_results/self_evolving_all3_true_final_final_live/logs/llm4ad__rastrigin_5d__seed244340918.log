def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_y = float('inf')
    
    for _ in range(budget // 10):
        x = rng.uniform(lb, ub, size=dim)
        
        if func(x) < best_y:
            best_y = func(x)
            best_x = x
            
        for _ in range(9):
            y = rng.uniform(lb, ub, size=dim)
            
            if np.linalg.norm(y - best_x) > 0.5 and func(y) < best_y:
                best_y = func(y)
                best_x = y
                
    return best_x
