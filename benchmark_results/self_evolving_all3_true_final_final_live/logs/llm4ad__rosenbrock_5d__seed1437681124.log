def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    population_size = 50
    initial_population = rng.uniform(lb, ub, (population_size, dim))
    temperature = 1000.0
    cooling_rate = 0.99

    for _ in range(budget):
        objective_values = func(initial_population)
        best_individual = np.argmin(objective_values)

        # Simulated Annealing (SA) phase
        current_temperature = temperature
        while current_temperature > 1e-6:
            perturbation = rng.normal(size=dim)
            new_individual = clip(initial_population[best_individual] + perturbation * 0.5)
            new_objective_value = func(new_individual)

            if np.exp((objective_values[best_individual] - new_objective_value) / current_temperature) > rng.uniform(0, 1):
                initial_population[best_individual] = new_individual
                objective_values[best_individual] = new_objective_value

            current_temperature *= cooling_rate

        # Differential Evolution (DE) phase
        for i in range(population_size):
            differences = initial_population - initial_population[i]
            perturbation = rng.normal(size=dim)
            new_individual = clip(initial_population[i] + 0.5 * perturbation * differences[best_individual])
            new_objective_value = func(new_individual)

            if new_objective_value < objective_values[best_individual]:
                initial_population[i] = new_individual
                objective_values[i] = new_objective_value

    return initial_population[np.argmin(objective_values)]
