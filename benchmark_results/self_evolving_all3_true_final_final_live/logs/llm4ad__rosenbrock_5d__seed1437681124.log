def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(x, sigma, d):
        z = np.random.normal(size=d)
        return x + sigma * z

    def sample_sigma(sigma, mu, target):
        n = 1.0 / (np.sum((x - target) ** 2) + 1e-8)
        return sigma * n

    def cma_es(x_best, func, dim, lb, ub, budget):
        lambda_ = int(np.ceil(dim ** 2))
        mu = x_best
        sigma0 = 0.5
        sigma = sigma0
        d = np.eye(dim) / (lambda_ - 1)
        c_m = 0.75
        c_c = 1.0
        c_1 = 2.0

        for _ in range(budget):
            x_new = mutate(mu, sigma, dim)

            # Clip candidates to [lb, ub]
            x_new = np.clip(x_new, lb, ub)

            f_new = func(x_new)
            if f_new < func(mu):
                mu = x_new
                sigma = sample_sigma(sigma0, mu, mu)
                d = (1 - c_m) * d + c_m * (np.outer(x_new - mu, x_new - mu)) / (lambda_ - 1)

        return mu

    x_best = np.random.uniform(size=dim, low=lb, high=ub)
    best_x = cma_es(x_best, func, dim, lb, ub, budget)
    return best_x
