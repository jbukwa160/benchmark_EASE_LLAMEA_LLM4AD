def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    T0 = 1000
    alpha = 0.99
    T = T0
    accepted = []
    
    for _ in range(budget):
        candidate = clip(x + rng.uniform(-1, 1, size=dim))
        f_candidate = func(candidate)
        f_x = func(x)
        
        delta_f = f_candidate - f_x
        
        if delta_f <= 0:
            x = candidate
            accepted.append(1)
        else:
            prob = np.exp(-delta_f / T)
            if rng.random() < prob:
                x = candidate
                accepted.append(1)
            else:
                accepted.append(0)
        
        T *= alpha
        
    best_x = x.copy()
    for _ in range(budget // 10):
        i = rng.randint(dim)
        candidate = clip(best_x.copy())
        candidate[i] += rng.uniform(-1, 1)
        f_candidate = func(candidate)
        if f_candidate < func(best_x):
            best_x = candidate
    
    return best_x
