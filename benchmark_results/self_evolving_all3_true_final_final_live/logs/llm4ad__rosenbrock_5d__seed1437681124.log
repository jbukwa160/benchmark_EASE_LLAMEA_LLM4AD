def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def generate_population(size, dim, lb, ub):
        return (lb + (ub - lb) * rng.uniform(0, 1, size))[:, None].repeat(dim, axis=1)

    current_best = np.array([1.]*dim)
    for _ in range(budget):
        new_solution = generate_population(size=10, dim=dim, lb=lb, ub=ub)
        new_solution = clip(new_solution, lb, ub)
        new_fitness = func(new_solution)

        if rng.uniform(0, 1) < np.exp((current_best[-new_fitness] - new_fitness) / 100):
            current_best = new_solution

    return current_best
