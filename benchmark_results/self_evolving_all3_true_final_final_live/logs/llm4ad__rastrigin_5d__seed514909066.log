def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(x):
        child = x + 0.1 * (ub - lb) * rng.rand(dim)
        return child

    def crossover(parent1, parent2):
        child = (parent1 + parent2) / 2
        return child

    best_x = np.zeros(dim)
    best_f = float('inf')
    current_x = clip(rng.uniform(lb, ub, size=dim))
    current_f = func(current_x)

    T = budget * 10

    for i in range(budget):
        new_x = generate_candidate(current_x)
        new_f = func(clip(new_x))

        if new_f < current_f:
            current_x = new_x
            current_f = new_f

            if new_f < best_f:
                best_x = current_x.copy()
                best_f = new_f

        elif np.random.rand() < np.exp((current_f - new_f) / T):
            current_x = new_x
            current_f = new_f

        T *= 0.99  # adaptive cooling schedule

    return best_x
