def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    x0 = (ub + lb) / 2 * np.ones(n)
    sigma = (ub - lb) / 10
    t_max = int(budget / (n ** 2))
    
    best_x = x0.copy()
    best_f = func(x0)
    
    for t in range(t_max):
        x_new = x0 + rng.normal(size=n) * sigma
        f_new = func(np.clip(x_new, lb, ub))
        
        if f_new < best_f:
            best_f = f_new
            best_x = x_new.copy()
            
        alpha = min(1 - (t / t_max), 0.02)
        sigma *= np.exp(alpha * rng.uniform(-1, 1))
        
    return best_x
