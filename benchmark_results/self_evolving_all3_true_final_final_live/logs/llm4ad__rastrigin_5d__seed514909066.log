def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = f(x_best)

    sigma = 1.
    iter_count = 0
    while iter_count < budget:
        iter_count += 1

        # SA exploration
        delta = rng.normal(size=dim) * sigma
        x_new = x_best + delta
        x_new = np.clip(x_new, lb, ub)
        f_new = f(x_new)

        if f_new <= f_best:
            x_best = x_new
            f_best = f_new

        # CMA-ES adaptation
        weights = 1. / (1 + rng.uniform(size=dim))
        sigma *= np.exp((f_new - f_best) * 0.01)
        delta = rng.normal(size=dim)

        if iter_count % 10 == 0:
            x_cma = x_best + np.dot(delta, weights)
            x_cma = np.clip(x_cma, lb, ub)
            f_cma = f(x_cma)

            if f_cma < f_best:
                x_best = x_cma
                f_best = f_cma

    return x_best
