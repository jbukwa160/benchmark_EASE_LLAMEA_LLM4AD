def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def generate_initial_population(dim, lb, ub, rng):
        return rng.uniform(lb, ub, size=(budget, dim))

    def calculate_fitness(population, func):
        fitness = [func(individual) for individual in population]
        return np.array(fitness)

    def select_parents(population, fitness, budget):
        indices = np.argsort(fitness)[:budget]
        parents = population[indices]
        return parents

    def crossover(parent1, parent2, rng):
        child = parent1.copy()
        mask = rng.choice([True, False], size=dim)
        for i in range(dim):
            if mask[i]:
                child[i] += (parent2[i] - parent1[i]) * rng.uniform(0, 1)
        return child

    def local_search(individual, func, dim, lb, ub, rng):
        while True:
            perturbation = rng.uniform(-1, 1, size=dim) * 0.01
            new_individual = individual + perturbation
            new_individual = clip(new_individual, lb, ub)
            if func(new_individual) < func(individual):
                individual = new_individual
            else:
                break
        return individual

    population = generate_initial_population(dim, lb, ub, rng=rng)
    fitness = calculate_fitness(population, func)

    for i in range(budget - 1):
        parents = select_parents(population, fitness, budget)
        children = []
        for j in range(int(0.5 * budget)):
            parent1, parent2 = rng.choice(parents, size=2, replace=False)
            child = crossover(parent1, parent2, rng=rng)
            child = local_search(child, func, dim, lb, ub, rng=rng)
            children.append(child)
        population[-1] = np.mean(children, axis=0)
        fitness = calculate_fitness(population, func)

    best_individual = select_parents(population, fitness, 1)[0]
    return clip(best_individual, lb, ub)
