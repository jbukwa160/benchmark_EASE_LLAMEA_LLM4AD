def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    best = None
    while True:
        mu = 1 + (ub - lb) * rng.uniform(0, 1)
        sigma = 1 + (ub - lb) / 2 * rng.uniform(0, 1)
        for _ in range(budget):
            x = clip(mu + sigma * np.clip(rng.normal(size=dim), -1, 1))
            f_x = func(x)
            if best is None or f_x < func(best):
                best = x
        budget *= 2
    return best
