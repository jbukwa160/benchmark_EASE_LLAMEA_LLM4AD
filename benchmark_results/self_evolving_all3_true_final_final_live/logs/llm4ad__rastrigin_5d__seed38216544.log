def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.minimum(np.maximum(candidate, lb), ub)

    best_x = np.zeros(dim)
    best_f = float('inf')

    n_samples_dim = [1] * dim
    while True:
        if len(n_samples_dim) == budget:
            break

        x = rng.uniform(lb, ub, size=dim)
        x = clip(x)

        f = func(x)

        if f < best_f:
            best_x = x
            best_f = f

        for i in range(dim):
            n_samples_dim[i] += 1
            new_x = np.copy(x)
            new_x[i] = rng.uniform(lb, ub)
            new_x = clip(new_x)

            new_f = func(new_x)

            if new_f < best_f:
                x = new_x
                f = new_f

        n_samples_dim[0] *= 2
        for i in range(1, dim):
            n_samples_dim[i] = min(n_samples_dim[i], n_samples_dim[i-1])

    return best_x
