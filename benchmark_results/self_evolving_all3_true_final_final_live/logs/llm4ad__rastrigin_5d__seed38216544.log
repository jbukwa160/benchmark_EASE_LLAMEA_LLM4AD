def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x), x

    population_size = 50
    num_iterations = int(budget / (population_size * dim))
    initial_temperature = 1000.0
    cooling_rate = 0.99
    best_solution = None
    best_value = np.inf

    for i in range(num_iterations):
        X = rng.uniform(lb, ub, size=(population_size, dim))
        X_clipped = clip(X)
        
        for _ in range(dim):
            Y = X.copy()
            indices = rng.choice(population_size, size=3, replace=False)
            Y[indices] += 0.1 * (X[indices] - X[rng.randint(0, population_size), :])
            Y_clipped = clip(Y)
            Y_values, _ = evaluate(Y_clipped)

        for j in range(population_size):
            if Y_values[j] < best_value:
                best_solution = Y_clipped[j]
                best_value = Y_values[j]

        temperature = initial_temperature * (cooling_rate ** i)
        alpha = rng.uniform(0, 1)
        
        if np.random.rand() < alpha or Y_values[j] <= best_value + (temperature / best_value):
            X[rng.randint(0, population_size), :] = Y_clipped[j]

    return best_solution
