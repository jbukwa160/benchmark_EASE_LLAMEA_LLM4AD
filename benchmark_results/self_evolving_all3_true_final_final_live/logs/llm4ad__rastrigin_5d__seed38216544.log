def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    n_dim = dim
    sigma = 10.0 / (n_dim ** 2)
    mu = np.zeros(n_dim)
    x_best = np.zeros(n_dim)
    f_best = float('inf')
    temp = 1.0

    for _ in range(budget):
        for i in range(n_dim):
            sigma *= rng.uniform(0.9, 1.1)

        z = mu + sigma * np.random.randn(n_dim)
        x = np.clip(z, lb, ub)

        f = evaluate(x)

        if f < f_best:
            f_best = f
            x_best = x

        if temp > 1e-6 and rng.rand() < np.exp(-(f - f_best) / temp):
            mu = x
            temp *= 0.99

    return x_best
