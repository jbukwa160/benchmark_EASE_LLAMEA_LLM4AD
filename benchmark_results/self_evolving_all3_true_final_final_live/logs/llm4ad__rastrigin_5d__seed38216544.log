def algorithm(func, dim, lb, ub, budget, rng):
    def init_cma():
        mu = 0.5 * (ub + lb)
        sigma = 1.0
        weights = np.array([1.0] * dim) / dim
        return {'mu': mu, 'sigma': sigma, 'weights': weights}

    def mutate_cma(p):
        sigma = p['sigma']
        delta = rng.normal(size=dim) * sigma
        new_x = p['mu'] + np.dot(delta, p['weights'])
        return new_x

    def adapt_cma(p, x):
        mu_new = (1 - 0.01) * p['mu'] + 0.01 * x
        sigma_new = max(1e-5, p['sigma'] * np.exp(-0.1 * rng.uniform(-1, 1)))
        weights_new = np.array([1.0] * dim) / dim
        return {'mu': mu_new, 'sigma': sigma_new, 'weights': weights_new}

    def simulated_annealing(p):
        for _ in range(1000):
            x = mutate_cma(p)
            if func(x) < func(p['mu']):
                p['mu'] = x
                return
            elif rng.uniform(0, 1) < np.exp(-(func(x) - func(p['mu'])) / 10.0):
                p['mu'] = x

    def cma_es(p):
        for _ in range(budget // dim):
            x = mutate_cma(p)
            if func(x) <= func(p['mu']):
                p = adapt_cma(p, x)

    p = init_cma()
    best_x = np.array([0.0] * dim)
    best_f = float('inf')
    for _ in range(budget):
        simulated_annealing(p)
        cma_es(p)
        if func(p['mu']) < best_f:
            best_f = func(p['mu'])
            best_x = p['mu']
        if np.any((p['mu'] < lb) | (p['mu'] > ub)):
            return best_x
    return best_x
