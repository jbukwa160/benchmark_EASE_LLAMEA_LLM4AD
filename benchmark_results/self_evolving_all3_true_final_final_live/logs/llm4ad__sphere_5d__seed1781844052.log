def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    step_size = 5.0
    while True:
        if sum(np.abs(best_x - x)) < 0.001 or budget <= 0:
            break
        
        new_x = np.clip(x + rng.uniform(-step_size, step_size, (1, dim)), lb, ub)
        
        f_new = func(new_x)
        if f_new < best_f:
            best_f = f_new
            best_x = new_x.copy()
        
        budget -= 1
        x = new_x
        
        # adaptively reduce the step size
        step_size *= 0.9
    
    return best_x
