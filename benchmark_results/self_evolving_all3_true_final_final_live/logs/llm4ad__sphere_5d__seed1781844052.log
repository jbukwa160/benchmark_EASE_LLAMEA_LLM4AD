def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(rng, dim, lb, ub):
        population = rng.uniform(lb, ub, size=(budget, dim))
        for i in range(budget):
            if np.sum(population[i]**2) < 0.1:
                population[i] = clip(np.zeros(dim))
        return population

    def adaptive_c1(rng):
        c1 = rng.uniform(0.5, 1)
        return c1

    def pso_de_algorithm(func, dim, lb, ub, budget, rng):
        population = generate_initial_population(rng, dim, lb, ub)
        best_positions = population.copy()
        velocities = np.zeros((budget, dim))
        c1 = adaptive_c1(rng)

        for i in range(budget):
            fitness_values = func(population)
            idx_best = np.argmin(fitness_values)
            best_fitness_value = fitness_values[idx_best]
            best_position = clip(best_positions[idx_best])
            velocities[idx_best] = 0.5 * rng.uniform(-1, 1, size=dim)

            for j in range(budget):
                if j != idx_best:
                    r1 = rng.uniform(0, 1)
                    r2 = rng.uniform(0, 1)
                    velocities[j] += c1 * (best_position - population[j]) + \
                        rng.uniform(-1, 1) * (population[idx_best] - population[j])
                    population[j] += velocities[j]

            best_positions = np.minimum(best_positions, clip(population))
            fitness_values = func(clip(population))

        return clip(population[np.argmin(fitness_values)])

    return pso_de_algorithm(func, dim, lb, ub, budget, rng)
