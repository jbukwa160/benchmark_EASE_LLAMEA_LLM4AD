def algorithm(func, dim, lb, ub, budget, rng):
    X = np.zeros((budget, dim))
    for i in range(budget):
        x = np.clip(rng.uniform(lb, ub, size=(dim)), a_min=lb, a_max=ub)
        X[i] = x
    fX = func(X)

    def nelder_mead(fX, X, dim):
        x0 = np.mean(X, axis=0)
        x1 = X[np.argmin(fX)]
        x2 = X[np.argsort(fX)[:3]]
        xm = (x0 + x1) / 2.0
        x_p = 2 * x0 - x1
        if f(xm) < f(x1):
            x_p = xm
        elif f(xm) > f(x1):
            x_p = 2 * x1 - x0
        for i in range(dim):
            x_m = np.copy(x1)
            x_m[i] = rng.uniform(lb, ub)
            x_m = np.clip(x_m, a_min=lb, a_max=ub)
            if f(x_m) < f(x1):
                x_p = x_m
        return (x0, x1, xm, x_p)

    def f(x):
        x = np.clip(x, a_min=lb, a_max=ub)
        return func(np.array([x]))

    best_x = X[np.argmin(fX)]
    for i in range(budget * 10):
        (x0, x1, xm, x_p) = nelder_mead(fX, X, dim)
        r = rng.uniform(-2.0, 1.0)
        x_new = x0 + r * (xm - x0) + r * np.random.choice([-1.0, 1.0]) * (x_p - x0)
        x_new = np.clip(x_new, a_min=lb, a_max=ub)
        fx_new = f(x_new)
        if fx_new < fX[np.argmin(fX)]:
            X[np.argmin(fX)] = x_new
            fX[np.argmin(fX)] = fx_new

    return X[np.argmin(fX)]
