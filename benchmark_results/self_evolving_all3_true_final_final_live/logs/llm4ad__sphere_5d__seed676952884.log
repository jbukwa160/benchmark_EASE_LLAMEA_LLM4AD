def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(-5, 5, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_cand = rng.uniform(lb, ub, size=dim)
        
        # Local exploration
        step_size = np.exp(rng.uniform(-2, -1)) * 0.01
        x_neigh = x_best + rng.uniform(-1, 1, size=dim) * step_size
        
        # Clip to bounds
        x_neigh = np.clip(x_neigh, lb, ub)
        
        f_cand = func(x_neigh)
        
        if f_cand < f_best:
            x_best = x_neigh
            f_best = f_cand

    return x_best
