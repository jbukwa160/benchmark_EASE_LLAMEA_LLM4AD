def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    for _ in range(budget):
        idx = rng.choice(dim)
        delta = np.clip(rng.normal(0, 1), -5.0, 5.0)
        new_x = x.copy()
        new_x[idx] += delta
        new_x = np.clip(new_x, lb, ub)
        if func(new_x) < func(best_x):
            best_x = new_x
    return best_x
