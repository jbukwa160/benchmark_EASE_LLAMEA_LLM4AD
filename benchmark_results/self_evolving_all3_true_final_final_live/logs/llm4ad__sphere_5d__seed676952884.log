def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_candidate = rng.uniform(lb, ub, size=dim)
        
        if np.any(np.abs(x_candidate - x_best) > 1e-6): # check if new candidate is sufficiently far
            f_candidate = func(x_candidate)
            
            if f_candidate < f_best:
                f_best = f_candidate
                x_best = x_candidate

    return x_best
