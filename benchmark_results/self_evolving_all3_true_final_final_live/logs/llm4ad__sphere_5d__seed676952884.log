def algorithm(func, dim, lb, ub, budget, rng):
    X = [np.array([random.uniform(lb, ub) for _ in range(dim)]) for _ in range(budget)]
    X = [[x + 0.5 * (ub - lb) * (2 * np.random.rand() - 1) for x in dim_vec] for dim_vec in X]
    X = [np.clip(x, lb, ub) for x in X]

    mean = np.mean(X, axis=0)
    sigma = 0.5 * (ub - lb)

    for _ in range(budget):
        Y = [[mean + sigma * np.random.randn(dim)] for _ in X]
        Y = [np.clip(y[0], lb, ub) for y in Y]

        fitness_X = [func(x) for x in X]
        fitness_Y = [func(y) for y in Y]

        idx_sorted_X = sorted(range(len(fitness_X)), key=lambda k: fitness_X[k])
        idx_sorted_Y = sorted(range(len(fitness_Y)), key=lambda k: fitness_Y[k])

        worst_idx = idx_sorted_X[-1]
        second_worst_idx = idx_sorted_X[-2]
        third_worst_idx = idx_sorted_X[-3]

        Y[worst_idx] = X[second_worst_idx]
        Y[second_worst_idx] = mean
        Y[third_worst_idx] = [mean + 0.5 * (ub - lb) * (2 * np.random.rand() - 1)]

        fitness_Y = [func(y) for y in Y]

        if np.mean(fitness_Y) < np.mean(fitness_X):
            X = Y

    best_idx = sorted(range(len(X)), key=lambda k: func(X[k]))[0]
    return X[best_idx]
