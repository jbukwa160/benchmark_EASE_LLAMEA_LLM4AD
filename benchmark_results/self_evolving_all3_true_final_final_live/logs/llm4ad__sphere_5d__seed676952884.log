def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        step_size = 0.1 * (ub - lb) / np.sqrt(i + 1)
        new_x = x + step_size * rng.normal(size=dim)
        
        # Clip new_x to [lb, ub]
        new_x = np.clip(new_x, lb, ub)

        new_f = func(new_x)

        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f

        x = best_x.copy()

    return best_x
