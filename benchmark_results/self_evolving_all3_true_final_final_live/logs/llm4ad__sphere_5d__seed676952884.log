def algorithm(func, dim, lb, ub, budget, rng):
    def get_next_candidate(mean, cov):
        candidate = mean + np.dot(cov, rng.normal(size=(dim,)))
        return np.clip(candidate, lb, ub)

    n_evals = 0
    x_best = rng.uniform(lb, ub, size=(dim,))
    f_best = func(x_best)
    
    while n_evals < budget:
        mean = x_best
        cov = np.eye(dim) * 1e-2
        
        for _ in range(100):
            candidate = get_next_candidate(mean, cov)
            n_evals += 1
            
            if n_evals >= budget:
                break
            
            f_candidate = func(candidate)
            
            if f_candidate < f_best:
                x_best = candidate
                f_best = f_candidate
                
        mean_new = (mean + x_best) / 2
        cov *= 0.5
        
        for i in range(dim):
            sigma_i = np.sqrt(cov[i, i])
            cov[i, i] += 1e-4 * (np.random.uniform(-1, 1, size=(1,)) + 1)
            cov[i, :] += (rng.normal(size=(1, dim)) / (sigma_i ** 2))
            
    return x_best
