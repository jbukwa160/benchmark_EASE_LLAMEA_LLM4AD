def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def func_wrapper(x):
        x = clip(x)
        return func(x)

    best_x = None
    best_f = float('inf')
    step_size = 1.0

    for _ in range(budget):
        if rng.random() < 0.5:
            # Random restart
            x = lb + (ub - lb) * rng.uniform(size=dim)
        else:
            # Adaptation of CMA-ES
            cov_matrix = np.eye(dim)
            mean_x = 0 if best_x is None else np.mean(best_x)

            for _ in range(100):  # Number of iterations for adaptation
                x = mean_x + step_size * rng.multivariate_normal(mean=np.zeros(dim), cov=cov_matrix)
                f = func_wrapper(x)

                if f < best_f:
                    best_x = x
                    best_f = f

            # Adaptation of step-size and covariance matrix
            dist_best_prev = np.linalg.norm(best_x - (best_x if best_x is not None else mean_x))
            cov_matrix *= 0.7 + 0.3 * rng.random()
            step_size = min(1, max(step_size * 0.9, best_f / dist_best_prev))

    return best_x
