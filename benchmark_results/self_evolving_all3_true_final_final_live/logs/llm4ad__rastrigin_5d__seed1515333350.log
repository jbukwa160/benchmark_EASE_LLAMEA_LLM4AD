def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_pop = 50
    F = 0.5
    CR = 0.9
    pop_size = 100
    
    # Initialize population
    x = (ub - lb) * rng.rand(pop_size, D) + lb
    
    for _ in range(budget):
        # Evaluate fitness
        fit = np.array([func(x_i) for x_i in x])
        
        # Select parents
        idx = np.argsort(fit)
        x_best = x[idx[0]]
        fit_best = fit[idx[0]]
        
        # Differential Evolution
        y = x.copy()
        for i in range(n_pop):
            r1, r2, r3 = rng.choice(pop_size, 3, replace=False)
            if rng.rand() < CR:
                y[r1] = x[r1] + F * (x[r2] - x[r3])
        
        # Clip candidates to [lb, ub]
        for i in range(pop_size):
            for j in range(D):
                if y[i, j] < lb:
                    y[i, j] = lb
                elif y[i, j] > ub:
                    y[i, j] = ub
        
        # Evaluate new fitness and select best individuals
        fit_y = np.array([func(y_i) for y_i in y])
        
        idx = np.argsort(fit_y)
        x[idx[:n_pop]] = y[idx[:n_pop]]
    
    return x_best
