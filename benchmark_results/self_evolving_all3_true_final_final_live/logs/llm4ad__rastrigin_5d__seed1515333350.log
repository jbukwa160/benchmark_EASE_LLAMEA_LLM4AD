def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(mean, sigma):
        candidate = mean + sigma * (rng.standard_normal(dim) - 0.5)
        return clip(candidate)

    n_candidates = int(np.sqrt(budget))
    population_size = n_candidates * 10

    candidates = [generate_candidate(np.zeros(dim), 1) for _ in range(population_size)]
    scores = [func(candidates[i]) for i in range(population_size)]

    for _ in range(int(budget / (population_size + 1))):
        if len(scores) > population_size:
            min_idx = np.argmin(scores)
            best_candidate = candidates[min_idx]
            for j in range(n_candidates):
                candidate_idx = rng.choice(len(candidates), replace=False)
                new_score = func(candidates[candidate_idx])
                old_score = scores[candidate_idx]
                if new_score < old_score:
                    scores[candidate_idx] = new_score
                    candidates[candidate_idx] = generate_candidate(best_candidate, 1)
        else:
            for i in range(n_candidates):
                candidate_idx = rng.choice(len(candidates), replace=False)
                new_candidate = generate_candidate(candidates[candidate_idx], 1.5)
                scores.append(func(new_candidate))
                candidates.append(new_candidate)

    min_idx = np.argmin(scores)
    best_candidate = candidates[min_idx]
    return best_candidate
