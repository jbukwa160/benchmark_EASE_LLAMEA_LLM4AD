def algorithm(func, dim, lb, ub, budget, rng):
    n = 0
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    T = 100 * (ub - lb) / (1 + n / budget)
    r_min = 0.01 * (ub - lb)
    r_max = 0.5 * (ub - lb)
    r = rng.uniform(r_min, r_max)

    while n < budget:
        x_new = x_best + r * rng.normal(0, 1, size=dim)
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        delta = f_new - f_best

        if delta <= 0 or np.random.rand() < np.exp(-delta / T):
            x_best = x_new
            f_best = f_new

        n += 1
        r *= 0.99
        T -= 10 * (ub - lb) / budget

    return x_best
