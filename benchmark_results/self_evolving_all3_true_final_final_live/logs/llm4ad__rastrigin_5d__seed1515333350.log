def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def simulated_annealing(lb, ub, initial_temperature, cooling_rate, num_steps):
        current_solution = rng.uniform(lb, ub, size=dim)
        current_fitness = func(current_solution)
        temperature = initial_temperature

        for _ in range(num_steps):
            new_solution = clip(rng.normal(loc=current_solution, scale=np.sqrt(ub-lb), size=dim))
            new_fitness = func(new_solution)

            if new_fitness < current_fitness:
                current_solution = new_solution
                current_fitness = new_fitness
            else:
                delta = new_fitness - current_fitness
                probability = np.exp(-delta / temperature)
                if rng.uniform(0, 1) < probability:
                    current_solution = new_solution
                    current_fitness = new_fitness

            temperature *= cooling_rate

        return current_solution

    best_solution = None
    best_fitness = float('inf')

    for _ in range(budget):
        solution = simulated_annealing(lb, ub, rng.uniform(1, 100), 0.99, num_steps=100)
        fitness = func(solution)

        if fitness < best_fitness:
            best_solution = solution
            best_fitness = fitness

    return best_solution
