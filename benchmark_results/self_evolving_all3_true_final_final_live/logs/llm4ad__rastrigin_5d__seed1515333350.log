def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def generate_initial_population(dim, lb, ub, rng):
        return rng.uniform(lb, ub, (budget, dim))

    def differential_evolution(population, func, dim, lb, ub, budget):
        for _ in range(budget):
            for i in np.random.choice(population.shape[0], size=5, replace=False):
                v = population[i]
                u = rng.uniform(0, 1)
                trial = v + u * (population[np.random.choice(population.shape[0])] - v)
                trial = clip(trial, lb, ub)
                if func(trial) < func(v):
                    population[i] = trial
        return population

    def simulated_annealing(population, func, dim, lb, ub, budget, rng):
        T = 1.0
        alpha = 0.99
        for _ in range(budget):
            i = np.random.choice(population.shape[0])
            v = population[i]
            u = rng.uniform(0, 1)
            trial = v + rng.uniform(-T, T, size=dim) * (ub - lb)
            trial = clip(trial, lb, ub)
            delta = func(trial) - func(v)
            if delta < 0 or np.random.rand() < np.exp(-delta / T):
                population[i] = trial
            T *= alpha
        return population

    def hybrid_algorithm(population, dim, lb, ub, budget, rng):
        for _ in range(budget // 2):
            population = differential_evolution(population, func, dim, lb, ub, int(budget / 4))
        for _ in range(budget - budget // 2):
            population = simulated_annealing(population, func, dim, lb, ub, int(budget / 4), rng)
        return population

    initial_population = generate_initial_population(dim, lb, ub, rng)
    best_solution = np.inf
    best_candidate = None
    for _ in range(100): # Run the hybrid algorithm multiple times to increase chances of finding the global minimum.
        candidate = func(hybrid_algorithm(initial_population.copy(), dim, lb, ub, budget, rng))
        if candidate < best_solution:
            best_solution = candidate
            best_candidate = np.argmin(candidate)
    return initial_population[best_candidate]
