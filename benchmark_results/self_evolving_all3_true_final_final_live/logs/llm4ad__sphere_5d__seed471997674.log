def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    bounds = [(lb, ub) for _ in range(dim)]
    
    pop = rng.uniform(lb, ub, (pop_size, dim))
    best = func(pop)
    best_sol = pop[np.argmin(best)]
    
    for _ in range(budget):
        for i in range(pop_size):
            idxs = [j for j in range(dim) if np.random.rand() < 0.5]
            trial = pop[i].copy()
            
            for k in idxs:
                trial[k] = pop[np.random.choice(range(pop_size))][k]
                
            trial = rng.uniform(lb, ub, dim)
            trial = [max(min(x, ub), lb) for x in trial]
            
            f_trial = func(trial)
            if f_trial < best:
                best = f_trial
                best_sol = trial
                
            for j in range(dim):
                if np.random.rand() < 0.1 and rng.uniform(0, 1) < (ub - lb)/np.abs(ub - lb):
                    trial[j] += rng.uniform(-1, 1)*(ub - lb)
                    trial[j] = max(min(trial[j], ub), lb)
                    
            f_trial = func(trial)
            if f_trial < best:
                best = f_trial
                best_sol = trial
                
    return np.array(best_sol)
