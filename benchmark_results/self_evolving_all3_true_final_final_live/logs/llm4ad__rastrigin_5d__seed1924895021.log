def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_y = float('inf')
    
    def clipped_bounds(bounds, x):
        return np.array([min(max(x_i, bounds[0]), bounds[1]) for x_i, bound in zip(x, bounds)])
    
    def fitness(x):
        return func(clipped_bounds((lb, ub), x))
    
    pop_size = 100
    max_pop_size = 200
    
    for i in range(budget):
        if best_x is None or rng.random() < 0.1:
            res = differential_evolution(fitness, [(lb, ub) for _ in range(dim)], strategy='best1exp', mutation=0.5, recombination=0.9, maxiter=(10 ** rng.uniform(2, 6)), popsize=min(pop_size, max_pop_size))
        else:
            res = differential_evolution(fitness, [(lb, ub) for _ in range(dim)], strategy='best1exp', mutation=0.5, recombination=0.9, maxiter=(10 ** rng.uniform(2, 6)), popsize=min(pop_size + int(rng.normal(0, 20)), max_pop_size))
        
        if res.fun < best_y:
            best_x = res.x
            best_y = res.fun
    
    return np.array(best_x)
