def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    candidate = np.random.uniform(lb, ub, size=(pop_size, dim))
    best_candidate = candidate[np.argmin([func(x) for x in candidate])]

    for i in range(budget - 1):
        # Selection
        r1 = rng.randint(0, pop_size)
        r2 = rng.randint(0, pop_size)
        while r2 == r1:
            r2 = rng.randint(0, pop_size)

        # Mutation
        donor = candidate[rng.choice(pop_size)]
        for j in range(dim):
            if rng.random() < 0.5:
                donor[j] = best_candidate[j]
            else:
                donor[j] += (candidate[r1, j] - candidate[r2, j]) * 0.6
                donor[j] = np.clip(donor[j], lb, ub)

        # Crossover
        child = candidate[rng.choice(pop_size)]
        for k in range(dim):
            if rng.random() < 0.5:
                child[k] = donor[k]
            else:
                child[k] = (candidate[r1, k] + candidate[r2, k]) / 2

        # Replacement
        child = np.clip(child, lb, ub)
        f_child = func(child)

        if f_child < func(best_candidate):
            best_candidate = child

    return best_candidate
