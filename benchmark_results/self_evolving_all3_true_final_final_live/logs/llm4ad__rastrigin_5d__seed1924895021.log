def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_x = None
    best_f = np.inf
    restarts = 0

    while True:
        x = rng.normal(size=dim)
        x = clip(x)

        f = func(x)

        if f < best_f:
            best_x = x.copy()
            best_f = f

        if budget <= 0 or (restarts > 10 and np.random.rand() < 0.1):
            return best_x

        for _ in range(dim):
            y = rng.normal(size=dim)
            y = clip(y + best_x)

            g = func(y)
            if g < f:
                x = y.copy()
                f = g

        budget -= 1
        restarts += 1
