def algorithm(func, dim, lb, ub, budget, rng):
    N = 50
    mean = np.random.uniform(lb, ub, size=dim)
    cov = np.eye(dim) * (ub - lb)**2 / 10
    for _ in range(budget):
        z = np.random.normal(size=dim)
        x = mean + np.dot(np.linalg.cholesky(cov), z)
        x = np.clip(x, lb, ub)
        fx = func(x)
        if rng.rand() < 1 / (budget + 1):
            cov += N * np.outer((x - mean), (x - mean))
            mean = (mean + x) / 2
    return mean
