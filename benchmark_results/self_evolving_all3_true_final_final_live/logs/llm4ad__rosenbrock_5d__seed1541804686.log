def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        return func(clip(x))

    def sa_search(x0, T_max=10000, cooling_rate=0.99):
        x = x0
        T = 1e6
        for t in range(T_max):
            delta = rng.uniform(-1, 1, size=dim)
            new_x = x + delta
            if evaluate(new_x) < evaluate(x):
                x = new_x
            elif np.random.rand() < np.exp(-(evaluate(new_x)-evaluate(x))/T):
                x = new_x
            T *= cooling_rate
        return x

    best_x = None
    for _ in range(budget):
        x0 = rng.uniform(lb, ub, size=dim)
        simplex_size = 20
        x_simplex = [rng.uniform(lb, ub, size=dim) for _ in range(simplex_size)]
        for _ in range(100):
            y_simplex = np.array(x_simplex)
            y_center = (np.sum(y_simplex, axis=0) / simplex_size)
            y_reflection = 2 * y_center - x_simplex
            y_expansion = 1.5 * y_reflection + y_center
            y_contraction = y_center - np.sign(np.mean((evaluate(y_reflection)-evaluate(x)) for x in y_simplex)) * \
                0.5 * (y_reflection - y_center)
            y_shrinkage = y_center + 0.001 * (y_reflection - y_center)

            # Sort by function value
            x_sort_idx = np.argsort([evaluate(y) for y in [y_simplex, y_reflection, y_expansion, y_contraction, y_shrinkage]])

            # Update simplex
            x_simplex[x_sort_idx[0]] = y_simplex[x_sort_idx[0]]
            x_simplex[x_sort_idx[1]] = y_reflection
            if evaluate(y_reflection) < evaluate(y_expansion):
                x_simplex[x_sort_idx[2]] = y_reflection
            else:
                x_simplex[x_sort_idx[2]] = y_expansion

            # Shrinkage
            for i in range(simplex_size):
                x_simplex[i] -= (y_center - x_simplex[i])

        new_x = np.mean(x_simplex, axis=0)
        if best_x is None or evaluate(new_x) < evaluate(best_x):
            best_x = new_x

        # Random restart
        if rng.rand() < 0.1:
            x0 = rng.uniform(lb, ub, size=dim)

    return np.array([best_x])
