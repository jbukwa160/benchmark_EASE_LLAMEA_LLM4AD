def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = np.array(x)
        return func(x), None  # dummy gradient for Rosenbrock function

    def de_step(population):
        offspring = population.copy()
        for i in range(len(offspring)):
            idx1, idx2, idx3 = rng.choice(len(population), 3, replace=False)
            mutation = np.clip(0.5 * (population[idx1] - population[idx2]) + 0.5 * (offspring[idx3] - population[idx1]), -10, 10)
            offspring[i] += mutation
        return clip(offspring)

    def sa_step(population):
        new_population = []
        for x in population:
            delta = rng.uniform(-1, 1) * np.ones(dim)
            new_x = clip(x + delta)
            new_population.append(new_x)
        return new_population

    # Initial population
    population = [np.random.uniform(lb, ub, dim) for _ in range(100)]

    for _ in range(budget):
        population = de_step(population)

        # SA phase to fine-tune the best solution
        current_best = max(population, key=evaluate)[0]
        new_population = sa_step([current_best])
        if evaluate(new_population[0])[0] < evaluate(current_best)[0]:
            population.append(new_population[0])

    return clip(max(population, key=evaluate)[0])
