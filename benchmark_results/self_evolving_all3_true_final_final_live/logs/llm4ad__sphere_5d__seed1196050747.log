def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate():
        return rng.uniform(lb, ub, size=dim)

    best_x = get_candidate()
    best_y = func(best_x)
    for _ in range(budget):
        x = get_candidate()
        y = func(x)
        if y < best_y:
            best_x = x
            best_y = y
        v = rng.uniform(0, 1, size=dim)  # perturbation vector
        x_perturbed = best_x + np.sqrt(budget - _)*v
        x_perturbed = np.clip(x_perturbed, lb, ub)
        y_perturbed = func(x_perturbed)
        if y_perturbed < best_y:
            best_x = x_perturbed
            best_y = y_perturbed
    return best_x
