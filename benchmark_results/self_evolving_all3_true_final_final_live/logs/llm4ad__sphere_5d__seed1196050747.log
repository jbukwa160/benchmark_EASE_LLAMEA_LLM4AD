def algorithm(func, dim, lb, ub, budget, rng):
    candidates = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    best_candidate = candidates.copy()
    best_fitness = func(best_candidate)
    
    for i in range(budget):
        candidate = candidates.copy()
        candidate[rng.randint(0, dim)] += 1
        candidate = np.clip(candidate, lb, ub)
        fitness = func(candidate)
        
        if fitness < best_fitness:
            best_candidate = candidate
            best_fitness = fitness
        
        r = rng.uniform(0, 1)
        if r < 0.5:  # Greedy selection
            candidates[rng.randint(0, dim)] += 1
            candidates = np.clip(candidates, lb, ub)
        else:  # Random search
            candidates = np.array([rng.uniform(lb, ub) for _ in range(dim)])
            
    return best_candidate
