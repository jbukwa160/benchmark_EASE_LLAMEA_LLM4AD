def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    best_cost = float('inf')

    for _ in range(budget):
        candidate = best + 0.5 * (ub - lb) * rng.rand(dim)
        candidate = np.clip(candidate, lb, ub)

        cost = func(candidate)

        if cost < best_cost:
            best_cost = cost
            best = candidate

    return best
