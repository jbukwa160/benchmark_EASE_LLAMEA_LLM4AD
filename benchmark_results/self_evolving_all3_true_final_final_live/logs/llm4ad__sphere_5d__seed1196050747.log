def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    current_best = func(x)
    temperature = 1.0
    beta = 0.99

    for _ in range(budget):
        step_size = 2 * rng.uniform(0, 1) - 1
        new_x = clip(x + step_size)

        if func(new_x) < current_best:
            x = new_x
            current_best = func(x)
        else:
            delta = func(new_x) - current_best
            temperature *= beta

            if rng.uniform(0, 1) < np.exp(-delta / temperature):
                x = new_x
                current_best = func(x)

    return clip(x)
