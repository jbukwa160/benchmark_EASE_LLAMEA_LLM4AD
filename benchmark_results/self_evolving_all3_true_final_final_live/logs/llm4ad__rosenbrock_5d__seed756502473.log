def algorithm(func, dim, lb, ub, budget, rng):
    def sample(rng, dim, lb, ub):
        return rng.uniform(lb, ub, size=dim)

    x = sample(rng, dim, lb, ub)
    best_x = x.copy()
    best_f = func(x)

    lambda_ = int(np.floor(budget ** (1 / 4)))
    for t in range(int(budget)):
        y = sample(rng, dim, lb, ub)
        z = np.zeros(dim)
        w = np.random.normal(size=dim)
        for i in range(lambda_):
            z += func(y + 0.5 * w) - func(x + 0.5 * w)
        w /= lambda_
        x -= w
        if func(x) < best_f:
            best_x = x.copy()
            best_f = func(x)

    return best_x
