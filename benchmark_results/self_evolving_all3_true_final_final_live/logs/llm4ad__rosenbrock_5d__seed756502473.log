def algorithm(func, dim, lb, ub, budget, rng):
    num_samples = int(budget ** 0.5)
    X = np.random.uniform(lb, ub, (num_samples, dim))
    y = func(X)

    def gp_model(x):
        mean = np.zeros(dim)
        var = np.ones(dim)
        for i in range(dim):
            x_i = x[i]
            x_prev = X[:, i]
            cov = 1 / (var[i] + np.exp(-np.sum((x_prev - x_i) ** 2, axis=0)))
            mean[i] = y / cov
            var[i] = 1 / cov
        return mean

    def sample_gp(model, lb, ub):
        x = np.zeros(dim)
        for i in range(dim):
            mean = model(i * np.ones(dim))
            std_dev = np.sqrt(var[i])
            x[i] = norm.rvs(loc=mean[i], scale=std_dev, random_state=rng)
            x[i] = max(lb[i], min(ub[i], x[i]))
        return x

    def update_gp(X_new, y_new):
        for i in range(dim):
            x_i = X_new[:, i]
            cov = np.exp(-np.sum((X[:, i] - x_i) ** 2, axis=0))
            var[i] += cov
            mean[i] = (y / var[i]).mean()
        return mean

    x_best = np.zeros(dim)
    for _ in range(int(budget)):
        X_new = sample_gp(gp_model, lb, ub)
        y_new = func(X_new)
        if y_new < func(x_best):
            x_best = X_new
        update_gp(X_new, y_new)

    return x_best
