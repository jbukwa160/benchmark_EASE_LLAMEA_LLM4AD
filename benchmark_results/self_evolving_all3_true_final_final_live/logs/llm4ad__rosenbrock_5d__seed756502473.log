def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def sample_gaussian(mean, std, size=1):
        return mean + std * rng.normal(size=size)

    def gradient(x, func):
        gradient = np.zeros(dim)
        for i in range(dim-1):
            gradient[i] += 200 * (x[i+1] - x[i]**2) * (-2*x[i]*func(x[:i+1]) + 2*(x[i+1]-x[i]**2)*func(x[:i+2]))
        return gradient

    def evaluate(x, func):
        return func(x)

    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = evaluate(best_x, func)
    
    for _ in range(budget):
        # First-stage optimization
        new_x = clip(sample_gaussian(best_x, 0.1))
        f_new = evaluate(new_x, func)
        
        if f_new < best_f:
            best_x = new_x
            best_f = f_new
        
        # Gradient-based perturbation
        gradient_step = gradient(best_x, func)
        candidate = clip(best_x + 0.01 * np.sqrt(np.sum(gradient_step**2)) * rng.normal(size=dim))
        
        # Evaluate the new candidate
        f_candidate = evaluate(candidate, func)
        
        if f_candidate < best_f:
            best_x = candidate
            best_f = f_candidate
    
    return best_x
