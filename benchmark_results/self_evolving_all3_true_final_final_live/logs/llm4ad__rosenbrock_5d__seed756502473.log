def algorithm(func, dim, lb, ub, budget, rng):
    def sample_candidate(best_x):
        return best_x + rng.normal(size=dim, loc=np.zeros(dim), scale=0.1)

    current_best = rng.uniform(lb, ub, size=dim)
    for _ in range(budget):
        candidate = sample_candidate(current_best)
        clipped_candidate = np.clip(candidate, lb, ub)
        if func(clipped_candidate) < func(current_best):
            current_best = clipped_candidate
    return current_best
