def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def get_candidate(parents):
        sigma = 1.0
        for i in range(budget):
            candidate = np.zeros(dim)
            for j in range(dim):
                candidate[j] = parents[0][j] + rng.normal(0, sigma)
                if rng.random() < 0.5:
                    candidate[j] *= -1
            candidate = clip(candidate)
            yield candidate

    def evaluate_candidate(func, candidate):
        return func(candidate)

    def update_parents(parents, new_parents):
        parents[0] = np.mean(np.array(new_parents), axis=0)
        for i in range(1, len(parents)):
            parents[i] = rng.choice(new_parents, size=1)[0]
        return parents

    parents = [rng.uniform(lb, ub, dim) for _ in range(10)]
    best_candidate = np.zeros(dim)

    for i in range(budget):
        new_candidates = list(get_candidate(parents))
        scores = [evaluate_candidate(func, candidate) for candidate in new_candidates]
        best_index = np.argmin(scores)
        if scores[best_index] < evaluate_candidate(func, best_candidate):
            best_candidate = new_candidates[best_index]

    return best_candidate
