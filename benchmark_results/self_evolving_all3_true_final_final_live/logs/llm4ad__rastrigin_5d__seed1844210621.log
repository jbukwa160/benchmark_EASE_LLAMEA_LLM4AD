def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = x + 0.1 * (np.random.uniform(-1, 1, size=dim) - 0.5)
        y = np.clip(y, lb, ub)
        f_y = func(y)

        if f_y < best_f:
            best_x = y.copy()
            best_f = f_y
        elif rng.uniform(0, 1) < np.exp((best_f - f_y) / (np.finfo(float).eps + _)):
            x = y.copy()

    return best_x
