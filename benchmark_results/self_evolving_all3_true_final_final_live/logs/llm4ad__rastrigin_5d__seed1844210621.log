def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(size, bounds):
        population = np.random.uniform(bounds[0], bounds[1], size=(size, dim))
        return population

    def evaluate(population):
        return func(population)

    def select_parents(population, scores):
        idx = np.argsort(scores)[-int(0.2 * len(scores)):]
        return population[idx]

    def mutate(parents, sigma):
        mutation = 1e-6 + sigma * (np.random.rand(dim) - 0.5)
        children = parents + mutation
        return clip(children)

    def crossover(parents, children):
        crossover_points = np.random.randint(0, dim, size=len(parents))
        offspring = np.copy(parents)
        for i in range(len(offspring)):
            offspring[i][crossover_points[i]:] = children[i][crossover_points[i]:]
        return clip(offspring)

    def acceptance_probability(current_score, new_score):
        T = 1 / (2 * rng.uniform(0.01, 0.1))
        return min(1, np.exp((new_score - current_score) / T))

    def simulated_annealing(population, scores, budget):
        temperature = 100
        for _ in range(budget):
            parent_idx = rng.randint(len(population))
            child = mutate(population[parent_idx], temperature)
            score_child = func(child)
            score_parent = scores[parent_idx]
            if score_child < score_parent or np.random.rand() < acceptance_probability(score_parent, score_child):
                population[parent_idx] = child
                scores[parent_idx] = score_child

    def differential_evolution(population, scores, budget):
        for _ in range(budget):
            parents = select_parents(population, scores)
            children = crossover(parents, mutate(parents, 0.5))
            for i in range(len(children)):
                child_score = func(children[i])
                parent_scores = [func(parent) for parent in parents]
                if child_score < np.min(parent_scores):
                    population[i] = children[i]
                    scores[i] = child_score

    population = generate_initial_population(100, (lb, ub))
    scores = evaluate(population)
    simulated_annealing(population, scores, int(0.5 * budget))
    differential_evolution(population, scores, int(0.5 * budget))

    return population[np.argmin(scores)]
