def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for _ in range(budget - 1):
        x = np.random.uniform(lb, ub, size=dim)
        f = func(x)

        if f < best_f:
            best_x = x
            best_f = f

        # Nelder-Mead optimization around the current best solution
        simplex = np.column_stack((best_x, 2 * rng.rand(dim) - 1))
        for i in range(simplex.shape[0]):
            x_new = simplex[i]
            f_new = func(x_new)
            if f_new < best_f:
                best_x = x_new
                best_f = f_new

                # Reflected point
                r = np.mean(simplex, axis=0) + (np.max(simplex, axis=0) - simplex[i])
                f_r = func(r)

                if f_r < best_f:
                    best_x = r
                    best_f = f_r

    return best_x
