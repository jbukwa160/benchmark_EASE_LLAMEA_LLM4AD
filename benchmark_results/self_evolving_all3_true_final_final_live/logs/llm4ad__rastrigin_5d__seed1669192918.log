def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    sigma = 1.0
    mu = (ub - lb) / 2 + lb
    n_iter = int(budget / pop_size)
    
    def get_initial_population():
        return np.random.uniform(lb, ub, size=(pop_size, dim))
    
    def gaussian_mixture_model(pop):
        weights = [1.0/pop_size]*pop_size
        means = pop
        covars = [[sigma**2]*dim for _ in range(pop_size)]
        
        dists = []
        for i in range(pop_size):
            dists.append(multivariate_normal(mean=means[i], cov=covars[i]))
        
        return np.random.choice(pop, size=(pop_size,), p=weights), [dist.pdf(pop[i]) for i in range(pop_size)]
    
    def differential_evolution(pop):
        pop = np.clip(pop, lb, ub)
        scores = func(pop)
        idx_best = np.argmax(scores)
        
        for i in range(pop_size):
            if i == idx_best:
                continue
            diff = pop[idx_best] - pop[i]
            new_pop_i = pop[i] + sigma * rng.normal(size=dim) * diff
            new_pop_i = np.clip(new_pop_i, lb, ub)
            scores_new = func(np.array([new_pop_i]))
            if scores_new > scores[i]:
                pop[i] = new_pop_i
                scores[i] = scores_new
        
        return pop, scores
    
    population = get_initial_population()
    
    for _ in range(n_iter):
        population, scores = differential_evolution(population)
        best_idx = np.argmax(scores)
        new_population, weights = gaussian_mixture_model(population)
        
        for i in range(pop_size):
            if rng.random() < 0.1:
                population[i] = new_population[i]
    
    best_x = population[np.argmax(scores)]
    return best_x
