def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    D = 0.5 * (ub - lb)
    x = np.zeros(n)
    c = np.eye(n) + D * rng.randn(n, n)
    cmu = np.zeros(n)

    for _ in range(budget):
        v = c @ np.random.randn(n)
        while True:
            f_val = func(np.clip(v, lb, ub))
            if f_val < func(x):
                x = v.copy()
                break
            elif rng.rand() < 0.1: # 10% acceptance rate for exploration
                v = c @ np.random.randn(n)

        f_val = func(np.clip(cmu, lb, ub))
        if f_val < func(x):
            x = cmu.copy()

        y = np.zeros(n)
        for i in range(n):
            y[i] = (x[i] + 0.1 * rng.randn()) ** 2

        delta = y - x
        c += delta[:, None] @ delta[None, :]
        cmu += delta

    return x.copy()
