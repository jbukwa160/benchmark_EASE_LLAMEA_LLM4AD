def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidates):
        return np.clip(candidates, lb, ub)

    def generate_initial_population(dim, pop_size):
        return rng.uniform(lb, ub, (pop_size, dim))

    def calculate_mean_and_covariance(population):
        mean = np.mean(population, axis=0)
        cov = np.cov(population.T)
        return mean, cov

    def covariance_matrix_adaptation(mean, cov, sigma, population, func_dim):
        lambda_ = 1.0 + (2 / (func_dim + 1)) * min(1, budget / (np.sqrt(budget) + 1))
        mu = lambda_ / func_dim
        cmu = np.eye(func_dim)
        cpc = cov.copy()
        for i in range(cmu.shape[0]):
            cmu[i, i] *= lambda_
            cpc[i, i] /= lambda_

        new_population = rng.multivariate_normal(mean, (lambda_*cov + mu*cmu + (1-mu)*cpc)/func_dim, population.shape[0])
        new_sigma = sigma * np.sqrt(lambda_)

        return new_population, new_sigma

    def evaluate_and_update(population, sigma):
        fitness = [func(clip(candidate)) for candidate in population]
        mean_fitness = np.mean(fitness)
        best_candidate = population[np.argmin(fitness)]
        return population, fitness, mean_fitness, best_candidate

    def adaptive_learning_rate(mean_fitness, budget, rng):
        if budget == 1:
            return mean_fitness * (0.2 + rng.uniform(-0.01, 0.01))
        else:
            return mean_fitness * 0.995 + rng.uniform(-0.0015, 0.0015)

    dim = func_dim
    pop_size = 50

    population = generate_initial_population(dim, pop_size)
    sigma = 1.0
    budget = int(budget)
    best_candidate = None
    for i in range(1, budget+1):
        mean, cov = calculate_mean_and_covariance(population)
        population, sigma = covariance_matrix_adaptation(mean, cov, sigma, population, dim)
        population, fitness, mean_fitness, best_candidate = evaluate_and_update(population, sigma)
        if rng.uniform(0, 1) < 0.1 and i > 10:
            sigma *= np.sqrt(rng.uniform(0.5, 2))
        adaptive_lr = adaptive_learning_rate(mean_fitness, budget - i + 1, rng)
        population += rng.normal(0, sigma * np.sqrt(adaptive_lr), population.shape)

    return clip(best_candidate)
