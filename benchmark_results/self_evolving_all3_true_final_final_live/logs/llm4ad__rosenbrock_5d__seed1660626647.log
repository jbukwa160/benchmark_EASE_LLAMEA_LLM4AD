def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = 0.5 * (lb + ub) * np.ones(dim)
    f_best = func(clip(x_best))

    def hierarchical_sampling(n_samples, depth=1):
        if n_samples == 1:
            return [x_best]
        else:
            samples = []
            for _ in range(depth):
                x = rng.uniform(lb, ub, size=dim)
                samples.append(clip(x))
            return samples

    def adaptive_exploitation(samples, f_samples, depth):
        if len(f_samples) == 1:
            return samples[0]
        else:
            scores = np.array([f for f in f_samples])
            scores += np.log(len(samples)) * np.arange(len(samples))
            idx = np.argmax(scores)
            x_new = samples[idx]
            return [x_new] + adaptive_exploitation(samples[:idx] + samples[idx+1:], f_samples[:idx] + f_samples[idx+1:], depth-1)

    for _ in range(budget):
        n_samples = 2 ** (int(np.log2(budget / (dim - 1))) + 1)
        x_samples = hierarchical_sampling(n_samples)
        f_samples = [func(clip(x)) for x in x_samples]
        x_new = adaptive_exploitation(x_samples, f_samples, int(np.log2(n_samples)))
        if func(clip(x_new)) < f_best:
            x_best = x_new
            f_best = func(clip(x_best))

    return clip(x_best)
