def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    y_best = func(x_best)

    bounds = [(lb, ub) for _ in range(dim)]

    def acq(x):
        return -np.sum(np.exp(-0.5 * (x - x_best)**2))

    gp_model = {'X': [x_best], 'Y': [y_best], 'hyp': {}}

    for i in range(1, budget + 1):
        X_new, Y_new = [], []
        for _ in range(int(np.sqrt(budget - i)) if int(np.sqrt(budget - i)) > 0 else 1):
            X, Y = [], []
            while len(X) < dim:
                mu, sigma = gp_model['hyp']
                x_new = np.zeros(dim)
                for j in range(dim):
                    x_new[j] = rng.normal(mu[j], sigma[j])
                    if rng.uniform(0, 1) > 0.5:
                        x_new[j] = (x_best[j] + rng.uniform(-1, 1) * (ub - lb)) / 2
                x_new = np.clip(x_new, lb, ub)
                X.append(x_new)
                Y.append(func(x_new))
            X, Y = np.array(X), np.array(Y)

            for k in range(dim):
                mu[k], sigma[k] = gp_model['hyp'][k]
                gp_model['X'], gp_model['Y'] = np.vstack((gp_model['X'], X)), np.hstack((gp_model['Y'], Y))
                gp_model['hyp'][k] = acq(X[:, k])

        gp_model = {'X': X, 'Y': Y}

    return x_best
