def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(budget):
        x_new = np.clip(np.random.normal(loc=x, scale=np.sqrt(0.5), size=(1, dim)), lb, ub)
        
        if rng.uniform() < 1 - (i / budget)**2:
            x_new = np.clip(x_new + rng.uniform(-1, 1, size=(1, dim)) * (ub - lb) / 10, lb, ub)
        
        f_new = func(x_new)
        
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new
        
        x = np.concatenate((x, x_new), axis=0)
    
    return best_x
