def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 1.0
    alpha = 0.99
    beta = 0.01
    t = 0
    best_x = x.copy()
    best_f = func(x)

    while t < budget:
        y = x.copy()
        for i in range(dim):
            delta = rng.uniform(-1, 1)
            y[i] += delta * (ub - lb) / 2.0

        f = func(y)
        if f <= best_f:
            best_x = y
            best_f = f
        else:
            probability = np.exp(-(f - best_f) / T)
            if rng.uniform(0, 1) < probability:
                best_x = y
                best_f = f

        T *= alpha + (beta - alpha) * (1 - t / budget)

        for i in range(dim):
            if best_x[i] < lb:
                best_x[i] = lb
            elif best_x[i] > ub:
                best_x[i] = ub

        x = best_x.copy()
        t += 1

    return best_x
