def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    pop_size = 50
    x0 = (ub - lb) * rng.rand(pop_size, dim) + lb
    for _ in range(budget):
        x_new = np.copy(x0)
        for i in range(pop_size):
            idx1, idx2, idx3 = rng.choice(pop_size, 3, replace=False)
            trial = x0[idx1] + 0.5 * (x0[idx2] - x0[idx3]) + rng.uniform(-1, 1) * np.random.rand(dim)
            trial = np.clip(trial, lb, ub)
            x_new[i] = x0[idx1] if evaluate(trial) > evaluate(x0[idx1]) else trial
        for i in range(pop_size):
            mutation_prob = 0.01
            if rng.uniform(0, 1) < mutation_prob:
                num_mutations = int(rng.uniform(1, dim))
                idxs = np.random.choice(dim, num_mutations, replace=False)
                x_new[i, idxs] += (ub - lb) * rng.randn(num_mutations)
                x_new[i, idxs] = np.clip(x_new[i, idxs], lb, ub)
        x0 = np.copy(x_new)

    return x0[np.argmin([evaluate(x) for x in x0])]
