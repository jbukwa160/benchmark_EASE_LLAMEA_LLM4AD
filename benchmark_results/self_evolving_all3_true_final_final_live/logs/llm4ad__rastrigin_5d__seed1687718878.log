def algorithm(func, dim, lb, ub, budget, rng):
    mu = 1.0
    sigma = 5.0
    lambda_ = int(4 + 3 * np.log(dim))
    D = np.diag(rng.random((dim,)))
    x_best = np.array([ub] * dim)
    f_best = float('inf')
    
    for _ in range(budget):
        x = mu + sigma * rng.randn(lambda_, dim)
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
        
        f = func(x)
        
        if f < f_best:
            f_best = f
            x_best = x[np.argmin(f)]
    
    return x_best
