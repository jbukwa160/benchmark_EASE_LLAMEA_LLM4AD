def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(dim,))
    y = x.copy()
    best = func(x)
    
    for i in range(budget):
        v = x + rng.uniform(-1, 1, size=(dim,))
        
        # Clip to [lb, ub]
        v = np.clip(v, lb, ub)
        
        # Adaptive mutation
        mu = 0.5 * (func(x) - best) / (func(x) - func(y))
        v += mu * (x - y)
        
        # Local search around the best solution
        if rng.uniform(0, 1) < 0.1:
            for j in range(dim):
                z = x.copy()
                z[j] += rng.uniform(-1, 1)
                z = np.clip(z, lb, ub)
                if func(z) < best:
                    x = z
                    best = func(x)
        
        # Update best solution
        if func(v) < best:
            y = x
            x = v
            best = func(x)
    
    return x
