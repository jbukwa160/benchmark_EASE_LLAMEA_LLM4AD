def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_candidate = np.zeros(dim)
    best_value = float('inf')

    for _ in range(budget):
        candidate = rng.uniform(lb, ub, size=dim)
        value = func(candidate)

        if value < best_value:
            best_value = value
            best_candidate = clip(candidate)

        # Local refinement
        while True:
            step = rng.uniform(-1.0, 1.0, size=dim) * 0.01
            next_candidate = clip(best_candidate + step)
            next_value = func(next_candidate)

            if next_value < value or rng.random() < np.exp((value - next_value) / 100):
                best_candidate = next_candidate
                best_value = next_value
                break

    return best_candidate
