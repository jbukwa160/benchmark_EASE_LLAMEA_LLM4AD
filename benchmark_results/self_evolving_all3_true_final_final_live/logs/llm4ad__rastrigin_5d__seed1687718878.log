def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(dim, lb, ub):
        return 10 * rng.rand((budget, dim)) + lb

    def evaluate_population(population):
        return [func(individual) for individual in population]

    def mutate_individual(individual, best_individual, sigma):
        mutated_individual = individual + (best_individual - individual) * rng.uniform(-sigma, sigma)
        return clip(mutated_individual)

    def differential_evolution(population, func, dim, lb, ub, budget, rng):
        for i in range(budget - 1):
            targets = population[rng.choice(range(len(population)), size=10, replace=False)]
            mutated_targets = [mutate_individual(target, np.mean(targets, axis=0), 0.5) for target in targets]
            new_population = np.concatenate((population[1:], mutated_targets))
            population = evaluate_population(new_population)
        return np.argmin(population)

    def simulated_annealing(func, dim, lb, ub, budget, rng):
        temperature = 10
        individual = generate_initial_population(dim, lb, ub)[0]
        best_individual = individual
        for i in range(budget - 1):
            new_individual = individual + (rng.rand(dim) - 0.5) * temperature
            new_individual = clip(new_individual)
            if func(new_individual) < func(best_individual):
                best_individual = new_individual
            elif rng.rand() < np.exp((func(individual) - func(new_individual)) / temperature):
                individual = new_individual
            else:
                individual = best_individual
            temperature *= 0.99
        return best_individual

    population = generate_initial_population(dim, lb, ub)
    best_individual = simulated_annealing(func, dim, lb, ub, budget // 2, rng)
    differential_evolution(population, func, dim, lb, ub, budget // 2, rng)
    return best_individual
