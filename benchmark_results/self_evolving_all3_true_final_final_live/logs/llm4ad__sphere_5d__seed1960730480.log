def algorithm(func, dim, lb, ub, budget, rng):
    candidate = np.zeros(dim)
    best_candidate = candidate.copy()
    best_value = func(candidate)

    for _ in range(budget):
        step_size = 0.1 * (ub - lb) / rng.rand()
        delta = np.clip(rng.randn(dim), -step_size, step_size)
        new_candidate = best_candidate + delta
        new_candidate = np.clip(new_candidate, lb, ub)

        new_value = func(new_candidate)
        if new_value < best_value:
            best_candidate = new_candidate.copy()
            best_value = new_value

    return best_candidate
