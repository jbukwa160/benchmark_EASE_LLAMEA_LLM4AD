def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_x = rng.uniform(-5.0, 5.0, size=dim)
    best_f = func(clip(best_x))
    
    for _ in range(budget):
        x = rng.normal(size=dim)
        step_size = 1e-3 / (1 + (_ // 100)**0.2)  # adaptive learning rate
        x += clip(step_size * np.array(rng.uniform(-5.0, 5.0, size=dim)))
        
        f = func(clip(x))
        
        if f < best_f:
            best_x = x
            best_f = f
    
    return best_x
