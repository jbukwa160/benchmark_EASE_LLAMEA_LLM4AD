def algorithm(func, dim, lb, ub, budget, rng):
    n_iterations = int(budget)
    x_best = None
    y_best = float('inf')
    X = []
    Y = []

    for i in range(n_iterations):
        # Sample from the surrogate model using Acquisition Function (EF acquisition function is used here)
        mu, sigma = gp.predict(np.array([np.mean(X, axis=0)]), full_cov=False)
        ef = np.exp(-(mu - np.min(Y)) / (sigma + 1e-8))
        acq_func = ef
        x_new = sample_x(acq_func, X, dim, lb, ub, rng)

        # Evaluate the function at x_new
        y_new = func(x_new)

        # Update the GP model with new data
        X.append(x_new)
        Y.append(y_new)
        gp.fit(np.array(X), np.array(Y))

        # Update best solution
        if y_new < y_best:
            y_best = y_new
            x_best = x_new

    return x_best
