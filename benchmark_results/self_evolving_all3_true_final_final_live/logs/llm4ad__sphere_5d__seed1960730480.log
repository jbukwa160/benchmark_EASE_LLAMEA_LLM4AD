def algorithm(func, dim, lb, ub, budget, rng):
    def sphere(x):
        return sum(i**2 for i in x)

    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    def mutate(x):
        mutation_prob = 0.1
        mutation_std = 0.5
        new_x = x.copy()
        for i in range(dim):
            if rng.random() < mutation_prob:
                if rng.random() < 0.5:
                    new_x[i] += rng.normal(0, mutation_std)
                else:
                    new_x[i] += rng.standard_cauchy() * mutation_std
        return clip(new_x)

    def hybrid_acceptance(prob):
        accept_prob = min(1, prob ** (1 / (budget - 1)))
        return rng.random() < accept_prob

    x_best = np.zeros(dim)
    best_value = func(x_best)

    temperature = 10.0
    cooling_rate = 0.99
    budget_count = 0

    for _ in range(budget):
        new_x = mutate(x_best.copy())
        new_value = sphere(new_x)
        budget_count += 1

        delta = new_value - best_value
        if delta < 0:
            x_best = new_x
            best_value = new_value
        else:
            acceptance_prob = np.exp(-delta / temperature)
            if hybrid_acceptance(acceptance_prob):
                x_best = new_x
                best_value = new_value

        temperature *= cooling_rate

    return x_best
