def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 1000
    T_min = 1e-6
    alpha = 0.9
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        new_x = x.copy()
        
        # Clip candidates to [lb, ub]
        for i in range(dim):
            if rng.random() < 0.5:
                new_x[i] += np.random.uniform(-1, 1) * (ub - lb)
                new_x[i] = max(lb, min(ub, new_x[i]))
            else:
                new_x[i] -= np.random.uniform(-1, 1) * (ub - lb)
                new_x[i] = max(lb, min(ub, new_x[i]))
        
        new_f = func(new_x)
        
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f
        
        delta = new_f - best_f
        if delta <= 0 or rng.random() < np.exp(-delta / T):
            x = new_x.copy()
        
        T *= alpha
        
        # If temperature becomes too small, stop early
        if T < T_min:
            break
    
    return best_x
