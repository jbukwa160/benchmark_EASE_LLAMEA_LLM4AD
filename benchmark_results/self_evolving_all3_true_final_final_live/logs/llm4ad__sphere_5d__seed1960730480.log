def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    T = 1.0
    for _ in range(budget):
        y = clip(x + rng.normal(size=dim) * 0.5)
        if func(y) < func(best_x):
            best_x = y
        dE = func(best_x) - func(clip(y))
        
        # Adaptive Random Search (ARS) for local search
        if dE > 0 and T > 1e-3:
            for _ in range(int(np.sqrt(budget))):
                z = clip(best_x + rng.normal(size=dim) * 0.01)
                if func(z) < func(best_x):
                    best_x = z
        
        # Simulated Annealing
        if dE <= 0 or rng.uniform() < np.exp(-dE / T):
            x = y
        else:
            a = rng.uniform(0, 1)
            T *= 2 * a - 1.0
    return best_x
