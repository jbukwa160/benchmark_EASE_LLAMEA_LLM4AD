def algorithm(func, dim, lb, ub, budget, rng):
    def sample(rng, dim, lb, ub):
        return (ub - lb) * rng.uniform(size=dim) + lb

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x = sample(rng, dim, lb, ub)
    cma_sigma = 1.0
    cma_mu = np.zeros(dim)
    cma_covar = np.eye(dim)
    counter = 0

    while counter < budget:
        counter += 1
        candidate = clip(x + cma_sigma * np.random.normal(size=dim), lb, ub)
        f_candidate = func(candidate)

        if f_candidate < func(clip(x, lb, ub)):
            x = candidate
            cma_mu = (cma_mu * (counter - 1) / counter + candidate) / counter
            cma_covar = ((counter - 2) / (counter - 1)) * cma_covar + ((candidate - cma_mu) ** 2) / counter
        else:
            child = clip(cma_mu + np.random.normal(size=dim, loc=0, scale=np.sqrt(np.diag(cma_covar))), lb, ub)
            f_child = func(child)

            if f_child < f_candidate:
                x = child

    return clip(x, lb, ub)
