def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    pop_size = 50
    num_generations = int(budget / (dim * pop_size))
    sigma = 0.1
    T = 10.0

    x_pop = rng.uniform(lb, ub, size=(pop_size, dim))
    y_pop = np.zeros(pop_size)

    for i in range(num_generations):
        for j in range(pop_size):
            candidate = clip(x_pop[j] + sigma * rng.normal(size=dim))

            y_candidate = func(candidate)
            y_j = func(x_pop[j])

            if y_candidate < y_j:
                x_pop[j] = candidate
                y_pop[j] = y_candidate

        for j in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size, size=3)
            while r1 == r2 or r1 == r3 or r2 == r3:
                r1, r2, r3 = rng.randint(0, pop_size, size=3)

            candidate = clip(x_pop[r1] + 0.5 * (x_pop[r2] - x_pop[r3]) + sigma * rng.normal(size=dim))

            y_candidate = func(candidate)
            y_j = func(x_pop[j])

            if y_candidate < y_j:
                x_pop[j] = candidate
                y_pop[j] = y_candidate

        for j in range(pop_size):
            y_j = y_pop[j]

            r1, r2, r3 = rng.randint(0, pop_size, size=3)
            while r1 == r2 or r1 == r3 or r2 == r3:
                r1, r2, r3 = rng.randint(0, pop_size, size=3)

            candidate = clip(x_pop[j] + sigma * (x_pop[r1] - x_pop[r2]) + T * np.exp(-i / num_generations) * rng.normal(size=dim))

            y_candidate = func(candidate)
            if y_candidate < y_j:
                x_pop[j] = candidate
                y_pop[j] = y_candidate

    return clip(x_pop[np.argmin(y_pop)])
