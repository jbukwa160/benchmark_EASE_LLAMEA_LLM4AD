def algorithm(func, dim, lb, ub, budget, rng):
    def surrogate(x):
        return -np.mean(np.log(1 + func(x)))

    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    gp = GaussianProcessRegressor(kernel=np.r_[np.eye(dim)]*0.1)
    gp.fit(best_x[:, None], np.array([best_f]*dim))

    for _ in range(budget):
        x = gp.predict(np.atleast_2d(rng.randn(dim)))[0]
        x = (x + lb) / 2 * (ub - lb) + lb

        if func(x) < best_f:
            best_x = x
            best_f = func(x)
            gp.fit(best_x[:, None], np.array([best_f]*dim))

        # Local search
        x += rng.uniform(-0.1, 0.1, size=dim)
        x = clip(x, lb, ub)

        if func(x) < best_f:
            best_x = x
            best_f = func(x)

    return best_x
