def algorithm(func, dim, lb, ub, budget, rng):
    n_dim = dim
    n_iter = int(budget)
    
    def expected_improvement(x, y_best):
        mu, sigma = func(x), 1e-6
        z = (mu - y_best) / sigma if sigma > 0 else np.inf
        return (y_best - mu) * norm_cdf(z) + sigma * norm_pdf(z)
    
    def entropy_gain(x, y_best):
        x_all = get_points_in_hypercube(lb, ub, n_dim)
        mu, sigma = func(x), 1e-6
        z = (mu - y_best) / sigma if sigma > 0 else np.inf
        return norm_cdf(z) * np.log(len(x_all))
    
    def custom_acquisition_function(x):
        ei = expected_improvement(x, func(np.array([1.0]*n_dim)))
        eg = entropy_gain(x, func(np.array([1.0]*n_dim)))
        return 0.8*ei + 0.2*eg
    
    x_best = np.array([np.mean((lb+ub)/2)] * n_dim)
    y_best = func(x_best)
