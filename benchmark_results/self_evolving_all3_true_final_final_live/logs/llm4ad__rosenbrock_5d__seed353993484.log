def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    x_best = np.random.uniform(lb, ub, (1, n))
    f_best = func(x_best)
    
    for _ in range(budget):
        sigma = 0.5 * (ub - lb) / np.sqrt(rng.rand())
        dist = rng.randn(n)
        
        while True:
            x_new = x_best + sigma * dist
            x_new = np.clip(x_new, lb, ub)
            
            if func(x_new) < f_best:
                x_best = x_new
                f_best = func(x_new)
                
            dist -= 0.1 / (n * rng.rand()) * dist
            if np.linalg.norm(dist) > 100:
                break
                
        if budget % 10 == 0:
            x_best = np.random.uniform(lb, ub, (1, n))
            f_best = func(x_best)
            
    return x_best
