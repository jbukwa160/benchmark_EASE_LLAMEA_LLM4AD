def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(candidate):
        candidate = clip(candidate)
        return func(candidate)

    def sa_step(current_best, temperature):
        new_candidate = current_best + rng.normal(size=dim) * 0.1
        if evaluate(new_candidate) < evaluate(current_best):
            return new_candidate
        else:
            probability = np.exp((evaluate(current_best) - evaluate(new_candidate)) / temperature)
            if rng.random() < probability:
                return new_candidate
            else:
                return current_best

    def de_step(population, bounds):
        for i in range(len(population)):
            mutation_vector = population[np.random.choice(range(len(population)), size=len(population), replace=True)] - population[i]
            mutation_vector /= np.linalg.norm(mutation_vector)
            candidate = population[i] + rng.uniform(-1, 1) * mutation_vector
            candidate = clip(candidate)
            if evaluate(candidate) < evaluate(population[i]):
                population[i] = candidate
        return population

    current_best = lb + (ub - lb) * np.random.rand(dim)
    temperature = 10.0

    for _ in range(budget):
        new_candidate = sa_step(current_best, temperature)
        if evaluate(new_candidate) < evaluate(current_best):
            current_best = new_candidate
        population = [current_best]
        de_population_size = int(np.sqrt(len(population)))
        for _ in range(de_population_size):
            population.append(lb + (ub - lb) * np.random.rand(dim))
            population = de_step(population, [lb, ub])
        current_best = np.min(population, key=evaluate)
        temperature *= 0.99

    return clip(current_best)
