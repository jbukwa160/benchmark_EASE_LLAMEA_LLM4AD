def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    D = 2 * n
    mean = np.zeros(dim)
    cov = (ub - lb) ** 2 / 5 * np.eye(n) + 0.01 * np.ones((n, n))
    candidates = []
    for _ in range(budget):
        x = rng.multivariate_normal(mean, cov)
        x = np.clip(x, lb, ub)
        y = func(x)
        candidates.append(y)
        new_mean, new_cov = update_gaussian(mean, cov, x, y)
        mean = 0.1 * new_mean + (1 - 0.1) * mean
        cov = 0.9 * new_cov + 0.1 * cov
    best_idx = np.argmin(candidates)
    return np.array([x for x, y in zip(candidates[best_idx], candidates)])
