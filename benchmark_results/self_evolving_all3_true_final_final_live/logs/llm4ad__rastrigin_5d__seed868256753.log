def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    temp = 1.0
    tmax = 10000.0
    tmin = 1e-6
    cooling_rate = 0.99

    for _ in range(budget):
        x_new = x.copy()
        for i in range(dim):
            v = rng.uniform(-1, 1)
            x_new[i] += v * (x[i] - lb) + rng.uniform(lb, ub)

        x_new = clip(x_new)
        f_new = objective(x_new)
        f_x = objective(x)

        if f_new < f_x:
            x = x_new
            temp *= cooling_rate

        elif np.random.rand() < np.exp((f_x - f_new) / temp):
            x = x_new
            temp *= cooling_rate

    return x
