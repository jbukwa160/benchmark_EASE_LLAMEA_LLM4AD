def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best = np.zeros(dim)
    curr = best.copy()
    radius = 2 * (ub - lb) / dim
    iteration = 0

    while iteration < budget:
        for i in range(dim):
            perturbation = rng.uniform(-radius, radius)
            candidate = clip(curr + perturbation)

            if func(candidate) < func(curr):
                curr = candidate

        best = np.where(np.abs(best - curr) > 1e-5, curr, best)
        iteration += 1
        radius *= 0.99

    return best
