def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    def clip(candidate):
        clipped = np.clip(candidate, lb, ub)
        return clipped

    pop_size = 50
    x0 = np.random.uniform(lb, ub, size=(pop_size, dim))

    for _ in range(budget):
        # Random Search step
        new_x = np.random.uniform(lb, ub, size=(1, dim))
        if evaluate(new_x) < evaluate(x0):
            x0 = new_x

        # Differential Evolution step
        r1 = rng.randint(0, pop_size)
        r2 = rng.randint(0, pop_size)
        while r1 == r2:
            r2 = rng.randint(0, pop_size)

        v = 0.5 * (x0[r1] + x0[r2]) + np.random.uniform(-0.5, 0.5, size=dim)
        new_v = clip(v)
        if evaluate(new_v) < evaluate(x0):
            x0 = new_v

    return x0
