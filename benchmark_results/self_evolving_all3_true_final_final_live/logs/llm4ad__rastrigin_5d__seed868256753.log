def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 1e3
    cooling_rate = 0.99
    step_size = 1e-4
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Differential Evolution step
        v = rng.uniform(lb, ub, size=dim)
        w = rng.uniform(lb, ub, size=dim)
        u = 2 * rng.uniform(0, 1, size=dim) - 1

        new_x = x + step_size * (v - w) * u
        new_f = func(new_x)

        # Simulated Annealing step
        if np.random.rand() < np.exp((best_f - new_f) / T):
            x = new_x.copy()
            best_x = x.copy()
            best_f = new_f

        T *= cooling_rate

        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
        best_x = np.clip(best_x, lb, ub)

    return best_x
