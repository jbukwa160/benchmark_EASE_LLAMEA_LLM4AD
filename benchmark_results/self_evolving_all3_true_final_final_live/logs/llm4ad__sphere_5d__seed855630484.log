def algorithm(func, dim, lb, ub, budget, rng):
    def get_init_pop(dim, lb, ub, rng):
        init_pop = np.zeros((100, dim))
        for i in range(100):
            init_pop[i] = rng.uniform(lb, ub, size=dim)
        return init_pop

    pop = get_init_pop(dim, lb, ub, rng)

    for _ in range(budget):
        temp_pop = np.copy(pop)
        for i in range(100):
            mutation_dist = np.zeros(dim)
            for j in range(3):
                idx_j = (i + j) % 100
                mutation_dist += pop[idx_j] - pop[i]
            mutation_dist /= 3.0
            temp_pop[i] = pop[i] + 0.5 * rng.uniform(-1, 1) * mutation_dist

        best_idx = np.argmin([func(temp_pop[i]) for i in range(100)])
        if func(pop[best_idx]) > func(temp_pop[best_idx]):
            pop[best_idx] = temp_pop[best_idx]

    return np.clip(np.amin(pop, axis=0), lb, ub)
