def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        n_iter = 0
        while n_iter < 10 and not np.any(np.isclose(x, best_x)):
            n_iter += 1
            g = 2 * (x - best_x)
            alpha = 1e-3
            x_new = x - alpha * g

            # Clip to bounds
            for i in range(dim):
                if x_new[i] < lb:
                    x_new[i] = lb
                elif x_new[i] > ub:
                    x_new[i] = ub

            f_new = func(x_new)
            if f_new <= best_f:
                best_x = x_new.copy()
                best_f = f_new

            # Exploration
            sigma = 1.0 / (np.sqrt(n_iter) + 1e-6)
            delta = np.random.normal(size=dim, loc=0, scale=sigma)
            x += delta

            # Clip to bounds
            for i in range(dim):
                if x[i] < lb:
                    x[i] = lb
                elif x[i] > ub:
                    x[i] = ub

    return best_x
