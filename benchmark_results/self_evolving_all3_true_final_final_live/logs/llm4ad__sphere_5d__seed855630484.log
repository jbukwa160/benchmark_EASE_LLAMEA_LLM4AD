    def clip(x):
        return np.clip(x, lb, ub)

    # Initialize parameters
    pop_size = 50
    sigma = 5.0
    temperature = 100.0
    cooling_rate = 0.99

    # Initialize population
    x = rng.uniform(lb, ub, (pop_size, dim))

    for _ in range(budget):
        # Evaluate function at current population
        f_x = np.array([func(clip(x_i)) for x_i in x])

        # Selection and mutation
        indices = np.argsort(f_x)
        y = x[indices[:int(pop_size/2)]]
        z = y + sigma * rng.normal(size=y.shape)

        # Differential evolution step
        v = clip(z + 0.5 * (y - x[indices[int(pop_size/2):]])[np.random.choice(int(pop_size/2), size=dim, replace=False)])

        # Simulated annealing step
