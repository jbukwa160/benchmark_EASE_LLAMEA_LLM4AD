def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(size, dim):
        return rng.uniform(lb, ub, size=(size, dim))

    def clip_candidate(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def evaluate_candidate(candidate, func):
        return func(candidate)

    initial_population = generate_initial_population(50, dim)
    population_history = [initial_population]
    best_so_far = initial_population[np.argmin([evaluate_candidate(x, func) for x in initial_population])]

    learning_rate = 0.1

    for _ in range(budget):
        new_generation = np.array(population_history[-1])
        gradients = np.array([[func(np.clip(x + 0.001, lb, ub)) - func(np.clip(x - 0.001, lb, ub)) / 2
                              for x in population_history[-1]]])

        for i in range(50):
            new_individual = best_so_far.copy()
            for j in range(dim):
                perturbation = rng.normal(0, learning_rate)
                new_individual[j] += gradients[i, j] * perturbation
                new_individual = clip_candidate(new_individual, lb, ub)

            new_generation[i] = new_individual

        population_history.append(new_generation)
        best_so_far = new_generation[np.argmin([evaluate_candidate(x, func) for x in new_generation])]

    return best_so_far[np.argmin([evaluate_candidate(x, func) for x in population_history[-1]])]
