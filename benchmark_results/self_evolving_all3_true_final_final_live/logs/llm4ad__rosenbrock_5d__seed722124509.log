def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = 100
    pop = rng.uniform(lb, ub, (pop_size, dim))
    best_x = None
    for t in range(budget):
        new_pop = []
        for _ in range(pop_size):
            idx1, idx2 = rng.choice(dim, size=2, replace=False)
            x1 = clip(pop[idx1])
            x2 = clip(pop[idx2])
            y1 = func(x1)
            y2 = func(x2)
            if y1 < y2:
                new_pop.append(clip(x1 + 0.01 * rng.normal(size=dim)))
            else:
                new_pop.append(clip(0.9 * x1 + 0.1 * rng.uniform(lb, ub, size=dim) +
                                    0.1 * (x2 - x1)))
        pop = np.array(new_pop)
        
        # Simulated Annealing
        T = 10
        for i in range(pop_size):
            x_new = clip(pop[i] + rng.normal(size=dim))
            y_new = func(x_new)
            delta = y_new - func(pop[i])
            if delta < 0 or np.random.rand() < np.exp(-delta / T):
                pop[i] = x_new
                if best_x is None or delta < func(best_x):
                    best_x = x_new
        
        # Differential Evolution
        for i in range(3, pop_size):
            v = (pop[(i-1) % pop_size] + pop[(i+1) % pop_size]) / 2 + rng.normal(size=dim)
            y_v = func(v)
            if y_v < func(pop[i]):
                pop[i] = clip(v)
        
        # Update best solution
        for i in range(pop_size):
            x = pop[i]
            if best_x is None or func(x) < func(best_x):
                best_x = x
    
    return best_x
