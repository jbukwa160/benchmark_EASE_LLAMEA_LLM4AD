def algorithm(func, dim, lb, ub, budget, rng):
    def eval(x):
        return func(np.clip(x, lb, ub))

    D = dim
    mu = 1.0 / D
    sigma = 10.0
    c1 = 1 + (mu - 1) * 2 / (D + 3)
    c3 = 1 - 4 / (D + 3)

    x_mean = np.zeros(D)
    cov = np.eye(D)
    best_x = np.copy(x_mean)
    best_f = float('inf')

    for _ in range(budget):
        z = rng.randn(D)
        y = c1 * z + (1 - c1) * x_mean
        delta = sigma * np.dot(np.linalg.cholesky(cov), z)

        f_new = eval(y + delta)
        if f_new < best_f:
            best_x = y + delta
            best_f = f_new

        if rng.rand() < 0.1:  # 10% chance of mutation
            x_mean += 2 * sigma * rng.randn(D)

        cov += c3 * np.dot((y - x_mean).reshape(-1, 1), (y - x_mean).reshape(1, -1))
        cov = 0.5 * (cov + cov.T) + c3 * np.eye(D)

    return best_x
