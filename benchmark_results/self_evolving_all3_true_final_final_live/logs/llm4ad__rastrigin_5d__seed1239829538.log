def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def simulate_annealing(x0, T, alpha, iterations):
        x = x0.copy()
        for _ in range(iterations):
            new_x = x + (ub - lb) * rng.rand(dim)
            delta = func(new_x) - func(x)
            if delta < 0 or np.random.rand() < np.exp(-delta / T):
                x = new_x
            T *= alpha
        return x

    def differential_evolution(x0, iterations):
        pop_size = int(np.sqrt(budget))
        population = rng.uniform(lb, ub, (pop_size, dim))
        for _ in range(iterations):
            differences = np.abs(population[:, np.newaxis] - population)
            indices = np.argsort(differences, axis=1)[:, 1:]
            new_population = population.copy()
            for i in range(pop_size):
                mutation = differences[i, indices[i]] * rng.uniform(-1, 1, dim)
                trial = clip(population[i] + mutation)
                if func(trial) < func(new_population[i]):
                    new_population[i] = trial
            population = new_population.copy()
        return np.mean(population, axis=0)

    x = rng.uniform(lb, ub, dim)
    best_x = x.copy()

    for iteration in range(budget):
        if iteration % 100 == 0:
            # Switch to SA every 100 iterations
            x = simulate_annealing(x, 1.0, 0.99, 200)
        else:
            x = differential_evolution(x, 20)

        f_x = func(x)
        if f_x < func(best_x):
            best_x = x

    return best_x
