def algorithm(func, dim, lb, ub, budget, rng):
    def bounds(x):
        return np.clip(x, lb, ub)

    def fitness(x):
        x = bounds(x)
        return func(x)

    def stepsize(budget_left, population_size):
        if budget_left < 5 * dim:
            return 1e-6
        else:
            return 0.25 / (population_size ** (2/len(rng)))

    def cma_es(population_size, budget_left):
        mean = np.zeros(dim)
        sigma = stepsize(budget_left, population_size)
        lambda_ = population_size

        for _ in range(int(budget / population_size)):
            # Sample
            population = rng.randn(population_size, dim) + mean
            fitness_values = [fitness(x) for x in population]
            indices = np.argsort(fitness_values)

            # Update
            top = np.array([population[i] for i in indices[:int(lambda_/2)]])
            bottom = np.array([population[i] for i in indices[int(lambda_/2):]])

            mean_new = np.mean(top, axis=0)
            sigma_new = np.mean(np.linalg.norm(top - mean_new, axis=1)) / 0.5

            # Adapt step size
            sigma *= (budget_left // population_size) ** (2/len(rng))

            if fitness_values[indices[0]] < 10 * dim:
                return mean_new

            mean = mean_new
            sigma = sigma_new

        return mean

    best_x = np.zeros(dim)
    for _ in range(budget):
        x = cma_es(10, budget - _)
        if fitness(x) < fitness(best_x):
            best_x = x

    return best_x
