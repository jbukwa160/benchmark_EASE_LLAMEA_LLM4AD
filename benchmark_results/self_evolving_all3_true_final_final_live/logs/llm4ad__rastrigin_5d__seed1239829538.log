def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(size):
        return rng.uniform(lb, ub, size=(size, dim))

    def select_parents(population):
        _, indices = np.argpartition(-population[:, 0], 2)
        return population[indices[:2]]

    def crossover(parent1, parent2):
        offspring = parent1.copy()
        for i in range(dim):
            if rng.random() < 0.5:
                offspring[i] += rng.uniform(-ub, ub) * (parent2[i] - parent1[i])
        return clip(offspring)

    population_size = min(100, budget)
    initial_population = generate_initial_population(population_size)
    best_solution = np.zeros(dim)

    for _ in range(budget):
        selected_parents = select_parents(initial_population)
        offspring = []
        for _ in range(population_size - 2):
            offspring.append(crossover(selected_parents[0], selected_parents[1]))
        new_population = np.vstack((initial_population, [selected_parents[0]] * (population_size - 2) + offspring))
        best_solution = new_population[np.argmin([func(clip(x)) for x in new_population])]
        initial_population = new_population

    return clip(best_solution)
