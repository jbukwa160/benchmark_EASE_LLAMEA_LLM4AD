def algorithm(func, dim, lb, ub, budget, rng):
    candidates = np.random.uniform(lb, ub, size=(budget, dim))
    for i in range(budget - 1):
        scores = [func(c) for c in candidates]
        best_idx = np.argmin(scores)
        best_score = scores[best_idx]
        
        # clip the best candidate to bounds
        best_candidate = np.clip(candidates[best_idx], lb, ub)
        
        # create a new candidate by adding some noise to the best
        noise = rng.uniform(-1, 1, size=dim) * (ub - lb)
        new_candidate = best_candidate + noise
        
        # clip the new candidate to bounds
        new_candidate = np.clip(new_candidate, lb, ub)
        
        candidates[i + 1] = new_candidate
    
    scores = [func(c) for c in candidates]
    best_idx = np.argmin(scores)
    best_score = scores[best_idx]
    
    # clip the best candidate to bounds
    best_candidate = np.clip(candidates[best_idx], lb, ub)
    
    return best_candidate
