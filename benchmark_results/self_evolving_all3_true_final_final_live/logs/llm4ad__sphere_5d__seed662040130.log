def algorithm(func, dim, lb, ub, budget, rng):
    x = 5 * (np.random.rand(dim) - 0.5)
    best_x = x.copy()
    best_f = func(x)

    T = 1000.0
    cooling_rate = 0.99

    for _ in range(budget):
        new_x = x + rng.uniform(-1, 1, size=dim)
        new_x = np.clip(new_x, lb, ub)

        delta_f = func(new_x) - best_f

        if delta_f < 0 or (delta_f >= 0 and np.random.rand() < np.exp(-(best_f - func(new_x)) / T)):
            x = new_x
            best_x = new_x.copy()
            best_f = min(best_f, func(new_x))

        T *= cooling_rate

    return best_x
