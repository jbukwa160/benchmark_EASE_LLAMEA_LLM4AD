def algorithm(func, dim, lb, ub, budget, rng):
    def init_candidate():
        return [rng.uniform(lb, ub) for _ in range(dim)]

    def clip_candidate(candidate):
        clipped_candidate = []
        for i, val in enumerate(candidate):
            if val < lb:
                clipped_candidate.append(lb)
            elif val > ub:
                clipped_candidate.append(ub)
            else:
                clipped_candidate.append(val)
        return np.array(clipped_candidate)

    def evaluate_candidate(candidate):
        return func(candidate)

    current_best = init_candidate()
    current_best_value = evaluate_candidate(current_best)

    for _ in range(budget):
        candidate = clip_candidate(init_candidate())
        candidate_value = evaluate_candidate(candidate)

        if candidate_value < current_best_value:
            current_best = candidate
            current_best_value = candidate_value

        t = 0.999 * np.exp(-_ / (budget ** 2))
        if rng.uniform(0, 1) > t:
            current_best = clip_candidate(np.array(current_best + rng.normal(size=dim, loc=0, scale=0.5)))

    return current_best
