def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    for i in range(budget):
        step_size = max(0.1, 0.5 * (ub - lb) / (i + 2))
        x_candidate = x_best + step_size * rng.normal(size=dim) * np.ones((dim,))
        x_candidate = np.clip(x_candidate, lb, ub)
        f_candidate = func(x_candidate)
        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate
    return x_best
