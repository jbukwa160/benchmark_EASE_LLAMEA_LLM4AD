def algorithm(func, dim, lb, ub, budget, rng):
    x_best = (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    for i in range(budget):
        x_cand = x_best + (ub - lb) * (rng.rand(dim) - 0.5) / np.sqrt(i + 1)
        f_cand = func(np.clip(x_cand, a_min=lb, a_max=ub))
        
        if f_cand < f_best:
            x_best = x_cand
            f_best = f_cand

    return x_best
