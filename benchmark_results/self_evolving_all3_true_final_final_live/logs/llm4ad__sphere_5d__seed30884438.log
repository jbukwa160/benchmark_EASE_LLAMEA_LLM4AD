def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(-5.0, 5.0, size=dim)
    best_x = x.copy()
    best_y = func(x)

    for _ in range(budget):
        alpha = 1 / (10 + np.linalg.norm(best_x)) * rng.uniform(0.01, 0.1)
        g = 2 * x
        x = x - alpha * g

        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)

        y = func(x)
        
        if y < best_y:
            best_x = x.copy()
            best_y = y
    
    return best_x
