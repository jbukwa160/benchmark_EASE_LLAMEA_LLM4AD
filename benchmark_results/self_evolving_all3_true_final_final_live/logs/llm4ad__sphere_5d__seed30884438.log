def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 1.0 / (func(x) + 1e-6)
    T_min = 1e-4
    best_x = x.copy()
    for t in range(budget):
        # Random walk step
        y = x + rng.uniform(-1, 1, size=dim)
        y = np.clip(y, lb, ub)
        
        # Gaussian perturbation step
        y += rng.normal(0, T / (t + 1), size=dim)
        y = np.clip(y, lb, ub)
        
        # Metropolis acceptance criterion
        delta = func(x) - func(y)
        if delta < 0 or rng.rand() * np.exp(-delta / T) > 1:
            x = y.copy()
            best_x = y.copy()
        
        # Temperature schedule
        T *= 0.99
    return best_x
