def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    f_best = func(x_best)
    
    for i in range(budget - 1):
        x_cand = x_best.copy()
        
        # Random perturbation
        idx = rng.choice(dim, size=rng.integers(1, dim + 1), replace=False)
        x_cand[idx] += rng.uniform(-1, 1)
        
        # Clip candidates to [lb, ub]
        np.clip(x_cand, lb, ub, out=x_cand)
        
        f_cand = func(x_cand)
        
        if f_cand < f_best:
            x_best = x_cand
            f_best = f_cand
    
    return x_best
