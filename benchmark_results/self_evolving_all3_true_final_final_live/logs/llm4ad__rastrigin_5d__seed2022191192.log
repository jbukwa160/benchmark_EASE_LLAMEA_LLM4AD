def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def objective(params):
        return func(params)

    best_params = -np.ones(dim)
    best_value = float('inf')

    for i in range(budget):
        # Differential Evolution
        params_de = rng.uniform(lb, ub, size=(1, dim))
        for j in range(1, 5):
            trial_params = clip(params_de + rng.uniform(-1, 1, size=dim), lb, ub)
            if objective(trial_params) < best_value:
                best_value = objective(trial_params)
                best_params = trial_params

        # Simulated Annealing
        params_sa = best_params.copy()
        beta = 0.99
        tau = rng.uniform(1e-3, 1e-2)
        for _ in range(int(budget / 10)):
            trial_params = clip(params_sa + rng.normal(size=dim) * tau, lb, ub)
            if objective(trial_params) < best_value:
                params_sa = trial_params
                beta *= 0.99

        # Update best parameters
        if objective(best_params) > objective(params_sa):
            best_value = objective(params_sa)
            best_params = params_sa

    return best_params
