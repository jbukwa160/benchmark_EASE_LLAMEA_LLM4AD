def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    sigma = 0.1
    lambda_ = 100
    mu = lambda_ // 2
    d = dim

    for i in range(budget):
        x_new = np.zeros((lambda_, d))
        f_new = np.zeros(lambda_)
        
        for j in range(lambda_):
            noise = rng.normal(size=d) * sigma
            x_new[j] = clip(x + noise)
            f_new[j] = func(x_new[j])
        
        y = np.sort(f_new)[0:mu]
        r = (f_new - y[0]) / (y[mu-1] - y[0])
        i_ = np.argsort(r)[-1]
        x_next = clip(0.5 * x_new[i_] + 0.5 * x)
        
        if f_new[i_] < best_f:
            best_x = x_new[i_].copy()
            best_f = f_new[i_]
        
        x = x_next

    return best_x
