def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidates):
        return np.clip(candidates, lb, ub)

    def generate_initial_population(pop_size, lb, ub):
        return (ub - lb) * rng.rand(pop_size, dim) + lb

    def generate_neighbor(x, sigma):
        return x + sigma * (np.random.rand(dim) - 0.5) * 2

    population = generate_initial_population(100, lb, ub)
    best_individual = np.inf
    learning_rate = 0.1

    for _ in range(budget):
        for i in range(population.shape[0]):
            individual = func(clip(population[i]))
            if individual < best_individual:
                best_individual = individual
                best_index = i

            # Adaptive learning rate
            sigma = 10 / (1 + np.exp(-_ / 100))

            neighbor = generate_neighbor(population[i], sigma)
            neighbor_value = func(clip(neighbor))
            if neighbor_value < individual:
                population[i] = neighbor

        # Perturbation to escape local optima
        best_individual *= 0.99
        noise = (ub - lb) * rng.rand(dim) + lb
        population[best_index] += noise * learning_rate

    return clip(population[best_index])
