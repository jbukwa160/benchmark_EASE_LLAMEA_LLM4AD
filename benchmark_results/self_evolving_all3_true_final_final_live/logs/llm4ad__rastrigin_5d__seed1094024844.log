def algorithm(func, dim, lb, ub, budget, rng):
    n = int(np.ceil(budget / 0.1))
    pop_size = 50
    sigma_init = 5.0
    T = 1000.0
    cooling_rate = 0.99
    x_best = np.zeros(dim)
    f_best = float('inf')
    for i in range(n):
        pop = np.random.uniform(lb, ub, (pop_size, dim))
        for _ in range(10):
            differences = pop[:, None] - pop[None]
            differences = rng.permutation(differences) / rng.truncated_normal(1, 0.5, loc=0.001)
            y = pop + sigma_init * np.dot(differences, rng.normal(size=(pop_size, dim)))
            y = np.clip(y, lb, ub)
            f_y = func(y)
            idx_best = np.argmin(f_y)
            if f_y[idx_best] < f_best:
                x_best = y[idx_best]
                f_best = f_y[idx_best]
        sigma_init *= 0.9
        T *= cooling_rate
        pop = rng.normal(loc=x_best, scale=T / (T + 1), size=(pop_size, dim))
        pop = np.clip(pop, lb, ub)
    return x_best
