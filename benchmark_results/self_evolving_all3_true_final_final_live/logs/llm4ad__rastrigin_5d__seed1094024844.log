def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        z = np.copy(x_best)
        
        # Generate mutant
        while True:
            mu_i = []
            for j in range(dim):
                if rng.rand() < 0.5:
                    mu_i.append(rng.choice([x for i, x in enumerate(x_best) if i != j]))
                else:
                    mu_i.append(rng.choice([x for i, x in enumerate(z) if i != j]))
            mu = np.array(mu_i)
            
            # Check if mutant is within bounds
            if np.all((mu >= lb) & (mu <= ub)):
                break

        # Calculate mutant's fitness and mutation probability
        m_prob = 1 / (1 + func(mu))
        
        # Perform crossover
        for j in range(dim):
            if rng.rand() < m_prob:
                z[j] = mu[j]

        # Local search refinement
        x_new = np.copy(z)
        for i in range(dim):
            x_test = x_new.copy()
            x_test[i] += (ub - lb) * rng.uniform(-1, 1)
            if func(x_test) < func(x_new):
                x_new[i] = x_test[i]

        # Update best solution
        f_new = func(x_new)
        if f_new < f_best:
            x_best = np.copy(x_new)
            f_best = f_new

    return x_best
