def algorithm(func, dim, lb, ub, budget, rng):
    x0 = rng.uniform(lb, ub, size=dim)
    n_iter = 0
    while n_iter < budget:
        n_iter += 1
        res = optimize.minimize(lambda x: func(x), x0, method="SLSQP", bounds=[(lb, ub)]*dim, options={"maxiter": 1})
        if res.fun <= func(x0):
            x0 = res.x
    return x0
