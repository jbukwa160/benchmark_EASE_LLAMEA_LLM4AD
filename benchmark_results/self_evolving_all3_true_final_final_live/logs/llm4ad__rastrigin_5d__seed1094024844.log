def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    init_x = np.random.uniform(lb, ub, (dim,))
    x_best = init_x.copy()
    f_x_best = func(x_best)
    
    for i in range(budget):
        trial = x_best.copy()
        
        # Differential evolution mutation
        trial[0] += rng.normal(0, 1) * (x_best[0] - x_best[np.random.choice(dim-1)])
        for j in range(1, dim):
            trial[j] += rng.uniform(-1, 1) * (x_best[j] - x_best[j-1])
        
        # MOMA mutation
        for j in range(dim):
            if rng.uniform(0, 1) < 0.5:
                trial[j] = lb + (ub - lb) * rng.uniform(0, 1)
        
        trial = clip(trial)
        f_trial = func(trial)
        
        # Update best solution
        if f_trial < f_x_best:
            x_best = trial.copy()
            f_x_best = f_trial
    
    return x_best
