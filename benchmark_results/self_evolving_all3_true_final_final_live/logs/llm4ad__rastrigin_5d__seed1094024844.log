def algorithm(func, dim, lb, ub, budget, rng):
    n = 10 * np.ones(dim)  # initial lambda value for CMA-ES
    x = rng.uniform(lb, ub, size=(dim,))
    x_best = x.copy()
    f_best = func(x)
    
    for i in range(budget):
        y = x + 0.1 * rng.normal(size=x.shape)
        y = np.clip(y, lb, ub)  # clip to bounds
        
        n = int(max(10, min(n * (i + 2) / (i + 1), budget)))  # adaptive lambda
        y = np.random.multivariate_normal(x, np.eye(dim) if n == 0 else CMA_es_update(CMA_es_update(np.eye(dim), x, f_best), y, func))
        
        f_y = func(y)
        if f_y < f_best:
            x_best = y.copy()
            f_best = f_y
        elif rng.random() > (i + 1) / (budget + 2):  # restart with probability increasing with iteration number
            x = rng.uniform(lb, ub, size=(dim,))
    
    return x_best
