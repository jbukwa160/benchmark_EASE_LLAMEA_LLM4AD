def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)
    
    alpha = 0.1
    c1, c2 = 1, 1

    for i in range(budget):
        v1 = clip(x + alpha * rng.normal(size=dim))
        v2 = clip(best_x + alpha * rng.normal(size=dim))
        v3 = clip(x + c1 * (v1 - x) + c2 * (v2 - best_x))
        
        if func(clip(v3)) < best_f:
            best_f = func(clip(v3))
            best_x = clip(v3)
            
        x = np.array([y if rng.uniform() > 0.5 else clip(y + alpha * rng.normal(size=dim)) for y in v3])
        
    return best_x
