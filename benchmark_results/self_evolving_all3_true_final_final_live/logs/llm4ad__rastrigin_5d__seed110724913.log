def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(clip(x_best))

    for _ in range(budget):
        v1 = np.copy(x_best) + 0.2 * rng.uniform(-1, 1, size=dim)
        v2 = np.copy(x_best) + 0.5 * rng.uniform(-1, 1, size=dim)

        for i in range(dim):
            v1[i] = clip(v1[i])
            v2[i] = clip(v2[i])

        f_v1 = func(clip(v1))
        f_v2 = func(clip(v2))

        if f_v1 < f_best:
            x_best = np.copy(v1)
            f_best = f_v1
        elif f_v2 < f_best:
            x_best = np.copy(v2)
            f_best = f_v2

    return clip(x_best)
