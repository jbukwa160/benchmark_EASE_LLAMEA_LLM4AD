def algorithm(func, dim, lb, ub, budget, rng):
    def sample(dim):
        return rng.uniform(lb, ub, size=dim)

    def eval(x):
        return func(x) + 1e-10 * (x**2).sum()

    def clip(x):
        return np.clip(x, lb, ub)

    best_x = sample(dim)
    best_f = eval(best_x)

    noise_std = 0.5
    cov_mat = np.eye(dim)
    for _ in range(budget):
        x = clip(best_x + rng.normal(size=dim) * noise_std)
        f = eval(x)
        
        if f < best_f:
            best_x, best_f = x, f

        cov_mat = 0.8 * cov_mat + np.outer((x - best_x), (x - best_x))
        noise_std = np.sqrt(cov_mat.diagonal()).mean()

    return clip(best_x)
