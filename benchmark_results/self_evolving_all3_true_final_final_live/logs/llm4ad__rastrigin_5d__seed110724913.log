def algorithm(func, dim, lb, ub, budget, rng):
    def get_bounds():
        return [(lb + 0.5 * (ub - lb) * x[0], lb + 0.5 * (ub - lb) * x[1]) for x in rng.uniform(-5, 5, size=(budget, dim))]

    def cauchy_mutate(x, scale):
        return x + np.multiply(scale, rng.standard_cauchy((dim,)))

    def crossover(x1, x2):
        a = [0.9 if r < 1 else 0.1 for r in rng.uniform(0, 1, size=dim)]
        return (x1 * a) + ((1 - a) * x2)

    def evaluate_population(population):
        return np.array([func(x) for x in population])

    population = get_bounds()
    for _ in range(budget):
        fitness = evaluate_population(population)
        best_idx = np.argmin(fitness)
        best_x = population[best_idx]
        
        # Cauchy Mutation
        scale = 10 / (1 + np.linalg.norm(best_x))
        mutated_best = cauchy_mutate(best_x, scale)

        # Clip to bounds
        clipped_mutated_best = np.clip(mutated_best, lb, ub)
        
        # Crossover
        children = [crossover(clipped_mutated_best, x) for x in population]
        
        # Replace the worst individual with a child
        worst_idx = np.argmax(evaluate_population(children))
        population[worst_idx] = clipped_mutated_best
        
    return population[np.argmin(evaluate_population(population))]
