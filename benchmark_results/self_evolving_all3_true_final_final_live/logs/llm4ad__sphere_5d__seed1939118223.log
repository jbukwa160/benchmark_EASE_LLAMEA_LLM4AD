def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    best_val = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        val = func(x)
        if val < best_val:
            best = x
            best_val = val
        
        sigma = 1.0
        mu = np.zeros(dim)
        L = np.eye(dim) * (ub - lb)**2 / 10.0
        
        for i in range(5):
            K = np.linalg.cholesky(L).T
            x_t = rng.normal(mu, scale=sigma, size=dim)
            
            x_t[~np.isfinite(x_t)] = 0
            
            if _ < budget // 2:
                x_cand = lb + (ub - lb) * (x_t + np.dot(K, np.random.randn(dim)))
            else:
                x_cand = best + (ub - lb) * (x_t + np.dot(K, np.random.randn(dim)))
            
            val = func(x_cand)
            if val < best_val:
                best = x_cand
                best_val = val
                
    return best
