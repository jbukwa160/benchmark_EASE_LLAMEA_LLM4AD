def algorithm(func, dim, lb, ub, budget, rng):
    x = 5 * rng.rand(dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = best_x + (ub - lb) * rng.randn(dim)
        y = np.clip(y, lb, ub)
        f_y = func(y)
        
        if f_y < best_f:
            best_x = y
            best_f = f_y

        sigma = 0.1 + 0.9 * (ub - lb)**2 / ((best_f + 1) ** 2)
        step = rng.randn(dim) / np.linalg.norm(rng.randn(dim))
        step *= sigma

        for _ in range(8):
            z = best_x + step
            z = np.clip(z, lb, ub)
            f_z = func(z)

            if f_z < best_f:
                best_x = z
                best_f = f_z

    return best_x
