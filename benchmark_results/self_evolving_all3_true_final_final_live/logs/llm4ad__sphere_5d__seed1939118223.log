def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_candidate(current_solution):
        perturbation = (ub - lb) * rng.random(size=dim)
        new_solution = current_solution + perturbation
        return clip(new_solution)

    current_solution = rng.uniform(lb, ub, size=dim)
    best_solution = current_solution.copy()
    current_temperature = 1.0

    for _ in range(budget):
        candidate = generate_candidate(current_solution)
        if func(candidate) < func(best_solution):
            best_solution = candidate
        temperature_decrease_rate = 0.9999 ** (budget - _) / budget
        current_temperature *= temperature_decrease_rate

        probability = np.exp(-(func(candidate) - func(best_solution)) / current_temperature)
        if rng.random() < probability:
            current_solution = candidate

    return best_solution
