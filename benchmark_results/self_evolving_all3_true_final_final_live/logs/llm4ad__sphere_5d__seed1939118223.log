def algorithm(func, dim, lb, ub, budget, rng):
    x = [ub + (ub - lb) * np.random.rand(dim) for _ in range(budget)]
    
    for i in range(1, budget):
        y = []
        
        for j in range(i):
            v = [(x[j][k] if k != dim else rng.uniform(lb, ub)) 
                 for k in range(dim)]
            
            u = [(v[k] + (ub - lb) * rng.rand()) if i > 1 and rng.random() < 0.5 
                 else x[j][k] for k in range(dim)]
            
            y.append(np.array([min(max(u[k], lb), ub) for k in range(dim)]))
        
        x[i] = np.array(min(y, key=func))

    return min(x, key=func)
