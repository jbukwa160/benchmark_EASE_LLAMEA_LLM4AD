def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([0.0] * dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        step_size = 1e-2 + (ub - lb) * rng.uniform()
        direction = np.zeros(dim)
        for i in range(dim):
            if rng.random() < 0.5:
                direction[i] = rng.choice([-1, 1]) * step_size
            else:
                direction[i] = rng.gauss(0, step_size)

        new_x = x + direction
        clipped_x = np.clip(new_x, lb, ub)
        
        if func(clipped_x) < best_f:
            best_x = clipped_x.copy()
            best_f = func(clipped_x)

    return best_x
