def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def mutate(population, best, f, sigma):
        children = []
        for _ in range(len(population)):
            idx1, idx2, idx3 = np.random.choice(range(dim), 3, replace=False)
            child = population.copy()
            child[idx1] += rng.normal(0, sigma) * (best[idx1] - population[idx1])
            child[idx2] += rng.normal(0, sigma) * (best[idx2] - population[idx2])
            child[idx3] += rng.normal(0, sigma) * (best[idx3] - population[idx3])
            children.append(child)
        return np.array(children)

    def crossover(parent, child):
        return parent + 0.5 * (child - parent)

    def evaluate(population):
        return func(population)

    population = rng.uniform(lb, ub, size=(budget, dim))
    best_solution = None
    best_value = float('inf')

    for _ in range(budget):
        sigma = np.min(rng.uniform(0.1, 1.0, size=dim)) / 2

        mutated_population = mutate(population, clip(np.mean(population, axis=0)), func, sigma)
        clipped_mutated_population = clip(mutated_population)

        children = []
        for i in range(len(clipped_mutated_population)):
            child = crossover(clipped_mutated_population[i], population[i])
            children.append(child)

        next_generation = np.array(children)

        values = evaluate(next_generation)
        indices = np.argsort(values)
        next_generation = next_generation[indices]

        best_idx = np.argmin(values)
        if values[best_idx] < best_value:
            best_solution = next_generation[best_idx]
            best_value = values[best_idx]

        population = next_generation[:budget]

    return clip(best_solution)
