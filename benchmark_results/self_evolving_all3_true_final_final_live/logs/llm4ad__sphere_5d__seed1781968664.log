def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x_best = np.zeros(dim)
    y_best = float('inf')

    for _ in range(budget):
        mean = (ub + lb) / 2
        std_dev = (ub - lb) / 5

        # Sample from normal distribution with the current best solution as mean and a small standard deviation
        x_new = mean + rng.normal(size=dim, loc=mean, scale=std_dev)

        # Clip to bounds
        x_new = clip(x_new, lb, ub)

        y_new = func(x_new)
        
        if y_new < y_best:
            y_best = y_new
            x_best = x_new

    return x_best
