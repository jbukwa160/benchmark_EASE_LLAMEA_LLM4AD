def algorithm(func, dim, lb, ub, budget, rng):
    n_iter = int(budget / 0.1)
    x_best = np.random.uniform(lb, ub, size=dim)
    y_best = func(x_best)

    gp_mean = 0
    gp_std = 1

    for i in range(n_iter):
        # Sample a new point using the Gaussian process
        mean, std = gp_mean, gp_std
        x_new = np.random.normal(mean, std, size=dim)
        x_new = np.clip(x_new, lb, ub)

        # Evaluate the function at the new point
        y_new = func(x_new)

        # Calculate the probability of improvement
        pi = norm.cdf(y_best - y_new) if y_best - y_new > 0 else 1

        # If there's enough budget left and the new point is better or has a high probability of being better, update the best solution
        if (y_new < y_best and i < n_iter * 0.8) or np.random.rand() < pi:
            x_best = x_new
            y_best = y_new

    return x_best
