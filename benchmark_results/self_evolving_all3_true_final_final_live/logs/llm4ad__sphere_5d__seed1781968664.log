def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_x = None
    best_f = float('inf')

    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x

        # Adaptive bounds: shrink the search space towards the current optimum
        dist = np.linalg.norm(best_x - x)
        std_dev = 1.0 / (2 + _)
        lb = clip(best_x - std_dev * dist)
        ub = clip(best_x + std_dev * dist)

    return best_x
