def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.sqrt(budget))
    x_best = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    f_best = func(x_best)
    
    for i in range(pop_size - 1):
        x_rand = [x_best.copy() for _ in range(3)]
        
        for j in range(dim):
            if rng.random() < 0.5:
                x_rand[0][j] = np.clip(x_best[j] + 0.2 * (ub - lb) * rng.normal(size=None), lb, ub)
                x_rand[1][j] = np.clip(x_best[j] + 0.4 * (ub - lb) * rng.normal(size=None), lb, ub)
            else:
                x_rand[1][j] = np.clip(x_best[j] + 0.2 * (ub - lb) * rng.normal(size=None), lb, ub)
                x_rand[2][j] = np.clip(x_best[j] + 0.4 * (ub - lb) * rng.normal(size=None), lb, ub)
        
        f_rand = [func(x) for x in x_rand]
        idx = np.argsort(f_rand)[1:]
        
        if f_rand[idx[0]] < f_best:
            x_best = x_rand[idx[0]].copy()
            f_best = f_rand[idx[0]]
        
        for j, k in enumerate(idx):
            if f_rand[k] < f_rand[j]:
                x_rand[k][j] = np.clip((x_rand[k][j] + 0.5 * (ub - lb) * rng.normal(size=None)) + 
                                       0.7 * (x_best[j] - x_rand[k][j]), lb, ub)
    
    return x_best
