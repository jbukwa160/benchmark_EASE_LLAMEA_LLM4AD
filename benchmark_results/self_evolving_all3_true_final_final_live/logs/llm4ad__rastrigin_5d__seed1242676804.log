def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    xbest = np.zeros(dim)
    ybest = func(xbest)
    
    for _ in range(budget):
        pop = rng.uniform(lb, ub, (pop_size, dim))
        
        y_pop = np.array([func(x) for x in pop])
        
        fittest_idx = np.argmax(np.sum((ybest - y_pop)**2, axis=1))
        xbest_candidate = pop[fittest_idx]
        
        if ybest > y_pop[fittest_idx]:
            xbest = xbest_candidate
            ybest = y_pop[fittest_idx]
            
        for i in range(pop_size):
            mutant = 0.5*xbest + rng.uniform(lb, ub, dim) + rng.normal(size=dim)
            mutant = np.clip(mutant, lb, ub)
            y_mutant = func(mutant)
            
            if ybest > y_mutant:
                xbest = mutant
                ybest = y_mutant
                
    return xbest
