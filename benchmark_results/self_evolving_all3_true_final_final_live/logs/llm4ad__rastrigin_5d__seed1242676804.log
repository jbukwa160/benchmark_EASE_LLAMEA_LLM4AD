def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(dim, population_size, rng):
        return (ub - lb) * rng.rand(population_size, dim) + lb

    def evaluate_candidates(candidates):
        return func(candidates)

    def mutate(candidate, mutation_rate):
        mutated = np.copy(candidate)
        for i in range(dim):
            if rng.uniform(0, 1) < mutation_rate:
                mutated[i] += (ub - lb) * rng.uniform(-1, 1)
                mutated[i] = max(lb, min(ub, mutated[i]))
        return mutated

    def crossover(candidate1, candidate2):
        child = np.copy(candidate1)
        for i in range(dim):
            if rng.uniform(0, 1) < 0.5:
                child[i] = candidate2[i]
        return child

    population_size = 100
    mutation_rate = 0.01
    crossover_rate = 0.7
    population = generate_initial_population(dim, population_size, rng)
    best_candidate = np.argmin(evaluate_candidates(population))
    best_fitness = evaluate_candidates(population)[best_candidate]

    for i in range(budget):
        children = []
        for _ in range(population_size // 2):
            parent1_idx = rng.randint(0, population_size)
            parent2_idx = rng.randint(0, population_size)
            if rng.uniform(0, 1) < crossover_rate:
                child = crossover(population[parent1_idx], population[parent2_idx])
            else:
                child = np.copy(population[parent1_idx])
            children.append(child)

        for j in range(population_size // 2):
            candidate = mutate(children[j], mutation_rate)
            evaluate_candidate_fitness = func(candidate)
            if evaluate_candidate_fitness < best_fitness:
                best_candidate = j
                best_fitness = evaluate_candidate_fitness

        population = np.array(children + [population[best_candidate]])

    return population[best_candidate]
