def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    N = 50
    pop_size = int(np.sqrt(budget))
    x_best = np.zeros(dim)
    f_best = float('inf')
    iteration = 0

    while True:
        # Initialize population
        x = rng.uniform(lb, ub, size=(pop_size, dim))

        # Evaluate objective function
        f = func(x)

        # Find best solution
        idx = np.argmin(f)
        if f[idx] < f_best:
            f_best = f[idx]
            x_best = clip(x[idx])

        # Update parameters and sample from proposal distributions
        mu, sigma = 0.1 * rng.randn() + 1, 0.5 * rng.rand()
        for i in range(pop_size):
            epsilon = rng.normal(size=dim)
            x[i] = clip(mu + sigma * epsilon)

        iteration += 1

        # Check stopping criterion
        if f_best < 1e-6 or iteration >= budget:
            break

    return x_best
