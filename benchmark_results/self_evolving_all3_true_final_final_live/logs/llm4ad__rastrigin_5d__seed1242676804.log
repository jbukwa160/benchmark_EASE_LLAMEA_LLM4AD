def algorithm(func, dim, lb, ub, budget, rng):
    def eval(x):
        return func(np.clip(x, lb, ub))

    def gaussian_noise(sigma):
        return sigma * (rng.rand(dim) - 0.5)

    def differential_evolution(population, f, bounds, budget):
        n = len(population)
        for _ in range(budget):
            for i in range(n):
                j1 = np.random.randint(0, n)
                j2 = np.random.randint(0, n)
                if i != j1 and i != j2:
                    mutant = population[i] + gaussian_noise(0.01) * (population[j1] - population[j2])
                else:
                    mutant = population[i]
                mutant = f(mutant)
                if mutant < f(population[i]):
                    population[i] = mutant
        return np.array([f(x) for x in population])

    population = [np.random.uniform(lb, ub, dim) for _ in range(10)]
    while True:
        pop_evals = differential_evolution(population, eval, [[lb]*dim, [ub]*dim], budget//5)
        if len(np.unique([eval(x) for x in pop_evals])) == 1 or np.all(pop_evals == 0):
            return min(pop_evals, key=eval)
        population = np.random.choice(pop_evals, size=min(20, len(pop_evals)), replace=False)

    return None
