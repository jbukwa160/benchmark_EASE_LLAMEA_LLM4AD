def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    T = 1.0 + (ub - lb) / np.log(1 + budget)
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        y = x.copy()
        j = rng.randint(dim)
        y[j] += rng.uniform(-T, T)
        y = clip(y)

        f = func(y)
        if f < best_f:
            best_x = y
            best_f = f

        alpha = 0.99 ** i / (1 + i)
        T *= alpha

    return best_x
