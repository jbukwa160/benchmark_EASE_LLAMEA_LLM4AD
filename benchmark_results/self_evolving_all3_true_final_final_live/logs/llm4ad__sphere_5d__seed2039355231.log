def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x0 = rng.uniform(lb, ub, size=dim)
    sigma = 1.0
    mu = np.zeros(dim)
    cmu = np.eye(dim) * sigma**2

    for _ in range(budget):
        x = clip(mu + sigma * rng.randn(dim))
        fx = func(x)

        if fx < func(mu):
            mu = x
            cmu = 0.7 * cmu + 0.3 * (x - mu)[:, np.newaxis] @ (x - mu)
        else:
            cmu *= 1 - 2 / (budget + _)

    return clip(mu)
