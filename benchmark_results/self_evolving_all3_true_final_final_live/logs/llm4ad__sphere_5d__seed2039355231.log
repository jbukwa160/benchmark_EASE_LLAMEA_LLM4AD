def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        y = x + 0.5 * (rng.normal(size=dim) - 1)
        y = clip(y)
        f_y = func(y)
        
        if f_y < best_f:
            best_x = y.copy()
            best_f = f_y
        
        t = np.exp(-i / budget)
        p = rng.uniform(0, 1)
        if p < 0.01 * (1 - t):
            x = clip(best_x + rng.normal(size=dim) * t)

    return best_x
