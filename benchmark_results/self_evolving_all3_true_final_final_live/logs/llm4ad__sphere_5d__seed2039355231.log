def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x), len(np.where(x != 0)[0])

    def generate_new_x(population, learning_rate, step_size):
        mean, cov = population
        new_pop = np.zeros((dim,))
        for i in range(dim):
            x = np.random.normal(mean[i], np.sqrt(cov[i]))
            if rng.rand() < 0.5:
                x *= -1
            new_pop[i] = mean[i] + learning_rate * x / (np.sqrt(step_size) + 1e-8)
        return new_pop

    population = [np.zeros((dim,)), np.ones((dim,))]
    step_size = 1
    for _ in range(budget):
        fitnesses, lengths = zip(*[evaluate(generate_new_x(population, rng.uniform(0.1, 0.9), step_size)) for _ in range(10)])
        population = [np.mean(np.array([x[i] for x, f, l in zip([generate_new_x(population, rng.uniform(0.1, 0.9), step_size) for _ in range(100)], fitnesses, lengths)]).T, axis=0),
                      np.mean(np.var([x[i] for x, f, l in zip([generate_new_x(population, rng.uniform(0.1, 0.9), step_size) for _ in range(100)], fitnesses, lengths)], axis=0))]
        step_size *= 0.99
    best_x = generate_new_x(population, rng.uniform(0.1, 0.9), step_size)
    return clip(best_x)
