def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_x = None
    best_y = 1e10

    n_restart = int(np.ceil(budget / (2 * dim)))
    for _ in range(n_restart):
        x = rng.uniform(size=dim) - 0.5
        while True:
            y = func(x)
            if y < best_y:
                best_x = clip(x.copy())
                best_y = y
            if budget <= 0:
                break
            budget -= 1

            for i in range(dim):
                x[i] += rng.uniform(-0.5, 0.5)

        # Adaptive restart with polynomial mutation
        mu = np.mean(best_x)
        sigma = 2 * (np.max(ub) - np.min(lb)) / (dim + 1)
        for i in range(dim):
            x[i] = clip(np.random.uniform(lb, ub))
            if rng.rand() < 0.01:
                x[i] += rng.randn() * sigma
                x[i] = mu + rng.uniform(-1, 1) * (x[i] - mu)

    return best_x
