def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidates(population, temp):
        new_population = population + rng.uniform(-temp, temp, size=(population.shape[0], dim))
        return clip(new_population)

    def mutation(population):
        differences = rng.normal(size=population.shape)
        mutated_population = population + 0.1 * differences
        return clip(mutated_population)

    def differential_evolution(population, target_func, bounds, budget):
        best_solution = population[rng.choice(len(population))]
        while budget > 0:
            mutant = mutation(best_solution)
            if rng.random() < 0.5:
                mutant += 0.1 * (mutant - best_solution)
            fitness_mutant = target_func(mutant)
            if fitness_mutant < target_func(best_solution):
                best_solution = mutant
            budget -= 1
        return best_solution

    def simulated_annealing(population, target_func, bounds, initial_temp, cooling_rate, budget):
        best_solution = population[rng.choice(len(population))]
        current_temperature = initial_temp
        while budget > 0:
            candidate = generate_candidates(best_solution, current_temperature)
            fitness_candidate = target_func(candidate)
            if fitness_candidate < target_func(best_solution):
                best_solution = candidate
            elif rng.random() < np.exp((target_func(best_solution) - fitness_candidate) / current_temperature):
                best_solution = candidate
            current_temperature *= cooling_rate
            budget -= 1
        return best_solution

    population = np.random.uniform(lb, ub, size=(1000, dim))
    initial_population_best = func(population)
    initial_population_best_idx = np.argmin(initial_population_best)

    temp = 10.0
    current_temp = 10.0
    cooling_rate = 0.99

    for _ in range(budget):
        new_population_best = differential_evolution(population, func, (lb, ub), budget=100)
        initial_temperature_diff = np.abs(current_temp - temp)
        if rng.random() < 0.1 and initial_temperature_diff > 0.5:
            current_temp = temp
        population = generate_candidates(new_population_best, current_temp)

    final_solution = simulated_annealing(population, func, (lb, ub), current_temp, cooling_rate, budget=100)
    return final_solution
