def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.maximum(np.minimum(x, ub), lb)

    best_x = rng.uniform(lb, ub, size=dim)
    best_f = func(best_x)
    learning_rate = 0.1
    patience = 10

    for _ in range(budget):
        x = best_x + rng.normal(size=dim) * (ub - lb) / 5
        x = clip(x, lb, ub)

        f = func(x)
        if f < best_f:
            best_x = x
            best_f = f

        learning_rate *= 0.99
        patience -= 1

        if patience <= 0 or (budget - _ <= 100 and rng.uniform(0, 1) > 0.5):
            # restart with a new random solution
            best_x = rng.uniform(lb, ub, size=dim)
            patience = 10

    return best_x
