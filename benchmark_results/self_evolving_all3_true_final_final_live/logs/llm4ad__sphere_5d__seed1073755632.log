def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = dim
    n_gen = budget
    mu = 1 / D
    sigma0 = 10 * (ub - lb)
    c_sigma = 4 / (D + 2)
    cmu = 1

    x_best = np.random.uniform(lb, ub, size=D)
    f_best = func(x_best)

    for i in range(n_gen):
        y = clip(np.random.normal(loc=x_best, scale=sigma0 * np.exp(cmu * rng.normal(size=D)), size=D))
        y_new = func(y)
        if y_new < f_best:
            x_best = y
            f_best = y_new

    return x_best
