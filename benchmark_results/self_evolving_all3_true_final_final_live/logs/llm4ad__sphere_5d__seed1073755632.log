def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    best_sol = np.zeros(n)
    best_val = float('inf')
    
    for i in range(budget):
        step_size = 0.1 * (ub - lb) / (2 ** int(np.log2(i + 1)))
        new_sol = best_sol + rng.uniform(low=-step_size, high=step_size, size=n)
        
        # Clip to bounds
        new_sol = np.clip(new_sol, a_min=lb, a_max=ub)
        
        new_val = func(new_sol)
        if new_val < best_val:
            best_sol = new_sol
            best_val = new_val
            
    return best_sol
