def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    best_x = clip(rng.uniform(low=lb, high=ub, size=(dim)))
    best_f = func(best_x)

    for _ in range(budget):
        x = clip(rng.normal(loc=best_x, scale=0.1, size=(dim)))
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x

    return best_x
