def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_y = func(x)

    for t in range(budget):
        # Random Search (RS) phase
        if t < budget // 2:
            new_x = np.clip(rng.normal(loc=x, scale=np.sqrt(0.1), size=dim), a_min=lb, a_max=ub)
        else:
            # Cyclic Coordinate Descent (CCD) phase
            idx = (t + np.arange(dim)) % dim
            new_x = x.copy()
            for i in idx:
                new_x[i] = np.clip(rng.normal(loc=new_x[i], scale=np.sqrt(0.1), size=1)[0], a_min=lb, a_max=ub)
        
        new_y = func(new_x)

        if new_y < best_y:
            best_x = new_x.copy()
            best_y = new_y

    return best_x
