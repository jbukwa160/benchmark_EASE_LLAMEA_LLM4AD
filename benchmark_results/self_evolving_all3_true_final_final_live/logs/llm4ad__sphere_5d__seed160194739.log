def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    def clip_candidate(candidate):
        clipped_candidate = np.clip(candidate, a_min=lb, a_max=ub)
        return clipped_candidate

    def generate_initial_population(dim, lb, ub, rng):
        population = np.zeros((budget, dim))
        for i in range(budget):
            for j in range(dim):
                population[i, j] = rng.uniform(lb, ub)
        return population

    def differential_evolution(population, func, bounds, budget):
        best_solution = None
        best_value = float('inf')
        for _ in range(50):
            differences = np.zeros((budget, dim))
            for i in range(budget):
                for j in range(dim):
                    other = rng.choice(range(i+1, budget), replace=False)
                    differences[i, j] = population[other, j]
            mutation_factor = 0.5
            mutation = np.clip(differences * mutation_factor + population[:, None, :], a_min=bounds[0], a_max=bounds[1])
            crossover_prob = 0.7
            new_population = np.zeros((budget, dim))
            for i in range(budget):
                if rng.uniform(0, 1) < crossover_prob:
                    new_population[i] = mutation[i]
                else:
                    new_population[i] = population[i]
            best_individual = None
            best_value_individual = float('inf')
            for individual in new_population:
                value = evaluate(individual)
                if value < best_value_individual:
                    best_individual = individual
                    best_value_individual = value
            if best_value_individual < best_value:
                best_solution = best_individual
                best_value = best_value_individual
        return best_solution

    initial_population = generate_initial_population(dim, lb, ub, rng)
    clipped_population = clip_candidate(initial_population[0])
    for i in range(1, budget):
        clipped_candidate = clip_candidate(initial_population[i])
        if evaluate(clipped_candidate) < evaluate(clipped_population):
            clipped_population = clipped_candidate
    best_solution_de = differential_evolution(initial_population, func, (lb, ub), budget)
    clipped_best_solution_de = clip_candidate(best_solution_de)
    clipped_population = np.clip(clipped_population, a_min=clb, a_max=ub)
    clipped_best_solution_de = np.clip(clipped_best_solution_de, a_min=lb, a_max=ub)
    if evaluate(clipped_population) < evaluate(clipped_best_solution_de):
        best_solution = clipped_population
    else:
        best_solution = clipped_best_solution_de

    return best_solution
