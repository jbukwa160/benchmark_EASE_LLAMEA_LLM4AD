def algorithm(func, dim, lb, ub, budget, rng):
    D = len(dim)
    x_best = np.array([lb]*D)
    f_best = 1e6
    T = 1000.
    alpha = 0.99
    
    for _ in range(budget):
        if rng.random() < 0.05: # random search with probability 5%
            x_rand = lb + (ub - lb)*rng.rand(D)
            f_rand = func(x_rand)
            if f_rand < f_best:
                f_best = f_rand
                x_best = x_rand
        
        else: # simulated annealing
            x_current = x_best.copy()
            delta = rng.uniform(-1, 1, D) * (ub - lb)*0.01
            x_new = x_current + delta
            
            # clip to bounds
            for i in range(D):
                if x_new[i] < lb:
                    x_new[i] = lb
                elif x_new[i] > ub:
                    x_new[i] = ub
                
            f_current = func(x_current)
            f_new = func(x_new)
            
            delta_f = f_new - f_current
            
            if delta_f <= 0 or rng.random() < np.exp(-delta_f/T):
                x_best = x_new
                f_best = f_new
                
            T *= alpha
    
    return x_best
