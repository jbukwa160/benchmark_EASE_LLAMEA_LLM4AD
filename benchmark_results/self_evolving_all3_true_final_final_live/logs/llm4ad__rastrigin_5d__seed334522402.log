def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = 1e10
    candidate = rng.uniform(lb, ub, size=dim)

    for _ in range(budget):
        x = candidate.copy()
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x.copy()

        delta = np.zeros(dim)
        for i in range(dim):
            delta[i] = rng.uniform(-1, 1) * (ub - lb) / budget

        candidate += delta
        for i in range(dim):
            if candidate[i] < lb:
                candidate[i] = lb + rng.uniform(0, ub - lb)
            elif candidate[i] > ub:
                candidate[i] = ub - rng.uniform(0, ub - lb)

    return best_x
