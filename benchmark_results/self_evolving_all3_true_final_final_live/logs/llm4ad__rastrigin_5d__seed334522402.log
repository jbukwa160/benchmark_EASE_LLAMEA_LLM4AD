def algorithm(func, dim, lb, ub, budget, rng):
    def sample_sphere(radius, center, bounds):
        return center + radius * (np.random.randn(dim) - 0.5) / np.sqrt(np.sum((np.random.randn(dim) - 0.5)**2))

    best_x = None
    best_f = float('inf')

    for _ in range(budget // dim):
        x = sample_sphere(1, [0] * dim, bounds)
        f = func(x)

        if f < best_f:
            best_f = f
            best_x = x

        radius = 1 / np.sqrt(np.sum((x - best_x)**2))
        new_samples = np.array([sample_sphere(radius, best_x + r * (x - best_x), bounds) for r in rng.uniform(0.5, 1.5, size=dim)])

        for sample in new_samples:
            f = func(sample)
            if f < best_f:
                best_f = f
                best_x = sample

    return np.clip(best_x, lb, ub)
