def algorithm(func, dim, lb, ub, budget, rng):
    def clipped_candidate(candidate):
        return np.clip(candidate, lb, ub)

    bounds = [(lb, ub) for _ in range(dim)]

    def objective(x):
        candidate = np.clip(x, lb, ub)
        return func(candidate), []

    result = differential_evolution(objective, bounds, maxiter=budget, polish=True, strategy='best1exp')
    best_candidate = clipped_candidate(result.x)

    return best_candidate
