def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    pop_size = int(np.sqrt(budget))
    x0 = np.random.uniform(lb, ub, (pop_size, dim))

    best_x = None
    best_y = float('inf')

    for _ in range(pop_size):
        x = clip(x0[_])
        y = func(x)
        if y < best_y:
            best_y = y
            best_x = x

    simplex_size = pop_size // 2 + 1
    simplexes = np.array([best_x] * simplex_size)

    for _ in range(budget - pop_size):
        nms_simplex = NMSimplex(simplexes)
        new_simplex = nms_simplex.optimize(func, dim, lb, ub, rng)
        simplexes = clip(new_simplex)

        x_new = simplexes[-1]
        y_new = func(x_new)
        if y_new < best_y:
            best_y = y_new
            best_x = x_new

    return best_x
