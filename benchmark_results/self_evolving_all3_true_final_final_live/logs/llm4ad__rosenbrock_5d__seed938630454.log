def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    T = 10.0
    cooling_rate = 0.99
    n_iter = int(budget / dim)

    for _ in range(n_iter):
        y = x + rng.normal(size=dim) * 0.1

        # Simulated Annealing part
        delta_f = func(y) - func(x)
        if delta_f < 0:
            x = clip(y, lb, ub)
        else:
            T_new = max(T * cooling_rate, 1e-6)
            prob = np.exp(-delta_f / T_new)
            if rng.uniform() < prob:
                x = clip(y, lb, ub)

    return x
