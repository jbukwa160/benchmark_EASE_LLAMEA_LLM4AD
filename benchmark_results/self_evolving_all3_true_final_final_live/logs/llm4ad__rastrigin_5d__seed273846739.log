def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    def crossover(p1, p2):
        u = rng.rand(dim)
        v = rng.rand()
        if v < 0.5:
            c = p1 + u * (p2 - p1)
        else:
            c = p2 + u * (p1 - p2)
        return clip(c)

    def mutation(x, f_value):
        sigma = 0.01 * (ub - lb) / np.sqrt(f_value + 1e-8)
        g = rng.randn(dim)
        return clip(x + sigma * g)

    x_best = np.random.uniform(lb, ub, dim)
    best_f = func(x_best)

    for i in range(budget):
        pop = np.concatenate([np.expand_dims(x_best, axis=0), 
                             lb + (ub - lb) * rng.rand((budget - 1, dim))])
        f_values = [func(x) for x in pop]

        # Adaptive mutation
        sigma = 0.01 * (ub - lb) / np.sqrt(np.mean(f_values))

        # Hybrid crossover
        children = []
        for j in range(budget):
            if rng.rand() < 0.5:
                c1 = crossover(pop[j], pop[(j + 1) % budget])
                c2 = crossover(c1, x_best)
            else:
                c1 = crossover(pop[j], pop[(j - 1) % budget])
                c2 = crossover(c1, x_best)
            children.append(clip(mutation(c2, f_values[j])))
        children = np.array(children)

        # Differential Evolution
        for j in range(budget):
            g = rng.randn(dim)
            x_new = clip(x_best + sigma * g + (ub - lb) * rng.rand())
            if func(x_new) < best_f:
                x_best = x_new
                best_f = func(x_best)

    return x_best
