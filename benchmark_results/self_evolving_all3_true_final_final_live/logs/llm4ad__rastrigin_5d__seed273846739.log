def algorithm(func, dim, lb, ub, budget, rng):
    def clipped_candidate(candidate):
        return np.clip(candidate, lb, ub)

    current_best = np.zeros(dim)
    current_fitness = func(current_best)

    temperature = 1
    cooling_rate = 0.99

    for _ in range(budget):
        # Differential Evolution step
        noise = rng.uniform(-1, 1, size=(dim,))
        candidate = current_best + noise * 0.5

        # Simulated Annealing acceptance criterion
        if func(clipped_candidate(candidate)) < current_fitness:
            current_best = clipped_candidate(candidate)
            current_fitness = func(current_best)
        elif rng.rand() < np.exp((current_fitness - func(clipped_candidate(candidate))) / temperature):
            current_best = clipped_candidate(candidate)
            current_fitness = func(current_best)

        # Simulated Annealing cooling schedule
        temperature *= cooling_rate

    return current_best
