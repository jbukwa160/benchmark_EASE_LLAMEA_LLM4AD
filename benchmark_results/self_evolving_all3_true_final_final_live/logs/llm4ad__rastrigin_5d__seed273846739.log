def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(n, dim, lb, ub):
        return np.clip(rng.uniform(lb, ub, size=(n, dim)), a_min=lb, a_max=ub)

    def differential_evolution(population, func, dim, cr, f, lb, ub, budget):
        population = np.array(population)
        while len(population) < budget:
            p1, p2, p3 = rng.choice(population, size=3, replace=False)
            mutant = p1 + cr * (p2 - p3)
            mutant = np.clip(mutant, a_min=lb, a_max=ub)
            trial = func(mutant)
            if trial < min(func(population)):
                population.append(mutant.tolist())
        return population

    def simulated_annealing(population, func, dim, lb, ub, budget):
        T = 1000
        alpha = 0.99
        for _ in range(budget):
            i = rng.randint(0, len(population))
            mutant = np.clip(np.array(population[i]) + 1e-4 * (2*rng.rand(dim) - 1), a_min=lb, a_max=ub)
            delta = func(mutant) - func(population[i])
            if delta < 0 or rng.random() < np.exp(-delta / T):
                population[i] = mutant.tolist()
            T *= alpha
        return population

    population = generate_initial_population(100, dim, lb, ub)
    population = differential_evolution(population, func, dim, 0.5, 10, lb, ub, budget // 2)
    best_individual = min(population, key=func)
    population = simulated_annealing(population, func, dim, lb, ub, budget - budget // 2)
    return np.array(min(population, key=func))
