def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    n = int(np.sqrt(budget))
    pop_size = 1000
    candidates = rng.uniform(lb, ub, (pop_size, dim))

    for _ in range(n):
        solutions = np.zeros((pop_size, dim))
        for i in range(pop_size):
            best_idx = i
            if evaluate(candidates[i]) < evaluate(candidates[best_idx]):
                best_idx = i

            # DE-inspired mutation
            delta = rng.uniform(-1, 1, dim)
            solutions[i] = candidates[i] + delta * (candidates[np.random.choice(pop_size, size=2)] - candidates[np.random.choice(pop_size, size=2)])

            # Clip solutions to the bounds
            solutions[i] = np.clip(solutions[i], lb, ub)

        # Local search heuristic
        for i in range(pop_size):
            candidate = candidates[best_idx]
            step_size = 0.01

            while True:
                new_candidate = candidate + rng.uniform(-step_size, step_size, dim)
                new_candidate = np.clip(new_candidate, lb, ub)

                if evaluate(new_candidate) < evaluate(candidate):
                    candidate = new_candidate
                else:
                    break

            solutions[i] = candidate

        candidates = solutions.copy()

    best_solution_idx = np.argmax([evaluate(solution) for solution in candidates])
    return candidates[best_solution_idx]
