def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_fval = float('inf')

    for _ in range(budget):
        x = np.random.uniform(lb, ub, size=dim)
        fval = func(x)

        if fval < best_fval:
            best_x = x
            best_fval = fval

        # grid search steps
        dx = (ub - lb) / 10
        for i in range(dim):
            for j in np.arange(lb + dx, ub, dx):
                candidate = x.copy()
                candidate[i] = j
                candidate_fval = func(candidate)

                if rng.uniform(0, 1) < 0.01:  # exploration probability
                    if candidate_fval < best_fval:
                        best_x = candidate
                        best_fval = candidate_fval

    return np.clip(best_x, lb, ub)
