def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    x_best = rng.uniform(lb, ub, size=(dim,))
    cov = 0.1 * np.eye(dim)
    for _ in range(budget):
        x_candidate = x_best + np.random.multivariate_normal(np.zeros(dim), cov)
        x_candidate = clip(x_candidate)
        f_candidate = func(x_candidate)
        f_best = func(x_best)
        
        if f_candidate < f_best:
            x_best = x_candidate
            cov += 0.1 * (x_candidate - x_best) * (x_candidate - x_best).T

    return x_best
