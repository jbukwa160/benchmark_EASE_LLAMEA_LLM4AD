def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    y_best = func(x_best)

    for t in range(budget):
        x_new = x_best + 0.1 * (ub - lb) * rng.randn(dim)

        # Clip to bounds
        x_new = np.clip(x_new, lb, ub)

        y_new = func(x_new)
        
        if y_new < y_best:
            x_best = x_new
            y_best = y_new

    return x_best
