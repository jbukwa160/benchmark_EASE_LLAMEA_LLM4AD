def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    N = 50  # population size
    F = 0.8  # DE amplification factor
    CR = 0.9  # DE crossover probability
    T_max = 1000  # maximum temperature for SA

    x = np.random.uniform(lb, ub, (N, dim))
    best_x = np.copy(x[0])
    temp = 1.0

    for t in range(budget):
        # Evaluate population and update best candidate
        f_x = evaluate(x)
        idx_best = np.argmin(f_x)
        if f_x[idx_best] < evaluate(best_x):
            best_x = x[idx_best]
        
        # Differential Evolution step
        for i in range(N):
            r1, r2, r3 = rng.choice(N, 3, replace=False)
            u = x[r1] + F * (x[r2] - x[r3])
            if rng.random() < CR or np.all(x[i] == u):
                x[i] = u
        
        # Simulated Annealing temperature control
        temp *= 0.9999
        if temp > 1e-6:
            for i in range(N):
                if rng.random() < np.exp((evaluate(best_x) - evaluate(x[i])) / temp):
                    x[i] = best_x

        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
    
    return best_x
