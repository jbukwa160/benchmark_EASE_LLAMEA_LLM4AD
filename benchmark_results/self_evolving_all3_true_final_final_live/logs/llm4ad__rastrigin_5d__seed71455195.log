def algorithm(func, dim, lb, ub, budget, rng):
    D = rng.uniform(lb, ub, size=dim)
    T0 = 1000.0
    alpha = 0.99
    beta = 5e-2
    t = 1.0
    best_solution = D.copy()
    best_fitness = func(D)

    for _ in range(budget):
        x_new = best_solution + rng.uniform(-1, 1, size=dim)
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)
        
        if f_new < best_fitness:
            best_solution = x_new
            best_fitness = f_new

        delta_f = f_new - best_fitness
        if delta_f <= 0 or rng.rand() < np.exp(-delta_f / (T0 * t)):
            best_solution = x_new
            best_fitness = f_new
        
        T0 *= alpha
        t *= beta

    return best_solution
