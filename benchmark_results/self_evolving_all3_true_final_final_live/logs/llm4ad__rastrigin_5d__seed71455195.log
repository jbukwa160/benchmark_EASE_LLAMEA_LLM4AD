def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, (1, dim))
    for i in range(budget - 1):
        candidates = np.vstack([x, clip(x + rng * (np.random.rand(1, dim) - 0.5)), 
                                clip(x - rng * (np.random.rand(1, dim) - 0.5))])
        fitness = func(candidates)
        idx = np.argsort(fitness)[0]
        x = candidates[idx]

    return x
