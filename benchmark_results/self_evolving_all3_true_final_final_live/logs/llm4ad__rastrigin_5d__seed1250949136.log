def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 20
    max_iter = int(budget / (dim * pop_size))
    F = 1.0
    CR = 0.9
    x = rng.uniform(lb, ub, size=(pop_size, dim))

    for i in range(max_iter):
        for j in range(pop_size):
            v = np.zeros(dim)
            r1, r2, r3 = rng.choice(range(pop_size), replace=False, size=3)

            for k in range(dim):
                u = x[r1[k]] + F * (x[r2[k]] - x[r3[k]])
                v[k] = (1 - CR) * x[j][k] + CR * u

            v = np.clip(v, lb, ub)
            f_v = func(v)

            if f_v < func(x[j]):
                x[j] = v
        x = np.clip(x, lb, ub)

    return np.min(np.array([func(xj) for xj in x]), axis=0)
