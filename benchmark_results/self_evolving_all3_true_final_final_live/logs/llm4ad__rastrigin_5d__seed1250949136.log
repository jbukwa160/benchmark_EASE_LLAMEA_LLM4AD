def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_candidate(population):
        indices = rng.choice(dim, 3, replace=False)
        z = population[indices]
        x = [z[i] + rng.uniform(-1, 1) for i in range(3)]
        x = clip(np.array(x))
        return np.array(x)

    def evaluate(candidate):
        candidate = clip(candidate)
        return func(candidate)

    def differential_evolution(population, budget):
        for _ in range(budget):
            new_population = []
            for i in range(len(population)):
                parent1 = rng.choice(len(population), p=[0.5 if j == i else 1 / (len(population) - 1) for j in range(len(population))])
                parent2 = rng.choice(len(population), p=[0.5 if j == i else 1 / (len(population) - 1) for j in range(len(population))])
                child = generate_candidate(population)
                child = population[parent1] + rng.uniform(-1, 1) * (population[parent2] - population[parent1]) + child
                new_population.append(child)
            population = new_population

    def simulated_annealing(population, budget):
        T = 1000.0
        for _ in range(budget):
            best = max(population, key=evaluate)
            new_best = generate_candidate(population)
            if evaluate(new_best) < evaluate(best):
                population.remove(best)
                population.append(new_best)
            else:
                delta = evaluate(best) - evaluate(new_best)
                if delta > 0 and rng.random() * T > delta:
                    population.remove(best)
                    population.append(new_best)
            T *= 0.99

    population = [[rng.uniform(lb, ub) for _ in range(dim)] for _ in range(50)]
    differential_evolution(population, budget // 2)
    simulated_annealing(population, budget // 2)

    return max(population, key=evaluate)
