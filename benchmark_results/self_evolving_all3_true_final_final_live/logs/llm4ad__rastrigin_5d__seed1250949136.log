def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def generate_candidates(population, rng):
        new_population = []
        for _ in range(len(population)):
            parent1, parent2, parent3 = rng.choice(population, 3, replace=False)
            child = parent1 + 0.5 * (parent2 - parent3) + np.random.uniform(-1, 1, dim) / 10
            new_population.append(clip(child, lb, ub))
        return np.array(new_population)

    population = rng.uniform(lb, ub, size=(budget, dim))
    best = np.inf

    for i in range(budget):
        candidates = generate_candidates(population, rng)
        scores = [func(candidate) for candidate in candidates]
        population[np.argmin(scores)] = clip(np.array([candidates[np.argmin(scores)]]), lb, ub)

        if scores[0] < best:
            best = scores[0]

    return np.array([population[np.argmin(scores)]])
