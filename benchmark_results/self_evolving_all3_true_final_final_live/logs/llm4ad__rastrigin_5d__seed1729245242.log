def algorithm(func, dim, lb, ub, budget, rng):
    def clipped_candidate(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def fitness(x):
        return func(x)

    pop_size = 50
    bounds = [(lb, ub) for _ in range(dim)]
    x0 = rng.uniform(lb, ub, size=(pop_size, dim))
    pop = [clipped_candidate(x, lb, ub) for x in x0]
    pop_fitness = [fitness(x) for x in pop]

    best_x = np.array([lb] * dim)
    best_fitness = float('inf')

    for i in range(budget):
        for _ in range(pop_size):
            candidate = rng.uniform(lb, ub, size=dim)
            candidate = clipped_candidate(candidate, lb, ub)
            new_pop = [x + 0.1 * (candidate - x) for x in pop]
            new_pop_fitness = [fitness(x) for x in new_pop]

            max_idx = np.argmax(new_pop_fitness)
            if new_pop_fitness[max_idx] < pop_fitness[max_idx]:
                pop[max_idx] = new_pop[max_idx]
                pop_fitness[max_idx] = new_pop_fitness[max_idx]

        max_idx = np.argmax(pop_fitness)
        if pop_fitness[max_idx] < best_fitness:
            best_x = pop[max_idx]
            best_fitness = pop_fitness[max_idx]

    return best_x
