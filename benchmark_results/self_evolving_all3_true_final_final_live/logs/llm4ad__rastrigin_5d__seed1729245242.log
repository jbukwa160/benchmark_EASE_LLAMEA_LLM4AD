def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    F = 0.5
    CR = 0.9
    
    x = rng.uniform(lb, ub, (pop_size, dim))
    
    for _ in range(budget):
        g_best = np.inf
        g_x = None
        
        for i in range(pop_size):
            v1, v2, v3 = rng.choice(pop_size, 3, replace=False)
            y = x[v1] + F * (x[v2] - x[v3])
            
            if rng.random() < CR or np.all(x[i] == y):
                y += rng.uniform(-1, 1, dim) * 0.01
                
            y = np.clip(y, lb, ub)
            y_func = func(y)
            
            if y_func < g_best:
                g_best = y_func
                g_x = y
        
        x = np.clip(g_x + rng.uniform(lb, ub, (pop_size, dim)) * 0.1, lb, ub)
        
    return g_x
