def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 10 * dim + 5
    xbest = np.random.uniform(lb, ub, (pop_size, dim))
    pbest = func(xbest)
    
    for i in range(budget):
        if np.random.rand() < 0.1:
            strategy = 'rand/1/bin'
        else:
            strategy = 'best/2/bin'
        
        trial_pop = np.zeros((pop_size, dim))
        for j in range(pop_size):
            mutant = xbest[j] + rng.uniform(-1, 1) * (xbest[np.random.choice(pop_size, size=5)] - xbest)
            trial_pop[j] = mutant
            
            if strategy == 'rand/1/bin':
                trial_pop[j] = trial_pop[j] + rng.uniform(-1, 1) * (trial_pop[np.random.choice(pop_size-1, size=10)] - trial_pop)
            elif strategy == 'best/2/bin':
                trial_pop[j] = trial_pop[j] + rng.uniform(-1, 1) * (xbest[np.argsort(pbest)[0:2]] - xbest)
        
        trial_best = func(trial_pop)
        for j in range(pop_size):
            if trial_best[j] < pbest[j]:
                xbest[j] = trial_pop[j]
                pbest[j] = trial_best[j]
    
    return xbest[np.argmin(pbest)]
