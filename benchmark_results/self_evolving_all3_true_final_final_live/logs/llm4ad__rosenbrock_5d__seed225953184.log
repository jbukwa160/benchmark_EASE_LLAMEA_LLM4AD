def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    x_best = lb + (ub - lb) * rng.rand(n)
    t = 1.0
    best_cost = func(x_best)

    for _ in range(budget):
        v = np.clip(x_best + (ub - lb) * rng.randn(n), lb, ub)
        cost = func(v)

        if cost < best_cost:
            x_best = v
            best_cost = cost

        delta = cost - best_cost
        if delta < 0 or rng.rand() < np.exp(-delta / t):
            t *= 0.99

    return x_best
