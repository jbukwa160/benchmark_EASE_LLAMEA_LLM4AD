def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.array([ub + rng.rand() * (lb - ub) for _ in range(dim)])
    y_best = func(x_best)

    gp_model = GaussianProcessRegressor(kernel=1.0 * norm.pdf(0, 0, 1))
    gp_model.fit(np.array([x_best]), np.array([y_best]))

    budget_counter = 0
    while budget_counter < budget:
        x_candidate = gp_model.sample_f(x_best.shape)
        y_candidate = func(x_candidate)

        if y_candidate < y_best:
            x_best = x_candidate
            y_best = y_candidate

            gp_model.fit(np.array([x_best]), np.array([y_best]))
        else:
            gp_model.fit(np.array([[x_best, x_candidate]]), np.array([[y_best, y_candidate]]))

        # Clip candidates to [lb, ub]
        for i in range(dim):
            x_best[i] = max(lb, min(ub, x_best[i]))

        budget_counter += 1

    return x_best
