    v = np.zeros(dim)
    lr = 1.0
    beta = 0.9
    
    for _ in range(budget):
        g = np.zeros(dim)
        for i in range(dim-1):
            g[i] += 200*(x[i+1]-x[i]**2)*(2*x[i+1]-2*x[i]**3) - 2*(1-x[i])
        
        v = beta*v + (1-beta)*g
        x = x - lr * np.clip(v, -10, 10)
        x = np.clip(x, lb, ub)
        lr *= 0.99999
        
