def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(x):
        x = np.clip(x, lb, ub)
        return func(x)

    population_size = 50
    pop = rng.uniform(lb, ub, (population_size, dim))
    fit = [get_candidate(x) for x in pop]
    g_best = np.argmin(fit)
    best_x = pop[g_best]

    for t in range(budget):
        new_pop = []
        for i in range(population_size):
            x = pop[i] + 0.5 * (pop[np.random.choice(range(population_size), p=rng.uniform(0, 1)) - pop[np.random.choice(range(population_size), p=rng.uniform(0, 1))]] + rng.normal(size=dim) / np.sqrt(t+1))
            x = get_candidate(x)
            new_pop.append(x)
        fit_new = [get_candidate(x) for x in new_pop]
        g_best_new = np.argmin(fit_new)
        if fit_new[g_best_new] < fit[g_best]:
            best_x = new_pop[g_best_new]
            g_best = g_best_new
        pop = new_pop

    return best_x
