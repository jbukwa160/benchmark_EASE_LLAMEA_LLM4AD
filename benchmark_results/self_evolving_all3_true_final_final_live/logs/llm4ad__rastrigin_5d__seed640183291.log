def algorithm(func, dim, lb, ub, budget, rng):
    n = 10 * dim
    N = 50
    mu = 0.5
    sigma = 1.0
    best_x = np.random.uniform(lb, ub, size=(dim,))
    best_y = func(best_x)

    for i in range(budget):
        X = np.zeros((N, dim))
        Y = np.zeros(N)
        
        for j in range(N):
            x = best_x + (ub - lb) * rng.normal(size=(dim,))
            x = np.clip(x, lb, ub)
            
            v1 = mu * (best_x - x) / (np.linalg.norm(best_x - x) + 1e-6)
            v2 = np.zeros((dim,))
            for k in range(dim):
                if rng.rand() < 0.5:
                    v2[k] = sigma * rng.normal()
                else:
                    v2[k] = mu * (v1[k] - best_x[k])
            
            X[j] = x + v1 + v2
            
        Y[:] = func(X)
        
        best_idx = np.argmin(Y)
        if Y[best_idx] < best_y:
            best_y = Y[best_idx]
            best_x = X[best_idx]

    return best_x
