def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = f(x)

    for i in range(budget):
        # DE step
        r1, r2, r3 = rng.random(size=(3, dim))
        x_new = x + 0.5 * (r1 - r2) * (best_x - lb)
        x_new = np.clip(x_new, lb, ub)

        # SA step
        alpha = 0.99  # cooling rate
        beta = 0.01   # probability of accepting worse solution

        f_new = f(x_new)
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new
        else:
            u = rng.uniform(0, 1)
            if u < beta * np.exp((best_f - f_new) / (alpha ** i)):
                best_x = x_new.copy()
                best_f = f_new

    return best_x
