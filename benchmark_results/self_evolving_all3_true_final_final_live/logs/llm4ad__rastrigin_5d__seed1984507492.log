def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(individual):
        x = clip(individual)
        return func(x), x

    def differential_evolution(population_size, mutation_strategy, crossover_rate, bounds):
        population = rng.uniform(lb, ub, (population_size, dim))
        for _ in range(budget // 2):
            mutated_population = np.copy(population)
            for i in range(population_size):
                r1, r2, r3 = rng.choice(population_size, 3, replace=False)
                if mutation_strategy == 'rand/1/bin':
                    mutated_individual = population[r1] + crossover_rate * (population[r2] - population[r3])
                elif mutation_strategy == 'best/1/bin':
                    best_individual = np.argmin([evaluate(individual)[0] for individual in population])
                    mutated_individual = population[best_individual] + crossover_rate * (population[r1] - population[r2])
                else:
                    raise ValueError('Invalid mutation strategy')
                mutated_individual = clip(mutated_individual)
                mutated_population[i] = mutated_individual
            population = mutated_population
        return np.array([individual for _, individual in sorted(zip([evaluate(individual)[0] for individual in population], population), key=lambda x: x[0])])

    def simulated_annealing(initial_temperature, cooling_rate):
        current_solution = rng.uniform(lb, ub, dim)
        temperature = initial_temperature
        for _ in range(budget // 4):
            new_solution = np.copy(current_solution) + rng.normal(size=dim, loc=0, scale=ub - lb)
            new_solution = clip(new_solution)
            delta = evaluate(new_solution)[0] - evaluate(current_solution)[0]
            if delta < 0:
                current_solution = new_solution
            elif rng.rand() < np.exp(-delta / temperature):
                current_solution = new_solution
            temperature *= cooling_rate
        return current_solution

    population = differential_evolution(100, 'rand/1/bin', 0.5, (lb, ub))
    best_individual = simulated_annealing(10., 0.9)
    return evaluate(best_individual)[1]
