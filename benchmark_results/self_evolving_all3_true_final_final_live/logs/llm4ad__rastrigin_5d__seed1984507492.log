def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = 5  # dimensionality of the problem
    N = 50  # population size
    F = 0.7  # differential evolution scaling factor
    CR = 0.9  # crossover probability
    MR = 20.0  # polynomial mutation distribution index
    etaMR = 20.0  # polynomial mutation distribution exponent

    x_best = np.random.uniform(lb, ub, size=(1, D))
    f_best = func(x_best)

    for i in range(budget):
        population = rng.uniform(lb, ub, size=(N, D))

        for j in range(N):
            u, v, w = rng.choice(N, size=3, replace=False)
            x_new = clip(population[j] + F * (population[u] - population[v]) + CR * (population[w] - population[j]))

            if func(x_new) < f_best:
                x_best = x_new
                f_best = func(x_new)

        for j in range(N):
            u = rng.randint(0, N)
            x_new = clip(population[u] + MR * np.power(np.random.uniform(0, 1, size=D), etaMR) *
                                 (population[j] - x_best))
            if func(x_new) < f_best:
                population[j] = x_new

        if rng.rand() > 0.95:
            sigma = 0.01
            for j in range(N):
                x_new = clip(population[j] + np.random.normal(0, sigma, size=D))
                if func(x_new) < f_best:
                    population[j] = x_new

    return x_best
