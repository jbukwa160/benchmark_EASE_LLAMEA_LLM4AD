def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    def clip(x):
        return np.clip(x, lb, ub)

    n = 1e-3 * (ub - lb) ** 2 / dim
    mu = 0.5
    sigma = np.sqrt(n)
    lambda_ = int(np.ceil(4 + 3 * np.log(dim)))
    w_c = 1 / lambda_
    c_c = 2.05
    kappa = 1 / (dim + 1.25)

    x = rng.uniform(lb, ub, size=dim)
    y = f(x)
    archive = [x]
    count = 0

    while count < budget:
        v = np.zeros(dim)
        for i in range(lambda_):
            z = np.random.randn(dim)
            v += z / np.sqrt(np.sum(z**2))
        v = clip(v * sigma + x)

        y_new = f(v)
        if y_new < y:
            x, y = v, y_new
            archive.append(x)
            count = 0

        elif rng.uniform(0, 1) > 0.5:
            for i in range(lambda_):
                z = np.random.randn(dim)
                v += w_c * (z - kappa * v / np.linalg.norm(v)) * sigma
                v = clip(v)

            y_new = f(v)
            if y_new < y:
                x, y = v, y_new
                archive.append(x)
                count = 0

        else:
            c = np.random.randn(dim)
            s2 = np.sum(c**2)
            v += (1 + c_c / lambda_ * s2) * sigma * c / np.sqrt(s2)
            v = clip(v)

            y_new = f(v)
            if y_new < y:
                x, y = v, y_new
                archive.append(x)
                count = 0

        n = (1 - 1 / (count + 3)) ** 2 * n
        sigma *= np.exp(np.sqrt((y - f(archive[count])) / (n * lambda_)))
        mu += (v - x) / sigma ** 2

        count += 1

    return np.array(x)
