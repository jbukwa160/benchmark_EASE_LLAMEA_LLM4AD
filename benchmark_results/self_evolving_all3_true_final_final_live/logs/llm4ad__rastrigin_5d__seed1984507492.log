def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def generate_initial_population(dim, lb, ub, rng):
        population = rng.uniform(lb, ub, size=(budget, dim))
        return population

    def differential_evolution(population, func, dim, budget, rng):
        f_values = np.zeros(budget)
        for i in range(1, budget):
            # Select parents
            parents_idx = rng.choice(budget, size=3, replace=False)
            parent_a, parent_b, parent_c = population[parents_idx]
            
            # Differential evolution
            trial = clip(parent_a + rng.uniform(-1, 1) * (parent_b - parent_c))
            
            # Cosine mutation
            if rng.random() < 0.2:
                for j in range(dim):
                    trial[j] += rng.uniform(-0.5, 0.5) * np.cos(20 * np.pi * rng.uniform(0, 1))
            
            # Update population and f_values
            f_trial = func(trial)
            if f_trial < func(parent_a):
                population[i] = trial
                f_values[i] = f_trial
        return population[1:], f_values[1:]

    def adaptive_learning_rate(f_values):
        learning_rate = np.mean(np.diff(f_values))
        return learning_rate

    # Initialize the population and compute initial fitness values
    population = generate_initial_population(dim, lb, ub, rng)
    f_values = func(population)

    for _ in range(1, budget):
        population[1:], f_values[1:] = differential_evolution(population, func, dim, budget, rng)

    # Return the best solution found
    best_idx = np.argmin(f_values)
    return clip(population[best_idx])
