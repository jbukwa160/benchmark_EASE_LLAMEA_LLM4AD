def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(x):
        return np.clip(np.random.uniform(lb, ub, size=dim), a_min=lb, a_max=ub)

    def calculate_fitness(x):
        return func(x)

    x_best = None
    f_best = float('inf')
    T = 10.0

    for _ in range(budget):
        x_current = get_candidate(np.zeros(dim))
        f_current = calculate_fitness(x_current)

        if f_current < f_best:
            f_best = f_current
            x_best = np.copy(x_current)

        # SA
        beta = 1 / (T + 1)
        for i in range(dim):
            d_x_i = np.random.uniform(-0.5, 0.5)
            x_new = get_candidate(np.copy(x_current) + d_x_i * rng.randn())
            f_new = calculate_fitness(x_new)

            if f_new < f_best:
                T *= beta
                x_current = x_new
                f_current = f_new

        # DE
        for _ in range(dim):
            i1, i2, i3 = np.random.choice(range(dim), replace=False, size=3)
            d_x_i = 0.5 * rng.randn()
            x_new = get_candidate(np.copy(x_current) + d_x_i * (x_current[i1] - x_current[i2]) + d_x_i * (x_current[i2] - x_current[i3]))
            f_new = calculate_fitness(x_new)

            if f_new < f_best:
                x_current = x_new
                f_current = f_new

    return x_best
