def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.uniform(size=dim) + lb
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        if rng.random() < 0.1:
            # Random search
            x = (ub - lb) * rng.uniform(size=dim) + lb
        else:
            # Greedy descent
            dir_ = np.zeros(dim)
            for j in range(dim):
                if rng.random() < 0.5:
                    dir_[j] = -np.sign(x[j])
                elif rng.random() < 0.9:
                    dir_[j] += (ub - lb) * rng.uniform(-1, 1)

            x += 0.01 * dir_
            for j in range(dim):
                if x[j] > ub or x[j] < lb:
                    x[j] = np.clip(x[j], lb, ub)
        f = func(np.clip(x, lb, ub))
        
        if f < best_f:
            best_x = x.copy()
            best_f = f

    return best_x
