def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    if dim == 1:
        return np.array([ub])
        
    for _ in range(budget):
        x = np.clip(rng.uniform(size=dim) * (ub - lb) + lb, a_min=lb, a_max=ub)
        f = func(x)
        
        if f < best_f:
            best_x = x
            best_f = f
            
    return best_x
