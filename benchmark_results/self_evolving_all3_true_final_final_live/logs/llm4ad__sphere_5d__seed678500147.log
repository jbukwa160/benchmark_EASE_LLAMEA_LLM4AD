def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(clip(x))

    x = np.random.uniform(lb, ub, size=dim)
    t = 1.0
    best_x = x.copy()
    best_f = evaluate(best_x)
    for _ in range(budget):
        sigma = (ub - lb) / np.sqrt(t)
        delta = rng.normal(size=dim, loc=0.0, scale=sigma)
        new_x = clip(x + delta)
        alpha = 1 - np.exp(-t * rng.uniform(0.0, 1.0))
        new_f = evaluate(new_x)
        if new_f < best_f:
            x = new_x
            best_x = new_x.copy()
            best_f = new_f
        elif rng.rand() < alpha:
            beta = rng.normal(loc=1, scale=sigma / np.linalg.norm(delta))
            x = clip(x + (new_x - x) * beta)
        t *= 0.9999
    return best_x
