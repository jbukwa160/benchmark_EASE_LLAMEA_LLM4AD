def algorithm(func, dim, lb, ub, budget, rng):
    pop = np.random.uniform(lb, ub, size=(budget, dim))
    best = pop[rng.randint(0, budget)]
    
    for _ in range(budget - 1):
        candidates = []
        
        for i in range(budget):
            x = pop[i]
            
            if rng.random() < 0.5:
                mutation = np.random.normal(loc=0, scale=np.max(pop) / (i + 2), size=dim)
            else:
                mutation = np.random.uniform(-1, 1, size=dim)
                
            candidate = x + mutation
            
            for j in range(dim):
                if rng.random() < 0.5 and candidate[j] > ub:
                    candidate[j] = ub
                elif rng.random() < 0.5 and candidate[j] < lb:
                    candidate[j] = lb
                    
            candidates.append(candidate)
            
        pop[rng.randint(0, budget)] = np.min(candidates, axis=0)
        
        if func(pop[np.argmin([func(p) for p in pop])]) < func(best):
            best = pop[np.argmin([func(p) for p in pop])]
    
    return best
