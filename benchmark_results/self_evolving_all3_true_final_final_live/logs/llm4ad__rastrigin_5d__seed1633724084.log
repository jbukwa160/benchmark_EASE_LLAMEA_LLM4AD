def algorithm(func, dim, lb, ub, budget, rng):
    n = 1 + int(np.floor(np.log(budget/5)))
    D = [0] * n
    for i in range(n-1):
        D[i] = rng.rand(dim)
    
    best = np.zeros(dim) - 100
    best_f = float('inf')
    
    for t in range(1, budget+1):
        x = lb + (ub-lb)*rng.uniform(size=dim)
        x_old = D[n-1]
        D[n-1] = x
        
        f = func(D[-1])
        
        if f < best_f:
            best_f = f
            best = np.copy(x)
        
        for i in range(n-2, -1, -1):
            v = lb + (ub-lb)*rng.uniform(size=dim)
            v[0] += D[i+1][0]
            f_v = func(v)
            
            if rng.rand() < 0.5:
                if f_v <= best_f or t > budget/2:
                    D[i] = np.copy(v)
                else:
                    alpha = rng.uniform(0, 1)
                    D[i] = alpha * v + (1-alpha) * x_old
            else:
                D[i] = np.copy(x_old)
        
        if t % 100 == 0 or t == budget:
            print(f'Iteration: {t}, Best f: {best_f}')
    
    return best
