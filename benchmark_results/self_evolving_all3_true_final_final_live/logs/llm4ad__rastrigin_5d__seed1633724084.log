def algorithm(func, dim, lb, ub, budget, rng):
    n = len(dim)
    D = 0.9
    F = 1.5
    CR = 0.8
    T = 10000
    initial_temp = 10.0
    cooling_rate = 0.99

    best_x = np.random.uniform(lb, ub, n)
    best_f = func(best_x)

    for i in range(budget):
        x = np.copy(best_x)
        idx = np.random.choice(n, size=n, replace=False)
        u1 = x + D * (best_x - x) / np.linalg.norm(best_x - x)
        u2 = rng.uniform(lb, ub, n)
        u3 = rng.uniform(0, 1, n)

        for j in range(n):
            if rng.random() < CR or u3[j] < 0.5:
                x[idx[j]] = u1[idx[j]]
            elif rng.random() < 0.1:
                x[idx[j]] = u2[idx[j]]

        x = np.clip(x, lb, ub)
        f = func(x)

        if f < best_f:
            best_x = np.copy(x)
            best_f = f

        temp = max(initial_temp * cooling_rate ** (i / T), 1e-6)

        if rng.random() < np.exp((best_f - f) / temp):
            best_x = x
            best_f = f

    return best_x
