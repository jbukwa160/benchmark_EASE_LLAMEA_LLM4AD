def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    D = len(dim)
    n_pop = 50
    n_gen = int(budget / (D * n_pop))
    X_best = np.random.uniform(lb, ub, size=(n_pop, D))

    for _ in range(n_gen):
        F = 0.5
        Cr = 1

        V = np.zeros((n_pop, D))
        U = np.zeros((n_pop, D))

        for i in range(D):
            V[:, i] = X_best[:, i] + rng.uniform(-1, 1, size=n_pop)
            U[:, i] = X_best[rng.randint(0, n_pop-1), i] + rng.uniform(-1, 1, size=n_pop)

        for i in range(n_pop):
            r1 = rng.randint(0, n_pop-1)
            r2 = rng.randint(0, n_pop-1)
            if rng.rand() < Cr:
                U[i, :] = clip(V[r1, :] + F * (U[i, :] - X_best[r1, :]))
            else:
                U[i, :] = X_best[r1, :]
        for i in range(n_pop):
            X_best[i, :] = clip(0.5 * (X_best[i, :] + U[i, :]))

    return np.clip(X_best[np.argmin([func(x) for x in X_best])], lb, ub)
