def algorithm(func, dim, lb, ub, budget, rng):
    def sample_gaussian(mu, cov, n_dim):
        return mu + np.random.multivariate_normal(np.zeros(n_dim), cov)

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x, lb, ub)
        return func(x)

    mu = rng.uniform(lb, ub, dim)
    sigma = 0.5 * (ub - lb) / 2
    cov = np.eye(dim) * sigma ** 2

    best_x = mu.copy()
    best_f = evaluate(best_x)

    for _ in range(budget):
        x = sample_gaussian(mu, cov, dim)
        f = evaluate(x)

        if f < best_f:
            best_f = f
            best_x = x

        # update the covariance matrix
        delta = (x - mu) / sigma
        delta *= delta
        cov += np.outer(delta, delta)
        cov /= len(mu) + 1

        # update the mean vector
        mu = (len(mu) * mu + x) / (len(mu) + 1)

    return best_x
