def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def crossover(parent1, parent2):
        child = np.zeros_like(parent1)
        for i in range(dim):
            if rng.random() < 0.5:
                child[i] = parent1[i]
            else:
                child[i] = parent2[i]
        return child

    x_best = lb + (ub - lb) * rng.uniform(size=dim)
    f_best = func(x_best)

    T_max = ub - lb
    T_min = 0.01 * T_max
    alpha = 0.99
    gamma = 1e-6

    for _ in range(budget):
        x_new = clip(crossover(clip(x_best + rng.uniform(size=dim), lb, ub),
                              clip(x_best - rng.uniform(size=dim), lb, ub)),
                     lb, ub)

        f_new = func(x_new)
        delta_f = f_new - f_best

        if delta_f < 0:
            x_best = x_new
            f_best = f_new
        else:
            T = max(T_min, T_max * np.exp(-_ / (budget + gamma)))
            prob_accept = np.exp(-delta_f / T)
            if rng.random() < prob_accept:
                x_best = x_new

        # adaptive cooling schedule
        T = alpha * T + 0.01

    return x_best
