def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)
    avg_improvement = 0
    eps = 1.0

    for _ in range(budget):
        if rng.rand() < eps:
            new_x = np.random.uniform(lb, ub, size=(dim,))
        else:
            new_x = x + rng.normal(size=(dim,))

        new_f = func(new_x)

        if new_f < best_f:
            best_f = new_f
            best_x = new_x.copy()
            avg_improvement += 1

        eps *= np.exp(-avg_improvement / budget)

    return np.clip(best_x, lb, ub)
