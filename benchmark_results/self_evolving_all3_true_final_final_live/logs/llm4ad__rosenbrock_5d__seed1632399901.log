def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x), x

    def mutate(x, sigma):
        return x + rng.randn(dim) * sigma

    def constraint_penalty(x):
        penalty = 0
        for i in range(dim - 1):
            if (x[i+1] - x[i]**2)**2 > 10:
                penalty += 10000
            if (1 - x[i])**2 > 100:
                penalty += 10000
        return penalty

    def polynomial_mutation(x, sigma, indpb):
        mutated = np.copy(x)
        for i in range(dim):
            if rng.rand() < indpb:
                mutated[i] += rng.uniform(-sigma, sigma)
        return clip(mutated)

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = evaluate(x_best)[0]
    pop_size = min(100, budget // 5)
    for i in range(budget):
        if i % 25 == 0:
            sigma = np.exp(rng.uniform(-3, -1))
            x_cand = polynomial_mutation(x_best, sigma * np.sqrt(np.mean((x_best - lb)**2)), 1.0 / dim)
            f_cand, _ = evaluate(x_cand)
        else:
            x_cands = []
            for _ in range(pop_size):
                x_cand = mutate(x_best, np.exp(rng.uniform(-3, -1)))
                if constraint_penalty(x_cand) < 10000 and rng.rand() < (budget - i) / budget:
                    x_cands.append(x_cand)
            f_cands, x_cands = zip(*map(evaluate, x_cands))
            sigma = np.sqrt(np.mean((x_best - lb)**2)) * np.exp(rng.uniform(-3, -1))
        if np.any(np.array(f_cands) < f_best):
            x_best, f_best = x_cands[np.argmin(f_cands)], min(f_cands)
    return x_best
