def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # gradient computation using finite differences
        eps = 1e-6 * (ub - lb)
        grad = np.zeros(dim)
        for i in range(dim):
            e = np.zeros(dim)
            e[i] = eps
            grad[i] = (func(x + e) - func(x - e)) / (2.0 * eps)

        # gradient descent update
        step_size = 1e-3
        x = x - step_size * grad

        # clip to bounds and evaluate function value
        x = np.clip(x, lb, ub)
        f = func(x)

        # update best solution
        if f < best_f:
            best_x = x.copy()
            best_f = f

    return best_x
