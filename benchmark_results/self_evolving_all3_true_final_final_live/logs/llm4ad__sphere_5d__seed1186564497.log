def algorithm(func, dim, lb, ub, budget, rng):
    best = None
    min_val = float('inf')
    
    for _ in range(budget):
        x = (ub - lb) * rng.rand(dim) + lb
        
        if func(x) < min_val:
            min_val = func(x)
            best = x
            
        if np.all(best == 0):
            break
    
    return best
