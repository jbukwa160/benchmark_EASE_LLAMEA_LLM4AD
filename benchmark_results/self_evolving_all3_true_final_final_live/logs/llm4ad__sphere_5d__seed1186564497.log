def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    best_score = float('inf')
    
    for _ in range(budget):
        # Randomly select a dimension to optimize
        i = rng.randint(0, dim)
        
        # Use binary search to find the optimal value within this dimension
        lo = lb[i]
        hi = ub[i]
        while lo < hi:
            mid = (lo + hi) / 2.0
            score = func(np.copy(best))
            score_i = mid * np.copy(best)[i] ** 2
            
            # Clip candidate to [lb, ub]
            candidate = np.copy(best)
            candidate[i] = mid
            
            if score_i < score:
                lo = mid + 1e-6
            else:
                hi = mid - 1e-6
        
        best = candidate
        best_score = func(best)
    
    return best
