def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget - 1):
        x_new = rng.uniform(lb, ub, (1, dim))
        
        if func(x_new) < best_f:
            best_f = func(x_new)
            best_x = x_new.copy()

        # Local refinement
        if func(x_new) > best_f * 0.9 and np.linalg.norm(x_new - best_x) < 0.5:
            step_size = 0.1 / (budget - _)
            for i in range(dim):
                new_x_i = best_x[0, i] + rng.uniform(-step_size, step_size, (1,))
                x_new[i] = np.clip(new_x_i, lb, ub)
                if func(x_new) < best_f:
                    best_f = func(x_new)
                    best_x = x_new.copy()
    
    return best_x
