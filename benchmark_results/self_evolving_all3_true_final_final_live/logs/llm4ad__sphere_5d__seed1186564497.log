def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = clip(x.copy())
    best_f = func(best_x)

    T = 1.0
    cooling_rate = 0.99

    for i in range(budget):
        x_new = x + np.random.normal(size=dim)
        x_new = clip(x_new)
        f_new = func(x_new)

        if f_new < best_f:
            x = x_new.copy()
            best_x = x
            best_f = f_new

        else:
            delta = f_new - best_f
            if delta < 0 or rng.uniform() < np.exp(-delta / T):
                x = x_new.copy()

        T *= cooling_rate

    return best_x
