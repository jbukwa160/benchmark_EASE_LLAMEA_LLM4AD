def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        i = rng.randint(0, dim)
        dx = (rng.uniform(lb[i], ub[i]) - x[i]) / rng.uniform(1.0, 10.0)
        x[i] += dx
        clipped_x = np.clip(x, lb, ub)

        f = func(clipped_x)
        if f < best_f:
            best_f = f
            best_x = clipped_x.copy()

    return best_x
