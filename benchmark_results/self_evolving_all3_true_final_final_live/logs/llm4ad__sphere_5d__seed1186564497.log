def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = np.inf
    
    for i in range(budget):
        x = best_x + (ub - lb) * np.random.rand(dim)
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
        
        f = func(x)
        
        if f < best_f:
            best_x = x
            best_f = f
            
    return best_x
