def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    n = int(np.ceil(budget / dim))
    mu = 10
    sigma = 1.0

    population = [rng.uniform(lb, ub, size=dim) for _ in range(mu)]
    best = np.inf
    best_individual = None

    for _ in range(n):
        fitnesses = [evaluate(x) for x in population]
        elite_indices = np.argsort(fitnesses)[:int(mu / 2)]

        next_population = []
        for i in elite_indices:
            new_individual = population[i] + rng.normal(0, sigma, size=dim)
            next_population.append(new_individual)

        if len(next_population) < mu:
            for _ in range(mu - len(next_population)):
                new_individual = np.array([rng.uniform(lb, ub) for _ in range(dim)])
                next_population.append(new_individual)

        population = next_population

        best_i = np.argmin(fitnesses)
        best_individual = population[best_i]
        best = fitnesses[best_i]

    return best_individual
