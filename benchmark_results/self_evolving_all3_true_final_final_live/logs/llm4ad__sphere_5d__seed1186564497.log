def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def get_next_candidate(mean, sigma):
        z = rng.randn(dim)
        return mean + sigma * z

    mean = np.zeros(dim)
    sigma = 5.0
    x_best = mean
    f_best = float('inf')

    for _ in range(budget):
        candidate = clip(get_next_candidate(mean, sigma))
        f_candidate = func(candidate)

        if f_candidate < f_best:
            f_best = f_candidate
            x_best = candidate

        mean = 0.1 * (mean + np.sqrt(budget / (_ + 1)) * (candidate - mean))

    return x_best
