def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_y = func(x)
    sigma = 1.0
    iterations = 0

    while iterations < budget:
        y = func(x)
        
        if y < best_y:
            best_x = x.copy()
            best_y = y
            
        for i in range(dim):
            v = rng.normal(size=dim)
            new_x = x + sigma * v
            new_x = np.clip(new_x, lb, ub)
            
            y_new = func(new_x)
            
            if y_new < y:
                x[i] = new_x[i]
                
        sigma *= 0.99
        
        iterations += 1

    return best_x
