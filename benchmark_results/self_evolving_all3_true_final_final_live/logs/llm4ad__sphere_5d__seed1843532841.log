def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(budget):
        pop_size = int(np.ceil(budget / 2))
        initial_pop = rng.uniform(lb, ub, size=(pop_size, dim))
        return initial_pop

    def compute_fitness(pop):
        fitness_values = func(pop)
        return fitness_values

    def compute_stepsize(mu, pop, stepsize):
        covariance_matrix = np.cov(pop.T) + (np.eye(dim) * 1e-8)
        step_direction = np.linalg.solve(covariance_matrix, np.ones((dim, 1)))
        return stepsize * step_direction / np.sqrt(np.dot(stepdirection, stepdirection))

    def adapt_stepsize(mu, pop):
        fitness_values = compute_fitness(pop)
        std_devs = np.std(pop, axis=0)
        sigma = np.mean(std_devs) + 2e-4
        return sigma

    def generate_next_population(current_pop, stepsize):
        next_pop = current_pop + stepsize
        return clip(next_pop)

    initial_pop = generate_initial_population(budget)
    best_solution = None
    best_fitness = float('inf')

    for _ in range(int(np.ceil(budget / 2))):
        fitness_values = compute_fitness(initial_pop)
        idx_best = np.argmin(fitness_values)
        current_best_solution = clip(initial_pop[idx_best])

        if fitness_values[idx_best] < best_fitness:
            best_solution = current_best_solution
            best_fitness = fitness_values[idx_best]

        stepsize = adapt_stepsize(best_solution, initial_pop)
        next_pop = generate_next_population(initial_pop, stepsize)
        initial_pop = next_pop

    return best_solution
