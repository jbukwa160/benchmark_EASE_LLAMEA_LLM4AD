def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        return func(clip(x))

    best = None
    for _ in range(budget):
        x = np.zeros(dim)
        sigma = 1.0
        while True:
            distribution = rng.normal(size=dim) * sigma
            new_x = x + distribution
            if evaluate(new_x) < (best is None or evaluate(best)):
                best = new_x
            if evaluate(new_x) > evaluate(x):
                sigma *= 0.5
            else:
                sigma = np.max([sigma * 1.01, 0.5])
                x = new_x
            if sigma < 1e-6:
                break

    return best
