def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    best_candidate = np.random.uniform(lb, ub, size=dim)
    best_fitness = func(best_candidate)
    candidate = best_candidate.copy()

    for _ in range(budget - 1):
        new_candidate = np.random.uniform(lb, ub, size=dim)
        new_fitness = func(new_candidate)

        if new_fitness < best_fitness:
            best_candidate = new_candidate
            best_fitness = new_fitness

        delta = rng.truncexponential(1)  # truncated exponential distribution between -1 and +1
        candidate += delta * (new_candidate - candidate)
        candidate = clip_candidate(candidate)

        if func(candidate) < best_fitness:
            best_candidate = candidate.copy()
            best_fitness = func(best_candidate)

    return best_candidate
