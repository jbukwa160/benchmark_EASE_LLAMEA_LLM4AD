def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = np.inf
    
    for _ in range(budget):
        x = lb + (ub - lb) * rng.rand(dim)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
            
        if _ > 0 and rng.rand() < 1e-6:  # early stopping with small probability
