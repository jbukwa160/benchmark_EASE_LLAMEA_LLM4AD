def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.ones(dim)
    f_best = 1e10
    for _ in range(budget):
        x_new = x_best + rng.normal(size=dim) * 0.01
        f_new = func(x_new)
        if np.all(np.logical_and(lb <= x_new, x_new <= ub)) and f_new < f_best:
            x_best = x_new
            f_best = f_new
    return x_best
