def algorithm(func, dim, lb, ub, budget, rng):
    D = len(dim)
    pop_size = 100
    sigma = 0.5
    T = 500
    cooling_rate = 0.95
    best_x = rng.uniform(lb, ub, size=D)
    best_f = func(best_x)

    for _ in range(budget):
        X = np.random.uniform(lb, ub, size=(pop_size, D))
        F = rng.uniform(0.1, 1, size=pop_size)
        for i in range(pop_size):
            v = X[i] + sigma * (F * (X[np.random.choice(range(pop_size), size=D)] - X[i]) +
                               (rng.rand(D) > 0.5))
            v = np.clip(v, lb, ub)
            f = func(v)
            if f < best_f:
                best_f = f
                best_x = v

        T *= cooling_rate
        sigma *= (1 + 1 / T)

    return best_x
