def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    mutation_factor = 0.5
    crossover_rate = 0.9
    
    bounds = [(lb, ub) for _ in range(dim)]
    
    def objective(x):
        return func(x)
    
    de_res = differential_evolution(objective, bounds=bounds, args=(dim,), x0=rng.rand(dim), strategy='rand1exp', mutation_factor=mutation_factor, crossover_rate=crossover_rate, maxiter=budget//pop_size, tol=1e-8, polish=True)
    
    best_x = de_res.x
    best_f = de_res.fun
    
    simplex_bounds = [(lb, ub) for _ in range(dim)]
    simplex_init = rng.rand(dim)
    
    def objective_simplex(x):
        return func(x)
    
    res = minimize(objective_simplex, simplex_init, method='Nelder-Mead', bounds=simplex_bounds, options={'maxiter': budget//pop_size})
    
    if res.fun < best_f:
        best_x = res.x
        best_f = res.fun
    
    return np.clip(best_x, lb, ub)
