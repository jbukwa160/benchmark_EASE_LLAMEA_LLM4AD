def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_process(x_train, y_train):
        cov_func = lambda x1, x2: 1 * np.exp(-np.sum((x1 - x2) ** 2))
        cov_matrix = np.array([[cov_func(xi, xj) for xi in x_train] for xj in x_train])
        mean_vector = np.mean(y_train)
        return mean_vector, cov_matrix

    def predict(gp_model, x_new):
        mean_vector, cov_matrix = gp_model
        return mean_vector + np.dot(np.array([cov_func(x_new, x) for x in x_train]), np.linalg.inv(cov_matrix))

    best_x = rng.uniform(lb, ub, size=dim)
    best_y = func(best_x)

    x_train, y_train = [], []
    gp_model = None

    for i in range(budget):
        if i > 0:
            mean_vector, cov_matrix = gaussian_process(x_train, y_train)
            gp_model = (mean_vector, cov_matrix)

        new_x = best_x.copy()
        for j in range(dim):
            noise = rng.uniform(-1e-3, 1e-3)
            new_x[j] += np.sqrt(1 / (i + 1)) * noise
            new_x[j] = max(lb, min(new_x[j], ub))

        new_y = func(new_x)

        if new_y < best_y:
            best_x = new_x.copy()
            best_y = new_y

        x_train.append(best_x)
        y_train.append(best_y)

    return np.array([best_x])
