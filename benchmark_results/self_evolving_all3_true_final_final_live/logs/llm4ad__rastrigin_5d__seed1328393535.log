def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(np.clip(x, lb, ub))

    current = rng.uniform(lb, ub, size=dim)
    best = current.copy()
    temp = 1.0
    depth = 0

    while budget > 0:
        for _ in range(dim * 10):
            new = current + rng.normal(size=dim) / np.sqrt(depth + 2)
            if evaluate(new) < evaluate(current):
                current = new
                if evaluate(current) < evaluate(best):
                    best = current.copy()
            temp *= 0.99
            if rng.uniform() > np.exp((evaluate(new) - evaluate(current)) / temp):
                current = new

        depth += 1
        budget -= dim * 10

    return best
