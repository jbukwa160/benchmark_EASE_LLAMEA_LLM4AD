def algorithm(func, dim, lb, ub, budget, rng):
    mu = 10 * np.eye(dim)
    sigma = 1 + 0.5 * (ub - lb) / rng
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = np.clip(np.random.multivariate_normal(0, mu, 1), lb, ub)
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
        
        delta = x - best_x
        H = (np.outer(delta, delta) + np.eye(dim)) / len([x for x in [best_x] if rng == 1])
        
        mu += sigma ** 2 * H
        sigma *= 0.99 + 0.01 * np.random.uniform(-1, 1)
    
    return best_x
