def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def rastrigin(x):
        return func(10*x + np.sum(x**2 - 10*np.cos(2*np.pi*x)))

    n = len(rng.state)
    mean = np.zeros(dim)
    cov = 1.0 * np.eye(dim)
    noise_scale = 1e-6
    restarts = 5

    best = None
    for _ in range(budget):
        if rng.random() < 0.01:
            # restart
            mean = np.random.uniform(lb, ub, size=dim)
            cov = 1.0 * np.eye(dim)

        noise = rng.normal(size=dim) * noise_scale
        x = clip(mean + rng.normal(size=n) * np.sqrt(cov))
        f_x = rastrigin(x)

        if best is None or f_x < func(10*best + np.sum(best**2 - 10*np.cos(2*np.pi*best))):
            best = x

        cov += (x-mean).reshape(-1, 1) @ (x-mean).reshape(1, -1) / n
        mean = (mean * (n-1) + x) / n

    return best
