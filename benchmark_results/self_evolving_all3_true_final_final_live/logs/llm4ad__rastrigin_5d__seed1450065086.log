def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = None
    best_fval = float('inf')
    
    for _ in range(budget):
        sol = rng.uniform(lb, ub, size=dim)
        fval = func(sol)
        
        if fval < best_fval:
            best_fval = fval
            best_sol = sol
        
        if np.random.rand() < 0.1:  # 10% chance of restarting
            sol = rng.uniform(lb, ub, size=dim)
    
    return best_sol
