def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_population(pop_size, dim, bounds):
        return rng.uniform(bounds[:, 0], bounds[:, 1], (pop_size, dim))

    def mutation(c, x_best, strategy):
        if strategy == 'rand/1/bin':
            r1 = rng.rand(dim)
            r2 = rng.rand(dim)
            mutant_c = c + r1 * (x_best - c) + r2 * (ub - lb)
            return clip(mutant_c)
        elif strategy == 'best/1/exp':
            mutant_c = x_best
            for i in range(dim):
                alpha = 0.5 if rng.rand() < 0.5 else 1.1
                mutant_c[i] += alpha * (ub - lb) * np.random.randn()
            return clip(mutant_c)
        else:
            raise ValueError('Invalid strategy')

    def crossover(c, x_best):
        if rng.rand() < 0.5:
            return c
        else:
            return x_best

    population = generate_population(50, dim, [lb, ub])
    for _ in range(budget):
        fitness_values = [func(x) for x in population]
        best_idx = np.argmin(fitness_values)
        x_best = population[best_idx]
        
        # Hill-climbing
        for i in range(dim):
            candidate = crossover(population[best_idx], x_best)
            candidate[i] += 0.01 * (ub - lb) * rng.randn()
            candidate[i] = clip(candidate[i])
            if func(candidate) < fitness_values[best_idx]:
                population[best_idx] = candidate
                fitness_values[best_idx] = func(population[best_idx])

        # Differential Evolution
        for i in range(50):
            mutant_c = mutation(population[i], x_best, 'rand/1/bin')
            trial = crossover(mutant_c, x_best)
            if func(trial) < fitness_values[i]:
                population[i] = trial
                fitness_values[i] = func(population[i])

    best_idx = np.argmin(fitness_values)
    return population[best_idx]
