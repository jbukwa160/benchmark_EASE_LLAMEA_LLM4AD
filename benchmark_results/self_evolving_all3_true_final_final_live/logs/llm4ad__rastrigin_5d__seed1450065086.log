def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    pop_size = 10 * dim + 1
    mean = np.zeros(dim)
    sigma = 0.5
    cov = np.eye(dim) * (sigma ** 2)
    cum_diversity = 1.0

    for _ in range(budget):
        candidates = rng.normal(mean, scale=sigma, size=(pop_size, dim))
        candidates = clip(candidates, lb, ub)

        fits = np.array([func(candidate) for candidate in candidates])

        sorted_indices = np.argsort(fits)
        best_candidate = candidates[sorted_indices[:1]]

        selected = candidates[sorted_indices[:int(0.1 * pop_size)]]
        selected_fits = fits[sorted_indices[:int(0.1 * pop_size)]]

        mean = np.mean(selected, axis=0)

        for i in range(dim):
            cov[i, :] = (cov[i, :] + 2 / pop_size * np.dot(selected[:, i] - mean, selected[:, i] - mean)) / cum_diversity
            cum_diversity += 1

        lambda_ = int(0.25 * pop_size)
        weights = np.zeros(pop_size)
        weights[sorted_indices[:lambda_]] = 1 / (selected_fits + 10 ** (-8))

        new_mean = mean.copy()
        for i in range(dim):
            sum_weights = np.sum(weights)
            numerator = np.sum(weights[:, None] * selected[:, i])
            denominator = np.sqrt(np.sum(weights[:, None] * cov[i, :]))
            if sum_weights > 0 and denominator > 1e-8:
                new_mean[i] += (numerator / sum_weights - mean[i]) / cum_diversity
            else:
                new_mean[i] += rng.uniform(-sigma, sigma)

        mean = clip(new_mean, lb, ub)
        sigma *= np.exp((np.mean(selected_fits) - fits[sorted_indices[:1]]) / 2 + (cum_diversity - 1) / (4 * cum_diversity))

    return best_candidate
