def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    learning_rate = 0.1

    for _ in range(budget):
        new_x = clip(best_x + learning_rate * rng.normal(size=dim))
        new_f = func(new_x)

        if new_f < best_f:
            best_x = new_x
            best_f = new_f

        # Elite selection: 10% of budget is used to re-evaluate the current best solution
        if _ % (budget // 10) == 0:
            candidate_idx = rng.choice(dim, size=dim)
            candidate_x = clip(best_x + learning_rate * rng.normal(size=dim))
            for i in range(dim):
                if func(candidate_x[candidate_idx[i]]) < func(best_x[candidate_idx[i]]):
                    best_x[candidate_idx[i]] = candidate_x[candidate_idx[i]]

    return best_x
