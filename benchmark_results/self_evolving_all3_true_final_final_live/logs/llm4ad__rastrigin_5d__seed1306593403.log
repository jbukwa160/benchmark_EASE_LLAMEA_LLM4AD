def algorithm(func, dim, lb, ub, budget, rng):
    def generate_population(n):
        return rng.uniform(lb, ub, (n, dim))

    def clip_candidates(candidates, bounds):
        return np.clip(candidates, *bounds)

    best_solution = None
    best_fitness = float('inf')
    restarts = 0

    for _ in range(budget):
        if restarts > 5:
            population = generate_population(50)
            restarts = 0
        else:
            population = np.vstack((np.random.choice(population, (1, dim), replace=False),
                                    rng.uniform(lb, ub, (49, dim))))

        for i in range(len(population)):
            candidate = population[i]
            if rng.random() < 0.5:
                trial = clip_candidates(candidate + rng.uniform(-10, 10, (dim)), (lb, ub))
            else:
                trial = clip_candidates(np.array([candidate[0] + rng.uniform(lb, ub)]).T + rng.uniform(-10, 10, (1, dim)), (lb, ub))

            fitness_trial = func(trial)
            if fitness_trial < best_fitness:
                best_solution = trial
                best_fitness = fitness_trial

        population = np.array([best_solution] + [candidate for candidate in population if func(candidate) != best_fitness])

    return best_solution
