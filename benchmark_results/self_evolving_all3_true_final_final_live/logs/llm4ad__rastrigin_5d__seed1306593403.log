def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(dim, lb, ub):
        return lb + (ub - lb) * rng.random((dim))

    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    x_best = get_candidate(dim, lb, ub)
    f_best = func(x_best)

    T_initial = 1000
    alpha = 0.98
    T = T_initial

    for i in range(budget):
        candidate = clip(get_candidate(dim, lb, ub), lb, ub)
        f_candidate = func(candidate)

        if f_candidate < f_best:
            x_best = candidate
            f_best = f_candidate

        delta = f_candidate - f_best
        T *= alpha

        if rng.rand() < np.exp(-delta / T):
            x_best = candidate
            f_best = f_candidate

    return x_best
