def algorithm(func, dim, lb, ub, budget, rng):
    n = int(np.ceil(budget / (dim * 0.1)))
    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for _ in range(n):
        arm_prob = np.zeros(dim)
        for i in range(dim):
            x = np.copy(best_x)
            x[i] += rng.uniform(-0.1, 0.1)
            x = np.clip(x, lb, ub)
            f = func(x)
            if f < best_f:
                best_f = f
                best_x = x

        # Update probabilities for each arm
        for i in range(dim):
            x = np.copy(best_x)
            x[i] += rng.uniform(-0.1, 0.1)
            x = np.clip(x, lb, ub)
            f = func(x)
            if f < best_f:
                arm_prob[i] = (f - best_f) / 10

        # Select the next point to sample
        cdf = np.cumsum(arm_prob)
        u = rng.uniform(0, 1)
        idx = np.where(cdf >= u)[0][0]

        x = np.copy(best_x)
        x[idx] += rng.uniform(-0.1, 0.1)
        x = np.clip(x, lb, ub)
        f = func(x)

        if f < best_f:
            best_f = f
            best_x = x

    return best_x
