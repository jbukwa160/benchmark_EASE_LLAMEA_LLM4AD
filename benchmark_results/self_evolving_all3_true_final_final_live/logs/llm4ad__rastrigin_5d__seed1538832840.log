def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lower_bound, upper_bound):
        return np.clip(candidate, a_min=lower_bound, a_max=upper_bound)

    def objective(x):
        return func(x)

    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_obj = objective(best_x)
    current_obj = objective(x)

    for i in range(budget):
        # Differential Evolution step
        y = clip(x + 0.5 * rng.normal(size=x.shape), lb, ub)
        z = clip(y + 0.5 * rng.normal(size=y.shape), lb, ub)
        w = clip(z + 0.5 * rng.normal(size=z.shape), lb, ub)

        f1 = objective(clip(x - w + 2 * rng.uniform(-1, 1, size=x.shape), lb, ub))
        f2 = objective(clip(y - z + 2 * rng.uniform(-1, 1, size=y.shape), lb, ub))

        # Simulated Annealing step
        if current_obj < best_obj or np.random.rand() < np.exp((current_obj - best_obj) / (i + 1)):
            x = clip(z + 0.5 * rng.normal(size=z.shape), lb, ub)
            current_obj = objective(x)

        # Update the best solution
        if current_obj < best_obj:
            best_x = x.copy()
            best_obj = current_obj

    return best_x
