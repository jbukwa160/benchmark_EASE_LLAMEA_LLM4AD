def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def evaluate(x):
        return func(x)

    # Initial population
    pop = rng.uniform(lb, ub, size=(budget, dim))

    # Differential Evolution parameters
    F = 1.0
    CR = 0.5

    for t in range(budget):
        # Evaluate population
        scores = [evaluate(clip(x, lb, ub)) for x in pop]

        # Find the best individual
        best_idx = np.argmin(scores)
        best_x = clip(pop[best_idx], lb, ub)

        # Differential Evolution mutation and crossover
        mutants = []
        for i in range(budget):
            r1 = rng.randint(0, budget - 1)
            while r1 == i:
                r1 = rng.randint(0, budget - 1)
            r2 = rng.randint(0, budget - 1)
            while r2 == i or r2 == r1:
                r2 = rng.randint(0, budget - 1)

            mutant_x = clip(pop[i] + F * (pop[r1] - pop[r2]), lb, ub)
            crossover_x = []
            for j in range(dim):
                if rng.random() < CR or mutant_x[j] != pop[i][j]:
                    crossover_x.append(mutant_x[j])
                else:
                    crossover_x.append(pop[i][j])

            mutants.append(crossover_x)

        # Simulated Annealing local search
        temperature = 1000 - t * 10
        for i in range(budget):
            mutant_idx = rng.randint(0, budget - 1)
            if evaluate(mutants[mutant_idx]) < evaluate(pop[i]):
                pop[i] = mutants[mutant_idx]
            elif np.random.rand() < np.exp(- (evaluate(mutants[mutant_idx]) - evaluate(pop[i])) / temperature):
                pop[i] = mutants[mutant_idx]

    # Return the best individual found
    scores = [evaluate(clip(x, lb, ub)) for x in pop]
    return clip(pop[np.argmin(scores)], lb, ub)
