def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 20
    sigma = 0.1
    F = 0.5
    best_x = None
    best_y = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, (pop_size, dim))
        
        y = func(x)
        
        if np.any(y < best_y):
            best_x = x[np.argmin(y)]
            best_y = np.min(y)
            
        v1 = rng.randn(pop_size, dim) * sigma
        v2 = rng.randn(pop_size, dim) * sigma
        
        for i in range(pop_size):
            trial_x = F * (best_x[i] + v1[i]) + (ub - lb) * rng.rand(dim)
            trial_y = func(np.clip(trial_x, lb, ub))
            
            if trial_y < best_y:
                best_x[i] = trial_x
                best_y = min(best_y, trial_y)
                
    return np.array([best_x[0]])
