    n_gen = 0
    pop_size = 10 * D
    mu = int(pop_size / 2)
    sigma = 1.0
    x_best = -np.inf
    x_best_sol = None

    # Initialize the covariance matrix and mean vector
    P = np.eye(D) + rng.randn(D, D)
    m = np.zeros(D)

    while n_gen < budget:
        for _ in range(pop_size):
            # Sample from a multivariate normal distribution with mean m and covariance matrix P
            x = np.dot(rng.randn(D), np.linalg.cholesky(P)) + m

            # Clip candidates to [lb, ub]
