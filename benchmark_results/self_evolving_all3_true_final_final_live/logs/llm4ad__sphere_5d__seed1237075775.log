def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    for _ in range(budget):
        f_x = func(x)
        if f_x == 0:
            return x
        s = np.full(dim, np.nan)
        for i in range(dim):
            step = rng.uniform(-1.0, 1.0)
            s[i] = x[i] + step * (x[i] - lb) / (ub - lb)
            f_s = func(s)
            if f_s < f_x:
                x = s
    return x
