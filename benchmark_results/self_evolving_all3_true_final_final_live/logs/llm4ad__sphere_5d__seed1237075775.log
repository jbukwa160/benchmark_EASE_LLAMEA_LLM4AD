def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    step_size = 5.0 / np.sqrt(budget)
    
    for i in range(budget):
        new_x = x + (ub - lb) * (rng.rand(dim) - 0.5) * 2
        new_x = np.clip(new_x, lb, ub)
        
        if func(new_x) < func(x):
            x = new_x
        
        step_size *= 1.001 ** (i / budget)
    
    return x
