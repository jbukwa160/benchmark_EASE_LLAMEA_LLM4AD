def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 1000
    alpha = 0.99
    best_x = x.copy()
    best_fx = func(x)

    for _ in range(budget):
        new_x = x + rng.uniform(-T, T, size=dim)
        new_fx = func(new_x)

        if new_fx < best_fx:
            best_fx = new_fx
            best_x = new_x

        if np.any(np.logical_or(new_x < lb, new_x > ub)):
            continue

        prob = np.exp((best_fx - new_fx) / T)
        if rng.uniform(0, 1) > prob:
            x = new_x

        T *= alpha
    return best_x
