def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(np.clip(x, lb, ub))

    x = rng.uniform(lb, ub, size=(1, dim))
    best_x = x.copy()
    best_f = evaluate(x)

    for _ in range(budget):
        v = rng.normal(size=(dim,))
        u = x + 0.5 * v
        f_u = evaluate(u)
        
        if f_u < best_f:
            best_x = u
            best_f = f_u
        
        # Local Search: gradient descent with a small step size and max iterations
        for _ in range(10):
            g = np.array([2 * x[i] for i in range(dim)])  # Approximate gradient using finite differences
            x -= 0.01 * g / np.linalg.norm(g)  # Step size of 0.01 and max iterations of 10
            
            if evaluate(np.clip(x, lb, ub)) < best_f:
                best_x = x.copy()
                best_f = evaluate(np.clip(x, lb, ub))
        
        x = (best_x + rng.uniform(lb, ub, size=(1, dim))) / 2
    
    return best_x
