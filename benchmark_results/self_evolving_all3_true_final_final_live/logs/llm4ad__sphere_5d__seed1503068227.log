def algorithm(func, dim, lb, ub, budget, rng):
    simplex = np.zeros((dim + 1, dim))
    for i in range(dim):
        simplex[0, i] = (ub - lb) * rng.rand() + lb
    for i in range(1, dim + 1):
        while np.linalg.norm(simplex[i, :] - simplex[0, :]) < 1e-6:
            simplex[i, :] = (ub - lb) * rng.rand() + lb

    simplex[:, dim] = func(simplex)

    for _ in range(budget - 1):
        centroid = np.mean(simplex[:-1, :-1], axis=0)
        new_point = centroid + (ub - lb) * rng.randn(dim)
        new_point = np.clip(new_point, lb, ub)
        new_point_value = func(np.append(new_point, centroid[-1]))
        
        if new_point_value < simplex[0, -1]:
            simplex = np.vstack((np.append(new_point, new_point_value), simplex))
            for i in range(1, dim + 2):
                if i != 0:
                    reflect_point = 2 * simplex[i, :-1] - simplex[0, :-1]
                    reflect_point_value = func(np.append(reflect_point, centroid[-1]))
                    if reflect_point_value < new_point_value:
                        simplex[i, :] = np.append(reflect_point, reflect_point_value)
        else:
            new_point_value = func(new_point)
            if new_point_value < simplex[0, -1]:
                simplex[0, :-1] = new_point
                simplex[0, -1] = new_point_value

    best_solution = simplex[np.argmin(simplex[:, -1])[:-1]]
    return best_solution
