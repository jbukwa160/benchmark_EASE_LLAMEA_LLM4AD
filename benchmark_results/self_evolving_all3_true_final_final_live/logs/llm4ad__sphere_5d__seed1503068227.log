def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(current_solution):
        new_solution = current_solution + rng.randn(dim)
        return clip(new_solution)

    def local_search(candidate, budget):
        for _ in range(budget):
            new_candidate = candidate + rng.randn(dim)
            new_candidate = clip(new_candidate)
            if func(new_candidate) < func(candidate):
                candidate = new_candidate
        return candidate

    current_solution = np.zeros(dim)
    temperature = 1.0
    cooling_rate = 0.99
    improvement_threshold = 0.1

    for _ in range(budget * dim):
        new_temperature = max(temperature * (1 - cooling_rate), 0.01)

        candidate = local_search(current_solution, int(budget / dim))
        if rng.rand() < np.exp((func(candidate) - func(current_solution)) / new_temperature):
            current_solution = candidate

        temperature *= cooling_rate
        if _ % int(0.1 * budget * dim) == 0:
            improvement = func(current_solution)
            print(f'Improvement after {int(_ / (budget * dim))} iterations: {improvement}')

    return current_solution
