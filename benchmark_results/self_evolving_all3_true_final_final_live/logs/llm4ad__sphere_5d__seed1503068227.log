def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best = None
    temp = 1.0
    sigma = 5.0

    for _ in range(budget):
        candidates = clip(rng.normal(size=(dim,)))
        f_values = func(candidates)
        idx = np.argmin(f_values)

        if best is None or f_values[idx] < func(best):
            best = candidates[idx]

        temp *= 0.99
        sigma *= 1.01

    return best
