def algorithm(func, dim, lb, ub, budget, rng):
    D = 0.5
    sigma = 0.1
    T = 100.0
    n_iter_sa = int(0.1 * budget)
    
    best_x = np.zeros(dim)
    best_fval = float('inf')
    
    for i in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        fval = func(x)
        
        if fval < best_fval:
            best_x = x
            best_fval = fval
        
        # Differential Evolution step
        r1, r2, r3 = rng.choice(dim, 3, replace=False)
        x_try = x + D * (x[r1] - x[r2]) + sigma * rng.normal(0, 1, size=dim)
        
        # Clip candidates to [lb, ub]
        x_try = np.clip(x_try, lb, ub)
        
        fval_try = func(x_try)
        
        if fval_try < best_fval:
            best_x = x_try
            best_fval = fval_try
        
        # Simulated Annealing step
        if i >= n_iter_sa and rng.uniform(0, 1) < np.exp((best_fval - fval) / T):
            T *= 0.99
    
    return best_x
