def algorithm(func, dim, lb, ub, budget, rng):
    def sample(lb, ub):
        return (ub - lb) * rng + lb
    
    def evaluate(x):
        return func(x)
    
    current = sample(lb, ub)
    best = current.copy()
    temperature = 1.0
    sigma_max = 10.0
    sigma_min = 0.01
    n_iter_no_improvement = 0
    iteration = 0
    
    while iteration < budget:
        new = current + sigma_min * (rng.randn(dim) - 0.5)
        new = np.clip(new, lb, ub)
        
        if evaluate(new) < evaluate(best):
            best = new.copy()
            n_iter_no_improvement = 0
        else:
            n_iter_no_improvement += 1
        
        probability = np.exp((evaluate(current) - evaluate(new)) / temperature)
        if rng.rand() < probability:
            current = new.copy()
        
        if n_iter_no_improvement > budget // 10:
            sigma_max *= 0.9
            n_iter_no_improvement = 0
        
        if iteration % (budget // 100) == 0 or iteration == budget - 1:
            temperature *= 0.999
        
        iteration += 1
    
    return best
