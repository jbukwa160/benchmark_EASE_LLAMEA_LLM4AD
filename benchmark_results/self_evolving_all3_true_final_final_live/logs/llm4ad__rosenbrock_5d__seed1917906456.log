def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, (1, dim))
    sigma = 0.5
    cov = np.eye(dim)
    best_x = x.copy()
    best_f = func(clip(x))

    for _ in range(budget):
        new_x = x + rng.normal(loc=0, scale=sigma, size=(1, dim))
        new_x = clip(new_x)

        f_new = func(new_x)

        if f_new < best_f:
            best_x = new_x
            best_f = f_new

        if np.linalg.norm(sigma) > 1e-3:  # cov matrix adaptation
            delta = new_x - x
            cov += np.outer(delta, delta)
            sigma = np.sqrt(np.diag(cov))

        x = np.random.multivariate_normal(mean=best_x.flatten(), cov=cov)

    return best_x
