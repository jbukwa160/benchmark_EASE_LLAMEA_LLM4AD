def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    def objective(x):
        x = clip(x)
        return func(x)

    population_size = 20
    neighborhood_size = [0.1] * (dim - 1) + [0.2]
    best_solution = rng.uniform(lb, ub)
    best_fitness = objective(best_solution)

    for i in range(budget):
        new_population = np.zeros((population_size, dim))
        for j in range(population_size):
            solution = clip(best_solution + rng.normal(0, 1, size=dim))
            if rng.uniform() < 0.5:
                solution = np.mean(np.vstack((new_population[:j], best_solution[:, None])), axis=0)
            new_population[j] = solution
        new_fitnesses = [objective(solution) for solution in new_population]
        new_indices = np.argsort(new_fitnesses)[:population_size//2]
        new_population = new_population[new_indices]
        new_fitnesses = [new_fitnesses[i] for i in new_indices]

        if rng.uniform() < 0.1:
            neighborhood_size = [0.05]* (dim - 1) + [0.1]
        elif rng.uniform() < 0.2:
            neighborhood_size = [0.5]* (dim - 1) + [1.]

        for j in range(population_size):
            solution = new_population[j]
            if rng.uniform() < 0.9 and objective(solution) < best_fitness:
                best_solution = solution
                best_fitness = objective(best_solution)
            elif rng.uniform() < 0.5 and objective(solution) > objective(best_solution + neighborhood_size * rng.normal(0, 1, size=dim)):
                best_solution = new_population[j]
                best_fitness = new_fitnesses[j]

    return best_solution
