def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    pop_size = int(budget ** (1 / 2))
    population = rng.uniform(lb, ub, (pop_size, dim))

    for _ in range(int(budget)):
        # Parent selection
        parents = []
        for i in range(pop_size):
            j = rng.randint(0, pop_size)
            k = rng.choice([l for l in range(pop_size) if l != i and l != j])
            parent = np.array([population[i], population[j], population[k]])
            np.random.shuffle(parent)
            parents.append(parent)

        # Mutation
        mutated_parents = np.array([(parents[i][0] + rng.uniform(-1, 1)) * (parents[i][2] - parents[i][1]) +
                                    (parents[i][1] + rng.uniform(-1, 1)) * (parents[i][0] - parents[i][2])
                                    for i in range(pop_size)])

        # Crossover
        crossovered = np.array([(parents[i][0] + rng.uniform(0, 1) * mutated_parents[i]) if rng.random() < 0.5 else
                                (mutated_parents[i] + rng.uniform(0, 1) * parents[i][0])
                               for i in range(pop_size)])

        # Selection
        population = clip(np.array([(crossovered[i] if func(crossovered[i]) <= func(parents[i][0]) else
                                     parents[i][0])
                                    for i in range(pop_size)]))

    return np.min(population, axis=0)
