def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return func(x)

    x = np.random.uniform(lb, ub, size=dim)
    temperature = 1e5
    cma_x = np.copy(x)
    cma_mean = np.zeros(dim)
    cma_cov = np.eye(dim) * 0.2

    for _ in range(budget):
        new_x = cma_mean + np.sqrt(cma_cov) @ rng.randn(dim)

        # Clip candidates to [lb, ub]
        new_x = np.clip(new_x, lb, ub)

        old_f = Rosenbrock(x)
        new_f = Rosenbrock(new_x)

        if new_f < old_f:
            x = new_x
            cma_mean = new_x

        elif np.random.rand() < np.exp((old_f - new_f) / temperature):
            x = new_x

        # Update CMA-ES parameters
        delta = (new_x - cma_mean) / np.sqrt(cma_cov.diagonal())
        cma_mean += 0.1 * delta @ cma_cov
        for i in range(dim):
            if delta[i] > 0:
                cma_cov[i, i] *= 1 + 2 / (dim + 1)
            elif delta[i] < 0:
                cma_cov[i, i] /= 1 - 2 / (dim + 1)

        # Update temperature schedule
        if new_f > old_f and np.random.rand() < 0.05:
            temperature *= 0.9

    return x
