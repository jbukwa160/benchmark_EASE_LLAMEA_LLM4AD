def algorithm(func, dim, lb, ub, budget, rng):
    D = len(dim)
    x_best = np.random.uniform(lb, ub, size=D)
    f_best = func(x_best)
    
    for _ in range(budget):
        radius = 0.1
        sigma = 2.0
        
        while True:
            r = np.zeros(D)
            for i in range(D):
                r[i] = rng.uniform(-radius, radius)
            
            x_new = x_best + r
            
            # Clip candidates to [lb, ub]
            x_new = np.clip(x_new, lb, ub)
            
            f_new = func(x_new)
            
            if f_new < f_best:
                x_best = x_new
                f_best = f_new
                
        radius *= 0.9
        
    return x_best
