def algorithm(func, dim, lb, ub, budget, rng):
    def sample(rng):
        x = np.zeros(dim)
        for i in range(dim):
            x[i] = rng.uniform(lb, ub)
        return x

    def expand(x):
        children = []
        for i in range(dim):
            child = x.copy()
            child[i] += 0.1
            if func(child) < func(x):
                children.append(child)
            child[i] -= 0.2
            if func(child) < func(x):
                children.append(child)
        return children

    def select(children, rng):
        return np.random.choice(children, p=[func(c)/sum([func(c) for c in children]) for c in children], size=1)[0]

    x_best = sample(rng)
    best_value = func(x_best)

    for _ in range(budget):
        x_current = select(expand(x_best), rng)
        if func(x_current) < best_value:
            x_best = x_current
            best_value = func(x_best)

        # Adaptive sampling: increase the step size when exploring new areas
        if len(expand(x_best)) > 10 and rng.random() < 0.5:
            for i in range(dim):
                x_best[i] += rng.uniform(-1, 1)
                if lb <= x_best[i] <= ub and func(x_best) < best_value:
                    break
                x_best[i] -= rng.uniform(-1, 1)

    return x_best
