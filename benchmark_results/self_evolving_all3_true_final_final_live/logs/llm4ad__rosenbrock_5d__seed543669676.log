def algorithm(func, dim, lb, ub, budget, rng):
    def acq_func(x):
        mu = func(x)
        sigma = 1e-6 + 0.01 * np.sum(np.abs(x - 1))
        return (func(x) - mu) / sigma if sigma > 1e-6 else 1e10

    best_x = 1 * np.ones(dim)
    best_f = func(best_x)

    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        f = func(x)
        acq = acq_func(x)

        if f < best_f:
            best_f = f
            best_x = x

        alpha = 0.1 + 0.9 * (1 - np.linalg.norm(best_x - 1) / dim)
        beta = 0.5 + 0.5 * (best_f / 100)

        for i in range(dim):
            x_try = best_x.copy()
            x_try[i] += 1e-4
            try:
                acq_try = acq_func(x_try)
            except np.linalg.LinAlgError:
                continue

            if acq_try < (alpha * acq + beta * np.inf):
                x[i] = x_try[i]
                break

    return best_x
