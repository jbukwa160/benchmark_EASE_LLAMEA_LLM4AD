def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(dim, pop_size, rng):
        return (ub - lb) * rng.uniform(size=(pop_size, dim)) + lb

    def differential_evolution(population, func, dim, lb, ub, budget, rng):
        for _ in range(budget):
            for i in range(len(population)):
                candidate = population[i]
                r1_idx, r2_idx, r3_idx = np.random.choice(range(len(population)), 3, replace=False)
                while r1_idx == i or r2_idx == i or r3_idx == i:
                    r1_idx, r2_idx, r3_idx = np.random.choice(range(len(population)), 3, replace=False)

                difference = population[r1_idx] - population[r2_idx]
                trial = clip(candidate + 0.5 * (difference / np.abs(difference).max()))

                if func(trial) < func(candidate):
                    candidate = trial

            population[i] = candidate
        return population

    initial_population = generate_initial_population(dim, 50, rng)
    best_candidate = differential_evolution(initial_population, func, dim, lb, ub, budget, rng)

    return best_candidate[np.argmin([func(x) for x in best_candidate])]
