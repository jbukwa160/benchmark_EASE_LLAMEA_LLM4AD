def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        x = clip(rng.normal(x, 0.5 * (ub - lb), size=dim))
        f = func(x)

        if f < best_f:
            best_f = f
            best_x = x

        x_local = best_x.copy()
        for i in range(dim):
            x_local[i] += rng.uniform(-1, 1) * 0.01 * (ub - lb)
            x_local = clip(x_local)

            if func(x_local) < best_f:
                best_f = func(x_local)
                best_x = x_local

    return best_x
