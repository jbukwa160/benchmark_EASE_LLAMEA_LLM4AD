def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_y = func(x)

    for _ in range(budget - 1):
        learning_rate = 0.01 / (1 + rng.rand() * 10)
        step_size = learning_rate * rng.uniform(-5, 5, size=dim)
        new_x = clip(best_x + step_size)
        new_y = func(new_x)

        if new_y < best_y:
            best_x = new_x
            best_y = new_y

    return best_x
