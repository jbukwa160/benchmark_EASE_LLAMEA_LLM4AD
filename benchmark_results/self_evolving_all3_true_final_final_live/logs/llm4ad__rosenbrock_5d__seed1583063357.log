def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(candidate=None):
        if candidate is None:
            return np.random.uniform(lb, ub, size=dim)
        else:
            return (candidate + 0.1 * rng.randn(dim)) % (ub - lb) + lb

    sigma = 2.0
    lambda_ = int(budget ** (1 / dim))
    mu = np.zeros(dim)
    cov = np.eye(dim) * sigma ** 2
    pc = np.zeros((lambda_, dim))

    for _ in range(budget):
        candidate = generate_candidate()
        fitness = func(candidate)
        
        if np.isnan(fitness):
            continue
        
        pc[np.arange(lambda_), :] = candidate
        pc -= mu

        cov += np.dot(pc.T, pc) / lambda_
        chdev = rng.randn(dim)

        for i in range(lambda_ - 1):
            index = i * (dim + 2)
            if rng.rand() < 0.5:
                index += 1
            if rng.rand() < 0.5:
                index += dim

            cov[index, :] *= 0.5
            chdev[index:] += np.sqrt(0.5 * rng.randn(*cov[index:, :].shape))

        chdev = np.dot(np.linalg.cholesky(cov), chdev)
        new_candidate = mu + sigma * chdev
        
        new_fitness = func(new_candidate)

        if np.isnan(new_fitness):
            continue

        if new_fitness < fitness:
            candidate = new_candidate
            fitness = new_fitness

        yield candidate, fitness

    best_candidate = None
    for candidate, _ in algorithm(func, dim, lb, ub, budget, rng):
        best_candidate = candidate
        break

    return best_candidate
