def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def gradient(x):
        grad = np.zeros(dim)
        for i in range(dim-1):
            grad[i] += 200 * (x[i+1] - x[i]**2) * (2*x[i]*100 + 1/5*2*(x[i+1]-x[i]**2)*200*x[i])
            grad[i+1] -= 400 * (x[i+1]-x[i]**2)**2
        return grad

    pop_size = int(np.sqrt(budget))
    x_best = np.random.uniform(lb, ub, size=(pop_size, dim))
    g_best = func(x_best)

    for _ in range(1, budget):
        parents = []
        parent_scores = []

        for i in range(pop_size):
            noise = rng.randn(dim)
            child = clip(x_best[i] + 0.1*noise)
            score = func(child)
            if score < g_best:
                g_best = score
                x_best[i] = child
            parents.append([child, score])
            parent_scores.append(score)

        parents.sort(key=lambda x: x[1])

        while len(parents) > pop_size // 2:
            del parents[-1]

        for i in range(pop_size):
            if parents[i][0].any() != clip(x_best[i] + gradient(x_best[i])/100).any():
                noise = rng.randn(dim)
                child = clip(x_best[i] + 0.1*noise)
                score = func(child)
                if score < g_best:
                    g_best = score
                    x_best[i] = child

    return np.array([x_best[np.argmin(g_best)]])
