def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(distribution):
        return np.clip(rng.normal(loc=distribution.mean, scale=distribution.std, size=dim), a_min=lb, a_max=ub)

    best_x = rng.uniform(size=dim)
    best_f = func(best_x)
    distribution = np.array([0.5] * dim)

    for _ in range(budget):
        candidate = get_candidate(distribution)
        f = func(candidate)

        if f < best_f:
            best_f, best_x = f, candidate

        improvement_rate = (best_f - f) / max(1e-6, np.abs(best_f))
        distribution *= 0.99 + 0.01 * improvement_rate
        distribution /= np.sum(distribution)

    return best_x
