def algorithm(func, dim, lb, ub, budget, rng):
    D = len(dim)
    population_size = int(budget**0.7) # heuristic for setting initial population size
    sigma = budget**(1/D) * 10 / population_size ** (1 / D) # heuristic for setting initial step size

    mean = np.array([np.mean([lb[i], ub[i]]) for i in range(D)])
    covariances = [[(ub[i] - lb[i])**2/2 for _ in range(D)] for _ in range(D)]

    def gko_step(population):
        new_population = []
        for x in population:
            y = np.zeros((D))
            for d in range(D):
                y[d] = func(x) + rng.normal(0, sigma)
            new_population.append(y)
        return new_population

    def cma_es_step(population):
        mean_new = np.copy(mean)
        cov_new = np.copy(np.array(covariances))
        
        for i in range(D):
            cov_new[i][i] += 1
        
        for x in population:
            diff = x - mean_new
            for i in range(D):
                cov_new[i][i] *= (1 + diff[i]**2)
        
        new_population = []
        for _ in range(population_size):
            mean_new += rng.normal(0, sigma) * np.array([np.sqrt(cov_new[i][i]) for i in range(D)])
            new_population.append(mean_new)
        
        return new_population

    population = [mean + [lb[i] + ub[i]/2 if rng.random() < 0.5 else -ub[i]/2 + lb[i]] * D for _ in range(population_size)]

    for _ in range(budget):
        population = gko_step(population)
        
        best_x = min(population, key=lambda x: func(x))
        best_f = func(best_x)

        if np.isinf(best_f) or best_f > 1e10:
            return np.array([lb[i] + ub[i]/2 for i in range(D)])

        population = cma_es_step(population)

    best_x = min(population, key=lambda x: func(x))
    clipped_best_x = [max(min(x, ub[i]), lb[i]) for i, x in enumerate(best_x)]
    
    return np.array(clipped_best_x)
