def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = evaluate(clip(x_best))
    
    T = 1
    alpha = 0.99
    beta = 0.01
    
    for _ in range(budget):
        y = clip(np.copy(x_best) + rng.uniform(-1, 1, size=dim))
        
        if evaluate(y) < f_best:
            x_best = y
            f_best = evaluate(clip(x_best))
            
        delta_f = f_best - evaluate(y)
        p = np.exp(-delta_f / T)
        
        if rng.random() < p:
            x_best = y
            f_best = evaluate(clip(x_best))
        
        T *= alpha + beta * (1 - _ / budget)
    
    return clip(x_best)
