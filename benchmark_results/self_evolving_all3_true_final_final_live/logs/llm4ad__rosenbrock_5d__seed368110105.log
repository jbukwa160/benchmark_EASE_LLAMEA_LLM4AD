def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(x, f, c1, c2):
        z = x + c1 * (ub - x) + c2 * (x - lb)
        return np.clip(z, lb, ub)

    def crossover(u, v, cr):
        w = u + cr * (v - u)
        return np.clip(w, lb, ub)

    best_x = lb + (ub - lb) * rng.rand(dim)
    best_f = func(best_x)

    for _ in range(budget):
        x1 = mutate(best_x, func, 0.5, 0.3)
        x2 = mutate(x1, func, 0.5, 0.3)
        u = crossover(x1, x2, 0.9)
        f_u = func(u)

        if f_u < best_f:
            best_x = u
            best_f = f_u

    return best_x
