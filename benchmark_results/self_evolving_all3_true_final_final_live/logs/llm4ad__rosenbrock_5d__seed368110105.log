def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    x0 = 1 + (ub - 1) * rng.rand(dim)
    bounds = [(lb, ub)] * dim
    res = minimize(objective, x0, method="SLSQP", bounds=bounds, options={"ftol": 1e-20})
    return res.x
