def algorithm(func, dim, lb, ub, budget, rng):
    D = 0.1 * (ub - lb)
    x_best = np.zeros(dim)
    f_best = float('inf')
    sigma = 5
    iter_count = 0
    while iter_count < budget:
        x = x_best + np.random.normal(0, sigma, dim)
        x = np.clip(x, lb, ub)
        f_x = func(x)
        if f_x < f_best:
            f_best = f_x
            x_best = x
            D = 0.1 * (ub - lb)
        else:
            D *= 0.9
        sigma *= 0.95
        iter_count += 1
    return x_best
