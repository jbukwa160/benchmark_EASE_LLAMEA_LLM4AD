def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    bounds = [(lb, ub) for _ in range(dim)]
    max_iter = int(budget / pop_size)
    
    def generate_initial_population(rng, bounds, dim):
        return [rng.uniform(bounds[i][0], bounds[i][1]) for i in range(dim)] + \
               [rng.uniform(bounds[i][0], bounds[i][1]) for i in range(dim)]
    
    def mutation(individual, best, rng, bounds, dim, alpha):
        mutant = individual
        for i in range(dim):
            delta = (best - individual) * alpha
            mutant[i] += rng.uniform(-delta, delta)
            mutant[i] = np.clip(mutant[i], bounds[i][0], bounds[i][1])
        return mutant
    
    def selection(population, best, rng):
        new_population = []
        for _ in range(pop_size):
            idx = rng.randint(0, pop_size)
            if rng.random() < 0.5:
                new_population.append(mutation(population[idx], best, rng, bounds, dim, alpha))
            else:
                new_population.append(population[idx])
        return new_population
    
    def adaptive_learning_rate(best, population):
        mean = np.mean([func(x) for x in population if func(x) < 0.1 * func(best)])
        return max(0.01, min(1.0, 0.9 + 0.8 * (mean - 0.1)))
    
    alpha = 0.5
    best_individual = None
    
    for _ in range(max_iter):
        population = generate_initial_population(rng, bounds, dim)
        for _ in range(pop_size):
            individual = population[_]
            if func(individual) < func(best_individual) or best_individual is None:
                best_individual = individual
        
        alpha = adaptive_learning_rate(best_individual, population)
        
        population = selection(population, best_individual, rng)
    
    return np.array([best_individual])
