def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    pop_size = 40 * D
    mu = 0.01
    c1 = 1 / (D + 1.5)
    sigma_init = 10
    alpha = 2
    lambda_ = 50
    threshold = 1e-6

    x_best = np.random.uniform(lb, ub, D)
    f_best = func(x_best)

    for _ in range(budget):
        y = np.zeros((pop_size, D))
        for i in range(pop_size):
            if rng.random() < 0.2:
                sigma = max(1e-6, min(sigma_init * (1 + mu), alpha * x_best))
            else:
                sigma = sigma_init
            x = x_best + np.random.normal(scale=sigma, size=D)
            y[i] = np.clip(x, lb, ub)

        f = func(y)
        indices = np.argsort(f)[:lambda_]
        y_sorted = y[indices]

        cov = np.cov(y_sorted.T)
        mean = np.mean(y_sorted, axis=0)
        step_size = c1 * (cov + 1e-8) ** -1

        x_best_new = mean
        f_best_new = func(x_best_new)

        if np.abs(f_best_new - f_best) < threshold:
            break

        x_best = x_best_new
        f_best = f_best_new

    return x_best
