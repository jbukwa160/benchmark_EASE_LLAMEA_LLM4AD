def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def rastrigin(x):
        return func(x) + 10*dim

    x_best = np.zeros(dim)
    y_best = rastrigin(x_best)
    f_current = y_best
    T_max = 1000.0
    cooling_rate = 0.99
    T = T_max

    for _ in range(budget):
        if rng.random() < 0.1:  # 10% chance of DE update
            x_new, _, _ = differential_evolution(rastrigin, [(lb, ub)]*dim)
            x_new = clip(x_new, lb, ub)
            y_new = rastrigin(x_new)

            if y_new < f_current:
                f_current = y_new
                x_best = x_new

        else:  # SA update
            delta = rng.uniform(-0.5, 0.5)*T
            x_new = clip(x_best + np.random.normal(size=dim)*delta, lb, ub)

            if rastrigin(x_new) < f_current:
                f_current = rastrigin(x_new)
                x_best = x_new

        T *= cooling_rate

    return x_best
