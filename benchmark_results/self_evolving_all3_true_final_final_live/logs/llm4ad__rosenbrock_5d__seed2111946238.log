def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    def eval(x):
        return func(x)

    pop_size = 50
    n_generations = int(budget / (dim * pop_size))
    mutation_prob = 0.1
    crossover_prob = 0.5

    x_best = bound(np.random.uniform(lb, ub, dim))
    f_best = eval(x_best)

    for gen in range(n_generations):
        offspring = np.zeros((pop_size, dim))
        for i in range(pop_size):
            x_rand = bound(np.random.uniform(lb, ub, dim))
            mutation_factor = rng.uniform(-1, 1)
            crossover_factor = rng.uniform(0, 1)
            mutation = mutation_prob * (x_rand - x_best) + crossover_factor * (offspring[i-1] - x_best)
            offspring[i] = bound(x_best + mutation)

        for i in range(pop_size):
            if eval(offspring[i]) < f_best:
                x_best = offspring[i]
                f_best = eval(x_best)

        crossover_mask = np.random.rand(pop_size) < crossover_prob
        offspring[crossover_mask] = (offspring[crossover_mask] + x_best) / 2

    return bound(x_best)
