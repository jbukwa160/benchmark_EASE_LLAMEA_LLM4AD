def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    x = np.random.uniform(lb, ub, size=dim)
    sigma = 0.5 * (ub - lb) / np.sqrt(dim)
    c1 = c2 = 1
    cmu = np.zeros(dim)
    ps = np.zeros((budget, dim))
    cs = np.zeros(budget)

    for i in range(1, budget + 1):
        y = x + sigma * (np.random.randn(dim) + c1 * cmu - c2 * rng.choice(x))
        y = np.clip(y, lb, ub)
        ps[i-1] = y
        cs[i-1] = objective(y)

    idx = np.argsort(cs)[:budget//2]
    x = ps[idx[0]]
    cmu = (ps[idx] - x) / sigma
    c1 = 1 + 3 * rng.uniform(0, 1)
    c2 = 1

    for _ in range(budget - budget//2):
        y = x + sigma * (np.random.randn(dim) + c1 * cmu - c2 * rng.choice(x))
        y = np.clip(y, lb, ub)
        cs[-1] = objective(y)
        if cs[-1] < cs[0]:
            x = y
            cmu = (ps[idx] - x) / sigma
        else:
            idx = np.argsort(cs)[-2:]
            cmu -= (ps[idx] - x) / sigma

    return x
