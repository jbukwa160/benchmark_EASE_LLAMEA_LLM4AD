def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def objective(x):
        return func(x)

    pop_size = int(budget ** 0.5)
    xbest = np.random.uniform(lb, ub, size=(pop_size, dim))

    for t in range(1, budget + 1):
        F = 0.5 * (2 - t / budget)
        C = 0.7
        y = np.zeros((pop_size, dim))
        
        for i in range(pop_size):
            r1, r2, r3 = rng.choice(pop_size, size=3, replace=False), rng.choice(pop_size, size=3, replace=False)
            v = clip(xbest[r1] + F * (xbest[r2] - xbest[r3]))
            y[i] = C * v + (1 - C) * xbest[i]
        
        sigma = 0.5
        for i in range(pop_size):
            noise = rng.normal(size=dim, loc=0, scale=sigma)
            y[i] += noise
        
        y = clip(y)

        f = objective(y)
        if t % 100 == 0:
            print(f't={t}, best_f={np.min([objective(xbest[i]) for i in range(pop_size)])}')

        indices = np.argsort([objective(x) for x in y])[::-1][:pop_size]
        xbest = y[indices]

    return xbest[np.argmin([objective(x) for x in xbest])]
