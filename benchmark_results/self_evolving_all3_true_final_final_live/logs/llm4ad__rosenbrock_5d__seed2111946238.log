def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def simulated_annealing(current_solution, temperature, iteration):
        new_solution = current_solution + rng.uniform(-1.0, 1.0, size=dim)
        new_solution = clip(new_solution, lb, ub)
        
        delta = func(new_solution) - func(current_solution)
        if delta < 0 or (delta >= 0 and np.random.rand() < np.exp(-iteration / temperature)):
            return new_solution
        else:
            return current_solution

    def crossover(parent1, parent2):
        child = (parent1 + parent2) / 2.0
        child = clip(child, lb, ub)
        return child

    x = rng.uniform(lb, ub, size=dim)
    
    best_solution = x.copy()
    current_solution = x.copy()
    
    temperature = np.log(budget / (budget - 1))
    iteration = 1
    
    while iteration <= budget:
        new_solution = simulated_annealing(current_solution, temperature, iteration)
        
        if func(new_solution) < func(best_solution):
            best_solution = new_solution
            
        crossover_solution = crossover(best_solution, current_solution)
        if func(crossover_solution) < func(best_solution):
            best_solution = crossover_solution
        
        current_solution = new_solution
        iteration += 1
    
    return best_solution
