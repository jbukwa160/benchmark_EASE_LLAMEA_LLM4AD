def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    n_dim = dim
    pop_size = int(np.sqrt(budget))
    x0 = (ub - lb) * rng.rand(n_dim) + lb
    x_best = x0.copy()
    f_best = evaluate(x_best)
    population = [x0]

    for _ in range(budget):
        new_population = []
        for _ in range(pop_size):
            i, j, k = rng.choice(range(pop_size), 3, replace=False)
            u = rng.rand(n_dim) * (ub - lb) + lb
            v = rng.uniform(-1, 1)
            x_new = population[i] + v * (population[j] - population[k]) + u

            # Clip to bounds
            x_new = np.clip(x_new, lb, ub)

            f_new = evaluate(x_new)
            if f_new < f_best:
                f_best = f_new
                x_best = x_new.copy()
            new_population.append(x_new)

        population = new_population

    return x_best
