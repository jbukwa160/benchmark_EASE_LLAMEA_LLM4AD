def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(n):
        return [clip(rng.uniform(lb, ub, (dim))) for _ in range(n)]

    def evaluate(population):
        return [func(individual) for individual in population]

    def acceptance_probability(current_fitness, new_fitness, temperature):
        if current_fitness <= new_fitness:
            return 1.0
        else:
            return np.exp((new_fitness - current_fitness) / temperature)

    def simulated_annealing(population, temperature, budget):
        best_individual = min(population, key=lambda x: func(x))
        for _ in range(budget):
            i, j = random.sample(range(len(population)), 2)
            new_individual = clip(best_individual + rng.uniform(-1.0, 1.0, (dim)))
            new_fitness = func(new_individual)
            if new_fitness < func(best_individual) and acceptance_probability(func(best_individual), new_fitness, temperature):
                best_individual = new_individual
            population[j] = new_individual
        return best_individual

    def differential_evolution(population, budget):
        for _ in range(budget):
            i, j, k = random.sample(range(len(population)), 3)
            mutation_index = [i, j, k][np.random.choice(3)]
            individual = clip(population[mutation_index] + rng.uniform(-1.0, 1.0, (dim)))
            population[j] = individual
        return min(population, key=lambda x: func(x))

    initial_population = generate_initial_population(100)
    evaluated_population = evaluate(initial_population)

    temperature = 10.0
    sa_budget = budget // 2

    best_individual_sa = simulated_annealing(initial_population, temperature, sa_budget)

    remaining_budget = budget - sa_budget

    de_budget = min(remaining_budget, 50)
    de_population = generate_initial_population(100)
    evaluated_de_population = evaluate(de_population)
    best_individual_de = differential_evolution(de_population, de_budget)

    final_best_individual = min([best_individual_sa, best_individual_de], key=lambda x: func(x))
    return np.array(final_best_individual)
