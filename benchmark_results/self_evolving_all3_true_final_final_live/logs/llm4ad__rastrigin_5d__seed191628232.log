def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Exploration phase
        x_exploration = rng.normal(0, 1, size=dim)
        x_exploration = clip_to_bounds(x + 0.1 * x_exploration, lb, ub)
        f_exploration = func(x_exploration)

        # Exploitation phase
        if f_exploration < best_f:
            best_x = x_exploration.copy()
            best_f = f_exploration

        # Adaptive step size adjustment
        exploration_step_size = 0.1 * rng.normal(1, 0.5)
        exploitation_step_size = 0.01 * (best_f - func(best_x))
        if exploration_step_size < exploitation_step_size:
            x_exploration = rng.normal(0, 1, size=dim)
            x_exploration = clip_to_bounds(x + exploration_step_size * x_exploration, lb, ub)
            f_exploration = func(x_exploration)

            # Update best solution
            if f_exploration < best_f:
                best_x = x_exploration.copy()
                best_f = f_exploration

    return best_x
