def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    pop = np.random.uniform(lb, ub, size=(pop_size, dim))
    best = np.inf
    for _ in range(budget):
        fit_pop = func(pop)
        idx = np.argmin(fit_pop)
        if fit_pop[idx] < best:
            best = fit_pop[idx]
            best_x = pop[idx]
        temp = 1.0
        while True:
            mutation_prob = 0.5
            mutated_pop = pop.copy()
            for i in range(pop_size):
                if rng.random() < mutation_prob:
                    v = np.zeros(dim)
                    for j in range(dim):
                        if rng.random() < 0.5:
                            v[j] = (ub - lb) * rng.uniform(-1, 1) + pop[i, j]
                        else:
                            v[j] = ub + (pop[i, j] - lb) * rng.uniform(-1, 1)
                    mutated_pop[i] = v
            fit_mutated_pop = func(mutated_pop)
            idx = np.argmin(fit_mutated_pop)
            if fit_mutated_pop[idx] < best:
                temp *= 0.99
                pop = mutated_pop.copy()
                break
            elif rng.random() > 1e-5 * temp:
                pop = mutated_pop.copy()
                break
        crossover_prob = 0.9
        for i in range(pop_size):
            if rng.random() < crossover_prob:
                p1_idx = np.random.choice(pop_size, size=2)
                v = 0.5 * (pop[p1_idx[0], :] + pop[p1_idx[1], :])
                mutated_pop[i] = v
        fit_mutated_pop = func(mutated_pop)
        idx = np.argmin(fit_mutated_pop)
        if fit_mutated_pop[idx] < best:
            temp *= 0.99
            pop = mutated_pop.copy()
        elif rng.random() > 1e-5 * temp:
            pop = mutated_pop.copy()
    return best_x
