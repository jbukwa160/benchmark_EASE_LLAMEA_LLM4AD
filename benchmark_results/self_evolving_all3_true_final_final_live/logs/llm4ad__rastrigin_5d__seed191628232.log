def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def objective(x):
        return func(x)

    pop_size = 100
    pop = np.random.uniform(lb, ub, (pop_size, dim))
    best = None

    for i in range(budget):
        if budget % 10 == 0:
            pop = np.random.uniform(lb, ub, (pop_size, dim))

        scores = [objective(clip(x)) for x in pop]
        sorted_pop = np.array(pop)[np.argsort(scores)]

        for j in range(1, pop_size):
            trial = clip(sorted_pop[j] + rng.normal(0, 0.5) * (sorted_pop[j-1] - sorted_pop[j]))

            if objective(trial) < scores[j]:
                sorted_pop[j], trial = trial, sorted_pop[j]
                scores[j] = objective(clip(trial))

        best_candidate = clip(sorted_pop[0])
        if best is None or objective(best_candidate) < objective(best):
            best = best_candidate

    return best
