def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        # Cyclic exploration
        for i in range(dim):
            # Perturb the current solution along each dimension
            perturbation = 0.1 * rng.random() - 0.05
            new_x = x.copy()
            new_x[i] += perturbation
            
            new_f = func(clip(new_x))
            
            if new_f < best_f:
                best_f = new_f
                best_x = clip(new_x)
        
        # Local refinement of the best solution found so far
        for _ in range(budget // dim):
            # Perturb the current best solution along each dimension
            perturbation = 0.01 * rng.random() - 0.005
            new_best_x = best_x.copy()
            new_best_x[i] += perturbation
            
            new_best_f = func(clip(new_best_x))
            
            if new_best_f < best_f:
                best_f = new_best_f
                best_x = clip(new_best_x)
    
    return best_x
