def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    cr = 0.8
    f = 0.9
    
    x_min = np.full(dim, lb)
    x_max = np.full(dim, ub)
    
    population = rng.uniform(lb, ub, size=(pop_size, dim))
    
    best_x = None
    best_f = float('inf')
    
    for t in range(budget):
        y = np.zeros((pop_size, dim))
        
        for i in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size, size=3)
            
            if rng.random() < cr:
                y[i] = population[r1] + f * (population[r2] - population[r3])
            else:
                y[i] = population[r1]
        
        # Clip candidates to [lb, ub]
        for i in range(pop_size):
            y[i] = np.clip(y[i], lb, ub)
            
        f_values = func(y)
        
        best_i = np.argmin(f_values)
        
        if f_values[best_i] < best_f:
            best_x = y[best_i]
            best_f = f_values[best_i]
        
        # Adaptive Grid Search
        grid_size = int(np.ceil(np.sqrt(pop_size)))
        for i in range(0, pop_size, grid_size):
            for j in range(grid_size):
                x_grid = population[i+j]
                
                # Clip grid points to [lb, ub]
                x_grid = np.clip(x_grid, lb, ub)
                
                f_grid = func(x_grid)
                
                best_i_grid = np.argmin(f_values[:i+j+1])
                
                if f_grid < f_values[best_i_grid]:
                    population[i+j] = x_grid
                    f_values[i+j] = f_grid
                    
    return best_x
