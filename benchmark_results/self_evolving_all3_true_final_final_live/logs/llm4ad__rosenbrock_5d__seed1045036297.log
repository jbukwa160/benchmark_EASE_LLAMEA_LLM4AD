def algorithm(func, dim, lb, ub, budget, rng):
    x = (lb + ub) / 2 * np.ones(dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        step_size = max(0.1, (ub - lb) / 10)
        dx = step_size * rng.randn(dim)
        x_new = x + dx
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new

        alpha = 0.1
        beta = 0.5
        t = rng.uniform(0, 1)
        if t < alpha:
            x = x_new
        elif t < alpha + beta * (1 - np.exp(-(f_new - best_f) / 10)):
            x = (x_new - dx) / 2 + x

    return best_x
