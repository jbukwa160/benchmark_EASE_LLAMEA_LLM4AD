def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def objective(x):
        return func(x)

    x = np.random.uniform(lb, ub, size=(budget, dim))
    fitness = np.array([objective(clip(x_i, lb, ub)) for x_i in x])

    best_x = x[np.argmin(fitness)]
    best_fitness = np.min(fitness)
    
    learning_rate = 1.0
    for i in range(budget - 1):
        noise = rng.normal(size=(dim,))
        mutant = best_x + learning_rate * noise / (np.linalg.norm(noise) + 1e-8)
        mutant = clip(mutant, lb, ub)

        fitness_mutant = np.array([objective(clip(mutant_i, lb, ub)) for mutant_i in mutant])
        
        indices = np.argsort(fitness_mutant)[:2]
        if best_fitness > fitness_mutant[indices[0]]:
            best_x = mutant[indices[0]]
            best_fitness = fitness_mutant[indices[0]]

    return best_x
