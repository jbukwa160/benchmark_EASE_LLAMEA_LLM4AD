def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(num_particles, dim):
        x = rng.uniform(lb, ub, (num_particles, dim))
        return x

    def calculate_fitness(x):
        return func(x)

    def calculate_distance(x1, x2):
        return np.linalg.norm(x1 - x2)

    num_particles = 50
    x = generate_initial_population(num_particles, dim)
    best_solution = clip(x[0])
    best_fitness = calculate_fitness(best_solution)

    cooling_schedule = lambda t: 0.995 ** t

    for t in range(budget):
        # Selection and mutation
        y = np.copy(x)
        mask = rng.uniform(0, 1, (num_particles, dim)) > 0.5
        y[mask] += rng.uniform(-10, 10, (np.sum(mask), dim))
        y = clip(y)

        # Crossover
        z = np.zeros((num_particles, dim))
        for i in range(num_particles):
            j = rng.randint(0, num_particles)
            while i == j:
                j = rng.randint(0, num_particles)
            z[i] = 0.5 * y[i] + 0.5 * x[j]

        # Selection and update
        fitness_y = calculate_fitness(y)
        fitness_z = calculate_fitness(z)

        for i in range(num_particles):
            if (fitness_y[i] < best_fitness or rng.uniform(0, 1) < np.exp((best_fitness - fitness_y[i]) / cooling_schedule(t))) and \
               (fitness_z[i] < best_fitness or rng.uniform(0, 1) < np.exp((best_fitness - fitness_z[i]) / cooling_schedule(t))):
                x[i] = y[i]
                if fitness_y[i] < best_fitness:
                    best_solution = clip(x[i])
                    best_fitness = fitness_y[i]

            elif fitness_z[i] < best_fitness and rng.uniform(0, 1) < np.exp((best_fitness - fitness_z[i]) / cooling_schedule(t)):
                x[i] = z[i]
                if fitness_z[i] < best_fitness:
                    best_solution = clip(x[i])
                    best_fitness = fitness_z[i]

    return best_solution
