def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, (1, dim))
    best_fitness = func(x_best)
    step_size = 0.5 * (ub - lb) / dim
    num_successful_steps = 0
    for i in range(1, budget + 1):
        if rng.random() < 0.2:
            x_new = np.clip(np.random.uniform(lb, ub, (1, dim)), a_min=lb, a_max=ub)
        else:
            x_new = x_best + rng.choice([-1, 1], size=(1, dim)) * step_size
        fitness = func(x_new)
        if fitness < best_fitness:
            best_fitness = fitness
            x_best = x_new
            num_successful_steps += 1
        else:
            step_size *= np.exp(-num_successful_steps / i)
            num_successful_steps = 0
    return x_best
