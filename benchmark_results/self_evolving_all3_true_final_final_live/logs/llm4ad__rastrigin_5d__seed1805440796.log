def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(1, dim))
    cma = 0.5 * np.eye(dim)
    p = np.zeros((dim,))
    sigma = 0.25
    f_best = func(x)

    for _ in range(budget):
        z = rng.randn(1, dim)
        y = x + sigma * np.dot(np.sqrt(cma), z)
        y = np.clip(y, lb, ub)

        fy = func(y)
        if fy < f_best:
            f_best = fy
            x = y

        p = 0.5 * (p + (y - x) / sigma)
        cma += (1 - 2 / (dim + 3)) * np.outer(p, p) + 2 / (dim + 3) * cma
        sigma *= 1 + 1 / (4 + dim - 3)

    return x
