def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(rng, lb, ub, dim):
        return lb + (ub - lb) * rng.uniform(size=(dim, 100))

    def differential_evolution(population, func, lb, ub, dim):
        population = np.clip(population, lb, ub)
        scores = [func(individual) for individual in population]
        parents = np.array([population[i] for i in np.argsort(scores)[:10]])
        children = []
        for _ in range(70):
            parent1, parent2 = rng.choice(parents, size=2, replace=False)
            child = parent1 + 0.5 * (parent2 - parent1) + rng.uniform(-1, 1, dim)
            child = np.clip(child, lb, ub)
            children.append(child)
        return np.array(children)

    def cma_es(population, func, dim):
        scores = [func(individual) for individual in population]
        best_individual = population[np.argmin(scores)]
        subspace_size = int(dim * 0.5)
        new_population = []
        for _ in range(100):
            parent = rng.choice(population, p=np.array(scores)/sum(scores))
            parent_subspace = parent[:subspace_size]
            child = np.copy(parent)
            for i in range(subspace_size, dim):
                child[i] = parent[i] + 0.5 * (parent[i] - parent_subspace[i % subspace_size]) + rng.uniform(-1, 1)
            new_population.append(child)
        return np.array(new_population)

    population = generate_initial_population(rng, lb, ub, dim)
    for _ in range(budget):
        population = differential_evolution(population, func, lb, ub, dim)
        population = cma_es(population, func, dim)
    best_individual = population[np.argmin([func(individual) for individual in population])]
    return best_individual
