def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    D = 1.0 / (n * rng)
    mean = np.zeros(n)
    cov = D * np.eye(n)

    for _ in range(budget):
        x_new = np.random.multivariate_normal(mean, cov)
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)

        if rng < 1e-3:
            if f_new < func(mean):
                mean = x_new
                cov *= 0.5

    return mean
