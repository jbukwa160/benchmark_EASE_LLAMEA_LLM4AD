def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x0 = rng.uniform(lb, ub, size=dim)
    T = 1.0
    alpha = 0.99

    for _ in range(budget):
        x_new = clip(x0 + 0.2 * (ub - lb) * np.random.randn(dim), lb, ub)

        delta = func(clip(x_new, lb, ub)) - func(clip(x0, lb, ub))

        if delta < 0:
            x0 = x_new
        else:
            prob = np.exp(-delta / T)
            if rng.uniform(0, 1) < prob:
                x0 = x_new

        T *= alpha

    return clip(x0, lb, ub)
