def algorithm(func, dim, lb, ub, budget, rng):
    def objective(params):
        return func(params)

    n = 1
    sigma = 10 / np.sqrt(dim)
    best_params = np.zeros(dim)
    best_fitness = float('inf')

    for _ in range(budget):
        pop_size = int(n * (ub - lb) ** 2 + 1)
        params = rng.uniform(lb, ub, size=(pop_size, dim))
        fitnesses = [objective(param) for param in params]

        sorted_indices = np.argsort(fitnesses)[:int(pop_size / 2)]
        new_params = params[sorted_indices]
        new_fitnesses = [fitnesses[i] for i in sorted_indices]

        mu = new_params[:int(pop_size / 5), :]
        sigma *= 0.9 + 10 * (1 - np.exp(-_ / budget))

        for _ in range(10):
            mutation = rng.normal(size=(pop_size, dim))
            mutated_params = new_params + sigma * mutation
            clipped_params = np.clip(mutated_params, lb, ub)

            fitnesses = [objective(param) for param in clipped_params]
            sorted_indices = np.argsort(fitnesses)[:int(pop_size / 2)]
            new_params[sorted_indices] = clipped_params[sorted_indices]
            new_fitnesses[sorted_indices] = fitnesses[sorted_indices]

        mu = new_params[:int(pop_size / 5), :]
        sigma *= 0.9 + 10 * (1 - np.exp(-_ / budget))

        if best_fitness > min(new_fitnesses):
            best_fitness = min(new_fitnesses)
            best_params = new_params[np.argmin(new_fitnesses)]

    return best_params
