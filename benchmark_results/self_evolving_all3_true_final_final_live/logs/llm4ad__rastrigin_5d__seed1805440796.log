def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x) if x.size == dim else func(np.atleast_1d(x))

    D = dim
    n_candidates = 20 * D

    best_candidate = rng.uniform(lb, ub)
    best_fitness = evaluate(best_candidate)
    best_candidate = clip(best_candidate)

    for i in range(budget):
        candidates = np.vstack([clip(rng.normal(size=D)) + lb for _ in range(n_candidates)])
        fitnesses = [evaluate(candidate) for candidate in candidates]

        idx = np.argsort(fitnesses)[:D]
        candidates, fitnesses = candidates[idx], np.array(fitnesses)[idx]

        if i < budget // 2:
            best_candidate = candidates[0]
            best_fitness = fitnesses[0]
        else:
            weights = [1 - i / (budget * 0.5) for i in range(n_candidates)]
            mean = np.average(candidates, axis=0, weights=weights)
            std_devs = np.std(candidates, axis=0)

            if len(std_devs[std_devs < 0]) > D // 2:
                best_candidate = candidates[np.argmax(fitnesses)]
                best_fitness = fitnesses[np.argmax(fitnesses)]
            else:
                new_candidates = mean + rng.normal(size=D) * std_devs
                new_fitnesses = [evaluate(candidate) for candidate in new_candidates]
                idx = np.argsort(new_fitnesses)[:D]
                new_candidates, new_fitnesses = new_candidates[idx], np.array(new_fitnesses)[idx]

                weights = [1 - i / (budget * 0.5) for i in range(n_candidates)]
                mean = np.average(candidates, axis=0, weights=weights)
                std_devs = np.std(candidates, axis=0)

                if len(std_devs[std_devs < 0]) > D // 2:
                    best_candidate = candidates[np.argmax(fitnesses)]
                    best_fitness = fitnesses[np.argmax(fitnesses)]
                else:
                    best_candidate = new_candidates[0]
                    best_fitness = new_fitnesses[0]

    return clip(best_candidate)
