def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n = int(np.ceil(budget ** (1 / D)))
    mu = 0.1 * np.random.randn(D)
    sigma = 10
    c_c = 2 / (D + 1.27)
    c_cov = 2 / ((D + 1.93) ** 2 + 2)

    for _ in range(n):
        x = mu + rng.uniform(-sigma, sigma, size=D)
        x = np.clip(x, lb, ub)
        f_x = func(x)

        if rng.random() < c_c:
            z = rng.randn(D)
            sigma *= np.exp(1 / (D + 2) * (f_x - rng.uniform(-1e8, 0)))
            mu += z * sigma

        y = mu + rng.randn(D) * sigma
        f_y = func(y)

        if f_y < f_x:
            mu = y
            x = y

    return np.clip(mu, lb, ub)
