def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def obj_func(x):
        return func(x)

    init_sigma = 0.5 * (ub - lb)
    n_pop = 100
    pop_size = n_pop
    mu = pop_size // 2

    init_pop = rng.uniform(lb, ub, size=(pop_size, dim))

    for _ in range(budget):
        scores = [obj_func(x) for x in init_pop]
        best_idx = np.argsort(scores)[:mu]

        new_pop = []
        for idx in best_idx:
            x = init_pop[idx]
            y = rng.normal(0, init_sigma, size=dim)
            z = clip(x + y, lb, ub)
            new_pop.append(z)

        pop_size += 1
        if len(new_pop) > pop_size:
            init_pop = np.array(new_pop[:pop_size])
        else:
            init_pop = np.concatenate((init_pop, np.array(new_pop)))

    scores = [obj_func(x) for x in init_pop]
    best_idx = np.argmin(scores)
    return clip(init_pop[best_idx], lb, ub)
