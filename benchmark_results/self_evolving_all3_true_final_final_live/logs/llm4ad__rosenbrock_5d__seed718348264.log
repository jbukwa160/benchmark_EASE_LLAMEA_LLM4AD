def algorithm(func, dim, lb, ub, budget, rng):
    def bounded_random_search(bounds, size=1, rng=rng):
        return rng.uniform(bounds[0], bounds[1], (size, dim))

    def differential_evolution(bounds, pop_size=10, mut=0.5, cross_prob=0.7, seed=42):
        np.random.seed(seed)
        x = bounded_random_search(bounds, pop_size)
        y = func(x)
        for _ in range(budget // 2):
            z = x + mut * (x[np.random.choice(pop_size, size=dim, replace=False)] - x)
            z = np.clip(z, bounds[0], bounds[1])
            w = func(z)
            if w < y:
                x[z < x] = z[z < x]
                y = w
        return x[np.argmin(y)]

    def simulated_annealing(bounds, T=100, cooling_rate=0.95):
        x = bounded_random_search(bounds, 1)
        y = func(x)
        for _ in range(budget - budget // 2):
            z = x + rng.normal(size=x.shape)
            z = np.clip(z, bounds[0], bounds[1])
            w = func(z)
            if w < y:
                x, y = z, w
            else:
                delta = w - y
                if np.random.rand() < np.exp(-delta / T):
                    x, y = z, w
                T *= cooling_rate
        return x

    x1 = differential_evolution((lb, ub), pop_size=20)
    x2 = simulated_annealing((lb, ub))
    return x2 if func(x2) < func(x1) else x1
