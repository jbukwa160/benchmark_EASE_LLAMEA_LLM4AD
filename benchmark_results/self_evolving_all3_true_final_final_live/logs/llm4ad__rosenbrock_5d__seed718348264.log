def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x)

    population_size = 100
    generations = int(budget / (dim * population_size))
    mutation_rate = 0.5
    temperature = 1e10

    initial_population = rng.uniform(lb, ub, size=(population_size, dim))

    best_solution = np.inf
    best_candidate = None

    for _ in range(generations):
        new_population = initial_population.copy()
        for i in range(population_size):
            target = initial_population[i]
            mutation = rng.normal(size=dim)
            mutated_target = clip(target + mutation_rate * mutation)
            trial = evaluate(mutated_target)

            if trial < evaluate(target):
                new_population[i] = mutated_target
            else:
                probability = np.exp((evaluate(target) - trial) / temperature)
                if rng.rand() < probability:
                    new_population[i] = mutated_target
        initial_population = new_population.copy()

        current_best = np.min([evaluate(candidate) for candidate in initial_population])
        if current_best < best_solution:
            best_solution = current_best
            best_candidate = np.argmin([evaluate(candidate) for candidate in initial_population])

    return clip(initial_population[best_candidate])
