def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(pop_size):
        return np.random.uniform(lb, ub, (pop_size, dim))

    def calculate_fitness(population):
        fitness = []
        for x in population:
            fitness.append(func(x))
        return np.array(fitness)

    def adaptive_crossover(parent1, parent2):
        child = (parent1 + parent2) / 2
        return np.clip(child, lb, ub)

    def adaptive_mutation(individual, mutation_rate):
        mutated_individual = individual + rng.uniform(-1, 1, dim)
        return np.clip(mutated_individual, lb, ub)

    population_size = int(budget ** (1 / dim))
    initial_population = generate_initial_population(population_size)
    best_solution = None
    best_fitness = float('inf')
    temperature = budget

    for t in range(1, budget + 1):
        fitness_values = calculate_fitness(initial_population)
        best_individual = np.argmin(fitness_values)
        if fitness_values[best_individual] < best_fitness:
            best_fitness = fitness_values[best_individual]
            best_solution = initial_population[best_individual]

        parents = np.argsort(fitness_values)[:population_size // 2]
        offspring = []
        for i in range(population_size // 2):
            parent1, parent2 = parents[i], parents[(i + 1) % (population_size // 2)]
            child = adaptive_crossover(initial_population[parent1], initial_population[parent2])
            mutated_child = adaptive_mutation(child, temperature / t)
            offspring.append(mutated_child)

        initial_population = np.vstack((initial_population, np.array(offspring)))
        initial_population = np.clip(initial_population, lb, ub)

    return best_solution
