def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    class Particle:
        def __init__(self, x0, v0):
            self.position = x0
            self.velocity = v0

    class DEPSO:
        def __init__(self, pop_size, dim, lb, ub, budget):
            self.pop_size = pop_size
            self.dim = dim
            self.lb = lb
            self.ub = ub
            self.budget = budget
            self.particles = [Particle(rng.uniform(lb, ub, size=dim), rng.uniform(-5, 5, size=dim)) for _ in range(pop_size)]

        def differential_evolution(self):
            particles_copy = self.particles.copy()
            best_particle_index = np.argmin([func(particle.position) for particle in self.particles])
            best_particle = self.particles[best_particle_index]

            for i in range(self.pop_size - 1):
                j, k, l = rng.choice(range(self.pop_size), size=3, replace=False)
                while (j == best_particle_index or
                       np.linalg.norm(particles_copy[j].position - particles_copy[k].position) < 0.01 or
                       np.linalg.norm(particles_copy[j].position - particles_copy[l].position) < 0.01):
                    j, k, l = rng.choice(range(self.pop_size), size=3, replace=False)

                mutant_particle_position = (particles_copy[j].position + particles_copy[k].position + particles_copy[l].position) / 3
                trial_particle_position = mutant_particle_position + rng.uniform(-5, 5, size=self.dim)
                trial_particle_position = clip(trial_particle_position)

                if func(trial_particle_position) < func(particles_copy[j].position):
                    particles_copy[j] = Particle(trial_particle_position, rng.uniform(-5, 5, size=self.dim))

            self.particles = particles_copy

        def particle_swarm_optimization(self):
            for i in range(len(self.particles)):
                v_new = self.particles[i].velocity + rng.uniform(-1, 1, size=self.dim)
                x_new = clip(self.particles[i].position + v_new)

                if func(x_new) < func(self.particles[i].position):
                    self.particles[i] = Particle(x_new, v_new)

        def optimize(self):
            for _ in range(self.budget):
                self.differential_evolution()
                self.particle_swarm_optimization()

    optimizer = DEPSO(pop_size=50, dim=dim, lb=lb, ub=ub, budget=budget)
    optimizer.optimize()

    best_particle = np.argmin([func(particle.position) for particle in optimizer.particles])
    return optimizer.particles[best_particle].position
