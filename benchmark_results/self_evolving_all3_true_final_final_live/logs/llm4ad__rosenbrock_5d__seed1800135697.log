def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, a_min=lb, a_max=ub)

    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        noise = rng.normal(size=(dim,))
        new_x = clip(x + 0.1 * noise, lb, ub)
        new_f = func(new_x)
        
        if new_f < best_f:
            best_f = new_f
            best_x = new_x.copy()
            
        for i in range(dim):
            x_candidate = clip(x + np.eye(dim)[i] * 0.1 * noise[i], lb, ub)
            f_candidate = func(x_candidate)
            
            if f_candidate < best_f:
                best_f = f_candidate
                best_x = x_candidate.copy()

    return best_x
