def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    t = 1.0
    alpha = 0.9
    lambda_ = 10

    for _ in range(budget):
        # Simulated Annealing (SA) phase
        while True:
            y = rng.uniform(lb, ub, size=dim)
            delta_f = func(y) - best_f
            if delta_f < 0 or np.random.rand() < np.exp(-delta_f / t):
                x = y.copy()
                best_x = x.copy()
                best_f = func(x)
                break
            else:
                t *= alpha

        # Crossover-based Evolution Strategy (CES) phase
        v = rng.normal(size=dim)
        z = best_x + lambda_ * v / np.linalg.norm(v)
        z = np.clip(z, lb, ub)

        if func(z) < best_f:
            x = z.copy()
            best_x = z.copy()
            best_f = func(z)

    return best_x
