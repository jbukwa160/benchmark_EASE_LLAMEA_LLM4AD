def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = clip(rng.uniform(lb, ub, size=dim))
    y_min = func(x)
    
    for _ in range(budget - 1):
        v1 = clip(x + rng.uniform(-1, 1, size=dim))
        v2 = clip(x + rng.uniform(-1, 1, size=dim))
        v3 = clip(x + rng.uniform(-1, 1, size=dim))
        
        f1 = func(v1)
        f2 = func(v2)
        f3 = func(v3)
        
        if (np.random.rand() < 0.5 and f1 <= y_min) or np.random.rand() < 0.99:
            x = v1
            y_min = f1
            
        if (np.random.rand() < 0.5 and f2 <= y_min):
            x = v2
            y_min = f2
            
        if (np.random.rand() < 0.5 and f3 <= y_min):
            x = v3
            y_min = f3
            
    return clip(x)
