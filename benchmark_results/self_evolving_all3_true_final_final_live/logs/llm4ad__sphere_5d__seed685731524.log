def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    best = clip(rng.rand(dim))
    best_f = func(best)
    for i in range(budget - 1):
        mutant = clip(best + rng.uniform(-1, 1, size=dim) * rng.choice([-1, 1], size=dim))
        if func(mutant) < best_f:
            best = mutant
            best_f = func(best)
    return best
