def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget - 1):
        new_x = rng.uniform(lb, ub, size=dim)
        
        # Gradient estimation using finite differences
        step_size = 0.01
        gradient = np.zeros(dim)
        for i in range(dim):
            x_clone = new_x.copy()
            x_clone[i] += step_size
            gradient[i] = (func(x_clone) - func(new_x)) / step_size
        
        # Gradient-based refinement
        alpha = 0.1
        new_x = best_x - alpha * gradient
        
        # Clip to bounds
        new_x = np.clip(new_x, lb, ub)
        
        # Evaluate and update best solution if necessary
        new_f = func(new_x)
        if new_f < best_f:
            best_f = new_f
            best_x = new_x.copy()
    
    return best_x
