def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.ones(dim)
    f_best = float('inf')
    
    for _ in range(budget):
        # Step 1: Sample a random point
        x_rand = lb + (ub - lb) * rng.rand(dim)
        
        # Step 2: Compute the gradient of the function at the current best point
        grad = np.zeros(dim)
        if f_best < float('inf'):
            for i in range(dim):
                epsilon = 1e-3
                x_plus_epsilon_i = x_best.copy()
                x_plus_epsilon_i[i] += epsilon
                grad[i] = (func(x_plus_epsilon_i) - func(x_best)) / epsilon
        
        # Step 3: Compute the step size using Armijo rule
        alpha = 0.1
        def f_alpha(alpha):
            return func(x_best + alpha * grad)
        
        if f_alpha(1) < f_best:
            best_alpha = 1
        else:
            best_alpha = 0
            
            for i in range(10):
                alpha_new = (1 - 2**i) / 100.0
                if f_alpha(alpha_new) < f_alpha(best_alpha):
                    best_alpha = alpha_new
        
        # Step 4: Update the current best point and function value
        x_new = x_best + best_alpha * grad
        x_new = np.clip(x_new, lb, ub)
        
        if func(x_new) < f_best:
            f_best = func(x_new)
            x_best = x_new
    
    return x_best
