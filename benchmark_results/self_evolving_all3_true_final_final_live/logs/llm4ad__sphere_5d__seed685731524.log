def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    pop_size = 100
    pop = rng.uniform(lb, ub, (pop_size, dim))

    for _ in range(budget):
        fitness = [func(clip(x)) for x in pop]
        idx = np.argsort(fitness)[:int(pop_size / 2)]
        parents = pop[idx]

        offspring = []
        while len(offspring) < pop_size:
            p1, p2 = rng.choice(parents, size=2, replace=False)
            child = (p1 + p2) * rng.uniform(0.5, 1.0) / 2
            offspring.append(child)

        mutation_rate = 0.01
        for i in range(pop_size):
            if rng.random() < mutation_rate:
                idx = rng.randint(dim)
                offspring[i][idx] += rng.uniform(-1e-6, 1e-6)

        pop = np.array(offspring)

    best_idx = np.argmin([func(clip(x)) for x in pop])
    return clip(pop[best_idx])
