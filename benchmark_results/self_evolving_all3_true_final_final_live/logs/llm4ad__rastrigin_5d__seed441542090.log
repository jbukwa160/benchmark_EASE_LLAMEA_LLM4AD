def algorithm(func, dim, lb, ub, budget, rng):
    X = np.random.uniform(lb, ub, (budget, dim))
    Y = func(X)
    best_idx = 0
    min_val = np.inf
    
    for i in range(1, budget):
        if Y[i] < min_val:
            min_val = Y[i]
            best_idx = i
            
        r = rng.uniform()
        if r < 0.01:  # elitism probability
            idx = np.random.randint(0, i + 1)
            X[i] = X[idx].copy()
        else:
            for j in range(dim):
                X[i, j] = lb + (ub - lb) * rng.uniform()
                
    return X[best_idx]
