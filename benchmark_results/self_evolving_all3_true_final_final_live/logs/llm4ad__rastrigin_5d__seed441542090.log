def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    D = dim
    G = int(budget / pop_size)
    F = 0.5
    CR = 0.9
    x_best = None
    f_best = float('inf')
    
    for g in range(G):
        X = rng.uniform(lb, ub, (pop_size, D))
        
        for i in range(pop_size):
            r1, r2, r3 = np.random.choice(range(pop_size), 3, replace=False)
            
            if rng.rand() < CR:
                u = X[r1]
                v = X[r2]
                w = X[r3]
                x_new = X[i] + F * (u - X[i]) + F * (v - X[i])
            else:
                x_new = X[i]
            
            if func(x_new) < func(X[i]):
                X[i] = x_new
            
        f_max = np.max([func(x) for x in X])
        
        if f_max < f_best:
            f_best = f_max
            x_best = X[np.argmax([func(x) for x in X])]
    
    return x_best
