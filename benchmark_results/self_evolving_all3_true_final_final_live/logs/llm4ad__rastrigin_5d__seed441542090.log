def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def generate_population(n):
        return rng.uniform(lb, ub, size=(n, dim))

    def evaluate(population):
        return func(clip(population))

    n = 50
    population_size = min(n, budget)
    population = generate_population(population_size)
    best_candidate = np.zeros(dim)

    for _ in range(budget):
        fitness = evaluate(population)
        idx = np.argsort(fitness)[:population_size//2]
        population[idx] = best_candidate

        variation_matrix = rng.uniform(-1, 1, size=(population_size, dim))
        new_population = population + variation_matrix[:, np.newaxis] * (population[np.random.randint(0, population_size, size=population_size), np.newaxis] - best_candidate)
        fitness_new = evaluate(new_population)

        idx = np.argsort(fitness_new)[:population_size//2]
        population[idx] = new_population[idx]

        better_idx = np.where(fitness_new < fitness)[0]
        if len(better_idx) > 0:
            population[better_idx] = new_population[better_idx]
            best_candidate = population[np.argmin(np.append(fitness, fitness_new))]

    return best_candidate
