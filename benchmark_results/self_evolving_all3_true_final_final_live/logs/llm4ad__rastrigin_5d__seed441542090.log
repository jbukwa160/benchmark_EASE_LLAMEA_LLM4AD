def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    pop_size = 100
    population = rng.uniform(lb, ub, (pop_size, dim))
    diversity = np.linalg.norm(population, axis=1)
    diversity_mean = np.mean(diversity)
    best_x = population[np.argmin([func(clip(x, lb, ub)) for x in population])]
    
    for i in range(budget):
        # Probability-based adaptive learning rate
        alpha = 0.01 * (i / budget)**2
        
        # Update each individual with a small probability
        for j in range(pop_size):
            if rng.rand() < 0.1:
                new_x = population[j] + alpha * rng.randn(dim)
                new_x = clip(new_x, lb, ub)
                population[j] = new_x
                
        diversity = np.linalg.norm(population, axis=1)
        diversity_mean = np.mean(diversity)
        
        # Restart if the population's diversity decreases
        if diversity_mean < 0.5 * diversity_mean:
            population = rng.uniform(lb, ub, (pop_size, dim))
        
        best_x = population[np.argmin([func(clip(x, lb, ub)) for x in population])]
    
    return clip(best_x, lb, ub)
