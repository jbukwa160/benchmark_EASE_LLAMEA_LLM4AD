def algorithm(func, dim, lb, ub, budget, rng):
    def generate_x(rng):
        x = np.zeros(dim)
        for i in range(dim):
            x[i] = rng.uniform(lb, ub)
        return x

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    n_iterations = int(budget / dim)
    pop_size = 10
    mu = np.zeros((n_iterations, pop_size, dim))
    sigma = np.ones(n_iterations) * 0.5
    f_values = np.zeros(n_iterations)

    for i in range(n_iterations):
        if rng.random() < 0.1:
            # mutation step
            noise = np.random.normal(0, sigma[i], (pop_size, dim))
            mu[i] = clip(mu[i - 1] + noise, lb, ub)
        else:
            # selection step
            children = np.zeros((pop_size, dim))
            for j in range(pop_size):
                x = generate_x(rng)
                children[j] = clip(x, lb, ub)
            mu[i] = np.mean(children, axis=0)

        f_values[i] = func(mu[i])

    best_index = np.argmin(f_values)
    return clip(mu[best_index], lb, ub)
