def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    t = 0
    sigma = 1.5 * (ub - lb) / np.sqrt(rng.rand())
    T = 10.0

    while t < budget:
        for _ in range(dim):
            x_trial = x_best + sigma * rng.randn(dim)
            f_trial = func(x_trial)

            if f_trial < f_best or rng.rand() < np.exp((f_best - f_trial) / T):
                x_best = x_trial
                f_best = f_trial

        sigma *= 0.99
        T -= 0.1

        t += 1

    return x_best
