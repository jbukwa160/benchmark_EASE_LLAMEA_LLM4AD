def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    def mutate(x, step_size):
        mutated = x + np.random.normal(0, step_size, size=dim)
        mutated = clip(mutated)
        return mutated

    def select(parents, children):
        idx = np.argsort([func(mutate(child, 1e-6)) for child in children])
        parents[:] = children[idx[:len(parents)]]

    mu = int(np.sqrt(budget))
    lambda_ = mu * 5
    sigma = 1.0

    x = rng.uniform(lb, ub, size=dim)
    best_x = np.copy(x)

    for _ in range(budget):
        candidates = np.array([mutate(x, sigma) for _ in range(lambda_)])
        candidates = clip(candidates)

        select(np.copy(x), candidates)

        if func(best_x) > func(x):
            best_x[:] = x

    return best_x
