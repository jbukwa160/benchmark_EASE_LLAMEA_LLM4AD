def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    def eval(x):
        x = clip(x)
        return func(x)

    pop_size = int(budget ** (1 / 3))
    D = np.zeros((pop_size, dim))
    F = 0.5
    CR = 0.9

    for i in range(pop_size):
        D[i] = rng.uniform(lb, ub, size=dim)

    for _ in range(budget - pop_size):
        new_pop = np.copy(D)
        for i in range(pop_size):
            target = D[i]
            mu = rng.choice([j for j in range(pop_size) if j != i])
            delta = F * (clip(new_pop[mu] + 0.1*rng.normal(0, 1, size=dim)) - target)
            new_target = clip(target + delta)

            ridx = rng.randint(pop_size)
            while ridx == mu or ridx == i:
                ridx = rng.randint(pop_size)

            u = D[ridx]

            if rng.random() < CR:
                new_pop[i] = (new_target * rng.uniform(0.5, 1) + u * rng.uniform(0, 0.5))
            else:
                new_pop[i] = clip(new_target)

        D = new_pop

    best_x = np.copy(D[0])
    best_f = eval(best_x)
    for i in range(pop_size):
        x = D[i]
        f = eval(x)
        if f < best_f:
            best_f = f
            best_x = x

    return best_x
