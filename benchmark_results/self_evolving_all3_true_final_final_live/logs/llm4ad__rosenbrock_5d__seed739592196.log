def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50  # Population size
    cr = 0.9  # Crossover probability
    f = func

    def generate_initial_population():
        return np.random.uniform(lb, ub, (pop_size, dim))

    def clip(x):
        return np.clip(x, lb, ub)

    def eval_pop(pop):
        scores = [f(x) for x in pop]
        return np.array(scores), pop[np.argmin(scores)]

    initial_population = generate_initial_population()
    best_solution = eval_pop(initial_population)[1]

    step_size = 5.0 / dim  # Initial step size

    for _ in range(budget):
        new_population = []
        for x in initial_population:
            idx = rng.choice(dim, p=[1/dim]*dim)
            v = clip(x + step_size * (best_solution - x))
            u = clip(best_solution + cr * (v - best_solution))
            new_population.append(u)

        scores, best_solution = eval_pop(np.array(new_population))

        if len(initial_population) < pop_size:
            initial_population = np.vstack((initial_population, new_population))
        else:
            initial_population = new_population

    return best_solution
