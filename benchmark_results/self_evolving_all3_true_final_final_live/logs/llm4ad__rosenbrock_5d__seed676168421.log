def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    D = 0.1 * rng.rand(n) + 1e-8  # Initial step size
    mu = rng.uniform(ub - lb, size=n)
    x_best = mu.copy()
    f_best = func(mu)

    for _ in range(budget):
        y = mu + D * rng.randn(n)
        y = np.clip(y, lb, ub)  # Clip to bounds

        f_y = func(y)
        if f_y < f_best:
            x_best = y.copy()
            f_best = f_y

        sigma = 0.1
        s2 = (f_y - f_best) * (y - x_best).dot(y - x_best) / (n + 1)
        D += sigma * (np.eye(n) if s2 > 0 else -np.eye(n))

    return x_best
