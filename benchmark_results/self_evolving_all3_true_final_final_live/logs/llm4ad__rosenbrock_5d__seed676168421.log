def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget - 1):
        i = rng.choice(dim)
        x_try = x.copy()
        x_try[i] += rng.uniform(-0.5, 0.5)
        
        # Clip to bounds
        x_try = np.clip(x_try, lb, ub)
        
        f_try = func(x_try)
        
        if f_try < best_f:
            best_x = x_try
            best_f = f_try
            
        # Simple random search step
        for j in range(dim):
            if rng.random() < 0.1:
                x_try = x.copy()
                x_try[j] += rng.uniform(-0.5, 0.5)
                
                # Clip to bounds
                x_try = np.clip(x_try, lb, ub)
                
                f_try = func(x_try)
                
                if f_try < best_f:
                    best_x = x_try
                    best_f = f_try
                    
    return best_x
