def algorithm(func, dim, lb, ub, budget, rng):
    n_iter = 0
    X_init = (ub - lb) * rng.random((dim,)) + lb
    Y_init = func(X_init)
    X_best = X_init.copy()
    Y_best = np.min(Y_init)

    while n_iter < budget:
        # Bayesian Optimization step
        mean, var = bayesian_optimization(X_init, Y_init, func, 10, rng)
        x_new = sample_GP(mean, var, rng)
        
        # Local search step
        x_new = local_search(x_new, func, lb, ub, 0.01, rng)

        # Update best solution if necessary
        y_new = func(x_new)
        if y_new < Y_best:
            X_best = x_new.copy()
            Y_best = y_new

        # Update search space and iteration counter
        n_iter += 1
        X_init = np.vstack((X_init, x_new))
        Y_init = np.append(Y_init, y_new)

    return X_best
