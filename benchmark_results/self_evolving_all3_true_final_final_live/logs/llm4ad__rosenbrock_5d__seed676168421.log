def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    def generate_initial_population(pop_size, dim, lb, ub):
        return lb + (ub - lb) * rng.uniform(size=(pop_size, dim))

    def calculate_fitness(x):
        return func(clip(x))

    def simulated_annealing(population, pop_size, dim, lb, ub, budget, rng):
        temperature = 1
        for _ in range(budget // 2):
            for i in range(pop_size):
                candidate = clip(population[i] + rng.normal(size=dim) * temperature)
                if calculate_fitness(candidate) < calculate_fitness(population[i]):
                    population[i] = candidate
            temperature *= 0.95

    def differential_evolution(population, pop_size, dim, lb, ub, budget, rng):
        for _ in range(budget // 2):
            for i in range(1, pop_size):
                difference = (population[i-1] - population[0]) / np.linalg.norm(population[i-1] - population[0])
                candidate = clip(population[0] + difference * rng.normal(size=dim))
                if calculate_fitness(candidate) < calculate_fitness(population[0]):
                    population[0] = candidate

    population = generate_initial_population(100, dim, lb, ub)
    simulated_annealing(population, 100, dim, lb, ub, budget // 2, rng)
    differential_evolution(population, 100, dim, lb, ub, budget - (budget // 2), rng)

    best = population[np.argmin([calculate_fitness(x) for x in population])]

    return best
