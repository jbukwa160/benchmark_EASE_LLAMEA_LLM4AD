def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    x0 = (ub - lb) * rng.rand(dim) + lb
    current_best = evaluate(x0)
    best_x = x0

    T = 1.0
    alpha = 0.95
    beta = 0.01
    gamma = 10.0
    step_size = (ub - lb) / 2.0

    for _ in range(budget):
        # dynamic exploration of the search space using a probabilistic walk
        dx = (step_size * rng.randn(dim))

        x_new = best_x + dx
        f_new = evaluate(x_new)

        if f_new < current_best:
            current_best = f_new
            best_x = x_new

        # Simulated Annealing
        delta_f = f_new - current_best
        if delta_f > 0:
            T *= alpha
            if rng.rand() < np.exp(-delta_f / T):
                current_best = f_new
                best_x = x_new

        # reset temperature and step-size after some iterations
        if _ % int(budget * gamma) == 0:
            T = 1.0
            step_size /= beta

    return best_x
