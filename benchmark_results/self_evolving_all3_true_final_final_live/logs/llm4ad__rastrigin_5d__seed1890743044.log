def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x) + 1e-10  # Avoid log of zero in Simulated Annealing

    def simulated_annealing(x0, T, cooling_rate, num_iterations):
        x = x0
        for _ in range(num_iterations):
            delta = rng.uniform(-T, T, size=dim)
            new_x = x + delta
            new_x = clip(new_x)
            if evaluate(new_x) < evaluate(x):
                x = new_x
            else:
                prob = np.exp(-(evaluate(new_x) - evaluate(x)) / T)
                if rng.uniform(0, 1) < prob:
                    x = new_x
            T *= cooling_rate
        return x

    def differential_evolution(population_size, num_generations):
        population = rng.uniform(lb, ub, size=(population_size, dim))
        for _ in range(num_generations):
            differences = np.abs(population[:, np.newaxis] - population)
            targets = population[np.argmin(differences, axis=1)]
            offsets = rng.uniform(0, 1, size=(population_size, dim)) * (ub - lb)
            new_population = targets + offsets
            new_population = clip(new_population)
            population = new_population[np.argsort(evaluate(new_population))]
        return population[0]

    population_size = int(budget ** (1 / 2))
    num_generations_de = int(budget ** (1 / 3))
    T = ub - lb
    cooling_rate = 0.95
    num_iterations_sa = int(num_generations_de * budget)

    best_solution_de = differential_evolution(population_size, num_generations_de)
    best_solution_sa = simulated_annealing(best_solution_de, T, cooling_rate, num_iterations_sa)

    return clip(best_solution_sa)
