def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_candidate = -np.ones(dim)
    best_fitness = float('inf')
    current_candidate = np.zeros(dim)
    step_size = 1.0
    num_restarts = 10

    for _ in range(budget):
        if rng.rand() < 0.2:
            current_candidate = clip(rng.uniform(lb, ub, size=dim))
        else:
            current_candidate = clip(best_candidate + rng.normal(0, step_size, size=dim))

        fitness = func(current_candidate)
        if fitness < best_fitness:
            best_candidate = current_candidate
            best_fitness = fitness

        if rng.rand() < 0.1 and _ > num_restarts * budget // (num_restarts + 1):
            current_candidate = clip(rng.uniform(lb, ub, size=dim))
            step_size *= 0.9

    return best_candidate
