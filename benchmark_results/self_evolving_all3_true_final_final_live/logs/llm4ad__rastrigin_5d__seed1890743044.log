def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    pop_size = 50
    mutation_factor = 0.5
    crossover_probability = 0.9
    best_solution = -1e10 * np.ones(dim)
    best_fitness = float('inf')

    for _ in range(budget // (pop_size + 1)):
        population = rng.uniform(lb, ub, size=(pop_size, dim))
        for i in range(pop_size):
            if func(clip(population[i], lb, ub)) < best_fitness:
                best_solution = clip(population[i], lb, ub)
                best_fitness = func(best_solution)

        differential_pool = population[np.random.choice(pop_size, size=3, replace=False)]
        for i in range(pop_size):
            mutation = (differential_pool[0, :] - differential_pool[1, :]) + rng.uniform(-mutation_factor, mutation_factor) * (differential_pool[2, :] - differential_pool[1, :])
            mutated_solution = clip(differential_pool[i, :] + crossover_probability * mutation, lb, ub)
            if func(mutated_solution) < best_fitness:
                population[i] = mutated_solution
        population[np.random.choice(pop_size, size=3, replace=False)] = rng.uniform(lb, ub, size=(3, dim))

    return best_solution
