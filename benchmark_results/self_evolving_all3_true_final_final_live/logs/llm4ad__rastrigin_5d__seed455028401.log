def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def eval(x):
        x = clip(x)
        return func(x)

    def crossover(x1, x2, c):
        return 0.5 * (x1 + c * (x2 - x1))

    best_x = rng.uniform(lb, ub, size=dim)
    best_f = eval(best_x)

    for _ in range(budget):
        offspring = np.zeros((dim,))
        for i in range(dim):
            r1 = rng.uniform(0, 1)
            r2 = rng.uniform(0, 1)
            r3 = rng.uniform(-1, 1)
            x1 = best_x + r1 * (ub - lb) * rng.uniform(lb, ub, size=dim)
            x2 = best_x + r2 * (ub - lb) * rng.uniform(lb, ub, size=dim)
            offspring[i] = crossover(x1[i], x2[i], np.exp(-r3))
        offspring = clip(offspring)
        offspring_f = eval(offspring)

        if offspring_f < best_f:
            best_x = offspring
            best_f = offspring_f

    return best_x
