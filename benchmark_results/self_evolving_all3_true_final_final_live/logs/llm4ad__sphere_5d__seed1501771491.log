def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    pop = np.random.uniform(lb, ub, (pop_size, dim))
    best = func(pop)
    
    for i in range(budget):
        candidates = pop[np.argsort(best)]
        new_pop = np.zeros((pop_size, dim))
        
        for j in range(pop_size):
            idx = rng.randint(0, pop_size - 1)
            noise = rng.uniform(-1.0, 1.0) * 0.01
            if rng.random() < 0.2:
                new_pop[j] = candidates[(idx + j) % pop_size]
            else:
                new_pop[j] = np.clip(candidates[idx] + noise, lb, ub)
        
        new_best = func(new_pop)
        if np.any(new_best < best):
            best = new_best
            pop = new_pop
    
    return pop[np.argmin(best)]
