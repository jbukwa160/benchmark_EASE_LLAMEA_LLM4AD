def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget - 1):
        r = 2 / (1 + _ / budget) - 1
        new_x = x + r * rng.uniform(-1, 1, size=(1, dim))
        
        # Clip candidates to [lb, ub]
        clipped_new_x = np.clip(new_x, lb, ub)
        
        f = func(clipped_new_x)
        if f < best_f:
            best_f = f
            best_x = clipped_new_x.copy()
        
        x = new_x
    
    return best_x[0]
