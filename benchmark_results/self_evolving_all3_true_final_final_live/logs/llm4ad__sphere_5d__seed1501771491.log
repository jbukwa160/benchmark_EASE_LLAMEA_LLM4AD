def algorithm(func, dim, lb, ub, budget, rng):
    def func_candidate(x):
        x = np.clip(x, lb, ub)
        return func(x)

    initial_x = np.random.uniform(lb, ub, size=(1, dim))
    current_x = initial_x
    best_x = initial_x

    T = 1e6
    cooling_rate = 0.99

    for _ in range(budget):
        new_x = current_x + rng.normal(size=current_x.shape)
        delta_f = func_candidate(new_x) - func_candidate(current_x)

        if delta_f < 0:
            current_x = new_x
            best_x = new_x
            T *= cooling_rate
        else:
            p = np.exp(-delta_f / T)
            r = rng.uniform()
            if r > p:
                current_x = new_x

    return best_x
