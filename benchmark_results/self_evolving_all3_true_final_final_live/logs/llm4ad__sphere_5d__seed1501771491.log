def algorithm(func, dim, lb, ub, budget, rng):
    n = len(dim)
    x_best = np.zeros(n)
    f_best = float('inf')
    for i in range(budget):
        x_candidate = x_best + 0.1 * (ub - lb) * rng.randn(n)
        x_candidate = np.clip(x_candidate, lb, ub)
        f_candidate = func(x_candidate)
        if f_candidate < f_best:
            f_best = f_candidate
            x_best = x_candidate
    return x_best
