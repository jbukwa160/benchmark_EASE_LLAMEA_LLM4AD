def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    for _ in range(budget):
        x_new = x_best + (ub - lb) * rng.rand(dim)
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)
        if f_new < func(x_best):
            x_best = x_new
    return x_best
