def algorithm(func, dim, lb, ub, budget, rng):
    x0 = 5 * (ub - lb) + lb
    mu = 1e-6
    sigma0 = 1.
    sigma_min = 1e-10
    sigma_max = 100.
    lambda_ = 50.
    c_m = 2 / (dim + 3.2)
    c_c = 2 / ((dim + 1.2) ** 2)

    x = x0 + rng.normal(0, sigma0, size=(dim,))
    y = func(x)
    best_x = x.copy()
    best_y = y

    for i in range(budget):
        if np.random.rand() < c_m:
            z = rng.normal(0, 1, size=(dim,))
            x += z * mu
        elif np.random.rand() < c_c:
            g = (x - best_x) / sigma_max
            h = rng.normal(0, 1, size=(dim,))
            x += g * np.exp(c_c * sigma_min ** 2) * h

        x = np.clip(x, lb, ub)
        y = func(x)

        if y < best_y:
            best_x = x.copy()
            best_y = y

    return best_x
