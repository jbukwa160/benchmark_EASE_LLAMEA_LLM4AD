def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    for _ in range(budget):
        if rng.uniform(0, 1) < 0.5:
            # Local search: choose a random neighbor of the current best
            x_new = x_best + rng.uniform(-2, 2, size=dim)
            x_new = np.clip(x_new, lb, ub)
            f_new = func(x_new)
            if f_new < func(x_best):
                x_best = x_new
        else:
            # Global search: choose a random point in the domain
            x_new = rng.uniform(lb, ub, size=dim)
            f_new = func(x_new)
            if f_new < func(x_best):
                x_best = x_new
    return x_best
