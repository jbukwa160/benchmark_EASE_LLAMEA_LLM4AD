def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def simulated_annealing(x0, T, func, dim, rng, budget):
        current_solution = x0
        best_solution = x0
        for i in range(budget):
            new_solution = current_solution + 0.1 * (rng.randn(dim) - 0.5)
            new_solution = clip(new_solution)
            if func(new_solution) < func(current_solution):
                current_solution = new_solution
                best_solution = new_solution
            else:
                p = np.exp(-(func(new_solution) - func(current_solution)) / T)
                if rng.rand() < p:
                    current_solution = new_solution
        return best_solution

    def differential_evolution(population, budget, func, dim, rng):
        for i in range(budget):
            offspring_population = population.copy()
            for j in range(len(offspring_population)):
                indices = np.random.choice(len(offspring_population), 3, replace=False)
                mutant_vector = clip(offspring_population[indices] + 0.5 * (rng.randn(dim) - 0.5))
                trial_solution = offspring_population[j] + 0.1 * (mutant_vector - offspring_population[j])
                if func(clip(trial_solution)) < func(offspring_population[j]):
                    offspring_population[j] = clip(trial_solution)
            population = offspring_population
        return population

    x0 = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    T = 1000
    population_size = int(np.sqrt(budget))
    population = [np.array([np.random.uniform(lb, ub) for _ in range(dim)]) for _ in range(population_size)]

    for i in range(budget):
        new_population = differential_evolution(population, budget // population_size, func, dim, rng)
        best_solution = np.min(new_population, axis=0)
        solution = simulated_annealing(best_solution, T - (i % 100), func, dim, rng, budget // population_size)
        population = new_population
    return solution
