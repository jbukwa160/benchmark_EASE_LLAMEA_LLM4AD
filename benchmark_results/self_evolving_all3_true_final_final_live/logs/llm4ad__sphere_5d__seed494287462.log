def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(best_x)
    radius = 1.0
    iterations = 0

    while iterations < budget:
        for _ in range(dim):
            new_x = clip(x + rng.uniform(-radius, radius, size=(dim,)), lb, ub)
            new_f = func(new_x)

            if new_f < best_f:
                best_f = new_f
                best_x = new_x

            delta = new_f - best_f
            if delta > 0 and iterations > budget // dim * 2:
                radius /= np.sqrt(np.abs(delta) + 1e-10)
        x = best_x.copy()
        iterations += 1

    return best_x
