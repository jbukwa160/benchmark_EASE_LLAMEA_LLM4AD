def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        dir = np.random.uniform(-1, 1, size=dim)
        x_candidate = x_best + 0.01 * dir
        f_candidate = func(np.clip(x_candidate, lb, ub))
        
        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate

    return np.clip(x_best, lb, ub)
