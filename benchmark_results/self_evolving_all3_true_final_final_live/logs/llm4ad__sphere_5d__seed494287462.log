def algorithm(func, dim, lb, ub, budget, rng):
    n = len(rng)
    mu = 0.5 * (ub + lb) * np.ones(dim)
    sigma = (ub - lb) / 3.0
    cov = np.eye(dim) * (ub - lb)**2 / 10.0
    pc = np.zeros(dim)

    for i in range(budget):
        new_candidate = mu + rng.normal(size=dim) * sigma
        new_candidate = np.clip(new_candidate, lb, ub)
        
        f_new = func(new_candidate)
        f_old = func(mu)
        
        if f_new < f_old:
            mu = new_candidate
            pc = new_candidate - mu
        
        cov += (new_candidate - mu).reshape(-1, 1) @ (new_candidate - mu).reshape(1, -1)
        
    return np.clip(mu, lb, ub)
