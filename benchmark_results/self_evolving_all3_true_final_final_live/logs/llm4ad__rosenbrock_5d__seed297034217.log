def algorithm(func, dim, lb, ub, budget, rng):
    def bounds(x):
        return np.clip(x, lb, ub)

    def crossover(parent1, parent2):
        alpha = 0.5 * (parent1 + parent2)
        beta = 0.5 * (parent1 - parent2)
        child = alpha + beta * special.erf(rng.uniform(-1, 1))
        return child

    def mutation(x):
        step_size = rng.uniform(0, 0.01)
        x += step_size * rng.normal(size=dim)
        return bounds(x)

    population_size = int(budget / (2 * dim + 1))
    population = np.random.uniform(lb, ub, size=(population_size, dim))

    for _ in range(int(budget)):
        fitness = [func(bounds(x)) for x in population]
        parents = np.argsort(fitness)[:int(population_size / 2)]
        offspring = []
        for i in range(0, int(population_size / 2), 2):
            parent1, parent2 = population[parents[i]], population[parents[i + 1]]
            child = crossover(parent1, parent2)
            offspring.append(child)
        population = np.array(offspring + [bounds(mutation(x)) for x in population])
    best_solution = bounds(population[np.argmin(fitness)])
    return best_solution
