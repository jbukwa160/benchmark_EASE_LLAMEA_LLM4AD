def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_fval = func(x)

    de_params = {
        'c1': 0.5,
        'c2': 0.3,
        'm': 10
    }

    sa_params = {
        'T': 1000,
        'alpha': 0.99
    }

    for i in range(budget):
        # Differential Evolution (DE) phase
        for j in range(dim):
            z = best_x.copy()
            idx = rng.choice(range(dim))
            z[idx] += rng.uniform(-1, 1)
            z[j] += rng.uniform(-1, 1)
            z[j] = np.clip(z[j], lb, ub)
            fval = func(z)

            if fval < best_fval:
                best_x = z.copy()
                best_fval = fval

        # Simulated Annealing (SA) phase
        T = sa_params['T']
        alpha = sa_params['alpha']

        for j in range(dim):
            z = best_x.copy()
            idx = rng.choice(range(dim))
            z[idx] += np.sqrt(T) * rng.normal(0, 1)
            z[j] += np.sqrt(T) * rng.normal(0, 1)
            z[j] = np.clip(z[j], lb, ub)

            fval = func(z)

            if fval < best_fval:
                best_x = z.copy()
                best_fval = fval

        T *= alpha
        if T < 1e-3: break

    return best_x
