def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=(1, dim))
    f_best = func(x_best)
    
    for _ in range(budget):
        x_cand = np.copy(x_best)
        
        for i in range(dim):
            mask = np.ones((dim,)) == i
            x_parent1 = rng.choice([x_best, x_cand], size=2)[0]
            x_parent2 = rng.choice([x_best, x_cand], size=2)[mask][0]
            
            if rng.random() < 0.5:
                x_cand[i] += 0.5 * (ub - lb) * np.sin(rng.uniform(-np.pi, np.pi))
            else:
                x_cand[i] = 0.9 * x_parent1[i] + 0.1 * x_parent2[i]
            
            if rng.random() < 0.1:
                x_cand[i] += (ub - lb) * rng.normal(0, 1)
        
        f_cand = func(np.clip(x_cand, lb, ub))
        
        if f_cand < f_best:
            x_best = np.copy(x_cand)
            f_best = f_cand
    
    return x_best
