def algorithm(func, dim, lb, ub, budget, rng):
    x_best = (np.random.uniform(lb, ub, size=(1, dim)))[0]
    f_best = func(x_best)
    for _ in range(budget):
        x_candidate = (np.random.uniform(lb, ub, size=(1, dim)))[0]
        f_candidate = func(x_candidate)
        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate
    return np.clip(x_best, lb, ub)
