def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def f(x):
        x = clip(x)
        return func(x)

    D = 1.0 / (ub - lb)**2
    c = 3 / np.sqrt(2 * dim + 1)
    F = 0.5

    pop_size = 50
    x = rng.uniform(lb, ub, size=(pop_size, dim))

    for _ in range(budget):
        y = np.copy(x)
        for i in range(pop_size):
            idx1, idx2, idx3 = rng.randint(0, pop_size, size=3), idx1, idx2
            while idx1 == idx2 or idx1 == idx3:
                idx1, idx2, idx3 = rng.randint(0, pop_size, size=3)
            u = rng.uniform(lb, ub, size=(dim,))
            v = rng.uniform(-D, D, size=(dim,))
            y[i] = clip(x[idx1] + c * (x[idx2] - x[idx3]) + F * u + v)

        x = np.where(rng.rand(pop_size, dim) < 0.5, x, y)
    return x[np.argmin([f(_) for _ in x])]
