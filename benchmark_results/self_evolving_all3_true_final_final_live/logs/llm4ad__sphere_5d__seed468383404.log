def algorithm(func, dim, lb, ub, budget, rng):
    best = np.random.uniform(lb, ub, size=dim)
    for _ in range(budget):
        candidate = np.clip(np.random.uniform(lb, ub, size=dim), a_min=lb, a_max=ub)
        value = func(candidate)
        if value < func(best):
            best = candidate
    return best
