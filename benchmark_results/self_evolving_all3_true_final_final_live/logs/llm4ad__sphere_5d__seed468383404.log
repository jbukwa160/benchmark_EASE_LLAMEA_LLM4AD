def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, a_min=lb, a_max=ub)

    def generate_initial_population(dim, bounds, rng):
        population = np.zeros((budget, dim))
        for i in range(budget):
            for j in range(dim):
                population[i, j] = random.uniform(bounds[0], bounds[1])
        return population

    def differential_evolution(population, func, dim, lb, ub, budget, rng):
        new_population = np.zeros((budget, dim))
        for i in range(budget):
            r1, r2, r3 = rng.sample(range(1, budget), 3)
            while r1 == r2 or r2 == r3 or r1 == r3:
                r1, r2, r3 = rng.sample(range(1, budget), 3)
            mutant = clip(population[r1] + 0.5 * (population[r2] - population[r3]), lb, ub)
            new_population[i] = mutant
        return np.sort(new_population, axis=0)

    def adaptive_clustering_selection(population, func, dim, lb, ub, budget):
        clusters = []
        for i in range(budget):
            cluster = [j for j in range(budget) if np.linalg.norm(population[i] - population[j]) < 1e-6]
            clusters.append(cluster)
        selected_indices = []
        for cluster in clusters:
            best_index = np.argmin([func(clip(x, lb, ub)) for x in [population[i] for i in cluster]])
            selected_indices.extend(cluster[best_index:])
        return selected_indices

    def adaptive_mutation(population, func, dim, lb, ub, budget):
        mutation_factors = np.random.uniform(-1, 1, size=budget)
        mutated_population = population + mutation_factors
        return clip(mutated_population, lb, ub)

    population = generate_initial_population(dim, (lb, ub), rng)
    best_solution = None

    for _ in range(budget):
        new_population = differential_evolution(population, func, dim, lb, ub, budget, rng)
        selected_indices = adaptive_clustering_selection(new_population, func, dim, lb, ub, budget)
        new_population = [new_population[i] for i in selected_indices]
        population = np.array(new_population)
        best_solution = min([min(func(clip(x, lb, ub)) for x in cluster) if len(cluster) > 1 else float('inf') for cluster in adaptive_clustering_selection(population, func, dim, lb, ub, budget)], key=lambda x: x)

    return population[np.argmin([func(clip(x, lb, ub)) for x in population])]
