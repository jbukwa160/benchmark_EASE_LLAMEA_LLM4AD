def algorithm(func, dim, lb, ub, budget, rng):
    n = 0
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    while n < budget:
        x = rng.uniform(lb, ub, size=dim)
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
        
        step_size = 1 / (n + 1) ** 0.5
        noise = rng.normal(0, 0.1, size=dim)
        candidate = best_x - step_size * np.gradient(func(best_x), axis=0) + noise
        
        clipped_candidate = np.clip(candidate, lb, ub)
        f_candidate = func(clipped_candidate)
        
        if f_candidate < best_f:
            best_f = f_candidate
            best_x = clipped_candidate
        
        n += 1
    
    return best_x
