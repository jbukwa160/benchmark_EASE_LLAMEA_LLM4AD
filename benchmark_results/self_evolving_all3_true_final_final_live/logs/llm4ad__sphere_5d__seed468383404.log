def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    
    for _ in range(budget):
        y = best_x + (ub - lb) * np.random.uniform(-1, 1, size=dim)
        y = np.clip(y, lb, ub)
        
        fx = func(y)
        fbest = func(best_x)
        
        if fx < fbest:
            best_x = y.copy()
    
    return best_x
