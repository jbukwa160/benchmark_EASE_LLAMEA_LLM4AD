def algorithm(func, dim, lb, ub, budget, rng):
    candidate = np.random.uniform(lb, ub, size=dim)
    best_candidate = candidate.copy()
    min_value = func(candidate)

    for _ in range(budget):
        gradient = 2 * (candidate - (lb + ub) / 2)
        next_candidate = candidate + rng.normal(loc=0, scale=np.finfo(float).eps, size=dim)
        next_candidate = np.clip(next_candidate, lb, ub)
        
        if func(next_candidate) < min_value:
            candidate = next_candidate
            best_candidate = next_candidate.copy()
            min_value = func(best_candidate)

    return best_candidate
