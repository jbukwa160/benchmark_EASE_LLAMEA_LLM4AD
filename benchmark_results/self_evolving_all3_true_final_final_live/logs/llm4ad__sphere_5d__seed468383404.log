def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        dir = (ub - lb) * rng.randn(dim) 
        step_size = np.sqrt((ub - lb)**2 / dim)
        
        new_x = x + step_size * dir
        
        # Clip candidates to [lb, ub]
        new_x = np.clip(new_x, lb, ub)
        
        f_new = func(new_x)
        
        if f_new < best_f:
            best_f = f_new
            best_x = new_x.copy()
            
        x = new_x.copy()
    
    return best_x
