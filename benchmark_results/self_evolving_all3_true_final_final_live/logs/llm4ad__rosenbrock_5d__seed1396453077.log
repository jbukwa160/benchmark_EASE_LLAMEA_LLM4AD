def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    D = len(dim)
    pop_size = 50
    Pop = rng.uniform(size=(pop_size, D))
    for _ in range(budget):
        X = clip(Pop)
        fit = func(X)
        idx = np.argsort(fit)[:pop_size//2]
        Pop[idx] = Pop[idx]/np.linalg.norm(Pop[idx], axis=1)[:, None]**(D-1)*rng.uniform(size=(len(idx), D))
    idx = np.argmin(func(clip(Pop)))
    return clip(Pop[idx])
