def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x), x

    def rand(lb, ub, dim):
        return lb + (ub - lb) * rng.rand(dim)

    pop_size = 20
    pop = [rand(lb, ub, dim) for _ in range(pop_size)]
    best_x = np.array([1]*dim)
    best_f = float('inf')

    for t in range(budget):
        if t % 10 == 0:
            print(f'Iteration {t+1} of {budget}')

        f_values = [evaluate(x)[0] for x in pop]
        best_pop_idx = np.argmin(f_values)

        if f_values[best_pop_idx] < best_f:
            best_x = pop[best_pop_idx].copy()
            best_f = f_values[best_pop_idx]

        new_pop = []
        while len(new_pop) < pop_size:
            idx1, idx2, idx3 = rng.choice(pop_size, 3, replace=False)
            x1, x2, x3 = pop[idx1], pop[idx2], pop[idx3]
            v = (x1 + x2 + x3) / 3 + 0.5 * (x1 - x2) * rng.randn(dim)

            new_pop.append(clip(v))

        pop = new_pop

    return best_x
