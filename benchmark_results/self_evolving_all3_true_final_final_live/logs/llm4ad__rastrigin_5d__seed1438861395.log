def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    max_iter = budget // pop_size
    c1, c2 = 0.5, 0.3
    f = lambda x: func(x)
    bounds = [(lb, ub) for _ in range(dim)]

    def de_step(pop):
        v = np.random.uniform(-0.01, 0.01, size=(pop_size, dim))
        pop_new = pop + v
        for i in range(pop_size):
            if rng.random() < c1:
                j = rng.choice(range(pop_size), replace=False)
                pop_new[i] += pop[j]
            elif rng.random() < c2:
                j = rng.choice(range(pop_size), replace=False)
                k = rng.choice(range(pop_size), replace=False)
                pop_new[i] += 0.5 * (pop[j] + pop[k])
        return np.clip(pop_new, *bounds)

    def ps_step(pop):
        for i in range(pop_size):
            j = rng.choice(range(pop_size), replace=False)
            k = rng.choice(range(pop_size), replace=False)
            if rng.random() < c1:
                pop[i] += (pop[j] - pop[k]) + np.random.uniform(-0.01, 0.01, size=dim)
            elif rng.random() < c2:
                pop[i] += (pop[j] - pop[k]) + np.random.uniform(-0.01, 0.01, size=dim)
        return np.clip(pop, *bounds)

    pop = np.random.uniform(lb, ub, size=(pop_size, dim))
    for _ in range(max_iter):
        pop_new = de_step(pop)
        f_values = np.array([f(x) for x in pop_new])
        idx_best = np.argmin(f_values)
        if rng.random() < 0.5:
            pop = pop_new
        else:
            pop[idx_best] = pop_new[idx_best]
    return pop[np.argmin(np.array([f(x) for x in pop]))]
