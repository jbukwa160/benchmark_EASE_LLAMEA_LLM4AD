def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    for i in range(budget):
        x_cand = lb + (ub - lb) * rng.rand(dim)
        f_cand = func(x_cand)
        if f_cand < x_best.sum():
            x_best = x_cand
    return x_best
