def algorithm(func, dim, lb, ub, budget, rng):
    def clipped_bounds(x):
        return [min(max(i, lb), ub) for i in x]

    n = len(lb)
    init_size = 100
    step_size = 0.5
    sigma = 1.0
    pop_size = int(budget / (n * dim))
    
    x0 = rng.uniform(size=(init_size, dim)) * 2 - 1
    
    def objfun(x):
        return func(clipped_bounds(x))

    res = minimize(objfun, clipped_bounds(np.mean(x0, axis=0)), method="SLSQP", bounds=[(lb, ub)]*n)
    
    for _ in range(pop_size):
        x = np.clip(rng.normal(loc=res.x, scale=sigma, size=(dim,))*2-1, a_min=lb, a_max=ub)
        
        # Selection
        if objfun(x) < func(res.x):
            res = minimize(objfun, clipped_bounds(x), method="SLSQP", bounds=[(lb, ub)]*n)

    return res.x
