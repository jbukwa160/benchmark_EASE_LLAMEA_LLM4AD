def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(dim,))
    y = func(x)
    population = [x]
    archive = [x]
    while len(population) < budget:
        offspring = []
        for _ in range(budget // 2 - len(archive)):
            parent1, parent2 = rng.choice(archive, size=2, replace=False)
            child = mutation(parent1, ub, rng=rng)
            child = crossover(child, parent2, rng=rng)
            offspring.append(child)
        population += archive + offspring
        for x in population:
            y = func(x)
            if y < np.min([func(z) for z in population]):
                archive = [x]
            elif np.random.rand() < 0.1:
                archive.append(x)
        population.sort(key=lambda x: func(x))
    return np.min([func(x) for x in population], axis=0)
