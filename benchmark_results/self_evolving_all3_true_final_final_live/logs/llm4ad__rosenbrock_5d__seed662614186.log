def algorithm(func, dim, lb, ub, budget, rng):
    def grad(x):
        g = np.zeros(dim)
        for i in range(dim - 1):
            g[i] += 400 * (x[i + 1] - x[i]**2) * (-2*x[i])
            g[i + 1] += 200 * (x[i + 1] - x[i]**2)
            g[i] += 2 * (1 - x[i])
        return g

    mu = np.random.uniform(lb, ub, size=dim)
    sigma = 0.5
    lambda_ = 50
    p = 1.0
    c1 = 0.5
    c2 = 2.0
    d = dim
    m = int(lambda_ / (d + 1))
    w = np.random.uniform(0, 1, size=lambda_)
    x_mean = mu.copy()
    x_dev = sigma * rng.randn(dim)
    f_min = func(x_mean)

    for i in range(budget):
        x = x_mean + np.dot(np.sqrt(w), x_dev)
        x = np.clip(x, lb, ub)

        f_x = func(x)
        g_x = grad(x)

        f_x_mean = func(x_mean)

        if f_x < f_x_mean:
            x_mean = x
            f_min = f_x

        rank = np.argsort(w)[-m:]
        w[rank] = (1 - c1) * w[rank] + c1 * rng.uniform(0, 1, size=m)
        x_dev = x_dev + np.dot(np.sqrt(w), g_x)

    return x_mean
