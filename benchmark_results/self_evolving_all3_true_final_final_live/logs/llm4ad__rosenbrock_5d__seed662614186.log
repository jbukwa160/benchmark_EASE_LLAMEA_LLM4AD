def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    N = 50  # number of particles
    D = dim  # dimensionality
    pop_size = 100  # population size
    max_iter = budget // (D * pop_size)  # maximum iterations

    x_best = np.random.uniform(lb, ub, size=(pop_size, D))
    f_best = [evaluate(x) for x in x_best]
    x_best[np.argmin(f_best)] = clip(np.zeros(D))

    for _ in range(max_iter):
        for i in range(pop_size):
            v1 = rng.uniform(0.5, 1.5)
            v2 = rng.uniform(-4, -3)
            p = np.random.choice(range(N), size=D, replace=True)
            x_new = clip(x_best[p] + v1 * (x_best[i] - x_best[p]) + v2 * (rng.rand(D) - 0.5))

            f_new = evaluate(x_new)

            if f_new < f_best[i]:
                f_best[i] = f_new
                x_best[i] = x_new

    return clip(np.array([np.min(f_best)]))
