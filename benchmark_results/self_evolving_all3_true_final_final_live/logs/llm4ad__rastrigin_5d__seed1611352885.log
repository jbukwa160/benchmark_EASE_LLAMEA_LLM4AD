def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    elite_size = int(pop_size * 0.2)
    sigma_max = 5.0
    sigma_min = 1e-6
    alpha = 0.99
    T = 1000.0

    def mutate(x, sigma):
        return x + rng.normal(0, sigma, size=dim)

    def adaptive_sigma(population, best_so_far, sigma_max, sigma_min, alpha):
        std_devs = np.std([ind for ind in population if not np.all(ind == best_so_far)], axis=0)
        max_std_dev = np.max(std_devs)
        return min(max(alpha * max_std_dev + (1 - alpha) * best_so_far[None, :], sigma_min), sigma_max)

    def ga_step(population):
        next_generation = []
        for _ in range(elite_size):
            next_generation.append(np.copy(best))
        while len(next_generation) < pop_size:
            parent1_idx, parent2_idx = rng.choice(range(len(population)), size=2, replace=False)
            child = (population[parent1_idx] + population[parent2_idx]) / 2
            if func(mutate(child, adaptive_sigma(population, best, sigma_max, sigma_min, alpha))) < func(best):
                next_generation.append(np.copy(child))
        return np.array(next_generation)

    def sa_step(x):
        new_x = mutate(x, T)
        if rng.random() < np.exp(-(func(new_x) - func(x)) / (T + 1)):
            return new_x
        else:
            return x

    population = lb + (ub - lb) * rng.rand(pop_size, dim)
    best = np.copy(np.argmax([func(ind) for ind in population]))
    T *= alpha

    while budget > 0 and not np.all(population == ub):
        for _ in range(pop_size):
            if func(sa_step(population[i])) < func(best):
                best = np.copy(i)
        population = ga_step(population)

        # Clip candidates to [lb, ub]
        population = np.clip(population, lb, ub)
        budget -= 1

    return np.array([best])
