def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)
    
    while budget > 0:
        intervals = 2 ** int(np.log((ub - lb) * dim / rng) / np.log(2)) + 1
        step = (ub - lb) / (intervals - 1)
        
        for i in range(intervals):
            for j in range(i, intervals):
                x1 = clip(lb + i * step)
                x2 = clip(lb + j * step)
                
                if np.any(x1 == x2):
                    continue
                
                x_mid = (x1 + x2) / 2
                f_mid = func(clip(x_mid))
                
                if f_mid < best_f:
                    best_f = f_mid
                    best_x = x_mid.copy()
                    
            for k in range(dim):
                x1 = clip(lb + i * step)
                x2 = x[k]
                
                if np.any(x1 == x2):
                    continue
                
                x[k] = (x1 + x2) / 2
                f = func(clip(x))
                
                if f < best_f:
                    best_f = f
                    best_x = x.copy()
                    
        budget -= 1
        
    return best_x
