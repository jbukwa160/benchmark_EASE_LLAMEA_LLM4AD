def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def rastrigin(x):
        return 10*dim + np.sum(x**2 - 10*np.cos(2*np.pi*x))

    x = rng.uniform(lb, ub, size=(dim,))
    best_x = clip(x)
    best_f = func(best_x)

    for i in range(budget-1):
        v = rng.normal(size=(dim,))
        u = rng.uniform(0, 1, size=(dim,))
        trial_x = clip(best_x + u*(best_x - x) + v)

        if rastrigin(trial_x) < best_f:
            best_x = trial_x
            best_f = rastrigin(best_x)

    return best_x
