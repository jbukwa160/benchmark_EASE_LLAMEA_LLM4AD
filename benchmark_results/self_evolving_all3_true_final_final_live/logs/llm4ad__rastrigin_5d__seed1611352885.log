def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(current_solution, rng):
        candidate = current_solution + 0.1 * (ub - lb) * rng.rand(dim)
        return np.clip(candidate, lb, ub)

    def acceptance_probability(current_fitness, new_fitness, temperature):
        if current_fitness < new_fitness:
            return 1
        else:
            return np.exp((new_fitness - current_fitness) / temperature)

    def differential_evolution_step(current_solution, population, func, dim, lb, ub):
        n = len(population)
        min_dist = float('inf')
        for i in range(n):
            if i != 0 and np.linalg.norm(population[i] - current_solution) < min_dist:
                min_dist = np.linalg.norm(population[i] - current_solution)
                best_index = i
        candidate = population[best_index] + 0.5 * (ub - lb) * rng.rand(dim)
        new_solution = np.clip(candidate, lb, ub)
        return new_solution

    def simulated_annealing_step(current_solution, temperature, func, dim, lb, ub):
        candidate = generate_candidate(current_solution, rng)
        current_fitness = func(current_solution)
        new_fitness = func(candidate)
        if new_fitness < current_fitness:
            return candidate
        else:
            probability = acceptance_probability(current_fitness, new_fitness, temperature)
            if rng.rand() < probability:
                return candidate
            else:
                return current_solution

    population_size = 50
    initial_population = (ub - lb) * rng.rand(population_size, dim) + lb
    best_solution = initial_population[0]
    best_fitness = func(initial_population[0])

    for _ in range(budget):
        if rng.rand() < 0.5:
            population = initial_population.copy()
            for i in range(population_size):
                new_solution = differential_evolution_step(best_solution, population, func, dim, lb, ub)
                population[i] = new_solution
            best_solution = np.argmax([func(sol) for sol in population])
        else:
            temperature = 1000 / (_ + 1)
            current_solution = generate_candidate(best_solution, rng)
            best_solution = simulated_annealing_step(current_solution, temperature, func, dim, lb, ub)

    return best_solution
