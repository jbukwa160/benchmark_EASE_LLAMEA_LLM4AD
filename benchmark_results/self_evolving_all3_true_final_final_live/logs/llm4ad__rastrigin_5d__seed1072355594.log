def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(x1, x2, F):
        v = x2 + F * (x2 - x1)
        return np.clip(v, lb, ub)

    def crossover(x1, x2, CR):
        r = rng.rand(dim)
        u = x1.copy()
        for i in range(dim):
            if r[i] < CR or np.random.rand() < 0.01:
                u[i] = mutate(x1, x2, F)[i]
        return u

    def fitness(x):
        return func(x)

    def selection(pop, fpop):
        idx = np.argsort(fpop)
        return pop[idx[:int(0.5 * len(pop))]]

    best_x = None
    best_f = float('inf')

    x = rng.uniform(lb, ub, (1, dim))
    for _ in range(budget):
        F = 0.9 / (2 + np.exp(-0.5 * (_ / budget)))
        CR = 0.4 / (1 + np.exp(-0.01 * _))

        x_new = [crossover(x[0], mutate(x[i-1], x[i+1], F), CR) for i in range(len(x))]
        f_new = [fitness(xi) for xi in x_new]

        x.append(np.array(x[-1]))
        fpop = np.array(f_new + [-best_f])
        pop = np.array([x[-2]] + x_new)

        best_idx = np.argmin(fpop)
        if fpop[best_idx] < best_f:
            best_x = pop[best_idx]
            best_f = fpop[best_idx]

    return best_x
