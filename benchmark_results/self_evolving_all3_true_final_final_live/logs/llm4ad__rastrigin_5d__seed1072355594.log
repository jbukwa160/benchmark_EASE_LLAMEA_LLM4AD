def algorithm(func, dim, lb, ub, budget, rng):
    D = 1e-3 * (ub - lb)**2  # Initial covariance matrix diagonal
    sigma = 0.5 * (ub - lb)  # Initial step size
    x = np.random.uniform(lb, ub, size=dim)
    f_best = func(x)

    for _ in range(budget):
        for i in range(dim):
            x_new = x.copy()
            x_new[i] += rng.normal(0, sigma)
            if lb <= x_new[i] <= ub:
                fx_new = func(x_new)
                accept_prob = np.exp(-((fx_new - f_best) / D))
                u = rng.uniform(0, 1)
                if u < accept_prob or i == dim-1:
                    x = x_new
                    f_best = fx_new

        for i in range(dim):
            z = np.zeros(dim)
            z[i] = 1
            y = np.dot(np.linalg.cholesky(D), z) + rng.normal(0, sigma)
            x_new = x + y
            if lb <= x_new[i] <= ub:
                fx_new = func(x_new)
                f_best = min(fx_new, f_best)

        D *= 1 - 1/(budget+1)  # Adapt covariance matrix

    return x
