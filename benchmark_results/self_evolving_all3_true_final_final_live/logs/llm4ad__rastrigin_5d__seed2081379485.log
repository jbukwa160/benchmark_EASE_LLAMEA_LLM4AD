def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    bounds = [(lb, ub) for _ in range(dim)]
    res = minimize(objective, 0.5 * (ub + lb), method="SLSQP", bounds=bounds)
    best_x = np.clip(res.x, lb, ub)
    return best_x
