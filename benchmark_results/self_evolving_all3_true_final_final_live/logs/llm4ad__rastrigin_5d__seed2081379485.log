def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(pop_size, dim):
        initial_pop = np.random.normal(size=(pop_size, dim))
        for i in range(pop_size):
            initial_pop[i] = clip(initial_pop[i])
        return initial_pop

    def calculate_objective_function(population):
        scores = func(population)
        return scores

    def update_mean(mean, population, weights):
        new_mean = np.average(population, axis=0, weights=weights)
        return clip(new_mean)

    def update_covariance_matrix(mean, population, weights):
        centered_population = population - mean
        cov = np.dot(centered_population.T, centered_population) / (len(population) - 1)
        return cov

    def select_parents(population, scores):
        indices = np.argsort(scores)[:int(len(scores)/2)]
        parents = population[indices]
        return parents

    def evolve(parents):
        mean = clip(np.mean(parents, axis=0))
        cov = update_covariance_matrix(mean, parents, None)
        new_mean = mean + np.linalg.cholesky(cov) * rng.normal(size=dim)

        offspring_population = np.concatenate((parents, [new_mean]))

        return offspring_population

    def restart(budget, population):
        if budget < 0:
            best_candidate = np.argmin(population)
            return population[best_candidate]
        else:
            budget -= 1
            return evolve(population)

    pop_size = int(np.sqrt(dim) * 10)
    initial_pop = generate_initial_population(pop_size, dim)
    for i in range(budget):
        scores = calculate_objective_function(initial_pop)
        parents = select_parents(initial_pop, scores)
        new_pop = evolve(parents)
        best_candidate = np.argmin(calculate_objective_function(new_pop))
        initial_pop[best_candidate] = clip(new_pop[best_candidate])

    return clip(np.min(calculate_objective_function(initial_pop)))
