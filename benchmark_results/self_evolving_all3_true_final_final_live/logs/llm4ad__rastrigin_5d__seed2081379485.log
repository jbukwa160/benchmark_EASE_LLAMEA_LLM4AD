def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(clip(x_best))
    T = 100.0
    cooling_rate = 1 / (budget * (10 ** -6))

    for i in range(budget):
        if budget - i <= 100:
            T *= np.exp(-cooling_rate * (budget - i))
        
        x_diff = rng.uniform(lb, ub, size=dim)
        y = clip(x_best + 0.5 * T * x_diff)

        f_y = func(y)
        acceptance_prob = np.exp((f_best - f_y) / T)
        if f_y < f_best or rng.random() < acceptance_prob:
            x_best = y
            f_best = f_y

    return clip(x_best)
