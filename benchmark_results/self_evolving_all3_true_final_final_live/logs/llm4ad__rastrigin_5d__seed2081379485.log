def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    x = 0.1 * (ub - lb) + lb
    sigma = 10 / (dim ** 2)
    c1, c_mu = 1, 1.0 / np.sqrt(dim)
    mu, cnt, best_x, best_f = rng.rand(dim), 1, x.copy(), f(x)

    for t in range(budget):
        y = rng.randn(dim) + x
        y = lb + (ub - lb) * y
        f_y = f(y)
        if f_y < best_f:
            best_f, best_x = f_y, y

        delta = (y - x) / sigma
        rho = 1.0 / dim
        c_cov = np.exp(-cnt * rho)

        mu += c1 * delta
        cov = c_mu * (delta @ mu)
        for i in range(dim):
            if rng.rand() < 0.5:
                mu[i] -= cov[i]
            else:
                mu[i] += cov[i]

        x += mu
        cnt += 1

    return best_x
