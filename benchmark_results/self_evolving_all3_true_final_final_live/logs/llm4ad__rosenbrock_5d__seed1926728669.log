def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    sigma_min = 0.1
    sigma_max = 10.0
    T_max = 10000
    cooling_rate = 0.99
    T = T_max

    x = np.random.uniform(lb, ub, (pop_size, dim))
    while True:
        # Simulated Annealing phase
        for i in range(pop_size):
            y = x[i] + rng.normal(0, sigma_min)
            y_clipped = np.clip(y, lb, ub)
            f_y = func(y_clipped)
            if f_y < func(x[i]):
                x[i] = y_clipped

        # Differential Evolution phase
        for i in range(pop_size):
            idx1, idx2, idx3 = rng.choice(range(pop_size), 3, replace=False)
            v = (x[idx1] + x[idx2]) / 2.0
            delta = np.random.uniform(-sigma_max, sigma_max, dim)
            new_x = v + delta
            new_x_clipped = np.clip(new_x, lb, ub)
            f_new_x = func(new_x_clipped)
            if f_new_x < func(x[i]):
                x[i] = new_x_clipped

        # Update temperature and sigma
        T *= cooling_rate
        if T < 1e-6:
            break

        # Evolutionary phase
        for i in range(pop_size):
            idx1, idx2, idx3 = rng.choice(range(pop_size), 3, replace=False)
            v = (x[idx1] + x[idx2]) / 2.0
            delta = np.random.uniform(-sigma_max, sigma_max, dim) * T
            new_x = v + delta
            new_x_clipped = np.clip(new_x, lb, ub)
            f_new_x = func(new_x_clipped)
            if f_new_x < func(x[i]):
                x[i] = new_x_clipped

        # Reduce sigma
        sigma_min *= 0.9

    best_idx = np.argmin([func(x_i) for x_i in x])
    return x[best_idx]
