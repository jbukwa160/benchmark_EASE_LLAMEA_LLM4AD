def algorithm(func, dim, lb, ub, budget, rng):
    n = 16
    mu = 0.5 * n
    c_c = 1 / (4 + 2 * n)
    c_m = 2 / (n + 2)
    d = np.ones(n) * 10
    pc = 0.25
    cmu = 2

    best_sol = None
    best_val = float('inf')

    for i in range(budget):
        x = rng.normal(0, 1, size=dim)
        while not (lb <= x).all() and (x <= ub).all():
            x = rng.normal(0, 1, size=dim)

        x = (ub - lb) * x + lb

        x_new = np.zeros(dim)
        for j in range(n):
            sigma_j = d[j] ** 2
            e_j = rng.normal(0, 1, size=dim)
            while not (lb <= x_new).all() and (x_new <= ub).all():
                x_new = rng.normal(0, 1, size=dim)

            x_new = (ub - lb) * x_new + lb
            x_new += c_c * sigma_j ** 0.5 * e_j

        x_new += mu * (ub - lb)
        val = func(x_new)

        if val < best_val:
            best_val = val
            best_sol = x_new

        if i % int(budget / n) == 0:
            for j in range(n):
                d[j] *= 1 + c_m * rng.uniform(-1, 1)
                cmu -= pc * rng.uniform(-1, 1)

    return best_sol
