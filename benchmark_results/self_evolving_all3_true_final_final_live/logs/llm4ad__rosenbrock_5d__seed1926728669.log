def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_crossover(mu, sigma):
        x = mu + np.random.randn(dim)*sigma
        return x.clip(lb, ub)

    def polynomial_mutation(x):
        delta_x = np.zeros(dim)
        for i in range(dim):
            if rng.rand() < 0.1:
                delta_x[i] = (ub - lb) * (rng.rand()**2 - rng.rand())
            x[i] += delta_x[i]
        return x.clip(lb, ub)

    def update_sigma(sigma, step_size=0.1):
        sigma_new = max(0.01, min(100, sigma + step_size*(rng.randn()-0.5)))
        return sigma_new

    mu = np.array([2]*dim)
    sigma = 10
    population_size = 50

    for _ in range(budget):
        x = [gaussian_crossover(mu, sigma) for _ in range(population_size)]
        fitness = [func(x_i) for x_i in x]
        best_idx = np.argmin(fitness)
        mu_new = x[best_idx]

        if rng.rand() < 0.5:
            mu_new = polynomial_mutation(mu_new)

        sigma = update_sigma(sigma)

    return mu_new
