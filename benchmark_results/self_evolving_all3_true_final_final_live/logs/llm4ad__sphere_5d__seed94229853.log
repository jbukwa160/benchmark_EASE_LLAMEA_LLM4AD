def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    for _ in range(budget):
        s = (ub - lb) * rng.randn(dim)
        x_new = x + 0.1 * np.sqrt(np.linalg.norm(s)) * s
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)
        if f_new < func(best_x):
            best_x = x_new
        x = x_new
    return best_x
