def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    T = 10.0
    alpha = 1e-4
    p_best = func(x.copy())
    
    for i in range(budget):
        y = x + rng.normal(0, 1, size=dim) * np.exp(-i / (2 * budget))
        y = np.clip(y, lb, ub)
        
        f_y = func(y.copy())
        delta = f_y - p_best
        
        if delta < 0 or np.random.rand() < np.exp(-delta / T):
            x = y
            p_best = f_y
            
        T *= max(1 - alpha, 1e-6)
    
    return x
