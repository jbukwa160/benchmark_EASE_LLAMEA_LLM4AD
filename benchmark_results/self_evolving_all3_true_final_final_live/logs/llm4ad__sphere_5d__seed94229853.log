def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = np.zeros(dim)
    best_obj = float('inf')
    
    for _ in range(budget):
        x = best_sol + rng.normal(size=dim) * 0.1
        x = np.clip(x, lb, ub)
        
        obj = func(x)
        if obj < best_obj:
            best_sol = x
            best_obj = obj
    
    return best_sol
