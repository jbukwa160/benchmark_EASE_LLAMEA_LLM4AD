def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    N = int(budget / (dim * pop_size))
    T = [1] * N
    best_sol = -np.inf
    best_x = None
    for n in range(N):
        x = np.random.uniform(lb, ub, size=(pop_size, dim))
        y = func(x)
        i_best = np.argmin(y)
        if y[i_best] < best_sol:
            best_sol = y[i_best]
            best_x = x[i_best]
        for i in range(pop_size):
            for j in range(dim):
                v = rng.normal(0, 1)
                x[i, j] += T[n] * v
                if x[i, j] < lb:
                    x[i, j] = lb
                elif x[i, j] > ub:
                    x[i, j] = ub
        y = func(x)
        i_best = np.argmin(y)
        if y[i_best] < best_sol:
            best_sol = y[i_best]
            best_x = x[i_best]
        for i in range(pop_size):
            p1 = rng.choice(range(pop_size), replace=False)
            p2 = rng.choice(range(pop_size), replace=False)
            v = 0.5 * (x[p1, :] + x[p2, :])
            if rng.random() < 0.5:
                v += T[n] * rng.normal(0, 1, size=dim)
            else:
                v -= T[n] * rng.normal(0, 1, size=dim)
            for j in range(dim):
                v[j] = max(lb, min(v[j], ub))
            y[p2] = func(x[p2])
            if y[p2] < best_sol:
                best_sol = y[p2]
                best_x = x[p2]
            if func(np.array([v])) < y[p1]:
                x[p1] = v
        T[n] *= 0.99
    return np.array(best_x)
