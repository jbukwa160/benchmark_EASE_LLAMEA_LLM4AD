def algorithm(func, dim, lb, ub, budget, rng):
    def normal_distribution(dim, mean, std_dev):
        return rng.normal(mean, std_dev, size=(dim))

    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_candidate = np.zeros(dim)
    best_value = float('inf')
    distribution_std_dev = 1.0

    for _ in range(budget):
        candidate = clip(normal_distribution(dim, 0, distribution_std_dev))
        value = func(candidate)

        if value < best_value:
            best_candidate = candidate
            best_value = value

        if np.random.rand() < 0.5:  # 50% chance to update the standard deviation
            if value > best_value:
                distribution_std_dev *= 1 - 0.01
            else:
                distribution_std_dev += 0.01

    return best_candidate
