def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = np.zeros(dim)
    best_val = float('inf')
    for i in range(budget):
        x = lb + (ub - lb) * np.random.rand(dim)
        val = func(x)
        if val < best_val:
            best_val = val
            best_sol = x.copy()
        if rng.uniform(0, 1) > 0.9:
            perturbation = (ub - lb) * np.random.randn(dim)
            new_x = best_sol + perturbation
            new_x = np.clip(new_x, lb, ub)
            new_val = func(new_x)
            if new_val < best_val:
                best_val = new_val
                best_sol = new_x.copy()
        if rng.uniform(0, 1) > 0.995 and i > budget // 2:
            break
    return best_sol
