def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population():
        population = rng.uniform(lb, ub, size=(budget, dim))
        return population

    def evaluate(population):
        fitness_values = func(population)
        return fitness_values

    def differential_evolution(population):
        for i in range(dim):
            a, b, c = rng.choice(range(budget), 3, replace=False)
            mutation_index = np.argmax([func(clip(population[a] + rng.uniform(-1, 1) * (population[b] - population[c]))),
                                        func(clip(population[a] + rng.uniform(-1, 1) * (population[b] - population[a]))),
                                        func(clip(population[a] + rng.uniform(-1, 1) * (population[c] - population[b])))])
            if mutation_index == i:
                return clip(population[mutation_index] + rng.uniform(-1, 1) * (population[rng.choice(range(budget), replace=False)] - population[rng.choice(range(budget), replace=False)]))
        return population[np.argmax(evaluate(population))]

    def nelder_mead_simplex(population):
        simplex = np.array([clip(x) for x in population])
        while True:
            centroid = np.mean(simplex, axis=0)
            worst_index = np.argmin(evaluate(simplex))
            if evaluate(centroid)[worst_index] < evaluate(simplex[worst_index]):
                new_simplex = np.vstack([simplex, clip(simplex[worst_index] + 2 * (centroid - simplex[worst_index]))])
                new_worst_index = np.argmin(evaluate(new_simplex))
                if evaluate(centroid)[new_worst_index] < evaluate(simplex[new_worst_index]):
                    simplex = new_simplex
            else:
                reflection = clip(simplex[worst_index] + 1.5 * (centroid - simplex[worst_index]))
                if evaluate(reflection) < evaluate(simplex[worst_index]):
                    expansion = clip(simplex[worst_index] + 2 * (reflection - simplex[worst_index]))
                    if evaluate(expansion) <= evaluate(simplex[worst_index]):
                        simplex = np.vstack([simplex, expansion])
            worst_index = np.argmin(evaluate(simplex))
            if np.linalg.norm(centroid - simplex[worst_index]) < 1e-3:
                return clip(population[np.argmax(evaluate(population))])
        return population[np.argmax(evaluate(population))]

    initial_population = generate_initial_population()
    for i in range(budget):
        new_population = differential_evolution(initial_population)
        best_solution = nelder_mead_simplex(new_population)
        initial_population = np.vstack([initial_population, best_solution])

    return initial_population[np.argmax(evaluate(initial_population))]
