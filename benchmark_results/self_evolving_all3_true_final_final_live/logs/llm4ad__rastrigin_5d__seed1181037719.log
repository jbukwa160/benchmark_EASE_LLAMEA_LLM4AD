def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = clip(x)
    best_f = func(best_x)
    cov = np.eye(dim) * 1e-2
    for _ in range(budget - 1):
        y = x + rng.normal(size=x.shape)
        y = clip(y)
        f_y = func(y)
        if f_y < best_f:
            best_f = f_y
            best_x = y
        delta = y - x
        cov += np.outer(delta, delta)
        v = np.linalg.solve(cov, rng.normal(size=x.shape))
        x += v
    return best_x
