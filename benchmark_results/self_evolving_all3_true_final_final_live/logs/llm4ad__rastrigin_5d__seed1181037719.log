def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidates):
        return np.clip(candidates, lb, ub)

    def evaluate(individuals):
        return func(individuals)

    n_restart = 5  # Number of restarts
    max_size = 50  # Maximum population size

    for i in range(n_restart):
        c = rng.uniform(lb, ub, (1, dim))
        sigma = 0.5 * (ub - lb) / np.sqrt(dim)

        for _ in range(budget // n_restart):
            mu = np.zeros((max_size, dim))
            cov = np.eye(max_size) * sigma
            x_new = np.random.multivariate_normal(mu[0], cov, max_size)
            x_new = clip(x_new)

            f_x_new = evaluate(x_new)

            idx_best = np.argmin(f_x_new)
            best_candidate = clip(x_new[idx_best])

            if _ % 10 == 0:
                print(f'Best candidate after {_} iterations: {best_candidate}')

    return best_candidate
