def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        step_size = 0.1 * (ub - lb) / np.sqrt(_ + 1)
        noise = rng.normal(size=dim, loc=0, scale=step_size)
        new_x = x + noise
        new_x = np.clip(new_x, lb, ub)

        new_f = func(new_x)
        if new_f < best_f:
            best_f = new_f
            best_x = new_x.copy()
            x = new_x

    return best_x
