def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 10 * (ub - lb)
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        y = rng.randn(dim) + x_best
        if np.any(y < lb) or np.any(y > ub):
            continue

        z = 0.5 * (ub - lb) * rng.uniform(size=dim)
        y += z
        f_y = func(y)

        if f_y < f_best:
            f_best = f_y
            x_best = y

        sigma *= np.exp(1 / (budget + _))
    return x_best
