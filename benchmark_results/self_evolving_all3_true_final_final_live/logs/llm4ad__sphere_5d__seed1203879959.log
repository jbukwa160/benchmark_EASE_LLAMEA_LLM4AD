def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    current_best = np.zeros(dim)
    best_value = float('inf')
    step_sizes = np.ones(dim) * 0.1

    for _ in range(budget):
        distribution = np.random.randn(dim)
        distribution *= step_sizes
        candidate = current_best + distribution

        value = evaluate(candidate)

        if value < best_value:
            best_value = value
            current_best = candidate

        step_size_update = 0.1 * (np.random.rand() - 0.5)  # Adaptation mechanism for each variable
        step_sizes += np.array([step_size_update] * dim)
        step_sizes = np.clip(step_sizes, 0.01, 1)

    return current_best
