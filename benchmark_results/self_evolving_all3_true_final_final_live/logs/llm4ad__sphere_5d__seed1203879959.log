def algorithm(func, dim, lb, ub, budget, rng):
    n = 50
    mu = 1.0 / np.sqrt(dim)
    sigma = 10.0
    x_best = -np.ones(dim)
    f_best = float('inf')
    
    for _ in range(budget):
        offspring = rng.multivariate_normal(x_best, (sigma**2) * np.eye(dim), size=n)
        clipped_offspring = np.clip(offspring, lb, ub)
        
        fitnesses = func(clipped_offspring)
        idx_best = np.argmax(fitnesses)
        
        if fitnesses[idx_best] < f_best:
            x_best = clipped_offspring[idx_best]
            f_best = fitnesses[idx_best]
            
    return x_best
