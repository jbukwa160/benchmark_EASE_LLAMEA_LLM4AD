def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def rastrigin(x):
        return func(10*dim + np.sum(x**2 - 10*np.cos(2*np.pi*x)))

    def differential_evolution():
        mutation = (0.5 * rng.rand(dim) - 0.25)
        crossover_prob = 1 / (1 + np.exp(-budget))
        x_best = clip(rng.uniform(lb, ub, dim))
        for _ in range(budget):
            trial = clip(x_best + mutation)
            if rastrigin(trial) < rastrigin(x_best):
                x_best = trial
        return x_best

    best_x = differential_evolution()
    return best_x
