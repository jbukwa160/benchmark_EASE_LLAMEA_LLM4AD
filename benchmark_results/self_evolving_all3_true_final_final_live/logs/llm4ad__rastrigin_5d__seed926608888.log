def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    def generate_init_x(dim, lb, ub):
        x = rng.uniform(-5, 5, size=(dim,))
        return clip(x)

    def generate_new_x(population, func, dim, lb, ub, budget):
        new_population = []
        for _ in range(10 * dim):
            parent_idx = np.random.choice(len(population), p=population)
            parent_x = population[parent_idx]
            noise = rng.normal(size=(dim,))
            new_x = parent_x + 0.1 * noise
            new_x = clip(new_x)
            if func(new_x) < func(parent_x):
                new_population.append(new_x)
        return new_population

    def simulated_annealing(x, func, lb, ub, rng):
        T = np.exp(10)
        while T > 0.1:
            new_x = x + rng.uniform(-5, 5, size=(dim,))
            new_x = clip(new_x)
            if func(new_x) < func(x):
                x = new_x
            else:
                p = np.exp((func(x) - func(new_x)) / T)
                if rng.random() > p:
                    x = new_x
            T *= 0.99
        return x

    population = [generate_init_x(dim, lb, ub)]
    for _ in range(budget):
        population = generate_new_x(population, func, dim, lb, ub, budget)
        best_idx = np.argmax([func(x) for x in population])
        best_x = population[best_idx]
        new_x = simulated_annealing(best_x, func, lb, ub, rng)
        population.append(new_x)

    return np.array(population[-1])
