def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    population = rng.uniform(lb, ub, (budget, dim))
    fitness = [func(clip(x)) for x in population]

    while budget > 0:
        budgets = budget
        for i in range(budgets):
            j = rng.randint(budget)
            k = rng.choice([x for x in range(budget) if x != j])
            candidate1 = clip(population[j] + 0.5*rng.uniform(-1, 1)*(population[k]-population[j]))
            candidate2 = clip(population[k] + 0.5*rng.uniform(-1, 1)*(population[j]-population[k]))

            fitness1 = func(candidate1)
            fitness2 = func(candidate2)

            if (fitness1 < fitness[j]) or (fitness1 < fitness2 and rng.random() < 0.5):
                population[j] = candidate1
                fitness[j] = fitness1

            if (fitness2 < fitness[k]) or (fitness2 < fitness1 and rng.random() < 0.5):
                population[k] = candidate2
                fitness[k] = fitness2

        best_idx = np.argmin(fitness)
        if budget % 10 == 0:
            print('Best fitness at iteration {}: {:.4f}'.format(budget, fitness[best_idx]))

        budget -= 1

    return population[np.argmin(fitness)]
