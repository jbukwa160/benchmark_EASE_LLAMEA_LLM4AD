def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    temp = 1.0

    for _ in range(budget):
        new_x = x + rng.normal(size=dim) * 0.01
        new_x = clip(new_x)

        if func(new_x) < func(best_x):
            best_x = new_x

        # Simulated Annealing
        delta = func(new_x) - func(best_x)
        if delta < 0 or np.exp(-delta / temp) > rng.uniform():
            x = new_x

        # Cooling schedule
        temp *= 0.99999

    return best_x
