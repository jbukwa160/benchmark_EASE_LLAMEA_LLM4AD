def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    sigma = 3.0
    mu = 1e-6
    T = 10 * dim
    p_mutate = 0.01

    def get_candidate():
        return np.clip(rng.uniform(lb, ub, size=dim), a_min=lb, a_max=ub)

    def fitness(x):
        return func(x)

    population = [get_candidate() for _ in range(pop_size)]
    best_solution = None
    best_fitness = float('inf')

    for t in range(T):
        if budget <= 0:
            break

        # Evaluate the current population and keep track of the best solution found so far.
        fitness_values = np.array([fitness(x) for x in population])
        new_best_idx = np.argmin(fitness_values)
        if fitness_values[new_best_idx] < best_fitness:
            best_solution = population[new_best_idx]
            best_fitness = fitness_values[new_best_idx]

        # Simulated Annealing step: accept new solutions with probability based on the temperature schedule and their fitness improvement.
        for i in range(pop_size):
            if rng.rand() < np.exp((best_fitness - fitness_values[i]) / (t + mu)):
                population[i] = get_candidate()
                budget -= 1

        # Genetic Algorithm step: mutate some solutions with a probability based on the temperature schedule and perform crossover.
        for i in range(pop_size):
            if rng.rand() < p_mutate * np.exp(-t/T):
                x1, x2 = population[i], get_candidate()
                population[i] = (x1 + sigma * rng.randn(dim)) / 2 + (x2 - sigma * rng.randn(dim)) / 2

    return best_solution
