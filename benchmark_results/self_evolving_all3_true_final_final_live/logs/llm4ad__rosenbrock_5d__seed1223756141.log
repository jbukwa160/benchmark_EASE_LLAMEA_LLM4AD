def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget - 1):
        i = np.random.randint(0, dim)
        z = x.copy()
        j = (i + rng.choice(dim)) % dim
        z[i] = clip(z[i] + 0.5 * (ub - lb) * (rng.uniform(-1, 1)))
        z[j] = clip(z[j] + 0.5 * (ub - lb) * (rng.uniform(-1, 1)))

        f_z = func(clip(z))
        if f_z < best_f:
            best_x = z.copy()
            best_f = f_z
        elif rng.rand() < np.exp((best_f - f_z) / 10.0):
            x[i] = z[i]
            x[j] = z[j]

    return clip(best_x)
