def algorithm(func, dim, lb, ub, budget, rng):
    def sample_gaussian(mu, sigma):
        return mu + rng.normal(size=dim) * sigma

    def evaluate_candidate(candidate):
        return func(candidate)

    x = [sample_gaussian(1.0, 2.0) for _ in range(dim)]
    best_x = np.copy(x)
    best_value = evaluate_candidate(np.array(x))

    temperature = 10
    sigma = 5
    cooling_rate = 0.99

    for _ in range(budget):
        new_x = sample_gaussian(x, sigma / temperature)
        clipped_new_x = np.clip(new_x, lb, ub)

        value = evaluate_candidate(clipped_new_x)

        if value < best_value:
            best_x = np.copy(clipped_new_x)
            best_value = value

        if rng.random() < np.exp((best_value - value) / temperature):
            x = clipped_new_x
            temperature *= cooling_rate

    return best_x
