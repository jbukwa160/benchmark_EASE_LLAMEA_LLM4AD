def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(np.array(x))

    def generate_candidate(x, step_size):
        indices = rng.choice(dim, size=dim, replace=False)
        new_x = x.copy()
        for i in indices:
            new_x[i] += np.sign(new_x[i] - lb) * rng.uniform(-step_size, step_size)
            new_x[i] = max(lb, min(ub, new_x[i]))
        return new_x

    def adaptive_cooling_schedule(current_fitness, best_fitness):
        temperature = 1.0
        alpha = 0.99
        if current_fitness > best_fitness:
            temperature *= alpha
        return temperature

    x_best = np.random.uniform(lb, ub, size=dim)
    for _ in range(budget):
        step_size = max(0.001, (ub - lb) / 2 ** int(np.log(_ + 1)))
        current_x = generate_candidate(x_best.copy(), step_size)
        current_fitness = evaluate(current_x)
        if current_fitness < evaluate(x_best):
            x_best = current_x
        temperature = adaptive_cooling_schedule(current_fitness, evaluate(x_best))
        if rng.uniform(0, 1) < np.exp((evaluate(x_best) - current_fitness) / temperature):
            x_best = current_x

    return x_best
