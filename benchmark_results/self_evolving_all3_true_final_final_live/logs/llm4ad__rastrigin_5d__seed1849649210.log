def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    temperature = 1.0
    cooling_rate = 0.99
    
    for _ in range(budget):
        v = clip(best_x + rng.uniform(-1, 1, size=dim))
        f_v = func(v)
        
        if f_v < best_f:
            best_f = f_v
            best_x = v
            
        alpha = rng.uniform(0, 1)
        if alpha > np.exp((best_f - f_v) / temperature):
            x = v.copy()
            
        temperature *= cooling_rate
        
    return best_x
