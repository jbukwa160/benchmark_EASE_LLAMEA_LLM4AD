def algorithm(func, dim, lb, ub, budget, rng):
    n = 50
    pop_size = int(np.sqrt(n * dim))
    
    bounds = [(lb, ub) for _ in range(dim)]
    
    def fitness(x):
        x = np.clip(x, lb, ub)
        return func(x), []
    
    res_de = differential_evolution(fitness, bounds=bounds, population_size=pop_size, strategy='best1exp', maxiter=n)
    
    x0 = res_de.x
    
    res_l_bfgs_b = minimize(func, x0, method='L-BFGS-B', bounds=bounds)
    
    return np.clip(res_l_bfgs_b.x, lb, ub)
