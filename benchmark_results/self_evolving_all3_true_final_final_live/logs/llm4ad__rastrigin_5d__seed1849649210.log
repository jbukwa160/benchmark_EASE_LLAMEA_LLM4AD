def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    sigma = 1.0
    CR = 0.5
    pop = np.random.uniform(lb, ub, (pop_size, dim))
    best = None
    for _ in range(budget):
        diffs = pop[:, np.newaxis] - pop[np.newaxis, :]
        dists = np.linalg.norm(diffs, axis=2)
        idx = rng.choice(pop_size, size=(pop_size,), replace=False)
        trial_pop = pop.copy()
        for i in range(pop_size):
            selected_idx = [j for j in idx if j != i]
            ridx = rng.randint(0, pop_size - 1, size=dim)
            mutation = diffs[selected_idx[ridx], ridx] / dists[selected_idx[ridx], ridx, None]
            trial_pop[i] += sigma * mutation
        for i in range(pop_size):
            trial = trial_pop[i]
            a = rng.randint(0, pop_size - 1)
            b = rng.randint(0, pop_size - 1)
            c = rng.randint(0, pop_size - 1)
            if func(trial) < func(pop[a]) or rng.random() < CR:
                trial_pop[i] = trial
        pop = clip_to_bounds(trial_pop, lb, ub)
        best_idx = np.argmin(func(pop))
        if best is None or func(pop[best_idx]) < func(best):
            best = pop[best_idx]
    return best
