def algorithm(func, dim, lb, ub, budget, rng):
    x = 0.5 * (ub - lb) + lb + rng.uniform(0, 1, size=dim)
    pop = np.repeat([x], budget, axis=0)
    
    for i in range(budget):
        y = pop[np.random.choice(pop.shape[0], size=3, replace=False)]
        r = rng.uniform(0, 1, size=dim)
        
        z = y + r * (y[:, np.newaxis] - x[np.newaxis, :])
        u = np.where(rng.uniform(0, 1, size=dim) < 0.5, z, x)
        
        f_z = func(u)
        f_x = func(x)
        
        if f_z < f_x:
            x = u
            pop[i] = u
            
    return x
