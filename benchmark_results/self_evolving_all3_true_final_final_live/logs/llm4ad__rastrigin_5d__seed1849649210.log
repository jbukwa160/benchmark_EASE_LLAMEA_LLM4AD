def algorithm(func, dim, lb, ub, budget, rng):
    def local_search(x, lb, ub):
        n = len(x)
        best_x = x.copy()
        for _ in range(100):  # Perform 100 local searches
            i = rng.choice(n)
            step_size = (ub - lb) * rng.uniform(0.01, 0.1)
            new_x_i = best_x[i] + step_size * rng.uniform(-1, 1)
            if lb <= new_x_i <= ub:
                new_x = best_x.copy()
                new_x[i] = new_x_i
                new_f = func(new_x)
                if new_f < func(best_x):
                    best_x = new_x
        return best_x

    def crossover(x1, x2):
        n = len(x1)
        a = rng.uniform(0.5, 1.5)  # Dynamic crossover rate
        c = np.zeros(n)
        for i in range(n):
            if rng.random() < a:
                c[i] = (x1[i] - x2[i]) * rng.uniform(-1, 1) + x2[i]
            else:
                c[i] = (x1[i] + x2[i]) / 2
        return c

    best_x = np.random.uniform(lb, ub, dim)
    for _ in range(budget):
        population = [local_search(best_x.copy(), lb, ub) for _ in range(20)]  # Maintain a population of 20 candidate solutions
        new_population = []
        for i in range(len(population)):
            for j in range(len(population)):
                if i != j:
                    new_x = crossover(population[i], population[j])
                    new_population.append(local_search(new_x, lb, ub))
        best_f = func(best_x)
        for x in new_population:
            f = func(x)
            if f < best_f:
                best_f = f
                best_x = x
        if rng.random() < 0.1:  # 10% chance of resetting the search space
            population = [np.random.uniform(lb, ub, dim) for _ in range(20)]
    return best_x
