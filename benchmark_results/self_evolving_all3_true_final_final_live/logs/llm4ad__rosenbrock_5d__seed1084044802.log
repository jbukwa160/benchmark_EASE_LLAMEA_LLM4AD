def algorithm(func, dim, lb, ub, budget, rng):
    def acquisition(x):
        mu = np.mean(func(np.array([x])))
        return -mu + 0.01 * x**2

    num_samples = int(budget ** (1 / 3))
    D = np.linspace(lb, ub, num_samples)

    for _ in range(int(budget)):
        X = []
        Y = []

        for i in range(num_samples):
            for j in range(i + 1, num_samples):
                x = np.array([D[i], D[j]])
                X.append(x)
                Y.append(func(x)[0])

        cov = 0.5 * np.eye(num_samples) + 0.01 * np.ones((num_samples, num_samples))
        mu = np.mean(Y)

        K_inv = np.linalg.inv(cov)
        a = np.dot(K_inv, X.T)
        b = np.dot(a, Y) - mu

        x_best = np.inf
        for i in range(num_samples):
            for j in range(i + 1, num_samples):
                x = D[i] * D[j]
                c = np.dot(X[i], a[i]) * np.dot(X[j], a[j])
                d = b[i] * b[j]

                if acquisition(x) > c - d:
                    x_best = x
                    break

            if x_best != np.inf and i + 1 == num_samples:
                break

        if x_best != np.inf:
            D = np.append(D, x_best)

    x = lb + (ub - lb) * rng.uniform(size=dim)
    while True:
        fx = func(x)[0]

        for i in range(dim):
            new_x = x.copy()
            new_x[i] += 0.1
            new_fx = func(new_x)[0]
            if new_fx < fx:
                x = new_x
                fx = new_fx

        if np.all(np.abs(func(x)) < 1e-3):
            break

    return x
