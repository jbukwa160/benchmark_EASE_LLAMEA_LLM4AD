            for i in range(10):
                candidate = clip(population[i] + rng.normal(size=dim), lb, ub)
                
                u1 = rng.choice(range(10))
                u2 = (u1 - 1) % 10
                v1 = rng.choice(range(dim))
                v2 = rng.choice(range(dim))
                
                new_population[i] = candidate.copy()
                new_population[i][v1], new_population[i][v2] = population[u1][v1] + rng.normal(), population[u2][v2] + rng.normal()
                
            population[:] = clip(new_population, lb, ub)
            
