def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    n = 5  # dimensionality (hardcoded)
    x_best = np.random.uniform(lb, ub, size=(n,))
    f_best = func(x_best)

    for _ in range(budget):
        x_new = np.zeros(n)
        for i in range(n):
            if rng.rand() < 0.1:
                # gradient descent
                step_size = rng.uniform(0.001, 0.01)
                x_new[i] = x_best[i] - step_size * (func(clip(x_best + np.zeros(n) + 0.1 * rng.randn(n))) - f_best)
            else:
                # differential evolution
                u = np.random.uniform(lb, ub, size=(n,))
                v = np.random.uniform(lb, ub, size=(n,))
                x_new[i] = x_best[i] + rng.uniform(-1, 1) * (u[i] - x_best[i]) + rng.uniform(-1, 1) * (v[i] - x_best[i])

        f_new = func(clip(x_new))
        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
