def algorithm(func, dim, lb, ub, budget, rng):
    bounds = [(lb[i], ub[i]) for i in range(dim)]
    
    res_de = differential_evolution(func, bounds)
    
    def genetic_optimizer(bounds, budget):
        pop_size = 100
        mutation_rate = 0.1
        elite_size = int(pop_size * 0.2)
        
        population = np.random.uniform(lb, ub, (pop_size, dim))
        fitness = np.array([func(ind) for ind in population])
        
        for _ in range(budget):
            parents = np.argsort(fitness)[:elite_size]
            offspring = np.concatenate((population[parents], 
                                       np.random.uniform(lb, ub, (pop_size - elite_size, dim))))
            
            fitness = np.array([func(offspring[i]) for i in range(pop_size)])
            
            indices = rng.choice(pop_size, size=pop_size//2, replace=False)
            mutation = np.random.uniform(0, 1, pop_size) > mutation_rate
            population[indices] = offspring[indices]
            population[mutation] += np.random.uniform(-1, 1, (np.sum(mutation), dim))
            
            fitness = np.array([func(ind) for ind in population])
        
        return np.argmin(fitness)
    
    best_individual_de = res_de.x
    best_individual_genetic = population[genetic_optimizer(bounds, budget)]
    
    if func(best_individual_de) < func(best_individual_genetic):
        return best_individual_de
    else:
        return best_individual_genetic
