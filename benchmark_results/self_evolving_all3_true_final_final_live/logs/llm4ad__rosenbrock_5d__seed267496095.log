def algorithm(func, dim, lb, ub, budget, rng):
    n = len(dim)
    pop_size = 50
    x_best = lb + (ub - lb) * rng.rand(pop_size, n)
    
    for t in range(budget):
        f_x = func(x_best)
        
        # Local search
        for i in range(pop_size):
            x = x_best[i] + 0.1 * rng.randn(n)
            x = np.clip(x, lb, ub)
            f_x_new = func(x)
            
            if f_x_new < f_x:
                f_x = f_x_new
                x_best[i] = x
        
        # Mutation and selection
        for i in range(pop_size):
            z = x_best[(i-1)%pop_size] + 0.5 * (x_best[(i+1)%pop_size] - x_best[(i-2)%pop_size])
            z = np.clip(z, lb, ub)
            f_z = func(z)
            
            if f_z < f_x:
                f_x = f_z
                x_best[i] = z
                
    return x_best[np.argmin([func(x) for x in x_best])]
