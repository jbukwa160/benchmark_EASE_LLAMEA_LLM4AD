def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    n = len(lb)
    assert n == dim
    assert n == len(ub)
    assert n == dim

    D = 10.0
    w = 0.7298
    c1 = c2 = 1.49618
    m = int(np.sqrt(budget))

    x_best = np.random.uniform(lb, ub, size=(m, n))
    v = np.zeros((m, n))

    for i in range(m):
        f_best = [f(x[i]) for x in x_best]
        idx = np.argmin(f_best)
        x_best[idx] += 0.1 * rng.normal(size=n)

    for _ in range(budget - m):
        for i in range(m):
            r1, r2 = rng.uniform(0, 1, size=2)
            v[i] = w * v[i] + c1 * r1 * (x_best[i] - x[i]) + c2 * r2 * (x_best[np.argmin(f_best)] - x[i])
            x_new = x[i] + v[i]
            f_new = f(x_new)
            if f_new < f_best[i]:
                x_best[i] = x_new
                f_best[i] = f_new

        # DE mutation
        for i in range(m):
            idx1, idx2, idx3 = rng.choice(m, size=3, replace=False)
            v[i] += D * (x_best[idx1] - 2*x_best[idx2] + x_best[idx3])

        for i in range(m):
            r1, r2 = rng.uniform(0, 1, size=2)
            v[i] = w * v[i] + c1 * r1 * (x_best[i] - x[i]) + c2 * r2 * (x_best[np.argmin(f_best)] - x[i])
            x_new = x[i] + v[i]
            f_new = f(x_new)
            if f_new < f_best[i]:
                x_best[i] = x_new
                f_best[i] = f_new

        # clip to bounds
        for i in range(m):
            x_best[i] = np.clip(x_best[i], lb, ub)

    idx = np.argmin(f_best)
    return x_best[idx]
