def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    best_x = np.ones(n) * (lb + ub) / 2
    best_f = func(best_x)
    current_f = best_f
    alpha = 0.01
    T = 1e3

    for _ in range(budget):
        new_x = np.copy(best_x)
        k = rng.choice(n)

        # Probabilistic gradient descent
        delta = alpha * (ub[k] - lb[k]) * (best_x[k] - lb[k])
        if rng.uniform(0, 1) < np.exp(-delta / T):
            new_x[k] += delta

        # Clip to bounds
        new_x = np.clip(new_x, lb, ub)

        # Simulated annealing
        new_f = func(new_x)
        T *= 0.999

        if new_f <= current_f:
            current_f = new_f
            best_x = new_x
        elif rng.uniform(0, 1) < np.exp((current_f - new_f) / T):
            current_f = new_f
            best_x = new_x

    return best_x
