def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    pop_size = 50
    init_stddev = 2.0
    crossover_prob = 0.9
    mutation_prob = 0.1

    population = rng.uniform(lb, ub, size=(pop_size, dim))
    best_solution = None
    best_fitness = np.inf

    for _ in range(budget):
        # Evaluate fitness for each individual in the current population
        fitnesses = [func(clip(x, lb, ub)) for x in population]

        # Update the best solution found so far
        if min(fitnesses) < best_fitness:
            best_solution = population[np.argmin(fitnesses)]
            best_fitness = min(fitnesses)

        # Select parents using tournament selection
        parents = []
        for _ in range(pop_size):
            i, j, k = rng.choice(pop_size, size=3, replace=False)
            if fitnesses[i] < fitnesses[j] and fitnesses[i] < fitnesses[k]:
                parents.append(population[i])
            elif fitnesses[j] < fitnesses[i] and fitnesses[j] < fitnesses[k]:
                parents.append(population[j])
            else:
                parents.append(population[k])

        # Perform crossover operation
        offspring = []
        for x, y in zip(parents[::2], parents[1::2]):
            if rng.random() < crossover_prob:
                idx = rng.choice(dim)
                z = np.copy(x)
                z[idx] = y[idx]
                offspring.append(z)
            else:
                offspring.append(x)

        # Perform mutation operation
        for i, x in enumerate(offspring):
            if rng.random() < mutation_prob:
                idx = rng.choice(dim)
                x[idx] += rng.normal(0.0, init_stddev)
                x = clip(x, lb, ub)
                offspring[i] = x

        # Update the population with the new offspring
        population = np.array(offspring)

    return best_solution
