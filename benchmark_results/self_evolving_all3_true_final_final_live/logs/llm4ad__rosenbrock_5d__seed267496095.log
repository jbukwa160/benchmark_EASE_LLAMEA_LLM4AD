def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    sigma_init = 0.1
    sigma_decay = 0.9999
    T_init = 1000
    T_decay = 0.99
    p_c = 0.5

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    sigma = sigma_init
    T = T_init

    for _ in range(budget):
        for _ in range(pop_size):
            x_new = x_best + rng.normal(size=dim) * sigma
            x_new = np.clip(x_new, lb, ub)
            f_new = func(x_new)

            if f_new < f_best:
                x_best = x_new
                f_best = f_new

        sigma *= sigma_decay
        T *= T_decay

        # Simulated Annealing schedule
        p_accept = 1 / (1 + np.exp((f_best - f_new) / T))
        if rng.random() < p_accept:
            x_best = x_new
            f_best = f_new

    return x_best
