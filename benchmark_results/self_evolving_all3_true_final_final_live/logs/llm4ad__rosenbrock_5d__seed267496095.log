def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(1e4)
    pop = lb + (ub - lb) * rng.rand(pop_size, dim)

    for _ in range(budget):
        # Evaluate function at all points
        fitness = func(pop)

        # Select indices of best candidates
        idx_best = np.argsort(fitness)[:int(pop_size*0.1)]

        # Perform local search around the best candidate
        pop[idx_best] = ub - (ub - lb) * 0.5 + (ub - lb) * rng.rand(len(idx_best), dim)

    # Clip candidates to [lb, ub]
    pop = np.clip(pop, lb, ub)

    # Return the best point found
    return pop[np.argmin(func(pop))]
