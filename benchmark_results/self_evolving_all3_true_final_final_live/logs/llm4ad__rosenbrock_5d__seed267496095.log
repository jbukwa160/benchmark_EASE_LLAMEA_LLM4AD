def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    n = len(lb)
    x0 = np.array([np.random.uniform(lb[i], ub[i]) for i in range(n)])
    bounds = [(lb[i], ub[i]) for i in range(n)]

    res = minimize(objective, x0, method="L-BFGS-B", bounds=bounds, options={"maxfun": budget})

    return np.clip(res.x, lb, ub)
