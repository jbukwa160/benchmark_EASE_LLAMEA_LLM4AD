def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    x = np.zeros(dim)
    temp = 1.0
    T_min = 1e-6
    for t in range(1, budget + 1):
        delta = rng.uniform(-1, 1, dim) * temp
        new_x = clip(x + delta)
        epsilon = func(new_x) - func(x)
        if epsilon <= 0 or np.exp(-epsilon / temp) > rng.rand():
            x = new_x
        if t % (budget // 10) == 0:
            temp *= 0.99
        if temp < T_min:
            break
    return clip(x)
