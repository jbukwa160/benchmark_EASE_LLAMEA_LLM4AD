def algorithm(func, dim, lb, ub, budget, rng):
    X = np.random.uniform(lb, ub, size=(budget, dim))
    F = func(X)
    best_idx = np.argmin(F)
    best_x = X[best_idx]
    for _ in range(budget*10):  # repeat gradient descent 10 times
        x_new = best_x + rng.normal(size=dim) * 0.01
        f_new = func(np.clip(x_new, lb, ub))
        if f_new < F[best_idx]:
            F[best_idx] = f_new
            best_x = np.clip(x_new, lb, ub)
    return best_x
