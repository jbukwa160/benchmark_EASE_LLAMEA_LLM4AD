def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def mutate(x):
        noise = np.random.normal(size=dim)
        return x + 0.1 * noise

    x_best = np.zeros(dim)
    f_best = float('inf')
    for _ in range(budget):
        x_new = x_best + 0.5 * rng.normal(size=(dim, dim))
        x_new /= np.linalg.norm(x_new, axis=1)[:, None]
        x_new *= 2
        x_new += -1 + 2 * rng.uniform(size=dim)
        for _ in range(dim):
            if rng.uniform() < 0.01:
                x_new = mutate(x_new)
        f_new = func(clip(x_new))
        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return clip(x_best)
