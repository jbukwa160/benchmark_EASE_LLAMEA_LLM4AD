def algorithm(func, dim, lb, ub, budget, rng):
    def bounds(x):
        return np.minimum(np.maximum(x, lb), ub)

    best_x = None
    best_f = float('inf')

    for _ in range(budget // 5):
        x = [1.0] * dim
        while True:
            y = x + bounds(rng.uniform(-1, 1, size=dim))
            f = func(y)
            if f < best_f:
                best_x = y
                best_f = f
            if np.random.rand() > 0.9 or _ == budget // 5 - 1:
                break
        x, y = [best_x[i] + rng.uniform(-1, 1) * (x[i] - x[i-1]) for i in range(dim)], best_x
        f = func(bounds(y))
        if f < best_f:
            best_x = y
            best_f = f

    return bounds(best_x)
