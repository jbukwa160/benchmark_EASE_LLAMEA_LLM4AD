def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        if x.ndim == 1:
            return func(x)
        else:
            return [func(xi) for xi in x]

    T = 1000.0
    alpha = 0.99
    current = np.random.uniform(lb, ub, dim)

    best_x = current.copy()
    best_f = evaluate(current)

    for _ in range(budget):
        new_x = current + rng.uniform(-T, T, size=dim)
        new_x = np.clip(new_x, lb, ub)
        
        new_f = evaluate(new_x)

        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f

        delta_f = new_f - best_f
        if delta_f < 0 or rng.uniform(0, 1) < np.exp(-delta_f / T):
            current = new_x.copy()

        T *= alpha

    return best_x
