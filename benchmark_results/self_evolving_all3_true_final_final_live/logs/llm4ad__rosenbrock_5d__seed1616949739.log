def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(budget / dim)
    x = rng.uniform(lb, ub, (pop_size, dim))
    for _ in range(int(budget)):
        # Mutation
        v = np.zeros((pop_size, dim))
        for i in range(pop_size):
            idx1, idx2, idx3 = np.random.choice(pop_size, 3, replace=False)
            v[i] = x[idx1] + rng.uniform(-1, 1) * (x[idx2] - x[idx3])
        
        # Crossover
        u = np.zeros((pop_size, dim))
        for i in range(pop_size):
            idx = np.random.choice(pop_size)
            if rng.rand() < 0.5:
                u[i] = v[i]
            else:
                u[i] = x[idx]
        
        # Selection
        x = np.where(rng.uniform(0, 1, (pop_size, dim)) < (func(u) / func(x)), u, x)
    
    return np.clip(np.min(x, axis=0), lb, ub)
