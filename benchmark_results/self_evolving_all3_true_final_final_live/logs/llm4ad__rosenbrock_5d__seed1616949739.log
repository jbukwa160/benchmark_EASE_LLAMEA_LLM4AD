def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidates(x_best, N, lb, ub):
        x = rng.uniform(lb, ub, (N, dim))
        return x

    def surrogate_loss(x, y):
        return np.sum((100*(x[:, 1:] - x[:,:-1])**2)**2 + (1-x)**2, axis=1) + np.random.normal(0, 1e-6, size=x.shape[0])

    def acquisition_function(x, mu, sigma):
        return (np.exp(-(x-mu)**2/(2*sigma**2)) - 1) * (mu > 1.5)

    x_best = None
    y_best = np.inf

    for t in range(budget):
        N = int(0.1 * budget)
        if t == 0:
            x = generate_candidates(np.array([]), N, lb, ub)
        else:
            x = generate_candidates(x_best, N, lb, ub)

        y = surrogate_loss(x, func(x))
        mu = np.mean(y)
        sigma = np.std(y) + 1e-6

        u = acquisition_function(x, mu, sigma)

        idx = np.argsort(u)[::-1][:N]
        x_new = x[idx]

        for i in range(N):
            if surrogate_loss(np.array([x_best]), func)(0)[0] < y[i]:
                continue
            if surrogate_loss(np.array([x_new[i]]), func)(0)[0] > y[i]:
                break

            x_best = x_new[i]
            y_best = y[i]

        if t % 10 == 0:
            print(f't: {t}, best: {y_best}')

    return np.array([x_best])
