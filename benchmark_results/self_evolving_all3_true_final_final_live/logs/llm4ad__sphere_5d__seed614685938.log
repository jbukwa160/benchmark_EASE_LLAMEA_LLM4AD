def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    current_solution = rng.uniform(lb, ub, size=dim)
    best_solution = current_solution.copy()
    best_fitness = func(current_solution)

    temperature = 10.0
    step_size = (ub - lb) / 2.0

    for _ in range(budget):
        new_solution = clip(current_solution + rng.uniform(-step_size, step_size, size=dim))
        new_fitness = func(new_solution)
        delta = new_fitness - best_fitness

        if delta < 0:
            best_solution = new_solution.copy()
            best_fitness = new_fitness
        elif np.random.rand() < np.exp(-delta / temperature):
            current_solution = new_solution.copy()

        temperature *= 0.9999  # cooling schedule

    return best_solution
