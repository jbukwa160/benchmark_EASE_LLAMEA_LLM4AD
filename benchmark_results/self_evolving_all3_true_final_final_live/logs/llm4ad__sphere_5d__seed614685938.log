def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    for _ in range(budget):
        x_candidate = x_best + (ub - lb) * rng.uniform(size=dim) - 0.5 * (ub - lb)
        
        # Clip candidates to [lb, ub]
        x_candidate = np.clip(x_candidate, lb, ub)
        
        f_candidate = func(x_candidate)
        
        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate
    
    return x_best
