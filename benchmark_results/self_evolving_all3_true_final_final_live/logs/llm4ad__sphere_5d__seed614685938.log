def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    mean = np.copy(x)
    cov_mat = np.eye(dim)

    for _ in range(budget):
        candidates = mean + cov_mat @ rng.randn(dim)
        candidates = np.clip(candidates, lb, ub)

        f_val = func(candidates)
        f_mean = func(mean)

        if f_val < f_mean:
            mean = candidates
            cov_mat *= 0.5

    return mean
