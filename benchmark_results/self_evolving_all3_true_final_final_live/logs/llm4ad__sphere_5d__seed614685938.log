def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        learning_rate = 1 / (0.01 + (_ / budget))
        
        # Compute gradient
        grad = 2 * (x - lb) / (ub - lb) if ub == lb else 2 * (x - lb) / (ub - lb)
        
        # Update x using SGD with adaptive learning rate
        x -= learning_rate * grad
        
        # Clip to bounds
        x = np.clip(x, lb, ub)
        
        # Check for early stopping
        if func(x) < best_f:
            best_x = x.copy()
            best_f = func(x)
    
    return best_x
