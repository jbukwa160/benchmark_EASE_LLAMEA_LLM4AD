def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def mutate(parents):
        children = parents + 0.1 * (ub - lb) * rng.randn(dim)
        return clip(children)

    pop_size = 10
    step_size = 5.0
    best_solution = None

    for _ in range(budget):
        parents = np.random.uniform(lb, ub, size=(pop_size, dim))
        children = mutate(parents)

        candidate_values = func(children)
        min_value_idx = np.argmin(candidate_values)
        candidate = children[min_value_idx]

        if best_solution is None or candidate_values[min_value_idx] < func(best_solution):
            best_solution = candidate

    return best_solution
