def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    current = np.zeros(dim)
    best = current.copy()
    temperature = 1.0
    step_size = (ub - lb) / 2.0

    for _ in range(budget):
        new = current + rng.normal(0, step_size, size=dim)
        new = clip(new)

        delta = func(new) - func(current)
        if delta < 0 or rng.random() < np.exp(-delta/temperature):
            current = new
            if func(current) < func(best):
                best = current.copy()

        temperature *= 0.999

    return best
