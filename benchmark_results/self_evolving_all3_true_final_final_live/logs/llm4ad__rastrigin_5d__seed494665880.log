def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_particles = 50
    w = 0.7298
    c1 = 1.49618
    c2 = 1.49618
    x_min = np.zeros(D)
    x_max = np.ones(D) * (ub - lb)

    particles = rng.uniform(lb, ub, size=(n_particles, D))
    velocities = rng.uniform(-0.5, 0.5, size=(n_particles, D))

    p_best = particles.copy()
    g_best = np.zeros(D)
    f_g_best = func(g_best)

    for _ in range(budget):
        for i in range(n_particles):
            x_new = particles[i] + velocities[i]
            x_new = np.clip(x_new, lb, ub)
            f_x_new = func(x_new)

            if f_x_new < func(p_best[i]):
                p_best[i] = x_new
                if f_x_new < f_g_best:
                    g_best = p_best[i]
                    f_g_best = f_x_new

        r1 = rng.uniform(0, 1)
        r2 = rng.uniform(0, 1)

        for i in range(n_particles):
            p_best_i = p_best[i]
            g_best_i = g_best
            velocities[i] = w * velocities[i] + c1 * r1 * (p_best_i - particles[i]) + \
                            c2 * r2 * (g_best_i - particles[i])

    return g_best
