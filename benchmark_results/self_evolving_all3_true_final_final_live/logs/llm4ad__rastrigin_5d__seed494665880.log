def algorithm(func, dim, lb, ub, budget, rng):
    def rastrigin(x):
        return func(x)

    n = dim
    pop_size = 50
    F = 0.5
    CR = 1.0
    T = 10000
    temp = 10
    t = 0

    # Initialize population
    x = np.random.uniform(lb, ub, (pop_size, n))

    while True:
        for i in range(pop_size):
            # Differential Evolution step
            r1, r2, r3 = rng.choice(pop_size, size=3, replace=False)
            v = x[r1] + F * (x[r2] - x[r3])
            v = np.clip(v, lb, ub)

            # Crossover
            u = np.copy(x[i])
            for j in range(n):
                if rng.random() < CR or j == rng.randint(0, n-1):
                    u[j] = v[j]

            # Simulated Annealing step
            delta = rastrigin(u) - rastrigin(v)
            if delta > 0:
                x[i] = u
            else:
                p = np.exp(-delta / temp)
                if rng.random() < p:
                    x[i] = u

        t += 1
        if t >= T or np.min(rastrigin(x)) == rastrigin(np.zeros(n)):
            break

    best_x = np.argmin(rastrigin(x))
    return np.clip(x[best_x], lb, ub)
