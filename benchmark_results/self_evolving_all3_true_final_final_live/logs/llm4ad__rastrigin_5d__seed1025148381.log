def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_candidate = rng.uniform(lb, ub, size=dim)
    best_value = func(clip(best_candidate))

    for _ in range(budget):
        step_size = 0.1 * (ub - lb) / dim
        new_candidate = clip(best_candidate + rng.normal(size=dim) * step_size)
        new_value = func(new_candidate)

        if new_value < best_value:
            best_candidate = new_candidate
            best_value = new_value

    return best_candidate
