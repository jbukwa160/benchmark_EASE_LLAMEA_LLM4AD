def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def evaluate(x):
        return func(x)

    best = np.zeros(dim)
    for i in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        y = rng.uniform(lb, ub, size=dim)
        z = rng.uniform(lb, ub, size=dim)
        
        # Differential Evolution
        trial = clip(x + 0.1 * (y - best), lb, ub)
        if evaluate(trial) < evaluate(best):
            best = trial

        # Simulated Annealing
        T = 1 / np.log(i + 2)
        if rng.uniform(0, 1) > np.exp((evaluate(x) - evaluate(best)) / T):
            best = x

    return clip(best, lb, ub)
