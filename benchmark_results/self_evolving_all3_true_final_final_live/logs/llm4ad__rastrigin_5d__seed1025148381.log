def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    F = 0.5  # Scaling factor for mutation
    CR = 0.9  # Crossover rate
    x_best = rng.uniform(lb, ub, size=(pop_size, dim))
    f_best = np.zeros(pop_size)
    for _ in range(budget):
        y = x_best.copy()
        for i in range(pop_size):
            r1 = rng.randint(0, pop_size)
            while r1 == i:
                r1 = rng.randint(0, pop_size)
            v = F * (y[r1] - x_best[i]) + rng.uniform(-1, 1, size=(dim))
            y[i] = (v + x_best[i]) * CR + x_best[i] * (1 - CR)
            if lb <= y[i].min() and y[i].max() <= ub:
                y[i] = np.clip(y[i], a_min=lb, a_max=ub)
        f = func(y)
        for i in range(pop_size):
            if f[i] < f_best[i]:
                x_best[i] = y[i]
                f_best[i] = f[i]
    return x_best[np.argmin(f_best)]
