def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_process(x_train, y_train, x_test):
        from scipy.stats import norm
        K = np.zeros((len(x_train), len(x_train)))
        for i in range(len(x_train)):
            for j in range(len(x_train)):
                K[i, j] = np.sum((x_train[i] - x_train[j])**2)
        alpha = 1e-8
        L = np.linalg.cholesky(K + alpha * np.eye(len(x_train)))
        mu = np.dot(L, np.linalg.solve(L.T, y_train))
        sigma = np.sqrt(np.diag(np.dot(L, L.T)) - 1) / (len(x_train) ** .5)
        return mu, sigma

    def evolution_strategy(mu, sigma):
        x_new = mu + sigma * rng.randn(dim)
        x_new = np.clip(x_new, lb, ub)
        return func(x_new), x_new

    n_iter = 0
    best_x = None
    best_y = float('inf')
    
    while n_iter < budget:
        x_train = []
        y_train = []
        
        for i in range(5):
            mu, sigma = gaussian_process(np.array(x_train).reshape(-1, dim), np.array(y_train), None)
            y_i, x_i = evolution_strategy(mu, sigma)
            
            if y_i < best_y:
                best_x = x_i
                best_y = y_i
                
            x_train.append(x_i)
            y_train.append(y_i)
        
        n_iter += 1
    
    return np.array(best_x)
