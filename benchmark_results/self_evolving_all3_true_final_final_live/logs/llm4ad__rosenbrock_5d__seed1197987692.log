def algorithm(func, dim, lb, ub, budget, rng):
    def func_val(x):
        return func(x)

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func_val(x_best)

    n_iter = 0
    while n_iter < budget:
        n_offspring = int(1.2 * dim**2)
        offspring = np.clip(rng.normal(loc=x_best, scale=np.ones(dim), size=(n_offspring, dim)),
                            a_min=lb, a_max=ub)
        f_values = func_val(offspring)

        idx_sorted = np.argsort(f_values)[:int(n_offspring/10)]
        x_new = np.mean(offspring[idx_sorted], axis=0)

        if func_val(x_new) < f_best:
            x_best = x_new
            f_best = func_val(x_new)
            n_iter = 1

        if n_iter > 20 and np.all(func_val(np.clip(offspring, a_min=lb, a_max=ub)) >= f_best):
            break

        x_best = (x_best * (1 - 0.01) + rng.normal(loc=x_new, scale=np.ones(dim), size=dim) * 0.02)
        n_iter += 1

    return np.clip(x_best, a_min=lb, a_max=ub)
