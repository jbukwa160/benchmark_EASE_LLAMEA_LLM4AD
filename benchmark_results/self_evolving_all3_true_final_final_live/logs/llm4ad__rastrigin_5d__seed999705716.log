def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    current_best = np.zeros(dim)
    best_value = float('inf')

    while budget > 0:
        # Allocate budget to promising regions
        sigma = (ub - lb) / 2.0
        std_dev = max(1e-6, (ub - lb) * rng.uniform(0, 1))

        # Sample new candidates from current best
        x_new = clip(current_best + np.random.normal(size=(budget, dim)) * std_dev, lb, ub)

        # Evaluate new candidates and update best
        values = func(x_new)
        idx = np.argpartition(values, 0)[:int(budget / 2)]
        x_new = x_new[idx]
        values = values[idx]

        for i in range(int(budget / 2)):
            if values[i] < best_value:
                current_best = x_new[i]
                best_value = values[i]
                budget -= int(budget / 2)

    return clip(current_best, lb, ub)
