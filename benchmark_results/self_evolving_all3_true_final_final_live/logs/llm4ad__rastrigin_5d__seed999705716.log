def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = 10 * dim
    n_gen = int(budget / (pop_size * dim))
    
    x_best = None
    
    for gen in range(n_gen):
        X = rng.uniform(lb, ub, size=(pop_size, dim))
        
        y = func(clip(X))
        idx_best = np.argmin(y)
        
        if x_best is None or y[idx_best] < func(x_best):
            x_best = clip(X[idx_best])
            
        F = 0.5 - rng.uniform(0, 1) * 0.3
        CR = 0.9 + rng.uniform(0, 1) * 0.1
        
        for i in range(pop_size):
            trial = X[i]
            
            if rng.uniform(0, 1) < CR:
                idx_r = np.random.choice(pop_size, size=dim, replace=False)
                idx_d = np.random.choice(dim, size=2)
                
                trial[idx_d] += F * (clip(X[idx_r[0], idx_d]) - clip(X[idx_r[1], idx_d]))
            
            y_trial = func(clip(trial))
            
            if y_trial < y[i]:
                X[i] = trial
                y[i] = y_trial
                
        if n_gen % 10 == 0 or gen == n_gen - 1:
            print(f"Generation: {gen}, Best f(x): {func(x_best)}")
    
    return x_best
