def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(budget):
        y = x + 0.5 * rng.normal(size=(dim,))
        y = clip(y)
        
        f_y = func(y)
        
        if f_y < best_f:
            best_f = f_y
            best_x = y.copy()
            
        alpha = np.exp(-i / budget)
        beta = (1 - alpha) * 0.2
        
        z = y + alpha * rng.normal(size=(dim,))
        z = clip(z)
        
        f_z = func(z)
        
        if f_z < best_f:
            x = z.copy()
            
    return best_x
