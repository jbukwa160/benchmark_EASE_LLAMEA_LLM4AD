def algorithm(func, dim, lb, ub, budget, rng):
    def wrapper(x):
        return func(np.clip(x, lb, ub))

    bounds = [(lb, ub) for _ in range(dim)]
    result_de = differential_evolution(wrapper, bounds, maxiter=budget)
    
    x_best = np.array(result_de.x)
    f_best = result_de.fun
    
    def local_search(x0):
        def wrapper_local(x):
            return func(np.clip(x, lb, ub))
        
        res = minimize(wrapper_local, x0, method="SLSQP", bounds=[(lb, ub) for _ in range(dim)])
        return res.x
        
    best_x = x_best
    for i in rng.randint(0, budget, size=budget):
        x_new = local_search(best_x)
        if func(np.clip(x_new, lb, ub)) < f_best:
            f_best = func(np.clip(x_new, lb, ub))
            best_x = x_new
    
    return np.array([best_x])
