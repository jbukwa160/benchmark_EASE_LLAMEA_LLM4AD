def algorithm(func, dim, lb, ub, budget, rng):
    N = 50
    pop_size = 100
    sigma = 1.0
    min_sigma = 0.01
    max_sigma = 10.0
    best = None
    for i in range(budget):
        X = np.random.normal(loc=rng.uniform(lb, ub), scale=sigma, size=(pop_size, dim))
        X = np.clip(X, lb, ub)
        Y = func(X)
        idx = np.argsort(Y)[:1]
        if best is None or Y[idx] < func(best):
            best = X[idx]
        sigma = max(min_sigma, min(max_sigma, 0.9*sigma + 0.01*np.random.normal()))
    return best
