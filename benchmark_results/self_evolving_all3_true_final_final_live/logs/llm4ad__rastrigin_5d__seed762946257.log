def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    def clip(x):
        return np.clip(x, lb, ub)

    n = len(rng)
    x_best = np.zeros(dim)
    f_best = float('inf')
    T = 100.0
    step_size = 1e-2

    for i in range(budget):
        if rng[i] < 0.5:
            # Simulated Annealing (SA) phase
            x_new = clip(x_best + np.random.uniform(-step_size, step_size, dim))
            f_new = f(x_new)
            alpha = np.exp(-(f_new - f_best) / T)
            if rng[i] < alpha or f_new < f_best:
                x_best = x_new
                f_best = f_new

        else:
            # Bayesian Optimization (BO) phase
            gp_model = GaussianProcessRegressor(nugget=1e-2, kernel=RBF(1.0))
            gp_model.fit(x_best.reshape(-1, dim), np.array([f_best]))

            x_new = gp_model.sample_y(fBest=f_best, n_samples=100)
            f_new = np.min(np.array([f(x) for x in x_new]))
            x_idx = np.argmin(np.array([f(x) for x in x_new]))
            x_new = clip(x_new[x_idx])

            if rng[i] < np.exp(-(f_new - f_best)):
                x_best = x_new
                f_best = f_new

    return x_best
