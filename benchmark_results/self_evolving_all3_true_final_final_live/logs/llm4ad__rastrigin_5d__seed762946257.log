def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(lb, ub, rng):
        return [lb + (ub - lb) * rng for _ in range(dim)]

    def clip(candidate, lb, ub):
        return [min(max(x, lb), ub) for x in candidate]

    population_size = 50
    population = [get_candidate(lb, ub, rng) for _ in range(population_size)]
    best_individual = np.array([0.0] * dim)
    for t in range(budget):
        # Crossover: choose two random parents and create a child by replacing each dimension with the parent's value
        children = []
        for i in rng.sample(range(population_size), population_size // 2):
            for j in rng.sample(range(population_size), population_size // 2):
                child = population[i].copy()
                for k in range(dim):
                    if rng.random() < 0.5:
                        child[k] = population[j][k]
                children.append(child)
        # Mutation: for each dimension of the child, perturb it with a probability determined by a custom strategy
        for i, child in enumerate(children):
            prob = 1 / (t + 1) * np.exp(-abs(func(child)) / budget)
            for j in range(dim):
                if rng.random() < prob:
                    mu = population[np.argmax([func(c) for c in children])][j]
                    delta = rng.uniform(-1, 1)
                    child[j] += delta * (mu - child[j])
        # Selection: select the best individual from the current population and all new individuals
        population = [clip(child, lb, ub) if t < budget // 2 else np.array([0.0] * dim) for child in children]
        scores = [func(individual) for individual in population]
        idx = np.argmin(scores)
        best_individual = clip(population[idx], lb, ub)
    return best_individual
