    lambda_ = 10
    sigma = 0.5
    D = int(np.sqrt(dim))
    x_best = rng.uniform(lb, ub, size=(dim,))
    f_best = func(x_best)
    
    for i in range(budget):
        while True:
            y = np.clip(rng.normal(loc=x_best, scale=sigma, size=(dim,)), a_min=lb, a_max=ub)
            y_subset = y[np.random.choice(dim, D, replace=False)]
            y_candidate = y_subset + 0.5 * rng.normal(size=y_subset.shape) 
            f_candidate = func(y_candidate)
            
            if f_candidate < f_best:
                x_best = y_candidate
                f_best = f_candidate
                break
        
        sigma *= (1 - 1 / (budget + i))
    
    return x_best
