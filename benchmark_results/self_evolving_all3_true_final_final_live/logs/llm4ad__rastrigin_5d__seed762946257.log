def algorithm(func, dim, lb, ub, budget, rng):
    D = np.sqrt((ub - lb)**2 + 1e-8)
    
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)
    
    for _ in range(budget):
        x_cand = x_best + D * rng.randn(dim)
        
        # Clip candidates to [lb, ub]
        x_cand = np.clip(x_cand, lb, ub)
        
        f_cand = func(x_cand)
        
        if f_cand < f_best:
            x_best = x_cand
            f_best = f_cand
            
    return x_best
