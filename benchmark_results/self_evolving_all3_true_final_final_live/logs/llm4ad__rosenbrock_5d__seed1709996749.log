def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    max_iter = budget // (dim * pop_size)
    p = 0.9
    mu = 1e-6
    n_pop = int(budget / max_iter)

    def get_candidate(bounds):
        x = np.zeros(dim)
        for i in range(dim):
            x[i] = rng.uniform(bounds[0], bounds[1])
        return x

    def clip(x, bounds):
        return np.clip(x, bounds[0], bounds[1])

    def evaluate(x):
        return func(x)

    pop = [get_candidate((lb, ub)) for _ in range(pop_size)]
    pop_best = [evaluate(x) for x in pop]

    for iter_ in range(max_iter):
        for i in range(n_pop):
            x_new = clip(get_candidate((lb, ub)), (lb, ub))
            fit_new = evaluate(x_new)
            if fit_new < min(pop_best):
                pop[i] = x_new
                pop_best[i] = fit_new

        for i in range(n_pop):
            x1, x2 = rng.choice(pop_size, 2, replace=False)
            u = np.random.uniform(0, 1, dim) ** (p - 1)
            v = rng.uniform(0, 1, dim)
            x_new = clip((pop[x1] + u * (pop[x2] - pop[x1])) + mu * v, (lb, ub))
            fit_new = evaluate(x_new)
            if fit_new < min(pop_best):
                pop[i] = x_new
                pop_best[i] = fit_new

        for i in range(n_pop):
            if rng.random() < 0.1:
                x = get_candidate((lb, ub))
                pop[i] = clip(x, (lb, ub))

    best = min(pop, key=evaluate)
    return np.array(best)
