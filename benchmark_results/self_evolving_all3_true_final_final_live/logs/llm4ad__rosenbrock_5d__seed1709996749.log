def algorithm(func, dim, lb, ub, budget, rng):
    def grad(x):
        x = np.array(x)
        d = np.zeros(dim)
        for i in range(dim-1):
            d[i] += 400 * (x[i+1] - x[i]**2) * (2*x[i] - 2*(x[i+1] - x[i]**2))
            d[i] -= 2 * (x[i] - 1)
        return d

    def grad_norm(x):
        return np.linalg.norm(grad(x))

    best_x = rng.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for _ in range(budget):
        gp = GaussianProcess(kernel=np.random.choice(['matern32', 'squared_exponential']))
        gp.fit(rng.uniform(lb, ub, (100, dim)))

        x = gp.predict(np.array([[np.mean([lb, ub])] * dim]))

        if grad_norm(x) > 1e-3:
            # gradient-based local search
            step_size = 0.01
            for _ in range(10):
                new_x = x + np.clip(step_size * grad(x), -1e-4, None)
                new_f = func(new_x)
                if new_f < best_f:
                    best_x = new_x
                    best_f = new_f
                x = new_x

        else:
            # Bayesian optimization
            x = gp.sample(100)

            for xi in x:
                f = func(xi)
                if f < best_f:
                    best_x = xi
                    best_f = f

    return best_x
