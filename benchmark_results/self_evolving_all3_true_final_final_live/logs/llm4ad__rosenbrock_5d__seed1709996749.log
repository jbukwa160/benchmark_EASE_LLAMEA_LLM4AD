def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for _ in range(budget):
        x_new = best_x + np.clip(rng.normal(size=dim), -1, 1) * 0.01
        f_new = func(x_new)

        if f_new < best_f:
            best_f = f_new
            best_x = x_new

        # Clip candidates to [lb, ub]
        for i in range(dim):
            if x_new[i] < lb:
                x_new[i] = lb
            elif x_new[i] > ub:
                x_new[i] = ub

    return best_x
