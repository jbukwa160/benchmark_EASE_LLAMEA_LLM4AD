def algorithm(func, dim, lb, ub, budget, rng):
    population_size = 50
    generations = int(budget / population_size)
    f = lambda x: func(x) + 1e6 * np.sum(np.abs(x))  # penalty function for infeasible solutions
    bounds = [(lb, ub)] * dim

    def generate_initial_population(rng):
        return rng.uniform(lb, ub, (population_size, dim))

    def differential_evolution(population, bounds, f, budget):
        mutation_rate = 0.5
        crossover_rate = 0.5
        while budget > 0:
            np.random.shuffle(population)
            for i in range(population_size):
                if rng.rand() < crossover_rate:
                    candidate = population[i] + mutation_rate * (population[np.random.randint(0, population_size), :] - population[(i-1) % population_size, :])
                else:
                    candidate = population[i]
                candidate = np.clip(candidate, bounds[0][0], bounds[0][1])
                if f(candidate) < f(population[i]):
                    population[i] = candidate
            budget -= 1
        return population[np.argmin([f(x) for x in population])]

    initial_population = generate_initial_population(rng)
    best_solution = differential_evolution(initial_population, bounds, f, generations)

    return best_solution
