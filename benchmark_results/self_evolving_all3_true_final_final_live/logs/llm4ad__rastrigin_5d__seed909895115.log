def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    D = 0.9  # differential evolution parameter
    T_initial = 1000  # initial temperature for simulated annealing
    alpha = 0.99  # cooling rate for simulated annealing

    x = np.zeros(dim)
    x_best = np.copy(x)
    f_x_best = func(x)

    for _ in range(budget):
        y = np.array([random.uniform(lb, ub) for _ in range(dim)])
        z = np.array([random.uniform(lb, ub) for _ in range(dim)])

        # Differential evolution step
        v = D * y + (1 - D) * x_best

        # Clip to bounds
        v = clip(v, lb, ub)

        f_v = func(v)
        if f_v < f_x_best:
            x_best = np.copy(v)
            f_x_best = f_v

        # Simulated annealing step
        delta = f_x_best - f_v
        T_current = max(1, T_initial * alpha ** _)
        if delta < 0 or random.random() < np.exp(-delta / T_current):
            x_best = np.copy(v)
            f_x_best = f_v

    return x_best
