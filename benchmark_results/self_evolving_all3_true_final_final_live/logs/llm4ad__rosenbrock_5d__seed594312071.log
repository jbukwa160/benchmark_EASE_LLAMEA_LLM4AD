def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        r = 5.0 / (_ + 2)**(1/6)
        std_dev = max(r / np.sqrt(dim), 0.01)

        new_x = x + rng.uniform(-1, 1, (x.shape[0], dim)) * std_dev
        new_x = np.clip(new_x, lb, ub)

        new_f = func(new_x)

        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f

        x = best_x.copy()

    return best_x
