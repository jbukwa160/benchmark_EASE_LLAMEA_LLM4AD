def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    for i in range(budget):
        # Generate a candidate solution with noise added to previous best
        x_candidate = x_best + 0.1 * rng.randn(dim)
        
        # Clip the candidate solution to bounds
        x_candidate = np.clip(x_candidate, lb, ub)
        
        # Evaluate the function at the candidate solution
        f_candidate = func(x_candidate)
        
        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate
            
    return x_best
