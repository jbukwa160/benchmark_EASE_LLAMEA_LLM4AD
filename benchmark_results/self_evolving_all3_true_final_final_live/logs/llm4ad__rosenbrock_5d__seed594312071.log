def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    def generate_candidates(pop_size, mean, sigma):
        return np.clip(mean + rng.normal(0, sigma, size=(pop_size, dim)), lb, ub)

    def evaluate(candidate):
        return func(candidate)

    best = None
    max_budget = budget // (dim * 2)
    for _ in range(max_budget):
        if budget < dim * 2:
            break

        pop_size = int(np.sqrt(budget))
        candidates = generate_candidates(pop_size, np.zeros(dim), 1.0)
        fitnesses = [evaluate(candidate) for candidate in candidates]
        mean = np.mean(candidates, axis=0)
        sigma = np.std(candidates, axis=0)

        if best is None or evaluate(best) > min(fitnesses):
            best = candidates[np.argmin(fitnesses)]

        for _ in range(pop_size):
            indices = rng.choice(dim, size=int(np.sqrt(budget)), replace=False)
            new_candidates = generate_candidates(1, clip(candidates[indices] + rng.normal(0, sigma[indices], size=(len(indices), dim))), 1.0)
            fitnesses.extend([evaluate(candidate) for candidate in new_candidates])
            candidates.extend(new_candidates)

        mean = np.mean(candidates, axis=0)
        sigma = np.std(candidates, axis=0)
        budget -= pop_size * 2

    return best
