def algorithm(func, dim, lb, ub, budget, rng):
    D = 1e-8  # jitter value
    n_init = int(2 * (ub - lb) * rng.uniform(0.5, 1.5))
    X_init = np.random.uniform(lb, ub, size=(n_init, dim))
    y_init = func(X_init)
    
    for _ in range(budget):
        # select the next point to evaluate using Expected Improvement
        mu, sigma = gp.predict(X_init[:, None], return_std=True)
        with rng:
            idx_next = np.argmax(np.max(-mu + D * (1 - (np.exp(-10 * ((y_init - mu)**2 / sigma**2)))) , axis=0))
        
        # evaluate the function at the selected point
        X_next = X_init[idx_next, None]
        y_next = func(X_next)
        
        # update the GP model with new observation
        gp.fit(np.vstack([X_init, X_next]), np.append(y_init, y_next))
        
        # clip candidates to [lb, ub]
        X_next_clip = np.clip(X_next, lb, ub)
        
        # add new point to the set of samples
        X_init = np.vstack([X_init, X_next_clip])
        y_init = np.append(y_init, y_next)
    
    # return the best 1-D numpy array found
    idx_best = np.argmin(func(X_init))
    return X_init[idx_best]
