def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(current_best):
        candidate = current_best + rng.uniform(-1, 1, size=dim)
        return clip(candidate)

    T = 10.0
    num_restarts = int(budget / (budget // 100))
    for _ in range(num_restarts):
        current_best = np.zeros(dim)
        for _ in range(int(budget // num_restarts)):
            candidate = generate_candidate(current_best)
            new_cost = func(candidate)
            if new_cost < func(current_best):
                current_best = candidate
            T *= 0.99
            if rng.uniform(0, 1) > np.exp((func(current_best) - new_cost) / T):
                current_best = candidate
    return clip(current_best)
