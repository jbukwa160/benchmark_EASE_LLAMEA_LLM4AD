def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.zeros(dim)
    best_x = np.copy(x)
    step_size = 5.0

    for _ in range(budget):
        x += (np.random.rand(dim) - 0.5) * step_size
        x = clip(x)

        f_value = func(x)

        if f_value < func(best_x):
            best_x = np.copy(x)

        # Adaptive learning rate
        std_dev = np.std(x)
        step_size *= max(1e-2, 1 - (std_dev / (5.0 + 1e-6)))

    return best_x
