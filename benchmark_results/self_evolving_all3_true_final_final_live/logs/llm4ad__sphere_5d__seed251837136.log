def algorithm(func, dim, lb, ub, budget, rng):
    X = [np.array([rng.uniform(lb, ub) for _ in range(dim)])]
    min_val = float('inf')
    best_sol = None
    
    for _ in range(budget):
        new_x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
        
        # Check if the new point is already in X
        if any(np.all(x == new_x) for x in X):
            continue
        
        # Add the new point to X
        X.append(new_x)
        
        # Evaluate the function at the new point
        val = func(new_x)
        
        # Update the best solution found so far
        if val < min_val:
            min_val = val
            best_sol = new_x
            
    return best_sol
