def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        g = 0
        v = 0
        
        for i in range(dim):
            x_new = x.copy()
            x_new[0, i] += np.random.uniform(-1, 1)
            
            if any(np.logical_or(x_new < lb, x_new > ub)):
                continue
            
            f_new = func(x_new)
            g += (x_new - x) / rng
            v += (f_new - best_f) * g
            
        alpha = 0.01 / np.sqrt(rng)
        
        for i in range(dim):
            if g[i] != 0:
                x[0, i] -= (v[i] / np.linalg.norm(g[i]) ** 2 + alpha * rng * g[i]) / rng
                
        best_x = np.minimum(np.maximum(x, lb), ub)
        f_best = func(best_x)
        
        if f_best < best_f:
            best_f = f_best
            best_x = x.copy()
    
    return best_x[0]
