def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget - 1):
        x = rng.uniform(lb, ub, size=dim)
        if func(x) < f_best:
            f_best = func(x)
            x_best = x

    return np.clip(x_best, lb, ub)
