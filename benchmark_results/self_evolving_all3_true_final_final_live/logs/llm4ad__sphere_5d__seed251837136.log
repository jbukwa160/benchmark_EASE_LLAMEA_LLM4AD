def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(-5, 5, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(budget):
        step_size = 0.1 / (i + 1) ** 0.6
        dx = np.zeros(dim)
        
        for j in range(dim):
            noise = rng.uniform(-1, 1)
            delta = lb + (ub - lb) * rng.uniform(0, 1)
            
            x_plus_delta = best_x.copy()
            x_plus_delta[j] += delta
            
            if func(x_plus_delta) < best_f:
                dx[j] = delta
                best_x = x_plus_delta
                best_f = func(best_x)
        
        for j in range(dim):
            noise = rng.uniform(-1, 1)
            delta = lb + (ub - lb) * rng.uniform(0, 1)
            
            x_minus_delta = best_x.copy()
            x_minus_delta[j] -= delta
            
            if func(x_minus_delta) < best_f:
                dx[j] -= delta
                best_x = x_minus_delta
                best_f = func(best_x)
        
        x += step_size * dx
        
        # clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
    
    return best_x
