def algorithm(func, dim, lb, ub, budget, rng):
    best_solution = np.full(dim, 0)
    best_fitness = float('inf')
    current_solution = np.random.uniform(lb, ub, size=dim)

    learning_rate = 1.0
    for _ in range(budget):
        candidate = current_solution + np.random.uniform(-learning_rate, learning_rate, size=dim)
        clipped_candidate = np.clip(candidate, lb, ub)
        
        fitness = func(clipped_candidate)
        if fitness < best_fitness:
            best_fitness = fitness
            best_solution = clipped_candidate

        if rng.rand() < 0.1:  # adaptive learning rate
            learning_rate *= 0.9
        else:
            current_solution = np.clip(current_solution + np.random.uniform(-learning_rate, learning_rate, size=dim), lb, ub)

    return best_solution
