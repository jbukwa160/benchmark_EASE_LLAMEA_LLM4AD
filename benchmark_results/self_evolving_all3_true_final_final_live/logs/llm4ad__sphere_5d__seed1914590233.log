def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    F = 0.5
    CR = 0.1
    max_iter = int(budget)
    
    x = np.random.uniform(lb, ub, (pop_size, dim))
    y = func(x)
    
    best = np.argmin(y)
    best_x = x[best]
    
    for i in range(max_iter):
        for j in range(pop_size):
            r1 = rng.randint(0, pop_size - 1)
            while r1 == j:
                r1 = rng.randint(0, pop_size - 1)
            r2 = rng.randint(0, pop_size - 1)
            while r2 == j or r2 == r1:
                r2 = rng.randint(0, pop_size - 1)
            v = x[r1] + F * (x[r2] - x[j])
            
            u = np.zeros(dim)
            for k in range(dim):
                if rng.random() < CR or x[j][k] == v[k]:
                    u[k] = np.clip(v[k], lb, ub)
                else:
                    u[k] = x[j][k]
                    
            y_new = func(np.array([np.clip(u, lb, ub)]))
            y[j] = y_new
            
        best_j = np.argmin(y)
        if y[best_j] < y[best]:
            best_x = x[best_j]
            best = best_j
    
    return best_x
