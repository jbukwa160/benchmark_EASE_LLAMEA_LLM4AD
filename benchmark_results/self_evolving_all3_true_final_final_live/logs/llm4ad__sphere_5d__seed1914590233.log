def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    step = 0.5 * (ub - lb) / 2
    for _ in range(budget):
        new_x = x + step * rng.normal(size=dim)
        new_x = np.clip(new_x, lb, ub)
        f_new = func(new_x)
        f_best = func(best_x)
        if f_new < f_best:
            best_x = new_x
        elif rng.uniform(0, 1) > (f_new - f_best) / (func(x) - f_best):
            x = new_x
        step *= 0.9
    return best_x
