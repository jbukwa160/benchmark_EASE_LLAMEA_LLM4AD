def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    sigma = 5.0
    for _ in range(budget):
        x_candidate = np.clip(lb + (ub - lb) * rng.uniform(size=dim), a_min=lb, a_max=ub)
        f_candidate = func(x_candidate)
        if f_candidate < x_best[-np.inf]:
            x_best = x_candidate
    return x_best
