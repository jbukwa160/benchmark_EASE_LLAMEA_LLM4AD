def algorithm(func, dim, lb, ub, budget, rng):
    def func_candidate(candidate):
        return func(np.clip(candidate, lb, ub))

    initial_candidate = [random.uniform(lb, ub) for _ in range(dim)]
    best_candidate = initial_candidate.copy()
    current_candidate = initial_candidate
    temperature = 1.0

    for iteration in range(budget):
        new_candidate = current_candidate.copy()
        i = np.random.randint(0, dim)
        new_candidate[i] += rng.uniform(-temperature, temperature)
        
        if func_candidate(new_candidate) < func_candidate(current_candidate):
            current_candidate = new_candidate
        else:
            probability = 1 - (func_candidate(new_candidate) / func_candidate(current_candidate))
            if random.random() > np.exp(probability / temperature):
                current_candidate = new_candidate
        
        if func_candidate(current_candidate) < func_candidate(best_candidate):
            best_candidate = current_candidate

        temperature *= 0.99  # annealing schedule
        if iteration % (budget // 10) == 0:
            for _ in range(5):  # local search refinement
                new_candidate = current_candidate.copy()
                i = np.random.randint(0, dim)
                new_candidate[i] += rng.uniform(-1e-3, 1e-3)
                if func_candidate(new_candidate) < func_candidate(current_candidate):
                    current_candidate = new_candidate

    return best_candidate
