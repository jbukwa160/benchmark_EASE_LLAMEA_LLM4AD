def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_candidate(mean, sigma):
        return mean + sigma * rng.normal(size=dim)

    x = rng.uniform(lb, ub, size=dim)
    pop_size = 10
    mu = np.zeros(dim)
    cov = np.eye(dim) * 0.1
    lambda_ = 2 + int(np.log(2 * budget / dim))
    sigma = 5

    for i in range(budget):
        pop = [clip(generate_candidate(x, sigma)) for _ in range(pop_size)]
        pop = np.array(pop)
        mu_new = np.mean(pop, axis=0)
        cov_new = (1 - 2/lambda_) * cov + 1/(lambda_*dim) * np.dot((pop-mu_new[:, None]).T, pop-mu_new[:, None])
        sigma_new = np.sqrt(np.diag(cov_new))
        x = mu_new

        if i % 100 == 0 or budget - i < 100:
            f_x = func(x)
            print(f"Generation {i}: Best function value: {f_x}")

    return clip(x)
