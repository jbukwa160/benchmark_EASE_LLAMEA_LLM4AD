def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x)  # 10n + sum(x_i^2 - 10*cos(2*pi*x_i))

    best = np.zeros(dim)
    best_eval = float('inf')
    restarts = 0

    for _ in range(budget):
        if rng.random() < 0.1:  # probabilistic restart
            x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
            candidate_eval = evaluate(clip(x))
            if candidate_eval < best_eval:
                best_eval = candidate_eval
                best = x

        else:  # Differential Evolution
            population_size = 50
            population = np.zeros((population_size, dim))
            for i in range(population_size):
                population[i] = clip(np.array([rng.uniform(lb, ub) for _ in range(dim)]))

            offspring = np.copy(population)
            for i in range(population_size):
                r1, r2, r3 = rng.randint(0, population_size), rng.randint(0, population_size), rng.randint(0, population_size)
                while r1 == i or r2 == i or r3 == i:
                    r1, r2, r3 = rng.randint(0, population_size), rng.randint(0, population_size), rng.randint(0, population_size)

                mutation = 0.7 * (population[r1] - population[r2]) + 0.3 * (population[r3])
                offspring[i] += mutation
                if rng.random() < 0.5:  # crossover with parent
                    offspring[i] *= 1 - 0.1

            candidate_eval = evaluate(clip(offspring))
            if candidate_eval < best_eval:
                best_eval = candidate_eval
                best = clip(offspring)

        if _ % (budget // 10) == 0 and restarts < 5:
            print(f"Restart {_+1} of {budget}")
            restarts += 1

    return best
