def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(size, dim, lb, ub):
        return np.random.uniform(lb, ub, (size, dim))

    def differential_evolution(population, objective, bounds, budget):
        for _ in range(budget // 10):
            mutant = population + rng.rand(population.shape) * (bounds[:, 1] - bounds[:, 0])
            crossover = np.zeros_like(mutant)
            indices = np.random.choice(population.shape[0], size=population.shape[0], replace=False)
            for i in range(population.shape[0]):
                if rng.rand() < 0.5:
                    crossover[i] = mutant[i]
                else:
                    crossover[i] = population[indices[i]]
            fitness = objective(crossover)
            indices = np.argsort(fitness)
            population = population[indices[:int(0.1 * population.shape[0])]]
        return population

    def restart(population, budget):
        for _ in range(budget // 10):
            new_population = generate_initial_population(100, dim, lb, ub)
            fitness = objective(new_population)
            indices = np.argsort(fitness)
            population = population[indices[:int(0.1 * population.shape[0])]]
        return population

    def run_algorithm(population, bounds, budget):
        for _ in range(budget // 10):
            mutant = population + rng.rand(population.shape) * (bounds[:, 1] - bounds[:, 0])
            crossover = np.zeros_like(mutant)
            indices = np.random.choice(population.shape[0], size=population.shape[0], replace=False)
            for i in range(population.shape[0]):
                if rng.rand() < 0.5:
                    crossover[i] = mutant[i]
                else:
                    crossover[i] = population[indices[i]]
            fitness = objective(crossover)
            indices = np.argsort(fitness)
            population = population[indices[:int(0.1 * population.shape[0])]]
        return population

    # Initialisation
    population = generate_initial_population(100, dim, lb, ub)

    # Run algorithm
    for _ in range(budget // 10):
        population = differential_evolution(population, objective, [[lb], [ub]], budget)
        population = restart(population, budget)
    result = run_algorithm(population, [[lb], [ub]], budget)

    return clip(result[0])
