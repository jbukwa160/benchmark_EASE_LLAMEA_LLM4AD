def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    D = rng.uniform(lb, ub, size=dim)
    B = 0.5 * (ub - lb) / 2
    best = D.copy()
    best_fitness = func(D)

    for i in range(budget):
        x1 = clip(D + rng.normal(0, B, size=dim))
        x2 = clip(D + rng.normal(0, B, size=dim))

        v1 = 0.5 * (x1 - D) / np.linalg.norm(x1 - D)
        v2 = 0.5 * (x2 - D) / np.linalg.norm(x2 - D)

        p = 0.9 + rng.uniform(0, 0.1)
        z = clip(D + p * (v1 + v2))

        if func(z) < best_fitness:
            best_fitness = func(z)
            best = z.copy()

    return best
