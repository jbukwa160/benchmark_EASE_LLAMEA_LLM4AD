def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    sigma = 1.0
    T = 1000.0
    current_best = func(clip(x))
    best_candidate = x

    for _ in range(budget):
        new_x = clip(best_candidate + rng.normal(size=dim) * sigma)
        new_value = func(new_x)

        if new_value < current_best:
            current_best = new_value
            best_candidate = new_x

        alpha = 0.99  # cooling factor
        T *= alpha

        if rng.uniform(0, 1) > np.exp((current_best - new_value) / T):
            current_best = new_value
            best_candidate = new_x

    return clip(best_candidate)
