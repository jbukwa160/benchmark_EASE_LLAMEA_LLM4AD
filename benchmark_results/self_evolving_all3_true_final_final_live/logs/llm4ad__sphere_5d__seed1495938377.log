def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    n = len(lb)
    x = rng.uniform(-5, 5, size=n)
    best_x = x.copy()
    best_f = func(best_x)
    temperature = 1.0

    for _ in range(budget):
        y = clip(rng.normal(x, scale=0.5))
        f = func(y)

        if f < best_f:
            best_f = f
            best_x = y.copy()

        delta = f - best_f
        alpha = np.exp(-temperature * abs(delta))
        temperature *= 1 + 0.01 * (best_f / budget)

        if rng.uniform(0, 1) > alpha:
            x = best_x.copy()
        else:
            x = y.copy()

    return best_x
