def algorithm(func, dim, lb, ub, budget, rng):
    def noise(x):
        return 1e-3 * rng.randn(dim)

    x_best = -5 + (5 - (-5)) * rng.uniform(size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        gp = GaussianProcessRegression()
        gp.fit(np.array([x_best]), np.array([f_best]))

        x_new = x_best + noise(x_best)
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new) + gp.predict(x_new)[0]

        if f_new < f_best:
            f_best = f_new
            x_best = x_new

    return x_best
