def algorithm(func, dim, lb, ub, budget, rng):
    best = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    for _ in range(budget):
        candidate = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
        if func(candidate) < func(best):
            best = candidate
    return best
