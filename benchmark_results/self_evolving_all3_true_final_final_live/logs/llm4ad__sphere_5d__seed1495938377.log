def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = -np.ones(dim)
    f_best = float('inf')

    for _ in range(budget):
        for i in range(dim):
            if rng.random() < 0.1:  # mutation with probability 10%
                scale = max(0.01, (budget - _) / budget) * 2
                x_new = clip(x_best + rng.normal(scale=scale, size=(dim,)))
            else:
                x_new = clip(rng.uniform(lb, ub, size=(dim,)))

            f_new = func(x_new)

            if f_new < f_best:
                f_best = f_new
                x_best = x_new

    return x_best
