def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    f_best = float('inf')
    
    for _ in range(budget):
        x = (ub - lb) * rng.rand(dim) + lb
        f_x = func(x)
        
        if f_x < f_best:
            best = x
            f_best = f_x
        
        if np.random.rand() < 0.1 and f_best > 1e-6:  # restart condition
            x_restart = (ub - lb) * rng.rand(dim) + lb
            f_x_restart = func(x_restart)
            
            if f_x_restart < f_best:
                best = x_restart
                f_best = f_x_restart
    
    return best
