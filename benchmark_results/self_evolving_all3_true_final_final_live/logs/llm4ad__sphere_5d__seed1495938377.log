def algorithm(func, dim, lb, ub, budget, rng):
    def clip_bounds(x, bounds):
        return np.clip(x, bounds[0], bounds[1])

    pop_size = 100
    mutation_prob = 0.5
    temperature = 10
    cooling_factor = 0.95

    best_x = np.zeros(dim)
    best_y = float('inf')

    population = np.random.uniform(lb, ub, (pop_size, dim))

    for i in range(budget):
        for x in population:
            mutated_x = x + np.dot(rng.randn(dim), mutation_prob)
            mutated_x = clip_bounds(mutated_x, (lb, ub))
            y = func(mutated_x)

            if y < best_y:
                best_y = y
                best_x = mutated_x

        temperature *= cooling_factor
        for j in range(pop_size):
            if np.random.rand() < 0.1:
                x = population[j]
                mutated_x = x + np.dot(rng.randn(dim), mutation_prob)
                mutated_x = clip_bounds(mutated_x, (lb, ub))
                y = func(mutated_x)

                if y < best_y:
                    best_y = y
                    best_x = mutated_x

            if temperature > 0.1 and random.random() < np.exp((best_y - func(x)) / temperature):
                population[j] = best_x

    return best_x
