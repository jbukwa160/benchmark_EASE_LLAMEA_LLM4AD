def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.minimum(np.maximum(candidate, lb), ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    for _ in range(budget):
        radius = 0.5
        while True:
            z = x + rng.uniform(-radius, radius, size=dim)
            z = clip(z)
            if func(z) < func(best_x):
                best_x = z
                radius *= 1.2
            else:
                radius /= 1.1
                break
    return best_x
