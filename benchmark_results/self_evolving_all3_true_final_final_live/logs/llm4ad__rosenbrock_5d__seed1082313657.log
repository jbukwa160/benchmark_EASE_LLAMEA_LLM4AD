def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (1, dim))
    
    for i in range(10):
        gp = GaussianProcessRegressor()
        gp.fit(x, func(x))
        
        x_new = x.copy()
        
        for j in range(budget // 10):
            x_sample = gp.sample_fidelity_lcc(x, func(x), rng)
            
            if np.any((x_sample < lb) | (x_sample > ub)):
                continue
            
            new_func_value = func(x_sample)
            
            gp.fit(np.vstack([x, x_sample]), np.hstack([func(x), new_func_value]))
            
            x_new = np.vstack([x_new, x_sample])
        
        best_idx = np.argmin(func(x_new))
        x = x_new[best_idx:best_idx+1]
    
    return x
