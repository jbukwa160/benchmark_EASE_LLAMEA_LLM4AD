def algorithm(func, dim, lb, ub, budget, rng):
    num_vars = 5
    sigma0 = 1.0
    mu = (np.ones(num_vars) * ub + np.ones(num_vars) * lb) / 2
    N, D = 100, num_vars
    lambda_ = int(N ** (D - 1))
    weights = [lambda_**-u for u in range(lambda_)]

    X = np.clip(mu.reshape(-1, 1) + rng.uniform(lb, ub, size=(N, dim)), lb, ub)
    C = np.eye(dim)

    best_x = mu.copy()
    best_y = func(best_x)

    iteration = 0
    while iteration < budget:
        F = func(X)
        
        u = np.random.choice(lambda_, p=weights)
        X_new = X[u] + C @ rng.normal(size=(1, dim))
        
        X_new = np.clip(X_new, lb, ub).flatten()
        y_new = func(X_new)

        if y_new < best_y:
            best_x = X_new
            best_y = y_new

        w = 2 * (F - best_y) / (F + 1e-8)
        C += 0.01 * np.outer(w, w)
        
        iteration += 1

    return best_x
