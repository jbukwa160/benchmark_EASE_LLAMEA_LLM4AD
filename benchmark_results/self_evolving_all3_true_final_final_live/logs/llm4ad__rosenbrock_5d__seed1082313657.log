def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    mutation_prob = 0.1
    max_iter = int(budget / (pop_size * dim))
    
    best_x = None
    best_y = float('inf')
    
    for _ in range(max_iter):
        x = np.random.uniform(lb, ub, size=(pop_size, dim))
        
        y = np.zeros(pop_size)
        for i in range(pop_size):
            y[i] = func(x[i])
            
        mask = rng.rand(pop_size) < mutation_prob
        x[mask] += rng.normal(size=(mask.sum(), dim)) * 0.1
        
        # clip candidates to [lb, ub]
        np.clip(x, lb, ub, out=x)
        
        i_best = np.argmin(y)
        if y[i_best] < best_y:
            best_x = x[i_best].copy()
            best_y = y[i_best]
            
    return best_x
