def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidates(candidates, lb, ub):
        return np.clip(candidates, lb, ub)

    def gradient_based_optimizer(func, x0, dim, lb, ub, max_iter):
        x = x0
        for _ in range(max_iter):
            g = np.zeros(dim)
            for i in range(dim-1):
                g[i] += 200*(x[i+1]-x[i]**2)*2*(x[i+1]-x[i]**2) - 400*(x[i+1]-x[i]**2)*(x[i+1]-x[i])
                g[i] -= 2*(1-x[i])**2
            g[-1] += 200*(x[-1]-x[-2]**2)**2 - 2*(1-x[-1])**2
            step_size = 0.01 * np.sqrt(np.sum(g**2))
            x = clip_candidates(x - step_size*g, lb, ub)
        return x

    def local_search(func, x, dim, lb, ub, max_iter):
        best_x = x.copy()
        for _ in range(max_iter):
            noise = rng.uniform(-1.0, 1.0, size=dim) / np.sqrt(dim)
            new_x = clip_candidates(best_x + 0.01*noise, lb, ub)
            f_new = func(new_x)
            if f_new < func(best_x):
                best_x = new_x
        return best_x

    x0 = (np.random.uniform(lb, ub) for _ in range(dim))
    x_best = gradient_based_optimizer(func, x0, dim, lb, ub, budget//2)
    x_local_search = local_search(func, x_best, dim, lb, ub, budget//4)

    return clip_candidates(x_local_search, lb, ub)
