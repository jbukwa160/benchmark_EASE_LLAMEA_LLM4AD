def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(candidate):
        return func(candidate)

    def cma_es(population, sigma):
        num_parents = int(0.1 * len(population))
        parents = population[np.argsort(-np.array([evaluate(x) for x in population]))[:num_parents]]
        cov = np.cov(np.transpose(parents), bias=True)
        weights = (cov ** (-0.5)) / np.sum(cov ** (-0.5))
        new_population = parents + sigma * np.random.multivariate_normal(np.zeros(dim), weights)
        return clip(new_population)

    def simulated_annealing(best, current):
        T = 1
        while True:
            if rng.uniform(0, 1) < np.exp((evaluate(current) - evaluate(best)) / T):
                best = current
            T *= 0.99
            if T < 1e-5 or not budget:
                return

    population = clip(rng.uniform(lb, ub, size=(budget, dim)))
    for _ in range(budget * 10):  # Increase the number of iterations to improve results
        population = cma_es(population, sigma=0.1)
        best = np.max(np.array([evaluate(x) for x in population]))
        current = rng.choice(population[np.argmax(np.array([evaluate(x) for x in population]))])
        simulated_annealing(best, current)

    return clip(np.array([evaluate(x) for x in population])[np.argmax(np.array([evaluate(x) for x in population]))])
