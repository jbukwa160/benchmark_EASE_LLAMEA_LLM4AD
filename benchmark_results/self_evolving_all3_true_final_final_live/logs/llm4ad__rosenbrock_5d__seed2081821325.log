def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def differential_evolution(population_size, mutation_factor, crossover_probability, iteration):
        population = rng.uniform(lb, ub, size=(population_size, dim))
        for _ in range(iteration):
            differences = population[np.random.choice(population_size, 3, replace=False), :] - population
            mutant = (differences[0] * mutation_factor + differences[1] + differences[2]) / 3
            trial = np.where(rng.uniform(0, 1, size=dim) < crossover_probability,
                             mutant,
                             population[np.random.choice(population_size, replace=False)])
            trial = clip(trial, lb, ub)
            fitness = func(trial)
            index = np.argmin(func(population))
            if fitness < func(population[index]):
                population[index] = trial
        return np.argmin(func(population))

    def local_search(iteration):
        best_solution = rng.uniform(lb, ub)
        for _ in range(iteration):
            candidate = best_solution + rng.uniform(-1, 1, size=dim)
            candidate = clip(candidate, lb, ub)
            fitness = func(candidate)
            if fitness < func(best_solution):
                best_solution = candidate
        return best_solution

    iteration_de = int(budget / (2 * dim))
    iteration_ls = budget - 2 * dim * iteration_de

    index_best = differential_evolution(20, 0.5, 0.7, iteration_de)
    best_solution = clip(population[index_best], lb, ub)

    return local_search(iteration_ls)
