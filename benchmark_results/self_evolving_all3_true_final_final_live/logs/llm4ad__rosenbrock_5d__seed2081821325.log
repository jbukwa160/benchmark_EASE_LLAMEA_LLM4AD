def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        if rng.rand() < 0.1:
            z = rng.randn(dim)
            y = clip(x_best + 0.5 * z / np.linalg.norm(z))
            f_y = func(y)
            if f_y < f_best:
                x_best, f_best = y, f_y

        n = rng.randint(1, dim)
        z = rng.randn(n) - 0.5
        u = clip(x_best + 0.2 * np.dot(z, (ub - lb)) / np.linalg.norm(z))
        f_u = func(u)
        if f_u < f_best:
            x_best, f_best = u, f_u

    return x_best
