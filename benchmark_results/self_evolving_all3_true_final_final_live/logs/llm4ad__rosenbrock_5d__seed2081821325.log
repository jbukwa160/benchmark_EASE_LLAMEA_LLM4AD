def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (1, dim))
    t = 1
    current_best = func(x)
    N = int(budget / (dim * (ub - lb)))
    
    for _ in range(N):
        for i in range(dim):
            mu = np.zeros_like(x)
            sigma = 0.5
            while True:
                new_x = x + rng.randn(1, dim) * sigma
                new_x = np.clip(new_x, lb, ub)
                
                f_new = func(new_x)
                if f_new < current_best or rng.rand() < np.exp((current_best - f_new) / t):
                    x = new_x
                    current_best = min(current_best, f_new)
                    
                    mu[i] += (new_x[i] - x[i]) / N
                    sigma = 0.1 * rng.randn()
                    break
                    
                elif sigma < 10e-6:
                    mu[i] += (new_x[i] - x[i]) / N
                    sigma *= np.sqrt(2)
                    break
                
                t *= 0.99
    return x
