def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    D = dim
    pop_size = 100
    sigma = 0.1
    t_max = 10
    t = 0
    T = 1000
    alpha = 0.95

    x_best = np.random.uniform(lb, ub, size=(D,))
    f_best = evaluate(x_best)

    while t < budget:
        if t % T == 0 and t > 0:
            sigma *= (alpha ** t)
            pop_size = int(pop_size * alpha ** t)

        samples = rng.normal(loc=x_best, scale=sigma, size=(pop_size,))
        samples = np.clip(samples, lb, ub)

        f_samples = evaluate(samples)

        x_next = samples[np.argsort(f_samples)[:1]]
        f_next = f_samples[np.argsort(f_samples)[:1]]

        if f_next < f_best:
            x_best = x_next
            f_best = f_next

        t += 1

    return x_best
