def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    sigma = 1.0
    c1 = 2.08
    c2 = 1.92
    mu = 0.5
    learning_rate = 1e-6

    x_best = np.zeros(dim)
    f_best = float('inf')

    for _ in range(budget):
        pop = rng.uniform(lb, ub, (pop_size, dim))
        cov = np.eye(dim) * sigma**2
        f_pop = func(pop)

        for i in range(pop_size):
            if f_pop[i] < f_best:
                x_best = pop[i]
                f_best = f_pop[i]

        for i in range(pop_size):
            z = rng.normal(size=dim)
            v = np.dot(np.linalg.cholesky(cov), z)
            u = c1 * v + (c2 - 1) * mu
            x_new = pop[i] + u

            f_new = func(x_new)

            if f_new < f_pop[i]:
                cov = (1 - learning_rate) * cov + learning_rate * np.outer(u, u)
                pop[i] = x_new
                f_pop[i] = f_new

        sigma *= 0.99

    return x_best
