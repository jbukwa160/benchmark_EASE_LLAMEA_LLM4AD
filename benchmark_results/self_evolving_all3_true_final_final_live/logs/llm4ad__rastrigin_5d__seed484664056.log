def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    n = int(np.ceil(budget / (dim + 1)))
    x_best = np.zeros(dim)
    f_best = float('inf')

    for i in range(n):
        for _ in range(dim + 1):
            x_new = clip(rng.uniform(lb, ub, size=dim))
            if rng.random() < 0.5:
                x_new += rng.normal(0, 0.2, size=dim)

            f_new = func(x_new)
            if f_new < f_best:
                x_best = x_new
                f_best = f_new

        x_best = clip(x_best + rng.normal(0, 1e-3, size=dim))
        f_new = func(x_best)
        if f_new < f_best:
            f_best = f_new

    return x_best
