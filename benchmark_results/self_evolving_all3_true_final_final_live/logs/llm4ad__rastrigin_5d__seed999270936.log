def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_f = float('inf')
    
    for _ in range(10):  # random restarts
        
        simplex = np.random.uniform(lb, ub, (dim + 1, dim))
        
        while True:
            f_simplex = func(simplex)
            
            if np.any(f_simplex < best_f):
                best_x = simplex[np.argmin(f_simplex)]
                best_f = np.min(f_simplex)
                
            # Reflection
            r = np.sort(simplex, axis=0)[(dim):]
            xr = 2 * r[1] - simplex[(dim)]
            
            # Shrink
            for i in range(dim):
                simplex[i] = 0.5 * (simplex[i] + xr)
                
            if np.any(f_simplex < best_f):
                break
            
            # Expansion
            xe = 2 * xr - r[1]
            
            # Contraction
            xc = simplex[(dim)]
            
            f_reflection = func(xr)
            f_expansion = func(xe)
            f_contraction = func(xc)
            
            if f_reflection < best_f and (f_expansion > f_reflection or f_expansion >= f_best):
                simplex[(dim)] = xr
                
            elif f_expansion < best_f:
                simplex[(dim + 1):] = xe
                
            else:
                simplex[(dim + 1):] = xc
            
            if np.sum(f_simplex < best_f) == dim or len(simplex) > budget:
                break
        
        # Clip candidates to [lb, ub]
        simplex = np.clip(simplex, lb, ub)
        
        if rng.rand() < 0.01:  # occasional restart
            simplex = np.random.uniform(lb, ub, (dim + 1, dim))
    
    return best_x
