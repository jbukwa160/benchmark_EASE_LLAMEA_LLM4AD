def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    f_best = np.inf
    
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)
    
    x_current = 0.5 * (ub + lb) + (ub - lb) * rng.uniform(0, 1, size=dim)
    
    for _ in range(budget):
        f_current = func(clip(x_current))
        
        if f_current < f_best:
            f_best = f_current
            x_best = clip(x_current)
        
        alpha = 0.01 / (1 + np.exp(-f_current / 10))
        step_size = 0.05 * rng.uniform(0, 1)
        
        for i in range(dim):
            s = x_current[i] - x_best[i]
            cosine_similarity = np.dot(s, x_current) / (np.linalg.norm(s) * np.linalg.norm(x_current))
            delta = alpha * step_size * (2 * s * cosine_similarity - 0.1 * rng.uniform(-1, 1))
            
            x_current[i] += delta
    
    return x_best
