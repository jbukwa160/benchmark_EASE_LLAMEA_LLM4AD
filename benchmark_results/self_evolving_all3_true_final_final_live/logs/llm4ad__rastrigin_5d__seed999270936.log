def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    def func_wrapper(x):
        x = clip(x)
        return func(x)

    x_best = -np.ones(dim)
    f_best = np.inf
    pop_size = 50
    step_size = (ub - lb) / 3.0
    sigma = (ub - lb) * 2.0

    for _ in range(budget):
        if rng.uniform(0, 1) < 0.5:
            x_new = clip(x_best + rng.normal(0, step_size, dim))
        else:
            x_new = clip(x_best + rng.normal(0, sigma, dim))

        f_new = func_wrapper(x_new)
        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
