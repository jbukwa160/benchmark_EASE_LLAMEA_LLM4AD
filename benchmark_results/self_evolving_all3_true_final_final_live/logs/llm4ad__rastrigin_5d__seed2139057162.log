def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = 50
    x0 = (ub - lb) * rng.rand(pop_size, dim)
    x0 = clip(x0)

    best = float('inf')
    for t in range(budget):
        y = x0.copy()
        i = np.random.choice(pop_size, size=3, replace=False)
        v = y[i] + 0.5 * (y[i[:, np.newaxis]] - y[np.newaxis, i])
        f_v = func(v)

        for _ in range(pop_size - 1):
            j = np.random.choice(pop_size, size=3, replace=False)
            u = x0[j] + 0.5 * (v - x0[np.newaxis, j])
            if rng.rand() < 0.1: # 10% chance of mutation
                u += (ub - lb) * rng.randn(dim)
            f_u = func(clip(u))

            if f_u < f_v:
                y[_] = u

        f_y = func(clip(y))
        if f_y < best or rng.rand() < np.exp((best - f_y) / t):
            best = f_y
            x0 = y

    return clip(x0[np.argmin([func(x) for x in x0])])
