def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = 50
    sigma = 0.5
    adapt_rate = 1e-6
    local_search_radius = 2.0
    x_best = np.zeros(dim)
    f_best = float('inf')

    for _ in range(budget):
        population = rng.uniform(lb, ub, (pop_size, dim))
        f_values = [func(clip(x)) for x in population]
        population = np.array([x for _, x in sorted(zip(f_values, population))])

        for i in range(pop_size):
            if i < pop_size // 2:
                x_parent1 = population[i]
                x_parent2 = population[np.random.randint(i+1, pop_size)]
                x_child = clip(x_parent1 + rng.normal(0, sigma, dim) +
                               np.random.choice([-1, 1], size=dim))
            else:
                x_parent1 = population[np.random.randint(pop_size // 2)]
                x_parent2 = population[np.random.randint(i+1, pop_size)]
                x_child = clip(x_parent1 + rng.normal(0, sigma, dim) +
                               np.random.choice([-1, 1], size=dim))

            if func(clip(x_child)) < f_values[i]:
                population[i] = x_child

        if budget - _ <= 100:
            for i in range(pop_size):
                x_centroid = clip((population[0] + population[-1]) / 2)
                if rng.random() < 0.01:
                    local_search_radius *= (1 - adapt_rate)
                else:
                    local_search_radius /= (1 - adapt_rate)

                x_child = clip(x_centroid +
                               rng.normal(0, local_search_radius, dim) +
                               np.random.choice([-1, 1], size=dim))
                if func(clip(x_child)) < f_values[i]:
                    population[i] = x_child

        x_best_new = population[-1]
        f_best_new = func(clip(x_best_new))

        if f_best_new < f_best:
            f_best = f_best_new
            x_best = x_best_new

    return x_best
