def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    population_size = 50
    num_iterations = budget // population_size
    particles = rng.uniform(lb, ub, (population_size, dim))

    for _ in range(num_iterations):
        fitnesses = [func(particle) for particle in particles]
        best_particle = particles[np.argmin(fitnesses)]
        new_particles = []
        
        for i in range(population_size):
            parent1_idx = rng.randint(0, population_size)
            parent2_idx = rng.randint(0, population_size)
            
            if np.random.rand() < 0.5:
                child_particle = clip(best_particle + (particles[parent1_idx] - best_particle) * rng.uniform(-1, 1), lb, ub)
            else:
                child_particle = clip(particles[parent2_idx] + rng.uniform(-1, 1) * (best_particle - particles[parent2_idx]), lb, ub)
            
            new_particles.append(child_particle)
        
        particles = np.array(new_particles)

    best_candidate = particles[np.argmin([func(candidate) for candidate in particles])]
    
    return best_candidate
