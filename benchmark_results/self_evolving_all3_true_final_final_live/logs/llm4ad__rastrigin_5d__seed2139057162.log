def algorithm(func, dim, lb, ub, budget, rng):
    def bounds(x):
        return np.clip(x, lb, ub)

    x = bounds(rng.uniform(lb, ub, (1, dim)))
    y = func(x)
    best_x = x
    best_y = y

    for _ in range(budget - 1):
        v1 = bounds(rng.uniform(lb, ub, (1, dim)) + x)
        v2 = bounds(rng.uniform(lb, ub, (1, dim)) + x)
        v3 = bounds(rng.uniform(lb, ub, (1, dim)) + x)

        y1 = func(v1)
        y2 = func(v2)
        y3 = func(v3)

        if rng.random() < 0.5:
            s = np.random.choice([-1, 1])
            v4 = bounds(best_x + s * rng.uniform(lb, ub, (1, dim)))
            y4 = func(v4)

            if y4 < max(y1, y2, y3):
                x = v4
                y = y4

        else:
            if min(y1, y2, y3) < y:
                x = np.mean([v1, v2, v3], axis=0)
                y = func(x)

        if y < best_y or rng.random() < 0.01:
            best_x = bounds(x)
            best_y = y

    return best_x
