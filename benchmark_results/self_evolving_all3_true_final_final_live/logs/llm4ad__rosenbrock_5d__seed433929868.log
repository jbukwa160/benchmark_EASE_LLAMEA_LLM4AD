def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    mean = np.random.uniform(lb, ub, size=dim)
    cov = np.eye(dim) * 0.1

    best_x = mean.copy()
    best_f = evaluate(mean)

    for _ in range(budget):
        new_mean = mean + np.random.multivariate_normal(np.zeros(dim), cov)
        new_x = clip(new_mean)

        if evaluate(new_x) < best_f:
            mean = new_mean
            best_f = evaluate(new_x)
            best_x = new_x.copy()

    return best_x
