def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    current = np.random.uniform(lb, ub, size=dim)
    best = current.copy()
    improvement_count = 0
    iteration = 0
    
    while True:
        candidate = current + rng.normal(size=current.shape) * 0.1
        candidate = clip(candidate)
        
        if func(candidate) < func(best):
            best = candidate
            improvement_count = 0
        else:
            improvement_count += 1
        
        if improvement_count >= 20 or iteration > budget:
            break
        
        current = best.copy()
        iteration += 1
    
    return best
