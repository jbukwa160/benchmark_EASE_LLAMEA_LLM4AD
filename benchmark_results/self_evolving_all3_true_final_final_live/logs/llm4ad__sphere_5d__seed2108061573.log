def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def accept(current, candidate, T):
        if func(candidate) < func(current):
            return candidate
        else:
            p = np.exp(-(func(candidate) - func(current)) / (T * 1e-3))
            if rng.random() < p:
                return candidate
            else:
                return current

    current_best = np.zeros(dim)
    T = ub - lb + 1
    for _ in range(budget):
        candidate = clip(np.array(rng.uniform(lb, ub, size=dim)))
        current_best = accept(current_best, candidate, T)
        T *= 0.99
    return current_best
