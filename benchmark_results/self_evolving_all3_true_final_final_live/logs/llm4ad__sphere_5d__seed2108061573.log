def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    for _ in range(budget):
        step_size = 1.0 / (budget + 1) ** (1/2)
        x_new = x_best + rng.uniform(-step_size, step_size, size=dim)
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)
        if f_new < func(x_best):
            x_best = x_new
    return x_best
