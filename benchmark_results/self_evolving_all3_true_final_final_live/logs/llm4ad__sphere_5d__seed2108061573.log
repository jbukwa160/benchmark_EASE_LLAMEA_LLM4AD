def algorithm(func, dim, lb, ub, budget, rng):
    best_candidate = np.full(dim, 0)
    best_fitness = float('inf')
    
    iteration = 1
    while iteration <= budget:
        candidate = (ub - lb) * rng.rand(dim) + lb
        
        fitness = func(candidate)
        
        if fitness < best_fitness:
            best_candidate = candidate
            best_fitness = fitness
            
            if iteration == budget:
                break
            
        iteration += 1
        
        if iteration % (budget // 5) == 0 and best_fitness != float('inf'):
            restart_candidate = np.full(dim, 0)
            for i in range(dim):
                restart_candidate[i] = lb + rng.uniform(0, ub - lb)
                
            restart_fitness = func(restart_candidate)
            
            if restart_fitness < best_fitness:
                best_candidate = restart_candidate
                best_fitness = restart_fitness
                
    return best_candidate
