def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, dim)
    for _ in range(budget):
        x_new = x_best + rng.normal(size=dim) * 0.01
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)
        if f_new < func(x_best):
            x_best = x_new
    return x_best
