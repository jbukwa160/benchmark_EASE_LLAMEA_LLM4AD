def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    best = None
    best_fitness = float('inf')

    for _ in range(budget):
        cma_mean = np.zeros(dim)
        cma_cov = np.eye(dim) * 0.5

        for _ in range(100):
            perturbation = rng.normal(size=dim)
            candidate = clip(cma_mean + cma_cov @ perturbation)

            fitness = func(candidate)
            if fitness < best_fitness:
                best_fitness = fitness
                best = candidate

            sigma = np.sqrt(np.sum(perturbation ** 2))
            cma_cov += (sigma ** 2 - 1) * np.outer(perturbation, perturbation) / dim

    return clip(best)
