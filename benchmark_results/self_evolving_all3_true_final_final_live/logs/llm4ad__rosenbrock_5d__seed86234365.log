def algorithm(func, dim, lb, ub, budget, rng):
    def grad_func(x):
        return 2 * 100 * (x[1:] - x[:-1]**2) * (np.ones((dim-1)) + 400*x[:-1]*(x[1:]-x[:-1]**2)) + 2*(1-x[:-1])

    x = np.random.uniform(lb, ub, dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        direction = -np.dot(grad_func(x), (ub-lb)/budget**0.5)
        x += 0.01 * direction
        x = np.clip(x, lb, ub)
        
        f = func(x)
        if f < best_f:
            best_x = x.copy()
            best_f = f

    return best_x
