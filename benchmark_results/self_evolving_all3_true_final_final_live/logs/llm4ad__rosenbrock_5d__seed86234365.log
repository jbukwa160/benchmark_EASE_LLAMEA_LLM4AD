def algorithm(func, dim, lb, ub, budget, rng):
    def get_init_pop(dim):
        return 10 * (ub - lb) + lb + rng.uniform(0, 1, size=(dim))

    def clip(x, lb, ub):
        return np.minimum(np.maximum(x, lb), ub)

    def weighted_sampling(pop, weights, dim):
        idx = np.zeros((len(weights), dim))
        for i in range(dim):
            idx[:, i] = rng.choice(len(pop), size=len(weights), p=weights)
        return pop[idx]

    def func_eval(params):
        return func(params)

    x_best = get_init_pop(dim)
    f_best = func(x_best)
    pop = [x_best]
    weights = [1.0 / len(pop)]

    for _ in range(budget - 1):
        new_pop = []
        for _ in range(2 * dim):
            parents = weighted_sampling(pop, weights, dim)
            child = clip(parents + (ub - lb) * rng.normal(size=dim), lb, ub)
            new_pop.append(child)

        scores = [func_eval(x) for x in new_pop]
        idx = np.argsort(scores)[:len(pop)]
        pop, weights = [new_pop[i] for i in idx], [1.0 / len(idx) if i < len(pop) else 0 for i in range(len(idx))]

        f_best_new = func(clip(np.array(pop[0]) + (ub - lb) * rng.normal(size=dim), lb, ub))
        if f_best_new < f_best:
            x_best = clip(np.array(pop[0]) + (ub - lb) * rng.normal(size=dim), lb, ub)
            f_best = f_best_new

    return x_best
