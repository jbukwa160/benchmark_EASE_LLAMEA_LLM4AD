def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    sigma = 0.5
    T = 1000
    cooling_rate = 0.99
    
    x = np.random.uniform(lb, ub, (pop_size, dim))
    
    for _ in range(budget):
        y = np.zeros((pop_size, dim))
        
        for i in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size, 3)
            while r1 == i or r2 == i or r3 == i:
                r1, r2, r3 = rng.randint(0, pop_size, 3)
            
            y[i] = x[r1] + sigma * (x[r2] - 2*x[r3])
        
        y = np.clip(y, lb, ub)
        
        f_x = func(x)
        f_y = func(y)
        
        for i in range(pop_size):
            if f_y[i] < f_x[i]:
                x[i] = y[i]
            elif rng.random() < np.exp((f_x[i] - f_y[i]) / T):
                x[i] = y[i]
        
        T *= cooling_rate
        
    best_idx = np.argmin(func(x))
    return x[best_idx]
