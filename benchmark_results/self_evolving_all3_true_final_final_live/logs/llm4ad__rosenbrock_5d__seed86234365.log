def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    x_best = np.zeros(n)
    f_best = float('inf')
    
    for i in range(budget):
        sigma = 0.5
        while True:
            x_new = x_best + sigma * (rng.randn(n) - 0.5)
            clip_x_new = np.clip(x_new, lb, ub)
            f_new = func(clip_x_new)
            
            if f_new < f_best:
                x_best = clip_x_new
                f_best = f_new
                
            if rng.rand() > 0.1 and sigma > 1e-3:
                break
            
            sigma *= 0.5
    
    return x_best
