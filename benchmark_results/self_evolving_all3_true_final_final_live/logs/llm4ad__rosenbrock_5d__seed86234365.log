def algorithm(func, dim, lb, ub, budget, rng):
    def eval(x):
        return func(x)

    bounds = [(lb[i], ub[i]) for i in range(dim)]
    result_de = differential_evolution(eval, bounds=bounds, x0=np.random.uniform(lb, ub, size=dim), maxiter=budget)
    
    if not np.isfinite(result_de.fun):
        return None
    
    x_best = result_de.x
    f_best = result_de.fun
    
    def loss(x):
        return func(x) - f_best
    
    res = minimize(loss, x0=x_best, method="L-BFGS-B", bounds=bounds)
    
    if not np.isfinite(res.fun):
        return None
    
    x_optimal = res.x
    f_optimal = res.fun
    
    if f_optimal < f_best:
        return x_optimal
    else:
        return x_best
