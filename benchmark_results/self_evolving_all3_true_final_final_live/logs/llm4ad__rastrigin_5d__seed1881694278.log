def algorithm(func, dim, lb, ub, budget, rng):
    n = 100
    mu = 0.8
    sigma = 1.0
    c_cov = 2 / (dim + 3.0 + 2 * np.sqrt(dim))
    c_mup = 2 * (np.sqrt(dim) * (1 - mu) + 2)
    c_sig = pow(2, 1 / (4 * dim + 6))

    x_mean = np.zeros(dim)
    cov_matrix = np.eye(dim)

    for _ in range(budget):
        candidates = rng.multivariate_normal(x_mean, cov_matrix * sigma)
        candidates = np.clip(candidates, lb, ub)

        fitnesses = [func(candidate) for candidate in candidates]
        best_candidate = candidates[np.argmin(fitnesses)]

        if np.min([func(best_candidate), func(x_mean)]) < 0:
            x_mean = best_candidate
        else:
            c_cov_new = 2 / (dim + 3.0 + 2 * np.sqrt(dim))
            sigma *= c_sig

    return x_mean
