def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 1000
    alpha = 0.99
    beta = 1e-6
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        if np.random.rand() < 0.2:
            # Simulated annealing step
            new_x = x + rng.uniform(-T, T, size=dim)
            new_x = np.clip(new_x, lb, ub)
            f_new = func(new_x)
            if f_new < best_f:
                x = new_x.copy()
                best_x = new_x.copy()
                best_f = f_new
            elif np.exp(-(f_new - best_f) / T) > rng.rand():
                x = new_x.copy()

        else:
            # Stochastic hill climbing step
            for i in range(dim):
                alpha_i = 1 + (ub - lb) * rng.uniform(-beta, beta)
                new_x = x.copy()
                new_x[i] += alpha_i * rng.uniform(-1, 1)
                new_x = np.clip(new_x, lb, ub)
                f_new = func(new_x)
                if f_new < best_f:
                    x = new_x.copy()
                    best_x = new_x.copy()
                    best_f = f_new
        T *= alpha

    return best_x
