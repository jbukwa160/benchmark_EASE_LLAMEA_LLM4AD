def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    pop_size = 100
    n_iter = int(budget / (dim * pop_size))
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    for _ in range(n_iter):
        y_best = x_best.copy()
        score_best = f_best

        for i in range(pop_size):
            parent1, parent2 = x_best.copy(), x_best.copy()
            np.random.shuffle(parent1), np.random.shuffle(parent2)
            trial = clip(parent1 + 0.5 * (parent2 - parent1) + rng.randn(dim) * (ub - lb))

            score_trial = func(trial)

            if score_trial < score_best:
                y_best, score_best = trial, score_trial

        for i in range(pop_size):
            parent1, parent2 = x_best.copy(), y_best.copy()
            np.random.shuffle(parent1), np.random.shuffle(parent2)
            trial = clip(parent1 + 0.5 * (parent2 - parent1) + rng.randn(dim) * (ub - lb))

            score_trial = func(trial)

            if score_trial < score_best:
                x_best, f_best = trial, score_trial

    return x_best
