def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(budget):
        return rng.uniform(lb, ub, size=(budget, dim))

    def calculate_fitness(population, func):
        return [func(individual) for individual in population]

    def select_parents(population, fitness, budget):
        indices = np.argsort(fitness)[:budget]
        return population[indices], fitness[indices]

    def crossover(parent1, parent2):
        child = 0.5 * (parent1 + parent2)
        return child

    def mutation(individual):
        return individual + rng.normal(0, 0.01, size=dim)

    def simulated_annealing(population, fitness, lb, ub, budget):
        temperature = 100
        for i in range(budget):
            j = np.random.randint(len(fitness))
            k = np.random.randint(len(fitness))
            if fitness[j] < fitness[k]:
                continue
            else:
                new_individual = crossover(population[j], population[k])
                new_fitness = func(clip(new_individual))
                delta = new_fitness - fitness[j]
                if delta <= 0 or np.exp(-delta/temperature) > rng.random():
                    population[j] = clip(new_individual)
                    fitness[j] = new_fitness
            temperature *= 0.99

    def differential_evolution(population, fitness, lb, ub):
        for i in range(len(fitness)):
            r1 = np.random.randint(len(fitness))
            r2 = np.random.randint(len(fitness))
            while r1 == i or r2 == i:
                r1 = np.random.randint(len(fitness))
                r2 = np.random.randint(len(fitness))
            mutation_index = rng.uniform(0, 1)
            if mutation_index > 0.5:
                new_individual = crossover(population[r1], population[r2])
            else:
                new_individual = mutation(population[i])
            new_fitness = func(clip(new_individual))
            if new_fitness < fitness[i]:
                population[i] = clip(new_individual)
                fitness[i] = new_fitness

    initial_population = generate_initial_population(budget)
    initial_fitness = calculate_fitness(initial_population, func)

    for i in range(10):
        population, fitness = select_parents(initial_population, initial_fitness, budget // 2)
        simulated_annealing(population, fitness, lb, ub, budget // 4)
        differential_evolution(population, fitness, lb, ub)
        initial_population = population
        initial_fitness = fitness

    best_individual = np.argmin(calculate_fitness(initial_population, func))
    return clip(initial_population[best_individual])
