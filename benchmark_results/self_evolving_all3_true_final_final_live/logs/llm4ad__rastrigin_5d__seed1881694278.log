def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    y = rng.uniform(lb, ub, size=dim)

    for _ in range(budget):
        f_y = func(y)
        
        if f_y < x_best.sum():
            x_best = y
            
        x_neighbour = y + rng.normal(size=y.shape)
        x_neighbour = np.clip(x_neighbour, lb, ub)
        
        f_x_neighbour = func(x_neighbour)
        
        if f_x_neighbour <= f_y:
            y = x_neighbour
        else:
            sigma = 1 / (f_y - f_x_neighbour + 1e-3)
            e = rng.standard_cauchy(size=y.shape) * sigma
            
            # "Escape" mechanism: add the Cauchy-distributed vector to the current solution with a small probability
            if rng.uniform(0, 1) < 0.05:
                y += e
                
    return x_best
