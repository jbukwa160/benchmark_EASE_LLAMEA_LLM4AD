def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for i in range(budget):
        x = np.copy(best_x)
        step_size = 0.1 * (ub - lb) / (i + 1)**(2/7)
        
        while True:
            direction = rng.choice([-1, 1], size=dim)
            new_x = x + step_size * direction
            
            # Clip candidates to [lb, ub]
            new_x = np.clip(new_x, lb, ub)

            f = func(new_x)
            
            if f < best_f:
                best_x = new_x
                best_f = f
                
                # Adaptive restart: reset the search if no improvement is found for 10 iterations
                if i % 10 == 0 and np.random.rand() < 0.1:
                    x = rng.uniform(lb, ub, size=dim)
                    step_size *= 2
                    
            if step_size < 1e-5 or i > budget - 100:
                break
                
    return best_x
