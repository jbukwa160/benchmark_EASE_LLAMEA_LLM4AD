def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def objective(x):
        return func(x)

    def differential_evolution(bounds, max_iter, population_size=50, crossover_probability=0.7, mutation_strategy='rand1/exp', cr=None):
        if cr is None:
            cr = 0.5 * (np.random.rand(population_size) - 0.5)
        
        x = np.random.uniform(lb, ub, (population_size, dim))
        f = [objective(clip(x[i])) for i in range(population_size)]
        
        for _ in range(max_iter):
            u, v, w = rng.choice(population_size, size=(3,), replace=False)
            
            if mutation_strategy == 'rand1/exp':
                a = 0.5 * (x[u] - x[v]) + cr
                b = 0.5 * (x[w] - x[u])
                
                trial_individual = clip(x[u] + b)
                trial_fitness = objective(trial_individual)
            else:
                raise ValueError("Unsupported mutation strategy")
            
            if trial_fitness < f[u]:
                x[u], f[u] = trial_individual, trial_fitness
            
            if np.random.rand() < crossover_probability:
                y = rng.choice(population_size, size=(population_size,), replace=False)
                
                for i in range(population_size):
                    if i == u or i == v or i == w:
                        continue
                    
                    a = 0.5 * (x[y[i]] - x[u]) + cr
                    b = 0.5 * (x[v] - x[w])
                    
                    trial_individual = clip(x[y[i]] + a)
                    trial_fitness = objective(trial_individual)
                    
                    if trial_fitness < f[y[i]]:
                        x[y[i]], f[y[i]] = trial_individual, trial_fitness
        
        return np.array([objective(clip(x[i])) for i in range(population_size)]), x

    def simulated_annealing(bounds, max_iter, initial_temperature, cooling_rate):
        x = np.random.uniform(lb, ub, dim)
        
        for _ in range(max_iter):
            trial_individual = clip(x + rng.uniform(-1, 1, size=(dim,)))
            
            if objective(trial_individual) < objective(clip(x)):
                x = trial_individual
            else:
                temperature = initial_temperature * (1 - cooling_rate)**(_ / max_iter)
                
                delta = objective(clip(x)) - objective(trial_individual)
                probability = np.exp(-delta / temperature)
                
                if rng.rand() < probability:
                    x = trial_individual
        
        return [objective(clip(x))], [x]

    best_candidate, best_fitness = None, 1e9
    for _ in range(budget):
        population_fitness, population_x = differential_evolution((lb, ub), budget // 2)
        
        if np.min(population_fitness) < best_fitness:
            best_fitness = np.min(population_fitness)
            best_candidate = population_x[np.argmin(population_fitness)]
        
        population_fitness, population_x = simulated_annealing((lb, ub), budget // 2, rng.uniform(1e-3, 1e-1), rng.uniform(0.8, 1))
        
        if np.min(population_fitness) < best_fitness:
            best_fitness = np.min(population_fitness)
            best_candidate = population_x[np.argmin(population_fitness)]
    
    return best_candidate
