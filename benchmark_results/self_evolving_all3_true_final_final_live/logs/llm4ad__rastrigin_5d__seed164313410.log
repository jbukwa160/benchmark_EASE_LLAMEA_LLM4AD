def algorithm(func, dim, lb, ub, budget, rng):
    def get_neighbors(x, sigma):
        neighbors = []
        for i in range(dim):
            neighbor = x.copy()
            neighbor[i] += rng.uniform(-sigma, sigma)
            neighbor[i] = max(lb, min(ub, neighbor[i]))
            neighbors.append(neighbor)
        return np.array(neighbors)

    def local_search(x, lb, ub, budget):
        for _ in range(budget):
            x = np.random.uniform(lb, ub, size=(dim,))
            if func(x) < func(x):
                x = x
        return x

    pop_size = 50
    sigma_max = 10.0
    sigma_min = 1.0
    p_c = 0.5
    budget_local_search = 100
    pop = np.random.uniform(lb, ub, size=(pop_size, dim))
    for _ in range(budget):
        weights = rng.uniform(0, 1, size=dim)
        weights /= np.sum(weights)
        mutated_pop = get_neighbors(pop, sigma_max - (sigma_max - sigma_min) * (_ / budget))
        crossed_pop = mutated_pop.copy()
        for i in range(pop_size):
            if rng.rand() < p_c:
                u, v = rng.randint(0, pop_size, size=2)
                crossed_pop[i] = (weights[0] * pop[u] + weights[1] * mutated_pop[u]) + \
                                 (weights[2] * pop[v] + weights[3] * mutated_pop[v])
            else:
                crossed_pop[i] = mutated_pop[i]
        crossed_pop = np.clip(crossed_pop, lb, ub)
        fitness_crossed = func(crossed_pop)
        fitness_mutated = func(mutated_pop)
        for i in range(pop_size):
            if fitness_crossed[i] < fitness_mutated[i]:
                pop[i] = crossed_pop[i]
        sigma = sigma_max - (sigma_max - sigma_min) * (_ / budget)
    best_x = np.argmin(func(pop))
    return local_search(pop[best_x], lb, ub, budget_local_search)
