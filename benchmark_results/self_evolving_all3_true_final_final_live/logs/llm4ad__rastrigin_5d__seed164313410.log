def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = np.zeros(dim)
    best_fit = float('inf')
    
    for _ in range(budget // 100):
        sol = np.clip(rng.uniform(lb, ub, size=dim), a_min=lb, a_max=ub)
        fit = func(sol)
        
        if fit < best_fit:
            best_sol = sol
            best_fit = fit
            
    return best_sol
