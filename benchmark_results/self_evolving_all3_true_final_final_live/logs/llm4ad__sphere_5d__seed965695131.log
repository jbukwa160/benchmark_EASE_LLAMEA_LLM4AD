def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    current_f = best_f
    step_size = 0.1
    
    for _ in range(budget):
        proposal = clip(x + rng.uniform(-step_size, step_size, size=dim))
        
        proposal_f = func(proposal)
        
        if proposal_f < current_f:
            current_f = proposal_f
            x = proposal
            
            if current_f < best_f:
                best_f = current_f
                best_x = x.copy()
                
        else:
            temperature = 1 / (budget - _ + 1)
            
            if rng.uniform(0, 1) > np.exp((current_f - proposal_f) / temperature):
                x = proposal
                
    return best_x
