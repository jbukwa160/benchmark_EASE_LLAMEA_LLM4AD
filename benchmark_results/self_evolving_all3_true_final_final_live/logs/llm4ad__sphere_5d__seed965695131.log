def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidates(dim, lb, ub, budget):
        return np.random.uniform(lb, ub, (budget, dim))

    def evaluate(x):
        return func(x)

    candidates = get_candidates(dim, lb, ub, budget)
    best_candidate = np.min(evaluate(candidates), axis=0)
    
    for t in range(1, budget):
        current_temperature = 5.0 / t
        new_candidate = np.copy(np.random.uniform(lb, ub, dim))
        new_candidate_eval = evaluate(new_candidate)
        
        if rng.random() < np.exp((new_candidate_eval - best_candidate) / current_temperature):
            best_candidate = new_candidate
            
        # Clip candidates to [lb, ub]
        candidates[t] = np.clip(candidates[t], lb, ub)
    
    return best_candidate
