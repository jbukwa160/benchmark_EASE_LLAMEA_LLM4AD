def algorithm(func, dim, lb, ub, budget, rng):
    def initialize(dim, lb, ub):
        x = np.zeros((dim,))
        for i in range(dim):
            if rng.random() < 0.5:
                x[i] = lb + (ub - lb) * rng.random()
            else:
                x[i] = ub - (ub - lb) * rng.random()
        return x

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def differential_evolution(func, x0, dim, bounds, budget, rng):
        pop_size = 50
        learning_rate = 1.0
        best_x = x0.copy()
        best_f = func(best_x)
        
        for _ in range(budget):
            candidates = np.zeros((pop_size, dim))
            for i in range(pop_size):
                parent_idx = rng.choice(pop_size, p=np.array([1 / pop_size] * pop_size))
                candidate = clip(x0 + learning_rate * (candidates[parent_idx] - x0), bounds[0], bounds[1])
                candidates[i] = candidate
                
            f_values = np.array([func(candidate) for candidate in candidates])
            idx = np.argmin(f_values)
            if f_values[idx] < best_f:
                best_x = clip(candidates[idx], bounds[0], bounds[1])
                best_f = f_values[idx]
        
        return best_x, best_f

    x0 = initialize(dim, lb, ub)
    best_x, _ = differential_evolution(func, x0, dim, (lb, ub), budget - 100, rng)
    for i in range(100):
        _, f_value = differential_evolution(func, best_x, dim, (lb, ub), 1, rng)
        if f_value < func(best_x):
            best_x = clip(np.array([best_x] + [0.9 * best_x + 0.1 * x for x in np.random.rand(dim)]), lb, ub)
    return best_x
