def algorithm(func, dim, lb, ub, budget, rng):
    x = 1 + (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    best_f = func(x)
    
    de_weight = 0.5
    sa_weight = 0.5
    
    for _ in range(budget):
        new_x = de_weight * (x + 0.1 * rng.randn(dim)) + \
                sa_weight * np.exp(-rng.rand()) * x + \
                lb + (ub - lb) * rng.rand()
        
        new_f = func(new_x)
        
        if new_f < best_f:
            best_f = new_f
            best_x = new_x.copy()
            
        # Clip to bounds
        for i in range(dim):
            best_x[i] = max(lb, min(ub, best_x[i]))
            
    return best_x
