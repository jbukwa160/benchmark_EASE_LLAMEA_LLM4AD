def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        x = clip(x, lb, ub)
        return func(x)

    def simulated_annealing(current_solution, temperature, step_size):
        while temperature > 1e-6:
            new_solution = current_solution + rng.normal(size=(dim,))
            new_solution = clip(new_solution, lb, ub)
            if evaluate(new_solution) < evaluate(current_solution):
                current_solution = new_solution
            else:
                probability = np.exp((evaluate(current_solution) - evaluate(new_solution)) / temperature)
                if rng.uniform() < probability:
                    current_solution = new_solution
            temperature *= 0.99
        return current_solution

    def differential_evolution(population, budget):
        for _ in range(budget):
            differences = population[:, np.newaxis] - population
            norms = np.linalg.norm(differences, axis=2)
            indices = np.argmin(norms, axis=1)
            new_population = population + 0.7 * differences[np.arange(len(population)), indices]
            new_population = clip(new_population, lb, ub)
            population = np.where(np.random.rand(len(population)) < 0.5, new_population, population)
        return population

    population_size = int(budget ** (1/3))
    population = rng.uniform(lb, ub, size=(population_size, dim))

    for _ in range(int(0.9 * budget)):
        current_solution = simulated_annealing(population[0], 1000, 0.01)
        population = np.vstack([current_solution] + [x for x in population if not np.all(x == current_solution)])

    population = differential_evolution(population, int(budget * 0.1))
    return current_solution
