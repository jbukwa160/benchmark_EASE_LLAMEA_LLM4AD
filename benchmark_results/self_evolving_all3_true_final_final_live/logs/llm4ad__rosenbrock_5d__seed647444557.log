def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x)

    x = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = float('inf')

    # Differential Evolution
    for i in range(budget // 3):
        y = clip(x + rng.normal(0, 1, dim))
        if evaluate(y) < evaluate(best_x):
            best_x = y
            best_f = evaluate(y)

        for j in range(dim):
            z = x.copy()
            z[j] += rng.uniform(-1, 1)
            z = clip(z)
            if evaluate(z) < evaluate(best_x):
                x = z

    # Simulated Annealing
    T = 10.0
    step_size = 0.5
    for _ in range(budget - budget // 3):
        y = clip(x + rng.uniform(-step_size, step_size, dim))
        if evaluate(y) < evaluate(best_x):
            x = y

        if rng.random() < np.exp((evaluate(best_x) - evaluate(x)) / T):
            x = best_x
        else:
            T *= 0.9

    return clip(best_x)
