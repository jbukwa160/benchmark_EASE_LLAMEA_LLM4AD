def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    cov = 1e-5 * np.eye(dim)
    step_size = 0.25 / (dim ** 0.5)

    for _ in range(budget):
        y = x + np.dot(np.random.randn(dim), cov ** 0.5) * rng
        y = np.clip(y, lb, ub)
        f_y = func(y)

        if f_y < func(x):
            x = y

    return x
