def algorithm(func, dim, lb, ub, budget, rng):
    def cma_es(x, sigma):
        for _ in range(budget):
            candidates = x + sigma * (rng.normal(size=(N, dim))[:, None] * sigma)
            candidates = np.clip(candidates, lb, ub)
            
            fitness = func(candidates)
            idx = np.argmin(fitness)
            if fitness[idx] < 1e-6: return candidates[idx]
            
            x = x + (candidates[idx] - x) / N
            sigma *= 0.9 * (np.std(candidates, axis=0).mean() + 1e-8) ** 2
            
    lb = np.array(lb)
    ub = np.array(ub)
    
    N = int(np.sqrt(budget))
    x = rng.uniform(lb, ub, size=(N, dim))
    sigma = (ub - lb) / 5.0
    
    return cma_es(x, sigma)
