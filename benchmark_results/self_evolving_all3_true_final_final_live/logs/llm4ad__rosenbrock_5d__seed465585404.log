def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_candidate = np.random.uniform(lb, ub, size=dim)
    best_value = func(clip(best_candidate))

    for _ in range(budget):
        candidate = clip(np.random.uniform(lb, ub, size=dim))
        value = func(candidate)

        if value < best_value:
            best_value = value
            best_candidate = candidate

        # Periodic restart: every 10% of the budget, reset the current candidate to a new random one
        if rng.random() < 0.1:
            candidate = clip(np.random.uniform(lb, ub, size=dim))
            value = func(candidate)

    return best_candidate
