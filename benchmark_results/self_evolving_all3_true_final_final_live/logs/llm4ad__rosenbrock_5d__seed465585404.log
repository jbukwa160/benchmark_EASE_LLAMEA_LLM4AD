def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x).sum()

    x = np.random.uniform(lb, ub, size=(dim,))
    x_best = x.copy()
    best_fitness = float('inf')

    T_initial = 10 * (ub - lb)
    alpha = 0.99
    cooling_rate = 0.999

    for _ in range(budget):
        T_current = T_initial * cooling_rate ** (_ / budget)

        while True:
            mutant = x + rng.normal(size=(dim,)) * (ub - lb) / 3
            mutant = clip(mutant, lb, ub)
            trial = mutant + rng.normal(size=(1, dim)) * (ub - lb) / 5
            trial = clip(trial, lb, ub)

            if evaluate(trial) < best_fitness:
                x_best = trial.copy()
                best_fitness = evaluate(x_best)

            if np.random.rand() < np.exp(-evaluate(trial) / T_current):
                x = trial.copy()

            if evaluate(trial) >= best_fitness or rng.uniform(0, 1) > alpha ** (_ / budget):
                break

    return x_best
