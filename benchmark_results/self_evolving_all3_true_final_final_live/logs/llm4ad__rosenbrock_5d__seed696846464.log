def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(size):
        population = []
        for _ in range(size):
            candidate = np.zeros(dim)
            for i in range(dim):
                candidate[i] = (ub - lb) * rng.uniform() + lb
            population.append(clip(candidate))
        return population

    def compute_objective_values(population, func):
        return [func(x) for x in population]

    def differential_evolution(population, objective_values, budget):
        mutation_rate = 0.5
        crossover_probability = 0.9
        offspring_size = int(len(population) / 2)

        while budget > 0:
            # Selection
            selected_parents = []
            for _ in range(offspring_size):
                i1, i2 = np.random.choice(len(population), size=2, replace=False)
                if objective_values[i1] < objective_values[i2]:
                    selected_parents.append(i1)
                else:
                    selected_parents.append(i2)

            # Mutation
            offspring = []
            for i in range(offspring_size):
                x1, x2 = population[selected_parents[i]], population[selected_parents[(i + 1) % len(selected_parents)]]
                mutant = x1 + mutation_rate * (x2 - x1)
                offspring.append(clip(mutant))

            # Crossover
            for i in range(offspring_size):
                if rng.random() < crossover_probability:
                    offspring[i] = (offspring[i] + population[selected_parents[i]]) / 2

            # Replacement
            new_objective_values = compute_objective_values(offspring, func)
            for i in range(len(population)):
                j = np.argmin(new_objective_values)
                if new_objective_values[j] < objective_values[i]:
                    population[i], offspring[j] = offspring[j], population[i]
                    objective_values[i], new_object_value = new_object_value, objective_values[i]

            budget -= 1

        return population[0]

    initial_population_size = min(100, len(func.__code__.co_argcount * (ub - lb) / rng.uniform() + lb))
    population = generate_initial_population(initial_population_size)
    objective_values = compute_objective_values(population, func)

    best_individual = differential_evolution(population, objective_values, budget)

    return best_individual
