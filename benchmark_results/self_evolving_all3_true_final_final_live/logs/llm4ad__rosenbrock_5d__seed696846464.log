def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population():
        population = []
        for _ in range(50):
            candidate = np.zeros(dim)
            for i in range(dim):
                candidate[i] = lb + (ub - lb) * rng.uniform()
            population.append(candidate)
        return np.array(population)

    def evaluate_candidates(candidates):
        values = func(candidates)
        return candidates, values

    def simulated_annealing(current_solution, initial_temperature, cooling_rate, num_iterations):
        temperature = initial_temperature
        for _ in range(num_iterations):
            new_candidate = current_solution + (ub - lb) * rng.uniform(-1, 1, size=dim)
            new_candidate = clip(new_candidate)
            delta = func(new_candidate) - func(current_solution)
            if delta < 0 or np.exp(-delta / temperature) > rng.uniform():
                current_solution = new_candidate
            temperature *= cooling_rate
        return current_solution

    def differential_evolution(population, num_generations):
        for _ in range(num_generations):
            mutated_population = population + (ub - lb) * rng.uniform(-1, 1, size=(len(population), dim))
            crossed_population = np.zeros((len(population), dim))
            for i in range(len(population)):
                r = rng.randint(0, len(population))
                crossed_population[i] = mutated_population[i] + (population[r] - mutated_population[r]) * rng.uniform()
                crossed_population[i] = clip(crossed_population[i])
            population = np.array([func(candidate) for candidate in crossed_population])
        return np.argmax(population)

    initial_temperature = 1000
    cooling_rate = 0.95
    num_iterations_sa = int(budget / 2)
    num_generations_de = budget - num_iterations_sa

    population = generate_initial_population()
    best_solution = np.inf
    for _ in range(num_iterations_sa):
        current_solution = simulated_annealing(population[np.argmin([func(candidate) for candidate in population])], initial_temperature, cooling_rate, num_iterations_sa)
        population = np.append(population, [current_solution], axis=0)

    best_index_de = differential_evolution(population[:-1], num_generations_de)
    best_solution = np.min(func(population[best_index_de]))

    return population[np.argmin([func(candidate) for candidate in population])]
