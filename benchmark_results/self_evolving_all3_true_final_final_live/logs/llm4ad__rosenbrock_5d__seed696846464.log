def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(individual):
        individual = clip(individual)
        return func(individual)

    pop_size = 100
    mutation_factor = 0.5
    crossover_probability = 0.7
    temperature = 10.0

    population = rng.uniform(lb, ub, size=(pop_size, dim))
    best_individual = population[np.argmin([evaluate(x) for x in population])]

    for _ in range(budget):
        # Differential Evolution step
        for i in range(pop_size):
            idx1, idx2, idx3 = rng.choice(pop_size, 3, replace=False)
            mutation = population[idx1] + mutation_factor * (population[idx2] - population[idx3])
            crossover = np.where(rng.rand(dim) < crossover_probability, mutation, population[i])
            population[i] = clip(crossover)

        # Simulated Annealing step
        for i in range(pop_size):
            new_individual = population[np.argmin([evaluate(x) for x in population])]
            delta = evaluate(new_individual) - evaluate(population[i])
            if delta < 0 or rng.rand() < np.exp(-delta / temperature):
                population[i] = clip(new_individual)

        # Update best individual
        best_individual = population[np.argmin([evaluate(x) for x in population])]

    return best_individual
