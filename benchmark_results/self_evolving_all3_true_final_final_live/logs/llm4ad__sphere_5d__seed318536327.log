def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T0 = 1e6
    alpha = 0.99  # cooling factor
    step_size = (ub - lb) / 2
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        new_x = x + rng.uniform(-step_size, step_size, size=dim)
        new_x = np.clip(new_x, lb, ub)
        new_f = func(new_x)
        
        if new_f < best_f:
            best_x = new_x
            best_f = new_f

        T = max(T0 * alpha ** i, 1e-6)  # adaptive cooling schedule
        delta = new_f - best_f
        
        if delta < 0 or rng.random() < np.exp(-delta / T):
            x = new_x

    return best_x
