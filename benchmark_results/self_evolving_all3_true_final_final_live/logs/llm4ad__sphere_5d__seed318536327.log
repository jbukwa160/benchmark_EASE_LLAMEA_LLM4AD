def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = func(x_best)

    for i in range(budget):
        x_candidate = rng.normal(loc=x_best, scale=1, size=(dim,))
        x_candidate = np.clip(x_candidate, lb, ub)
        f_candidate = func(x_candidate)

        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate

    return x_best
