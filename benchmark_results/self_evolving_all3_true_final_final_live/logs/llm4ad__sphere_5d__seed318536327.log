def algorithm(func, dim, lb, ub, budget, rng):
    def gp_model(x):
        return -func(x)

    def log_likelihood(params, x, y):
        sigma2 = params[0]
        alpha = params[1:]
        k = len(alpha)
        n = len(x)
        L = np.linalg.cholesky(np.eye(k) + np.dot(np.transpose(alpha), alpha))
        mu = np.dot(np.transpose(L), np.dot(alpha, x))
        var = sigma2 - np.sum(np.square(np.multiply(np.dot(np.transpose(alpha), x), L)))
        return -0.5 * (np.dot(np.transpose(y - mu), np.linalg.solve(np.dot(np.transpose(L), L) + np.eye(k) / var, y - mu)) +
                       k * np.log(2 * np.pi * sigma2))

    def predict(x_new, gp_model, params):
        alpha = params[1:]
        sigma2 = params[0]
        x = np.array([gp_model[i][0] for i in range(len(gp_model)) if gp_model[i][1]])
        y = np.array([gp_model[i][0] for i in range(len(gp_model)) if gp_model[i][1]])
        Kxx = np.zeros((len(x), len(x)))
        for i in range(len(x)):
            for j in range(i, len(x)):
                Kxx[i, j] = Kxx[j, i] = np.dot(np.transpose(alpha), (x[i] - x[j]))**2 + sigma2
        L = np.linalg.cholesky(np.eye(len(x)) + np.dot(Kxx, np.linalg.solve(np.dot(np.transpose(Kxx), Kxx) + np.eye(len(x)), Kxx)))
        mu = np.dot(L, y)
        var = np.max(sigma2 - np.square(np.multiply(mu, L)))
        return mu, var

    dim_bounds = [(lb, ub)] * dim
    x_best = lb + (ub - lb) * rng.rand(dim)
    gp_model_list = []
    for _ in range(budget):
        x_new = lb + (ub - lb) * rng.rand(dim)
        for i in range(len(x_best)):
            if not rng.random() < 0.1:
                continue
            x_new[i] += (x_new[i] - x_best[i]) * rng.uniform(-1, 1)
        gp_model_list.append((gp_model(x_new), True))
        params = rng.uniform(1e-3, 1e2, dim + 1)
        for i in range(len(gp_model_list) - 1):
            ll = log_likelihood(params, [gp[i][0] for i in range(len(gp)) if gp[i][1]], [gp[i][0] for i in range(len(gp)) if gp[i][1]])
            params_new = rng.uniform(1e-3, 1e2, dim + 1)
            ll_new = log_likelihood(params_new, [gp[i][0] for i in range(len(gp)) if gp[i][1]], [gp[i][0] for i in range(len(gp)) if gp[i][1]])
            if ll_new > ll:
                params = params_new
        mu, var = predict(x_new, gp_model_list[-1][0], params)
        gp_model_list.append((mu + np.sqrt(var) * rng.randn(), False))
        y_best = min([gp[0] for gp in gp_model_list if gp[1]], default=np.inf)
        x_best = (x_new if y_new < y_best else x_best) if y_new != np.inf else x_new
    return np.clip(x_best, lb, ub)
