def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = np.zeros(dim)
    best_val = float('inf')
    
    for i in range(budget):
        candidate = lb + (ub - lb) * rng.rand(dim)
        candidate = np.clip(candidate, lb, ub)
        
        val = func(candidate)
        if val < best_val:
            best_sol = candidate
            best_val = val
    
    return best_sol
