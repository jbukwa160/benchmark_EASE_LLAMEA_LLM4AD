def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    for i in range(budget):
        x_new = rng.uniform(lb, ub, size=dim) + 0.1*rng.normal(0, 1, size=dim)
        x_new = lb + (ub - lb) * np.clip(x_new, 0, 1)
        f_new = func(x_new)
        if f_new < func(x_best):
            x_best = x_new
    return x_best
