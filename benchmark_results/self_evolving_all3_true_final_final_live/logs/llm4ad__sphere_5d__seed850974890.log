def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(-5, 5, size=dim)
    T = 10
    while T > 0.1:
        for _ in range(budget // dim):
            y = x.copy()
            i = rng.choice(dim)
            j = rng.choice(np.setdiff1d(range(dim), i))
            y[i] += rng.uniform(-T, T)
            y[j] -= rng.uniform(0, T)
            y = np.clip(y, lb, ub)
            if func(y) < func(x):
                x = y
        T *= 0.99
    return x
