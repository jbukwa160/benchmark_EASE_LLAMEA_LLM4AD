def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidates(mu, sigma, n_offsprings):
        candidates = mu + sigma * (rng.normal(size=(n_offsprings, dim)) @ cov)
        return np.clip(candidates, lb, ub)

    def update_step_size(sigma, candidate, func_value):
        if func_value < best_func_value:
            best_candidate = candidate
            best_func_value = func_value
        alpha = 0.01 / (1 + i / budget)  # decrease step size over iterations
        sigma *= 1 - alpha * np.abs(func_value - best_func_value)
        return sigma

    def update_covariance_matrix(cov, candidates):
        mu_new = np.mean(candidates, axis=0)
        cov_new = np.cov(candidates, rowvar=False) + learning_rate * (cov @ cov.T)
        cov_new /= 1 + learning_rate
        return cov_new

    best_candidate = lb + (ub - lb) * rng.uniform(size=dim)
    best_func_value = func(best_candidate)

    mu = best_candidate
    sigma = 0.5 * (ub - lb)  # initial step size
    cov = np.eye(dim)

    for i in range(1, budget):
        candidates = generate_candidates(mu, sigma, 10 * dim)
        func_values = [func(candidate) for candidate in candidates]
        indices = np.argsort(func_values)[:dim]  # select best candidates
        new_mu = np.mean(candidates[indices], axis=0)

        sigma = update_step_size(sigma, new_mu, min(func_values))

        cov = update_covariance_matrix(cov, candidates[indices])

        mu = 0.9 * mu + 0.1 * new_mu

    return best_candidate
