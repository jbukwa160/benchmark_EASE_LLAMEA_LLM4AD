def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    alpha = 1.0
    for i in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        f = func(x)
        if f < f_best:
            f_best = f
            x_best = x.copy()
        alpha *= 0.99
        n_samples = int(1e-6 + (ub - lb) * np.power(rng.rand(), 2))
        for _ in range(n_samples):
            step_size = rng.uniform(-alpha, alpha)
            x_trial = x_best + step_size * rng.randn(dim)
            f_trial = func(x_trial)
            if f_trial < f_best:
                f_best = f_trial
                x_best = x_trial.copy()
    return x_best
