def algorithm(func, dim, lb, ub, budget, rng):
    n = int(np.ceil(budget ** (1 / dim)))
    X = np.zeros((n, dim))
    Y = np.zeros(n)
    
    for i in range(1, n + 1):
        gp = GaussianProcessRegressor(kernel=ConstantKernel() * RBF(length_scale=[1] * dim), alpha=0.1)
        
        # Fit the model using previous data
        X_prev = X[:i - 1]
        Y_prev = Y[:i - 1]
        gp.fit(X_prev, Y_prev)
        
        # Predict the expected improvement at each point in the search space
        x_pred = np.linspace(lb, ub, 1000)
        x_pred_mesh = np.meshgrid(*[x_pred] * dim)
        X_pred = np.vstack([x[None, :] for x in x_pred_mesh]).reshape(-1, dim)
        
        # Calculate the expected improvement
        f_pred = gp.predict(X_pred)
        EI = f_pred - Y_prev[-1] + (f_pred - Y_prev[-1]) * (0.01 + 2 * np.exp(-(f_pred - Y_prev[-1]) / (0.1 ** 2)))
        
        # Select the next point to evaluate based on expected improvement
        x_next_idx = EI.argmax()
        X[i - 1] = X_pred[x_next_idx]
        Y[i - 1] = func(X[i - 1])
        
        if i == n:
            break
    
    res = minimize(func, X[-1], method='SLSQP', bounds=[(lb, ub)] * dim)
    
    return res.x
