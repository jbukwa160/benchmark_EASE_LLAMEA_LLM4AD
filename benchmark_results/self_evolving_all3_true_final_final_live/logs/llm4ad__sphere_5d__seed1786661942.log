def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        sigma = 1.0
        N = int(rng * budget) + 1
        
        mu = x.copy()
        
        lambda_ = np.random.normal(mu, sigma, size=(N, dim))
        lambda_ = clip(lambda_)
        
        f_values = func(lambda_)
        
        idx = np.argsort(f_values)
        lambda_[idx[:int(0.5 * N)]] *= 1.01
        lambda_[idx[int(0.5 * N):]] *= 0.99
        
        mu = np.mean(lambda_, axis=0)
        x = clip(mu)
        
        f_value = func(x)
        
        if f_value < best_f:
            best_x = x.copy()
            best_f = f_value
    
    return best_x
