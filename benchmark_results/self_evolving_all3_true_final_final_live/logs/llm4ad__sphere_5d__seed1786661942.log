def algorithm(func, dim, lb, ub, budget, rng):
    X = np.random.uniform(lb, ub, (budget, dim))
    Y = func(X)
    
    def gp_mean(x):
        k = np.exp(-np.sum((X - x) ** 2, axis=1) / (2 * 0.5 ** 2))
        return np.mean(Y) + np.dot(k, np.mean(Y) - Y) / np.sum(k)

    def gp_var(x):
        k = np.exp(-np.sum((X - x) ** 2, axis=1) / (2 * 0.5 ** 2))
        return 1 - np.sum(np.dot(k, k)) + np.sum(k ** 2) / np.sum(k)

    best_x = X[np.argmin(Y)]
    best_y = np.min(Y)
    
    for i in range(budget):
        x_new = rng.uniform(lb, ub, dim)
        
        gp_mean_new = gp_mean(x_new)
        gp_var_new = gp_var(x_new)
        
        if gp_var_new == 0:
            continue
        
        pi = norm.cdf(0, loc=gp_mean_new - best_y, scale=np.sqrt(gp_var_new))
        
        u = rng.uniform(0, 1)
        if u < pi or i > budget * 2 / 3:
            x_new = clip(x_new, lb, ub)
            
            y_new = func([x_new])
            
            if y_new < best_y:
                best_x = x_new
                best_y = y_new
                
    return np.array(best_x)
