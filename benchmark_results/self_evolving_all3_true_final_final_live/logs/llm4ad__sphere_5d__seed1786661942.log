def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Greedily select the best dimension
        greedy_idx = np.argmax(np.abs(func(x + 1e-6 * np.eye(dim)) - func(x)))
        
        # Perturb the greedy dimension randomly
        new_x = x.copy()
        new_x[greedy_idx] += rng.uniform(-1, 1) * (ub - lb)
        new_x[new_x < lb] = lb
        new_x[new_x > ub] = ub
        
        # Evaluate new candidate and update best if necessary
        f_new = func(new_x)
        if f_new < best_f:
            best_f = f_new
            best_x = new_x.copy()

    return best_x
