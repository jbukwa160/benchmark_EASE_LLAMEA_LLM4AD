def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def sample():
        return rng.normal(size=dim)

    def update(X_best):
        n = len(X_best)
        mu = np.mean(X_best, axis=0)
        cov = np.cov(np.transpose(X_best - mu))
        L = np.linalg.cholesky(cov + 1e-8 * np.eye(dim)) if dim == 3 else np.linalg.cholesky(cov + 1e-8 * np.eye(dim))
        return clip(mu), L

    X_best = []
    best_score = np.inf
    mu, L = sample(), 0

    for _ in range(budget):
        X = [clip(mu + L @ rng.normal(size=dim)) for _ in range(50)]
        scores = [func(x) for x in X]
        if min(scores) < best_score:
            best_score = min(scores)
            X_best = X[np.argmin(scores)]

        mu, L = update(X_best)

    return np.array(X_best)
