def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(1, dim))
    pop_size = 10
    sigma = 0.5
    while True:
        for _ in range(pop_size):
            y = x + np.random.normal(size=x.shape)
            np.clip(y, lb, ub, out=y)
            if func(y) < func(x):
                x = y
        sigma *= 1 - 1 / (budget * pop_size + 1)
        budget -= pop_size
        if budget <= 0:
            break
    return x
