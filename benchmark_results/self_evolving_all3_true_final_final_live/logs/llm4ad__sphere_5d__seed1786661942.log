def algorithm(func, dim, lb, ub, budget, rng):
    mean = np.zeros(dim)
    cov = np.eye(dim)
    sigma = 1.0
    best_x = None
    best_f = float('inf')

    for _ in range(budget):
        x = rng.normal(mean, scale=sigma)[:, None]
        x = np.clip(x, lb, ub)

        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x

        delta = x - mean
        cov += sigma**2 * delta @ delta.T / (dim + 1)
        mean += (np.dot(delta, rng.normal(size=dim)) / np.sqrt(dim + 1))
        
    return best_x if best_x is not None else np.zeros((0,))
