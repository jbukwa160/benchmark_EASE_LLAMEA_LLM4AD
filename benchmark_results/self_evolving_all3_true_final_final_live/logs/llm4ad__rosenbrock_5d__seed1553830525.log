def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    sigma = 1.0
    t = 0
    while t < budget:
        if t % 100 == 0:
            sigma *= np.exp(-0.00001 * (t / 100))

        for _ in range(2 * dim):
            y = best_x + rng.normal(size=dim) * sigma

            # Clip candidates to [lb, ub]
            y = np.clip(y, lb, ub)

            f_y = func(y)
            if f_y < best_f:
                best_x = y
                best_f = f_y

        t += 1

    return best_x
