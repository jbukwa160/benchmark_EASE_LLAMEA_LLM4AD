def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_process(x, y, x_new):
        cov_func = 1 + (x[:, None] - x_new) ** 2
        mean = func(x)
        cov = 0.5 * np.log(np.diag(cov_func))**2
        return np.mean(mean), np.var(y)

    def sample_gaussian_process(mean, var):
        samples = np.random.normal(loc=mean, scale=np.sqrt(var))
        return samples

    x_best = rng.uniform(lb, ub, size=(1, dim))
    y_best = func(x_best)
    
    for i in range(budget):
        x_new = sample_gaussian_process(*gaussian_process(x_best, y_best, x_best), size=(1, dim))
        while True:
            if np.any(np.logical_or(x_new < lb, x_new > ub)):
                x_new = rng.uniform(lb, ub, size=(1, dim))
            else:
                break
        
        y_new = func(x_new)
        
        if y_new < y_best:
            x_best = x_new
            y_best = y_new
    
    return x_best
