def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def func_x(x):
        x = clip(x)
        return func(x)

    def rs_budget_search():
        best_x = None
        while True:
            x = rng.uniform(lb, ub, size=dim)
            f_x = func_x(x)
            if best_x is None or f_x < func_x(best_x):
                best_x = x
            yield best_x

    def de_population(initial_pop_size, mutation_factor, crossover_prob):
        pop = rng.normal(size=(initial_pop_size, dim))
        while True:
            yield pop

    budget /= 2
    rs_budget = int(budget * 0.7)
    de_budget = budget - rs_budget
    pop_rs = list(rs_budget_search() for _ in range(rs_budget))

    def de_step(pop):
        new_pop = np.copy(pop)
        for i in range(new_pop.shape[0]):
            r1, r2, r3 = rng.choice(pop_rs, size=3, replace=False)
            v = mutation_factor * (r1 - 2*r2 + r3)
            u = rng.uniform(0, 1, size=dim)
            if np.any(u < crossover_prob):
                new_pop[i] += v
        return new_pop

    pop_de = next(de_population(50, 10, 0.5))
    for _ in range(int(de_budget)):
        pop_de = de_step(pop_de)

    best_x_rs = max(pop_rs, key=func_x)
    best_x_de = np.mean(pop_de, axis=0)

    if func_x(best_x_rs) < func_x(best_x_de):
        return clip(best_x_rs)
    else:
        return clip(best_x_de)
