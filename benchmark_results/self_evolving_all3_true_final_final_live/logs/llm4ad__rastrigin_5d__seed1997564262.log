def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    N = 1000  # population size
    M = int(np.floor(budget / (D * N)))  # number of generations
    sigma = 1.4 * (ub - lb) / np.sqrt(D)  # initial step size using LHS
    mean = np.zeros(D)
    cov = np.eye(D)

    for m in range(M):
        # Latin Hypercube Sampling
        X = rng.uniform(0, 1, (N, D))
        X = ub - (ub - lb) * np.sort(X, axis=0, kind='mergesort')
        
        # Covariance Matrix Adaptation Evolution Strategy
        F = func(X)
        idx = np.argsort(F)
        f_best = F[idx[0]]
        x_best = X[idx[0]]

        if m == 0 or f_best < best_f:
            best_x = x_best
            best_f = f_best

        cov_new = (1 - 2 / (D + 3)) * cov + np.outer((X[idx[N // 2]] - mean), (X[idx[N // 2]] - mean))
        cov_inv_new = np.linalg.inv(cov_new)

        sigma_new = sigma * np.exp(np.sqrt(2 / (D + 1) * np.log(D + 3)))
        cov_new = sigma_new ** 2 * cov_inv_new
        sigma = sigma_new

        mean_new = mean + cov_new @ ((X[idx[N // 2]] - mean))
        mean = mean_new

        cov = cov_new

    return best_x
