def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(dim, population_size):
        return rng.uniform(lb, ub, (population_size, dim))

    def compute_fitness(candidate, func):
        return func(candidate)

    def select_parents(population, fitnesses, population_size):
        indices = np.argsort(fitnesses)[:population_size]
        return population[indices], fitnesses[indices]

    def crossover(parent1, parent2, rng):
        alpha = 0.5 + rng.uniform(0, 0.9)
        return alpha * parent1 + (1 - alpha) * parent2

    def mutation(child, lb, ub, rng):
        for i in range(dim):
            if rng.uniform(0, 1) < 0.1:
                child[i] += (ub - lb) * rng.uniform(-1, 1)
                child[i] = clip(child, lb, ub)[i]
        return child

    def differential_evolution(population_size, dim, lb, ub, budget, func, rng):
        population = generate_initial_population(dim, population_size)
        fitnesses = [compute_fitness(candidate, func) for candidate in population]

        for _ in range(budget):
            parent1, fitness1 = select_parents(population, fitnesses, 3)
            parent2, fitness2 = select_parents(population, fitnesses, 3)
            child = crossover(parent1, parent2, rng)
            child = mutation(child, lb, ub, rng)

            fitness_child = compute_fitness(child, func)
            if fitness_child < min(fitnesses):
                population[-1] = child
                fitnesses[-1] = fitness_child

        return select_parents(population, fitnesses, 1)[0]

    return differential_evolution(50, dim, lb, ub, budget, func, rng)
