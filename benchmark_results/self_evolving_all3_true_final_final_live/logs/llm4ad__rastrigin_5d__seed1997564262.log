def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population():
        population = rng.uniform(lb, ub, size=(budget, dim))
        return population

    def differential_evolution(population, generation):
        for i in range(budget):
            candidates = population.copy()
            x1, x2, x3 = np.random.choice(range(budget), 3, replace=False)
            if rng.rand() < 0.5:
                candidate = clip_candidate(candidates[x1] + rng.uniform(-1, 1) * (candidates[x2] - candidates[x3]))
            else:
                candidate = clip_candidate(candidates[x1] + rng.uniform(-1, 1) * (candidates[x3] - candidates[x2]))
            if func(candidate) < func(candidates[i]):
                population[i] = candidate
        return population

    def restart_search(max_generations):
        population = generate_initial_population()
        for generation in range(max_generations):
            population = differential_evolution(population, generation)
            if rng.rand() < 0.1 and generation > 10:
                return algorithm(func, dim, lb, ub, budget, rng)
            if np.all(np.isclose(population, 0)):
                return population[0]
        return population[np.argmin([func(candidate) for candidate in population])]

    population = restart_search(100)
    best_candidate = population[np.argmin([func(candidate) for candidate in population])]
    return best_candidate
