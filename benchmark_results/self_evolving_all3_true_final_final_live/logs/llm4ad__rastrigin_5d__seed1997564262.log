def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_y = func(x)

    for _ in range(budget):
        v = rng.normal(size=dim)
        u = x + 0.5 * v
        y = func(u)

        if y < best_y:
            best_x = u
            best_y = y

        c1, c2, m = rng.uniform(lb, ub, size=3)
        z = np.clip(best_x + (u - best_x) / 2 + c1 * (best_x - x) + c2 * (u - x), lb, ub)

        if func(z) < best_y:
            x = z

    return np.clip(best_x, lb, ub)
