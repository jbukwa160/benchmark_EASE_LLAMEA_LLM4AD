def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def sample(rng):
        return rng.uniform(lb, ub, size=(dim))

    def evaluate(x):
        x = clip(x)
        return func(x)

    best_x = None
    best_f = float('inf')
    n_restart = 0

    for _ in range(budget):
        if n_restart >= 10:
            break

        pop_size = 50
        population = [sample(rng) for _ in range(pop_size)]
        f_values = [evaluate(x) for x in population]

        for i in range(100):  # Number of iterations
            mu = np.mean(np.array(population), axis=0)
            sigma = 1.0 / (np.log(i + 2))
            next_population = []

            for _ in range(pop_size):
                noise = rng.normal(mu, sigma, size=(dim))
                x_new = clip(mu + noise)

                f_value = evaluate(x_new)
                if f_value < np.min(f_values) or rng.random() < 0.1:
                    next_population.append(x_new)
                    f_values.append(f_value)
                else:
                    idx = np.argmin(f_values)
                    next_population.append(population[idx])
                    f_values[idx] = f_value

            population = next_population
            f_values.sort()
            if f_values[0] < best_f:
                best_x = population[0]
                best_f = f_values[0]

        n_restart += 1

    return best_x
