def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(current, step_size):
        return current + step_size * rng.normal(size=dim)

    def levy_flight(candidate, alpha, sigma):
        u = rng.uniform(-1, 1)
        v = rng.uniform(-1, 1)
        w = (u**2 - v**2) / (alpha**2 + u**2 + v**2)
        return candidate + sigma * np.sqrt(abs(w)) * rng.normal(size=dim)

    def evaluate(candidate):
        try:
            return func(candidate), None
        except Exception as e:
            print(f"Error evaluating function at {candidate}: {e}")
            return 1e10, f"Error: {e}"

    current = rng.uniform(lb, ub, size=dim)
    best = np.copy(current)

    alpha = 0.01
    sigma = 0.05
    temperature = 100

    for i in range(budget):
        step_size = (ub - lb) / np.sqrt(i + 1)
        candidate = generate_candidate(current, step_size)
        clipped_candidate = np.clip(candidate, lb, ub)

        value, message = evaluate(clipped_candidate)
        if message:
            continue
        if value < func(best):
            best = np.copy(clipped_candidate)

        current = levy_flight(current, alpha, sigma) if rng.uniform(0, 1) > 0.9 else clipped_candidate
        clipped_current = np.clip(current, lb, ub)

        value, message = evaluate(clipped_current)
        if message:
            continue

        temperature *= 0.99
        if value < func(best):
            best = np.copy(clipped_current)

    return best
