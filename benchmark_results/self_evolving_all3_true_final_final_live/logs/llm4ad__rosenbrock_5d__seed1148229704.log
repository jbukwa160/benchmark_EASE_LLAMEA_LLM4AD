def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidates):
        return np.clip(candidates, lb, ub)

    x = np.array([0.5] * dim)
    T = 100
    step_size = 1
    accepted = []

    for _ in range(budget):
        x_prev = x.copy()
        delta = rng.uniform(-step_size, step_size) * np.ones(dim)
        x += delta

        f_prev = func(x_prev)
        f_new = func(clip(x))

        if f_new < f_prev:
            accepted.append(True)
            x = clip(x)
        else:
            alpha = 0.1
            exp_term = - (f_new - f_prev) / T
            accept_prob = np.exp(exp_term)
            if rng.uniform() < accept_prob:
                accepted.append(True)
                x = clip(x)
            else:
                x = x_prev

        T *= 0.99
        step_size *= 0.9995

    return x
