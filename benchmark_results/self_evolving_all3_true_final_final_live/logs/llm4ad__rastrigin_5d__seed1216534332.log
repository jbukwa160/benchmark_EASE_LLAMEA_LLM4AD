def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    x_best = x.copy()
    f_best = func(x)
    
    for i in range(budget - 1):
        x_new = x + rng.normal(size=x.shape) * (ub - lb) / 3
        x_new = np.clip(x_new, lb, ub)
        
        if func(x_new) < f_best:
            x_best = x_new.copy()
            f_best = func(x_new)
            
        sigma = (ub - lb) / 2.5
        for j in range(dim):
            if rng.random() < 0.1:
                x[j] += rng.normal(0, sigma)
                x[j] = np.clip(x[j], lb, ub)
        
    return x_best
