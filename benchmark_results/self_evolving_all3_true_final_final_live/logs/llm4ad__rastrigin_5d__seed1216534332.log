def algorithm(func, dim, lb, ub, budget, rng):
    def is_within_bounds(x):
        return (lb <= x).all() and (x <= ub).all()

    def generate_initial_population(budget):
        population = rng.uniform(lb, ub, size=(budget, dim))
        for i in range(budget):
            population[i] = np.clip(population[i], lb, ub)
        return population

    def evaluate(x):
        return func(x)

    def crossover(parent1, parent2, step_size):
        child = parent1 + rng.uniform(-step_size, step_size, size=dim)
        child = np.clip(child, lb, ub)
        return child

    def mutation(child, step_size):
        for i in range(dim):
            if rng.random() < 0.1:
                child[i] += rng.uniform(-step_size, step_size)
                child[i] = np.clip(child[i], lb, ub)
        return child

    population = generate_initial_population(budget)
    best_solution = np.zeros(dim)

    for generation in range(100): # fixed number of generations
        for i in range(budget):
            parent1, parent2 = rng.choice(population, size=2, replace=False)
            step_size = 0.5 / (generation + 1) # adaptive step size
            child = crossover(parent1, parent2, step_size)
            mutated_child = mutation(child, step_size)
            fitness_child = evaluate(mutated_child)
            fitness_parent1 = evaluate(parent1)
            fitness_parent2 = evaluate(parent2)

            if fitness_child < fitness_parent1:
                population[i] = mutated_child
            elif fitness_child < fitness_parent2:
                population[i] = mutated_child

            if is_within_bounds(population[i]):
                if evaluate(population[i]) < evaluate(best_solution):
                    best_solution = population[i]

    return best_solution
