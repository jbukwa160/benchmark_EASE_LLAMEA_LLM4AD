def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_y = func(x)

    for _ in range(budget):
        # Differential Evolution
        v = rng.uniform(-1, 1, size=dim) + x
        v = clip(v)

        # Probabilistic exploration
        if rng.random() < 0.1:
            w = np.roll(v, rng.randint(0, dim))
            w = clip(w)
            y = func(w)
            if y < best_y:
                best_x = w.copy()
                best_y = y

        # Selection and mutation
        u = rng.uniform(lb, ub, size=dim)
        z = 0.5 * (v + u) + x
        z = clip(z)

        y = func(z)
        if y < best_y:
            best_x = z.copy()
            best_y = y

    return best_x
