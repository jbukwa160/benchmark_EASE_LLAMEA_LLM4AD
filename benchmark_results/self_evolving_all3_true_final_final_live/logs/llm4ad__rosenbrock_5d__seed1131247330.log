def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def rand_candidates(n, d):
        return rng.uniform(lb, ub, (n, d))

    n = int(np.ceil(budget / 2))
    D = np.array([1.0, 1.0])
    F = 0.5
    T = budget

    current = rng.uniform(lb, ub)
    best = current
    for t in range(1, budget + 1):
        new_candidates = rand_candidates(n, dim) + clip(current + D * rng.normal(size=(n, dim)))
        fitnesses = [func(new_candidate) for new_candidate in new_candidates]
        indices = np.argsort(fitnesses)[:budget // 2]
        new_candidates = new_candidates[indices]

        for i in range(budget // 2):
            mutated = clip(new_candidates[i] + F * (current - new_candidates[i]) + rng.normal(size=dim))
            new_fitness = func(mutated)

            if new_fitness < fitnesses[i]:
                current = mutated
            elif np.exp(-(new_fitness - fitnesses[i]) / T) > rng.uniform():
                current = mutated

        best = clip(current)
        if t % 100 == 0:
            print(f'Iteration {t}: Best fitness = {func(best)}')

    return best
