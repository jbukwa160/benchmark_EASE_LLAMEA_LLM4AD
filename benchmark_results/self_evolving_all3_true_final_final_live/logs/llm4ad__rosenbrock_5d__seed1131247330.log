def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    n = dim
    bounds = [(lb[i], ub[i]) for i in range(n)]

    population_size = 50
    pop = rng.uniform(lb, ub, (population_size, n))

    for _ in range(budget):
        fit = np.array([evaluate(clip(x, lb, ub)) for x in pop])
        idx_best = np.argmin(fit)
        best_x = clip(pop[idx_best], lb, ub)

        if rng.random() < 0.1:
            pop[idx_best] = rng.uniform(lb, ub, n)

        new_pop = []
        for _ in range(population_size):
            choice_idx = rng.choice(n, size=3, replace=False)
            x_new = pop[rng.choice(population_size)]
            x_new[choice_idx] += 0.1 * (pop[rng.choice(population_size), choice_idx] - pop[rng.choice(population_size), choice_idx])
            new_pop.append(clip(x_new, lb, ub))
        pop = np.array(new_pop)

    return best_x
