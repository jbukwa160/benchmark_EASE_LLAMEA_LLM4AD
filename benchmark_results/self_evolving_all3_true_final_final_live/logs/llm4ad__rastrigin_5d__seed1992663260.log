def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def sample(rng):
        x = rng.uniform(-5, 5, size=dim)
        return x

    def evaluate(x):
        return func(x)

    n_samples = 0
    best_x = None
    best_f = float('inf')

    while n_samples < budget:
        # Simple Random Search (SRS) phase: sample random points in the search space
        for _ in range(50):
            x_new = sample(rng)
            f_new = evaluate(x_new)
            if f_new < best_f:
                best_x = clip(x_new)
                best_f = f_new

        # Covariance Matrix Adaptation Evolution Strategy (CMA-ES) phase: refine the search around the current best point
        cma_mu, cma_lambda = 10, 100
        cma_mean = np.array(best_x)
        cma_cov = np.eye(dim) * 1e-4

        for _ in range(50):
            n_samples += 1
            x_new = np.clip(np.random.multivariate_normal(cma_mean, cma_cov), lb, ub)
            f_new = evaluate(x_new)
            if f_new < best_f:
                best_x = x_new
                best_f = f_new

    return clip(best_x)
