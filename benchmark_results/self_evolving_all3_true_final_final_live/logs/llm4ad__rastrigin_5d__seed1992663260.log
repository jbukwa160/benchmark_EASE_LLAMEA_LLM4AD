def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(distribution='normal', mean=0, std_dev=1):
        if distribution == 'uniform':
            return (ub - lb) * np.random.rand(dim) + lb
        elif distribution == 'normal':
            return mean + std_dev * rng.normal(size=(dim,))
        else:
            raise ValueError('Invalid distribution type.')

    def evaluate(candidate):
        candidate = np.clip(candidate, a_min=lb, a_max=ub)
        return func(candidate)

    x_best = get_candidate(distribution='uniform')
    f_best = evaluate(x_best)

    for _ in range(budget):
        n = rng.randint(1, dim + 1)
        indices = rng.choice(dim, size=n, replace=False)

        parents = [get_candidate(distribution='normal', mean=x_best, std_dev=0.5) for _ in range(n)]

        candidates = np.array([evaluate(parent) for parent in parents])
        f_min_parent = np.min(candidates)
        indices_child = np.where(candidates == f_min_parent)[0]

        child = get_candidate(distribution='uniform')
        for i in indices:
            child[i] = (parents[indices_child][i] + rng.uniform(-1, 1) * (x_best[i] - parents[indices_child][i])) / 2

        candidate = np.clip(child, a_min=lb, a_max=ub)
        f_candidate = evaluate(candidate)

        if f_candidate < f_best:
            x_best = candidate
            f_best = f_candidate

    return x_best
