def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population():
        return rng.uniform(lb, ub, size=(budget, dim))

    def evaluate_population(population):
        return [func(clip(x)) for x in population]

    def differential_evolution(population, evaluations_left):
        while evaluations_left > 0:
            for i in range(len(population)):
                z = np.random.choice(np.delete(range(dim), i))
                v = population[i] + rng.uniform(-1, 1) * (population[z] - population[i])
                if func(clip(v)) < func(clip(population[i])):
                    population[i] = v
            evaluations_left -= 1

    def simulated_annealing(population):
        temperature = 1000.0
        while temperature > 10.0:
            for i in range(len(population)):
                x = np.random.choice(range(dim))
                y = rng.uniform(lb, ub)
                v = population[i] + (y - population[i][x]) * np.array([1 if j == x else 0 for j in range(dim)])
                delta = func(clip(v)) - func(clip(population[i]))
                if delta < 0 or rng.uniform(0, 1) < np.exp(-delta / temperature):
                    population[i] = v
            temperature *= 0.99

    initial_population = generate_initial_population()
    evaluations = evaluate_population(initial_population)
    best_solution_index = np.argmin(evaluations)

    differential_evolution(initial_population, budget - 1)
    simulated_annealing(initial_population)
    return clip(initial_population[best_solution_index])
