def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(clip(x_best))

    for i in range(budget):
        n_candidates = int(1e4 / np.sqrt(i + 1))
        x_candidates = clip(lb + (ub - lb) * rng.randn(n_candidates, dim))

        f_candidates = func(x_candidates)

        idx_sorted = np.argsort(f_candidates)
        x_top = x_candidates[idx_sorted[:n_candidates//2]]
        f_top = f_candidates[idx_sorted[:n_candidates//2]]

        x_best = x_top[np.argmin(f_top)]
        f_best = min(f_best, func(clip(x_best)))

    return clip(x_best)
