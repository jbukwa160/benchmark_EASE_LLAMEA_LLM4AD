def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = dim
    n_pop = 4 * D + 5
    pop = rng.uniform(lb, ub, size=(n_pop, D))
    cov = np.eye(D) * (ub - lb) ** 2 / 3.0
    mu = np.mean(pop, axis=0)

    for t in range(budget):
        fitness = func(clip(pop))
        if t % 100 == 0:
            print(f"Budget: {t}, Fitness: {np.min(fitness)}")

        cov_new = (1 - 2.38 / (t + 1)) * cov
        for i in range(n_pop):
            z = rng.randn(D)
            child = clip(mu + np.sqrt(cov_new) @ z)
            pop[i] = child

    best_idx = np.argmin(func(clip(pop)))
    return pop[best_idx]
