def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def rastrigin(x):
        return 10*dim + np.sum(x**2 - 10*np.cos(2*np.pi*x))

    x = rng.uniform(lb, ub, size=(1, dim))
    best_x = x
    best_f = func(x)
    for _ in range(budget):
        v = rng.normal(size=(1, dim))
        u = np.zeros((1, dim))
        y = clip(best_x + 0.5 * (ub - lb) * v, lb, ub)
        f = func(y)
        if rng.random() < np.exp(-f/best_f):
            best_f = f
            best_x = y
        for _ in range(dim):
            u += rng.uniform(-1, 1, size=(1, dim))
            u /= np.linalg.norm(u) + 1e-8
            y = clip(best_x + 0.5 * (ub - lb) * v + (ub - lb) * u, lb, ub)
            f = func(y)
            if rng.random() < np.exp(-f/best_f):
                best_f = f
                best_x = y
    return best_x
