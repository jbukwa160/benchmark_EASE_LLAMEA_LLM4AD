def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_process(x, y, n_predict=1):
        theta = 1e-10 * np.ones((dim,))
        sigma = 0.01 + np.exp(np.random.normal(0, 2, (n_predict, dim)))
        K = np.zeros((len(y), n_predict))
        for i in range(n_predict):
            for j in range(len(y)):
                K[j, i] = np.exp(-np.sum(((x[j] - x[i])**2) / theta**2)) * sigma[i]
        K += 1e-6 * np.eye(n_predict)
        alpha = np.linalg.solve(K, y)
        mean = np.dot(alpha, np.transpose(x))
        var = np.diag(np.dot(np.dot(x.T, K), x))
        return mean, var

    def acquisition_function(mean, var):
        return -mean / (1 + var)

    x = rng.uniform(lb, ub, size=(dim,))
    y = func(x)
    best_x = x.copy()
    best_y = y
    for _ in range(budget):
        mu, sigma = gaussian_process(x, y)
        acquisition = acquisition_function(mu, sigma**2 + 1e-6)
        x_new = rng.multivariate_normal(np.zeros(dim), np.eye(dim) * 0.01)
        x_new = lb + (ub - lb) * rng.uniform(size=(dim,))
        while True:
            if np.all(x_new >= lb) and np.all(x_new <= ub):
                break
            x_new = lb + (ub - lb) * rng.uniform(size=(dim,))
        y_new = func(x_new)
        if y_new < best_y or _ % 10 == 0:
            best_x = x_new.copy()
            best_y = y_new
        x = np.vstack((x, x_new))
        y = np.append(y, y_new)
    return best_x
