def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    pop_size = 50
    strategy = "rand/1/bin"
    F = 0.5
    cr = 0.9

    population = rng.uniform(lb, ub, (pop_size, dim))
    best_fitness = float("inf")
    best_candidate = np.zeros(dim)

    for _ in range(budget):
        offspring = []
        fitness_values = [func(candidate) for candidate in population]

        for i in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size, 3)
            while r1 == i or r2 == i or r3 == i:
                r1, r2, r3 = rng.randint(0, pop_size, 3)

            u = population[r1] + F * (population[r2] - population[r3])
            v = rng.uniform(0, 1, dim)
            candidate = clip(u + v, lb, ub)
            offspring.append(candidate)

        fitness_values_offspring = [func(candidate) for candidate in offspring]
        indices = np.argsort(fitness_values_offspring)[:pop_size]

        population = [offspring[i] for i in indices]
        fitness_values = [fitness_values_offspring[i] for i in indices]

        if min(fitness_values) < best_fitness:
            best_fitness = min(fitness_values)
            best_candidate = population[fitness_values.index(min(fitness_values))]

    return best_candidate
