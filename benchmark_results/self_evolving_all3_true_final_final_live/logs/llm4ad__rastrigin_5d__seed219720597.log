def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    best_sol = np.zeros(dim)
    best_obj = float('inf')
    temp = 1.0

    for _ in range(budget):
        x = clip(rng.uniform(size=dim) * (ub - lb) + lb)
        obj = func(x)
        
        if obj < best_obj:
            best_sol = x
            best_obj = obj
            
        delta = obj - best_obj
        prob_accept = np.exp(-delta / temp)
        
        if rng.random() < prob_accept:
            best_sol = x
        
        temp *= 0.99
    
    return best_sol
