def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    x_best = x.copy()
    best_fitness = func(x)
    for _ in range(budget):
        y = x + 0.5 * (rng.uniform(-1, 1, size=dim) - rng.uniform(-1, 1, size=dim))
        y = clip(y)
        fitness = func(y)
        if fitness < best_fitness:
            x_best = y.copy()
            best_fitness = fitness
        elif np.random.rand() < np.exp((best_fitness - fitness) / 10):
            x = y.copy()
    return x_best
