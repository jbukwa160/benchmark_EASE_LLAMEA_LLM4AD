def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    n = 0
    best_x = np.random.uniform(lb, ub, size=(dim,))
    best_fx = evaluate(best_x)
    sigma = 1.0
    T = 100.0

    while n < budget:
        for i in range(dim):
            x_new = best_x.copy()
            x_new[i] += np.random.normal(0, sigma * rng)

            if lb <= x_new[i] <= ub:
                f_new = evaluate(x_new)
            else:
                continue

            delta_f = f_new - best_fx
            acceptance_prob = 1.0 / (1 + np.exp(-delta_f / T))

            if delta_f < 0 or rng.random() < acceptance_prob:
                best_x = x_new
                best_fx = f_new

        sigma *= 0.99
        n += 1

    return best_x
