def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(best_x)
    
    for i in range(budget):
        x = np.copy(best_x)
        idx = [np.random.choice(dim) for _ in range(int(0.1 * dim))]
        
        for j in idx:
            if rng.rand() < 0.5 and lb <= best_x[j] + rng.randn() * (ub - lb) / 10 and ub >= best_x[j] + rng.randn() * (ub - lb) / 10:
                x[j] = np.clip(best_x[j] + rng.randn() * (ub - lb) / 10, lb, ub)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = np.copy(x)
    
    return best_x
