def algorithm(func, dim, lb, ub, budget, rng):
    def acquisition(x, gp, mean_func, std_func, ehvi_func, bounds):
        y_mean = mean_func(gp.predict(x.reshape(1, -1))[0])
        y_std = std_func(gp.predict(x.reshape(1, -1))[1])
        return ehvi_func(y_mean, y_std, x, bounds)

    def expected_hypervolume_improvement(mean, std_dev, point, bounds):
        return mean + 1.96 * std_dev

    def gaussian_process(mean_func, std_func):
        return np.mean(rng.uniform(0, 10, size=(dim, dim))), np.std(rng.uniform(0, 10, size=(dim, dim)))

    def surrogate_model(x):
        gp_mean, gp_std = gaussian_process(mean_func, std_func)
        y_gp = mean_func(gp_mean) + std_func(gp_std) * rng.normal(size=1)[0]
        return -y_gp

    n_dim = dim
    bounds = [(lb, ub)] * n_dim
    x_best = np.random.uniform(lb, ub, size=n_dim)
    budget_remaining = budget
    gp_mean_func = lambda x: np.mean(x)
    gp_std_func = lambda x: 1e-6

    for i in range(budget):
        if rng.rand() < 0.05:
            x_new = acquisition(np.array([x_best]), surrogate_model, gp_mean_func, gp_std_func,
                                expected_hypervolume_improvement, bounds)
        else:
            x_new = np.clip(x_best + 0.1 * (ub - lb) * rng.randn(n_dim), a_min=lb, a_max=ub)

        y_new = func(x_new)

        if y_new < surrogate_model(x_best):
            x_best = x_new

    return x_best
