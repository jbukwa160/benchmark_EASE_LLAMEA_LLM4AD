def algorithm(func, dim, lb, ub, budget, rng):
    def log_transform(x):
        return 0.5 * np.log((x - lb + 1e-8) / (ub - lb + 1e-8) + 1)

    def inverse_log_transform(x):
        return lb + (np.exp(2 * x) - 1) * (ub - lb)

    def cma_es(log_mu, log_sig, num_iter):
        mu = np.exp(log_mu)
        sig = np.exp(log_sig)
        sigma_trace = [sig]
        best_x = None
        for _ in range(num_iter):
            z = rng.normal(size=dim) * (1 + 2e-8)
            c = rng.normal(size=dim)
            y = mu + sigma_trace[-1] * np.dot(c, z)
            x_log = log_transform(y)
            x_norm = np.linalg.norm(x_log)
            if best_x is None or x_norm < np.linalg.norm(log_mu):
                best_x = y
            sigma_log = log_sig + 0.5 * (x_norm**2 - dim) / np.exp(2 * log_mu)
            sigma_new = sig * np.exp(sigma_log - log_sig)
            if sigma_trace[-1] <= sigma_new:
                sigma_trace.append(sigma_new)

        return best_x

    x_log = rng.normal(size=dim, loc=0, scale=1e-8)
    for i in range(budget):
        best_x_log = cma_es(x_log, 0, budget - i)
        best_x = inverse_log_transform(best_x_log)
        best_f = func(best_x)

        if best_f < np.inf:
            x_log = best_x_log

    return inverse_log_transform(cma_es(x_log, 0, budget))
