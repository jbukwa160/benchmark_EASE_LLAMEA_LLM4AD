def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_candidate(current_solution):
        step_size = 0.5
        candidate = current_solution + rng.uniform(-step_size, step_size, size=dim)
        return clip(candidate)

    def evaluate_and_update(current_solution, current_fitness, candidate, new_fitness):
        if new_fitness < current_fitness:
            return candidate, new_fitness
        else:
            acceptance_probability = np.exp((current_fitness - new_fitness) / (rng.uniform() * 0.1))
            if rng.uniform() < acceptance_probability:
                return candidate, new_fitness
            else:
                return current_solution, current_fitness

    def adaptive_cooling_schedule(iteration):
        cooling_rate = 1 / iteration
        temperature = 100 * np.exp(-cooling_rate)
        return temperature

    current_solution = rng.uniform(lb, ub, size=dim)
    best_solution = current_solution.copy()
    best_fitness = func(current_solution)

    for i in range(budget):
        candidate = generate_candidate(current_solution)
        new_fitness = func(candidate)
        temperature = adaptive_cooling_schedule(i + 1)
        
        if np.random.uniform() < 0.05:
            step_size *= (np.exp(-temperature))
            
        current_solution, best_solution = evaluate_and_update(
            current_solution,
            func(current_solution),
            candidate,
            new_fitness
        )

    return best_solution
