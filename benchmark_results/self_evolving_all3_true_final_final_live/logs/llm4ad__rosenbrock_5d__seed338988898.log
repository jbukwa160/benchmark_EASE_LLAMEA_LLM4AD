def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        x = np.clip(x, lb, ub)
        return x

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_new = x_best + rng.normal(size=dim) * 0.1
        x_new = clip(x_new)
        f_new = func(x_new)

        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
