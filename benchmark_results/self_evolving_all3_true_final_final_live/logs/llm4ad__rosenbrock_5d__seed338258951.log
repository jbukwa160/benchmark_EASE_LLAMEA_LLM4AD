def algorithm(func, dim, lb, ub, budget, rng):
    x = 5.0 * np.ones(dim)
    c = 1e-3
    alpha = 10.0 / dim**2
    gamma = 0.602 / (dim + 3)**2
    delta = 1e-6
    kmax = int(budget / dim)

    for k in range(kmax):
        s = rng.normal(size=dim)
        f_x_plus_s = func(x + c * s)
        f_x_minus_s = func(x - c * s)
        g = (f_x_plus_s - f_x_minus_s) / (2 * c)
        
        x += gamma * np.sign(g) * delta
        x = np.clip(x, lb, ub)

    return x
