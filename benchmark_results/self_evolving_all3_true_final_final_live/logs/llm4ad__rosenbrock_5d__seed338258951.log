                x[i] += rng.random() * np.sign(200*(x[i+1]-x[i]**2)*(x[i+1]-x[i]**2) - 2*(1-x[i]))
        if 1-x[dim-1]**2 > 0:
            x[dim-1] += rng.random() * np.sign(-2*(1-x[dim-1])) / (2*100)
        x = np.clip(x, lb, ub)
