def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def objective(x):
        return func(x)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = objective(clip(x_best))

    for _ in range(budget):
        trial_x = clip(np.random.uniform(lb, ub, size=dim))
        trial_f = objective(trial_x)

        if rng.rand() < 0.1: # 10% chance of crossover
            child_x = x_best + rng.uniform(-1, 1, size=dim) * (trial_x - x_best)
        else:
            child_x = trial_x

        f_child = objective(clip(child_x))

        if f_child < f_best:
            x_best = child_x
            f_best = f_child

    return clip(x_best)
