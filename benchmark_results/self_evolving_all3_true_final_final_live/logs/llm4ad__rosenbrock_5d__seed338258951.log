def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    population_size = int(budget ** 0.5)
    pop = rng.uniform(lb, ub, (population_size, dim))
    best_x = pop[np.argmin([evaluate(x) for x in pop])]

    iteration = 0
    while iteration < budget:
        iteration += 1

        # Differential Evolution (DE) phase
        de_pop = np.copy(pop)
        for i in range(population_size):
            trial = de_pop[i] + rng.uniform(-1, 1, dim) * (de_pop[np.random.randint(0, population_size),
                                                                  np.random.randint(0, dim)] - de_pop[
                np.random.randint(0, population_size), np.random.randint(0, dim)])
            trial = clip(trial)
            if evaluate(trial) < evaluate(de_pop[i]):
                de_pop[i] = trial

        # Simulated Annealing (SA) phase
        sa_temp = 1.0
        sa_prob = 0.01
        for _ in range(int(population_size * 0.5)):
            i, j = np.random.randint(0, population_size, 2)
            trial = de_pop[i] + rng.uniform(-sa_temp, sa_temp, dim) * (de_pop[j] - de_pop[i])
            trial = clip(trial)
            if evaluate(trial) < evaluate(de_pop[i]):
                de_pop[i] = trial
            else:
                if np.random.rand() > sa_prob:
                    de_pop[i] = trial

        pop = de_pop.copy()
        best_x = pop[np.argmin([evaluate(x) for x in pop])]

    return best_x
