def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def cauchy_mutate(x, a):
        mu = 1 / (a * rng.uniform(0, 1))
        return x + mu * rng.normal(0, 1)

    population_size = int(budget ** 0.5)
    population = np.random.uniform(lb, ub, (population_size, dim))

    for _ in range(population_size):
        i1, i2, i3 = rng.choice(population_size, 3, replace=False)
        offspring = population[i1] + 0.8 * (population[i2] - population[i3])
        offspring = clip(offspring)

    for _ in range(budget - population_size):
        for i in range(population_size):
            mutated_offspring = cauchy_mutate(population[i], rng.uniform(1e-4, 1))
            mutated_offspring = clip(mutated_offspring)
            if func(mutated_offspring) < func(population[i]):
                population[i] = mutated_offspring

    return np.array([min(population, key=func)])
