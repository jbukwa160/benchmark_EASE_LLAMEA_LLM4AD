def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidates(population, best):
        for i in range(len(population)):
            mutation = np.zeros(dim)
            for j in range(dim):
                r1, r2, r3 = np.random.choice(len(population), 3, replace=False)
                if rng.random() < 0.5:
                    mutation[j] += (population[r1][j] - best[j]) * 0.1
                else:
                    mutation[j] -= (best[j] - population[r2][j]) * 0.1
            crossover = np.zeros(dim)
            for j in range(dim):
                if rng.random() < 0.5:
                    crossover[j] = clip(best[j] + mutation[j])
                else:
                    crossover[j] = population[r3][j]
            candidate = clip(crossover + (ub - lb) * rng.uniform(-1, 1))
            yield candidate

    def evaluate(population):
        return [func(x) for x in population]

    best_solution = np.random.uniform(lb, ub, dim)
    population = [best_solution] * len(best_solution)

    for _ in range(budget):
        candidates = list(generate_candidates(population, best_solution))
        scores = evaluate(candidates + population)
        indices = np.argsort(scores)[:len(population)]
        population = [candidates[i] if i < len(candidates) else population[i] for i in indices]
        best_solution = min(population, key=func)

    return best_solution
