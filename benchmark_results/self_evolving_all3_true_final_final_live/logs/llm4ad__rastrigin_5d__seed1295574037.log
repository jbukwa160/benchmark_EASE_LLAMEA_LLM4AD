def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def polynomial_crossover(u, v, w):
        alpha = 0.5 + 0.3 * rng.random()
        z1 = u + alpha * (v - u)
        z2 = v + alpha * (u - v)
        return clip(z1), clip(z2)

    def mutation(x, mu):
        if rng.random() < mu:
            i = rng.randint(0, dim)
            x[i] += 0.1 * rng.randn()
            x = clip(x)
        return x

    best_x = np.zeros(dim)
    for _ in range(budget):
        population = np.array([mutation(best_x.copy(), 0.9) for _ in range(10)])
        population = np.clip(population, lb, ub)

        f_values = np.array([func(x) for x in population])
        idx_best = np.argmin(f_values)
        if f_values[idx_best] < func(best_x):
            best_x = population[idx_best]

    return best_x
