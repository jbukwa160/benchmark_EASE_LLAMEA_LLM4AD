def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def mutate(x1, x2, f):
        delta = 0.5 * (x1 - x2)
        c1 = rng.uniform(-1, 1)
        c2 = rng.uniform(-1, 1)
        return x1 + c1 * delta + c2 * np.sqrt(np.abs(f(x1) - f(x2)))

    def select(x1, x2, x3):
        if func(x1) < func(x2) and func(x1) < func(x3):
            return x1
        elif func(x2) < func(x1) and func(x2) < func(x3):
            return x2
        else:
            return x3

    pop = np.random.uniform(lb, ub, (budget, dim))
    for _ in range(budget - 1):
        new_pop = []
        for i in range(budget):
            x1 = clip(pop[i])
            idx = rng.choice([j for j in range(budget) if j != i], 2)
            x2 = clip(pop[idx[0]])
            x3 = clip(pop[idx[1]])
            mu = mutate(x1, x2, func)
            new_pop.append(mu)
        pop = np.array(new_pop)

    best_x = select(*pop)
    return best_x
