def algorithm(func, dim, lb, ub, budget, rng):
    population_size = int(np.sqrt(budget))
    pop = rng.uniform(lb, ub, size=(population_size, dim))
    for _ in range(budget - 1):
        fitness = func(pop)
        best_idx = np.argmax(fitness)
        best = pop[best_idx]
        new_pop = pop.copy()
        for i in range(population_size):
            if i == best_idx:
                continue
            candidate = new_pop[i] + rng.normal(size=dim, loc=0, scale=0.5) * (ub - lb)
            candidate = np.clip(candidate, lb, ub)
            new_pop[i] = candidate
        pop = new_pop
    best_idx = np.argmax(func(pop))
    return pop[best_idx]
