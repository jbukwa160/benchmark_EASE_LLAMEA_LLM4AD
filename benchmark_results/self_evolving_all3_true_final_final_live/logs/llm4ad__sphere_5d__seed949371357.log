def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    current_solution = rng.uniform(lb, ub, size=dim)
    current_fitness = func(current_solution)

    temperature = 1.0
    cooling_rate = 0.99

    for _ in range(budget):
        candidate_solution = clip_candidate(current_solution + rng.normal(size=dim) * 0.5)
        candidate_fitness = func(candidate_solution)

        delta = candidate_fitness - current_fitness

        if delta < 0:
            current_solution = candidate_solution
            current_fitness = candidate_fitness
        else:
            probability = np.exp(-delta / temperature)
            if rng.random() < probability:
                current_solution = candidate_solution
                current_fitness = candidate_fitness

        temperature *= cooling_rate

    return clip_candidate(current_solution)
