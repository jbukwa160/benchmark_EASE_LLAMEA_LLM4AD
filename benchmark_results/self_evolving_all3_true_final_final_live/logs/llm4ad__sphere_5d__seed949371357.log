def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def generate_population(pop_size, dim, lb, ub, rng):
        population = np.zeros((pop_size, dim))
        for i in range(pop_size):
            population[i] = lb + (ub - lb) * rng.rand(dim)
        return population

    def fitness(x, func):
        return func(x)

    def genetic_search(population, pop_size, budget, rng, lb, ub):
        for _ in range(budget):
            # Selection
            fitness_values = np.array([fitness(individual, func) for individual in population])
            parents = np.argsort(fitness_values)[:int(0.2 * pop_size)]
            
            # Crossover
            children = []
            for i in range(int(0.8 * pop_size)):
                parent1 = population[parents[i]]
                parent2 = population[parents[np.random.choice(len(parents), 1)[0]]]
                child = (parent1 + parent2) / 2
                children.append(child)
            
            # Mutation
            for i in range(int(0.8 * pop_size)):
                if rng.rand() < 0.01:
                    index = np.random.randint(dim)
                    child = children[i].copy()
                    child[index] += (ub - lb) * (rng.rand() - 0.5)
                    children[i] = clip(child, lb, ub)
            
            # Replace
            population[:int(0.8 * pop_size)] = children
        
        return np.array([fitness(individual, func) for individual in population])

    def local_search(population, pop_size, budget, rng, lb, ub):
        for i in range(budget):
            # Select the best candidate
            best_individual = population[np.argmin(np.array([fitness(individual, func) for individual in population]))]
            
            # Perform local search
            if rng.rand() < 0.1:
                index = np.random.randint(dim)
                step_size = (ub - lb) * 0.01
                current_individual = best_individual.copy()
                current_fitness = fitness(current_individual, func)
                
                while True:
                    next_individual = clip(best_individual + (lb - ub) * rng.choice([-1, 1]) * np.eye(dim)[index], lb, ub)
                    next_fitness = fitness(next_individual, func)
                    
                    if next_fitness < current_fitness or rng.rand() < 0.9:
                        best_individual = next_individual
                        current_individual = next_individual
                        current_fitness = next_fitness
                        
                    else:
                        break
        
        return np.array([fitness(individual, func) for individual in population])

    population = generate_population(100, dim, lb, ub, rng)
    genetic_search(population, 100, int(budget / 2), rng, lb, ub)
    local_search(population, 100, int(budget / 2), rng, lb, ub)

    return np.argmin(np.array([fitness(individual, func) for individual in population]))
