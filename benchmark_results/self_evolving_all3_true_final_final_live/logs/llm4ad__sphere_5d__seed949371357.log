def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        e = rng.uniform(-1.0, 1.0, size=dim)
        g = np.zeros(dim)
        for i in range(dim):
            p = x + 0.01 * e[i] * g
            p[i] += 5e-6 * rng.gauss(0, 1) # perturbation
            p[i] = max(lb, min(p[i], ub)) # clip
            f = func(p)
            if f < best_f:
                x = p.copy()
                best_x = p.copy()
                best_f = f

    return best_x
