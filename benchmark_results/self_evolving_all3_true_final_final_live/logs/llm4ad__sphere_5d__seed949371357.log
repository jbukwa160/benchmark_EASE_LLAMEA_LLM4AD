def algorithm(func, dim, lb, ub, budget, rng):
    best = None
    for _ in range(budget):
        x = np.clip(rng.uniform(lb, ub, size=dim), lb, ub)
        fx = func(x)
        if best is None or fx < func(best):
            best = x
        sigma = (ub - lb) / 2.0
        for _ in range(10):
            dx = rng.normal(loc=0.0, scale=sigma, size=dim)
            x_new = np.clip(x + dx, lb, ub)
            fx_new = func(x_new)
            if fx_new < fx:
                x = x_new
                fx = fx_new
    return best
