def algorithm(func, dim, lb, ub, budget, rng):
    def is_feasible(x):
        return np.all(lb <= x) and np.all(x <= ub)

    x = rng.uniform(-5, 5, size=dim)
    T = 1000
    alpha = 0.99

    for _ in range(budget):
        if not is_feasible(x):
            continue

        f_x = func(x)
        new_x = x + rng.normal(size=dim) * 0.01

        if not is_feasible(new_x):
            continue

        f_new_x = func(new_x)

        if f_new_x < f_x:
            x = new_x
        elif np.random.rand() < np.exp(-(f_new_x - f_x) / T):
            x = new_x

        T *= alpha

    return x
