def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    D = dim
    N = int(budget)
    pop_size = 50
    F = 1.0
    CR = 0.9
    scale_factor = 100.0
    T = 500.0

    x = rng.uniform(lb, ub, (pop_size, D))
    y = np.zeros((N, D))
    f = np.zeros(N)

    for i in range(1, N):
        obj = []
        for j in range(pop_size):
            z = x[j] + scale_factor * F * (x[j] - x[(j-1)%pop_size])
            mutation = rng.uniform(lb, ub, D)
            z = z + mutation
            if rng.rand() < CR or np.all(z == x[j]):
                z = np.clip(z, lb, ub)
                obj.append((objective(z), z))
            else:
                obj.append((-np.inf, x[j]))
        obj.sort(key=lambda x: x[0])
        f[i] = obj[-1][0]
        y[i] = obj[-1][1]

        if i % 10 == 0:
            scale_factor *= np.exp(-i / T)

    return y[N-1]
