def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_neighbor(x):
        sigma = 0.5
        noise = rng.normal(size=x.shape) * sigma
        return x + noise

    def evaluate(x):
        return func(x)

    x = rng.uniform(lb, ub, size=dim)
    T = 1000
    t = 0
    best_x = x.copy()
    best_f = evaluate(x)

    while t < budget:
        new_x = generate_neighbor(x)
        new_x = clip(new_x)
        new_f = evaluate(new_x)
        
        if new_f <= best_f:
            x = new_x
            best_x = new_x
            best_f = new_f
        else:
            delta = new_f - best_f
            p = np.exp(-delta / T)
            r = rng.uniform()
            if r < p:
                x = new_x
                best_x = new_x
                best_f = new_f
        
        T *= 0.99
        t += 1

    return best_x
