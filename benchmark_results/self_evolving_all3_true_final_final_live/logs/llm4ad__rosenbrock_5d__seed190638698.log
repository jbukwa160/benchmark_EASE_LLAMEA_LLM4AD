def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        x = np.clip(x, lb, ub)
        return func(x)

    def cma_es(pop_size=10, sigma=0.1, iter_max=budget):
        # Initialize CMA-ES
        weights = 1 / (pop_size * np.arange(1, pop_size + 1))
        mu = rng.rand(dim) * (ub - lb) + lb

        for _ in range(iter_max):
            # Sample candidates from multivariate normal distribution
            z = rng.randn(pop_size, dim)
            x = mu + sigma * np.sqrt(np.diag(weights))[:, None] @ z.T / np.sqrt(np.sum(weights))

            # Evaluate objective and store best candidate
            f_x = [objective(x_i) for x_i in x]
            idx_best = np.argmin(f_x)

            if f_x[idx_best] < func(mu):
                mu = x[idx_best]

        return mu

    def simulated_annealing(T=1000, iter_max=budget):
        x = lb + rng.rand(dim) * (ub - lb)
        T_schedule = np.linspace(T, 1e-6, budget)

        for i in range(budget):
            # Simulated Annealing
            f_x = objective(x)
            T_current = T_schedule[i]

            if f_x < func(x):
                x = x

            else:
                probability = np.exp(-(f_x - func(x)) / T_current)
                r = rng.uniform(0, 1)

                if r < probability:
                    x = x
                else:
                    x = lb + rng.rand(dim) * (ub - lb)

        return x

    # Initialize variables
    mu_cma_es = cma_es()
    mu_sa = simulated_annealing()

    # Combine results from both methods
    mu_final = 0.5 * mu_cma_es + 0.5 * mu_sa
    f_mu_final = objective(mu_final)

    return np.clip(mu_final, lb, ub)
