def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def f(x):
        return func(x)

    x = rng.uniform(lb, ub, size=dim)
    pop_size = int(budget ** 0.5)
    best_x = clip(x)
    best_f = f(best_x)

    for i in range(1, budget):
        v1 = rng.uniform(lb, ub, size=dim)
        v2 = rng.uniform(lb, ub, size=dim)
        v3 = rng.uniform(lb, ub, size=dim)
        x_new = clip(v1 + 0.5 * (v2 - v3))
        f_new = f(x_new)

        if f_new < best_f:
            best_x = x_new
            best_f = f_new

        candidates = np.array([clip(best_x + rng.uniform(-1, 1, size=dim)) for _ in range(pop_size)])
        f_candidates = [f(c) for c in candidates]

        idx = np.argsort(f_candidates)[:pop_size]
        candidates = candidates[idx]
        f_candidates = [f_c for f_c in sorted(f_candidates)]

        for j in range(pop_size):
            v_new = clip(best_x + rng.uniform(-1, 1, size=dim))
            if f(v_new) < f_candidates[j]:
                best_x = v_new
                best_f = f(best_x)

    return best_x
