def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    ngen = int(budget / pop_size)
    F = 0.5
    CR = 0.9
    D = dim
    G = np.zeros((pop_size, D))
    
    for i in range(pop_size):
        G[i] = lb + (ub - lb) * rng.rand(D)
    
    for gen in range(ngen):
        Y = np.copy(G)
        
        for i in range(pop_size):
            r1, r2, r3 = rng.choice(range(pop_size), 3, replace=False)
            
            while r1 == i:
                r1 = rng.choice(range(pop_size), replace=False)
                
            while r2 == i or r2 == r1:
                r2 = rng.choice(range(pop_size), replace=False)
                
            while r3 == i or r3 == r1 or r3 == r2:
                r3 = rng.choice(range(pop_size), replace=False)
            
            X = G[r1] + F * (G[r2] - G[r3])
            
            for j in range(D):
                u = rng.rand()
                
                if u < CR or abs(X[j]) > 0.01:
                    Y[i, j] = X[j]
                else:
                    Y[i, j] = G[i, j]
        
        for i in range(pop_size):
            fitness_i = func(Y[i])
            
            if fitness_i < func(G[i]):
                G[i] = Y[i]
    
    best_idx = np.argmin([func(g) for g in G])
    
    return G[best_idx]
