def algorithm(func, dim, lb, ub, budget, rng):
    n_dims = dim
    n_iter = int(budget)
    
    # Initialize the incumbent and its function value
    incumbent = np.zeros(n_dims)
    f_incumbent = float('inf')
    
    # Define the kernel parameters
    kappa = 1e-6
    sigma_sq = 1.0
    
    # Define the hyperparameters for the GP model
    theta = np.array([1.0, 1e-3])
    
    for iter in range(n_iter):
        # Sample the next candidate using the EI acquisition function
        mean, cov = sample_gp(incumbent, kappa, sigma_sq, rng)
        
        # Compute the expected improvement (EI) at the sampled point
        ei = compute_ei(mean, cov, incumbent, f_incumbent, theta)
        
        # Find the next candidate that maximizes EI
        next_candidate = np.argmax(ei + 1e-8)
        new_point = sample_from_gp(mean[next_candidate], cov[next_candidate], rng)
        
        # Clip the new point to the bounds
        new_point = np.clip(new_point, lb, ub)
        
        # Evaluate the objective function at the new point
        f_new = func(new_point)
        
        # Update the incumbent if necessary
        if f_new < f_incumbent:
            incumbent = new_point
            f_incumbent = f_new
        
    return incumbent
