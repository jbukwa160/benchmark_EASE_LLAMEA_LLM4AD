def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 1000
    alpha = 0.99
    best_x = x.copy()
    
    for _ in range(budget):
        new_x = x.copy()
        
        for i in range(dim):
            delta = rng.normal(0, 1) / np.sqrt(_ + 1)
            new_x[i] += delta * (ub - lb)
            
            if func(new_x[:i+1]) < func(best_x[:i+1]):
                best_x[:i+1] = new_x[:i+1].copy()
            else:
                p = np.exp((func(x[:i+1]) - func(best_x[:i+1])) / T)
                if rng.uniform(0, 1) < p:
                    best_x[:i+1] = new_x[:i+1].copy()
        
        x = np.clip(best_x, lb, ub)
        T *= alpha
    
    return best_x
