def algorithm(func, dim, lb, ub, budget, rng):
    def sample_random(bounds):
        return rng.uniform(bounds[0], bounds[1], size=dim)

    def clip(candidate, bounds):
        return np.clip(candidate, bounds[0], bounds[1])

    def evaluate(x, func):
        return func(np.array([x]))

    best_x = None
    best_fval = float('inf')

    population_size = 100
    num_generations = budget // population_size

    for _ in range(num_generations):
        candidates = np.vstack([sample_random((lb, ub)) for _ in range(population_size)])
        candidates = clip(candidates, (lb, ub))

        fvals = evaluate(candidates[:, 0], func)

        best_idx = np.argmin(fvals)
        if fvals[best_idx] < best_fval:
            best_x = candidates[best_idx]
            best_fval = fvals[best_idx]

        parents = np.zeros((population_size, dim))
        for i in range(population_size):
            parent_idx1 = rng.choice(population_size, p=np.exp(-fvals))
            parent_idx2 = rng.choice(population_size, p=np.exp(-fvals))
            idxs = np.random.choice(dim, size=dim, replace=False)
            parents[i] = (candidates[parent_idx1, idxs] + candidates[parent_idx2, idxs]) / 2

        fvals_parents = evaluate(parents[:, 0], func)

        for i in range(population_size):
            if fvals_parents[i] < best_fval:
                best_x = parents[i]
                best_fval = fvals_parents[i]

    return np.array(best_x)
