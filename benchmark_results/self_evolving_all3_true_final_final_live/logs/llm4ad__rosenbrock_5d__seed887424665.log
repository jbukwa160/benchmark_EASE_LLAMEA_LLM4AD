def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def differential_evolution():
        x0 = rng.uniform(lb, ub, (dim,))
        for _ in range(budget // 2):
            X = clip(rng.normal(loc=x0, scale=1.5, size=(dim, budget // 4)))
            Y = func(X.T)
            indices = np.argsort(Y)[:budget // 4]
            x0 = X[:, indices].mean(axis=1)

    def local_search():
        for _ in range(budget // 10):
            epsilon = rng.uniform(1e-8, 5.0)
            x = clip(x0 + epsilon * rng.normal(loc=x0, scale=1.0))
            if func(x) < func(x0):
                x0 = x

    differential_evolution()
    local_search()

    return x0
