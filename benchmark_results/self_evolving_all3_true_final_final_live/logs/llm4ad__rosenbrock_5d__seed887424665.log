def algorithm(func, dim, lb, ub, budget, rng):
    def sample_candidate(dim, lb, ub):
        return rng.uniform(lb, ub, size=dim)

    def gaussian_process_update(x_best, x_new, y_new, gp, lb, ub, dim):
        k = len(gp)
        for i in range(k):
            gp[i].update(x_new[i], y_new[i])
        return gp

    def bayesian_optimization(gp, bounds, budget, rng):
        X = []
        Y = []
        x_best = None
        y_best = np.inf
        for _ in range(budget):
            mu, sigma = [], []
            for i in range(len(bounds)):
                mean, std_dev = gp[i].predict(np.array([0.5]))
                mu.append(mean)
                sigma.append(std_dev)
            x_new = [bounds[i][0] + rng.uniform(0, 1) * (bounds[i][1] - bounds[i][0]) for i in range(dim)]
            y_new = func(x_new)
            X.append(x_new)
            Y.append(y_new)
            if y_new < y_best:
                x_best = x_new
                y_best = y_new
        return X, Y, x_best

    def simulated_annealing(gp, bounds, budget, rng):
        T = 1000
        cooling_rate = 0.99
        x_best_sa = None
        y_best_sa = np.inf
        for _ in range(budget):
            x_new = sample_candidate(dim, lb, ub)
            if func(x_new) < y_best_sa:
                x_best_sa = x_new
                y_best_sa = func(x_new)
            else:
                delta = func(x_new) - y_best_sa
                prob_accept = np.exp(-delta / T)
                if rng.uniform(0, 1) < prob_accept:
                    x_best_sa = x_new
                    y_best_sa = func(x_new)
            T *= cooling_rate
        return x_best_sa

    bounds = [(lb, ub)] * dim
    gp = [None] * dim
    for i in range(dim):
        gp[i] = rng.normal(0, 1, size=10)

    X_gp, Y_gp, x_best_gp = bayesian_optimization(gp, bounds, budget//2, rng)
    x_best_sa = simulated_annealing(gp, bounds, budget//2, rng)

    if func(x_best_gp) < func(x_best_sa):
        return x_best_gp
    else:
        return x_best_sa
