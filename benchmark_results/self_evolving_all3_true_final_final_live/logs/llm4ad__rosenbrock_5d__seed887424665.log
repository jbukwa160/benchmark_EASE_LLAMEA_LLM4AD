def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    x = rng.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)
    step_size = 1.0
    for _ in range(budget - 1):
        candidates = np.zeros((1000, dim))
        for i in range(dim):
            candidates[:, i] = rng.normal(loc=best_x[0, i], scale=step_size)
        candidates = clip(candidates)
        new_f = func(candidates)
        accept = np.random.uniform(0, 1, size=len(new_f)) < (new_f - best_f) / (func(candidates + 0.01) - func(candidates))
        x_new = candidates[accept]
        if len(x_new):
            step_size *= 1.5
            new_best_x = clip(np.mean(x_new, axis=0))
            new_best_f = func(new_best_x)
            if new_best_f < best_f:
                best_x = new_best_x
                best_f = new_best_f
        else:
            step_size /= 2.0
    return best_x
