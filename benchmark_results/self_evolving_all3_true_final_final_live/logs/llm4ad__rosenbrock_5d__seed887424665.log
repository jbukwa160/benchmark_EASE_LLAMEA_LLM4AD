def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    pop_size = int(1e3)
    population = rng.uniform(lb, ub, (pop_size, dim))
    velocity = 0.5 * rng.uniform(-1, 1, (pop_size, dim))

    for _ in range(budget - 1):
        fitness = np.array([evaluate(x) for x in population])
        indices = np.argsort(fitness)[:int(0.2 * pop_size)]
        new_population = population[indices]
        velocity = 0.5 * rng.uniform(-1, 1, (pop_size, dim))

        for i in range(pop_size):
            if i not in indices:
                r1, r2, r3 = np.random.choice(indices, size=3, replace=False)
                v_i = velocity[i] + rng.uniform(-1, 1) * (
                    population[r1] - population[r2]
                ) + 0.5 * (population[r3] - population[r1])
                new_population[i] += v_i
                if np.any(new_population[i] < lb) or np.any(new_population[i] > ub):
                    new_population[i] = np.clip(
                        new_population[i], lb, ub
                    )

        population = new_population.copy()
        velocity = 0.5 * rng.uniform(-1, 1, (pop_size, dim))

    best_individual = population[np.argmin(fitness)]
    return best_individual
