def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    best_solution = None
    best_fitness = float('inf')
    num_restarts = 0
    restart_interval = int(budget / (10 * dim))
    
    while budget > 0:
        # Generate an initial random solution
        solution = rng.uniform(lb, ub, size=dim)
        
        # Evolve the population using a Gaussian-based update rule
        for _ in range(int(budget / (2 * dim))):
            new_solution = solution + rng.normal(0, 1e-3, size=dim)
            new_solution = clip(new_solution)
            
            if func(new_solution) < func(solution):
                solution = new_solution
        
        # Update the best known solution
        fitness = func(solution)
        
        if fitness < best_fitness:
            best_fitness = fitness
            best_solution = solution
        
        budget -= 2 * dim
        
        # Restart the optimization process with a random solution
        if num_restarts >= restart_interval and rng.rand() < 0.1:
            solution = rng.uniform(lb, ub, size=dim)
            num_restarts = 0
        else:
            num_restarts += 1
    
    return best_solution
