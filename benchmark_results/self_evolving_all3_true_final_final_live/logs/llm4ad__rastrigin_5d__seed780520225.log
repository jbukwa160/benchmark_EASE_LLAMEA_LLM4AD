def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    F = 0.5
    CR = 0.9
    
    x_best_global = np.random.uniform(lb, ub, size=(pop_size, dim))
    
    for _ in range(budget):
        f_x = func(x_best_global)
        
        y = np.copy(x_best_global)
        
        for i in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size, size=3), rng.randint(0, pop_size, size=3)
            while r1 == i or r2 == i or r3 == i:
                r1, r2, r3 = rng.randint(0, pop_size, size=3)
            
            u = np.copy(x_best_global[i])
            v = x_best_global[r1] + F * (x_best_global[r2] - x_best_global[r3])
            y[i] = u + CR * (v - u)
        
        f_y = func(y)
        
        for i in range(pop_size):
            if f_y[i] < f_x[i]:
                x_best_global[i] = np.clip(y[i], lb, ub)
    
    return np.min(x_best_global, axis=0)
