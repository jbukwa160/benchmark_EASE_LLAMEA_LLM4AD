def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    F = 0.8
    CR = 0.5
    x_best = None
    f_best = float('inf')

    for _ in range(budget):
        # Initialize population
        x = np.zeros((pop_size, dim))
        for i in range(pop_size):
            x[i] = lb + (ub - lb) * rng.rand(dim)

        # Evaluate population
        f = func(x)
        indices = np.argsort(f)
        f_sorted = f[indices]
        x_sorted = x[indices]

        # Update best solution
        if f_sorted[0] < f_best:
            f_best = f_sorted[0]
            x_best = x_sorted[0]

        # Differential Evolution
        y = x_sorted.copy()
        for i in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size, 3)
            while r1 == i or r2 == i or r3 == i:
                r1, r2, r3 = rng.randint(0, pop_size, 3)

            y[i] = x_sorted[r1] + F * (x_sorted[r2] - x_sorted[r3])

        # Mutation and crossover
        for i in range(pop_size):
            if rng.rand() < CR:
                u = y[i]
                for j in range(dim):
                    u[j] += rng.uniform(-0.5, 0.5) * (ub - lb)
                u = np.clip(u, lb, ub)

                # Selection
                f_new = func(np.array([u]))
                if f_new < f_sorted[i]:
                    x_sorted[i] = u

    return x_best
