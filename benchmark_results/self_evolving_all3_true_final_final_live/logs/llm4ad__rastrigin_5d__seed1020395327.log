def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    sigma = 1.0
    mut_rule = "rand/1/bin"
    
    x = (ub - lb) * rng.rand(pop_size, dim) + lb
    
    for i in range(budget):
        fit = func(x)
        
        idx = np.argmin(fit)
        best_x = x[idx]
        
        if i % 10 == 0:
            sigma *= 1.01
        
        mutant = np.zeros((pop_size, dim))
        
        for j in range(pop_size):
            if mut_rule == "rand/1/bin":
                mutant[j] = best_x + sigma * rng.randn(dim)
        
        for k in range(pop_size):
            trial = mutant[k]
            
            # clip to bounds
            trial = np.clip(trial, lb, ub)
            
            fit_trial = func(trial)
            
            if fit_trial < fit[idx]:
                x[k] = trial
                fit[k] = fit_trial
        
        idx = np.argmin(fit)
        best_x = x[idx]
    
    return best_x
