def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    N = 50 # Population size
    F = 1.0 # Scaling factor
    CR = 0.9 # Crossover rate
    best = float('inf')
    x_best = None
    
    for i in range(budget):
        X = np.random.uniform(lb, ub, (N, D))
        
        for j in range(N):
            y = X[j]
            
            # Mutation
            r1 = rng.randint(0, N)
            r2 = rng.randint(0, N)
            r3 = rng.randint(0, N)
            while r2 == r1 or r2 == r3:
                r2 = rng.randint(0, N)
            while r3 == r1 or r3 == r2:
                r3 = rng.randint(0, N)
            
            a = X[r1] + F * (X[r2] - X[r3])
            
            # Crossover
            b = np.where(rng.rand(D) < CR, a, y)
            
            # Selection
            f_b = func(b)
            if f_b < func(y):
                X[j] = b
                
            # Update best solution
            f_x_best = func(X[np.argmin([func(x) for x in X])])
            if f_x_best < best:
                best = f_x_best
                x_best = X[np.argmin([func(x) for x in X])]
                
    return np.clip(x_best, lb, ub)
