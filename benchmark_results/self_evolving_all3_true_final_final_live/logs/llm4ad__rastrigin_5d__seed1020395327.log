def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    x_best = np.array([0.5 * (lb + ub) + 0.5 * (ub - lb) * rng.rand(n)])
    f_best = func(x_best)

    for i in range(budget):
        trial = np.zeros_like(x_best)
        p1, p2, p3 = x_best[rng.permutation(n)], x_best[rng.permutation(n)], x_best[rng.permutation(n)]

        for j in range(n):
            trial[j] = p1[j] + rng.uniform(-1, 1) * (p2[j] - p3[j])

        trial = np.clip(trial, lb, ub)
        f_trial = func(trial)

        if f_trial < f_best:
            x_best, f_best = trial, f_trial

    return x_best
