def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def fitness(x):
        return func(x)

    n = 1 + int(np.log(budget))
    mu = 0.5 * (ub - lb)
    sigma = (ub - lb) / np.sqrt(n)
    mean = rng.uniform(lb, ub, size=dim)
    pop_size = budget
    counter = 0

    best_x = None
    best_f = float('inf')

    for _ in range(budget):
        x = clip(mean + sigma * rng.normal(size=(pop_size, dim)))
        f = np.array([fitness(x_i) for x_i in x])

        argmin_idx = np.argmin(f)
        new_mean = mean + (x[argmin_idx] - mean) / pop_size

        if f[argmin_idx] < best_f:
            counter = 0
            best_x = x[argmin_idx]
            best_f = f[argmin_idx]

        else:
            counter += 1

        if counter > n and np.linalg.norm(mean - new_mean) < sigma * 0.01:
            mean = new_mean
            counter = 0

        mean = 0.9 * mean + 0.1 * new_mean

    return best_x
