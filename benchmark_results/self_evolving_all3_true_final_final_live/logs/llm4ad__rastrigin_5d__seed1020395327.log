def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    best_f = float('inf')
    s = max(ub - lb, 1e-2)  # initial step size
    
    for _ in range(budget):
        y = x + s * (ub - lb) * rng.rand(dim)
        y = np.clip(y, lb, ub)
        
        f = func(y)
        if f < best_f:
            best_x = y.copy()
            best_f = f
            
        if budget // 10 <= _ and s > 1e-3:  # reduce step size every 10% of budget
            s *= 0.9
        
    return best_x
