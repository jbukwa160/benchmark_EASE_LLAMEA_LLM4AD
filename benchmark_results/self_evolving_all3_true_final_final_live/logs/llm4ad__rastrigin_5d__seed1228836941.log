def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def generate_initial_population(dim, lb, ub, rng):
        return rng.uniform(lb, ub, (budget, dim))

    def evaluate_population(population, func):
        return np.array([func(individual) for individual in population])

    def differential_evolution(population, func, dim, lb, ub, budget, rng):
        mu = 0.5
        sigma = 1.0
        population_size = population.shape[0]
        while True:
            trial_population = np.copy(population)
            for i in range(population_size):
                idx_j = rng.choice(population_size, size=3, replace=False)
                j = idx_j[rng.uniform(0, 1) < mu]
                trial_individual = population[i] + sigma * (population[j[0]] - population[j[1]] + population[j[2]])
                trial_individual = clip(trial_individual, lb, ub)
                trial_population[i] = trial_individual
            f_value = evaluate_population(trial_population, func)
            idx_best = np.argmin(f_value)
            if f_value[idx_best] < population[idx_best]:
                population[idx_best] = trial_population[idx_best]
            yield population

    def polynomial_mutation(population, func, dim, lb, ub):
        for i in range(population.shape[0]):
            individual = population[i]
            for j in range(dim):
                if rng.uniform(0, 1) < 1 / (dim + 1):
                    mu = 2 * rng.uniform(lb[j], ub[j]) - lb[j] - ub[j]
                    trial_individual = individual + mu
                    trial_individual = clip(trial_individual, lb, ub)
                    population[i] = trial_individual
        yield population

    def run_algorithm(population, func, dim, lb, ub, budget):
        for _ in range(budget):
            population = differential_evolution(population, func, dim, lb, ub, budget, rng)
            population = polynomial_mutation(population, func, dim, lb, ub)
            yield population

    initial_population = generate_initial_population(dim, lb, ub, rng)
    best_individual = np.copy(initial_population[0])
    for population in run_algorithm(initial_population, func, dim, lb, ub, budget):
        idx_best = np.argmin(evaluate_population(population, func))
        if evaluate_population(population[idx_best], func) < evaluate_population(best_individual, func):
            best_individual = population[idx_best]
    return best_individual
