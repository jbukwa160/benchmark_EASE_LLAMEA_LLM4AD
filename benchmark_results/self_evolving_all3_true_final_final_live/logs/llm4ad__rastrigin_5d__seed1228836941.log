def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    F = 0.8
    CR = 0.9
    D = dim
    x = (ub - lb) * rng.rand(pop_size, D) + lb
    gbest = np.inf
    best_so_far_x = None

    for _ in range(budget):
        y = x.copy()
        for i in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size, 3)
            while r1 == i or r2 == i or r3 == i:
                r1, r2, r3 = rng.randint(0, pop_size, 3)

            u = x[r1]
            v = x[r2]
            w = x[r3]

            f1 = F * (u - x[i])
            f2 = F * (v - x[i])
            f3 = F * (w - x[i])

            y[i] += f1 + f2 + f3

        for i in range(pop_size):
            r = rng.rand(D)
            if rng.uniform(0, 1) < CR:
                for j in range(D):
                    if rng.uniform(0, 1) < r[j]:
                        y[i, j] = x[r1, j] + rng.uniform(-1, 1)

        f = func(y)
        for i in range(pop_size):
            if f[i] < gbest:
                gbest = f[i]
                best_so_far_x = y[i]

        x[:] = np.clip(y, lb, ub)

    return best_so_far_x
