def algorithm(func, dim, lb, ub, budget, rng):
    def generate_init_candidate(dim, lb, ub, rng):
        return lb + (ub - lb) * rng.uniform(size=dim)

    def generate_neighbour(candidate, sigma, rng):
        noise = rng.normal(size=candidate.shape)
        return candidate + sigma * noise

    def acceptance_probability(current_fitness, new_fitness, T):
        if current_fitness <= new_fitness:
            return 1
        else:
            return np.exp((new_fitness - current_fitness) / T)

    def simulated_annealing(candidate, func, lb, ub, budget, rng, init_temp=1000.0):
        current_candidate = candidate.copy()
        current_fitness = func(current_candidate)
        for _ in range(budget // 2):
            neighbour = generate_neighbour(current_candidate, 1.0, rng)
            neighbour_fitness = func(neighbour)
            if neighbour_fitness <= current_fitness:
                current_candidate = neighbour
                current_fitness = neighbour_fitness
            elif acceptance_probability(current_fitness, neighbour_fitness, init_temp) > rng.uniform():
                current_candidate = neighbour
                current_fitness = neighbour_fitness
        return current_candidate

    def differential_evolution(candidate, func, lb, ub, budget, rng):
        population_size = 10 * dim
        pop = np.vstack([generate_init_candidate(dim, lb, ub, rng) for _ in range(population_size)])
        fitnesses = np.array([func(x) for x in pop])
        for _ in range(budget // 2):
            differences = pop[:, np.newaxis] - pop
            u, indices = np.unique(differences, axis=1, return_inverse=True)
            mutant = (u * rng.uniform(size=u.shape[0])).sum(axis=1)[indices]
            trial = pop + 0.5 * (mutant - pop[np.newaxis])
            trial_fitnesses = func(trial)
            for i in range(population_size):
                if trial_fitnesses[i] < fitnesses[i]:
                    pop[i] = trial[i]
                    fitnesses[i] = trial_fitnesses[i]
        best_candidate = np.argmin(fitnesses)
        return pop[best_candidate]

    candidate = generate_init_candidate(dim, lb, ub, rng)
    candidate = simulated_annealing(candidate, func, lb, ub, budget // 2, rng)
    candidate = differential_evolution(candidate, func, lb, ub, budget - (budget // 2), rng)

    return np.clip(candidate, lb, ub)
