def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_population(n, lb, ub):
        return rng.uniform(lb, ub, size=(n, dim))

    def evaluate(x):
        return func(x) + 10 * dim

    def differential_evolution(population, f, bounds, budget):
        mutation_factor = 0.5
        crossover_probability = 0.1
        population_size = len(population)

        for _ in range(budget // population_size):
            targets = rng.choice(population_size, size=population_size, replace=False)
            candidates = np.array([clip(
                population[target] + mutation_factor * (np.random.choice(population_size) - target)
            ) for target in targets])

            mask = rng.rand(population_size) < crossover_probability
            population[mask] = clip(candidates[mask])
        return population

    def simplex_search(population):
        simplex_size = 10
        while True:
            distances = np.linalg.norm(population - population[0], axis=1)
            sorted_indices = np.argsort(distances)

            if distances[sorted_indices[-2]] > 0.01 * (ub - lb) ** dim:
                new_point = clip(
                    population[0] + rng.uniform(-1, 1, size=(dim,))
                )
                distances_new = np.linalg.norm(new_point - population, axis=1)
                if distances_new.min() < distances[sorted_indices[-2]]:
                    population[sorted_indices[-2]] = new_point
            else:
                return population

    initial_population = generate_population(100, lb, ub)
    best_individual = initial_population[np.argmin([evaluate(x) for x in initial_population])]

    for _ in range(budget // 10):
        population = differential_evolution(initial_population, evaluate, (lb, ub), budget // 10)
        new_best_individual = simplex_search(population)

        if evaluate(new_best_individual) < evaluate(best_individual):
            best_individual = new_best_individual

    return best_individual
