def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best = np.zeros(dim)
    best_func = float('inf')
    
    # DE initialization
    pop_size = 50
    population = rng.uniform(lb, ub, (pop_size, dim))
    for _ in range(budget // 10):
        diffs = rng.normal(size=(dim,))
        weights = rng.uniform(0.5, 1.0, size=pop_size)
        candidates = population + np.outer(population, weights[:, np.newaxis]) * diffs[np.newaxis, :]
        candidates = clip(candidates)
        
        # DE selection
        fit_candidates = func(candidates)
        indices = np.argsort(fit_candidates)[:pop_size]
        population = candidates[indices]
    
    # Simplex-based local search
    simplex_size = 10
    simplex = rng.uniform(lb, ub, (simplex_size, dim))
    for _ in range(budget - budget // 10):
        fit_simplex = func(simplex)
        indices = np.argsort(fit_simplex)[:2]
        best_indices = np.argsort(fit_simplex)[-1:]
        
        # Reflection
        reflection = simplex[best_indices] + 0.5 * (simplex[indices[1]] - simplex[best_indices])
        reflection = clip(reflection)
        
        fit_reflection = func(reflection)
        if fit_reflection < fit_simplex[best_indices]:
            simplex[best_indices] = reflection
        else:
            # Expansion
            expansion = simplex[best_indices] + 2 * (simplex[indices[1]] - simplex[best_indices])
            expansion = clip(expansion)
            
            fit_expansion = func(expansion)
            if fit_expansion < fit_reflection:
                simplex[best_indices] = expansion
    
    # Return the best solution found
    return simplex[-1]
