def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    best_score = float('inf')
    best_candidate = None
    population = np.random.uniform(lb, ub, (pop_size, dim))

    for _ in range(budget):
        scores = [func(candidate) for candidate in population]
        
        # Update the best score and candidate
        current_best_index = np.argmin(scores)
        if scores[current_best_index] < best_score:
            best_score = scores[current_best_index]
            best_candidate = population[current_best_index]

        # Differential evolution with adaptive mutation strategy
        new_population = []
        for i in range(pop_size):
            # Select three random candidates
            a, b, c = np.random.choice(pop_size, 3, replace=False)
            
            # Mutation
            mutant = population[a] + rng * (population[b] - population[c])
            
            # Clip to bounds
            mutant = np.clip(mutant, lb, ub)

            # Crossover
            trial = mutant + rng * (population[i] - mutant)

            # Clip to bounds
            trial = np.clip(trial, lb, ub)
            new_population.append(trial)

        population = np.array(new_population)

    return best_candidate
