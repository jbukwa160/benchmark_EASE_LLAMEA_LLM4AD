def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best = np.random.uniform(lb, ub, dim)
    curr_best = func(best)
    T = 100.0

    for _ in range(budget // 2):
        x1 = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
        x2 = np.array([np.random.uniform(lb, ub) for _ in range(dim)])

        v = clip(x1 + rng * (x2 - x1))
        new_fit = func(v)

        if new_fit < curr_best:
            curr_best = new_fit
            best = v

        T *= 0.99

    for _ in range(budget // 2):
        x = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
        new_fit = func(x)

        if new_fit < curr_best:
            curr_best = new_fit
            best = x

    return best
