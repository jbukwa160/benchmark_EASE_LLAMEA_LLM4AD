def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = 50
    best_solution = None
    best_func_value = float('inf')

    for _ in range(budget):
        population = np.random.uniform(lb, ub, (pop_size, dim))

        for i in range(pop_size):
            x1, x2, x3 = rng.choice(pop_size, 3, replace=False)
            mutant_individual = clip(population[x1] + 0.5 * (population[x2] - population[x3]))

            trial_individual = clip(mutant_individual + 0.2 * np.random.uniform(-1, 1, dim))
            trial_func_value = func(trial_individual)

            if trial_func_value < func(population[i]):
                population[i] = trial_individual

        best_solution = np.min(population, axis=0)
        best_func_value = func(best_solution)

    return best_solution
