def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def generate_initial_population(rng, n_pop, dim, lb, ub):
        initial_population = rng.uniform(lb, ub, (n_pop, dim))
        return initial_population

    def calculate_fitness(population, func):
        fitness = np.array([func(individual) for individual in population])
        return fitness

    def update_distribution(fitness, best_individual, population, mean, step_size):
        sigma = 0.1
        covar = np.cov(np.transpose(population))
        eigvals, eigvecs = np.linalg.eig(covar)
        inv_eigvecs = np.linalg.inv(eigvecs)
        new_mean = mean + (step_size * np.dot(eigvecs, np.diag(1 / eigvals)) * rng.normal(size=(dim,)))
        new_population = population + sigma * rng.normal(size=(n_pop, dim))
        return new_mean, new_population

    def restart_search(n_restart, initial_population, func):
        for _ in range(n_restart):
            best_individual = np.min(initial_population, axis=0)
            mean = np.mean(initial_population, axis=0)
            step_size = 1.0
            population = clip(initial_population + rng.normal(size=(n_pop, dim)), lb, ub)
            fitness = calculate_fitness(population, func)
            iterations_without_improvement = 0
            while iterations_without_improvement < budget:
                new_mean, new_population = update_distribution(fitness, best_individual, population, mean, step_size)
                new_population = clip(new_population, lb, ub)
                mean = new_mean
                population = new_population
                fitness = calculate_fitness(population, func)
                if np.min(fitness) < np.min(calculate_fitness(initial_population, func)):
                    iterations_without_improvement = 0
                else:
                    iterations_without_improvement += 1
                best_individual = np.argmin(fitness)
        return initial_population[best_individual]

    n_pop = 100
    initial_population = generate_initial_population(rng, n_pop, dim, lb, ub)
    best_individual = restart_search(n_restart=10, initial_population=initial_population, func=func)
    return clip(best_individual, lb, ub)
