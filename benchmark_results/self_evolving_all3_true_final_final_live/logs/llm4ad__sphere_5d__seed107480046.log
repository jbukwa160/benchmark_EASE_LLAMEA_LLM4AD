def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def mutate(population, sigma):
        mutants = population + (rng.uniform(-1, 1, size=dim) * sigma)
        return clip(mutants)

    def crossover(parent, mutant):
        indices = rng.randint(0, dim, size=int(dim/2))
        child = np.where(rng.uniform(size=dim) < 0.5, parent, mutant)
        child[indices] = parent[indices]
        return child

    population_size = int(budget / (func.__name__ == 'sphere'))
    population = rng.uniform(lb, ub, size=(population_size, dim))
    best_solution = np.zeros(dim)

    for _ in range(population_size):
        sigma = 1.0
        for _ in range(budget // population_size):
            mutants = mutate(population, sigma)
            new_population = [crossover(parent, mutant) for parent, mutant in zip(population, mutants)]
            population = np.array(new_population)

            best_solution[np.linalg.norm(population, axis=1).argmin()] = population[np.linalg.norm(population, axis=1).argmin()]
            solution_value = func(best_solution)
            if solution_value < func(best_solution):
                best_solution = np.copy(best_solution)

            sigma *= 0.9

        best_solution = clip(best_solution)
    return best_solution
