def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_y = func(x)

    for _ in range(budget):
        if rng.random() < 0.5:
            # Random sampling step
            new_x = rng.uniform(lb, ub, size=dim)
            y = func(new_x)
            if y < best_y:
                best_x = new_x.copy()
                best_y = y

        else:
            # Local search step
            noise = rng.normal(size=dim)
            s = rng.uniform(0.1, 5.0)  # adaptively adjust the step size
            new_x = best_x + noise * s
            new_x = np.clip(new_x, lb, ub)

            y = func(new_x)
            if y < best_y:
                best_x = new_x.copy()
                best_y = y

    return best_x
