def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = (np.random.uniform(lb, ub, size=dim) + rng.normal(0, 1e-4, size=dim)) / rng.uniform(0.5, 2.0)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = clip(best_x + rng.normal(0, 0.01, size=dim))
        f = func(y)
        
        if f < best_f:
            best_f = f
            best_x = y

    return best_x
