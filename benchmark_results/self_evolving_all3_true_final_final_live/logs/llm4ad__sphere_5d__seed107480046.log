def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = dim
    sigma = 10.0
    mu = np.zeros(D)
    sigma_best = np.inf
    count = 0
    while count < budget:
        N = 50
        x = np.random.randn(N, D) * sigma + mu
        x = clip(x)
        y = func(x)
        if any(np.isinf(y)):
            break
        best_idx = np.argmin(y)
        if y[best_idx] < sigma_best:
            sigma_best = y[best_idx]
            mu = x[best_idx, :]
        sigma_new = 0.5 * (sigma + np.sqrt(sigma**2 - sigma_best / N))
        sigma *= 0.1
        count += 1
    return clip(mu)
