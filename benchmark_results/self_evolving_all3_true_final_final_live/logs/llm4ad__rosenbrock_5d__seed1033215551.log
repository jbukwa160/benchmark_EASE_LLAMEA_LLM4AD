def algorithm(func, dim, lb, ub, budget, rng):
    best = np.array([0.0] * dim)
    best_func_value = float('inf')
    
    for _ in range(budget // 100 + 1):
        x = np.random.uniform(lb, ub, size=dim)
        
        # Local search
        for i in range(5):  # number of local search steps
            candidate = np.copy(x)
            
            for j in range(dim - 1):
                if rng.random() < 0.5:
                    candidate[j] += (rng.uniform(-1, 1) * x[j+1] + lb)
                else:
                    candidate[j+1] -= (rng.uniform(-1, 1) * candidate[j] + ub)
                
            candidate = np.clip(candidate, lb, ub)
            
            func_value = func(candidate)
            
            if func_value < best_func_value and not np.all(np.isclose(candidate, x)):
                best_func_value = func_value
                best = candidate
                
        # Random restart
        if rng.random() < 0.1:
            x = np.random.uniform(lb, ub, size=dim)
    
    return best
