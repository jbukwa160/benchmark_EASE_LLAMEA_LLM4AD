def algorithm(func, dim, lb, ub, budget, rng):
    D = rng.uniform(lb, ub, size=(dim,))
    X_best = D.copy()
    f_best = func(D)
    for i in range(budget-1):
        s = 0.01
        while s < 10:
            alpha = np.exp(rng.uniform(-3, 3))
            c = rng.normal(0, 0.1, size=(dim,))
            X_new = D + alpha * c
            f_new = func(X_new)
            if f_new < f_best:
                X_best = X_new.copy()
                f_best = f_new
            s *= 0.9
        D = np.clip(rng.normal(loc=X_best, scale=0.1*np.ones(dim), size=(dim)), lb, ub)
    return X_best
