def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x0 = np.random.uniform(lb, ub, size=dim)
    x_best = x0.copy()
    best_func_val = func(clip(x_best))

    temperature = 1.0
    cooling_rate = 0.99

    for _ in range(budget):
        new_x = clip(x_best + rng.normal(size=dim) * 0.01)

        new_func_val = func(new_x)
        delta = new_func_val - best_func_val

        if delta < 0:
            x_best = new_x
            best_func_val = new_func_val
        elif np.random.rand() < np.exp(-delta / temperature):
            x_best = new_x
            best_func_val = new_func_val

        temperature *= cooling_rate

    return clip(x_best)
