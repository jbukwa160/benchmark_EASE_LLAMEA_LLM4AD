def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def eval(x):
        x = clip(x)
        return func(x)

    def de_candidate(pop, best, fmin, sigma, rng):
        idx1 = rng.choice(dim)
        idx2 = rng.choice([i for i in range(dim) if i != idx1])
        candidate = pop[idx1] + sigma * (pop[idx2] - pop[np.random.randint(0, dim)])
        return clip(candidate)

    def sa_candidate(pop, best, fmin):
        step_size = 1e-4
        delta = rng.normal(loc=0, scale=np.sqrt(np.sum(best**2)))
        candidate = best + np.exp(-fmin) * delta
        return clip(candidate)

    pop = np.random.uniform(lb, ub, size=(budget, dim))
    best = pop[np.argmin([eval(x) for x in pop])]
    fmin = eval(best)

    for _ in range(budget - 1):
        candidate_de = de_candidate(pop, best, fmin, rng.uniform(0.5, 2.0), rng)
        candidate_sa = sa_candidate(pop, best, fmin)
        
        if rng.random() < 0.7:  # 70% chance to accept DE candidate
            candidate = candidate_de
        else:
            candidate = candidate_sa
        
        new_fval = eval(candidate)
        
        if new_fval < fmin:
            pop = np.delete(pop, np.argmin([eval(x) for x in pop]), axis=0)
            pop = np.vstack((pop, candidate))
            best = candidate
            fmin = new_fval

    return best
