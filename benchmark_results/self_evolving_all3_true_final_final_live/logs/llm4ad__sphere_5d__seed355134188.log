        y = func(x)
        
        if y < best_y:
            best_x = x
            best_y = y
            
        # Adaptive restarts
        if (_ + 1) % (budget // 10) == 0 and rng.rand() < 0.1:
            best_x = np.random.uniform(lb, ub, size=dim)
    
