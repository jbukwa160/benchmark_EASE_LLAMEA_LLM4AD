def algorithm(func, dim, lb, ub, budget, rng):
    def clip(cand, lower_bound, upper_bound):
        return np.clip(cand, a_min=lower_bound, a_max=upper_bound)

    current_best = np.zeros(dim)
    best_fitness = float('inf')

    for _ in range(budget):
        new_candidate = rng.uniform(lb, ub, size=(dim,))
        new_candidate = clip(new_candidate, lb, ub)

        new_fitness = func(new_candidate)
        
        if new_fitness < best_fitness:
            best_fitness = new_fitness
            current_best = new_candidate

        delta = rng.uniform(0.01, 1.0)  # Random step size between 0.01 and 1.0

        if rng.rand() < 0.2:  # 20% chance to accept worse solution (exploration)
            if np.random.rand() < np.exp(-(new_fitness - best_fitness) / delta):
                current_best = new_candidate
                best_fitness = new_fitness

    return clip(current_best, lb, ub)
