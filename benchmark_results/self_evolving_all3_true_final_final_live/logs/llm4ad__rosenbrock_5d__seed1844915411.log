def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return func(x)

    pop_size = 1000
    x = np.random.uniform(lb, ub, (pop_size, dim))
    
    best_x = None
    best_f = float('inf')
    
    for _ in range(budget):
        y = np.copy(x)
        
        for i in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size, 3)
            
            # Custom initialization
            if _ == 0:
                y[i] = x[rng.randint(0, pop_size)]
                
            # Crossover
            u = np.copy(x[i])
            for j in range(dim):
                if rng.random() < 0.5:
                    u[j] += (x[r1, j] - x[r2, j]) * rng.random()
                    
            # Mutation
            v = np.copy(u)
            for j in range(dim):
                v[j] += 0.5 * (u[j] - x[i, j])
                
            # Selection
            f1 = Rosenbrock(x[i])
            f2 = Rosenbrock(v)
            
            if f2 < f1:
                y[i] = v
                
        x = y
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
        
        # Update best solution
        best_f_local = float('inf')
        for i in range(pop_size):
            f = Rosenbrock(x[i])
            if f < best_f_local:
                best_f_local = f
                best_x_local = x[i]
                
        if best_f_local < best_f:
            best_f = best_f_local
            best_x = best_x_local
            
    return np.array(best_x)
