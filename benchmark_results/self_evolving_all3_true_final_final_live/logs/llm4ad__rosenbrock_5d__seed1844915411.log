def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    sigma = 5.0
    gamma = 1 / (2 * budget)
    best_x = np.random.uniform(lb, ub, size=dim)

    for t in range(budget):
        x_new = best_x + np.random.normal(size=dim) * sigma
        f_new = func(x_new)

        if not np.any(np.logical_and(x_new < lb, x_new > ub)):
            if f_new < func(best_x):
                best_x = x_new

        candidates = [np.clip(best_x + np.random.normal(size=dim) * sigma * gamma, lb, ub)]
        for _ in range(pop_size - 1):
            candidate = np.clip(np.copy(best_x) + np.random.normal(size=dim) * sigma * gamma, lb, ub)
            if func(candidate) < func(best_x):
                candidates.append(candidate)

        next_best_x = min(candidates, key=lambda x: func(x))
        best_x = next_best_x

    return best_x
