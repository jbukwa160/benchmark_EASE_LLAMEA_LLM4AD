def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    best_solution = None
    best_value = float('inf')

    for i in range(budget):
        x = rng.uniform(-5.0, 5.0, size=dim)
        x = clip_candidate(x)

        gradient_noise = rng.normal(0, 1e-3, size=dim)
        gradient = func(x + gradient_noise) - func(x - gradient_noise) / (2 * 1e-3)

        step_size = np.sqrt(np.sum(np.square(gradient)))
        direction = gradient / step_size

        new_x = x + direction * rng.uniform(0.001, 0.01)
        new_x = clip_candidate(new_x)

        value = func(new_x)
        if value < best_value:
            best_solution = new_x
            best_value = value

    return best_solution
