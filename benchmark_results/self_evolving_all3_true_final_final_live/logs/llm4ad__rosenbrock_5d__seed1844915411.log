def algorithm(func, dim, lb, ub, budget, rng):
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    def gradient(x):
        eps = 1e-6
        g = np.zeros(dim)
        for i in range(dim):
            dx = np.zeros(dim)
            dx[i] = eps
            g[i] = (func(x + dx) - f_best) / eps
        return g

    def quasi_newton(x, x_prev, f, f_prev):
        s = x - x_prev
        y = f - f_prev
        h = np.eye(dim)
        for i in range(dim):
            for j in range(i + 1, dim):
                dx = np.zeros(dim)
                dx[i] = s[j]
                dx[j] = s[i]
                h[i, j] = (f(x + dx) - f_prev) / eps
                h[j, i] = h[i, j]
        return y.T @ np.linalg.solve(h, s)

    for _ in range(budget):
        x_prev = x_best
        f_prev = f_best

        # Random search
        x_rand = lb + (ub - lb) * rng.rand(dim)
        f_rand = func(x_rand)
        if f_rand < f_best:
            x_best = x_rand
            f_best = f_rand

        # Quasi-Newton step
        g = gradient(x_best)
        dx = quasi_newton(x_best, x_prev, f_best, f_prev)
        x_trial = x_best + 0.1 * dx
        f_trial = func(np.clip(x_trial, lb, ub))
        if f_trial < f_best:
            x_best = x_trial
            f_best = f_trial

    return np.clip(x_best, lb, ub)
