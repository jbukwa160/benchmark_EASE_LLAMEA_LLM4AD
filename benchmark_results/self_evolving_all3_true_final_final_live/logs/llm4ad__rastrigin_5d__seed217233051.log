def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 20
    sigma = 0.5
    mu = (ub + lb) / 2
    best_x = mu
    best_f = func(best_x)
    iter_count = 0
    while iter_count < budget:
        X = mu + norm.rvs(loc=mu, scale=sigma, size=(pop_size, dim))
        clipped_X = np.clip(X, lb, ub)
        Y = func(clipped_X)
        idx = np.argsort(Y)[:int(pop_size / 2)]
        new_mu = np.mean(clipped_X[idx], axis=0)
        iter_count += pop_size
        if func(new_mu) < best_f:
            best_x = new_mu
            best_f = func(best_x)
            mu = new_mu
            sigma *= 1.01
        else:
            sigma *= 0.99
    return best_x
