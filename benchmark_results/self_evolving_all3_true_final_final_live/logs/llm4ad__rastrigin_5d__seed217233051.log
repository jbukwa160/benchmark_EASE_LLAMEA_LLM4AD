def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(budget):
        v1 = x + rng.normal(0, 0.5, size=dim)
        v2 = x + rng.normal(0, 0.3, size=dim)
        v3 = x + rng.normal(0, 0.1, size=dim)
        
        for j in range(dim):
            u = np.random.choice([v1, v2, v3])
            x_j = clip(u[j] if rng.uniform(0, 1) > 0.5 else x[j])
            x[j] = x_j
        
        f = func(x)
        if f < best_f:
            best_x = x.copy()
            best_f = f
    
    return best_x
