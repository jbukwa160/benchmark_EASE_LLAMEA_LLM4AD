def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    def evaluate(candidate):
        candidate = clip(candidate)
        return func(candidate)

    D = 0.5 * (ub - lb) / 1e6
    current = np.array([lb + rng.uniform(0, ub - lb) for _ in range(dim)])
    best = current.copy()
    temperature = 1e6

    for i in range(budget):
        for j in range(dim):
            donor = clip(current + D * rng.normal(size=dim))
            if evaluate(donor) < evaluate(best):
                best = donor
        current = best.copy()

        if evaluate(current) < evaluate(best):
            best = current

        temperature *= 0.99
        step_size = np.exp(-evaluate(best) / (1e6 + temperature))
        for j in range(dim):
            candidate = clip(best + step_size * rng.normal(size=dim))
            if evaluate(candidate) < evaluate(best):
                best = candidate
                break

    return best
