def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_noise(std):
        return rng.uniform(-std, std, size=dim)

    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def cmaes_step(x0, func, dim, lb, ub, step_size, sigma):
        for _ in range(10 * dim):  # CMA-ES iterations
            x1 = x0 + gaussian_noise(sigma)
            x1 = clip(x1)
            f1 = func(x1)
            if f1 < func(x0):
                x0 = x1
        return x0

    def multimodal_step(x, func, dim, lb, ub):
        for i in range(dim):
            x[i] += rng.uniform(-2 * (ub - lb), 2 * (ub - lb))
            x[i] = clip(x[i])
            f1 = func(x)
            if f1 < func(x):
                return x
        return x

    step_size = 0.5
    sigma = 1.0
    x = np.zeros(dim)
    for _ in range(budget):
        x = cmaes_step(x, func, dim, lb, ub, step_size, sigma)
        if rng.uniform(0, 1) < 0.2:  # 20% chance of switching to multimodal
            x = multimodal_step(x, func, dim, lb, ub)
    return x
