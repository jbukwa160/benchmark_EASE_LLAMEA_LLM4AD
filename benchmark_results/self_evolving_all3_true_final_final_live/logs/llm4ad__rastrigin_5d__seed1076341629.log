def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    bounds = [(lb, ub) for _ in range(dim)]
    result_de = differential_evolution(objective, bounds)
    
    x_init = rng.uniform(lb, ub, size=dim)
    gp_model = {'x_mean': np.zeros(dim), 'x_std': np.ones(dim)}
    x_best = x_init
    y_best = objective(x_init)
    
    for _ in range(budget):
        if np.isnan(y_best):
            x_new = rng.uniform(lb, ub, size=dim)
        else:
            # Sample from probabilistic hill climbing step
            x_new = x_best + gp_model['x_std'] * norm.rvs(size=dim)
            
            # Clip to bounds and ensure it's not too close to x_best
            if np.any(np.abs(x_new - x_best) > 1e-3):
                x_new = rng.uniform(lb, ub, size=dim)
        
        y_new = objective(x_new)
        
        # Update GP model with new data point
        gp_model['x_mean'] += (x_new - gp_model['x_mean']) / (_ + 1)
        gp_model['x_std'] += ((x_new - gp_model['x_mean']) ** 2) / (_ + 1) ** 0.5
        
        # Update best solution found so far
        if y_new < y_best:
            x_best = x_new
            y_best = y_new
    
    return x_best
