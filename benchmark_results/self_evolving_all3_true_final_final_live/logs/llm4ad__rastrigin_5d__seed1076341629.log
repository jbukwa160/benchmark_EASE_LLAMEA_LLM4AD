def algorithm(func, dim, lb, ub, budget, rng):
    D = len(dim)
    pop_size = 50
    gamma = 0.5
    F = 1.0
    best_x = None
    best_f = float('inf')

    for i in range(budget):
        X = np.zeros((pop_size, dim))
        Y = np.zeros((pop_size, D))

        for j in range(pop_size):
            X[j] = rng.uniform(lb, ub)

        for _ in range(10):
            for j in range(pop_size):
                r1, r2, r3 = rng.choice(range(pop_size), 3, replace=False)
                Y[j] = X[r1] + gamma * (X[r2] - X[r3])
                Y[j] = np.clip(Y[j], lb, ub)

            Z = F * Y
            X = np.where(np.random.rand(pop_size, D) < 0.5, X, Z)

        for j in range(pop_size):
            f = func(X[j])
            if f < best_f:
                best_f = f
                best_x = X[j]

    return best_x
