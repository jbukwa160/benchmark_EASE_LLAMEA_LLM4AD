def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        alpha = 1.0 / (i + 1) ** 0.5
        e = np.abs(np.random.normal(0, 1))
        new_x = best_x + alpha * e

        # Clip candidates to [lb, ub]
        new_x = np.clip(new_x, lb, ub)

        f_new = func(new_x)
        if f_new < best_f:
            best_x = new_x
            best_f = f_new
        elif rng.random() < 0.01 * (1 + np.exp(-i)):
            x = new_x

    return best_x
