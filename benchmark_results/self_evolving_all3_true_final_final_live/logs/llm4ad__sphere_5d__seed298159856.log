def algorithm(func, dim, lb, ub, budget, rng):
    n = 10 * dim
    mu = int(n / dim)
    sigma_max = 5.0
    sigma_min = 1e-6
    lambda_ = 50
    weights = np.array([lambda_ / (2 + i) for i in range(lambda_)])
    
    # Initialize variables
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)
    cov_mat = rng.uniform(0.1, 10.0, size=(dim, dim)) * np.eye(dim)

    for _ in range(budget):
        # Generate candidates
        x_cand = np.zeros((lambda_, dim))
        sigma = sigma_max / (1 + (_ / budget))
        noise = np.random.multivariate_normal(np.zeros(dim), cov_mat)
        x_cand = x_best + sigma * np.sqrt(2) * rng.normal(size=(lambda_, dim))[:, None] @ np.sqrt(cov_mat)

        # Clip candidates
        x_cand = np.clip(x_cand, lb, ub)
        
        # Evaluate candidates and update best solution
        f_cand = func(x_cand)
        idx_best = np.argmin(f_cand)
        if f_cand[idx_best] < f_best:
            x_best = x_cand[idx_best]
            f_best = f_cand[idx_best]

        # Update covariance matrix
        cov_mat += 1 / lambda_ * (x_cand - x_best)[:, None] @ (x_cand - x_best)
    
    return x_best
