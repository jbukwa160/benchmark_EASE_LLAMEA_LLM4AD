def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x_best = np.zeros(dim)
    f_best = float('inf')
    temperature = 1.0
    cooling_rate = 0.99
    sigma = 5.0

    for _ in range(budget):
        candidate = clip(x_best + rng.normal(0, sigma, dim))
        f_candidate = func(candidate)

        if f_candidate < f_best:
            x_best = candidate
            f_best = f_candidate

        delta = f_best - f_candidate
        probability = np.exp(-delta / temperature)
        accept = rng.uniform(0, 1) < probability

        if accept:
            x_best = candidate
            f_best = f_candidate

        temperature *= cooling_rate

    return x_best
