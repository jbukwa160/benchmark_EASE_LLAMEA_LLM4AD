def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    mean = np.zeros(dim)
    cov = np.eye(dim) * 1e-4
    sigma = 0.5
    lambda_ = 50

    for _ in range(budget):
        offspring = np.random.multivariate_normal(mean, cov + sigma**2*np.eye(dim), lambda_)
        offspring = clip(offspring)

        fitness = [func(x) for x in offspring]
        idx = np.argsort(fitness)[:lambda_//2]

        mean = np.mean(offspring[idx], axis=0)
        cov = (1 - 1/len(idx)) * cov + 1/len(idx) * np.dot((offspring[idx] - mean).T, offspring[idx] - mean)

    return clip(mean)
