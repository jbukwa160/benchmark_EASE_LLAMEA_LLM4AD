def algorithm(func, dim, lb, ub, budget, rng):
    def clip_bounds(x):
        return np.maximum(np.minimum(x, ub), lb)

    def generate_candidate_solution(rng):
        return clip_bounds(rng.uniform(size=dim))

    def fitness_function(solution):
        return func(solution)

    current_best = generate_candidate_solution(rng)
    for _ in range(budget):
        candidate = generate_candidate_solution(rng)
        if np.random.rand() < 0.1: # Simulated Annealing
            alpha = np.exp(-1 * (fitness_function(candidate) - fitness_function(current_best)) / rng.uniform())
            current_best = candidate if fitness_function(candidate) <= fitness_function(current_best) * alpha else current_best
        else:
            sigma = 1.0 # Initial step size for CMA-ES
            mean = current_best.copy()
            while _ < budget and np.linalg.norm(current_best - mean) > 1e-3:
                perturbation = rng.normal(size=dim)
                new_solution = mean + perturbation * sigma
                candidate = clip_bounds(new_solution)
                if fitness_function(candidate) < fitness_function(current_best):
                    current_best = candidate
            _ += 1

    return current_best
