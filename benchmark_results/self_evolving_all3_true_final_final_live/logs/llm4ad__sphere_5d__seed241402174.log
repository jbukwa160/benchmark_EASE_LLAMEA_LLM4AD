def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.minimum(np.maximum(x, lb), ub)

    def simplex_downhill(x0, func, dim, lb, ub, budget, rng):
        x = [x0] * (dim + 1)
        while True:
            for i in range(dim + 1):
                x[i] = clip(x[i], lb, ub)
                if np.random.rand() < 0.5:
                    x[i] += rng.uniform(-budget / dim, budget / dim)
                else:
                    x[i] -= rng.uniform(-budget / dim, budget / dim)
            f_x = func(np.array(x))
            best_x = np.array(x[np.argmin([func(xi) for xi in x])])
            if f_x < func(best_x):
                return best_x
            elif func(best_x) == 0:
                return best_x
            else:
                best_i = np.argmax([np.linalg.norm(xi - best_x) for xi in x])
                alpha = 1 / (dim + 2)
                beta = rng.uniform(0, 1)
                x[best_i] = clip(best_x + alpha * (x[best_i] - best_x) + beta * rng.uniform(-budget, budget), lb, ub)
            budget -= 1
            if budget <= 0:
                return best_x

    x0 = np.array([0.5] * dim)
    return simplex_downhill(x0, func, dim, lb, ub, budget, rng)
