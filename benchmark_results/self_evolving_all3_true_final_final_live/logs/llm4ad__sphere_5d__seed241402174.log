def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    current_best = func(x)

    for i in range(budget):
        y = x + 0.1 * (np.random.uniform(-1, 1, size=dim))
        y = np.clip(y, lb, ub)
        f_y = func(y)

        if f_y < current_best:
            current_best = f_y
            x = y

        T = 20 - i / budget * 20
        if rng.random() < np.exp((current_best - f_y) / T):
            current_best = f_y
            x = y

    return x
