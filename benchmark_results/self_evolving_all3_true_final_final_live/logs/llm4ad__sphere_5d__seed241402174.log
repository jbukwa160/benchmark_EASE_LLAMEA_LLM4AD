def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    cma_sigma = 0.1
    cma_rho_1 = 0.5
    cma_rho_c = 2.38 / (dim + 1.4)
    cma_mu = 10
    cma_x_mean = x.copy()
    cma_d_mean = np.zeros(dim)
    cma_p_pool = np.zeros((cma_mu, dim))
    cma_big_chi2 = 0

    for _ in range(budget):
        # generate new population
        noise = rng.randn(cma_mu, dim) * cma_sigma
        candidate = cma_x_mean + np.dot(noise, cma_d_mean)

        # clip candidates to [lb, ub]
        candidate = np.clip(candidate, lb, ub)

        # compute the fitness of each candidate
        f_candidate = func(candidate)

        # store candidate and its fitness in the pool
        for i in range(cma_mu):
            cma_p_pool[i] = candidate[i]
            cma_big_chi2 += (candidate[i] - x)**2

        # select the best candidate as the new mean
        if f_candidate < func(x):
            x = candidate.copy()
            cma_x_mean = x.copy()
            cma_d_mean = np.zeros(dim)
            cma_p_pool = np.zeros((cma_mu, dim))
            cma_big_chi2 = 0

    return x
