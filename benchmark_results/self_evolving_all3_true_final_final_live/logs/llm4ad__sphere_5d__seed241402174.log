def algorithm(func, dim, lb, ub, budget, rng):
    def sphere(x):
        return sum(x**2)

    def clip(x):
        return np.clip(x, lb, ub)

    x = np.zeros(dim)
    cov_matrix = np.eye(dim) * 1e-5
    step_size = 0.1

    for _ in range(budget):
        y = clip(x + rng.randn(dim))
        f_y = func(y)
        f_x = func(clip(x))

        if f_y < f_x:
            x = y
            cov_matrix = (1 - 2 * rng.rand()) * cov_matrix + rng.randn(dim, dim)

        step_size *= 0.99

    return clip(x)
