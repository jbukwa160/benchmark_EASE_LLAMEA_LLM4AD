def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(clip(x))

    for _ in range(budget):
        y = x + 0.5 * rng.normal(size=dim)
        f = func(clip(y))
        
        if np.random.rand() < 0.1:
            # Simulated Annealing
            alpha = 0.99 ** (budget - _)
            if f < best_f or np.exp((best_f - f) / (1e-8 + rng.uniform(size=1)[0])) > alpha:
                best_f, best_x = f, y.copy()
        else:
            # Differential Evolution
            z = x + 0.5 * rng.normal(size=dim)
            w = x + 0.2 * rng.normal(size=dim)
            u = clip(x + 0.3 * (y - z))
            v = clip(x + 0.4 * (w - u))
            if func(clip(v)) < f:
                f, y = func(clip(v)), v.copy()
        
        x = y

    return best_x
