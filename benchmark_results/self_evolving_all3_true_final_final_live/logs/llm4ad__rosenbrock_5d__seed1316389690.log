def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    min_val = func(x)
    
    for _ in range(budget):
        step_size = 0.1 / (budget + _)**0.5
        
        for i in range(dim):
            new_x = x.copy()
            new_x[i] += rng.uniform(-step_size, step_size)
            
            # Clip to bounds
            new_x = np.clip(new_x, lb, ub)
            
            val = func(new_x)
            if val < min_val:
                min_val = val
                best_x = new_x
                
        x = best_x.copy()
        
    return best_x
