def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(np.clip(x, lb, ub))

    pop_size = int(1e4)
    bounds = [(lb, ub) for _ in range(dim)]
    init_pop = rng.uniform(lb, ub, (pop_size, dim))
    init_costs = [objective(x) for x in init_pop]

    for i in range(budget):
        np.random.seed(i)
        diff = [np.random.choice(init_pop[i+1:]-init_pop[:i+1], size=dim, replace=False)]
        while len(diff[0]) < dim:
            if rng.random() < 0.5:
                idx = rng.randint(0, i+1)
                diff.append(init_pop[idx] - init_pop[rng.choice(range(i+1))])
            else:
                idx = rng.randint(i+1, pop_size-1)
                diff.append(init_pop[idx] - init_pop[rng.choice(range(i+1))])
        diff = np.array(diff)

        x_new = np.mean(init_pop + 0.5*diff, axis=1) + 0.01*rng.normal(0, ub-lb, dim)
        cost_new = objective(x_new)

        if cost_new < np.min([objective(x) for x in init_pop]):
            init_pop[i+1:] = [x_new]
            init_costs[i+1:] = [cost_new]

    best_idx = np.argmin(init_costs)
    return init_pop[best_idx]
