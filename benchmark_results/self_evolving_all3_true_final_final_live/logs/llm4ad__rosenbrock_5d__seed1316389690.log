def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def f(x):
        return func(x)

    # Initialize population and bounds
    pop_size = 100
    x = np.random.uniform(lb, ub, (pop_size, dim))
    y_best = np.inf

    for _ in range(budget):
        # Perform Differential Evolution (DE)
        a, b, c, d = rng.choice(pop_size, size=4, replace=False)
        v = clip(x[a] + 0.5*(x[b]-x[c]) + 0.3*(x[d]-x[a]))
        y = f(v)

        # Update best solution and population
        if y < y_best:
            x_best = v
            y_best = y

        idx = np.argsort(f(x))[:10]
        x[idx] = clip(x[idx])

    return x_best
