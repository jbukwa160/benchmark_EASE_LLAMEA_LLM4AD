def algorithm(func, dim, lb, ub, budget, rng):
    def gp_mean(X):
        return np.sin(np.sum(X, axis=1))

    def gp_var(X):
        return 0.1 + 0.5 * (np.sum((X - 1)**2, axis=1) / dim)

    def gp_cov(X, X_other):
        return np.exp(-np.sum((X[:, None] - X_other[None, :])**2, axis=-1) / 10)

    def gp_pred(X_new, X_old, y_old):
        mean = gp_mean(X_new)
        var = gp_var(X_new)
        cov = gp_cov(X_new[:, None], X_old[None, :])
        return mean + np.dot(cov, (y_old - mean) / gp_var(X_old)), var

    def sample_gp(X, y, n_samples):
        X_new = rng.uniform(lb, ub, size=(n_samples, dim))
        mu, sigma = gp_pred(X_new, X, y)
        return X_new[np.argmax(mu + rng.randn(n_samples) * np.sqrt(sigma), axis=1)]

    def bayesian_optimization(func, lb, ub, budget, rng):
        X = rng.uniform(lb, ub, size=(budget, dim))
        y = func(X)
        best_x = np.min(X, axis=0)
        for _ in range(budget):
            X_new = sample_gp(X, y, 100)
            y_new = func(X_new)
            if y_new < np.min(y):
                X = np.vstack((X, X_new))
                y = np.append(y, y_new)
                best_x = X[np.argmin(y), :]
        return best_x

    return bayesian_optimization(func, lb, ub, budget, rng)
