def algorithm(func, dim, lb, ub, budget, rng):
    def f(params):
        return func(np.clip(params, lb, ub))

    params = np.random.uniform(lb, ub, size=(dim,))
    covariance_matrix = np.eye(dim)
    step_size = 0.1
    population_size = 50

    for _ in range(budget):
        offspring_population = np.zeros((population_size, dim))
        for i in range(population_size):
            noise = rng.normal(size=dim)
            offspring_population[i] = params + step_size * np.sqrt(covariance_matrix) @ noise
        fitnesses = np.array([f(params_) for params_ in offspring_population])
        best_idx = np.argmin(fitnesses)
        next_params = offspring_population[best_idx]
        next_covariance_matrix = (1 - 0.01) * covariance_matrix + 0.01 * (offspring_population[best_idx] - params).reshape(-1, 1) @ (offspring_population[best_idx] - params).T
        step_size *= 0.9995
        params = next_params
        covariance_matrix = next_covariance_matrix

    return params
