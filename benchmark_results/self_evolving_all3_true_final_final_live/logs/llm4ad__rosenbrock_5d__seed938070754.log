def algorithm(func, dim, lb, ub, budget, rng):
    x = 0.5 * (ub + lb) + (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        g = np.zeros_like(x)
        df = 0
        for i in range(dim):
            x_try = x.copy()
            x_try[i] += 1e-6

            # Clip to bounds
            x_try = np.clip(x_try, lb, ub)

            f_try = func(x_try)
            g[i] = (f_try - best_f) / 1e-6

            if i > 0:
                for j in range(i):
                    x_j_try = x_try.copy()
                    x_j_try[j] += 1e-6
                    x_j_try = np.clip(x_j_try, lb, ub)

                    f_j_try = func(x_j_try)
                    g[i] -= (f_j_try - best_f) / 1e-6 * (x_try[j] - x[j])

            df += g[i]**2

        # Orthogonalize gradient vector
        u = g.copy()
        for i in range(1, dim):
            u[i] -= np.dot(u[i], g[:i]) / np.dot(g[:i], g[:i]) * g[:i]

        # Adapt step size using Armijo rule
        alpha = 0.01
        while True:
            x_new = x + alpha * u

            # Clip to bounds
            x_new = np.clip(x_new, lb, ub)

            f_new = func(x_new)
            if f_new < best_f:
                x = x_new
                best_x = x.copy()
                best_f = f_new
                break
            else:
                alpha *= 0.5

    return best_x
