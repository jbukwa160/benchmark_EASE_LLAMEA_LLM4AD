def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget - 1):
        # Compute gradient
        grad = np.zeros(dim)
        for i in range(dim):
            x_plus_h = x.copy()
            x_plus_h[i] += 0.01
            x_minus_h = x.copy()
            x_minus_h[i] -= 0.01
            grad[i] = (func(x_plus_h) - func(x_minus_h)) / (2 * 0.02)

        # Gradient boosting steps
        for _ in range(5):
            # Compute step size
            alpha = 1.0 / np.linalg.norm(grad)
            x_new = x + alpha * grad

            # Clip to bounds
            x_new = np.clip(x_new, lb, ub)

            # Evaluate new candidate
            f_new = func(x_new)

            # Update best solution if necessary
            if f_new < best_f:
                best_x = x_new.copy()
                best_f = f_new

            # Perturb new candidate and evaluate
            for i in range(dim):
                x_new_i = x_new + rng.uniform(-1, 1) * 0.01
                x_new_i = np.clip(x_new_i, lb, ub)
                f_new_i = func(np.array([x_new_i] * dim))

                # Update best solution if necessary
                if f_new_i < best_f:
                    best_x = x_new_i.copy()
                    best_f = f_new_i

            # Backtrack and re-evaluate gradients
            for _ in range(5):
                alpha /= 2.0
                x_new = x + alpha * grad

                # Clip to bounds
                x_new = np.clip(x_new, lb, ub)

                # Evaluate new candidate
                f_new = func(x_new)

                # Update best solution if necessary
                if f_new < best_f:
                    best_x = x_new.copy()
                    best_f = f_new

        # Update current solution and gradient
        x = best_x.copy()
        grad = np.zeros(dim)
        for i in range(dim):
            x_plus_h = x.copy()
            x_plus_h[i] += 0.01
            x_minus_h = x.copy()
            x_minus_h[i] -= 0.01
            grad[i] = (func(x_plus_h) - func(x_minus_h)) / (2 * 0.02)

    return best_x
