def algorithm(func, dim, lb, ub, budget, rng):
    def bounds(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = bounds(x)
        return func(x)

    pop_size = 50
    sigma_init = 5.0
    sigma_min = 0.01
    alpha = 1e-6

    population = rng.uniform(lb, ub, size=(pop_size, dim))
    best_x = np.zeros(dim)
    best_f = float('inf')

    for _ in range(budget):
        F = 0.5
        for _ in range(pop_size):
            i, j, k = rng.randint(0, pop_size, size=3)
            while i == j or j == k or k == i:
                i, j, k = rng.randint(0, pop_size, size=3)

            mutant_x = population[i] + F * (population[j] - population[k])
            sigma = max(sigma_min, sigma_init / np.sqrt(_ + 1))
            trial_x = mutant_x + rng.normal(size=dim) * sigma

            f_trial = evaluate(trial_x)
            if f_trial < evaluate(population[i]):
                population[i] = trial_x

        for i in range(pop_size):
            mutated_x = population[i] + alpha * rng.normal(size=dim)
            f_mutated = evaluate(mutated_x)
            if f_mutated < evaluate(population[i]):
                population[i] = mutated_x

        best_f_new = np.inf
        for x in population:
            f_x = evaluate(x)
            if f_x < best_f_new:
                best_f_new = f_x
                best_x = x

        if best_f_new < best_f:
            best_f = best_f_new
            best_x[:] = best_x

    return best_x
