def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    sigma = 0.1
    t_max = int(budget / (dim * pop_size))
    t_min = 1
    alpha = 0.9
    T = 10.0

    for _ in range(t_max - 1, -1, -1):
        x = np.random.uniform(lb, ub, size=(pop_size, dim))

        for i in range(pop_size):
            u = rng.rand(dim)
            while np.any(np.abs(u) < 0.01):
                u = rng.rand(dim)

            v = np.zeros(dim)
            for j in range(dim):
                if rng.rand() < 0.5:
                    v[j] = x[i, j]
                else:
                    v[j] = x[rng.randint(0, pop_size - 1), j]

            f_v = func(v)

            w = u * sigma
            f_w = func(x[i, :] + w)

            if f_v < f_w or rng.rand() < np.exp((f_v - f_w) / T):
                x[i] += w

        for i in range(pop_size):
            v = np.zeros(dim)
            for j in range(dim):
                v[j] = lb + (ub - lb) * rng.rand()

            f_v = func(v)

            if func(x[i]) < f_v:
                x[i] = v
            elif rng.rand() < np.exp((f_v - func(x[i])) / T):
                x[i] = v

        if _ % 10 == 0 and _ > t_min:
            T *= alpha

    return x[np.argmin([func(xi) for xi in x])]
