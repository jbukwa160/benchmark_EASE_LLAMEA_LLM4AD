def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lower, upper):
        return np.clip(candidate, lower, upper)

    def objective(params):
        return func(params)

    n = len(lb)
    x = np.random.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = objective(x)
    temperature = 1.0

    for _ in range(budget):
        if rng.random() < 0.01:  # 1% chance of mutation
            y = clip(x + rng.uniform(-10, 10, size=(dim,)), lb, ub)
        else:
            v = np.zeros((n,))
            for i in range(n):
                r1 = rng.randint(0, n-1)
                while r1 == i:
                    r1 = rng.randint(0, n-1)
                r2 = rng.randint(0, n-1)
                while r2 == i or r2 == r1:
                    r2 = rng.randint(0, n-1)
                v[i] = x[r1] + 0.5*(x[r2]-x[r1]) + rng.uniform(-1, 1)*temperature
            y = clip(x + v, lb, ub)

        f_y = objective(y)
        if f_y < best_f:
            best_x = y.copy()
            best_f = f_y

        alpha = np.exp(-(f_y - best_f)/temperature)
        temperature *= rng.uniform(0.9, 1.1)  # anneal temperature
        if rng.random() > alpha or f_y >= best_f:  # SA acceptance criterion
            x = y.copy()

    return best_x
