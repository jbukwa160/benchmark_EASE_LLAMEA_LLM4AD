def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    x = rng.uniform(lb, ub, (1, dim))
    sigma = 5.0 / dim ** (2/3)
    c1 = 1.0
    c2 = 0.8
    lambda_ = 32
    budget_used = 0

    while budget_used < budget:
        y = x + rng.normal(size=(lambda_, dim)) * sigma
        y = np.array([clip(y_i) for y_i in y])
        fitness = func(y)

        if budget_used == 0 or min(fitness) < func(x):
            x = y[np.argmin(fitness)]
            sigma = c1 * sigma + (1 - c1) * rng.uniform(0, 1)
            lambda_ *= 2
        else:
            mu = np.mean(y, axis=0)
            cov = np.cov(y.T)
            eigenvals, _ = np.linalg.eig(cov)

            if max(eigenvals) / min(eigenvals) > 10:
                x = mu + rng.normal(size=(1, dim)) * sigma
                budget_used += 1
            else:
                y_new = mu + (y - mu).T @ np.diag(np.sqrt(eigenvals)) * rng.normal(size=(lambda_, dim))
                y_new = np.array([clip(y_i) for y_i in y_new])
                fitness = func(y_new)

                if min(fitness) < func(x):
                    x = y_new[np.argmin(fitness)]
                    sigma *= c2
                else:
                    lambda_ //= 2

        budget_used += 1

    return clip(x)
