def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.minimum(np.maximum(x, lb), ub)

    def de_mutation(pop, g_best, F, dim):
        mutated_pop = pop + F * (g_best - pop) + rng.normal(size=(pop.shape[0], dim)) * 0.1
        return clip(mutated_pop, lb, ub)

    def de_crossover(u, v, cr):
        crossover_mask = np.random.choice([True, False], size=dim, p=[cr, 1-cr])
        return u + (v - u) * crossover_mask

    pop_size = int(np.sqrt(budget))
    pop = rng.uniform(lb, ub, size=(pop_size, dim))

    for _ in range(pop_size):
        F = rng.uniform(0.5, 1.0)
        cr = rng.uniform(0.6, 1.0)

        g_best = np.argmin([func(ind) for ind in pop])
        mutated_pop = de_mutation(pop, pop[g_best], F, dim)
        crossed_pop = [de_crossover(u, v, cr) for u, v in zip(mutated_pop, pop)]

        pop = np.array(crossed_pop)

    g_best = np.argmin([func(ind) for ind in pop])
    return pop[g_best]
