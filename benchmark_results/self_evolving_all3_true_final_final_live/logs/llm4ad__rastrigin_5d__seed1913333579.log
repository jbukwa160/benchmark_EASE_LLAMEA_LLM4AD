def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 0.5 * (ub - lb)
    n_params = [1.]
    mu = np.zeros(dim)
    c1 = 2 / (dim + 1.4)
    c_cma = 2 / ((dim + 1.4) ** 2)
    cmu = 2 / ((dim + 2.) ** 2)

    for i in range(budget):
        z = np.random.normal(size=dim)
        x = mu + sigma * z
        clipped_x = np.clip(x, lb, ub)
        
        f_x = func(clipped_x)
        
        n_params.append(1.)
        if np.random.rand() < 0.01:
            n_params[-1] *= 2.
        sigma_new = sigma * (1 + c_cma * (np.dot(z, z) - dim))
        mu_new = mu + sigma_new / np.sqrt(n_params[-1]) * z
        mu = mu_new
        
        if f_x < func(mu):
            mu = clipped_x
            
    return mu
