def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def mutation(x, sigma=0.1):
        return x + sigma * (ub - lb) * rng.randn(dim)

    def crossover(x1, x2, cr=0.9):
        u = rng.rand(dim)
        return u*x1 + (1-u)*x2

    best_candidate = clip(rng.uniform(lb, ub, size=(dim)))
    best_fitness = func(best_candidate)

    for _ in range(budget):
        candidate = mutation(clip(rng.normal(loc=best_candidate, scale=0.5, size=(dim))))
        candidate = crossover(candidate, best_candidate)
        candidate_fitness = func(candidate)
        
        if candidate_fitness < best_fitness:
            best_candidate = candidate
            best_fitness = candidate_fitness

    return clip(best_candidate)
