def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x) if isinstance(x, np.ndarray) else func(*x)

    x_best = np.array([ub + (ub - lb) * rng.uniform(0.0, 1.0) for _ in range(dim)])
    f_best = f(x_best)
    
    for _ in range(budget):
        v = [np.array([lb + (ub - lb) * rng.uniform(0.0, 1.0) for _ in range(dim)]) 
             for _ in range(dim)]
        
        for i in range(dim):
            r1 = np.random.choice(range(dim))
            while r1 == i:
                r1 = np.random.choice(range(dim))
            
            r2 = np.random.choice(range(dim))
            while (r2 == i) or (r2 == r1):
                r2 = np.random.choice(range(dim))
                
            v[i] += 0.5 * (x_best[r1] - x_best[r2]) + rng.uniform(-1, 1)
        
        f_v = f(np.array(v))
        
        if f_v < f_best:
            x_best = np.copy(v)
            f_best = f_v
    
    return x_best
