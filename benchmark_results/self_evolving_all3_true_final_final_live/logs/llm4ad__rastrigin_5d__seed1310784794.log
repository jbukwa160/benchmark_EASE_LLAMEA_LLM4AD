def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(clip(x_best))

    for _ in range(budget):
        n_points = 3
        y = np.zeros(n_points)
        for i in range(n_points):
            v = clip(rng.normal(size=dim))
            y[i] = func(x_best + 0.5 * v)

        v = np.mean((x_best - lb)[:, None] * (y - f_best)[None, :] / ((ub - lb) ** 2), axis=0)
        u = rng.uniform()
        if u < 1/3:
            x_new = clip(x_best + 0.5 * v)
        elif u < 2/3:
            x_new = clip(0.7 * x_best + 0.3 * rng.normal(size=dim))
        else:
            n_dim = int(rng.rand() * dim)
            i = np.random.choice(dim, replace=False, size=n_dim)
            x_new = clip(np.copy(x_best))
            for j in range(n_dim):
                x_new[i[j]] += rng.uniform(-1, 1)

        f_new = func(clip(x_new))

        if f_new < f_best:
            x_best = np.copy(x_new)
            f_best = f_new

    return clip(x_best)
