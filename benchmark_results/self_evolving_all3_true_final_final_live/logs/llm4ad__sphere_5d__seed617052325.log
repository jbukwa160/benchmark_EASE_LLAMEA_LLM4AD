def algorithm(func, dim, lb, ub, budget, rng):
    best_candidate = rng.uniform(lb, ub, size=dim)
    best_value = func(best_candidate)

    for _ in range(budget):
        candidate = best_candidate.copy()
        for i in range(dim):
            if rng.random() < 0.5:
                candidate[i] += (ub - lb) * rng.random()
            else:
                candidate[i] -= (ub - lb) * rng.random()

            candidate = np.clip(candidate, lb, ub)

            value = func(candidate)
            if value < best_value:
                best_candidate = candidate
                best_value = value

    return best_candidate
