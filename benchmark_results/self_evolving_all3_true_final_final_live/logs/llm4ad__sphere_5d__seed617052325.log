def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    min_f = func(best_x)

    for i in range(1, int((ub - lb) * 1000) + 1):
        x[0] = lb + (i / 1000) * (ub - lb)
        f = func(x)
        
        if f < min_f and budget > 0:
            best_x = x.copy()
            min_f = f
            budget -= 1
            
        elif f >= min_f and budget > 0:
            new_x = np.random.uniform(lb, ub, size=dim)
            f_new = func(new_x)
            
            if f_new < min_f:
                best_x = new_x.copy()
                min_f = f_new
                budget -= 1
                
    return best_x
