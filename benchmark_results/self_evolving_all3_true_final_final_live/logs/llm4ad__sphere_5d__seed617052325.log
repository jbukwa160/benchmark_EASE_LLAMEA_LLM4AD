def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=(1, dim))
    for _ in range(budget - 1):
        # Step 1: Mutation
        v = np.zeros((1, dim))
        for i in range(dim):
            r1, r2, r3 = rng.choice(x.shape[0], size=3, replace=False)
            u = clip(rng.uniform(lb, ub) * np.array([x[r1, i], x[r2, i], x[r3, i]]))
            v[0, i] = x[0, i] + 0.5 * (u - x[0, i]) / abs(u - x[0, i])
        # Step 2: Selection
        w = np.zeros((1, dim))
        for i in range(dim):
            w[0, i] = func(clip(v[0, i])) if rng.uniform(0.0, 1.0) < 0.5 else func(x[0, i])
        # Update
        x = np.where(func(w) <= func(x), w, x)
    return clip(x)
