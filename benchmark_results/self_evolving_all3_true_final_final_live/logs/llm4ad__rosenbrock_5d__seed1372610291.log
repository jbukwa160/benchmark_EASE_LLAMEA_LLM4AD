def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    def sa_search():
        T = 1000.0
        alpha = 0.99
        n_iter = int(budget / dim)
        best_x = rng.uniform(lb, ub, size=dim)
        best_f = evaluate(best_x)

        for i in range(n_iter):
            x_new = np.copy(best_x)
            idx = rng.randint(0, dim-1)
            step_size = 0.5 * (ub - lb) / n_iter

            # Step 1: Perturb one dimension
            x_new[idx] += rng.uniform(-step_size, step_size)

            # Step 2: Apply crossover operator
            for j in range(dim):
                if rng.random() < 0.5:
                    x_new[j] = np.mean([best_x[j], x_new[j]])

            # Step 3: Accept or reject new candidate
            f_new = evaluate(x_new)
            delta = f_new - best_f

            if delta < 0 or rng.uniform(0, 1) < np.exp(-delta / T):
                best_x = x_new
                best_f = f_new

            # Update temperature
            T *= alpha

        return best_x

    return sa_search()
