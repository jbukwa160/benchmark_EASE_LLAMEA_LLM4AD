def algorithm(func, dim, lb, ub, budget, rng):
    n_dim = dim
    n_var = int(np.ceil(n_dim / 2))

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_trial = np.copy(x_best)
        idx = rng.permutation(dim)[:n_var]
        x_trial[idx] = (x_best[idx] + np.random.uniform(-1, 1, size=n_var)) / 2

        # Clip to bounds
        x_trial = np.clip(x_trial, lb, ub)

        f_trial = func(x_trial)
        if f_trial < f_best:
            x_best = x_trial
            f_best = f_trial

    return x_best
