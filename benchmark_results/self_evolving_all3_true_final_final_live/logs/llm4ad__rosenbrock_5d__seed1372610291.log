def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    def evaluate(x):
        x = clip(x)
        return func(x), x

    D = dim
    pop_size = 50
    iter_num = budget // (D + 1)  # assuming each iteration has D+1 function evaluations
    temp_init = 1000.0
    temp_final = 1e-6
    alpha = 0.99

    x_best = np.random.uniform(lb, ub, size=(pop_size, D))
    f_best = np.array([evaluate(x)[0] for x in x_best])

    for i in range(iter_num):
        sigma = (ub - lb) / 2
        temp = temp_init * alpha ** i

        # ADE step
        for j in range(pop_size):
            idx1, idx2, idx3 = rng.choice(D, size=3, replace=False)
            a = np.random.normal(0, sigma, size=D)
            x_new = clip(x_best[j] + a[idx1] * (x_best[idx2] - x_best[idx3]))
            f_new, _ = evaluate(x_new)

        # SA step
        for j in range(pop_size):
            idx = rng.choice(D, p=np.array([0.5 if i == k else 0.5 / (D - 1) for i in range(D)]))
            a = np.random.normal(0, sigma, size=D)
            x_new = clip(x_best[j] + a[idx] * (x_best[j] - x_best[rng.choice(pop_size, p=np.array([1/(j+1)]))]))
            f_new, _ = evaluate(x_new)

            if f_new < f_best[j]:
                x_best[j] = _
                f_best[j] = f_new
            elif np.random.rand() < np.exp(-(f_new - f_best[j]) / temp):
                x_best[j] = _
                f_best[j] = f_new

        # update best solution
        idx = np.argmin(f_best)
        if f_best[idx] < 0:
            break

    return x_best[np.argmin(f_best)]
