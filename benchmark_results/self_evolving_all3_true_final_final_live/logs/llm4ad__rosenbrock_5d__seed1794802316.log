def algorithm(func, dim, lb, ub, budget, rng):
    def eval(x):
        x = np.clip(x, lb, ub)
        return func(x)

    n = dim
    mu = 1.0 / (n + 1.5)
    c1 = 2 / ((n + 2) ** 2)
    c3 = 2 / ((n + 4) ** 2)
    cmu = 1 - mu
    ccov = 1 - c1 * mu

    mean = np.random.uniform(lb, ub, n)
    cov = np.eye(n)

    best_x = mean.copy()
    best_f = eval(mean)

    for _ in range(budget):
        z = rng.normal(size=n)
        x = mean + ccov ** 0.5 * cov @ z

        f = eval(x)
        if f < best_f:
            best_x = x.copy()
            best_f = f

        delta = x - mean
        ax = c1 * mu * delta
        y = rng.normal(size=n)
        vy = cmu * (cov @ y)

        cov += ccov * np.outer(delta, delta) + c3 * np.outer(ax, ax) - 2.0 * ax @ vy

        mean += cmu * delta + vy

    return best_x
