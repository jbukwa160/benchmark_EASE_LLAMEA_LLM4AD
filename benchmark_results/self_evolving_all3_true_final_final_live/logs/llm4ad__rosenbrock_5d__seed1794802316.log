def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(pop_size, bounds):
        x = rng.uniform(-5, 5, (pop_size, dim))
        return clip(x)

    def evaluate(individuals, func):
        values = [func(individual) for individual in individuals]
        return values

    def differential_evolution(population, bounds, budget, rng):
        pop_size = len(population)
        for _ in range(budget // 10):
            diffs = np.zeros((pop_size, dim))
            weights = rng.uniform(0.1, 1.0, size=(pop_size,))
            for i in range(dim):
                indices = rng.choice(pop_size, size=3, replace=False)
                diffs[indices, i] = population[indices, i]
                weights += (population[indices, i] - population[:, i]) / np.abs(population[:, i])
            new_population = population + 0.5 * np.dot(diffs, weights)[:, None]
            new_population = clip(new_population)
        return new_population

    def local_search(individuals, bounds):
        for individual in individuals:
            x_best = individual.copy()
            x_current = individual.copy() + rng.uniform(-1e-6, 1e-6, size=dim)
            x_current = clip(x_current)
            while True:
                f_current = func(x_current)
                f_best = func(x_best)
                if f_current < f_best:
                    x_best = x_current
                    x_current = individual.copy() + rng.uniform(-1e-6, 1e-6, size=dim)
                    x_current = clip(x_current)
                else:
                    break

    population = generate_initial_population(50, (lb, ub))
    best_individual = evaluate(population, func)[0]
    best_individual = np.array([best_individual])

    for _ in range(budget):
        population = differential_evolution(population, (lb, ub), budget // 10, rng)
        values = evaluate(population, func)

        idx = np.argsort(values)[:1]
        best_individual = population[idx]

        local_search(best_individual, (lb, ub))
        values = evaluate(best_individual, func)[0]
        if values < best_individual[0]:
            best_individual = clip(np.array([values]))

    return best_individual
