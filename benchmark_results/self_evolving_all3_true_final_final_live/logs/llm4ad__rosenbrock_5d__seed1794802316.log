def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)
    
    step_size = 2 * (ub - lb) / np.sqrt(dim)
    step_reduction_factor = 0.9
    
    for _ in range(budget):
        while True:
            x_new = x_best + rng.uniform(-step_size, step_size, size=dim)
            x_new = np.clip(x_new, lb, ub)
            
            f_new = func(x_new)
            
            if f_new < f_best:
                x_best = x_new
                f_best = f_new
                
                # Reduce step size when making progress
                if _ > 100 and f_best < f_best - (f_best / 2**(_-100)):
                    step_size *= step_reduction_factor
                    
            else:
                break
                
    return x_best
