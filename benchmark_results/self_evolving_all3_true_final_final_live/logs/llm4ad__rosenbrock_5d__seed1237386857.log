def algorithm(func, dim, lb, ub, budget, rng):
    population_size = 100
    mutation_rate = 0.1
    elite_size = int(population_size * 0.2)
    
    def generate_initial_population():
        return rng.uniform(lb, ub, (population_size, dim))
    
    def clip_to_bounds(x):
        return np.clip(x, lb, ub)
    
    population = generate_initial_population()
    
    for _ in range(budget):
        scores = np.array([func(clip_to_bounds(x)) for x in population])
        sorted_indices = np.argsort(scores)[:elite_size]
        
        next_generation = population[sorted_indices]
        
        for i in range(population_size - elite_size):
            parent1, parent2 = rng.choice(next_generation, 2, replace=False)
            child = (parent1 + parent2) / 2
            if rng.rand() < mutation_rate:
                child += rng.uniform(-mutation_rate, mutation_rate, dim)
            next_generation[i] = clip_to_bounds(child)
        
        population = next_generation
    
    best_individual = population[np.argmin(scores)]
    return best_individual
