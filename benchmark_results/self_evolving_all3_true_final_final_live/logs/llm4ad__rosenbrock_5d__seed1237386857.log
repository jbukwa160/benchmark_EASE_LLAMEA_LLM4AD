def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def mutate(x):
        sigma = 0.1 * (ub - lb)
        for i in range(dim):
            if rng.random() < 0.5:
                x[i] += rng.uniform(-sigma, sigma)
            elif rng.random() < 0.5:
                x[i] -= rng.uniform(0, sigma)
        return clip(x)

    def evaluate(x):
        return func(x)

    population_size = int(np.sqrt(budget))
    population = np.random.uniform(lb, ub, (population_size, dim))

    best_x = None
    best_f = float('inf')

    for _ in range(population_size * 5): # restarts
        offspring = np.copy(population)
        for i in range(population_size):
            candidate = mutate(np.copy(offspring[i]))
            offspring[i] = evaluate(candidate)
        new_best_x, new_best_f = population[np.argmin(offspring)], np.min(offspring)

        if new_best_f < best_f:
            best_x, best_f = new_best_x, new_best_f

    return best_x
