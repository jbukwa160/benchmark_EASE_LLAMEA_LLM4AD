def algorithm(func, dim, lb, ub, budget, rng):
    def wrapper(x):
        return func(x)

    bounds = [(lb[i], ub[i]) for i in range(dim)]

    res = differential_evolution(wrapper, bounds, x0=rng.uniform(lb, ub, size=dim), polish=True)
    
    best_x = np.clip(res.x, lb, ub)
    best_f = wrapper(best_x)

    return best_x, best_f
