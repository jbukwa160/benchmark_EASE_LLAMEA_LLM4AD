def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    x_best = np.random.uniform(lb, ub, (pop_size, dim))
    f_values = np.zeros(pop_size)
    
    for _ in range(budget):
        F = 0.5 + 0.5 * np.sin(2 * np.pi * rng.uniform(0, 1))
        Cr = 0.9
        
        for i in range(pop_size):
            x_trial = x_best.copy()
            
            for j in range(dim):
                u = rng.uniform(0, 1)
                
                if u < F:
                    r1, r2 = rng.choice(pop_size, size=2, replace=False)
                    
                    if rng.random() < Cr or j == 0:
                        x_trial[j] += rng.normal(-1, 1) * (x_best[r1, j] - x_best[r2, j])
                
                x_trial[j] = np.clip(x_trial[j], lb, ub)
            
            f_value = func(x_trial)
            
            if f_value < f_values[i]:
                f_values[i] = f_value
                x_best[i] = x_trial.copy()
    
    return x_best[np.argmin(f_values)]
