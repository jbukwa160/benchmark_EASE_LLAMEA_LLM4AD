def algorithm(func, dim, lb, ub, budget, rng):
    def local_search(x, func):
        for i in range(dim):
            if 0 < x[i] < 1:
                dx = 10**(-6) * (np.random.rand() - 0.5)
                x[i] += dx
                x[i] = max(lb, min(ub, x[i]))
                x[i] = lb + (x[i] - lb) / (ub - lb) * (ub - lb)
        return func(x)

    D = np.zeros(dim)
    for i in range(dim):
        D[i] = rng.uniform(lb, ub)

    best_x = np.copy(D)
    best_f = func(best_x)

    pop_size = 10
    pops = np.random.rand(pop_size, dim) * (ub - lb) + lb

    for _ in range(budget):
        fitnesses = [func(x) for x in pops]
        idx = np.argsort(fitnesses)
        pops = pops[idx]

        for i in range(pop_size):
            D = pops[i] + rng.uniform(-1, 1, dim)

            # Clip candidates to [lb, ub]
            D = np.clip(D, lb, ub)

            if local_search(D, func) < fitnesses[i]:
                pops[i] = D
                fitnesses[i] = local_search(D, func)

        best_f_new = min([local_search(x, func) for x in pops])
        if best_f_new < best_f:
            best_f = best_f_new
            best_x = np.copy(pops[np.argmin([local_search(x, func) for x in pops])])

    return best_x
