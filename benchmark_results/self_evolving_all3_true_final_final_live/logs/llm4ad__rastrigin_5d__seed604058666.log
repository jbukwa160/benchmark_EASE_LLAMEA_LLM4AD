def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def polynomial_mutation(x, sigma):
        m = 20  # mutation strength distribution index
        a = 1 / (m - 2) if m != 2 else 0.5
        y = np.zeros_like(x)
        for i in range(dim):
            if rng.random() < 0.1:
                y[i] = x[i] + sigma * rng.uniform(-1, 1)
            else:
                y[i] = x[i]
        return clip(y)

    def differential_evolution(x0, bounds, budget):
        pop_size = 50
        x = np.array([rng.uniform(lb, ub) for _ in range(pop_size)])
        y = func(x)

        for i in range(budget):
            # selection
            idx = rng.choice(pop_size, size=3, replace=False)
            u = clip(np.array([(x[idx[0]] + x[idx[1]] + x[idx[2]]) / 3]))
            v = polynomial_mutation(u, 0.5)
            w = func(v)

            # update population
            if w < y[idx[np.argmin(y)]]:
                x[idx[np.argmin(y)]] = v
                y[idx[np.argmin(y)]] = w

        return np.array([x[np.argmin(y)]])

    return differential_evolution(np.zeros(dim), (lb, ub), budget)
