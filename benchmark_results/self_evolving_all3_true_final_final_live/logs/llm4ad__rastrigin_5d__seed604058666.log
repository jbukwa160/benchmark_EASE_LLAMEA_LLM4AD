def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    mu = int(np.ceil(n / 2))
    lambda_ = 4 * mu + 1
    sigma = 0.5 * (ub - lb)
    x = np.random.uniform(lb, ub, size=(lambda_, n))
    p = np.zeros((lambda_, n))

    for _ in range(budget):
        f_x = func(x)
        idx = np.argsort(f_x)

        if f_x[idx[0]] < 10**-20:
            return x[idx[0]]

        mu_idx = idx[:mu]
        sigma *= 0.99 + 0.1 / (1 + budget / n)
        c = np.random.normal(0, 1, size=(n,))
        z = np.zeros((lambda_, n))
        p_new = p[idx[mu:]] * 0.8

        for i in range(lambda_):
            if i < mu:
                p[i] = x[idx[i]]
            else:
                p[i] += sigma * c[i]

            z[i] = (p[i] - x[idx[0]]) / sigma
            while np.any(np.abs(z[i]) > 1.5) or np.any(np.isnan(z[i])):
                if np.any(np.abs(z[i]) > 1.5):
                    sigma *= 0.9
                elif not np.all(np.isfinite(z[i])):
                    p_new = x[idx[mu:]] * 0.8
                    break
                c = np.random.normal(0, 1, size=(n,))
                z[i] = (p[i] - x[idx[0]]) / sigma

            if i >= mu:
                p_new[i] = p[i]

        x = np.copy(x)
        for i in range(lambda_):
            x[i] += sigma * np.random.normal(0, 1, size=n)

            while not (lb <= x[i]).all() and (x[i] <= ub).all():
                x[i][np.isnan(x[i])] = lb + rng.uniform(0, 1 - lb)
                x[i][np.isinf(x[i])] = ub + rng.uniform(-ub, 1)

        for i in range(lambda_):
            f_x = func(x)
            idx = np.argsort(f_x)
            if f_x[idx[0]] < f_x[idx[mu]]:
                p_new[idx[i]] = x[idx[0]]
            else:
                x[i] = x[idx[mu]]

    return x[np.argmin(func(x))]
