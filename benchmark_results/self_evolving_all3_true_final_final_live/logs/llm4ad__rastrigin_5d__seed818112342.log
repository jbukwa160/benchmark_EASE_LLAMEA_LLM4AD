def algorithm(func, dim, lb, ub, budget, rng):
    def clip_bounds(x, lb, ub):
        return np.minimum(np.maximum(x, lb), ub)

    def fitness(x):
        return func(x)

    pop_size = 10 * dim
    n_offspring = int(pop_size / 2)
    sigma_init = 0.1
    c1, c2 = 1, 1

    # Initialize population
    x = rng.uniform(lb, ub, (pop_size, dim))
    y = x.copy()
    f = np.zeros(pop_size)

    for _ in range(budget):
        # CMA-ES step
        sigma = min(sigma_init * np.exp(-0.01 * _), 1)
        for i in range(n_offspring):
            z = rng.normal(0, sigma, dim)
            x_new = clip_bounds(x[i] + z, lb, ub)
            f_new = fitness(x_new)
            if f_new < f[i]:
                x[i], y[i], f[i] = x_new, x_new, f_new

        # Differential Evolution step
        for i in range(pop_size):
            j1, j2, j3 = rng.choice(range(pop_size), 3, replace=False)
            v = clip_bounds(y[j1] + c1 * (y[j2] - y[j3]), lb, ub)
            f_new = fitness(v)
            if f_new < f[i]:
                x[i], y[i], f[i] = v, v, f_new

        # Local search step
        for i in range(pop_size):
            z = np.zeros(dim)
            for j in range(dim):
                z[j] = rng.uniform(-sigma, sigma)
                new_x = clip_bounds(x[i][j] + z[j], lb, ub)
                new_f = fitness(new_x)
                if new_f < f[i]:
                    x[i][j] = new_x
                    y[i][j] = new_x
                    f[i] = new_f

    best_x = np.argmin(f)
    return clip_bounds(x[best_x], lb, ub)
