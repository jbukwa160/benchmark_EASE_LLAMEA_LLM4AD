def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def objective(x):
        return func(x)

    x = rng.uniform(lb, ub, size=dim)
    best_x = clip(x)
    best_f = objective(best_x)
    cma_es = np.array([[1.0] * dim])

    for _ in range(budget - 1):
        x_new = np.dot(cma_es, rng.normal(size=(1, dim)))
        x_new = clip(x_new[0])
        f_new = objective(x_new)

        if f_new < best_f:
            cma_es = (cma_es * (1 - 1 / (budget + 1))) + (np.outer((x_new - best_x), (f_new - best_f)) / (f_new - best_f))
            best_x = x_new
            best_f = f_new

    return best_x
