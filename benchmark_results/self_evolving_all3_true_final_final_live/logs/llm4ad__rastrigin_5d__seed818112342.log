def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def generate_initial_population(pop_size, dim):
        population = rng.uniform(size=(pop_size, dim))
        return clip(population)

    def evaluate(individuals):
        scores = [func(individual) for individual in individuals]
        return np.array(scores)

    def mutation(parent1, parent2, f):
        delta = (parent2 - parent1) * rng.normal(scale=f)
        child = parent1 + delta
        return clip(child)

    def crossover(child, parent):
        if rng.uniform() < 0.5:
            child[:] = parent
        else:
            idx = rng.choice(dim, size=dim, replace=False)
            child[idx] = parent[idx]
        return child

    population = generate_initial_population(50, dim)
    scores = evaluate(population)

    for _ in range(budget):
        idx_best = np.argmax(scores)
        best_individual = population[idx_best]

        idx_parents = rng.choice(population.shape[0], size=3, replace=False)
        parents = population[idx_parents]
        score_parents = scores[idx_parents]

        f_mutation = 0.5
        children = [crossover(mutation(parents[i], parents[(i+1)%3], f_mutation), parents[i]) for i in range(3)]

        new_scores = evaluate(children)
        idx_new_best = np.argmax(new_scores)

        if new_scores[idx_new_best] < scores[idx_best]:
            population[idx_parents[0]] = children[idx_new_best]
            scores[idx_parents[0]] = new_scores[idx_new_best]

    return best_individual
