def algorithm(func, dim, lb, ub, budget, rng):
    population_size = 50
    mutation_rate = 0.01
    crossover_rate = 0.5
    
    def generate_initial_population(budget):
        return [rng.uniform(lb, ub, size=dim) for _ in range(population_size)]
    
    def calculate_fitness(individuals, func):
        return [func(individual) for individual in individuals]
    
    def mutate(individual, mutation_rate):
        mutated_individual = np.copy(individual)
        for i in range(dim):
            if rng.random() < mutation_rate:
                mutated_individual[i] += rng.uniform(-1, 1)
                mutated_individual[i] = max(lb, min(ub, mutated_individual[i]))
        return mutated_individual
    
    def crossover(parent1, parent2, crossover_rate):
        child = np.copy(parent1)
        for i in range(dim):
            if rng.random() < crossover_rate:
                child[i] = parent2[i]
        return child
    
    best_so_far = None
    population = generate_initial_population(budget // 5)
    
    for _ in range(budget // 5):
        fitnesses = calculate_fitness(population, func)
        worst_index = np.argmax(fitnesses)
        if (best_so_far is None) or (fitnesses[worst_index] < best_so_far[1]):
            best_so_far = (population[worst_index], fitnesses[worst_index])
        
        new_population = []
        for i in range(population_size):
            parent1, parent2 = np.random.choice(population, 2, replace=False)
            child = crossover(parent1, parent2, crossover_rate)
            mutated_child = mutate(child, mutation_rate)
            new_population.append(mutated_child)
        
        population = [x if rng.random() < 0.5 else y for x, y in zip(population, new_population)]
    
    return best_so_far[0]
