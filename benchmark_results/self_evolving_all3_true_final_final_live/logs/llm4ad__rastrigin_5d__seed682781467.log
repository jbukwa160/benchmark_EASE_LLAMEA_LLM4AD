def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(1, budget+1):
        a = 0.5 * (ub - lb) / np.sqrt(np.log(i + 1))
        v1, v2, v3 = rng.normal(size=(dim,)), rng.normal(size=(dim,)), rng.normal(size=(dim,))
        
        x_new1 = clip(best_x + a * v1, lb, ub)
        f_new1 = func(x_new1)
        
        if f_new1 < best_f:
            best_x = x_new1.copy()
            best_f = f_new1
            
        x_new2 = clip(best_x + a * v2, lb, ub)
        f_new2 = func(x_new2)
        
        if f_new2 < best_f:
            best_x = x_new2.copy()
            best_f = f_new2
            
        x_new3 = (best_x + x_new1 + x_new2) / 3
        f_new3 = func(clip(x_new3, lb, ub))
        
        if f_new3 < best_f:
            best_x = x_new3.copy()
            best_f = f_new3
            
    return best_x
