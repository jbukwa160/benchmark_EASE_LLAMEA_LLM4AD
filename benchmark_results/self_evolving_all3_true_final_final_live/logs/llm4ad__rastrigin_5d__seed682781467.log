def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.minimum(np.maximum(x, lb), ub)

    def adapt_crossover(pop):
        best = pop[np.argmin([func(bound(x)) for x in pop])]
        mean = np.mean(pop, axis=0)
        std = np.std(pop, axis=0)
        weights = 1 / (std + 1e-8)
        wsum = np.sum(weights)
        weights /= wsum
        return np.dot(weights, pop)

    def mutation(x):
        if rng.random() < 0.5:
            x += rng.uniform(-ub, ub) * np.ones(dim)
        else:
            x -= rng.uniform(-ub, ub) * np.ones(dim)
        return bound(x)

    pop = [rng.uniform(lb, ub) * np.ones(dim) for _ in range(budget)]
    gen = 0
    while True:
        gen += 1
        new_pop = []
        for x in pop:
            u = adapt_crossover(pop)
            v = mutation(u)
            w = bound(x + rng.uniform(-1, 1) * (v - x))
            new_pop.append(w)
        if np.min([func(bound(x)) for x in new_pop]) <= np.min([func(bound(y)) for y in pop]):
            pop = new_pop
        else:
            break
    return min(pop, key=lambda x: func(bound(x)))
