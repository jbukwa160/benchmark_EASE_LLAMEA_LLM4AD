def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    F = 0.5
    CR = 0.9
    
    # Initialize population
    x = np.random.uniform(lb, ub, (pop_size, dim))
    
    for t in range(budget):
        # Calculate fitness
        f_x = func(x)
        
        # Find the best solution so far
        best_idx = np.argmin(f_x)
        best_sol = x[best_idx]
        best_fit = f_x[best_idx]
        
        # Generate new solutions
        for i in range(pop_size):
            r1, r2, r3 = rng.choice(pop_size, 3, replace=False)
            while r1 == i or r2 == i or r3 == i:
                r1, r2, r3 = rng.choice(pop_size, 3, replace=False)
            
            u = np.random.uniform(0, 1, dim)
            v = F * (x[r2] - x[r1]) + u
            p = np.where(u < CR, v, x[i])
            
            # Clip to bounds
            p = np.clip(p, lb, ub)
            
            # Calculate fitness
            f_p = func(np.array([p]))
            
            if f_p < best_fit:
                best_fit = f_p
                best_sol = p
                
        x[:] = np.array([best_sol])
    
    return best_sol
