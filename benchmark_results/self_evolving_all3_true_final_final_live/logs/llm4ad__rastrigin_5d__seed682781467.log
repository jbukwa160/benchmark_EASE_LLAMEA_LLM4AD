def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    sigma = 0.5 * (ub - lb) / np.sqrt(2 * dim)

    for _ in range(budget):
        N = 50
        y = np.random.randn(N, dim)
        y = y / np.linalg.norm(y, axis=1, keepdims=True) * sigma + rng.uniform(lb, ub, size=(N, dim))
        y = np.clip(y, lb, ub)

        mu = np.mean(y, axis=0)
        cov = np.cov(y.T)

        w = np.diag(cov + 1e-8 * np.eye(dim)) ** (-1 / 2)
        z = rng.randn(N, dim)
        v = np.dot(z, w)  # standardize the noise

        y_new = mu + sigma * np.dot(v, np.linalg.cholesky(cov))
        y_new = np.clip(y_new, lb, ub)

        f_values = func(y_new).astype(float)
        idx = np.argsort(f_values)[:5]

        f_avg = np.mean(f_values[idx])
        cov_new = np.cov(y_new[idx].T)

        sigma *= 0.1 + (f_best - f_avg) / (budget * 10)
        if f_avg < f_best:
            x_best = y_new[idx][np.argmin(f_values[idx])]
            f_best = f_avg

    return x_best
