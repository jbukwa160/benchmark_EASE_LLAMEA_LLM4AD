def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    for t in range(budget):
        # Random sampling
        x_candidate = lb + (ub - lb) * rng.rand(dim)

        # Clip candidates to [lb, ub]
        x_candidate = np.clip(x_candidate, lb, ub)

        # Gaussian mutation
        sigma = 0.1 / (1 + t / budget)
        mu = x_best
        x_mutation = mu + sigma * rng.randn(dim)
        x_mutation = np.clip(x_mutation, lb, ub)

        # Evaluate candidate solutions
        f_candidate = func(x_candidate)
        f_mutation = func(x_mutation)

        # Update best solution
        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate

        if f_mutation < f_best:
            x_best = x_mutation
            f_best = f_mutation

    return x_best
