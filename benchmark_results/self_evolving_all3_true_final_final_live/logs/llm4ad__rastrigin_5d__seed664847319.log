def algorithm(func, dim, lb, ub, budget, rng):
    D = len(dim)
    pop_size = 50
    w = 0.7298
    c1 = c2 = 1.49417
    x = rng.uniform(lb, ub, (pop_size, D))
    p_best = np.copy(x)
    g_best = np.inf

    for t in range(budget):
        for i in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size, 3)
            while r1 == i or r2 == i or r3 == i:
                r1, r2, r3 = rng.randint(0, pop_size, 3)

            v = w * p_best[i] + c1 * rng.uniform(0, 1) * (p_best[r1] - x[i]) + \
                c2 * rng.uniform(0, 1) * (g_best - x[i])

            u = np.clip(v, lb, ub)

            f_u = func(u)
            f_xi = func(x[i])
            if f_u < f_xi:
                p_best[i] = u
                x[i] = u

        g_best = np.argmin(func(p_best))
        g_best = p_best[g_best]

    return g_best
