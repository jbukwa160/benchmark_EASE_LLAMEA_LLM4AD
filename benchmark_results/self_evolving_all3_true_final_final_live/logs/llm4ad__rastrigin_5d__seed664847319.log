def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    best_fitness = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        y = rng.uniform(lb, ub, size=dim)
        
        while np.any(np.abs(x - y) < 1e-5):
            y = rng.uniform(lb, ub, size=dim)
        
        x_best = x
        f_x_best = func(x)
        
        for _ in range(budget // dim):
            u = rng.uniform(0, 1, size=dim)
            
            v = np.clip(x + u * (y - x), lb, ub)
            f_v = func(v)
            
            if f_v < f_x_best:
                x_best = v
                f_x_best = f_v
        
        if f_x_best < best_fitness:
            best = x_best
            best_fitness = f_x_best
    
    return np.clip(best, lb, ub)
