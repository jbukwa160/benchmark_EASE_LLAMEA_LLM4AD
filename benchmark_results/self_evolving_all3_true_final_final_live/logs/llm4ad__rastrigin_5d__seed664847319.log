def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def candidate(bmu, sigma):
        x = bmu + sigma * rng.normal(size=dim)
        return clip(x)

    def update_bmu(best_so_far, new_candidate):
        if func(new_candidate) < func(best_so_far):
            return new_candidate
        else:
            return best_so_far

    bmu = np.zeros(dim)
    sigma = 1.0
    population_size = int(np.ceil(budget ** (1 / dim)))
    for _ in range(population_size):
        candidate_x = candidate(bmu, sigma)
        if func(candidate_x) < func(bmu):
            bmu = update_bmu(bmu, candidate_x)
        sigma *= 0.95
    return bmu
