def algorithm(func, dim, lb, ub, budget, rng):
    mu = int(np.sqrt(budget))
    sigma = 0.5 * (ub - lb)
    lambda_ = 1 + int(0.01 * budget)
    
    # Initialize population and covariance matrix
    x = np.random.uniform(lb, ub, size=(lambda_, dim))
    D = np.eye(dim) + np.random.normal(size=(dim, dim)) / 100
    
    # Main loop
    for t in range(budget):
        # Evaluate function values
        y = func(x)
        
        # Update covariance matrix and step-size
        s2 = (1 / lambda_) * np.sum(np.diag(D))
        D += np.outer(sigma**2 * rng.rand(dim) - sigma**2, rng.rand(dim)) / 100
        
        # Sample new population
        x_new = np.zeros((lambda_, dim))
        for i in range(lambda_):
            z = rng.multivariate_normal(np.zeros(dim), s2 * D)
            u = rng.uniform(lb, ub, size=dim)
            x_new[i] = u + sigma * (x[i] + z / (1 + t / budget))
        
        # Differential Evolution crossover
        mask = np.random.choice(lambda_, lambda_, replace=False)
        x_new[mask] = 0.5 * (x[mask] + x_new[mask])
        
        # Select new population and update covariance matrix
        x = x_new[sort_y(y)]
        D = D / (1 - 1 / lambda_)
    
    return np.array(x[sort_y(func(x))][0])
