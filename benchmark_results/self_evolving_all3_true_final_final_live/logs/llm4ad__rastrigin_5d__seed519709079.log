def algorithm(func, dim, lb, ub, budget, rng):
    def rastrigin(x):
        return func(x) + 10 * len(x)

    pop_size = 50
    D = dim
    N = int(budget / (D * pop_size))
    x_best = np.array([random.uniform(lb, ub) for _ in range(dim)])

    for i in range(N):
        population = [np.array([random.uniform(lb, ub) for _ in range(D)]) for _ in range(pop_size)]
        for j in range(20):  # 20 generations of DE
            F = 0.5 + 0.3 * np.sin(np.pi * rng.random())
            for k in range(pop_size):
                v = population[k] + F * (np.array([rng.gauss(x_best[k], 1) for x in x_best]) - population[k])
                population[k] = np.clip(v, lb, ub)
        f_x = [rastrigin(x) for x in population]
        x_idx = np.argmin(f_x)
        if rastrigin(population[x_idx]) < rastrigin(x_best):
            x_best = population[x_idx]

    return x_best
