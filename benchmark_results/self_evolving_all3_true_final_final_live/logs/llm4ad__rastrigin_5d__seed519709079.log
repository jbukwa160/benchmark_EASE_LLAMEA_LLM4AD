def algorithm(func, dim, lb, ub, budget, rng):
    def get_bounds():
        bounds = [(lb[i], ub[i]) for i in range(dim)]
        return bounds
    
    def generate_random_candidate(bounds, rng):
        candidate = [rng.uniform(bounds[i][0], bounds[i][1]) for i in range(dim)]
        return np.array(candidate)
    
    def clip_candidate(candidate, bounds):
        clipped_candidate = [min(max(x, bounds[i][0]), bounds[i][1]) for i in range(dim)]
        return np.array(clipped_candidate)
    
    def differential_evolution(bounds, budget, func):
        population_size = int(budget ** 0.5) + 1
        candidate_population = [generate_random_candidate(bounds, rng) for _ in range(population_size)]
        
        for i in range(int(0.75 * budget)):
            new_population = []
            for j in range(population_size):
                parent_indices = np.random.choice(range(population_size), size=3, replace=False)
                parent1, parent2, parent3 = candidate_population[parent_indices]
                child_candidate = parent1 + 0.5 * (parent2 - parent3)
                new_population.append(clip_candidate(child_candidate, bounds))
            candidate_population = new_population
        
        best_candidate_index = np.argmin([func(candidate) for candidate in candidate_population])
        return candidate_population[best_candidate_index]
    
    def random_search(bounds, budget, func):
        candidates = [generate_random_candidate(bounds, rng) for _ in range(int(budget ** 0.5))]
        
        for i in range(int(0.75 * budget)):
            new_candidates = [clip_candidate(generate_random_candidate(bounds, rng), bounds)]
            candidates.extend(new_candidates)
        
        best_candidate_index = np.argmin([func(candidate) for candidate in candidates])
        return candidates[best_candidate_index]
    
    def multi_start_differential_evolution(bounds, budget, func):
        best_candidate = None
        n_starts = int(budget ** 0.25) + 1
        
        for _ in range(n_starts):
            candidate = differential_evolution(bounds, int(0.75 * budget), func)
            
            if (best_candidate is None or 
                func(candidate) < func(best_candidate)):
                best_candidate = candidate
        
        return best_candidate
    
    bounds = get_bounds()
    best_candidate = multi_start_differential_evolution(bounds, budget, func)
    
    return best_candidate
