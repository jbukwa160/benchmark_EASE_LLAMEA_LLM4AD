def algorithm(func, dim, lb, ub, budget, rng):
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    T = 1.0
    cooling_rate = 0.99
    sigma = 3.0

    for i in range(budget):
        y = x_best + sigma * rng.randn(dim)
        y = np.clip(y, lb, ub)

        f_y = func(y)
        delta_f = f_y - f_best

        if delta_f < 0:
            x_best = y
            f_best = f_y

        elif rng.rand() < np.exp(-delta_f / T):
            x_best = y
            f_best = f_y

        T *= cooling_rate
        sigma *= (1 + 0.01) ** -i

    return x_best
