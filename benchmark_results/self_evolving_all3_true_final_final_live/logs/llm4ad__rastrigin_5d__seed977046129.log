def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_par = 10
    lambda_ = int(n_par * D)
    mu = lambda_ // 2
    mueff = 0.667
    c1 = 1.0
    cmu = (2 / (D + 1.3)) + 1.6 / (D + 1.3) ** 2
    cc = (4 / (D + 7.8)) ** 2
    cs = (c1 * (2 / (D + 1.3)))
    cmu_c1 = cmu * (1 - c1)
    cc_mueff = cc * mueff

    xmean = np.zeros(D)
    pc = np.random.rand(lambda_, D) * (ub - lb) + lb
    dc = np.eye(D)

    for _ in range(budget):
        y = func(pc)
        ybest = np.min(y)
        indbest = np.argmin(y)
        if ybest < func(xmean):
            xmean = pc[indbest]
        
        dc = (1 - cc) * dc + (cc / lambda_) * np.outer(pc - xmean, pc - xmean)

        chdev = 1.0
        if (lambda_ > mu):
            chdev = np.sqrt((1 / (lambda_ - mu)) + (2 / (lambda_ - mu ** 2)))

        dc = (1 - cc_mueff) * dc + (cc_mueff / lambda_) * np.outer(xmean - pc[indbest], xmean - pc[indbest])

        pc = xmean + chdev * np.dot(np.linalg.cholesky(dc), rng.randn(lambda_, D))
        
        # Clip candidates to [lb, ub]
        pc = np.clip(pc, lb, ub)

    return xmean
