def algorithm(func, dim, lb, ub, budget, rng):
    def rosenbrock(x):
        assert len(x) == 5
        return sum(100*(x[i+1]-x[i]**2)**2 + (1-x[i])**2 for i in range(dim))

    x0 = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    distribution = np.copy(x0)
    step_size = 10.0

    for _ in range(budget):
        trial = distribution + rng.normal(size=distribution.shape) * step_size
        trial = np.clip(trial, lb, ub)

        if func(trial) < func(distribution):
            distribution = trial

    return distribution
