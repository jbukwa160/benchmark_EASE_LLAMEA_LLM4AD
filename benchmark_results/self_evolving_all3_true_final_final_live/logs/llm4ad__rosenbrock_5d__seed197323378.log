def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.ceil(budget / 2))
    x0 = lb + (ub - lb) * rng.rand(pop_size, dim)
    pop = np.zeros((pop_size, dim))
    pop[:,:] = x0
    fitness = np.zeros(pop_size)
    
    for _ in range(budget):
        f_best = np.inf
        for i in range(pop_size):
            candidate = pop[i]
            for j in range(dim):
                if rng.rand() < 0.5:
                    candidate[j] += (ub - lb) * rng.randn()
                else:
                    candidate[j] -= (ub - lb) * rng.randn()
                candidate = np.clip(candidate, lb, ub)
                
            candidate_fitness = func(candidate)
            
            if candidate_fitness < f_best:
                f_best = candidate_fitness
                best_idx = i
                
            fitness[i] = candidate_fitness
            
        alpha = 0.1 / (1 + _ * 1e-5)  # adaptive learning rate
        for j in range(pop_size):
            if j != best_idx:
                pop[j] += alpha * (pop[best_idx] - pop[j]) + rng.randn() * (ub - lb)
                pop[j] = np.clip(pop[j], lb, ub)
                
        fitness[:] = func(pop)
        
    return pop[np.argmin(fitness)]
