def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = np.inf
    x = rng.uniform(lb, ub, size=dim)
    
    for _ in range(budget):
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
            
        s = 0.1 * (ub - lb)  # Exploration radius
        
        while True:
            i = rng.choice(dim, p=[abs((x[i] - lb)/(ub - lb)) for i in range(dim)])
            
            y = np.copy(x)
            y[i] += rng.uniform(-s, s)
            y = np.clip(y, lb, ub)
            
            f_new = func(y)
            
            if f_new < best_f:
                x = y
                break
            
            s *= 0.5
        
        s /= 2
    
    return best_x
