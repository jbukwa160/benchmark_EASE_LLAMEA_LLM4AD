def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    strategy = 'best/1/bin'
    F = 0.5
    CR = 0.9
    D = dim
    N = int(budget/pop_size)
    G = np.zeros((pop_size, dim))
    for i in range(pop_size):
        G[i] = rng.uniform(lb, ub, size=dim)

    best = None
    for n in range(N):
        X = G.copy()
        V = np.zeros((pop_size, D))

        for i in range(pop_size):
            if strategy == 'best/1/bin':
                V[i] = G[i] + F * (G[np.random.randint(0, pop_size)] - G[i]) + rng.uniform(-1, 1, size=D)

        for i in range(pop_size):
            trial = np.zeros(D)
            a, b, c = np.random.choice(pop_size, 3, replace=False)
            for j in range(dim):
                u, l = X[b, j], X[a, j]
                v, w = V[i, j], G[c, j]

                if rng.random() < CR or u == l:
                    trial[j] = np.round(u * w / l + (1 - u) * v / l)
                else:
                    trial[j] = X[i, j] + F * (V[i, j] - X[i, j])

                trial[j] = max(lb, min(ub, trial[j]))

            if func(trial) < func(G[i]):
                G[i] = trial
                if best is None or func(G[i]) < func(best):
                    best = G[i]

    return best
