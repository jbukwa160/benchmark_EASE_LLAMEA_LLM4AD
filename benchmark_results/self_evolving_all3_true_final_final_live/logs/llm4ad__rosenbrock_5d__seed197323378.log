def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    best_cost = func(x_best)
    
    for _ in range(budget):
        x_new = x_best + 0.1 * rng.normal(size=dim)
        cost_new = func(np.clip(x_new, lb, ub))
        
        rejection_prob = max(1 - (cost_new - best_cost) / (ub - lb), 0)
        
        if rng.uniform() > rejection_prob:
            x_best = x_new
            best_cost = cost_new
    
    return np.array([np.round(xi, 2) for xi in x_best])
