def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(np.array([x]))

    D = len(lb)
    n_params = 1 + int(budget > D**2) # add more parameters if there's not enough budget to sample the entire covariance matrix
    mean = np.ones(n_params)*0.5*(ub+lb)
    sigma = (ub-lb)/3.0

    cov = np.eye(D)*sigma**2
    p = rng.rand(n_params)

    for i in range(budget):
        candidates = np.dot(cov, p) + mean[:D]

        # clip candidates to [lb, ub]
        candidates = np.clip(candidates, lb, ub)

        f_values = f(candidates)
        best_idx = np.argmin(f_values)
        cov = 0.1*np.eye(D)*sigma**2 + 0.9*cov + (candidates[best_idx]-mean[:D])* \
              (candidates[best_idx]-mean[:D]).T/sigma**2
        sigma = np.sqrt(np.diag(cov)) * np.exp(4.8/(n_params+5))
        mean[:D] += candidates[best_idx]-mean[:D]

    return mean[:D]
