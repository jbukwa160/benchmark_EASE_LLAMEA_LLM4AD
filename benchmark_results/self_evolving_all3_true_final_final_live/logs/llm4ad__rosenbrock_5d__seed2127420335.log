def algorithm(func, dim, lb, ub, budget, rng):
    def gp_model(X_train, y_train, X_test):
        from scipy.stats import norm
        K = np.exp(-np.sum((X_train[:, None] - X_train[None, :])**2, axis=2) / (2 * 1e-8))
        lambda_ = 1e-5
        L = np.linalg.cholesky(lambda_*K + np.eye(len(K)))
        mu = K.dot(np.linalg.solve(L.T, y_train)) / lambda_
        s = np.linalg.inv(lambda_*K + L.T.dot(L)).dot(y_train)
        return mu, s

    def sample_gp(model, X_test):
        mu, s = model
        return rng.normal(mu, s)

    def clip(x):
        return np.clip(x, lb, ub)

    best_solution = None
    best_fitness = float('inf')

    for i in range(budget):
        if dim == 1:
            x_new = sample_gp(gp_model(np.array([[0], [10]]), np.array([func(np.array([0])), func(np.array([10]))])))
        else:
            X_train = np.random.uniform(lb, ub, (budget // 2, dim))
            y_train = func(X_train)
            model = gp_model(X_train, y_train, X_train)
            x_new = sample_gp(model)

        x_new = clip(x_new)
        new_fitness = func(x_new)

        if new_fitness < best_fitness:
            best_solution = x_new
            best_fitness = new_fitness

    return best_solution
