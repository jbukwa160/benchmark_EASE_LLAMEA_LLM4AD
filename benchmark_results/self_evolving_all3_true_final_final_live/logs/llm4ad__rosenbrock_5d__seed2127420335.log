def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(params, mu, sigma):
        return params + np.random.normal(0, 1, dim) * sigma + (ub - lb) / 2 * mu

    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def polynomial_mutation(x, dim, eta_mu, eta_sigma):
        new_x = x.copy()
        for i in range(dim):
            if rng.random() < 0.1:
                new_x[i] += (ub - lb) / 2 * rng.uniform(-eta_mu, eta_mu)
            if rng.random() < 0.1 and sigma > 1e-5:
                new_x[i] += np.sqrt(sigma) * rng.normal(0, 1)
        return clip(new_x, lb, ub)

    mu = np.zeros(dim)
    sigma = 10
    eta_mu = 20
    eta_sigma = 100
    x_best = -np.inf
    for _ in range(budget):
        candidate = generate_candidate(mu, rng.uniform(-1, 1), sigma)
        f_x = func(candidate)
        if f_x < x_best:
            x_best = f_x
            mu = candidate.copy()
        if rng.random() < 0.5:
            new_mu = polynomial_mutation(mu, dim, eta_mu, eta_sigma)
            f_new_mu = func(new_mu)
            if f_new_mu < x_best:
                x_best = f_new_mu
                mu = new_mu.copy()
        sigma *= np.exp(-x_best / (2 * rng.uniform(0.5, 1)))
    return clip(mu, lb, ub)
