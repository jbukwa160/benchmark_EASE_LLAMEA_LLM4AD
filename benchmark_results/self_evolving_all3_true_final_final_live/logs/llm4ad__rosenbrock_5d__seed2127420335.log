def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 5.0
    alpha = 1e-4
    T = 100.0
    x = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(budget):
        if rng.rand() < 0.2:
            # Gradient Descent step
            dx = -alpha * np.gradient(func, x)
            x += sigma * dx
            
        else:
            # Simulated Annealing step
            noise = rng.normal(size=dim) * 1e-3
            x += sigma * noise
            
            if func(x) < best_f:
                best_x = x.copy()
                best_f = func(x)
                
            elif rng.rand() < np.exp((best_f - func(x)) / T):
                best_x = x.copy()
                best_f = func(x)
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
        
    return best_x
