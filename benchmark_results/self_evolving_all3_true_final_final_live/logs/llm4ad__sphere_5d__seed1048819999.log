def algorithm(func, dim, lb, ub, budget, rng):
    def step_size_generator(budget, n_steps):
        yield 1
        for _ in range(n_steps - 1):
            yield max(0.8 * (yield), 0.01)

    step_size = next(step_size_generator(budget, budget))
    distribution = np.zeros(dim)
    best_solution = np.zeros(dim)

    for i in range(budget):
        new_distribution = distribution + rng.normal(scale=step_size, size=dim)
        clipped_new_distribution = np.clip(new_distribution, lb, ub)
        new_solution = func(clipped_new_distribution)
        if new_solution < func(best_solution):
            best_solution = clipped_new_distribution
            step_size = 0.9 * (1 - 10 ** (-i / budget)) * step_size
        distribution = distribution + rng.normal(scale=step_size, size=dim)

    return np.array([best_solution])
