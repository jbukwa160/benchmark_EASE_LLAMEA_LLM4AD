def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    y_best = func(clip(x))
    
    for _ in range(budget):
        # Generate new points by perturbing the current point
        delta = 0.1 * rng.normal(size=dim)
        x_new = clip(x + delta)
        
        # Evaluate new point and update best if necessary
        y_new = func(clip(x_new))
        if y_new < y_best:
            y_best = y_new
            x_best = x_new
            
        # Adaptive shrinkage to escape local minima
        if rng.random() < 0.1:
            shrink_factor = 2 - (budget - _)/budget
            x = clip(x_best + (x - x_best) * shrink_factor)
    
    return x_best
