def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    y_best = func(x_best)

    for _ in range(budget):
        delta = rng.normal(size=(dim,))
        z = x_best + 0.5 * delta
        z = np.clip(z, lb, ub)
        
        y = func(z)
        if y < y_best:
            x_best = z
            y_best = y
    
    return x_best
