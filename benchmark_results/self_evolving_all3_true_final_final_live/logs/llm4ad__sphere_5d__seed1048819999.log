def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = np.zeros(dim)
    min_val = float('inf')
    T = 1.0
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        val = func(x)
        
        if val < min_val:
            min_val = val
            best_sol = x
        
        if np.random.rand() < np.exp((min_val - val) / T):
            T *= 0.99  # cooling rate
            
    return best_sol
