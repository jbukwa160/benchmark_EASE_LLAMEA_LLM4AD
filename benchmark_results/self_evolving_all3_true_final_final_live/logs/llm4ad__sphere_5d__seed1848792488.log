def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, (1, dim))
    f_best = func(x_best)
    step_size = 5.0
    for i in range(budget):
        while True:
            x_new = x_best + np.random.uniform(-step_size, step_size, (1, dim))
            for j in range(dim):
                if rng.rand() < 0.2 or x_new[0, j] > ub:
                    x_new[0, j] = min(ub, x_new[0, j])
                elif x_new[0, j] < lb:
                    x_new[0, j] = max(lb, x_new[0, j])
            f_new = func(x_new)
            if f_new < f_best or rng.rand() < 0.1:
                x_best = x_new
                f_best = f_new
                step_size *= 0.5
            else:
                break
    return x_best
