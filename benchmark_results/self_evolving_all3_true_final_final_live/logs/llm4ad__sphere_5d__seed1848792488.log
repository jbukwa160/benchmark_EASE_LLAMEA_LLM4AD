def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(clip(x_best))
    
    for _ in range(budget - 1):
        s = 0.5 * (ub - lb) / np.sqrt(_ + 1)
        x_candidate = clip(rng.uniform(lb, ub, size=dim) + s * rng.randn(dim))
        
        f_candidate = func(clip(x_candidate))
        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate
    
    return x_best
