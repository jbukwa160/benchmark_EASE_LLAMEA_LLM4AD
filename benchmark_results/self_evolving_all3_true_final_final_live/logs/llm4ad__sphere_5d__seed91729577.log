def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    x = 5 * (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    current_temperature = 1.0

    for _ in range(budget):
        new_x = clip(x + 2 * (ub - lb) * rng.randn(dim))
        
        if func(new_x) < func(best_x):
            best_x = new_x
            
        delta = func(new_x) - func(best_x)
        if delta <= 0 or np.random.rand() * np.exp(-delta / current_temperature) > rng.rand():
            x = new_x

        current_temperature *= 0.99
        
    return best_x
