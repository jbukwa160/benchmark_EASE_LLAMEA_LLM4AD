def algorithm(func, dim, lb, ub, budget, rng):
    x = [np.random.uniform(lb, ub) for _ in range(dim)]
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        learning_rate = 1.0 / (2 + np.sqrt(_ * rng))

        for i in range(dim):
            alpha = np.random.uniform(-1, 1)
            xi_new = x[i] + learning_rate * alpha
            xi_new = max(lb, min(ub, xi_new))  # clip to bounds

            x_new = x.copy()
            x_new[i] = xi_new

            f_new = func(x_new)

            if f_new < best_f:
                best_x = x_new.copy()
                best_f = f_new

        x = best_x.copy()

    return np.array(best_x)
