def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    best_obj = 0.0
    T_init = 1.0
    alpha = 0.99
    sigma = 5.0
    
    for i in range(budget):
        if i == 0:
            x_candidate = np.random.uniform(lb, ub, dim)
        else:
            x_candidate = np.clip(x_best + np.random.normal(0, sigma/(i+1), dim), lb, ub)
        
        candidate_obj = func(x_candidate)
        
        if candidate_obj < best_obj or i == 0:
            x_best = x_candidate
            best_obj = candidate_obj
        
        T = T_init * (1 - alpha)**i
        sigma *= np.exp(-T)
    
    return x_best
