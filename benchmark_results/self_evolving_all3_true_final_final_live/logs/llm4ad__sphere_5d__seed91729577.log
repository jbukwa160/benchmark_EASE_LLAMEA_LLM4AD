def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    cma_mean = x.copy()
    sigma = 0.5
    C = np.eye(dim) * sigma**2

    for _ in range(budget):
        x_new = clip(cma_mean + rng.normal(size=(1, dim)) @ np.sqrt(C))
        f_new = func(x_new)

        if f_new < func(clip(cma_mean)):
            cma_mean = x_new
            C += (x_new - cma_mean)[:, None] * (x_new - cma_mean)[None, :]
            sigma *= 0.1

    return clip(cma_mean)
