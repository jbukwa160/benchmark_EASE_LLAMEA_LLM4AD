def algorithm(func, dim, lb, ub, budget, rng):
    candidates = np.zeros((budget, dim))
    for i in range(budget):
        dist = max(np.abs(ub - lb), 1e-6) * (rng.rand() + 0.5)
        center = rng.uniform(lb, ub, size=dim)
        candidate = center + dist * (2 * rng.rand(dim) - 1)
        candidates[i] = np.clip(candidate, lb, ub)
    return func(candidates[np.argmin([func(x) for x in candidates])])
