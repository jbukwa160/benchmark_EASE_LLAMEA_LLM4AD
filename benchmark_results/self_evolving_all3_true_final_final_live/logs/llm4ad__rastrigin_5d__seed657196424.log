def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    pop_size = 50
    population = np.random.uniform(lb, ub, (pop_size, dim))
    best_x = population[np.argmin([f(x) for x in population])]

    learning_rate = 0.1
    mutation_factor = 0.5

    for i in range(budget):
        candidates = []
        for _ in range(pop_size):
            while True:
                trial_x = best_x + learning_rate * (population[np.random.choice(range(pop_size))] - best_x) \
                           + mutation_factor * rng.uniform(-ub, ub, dim)
                trial_x = np.clip(trial_x, lb, ub)
                if f(trial_x) < f(best_x):
                    candidates.append(trial_x)
                    break
                else:
                    learning_rate *= 0.9
        population = np.array(candidates)

        max_trials = 10
        for _ in range(max_trials):
            best_trial_idx = np.argmin([f(x) for x in population])
            if f(population[best_trial_idx]) < f(best_x):
                best_x = population[best_trial_idx]

    return best_x
