def algorithm(func, dim, lb, ub, budget, rng):
    def get_init_pop(size, dim):
        return rng.uniform(lb, ub, (size, dim))

    def evaluate_individual(x):
        return func(x)

    def clip_candidate(candidate, lower, upper):
        clipped = np.clip(candidate, lower, upper)
        return clipped if not np.any(np.isclose(clipped, lower)) and not np.any(np.isclose(clipped, upper)) else np.zeros(dim)

    def crossover(parent1, parent2, rng):
        children = []
        for _ in range(budget // 10):
            idx = [rng.randint(0, dim) for _ in range(dim)]
            child = parent1[idx]
            child += (parent2[idx] - parent1[idx]) * rng.uniform(0.5, 1.5)
            children.append(child)
        return np.array(children)

    def simulated_annealing(population):
        temperature = 10
        best_solution = np.inf
        current_solution = population[0]
        for i in range(budget):
            if rng.random() < 0.1:
                new_population = [clip_candidate(current_solution + rng.uniform(-ub, ub, dim), lb, ub) for _ in range(len(population))]
            else:
                children = crossover(current_solution, population[rng.randint(0, len(population))], rng)
                new_population = [clip_candidate(c, lb, ub) for c in np.concatenate((children, [current_solution]))]
            temperature *= 0.99
            best_in_new_pop = min(new_population, key=evaluate_individual)
            if evaluate_individual(best_in_new_pop) < evaluate_individual(current_solution):
                current_solution = best_in_new_pop
            if evaluate_individual(current_solution) < best_solution:
                best_solution = evaluate_individual(current_solution)
        return current_solution

    population_size = 50
    initial_population = get_init_pop(population_size, dim)

    for _ in range(10):
        solution = simulated_annealing(initial_population)
        yield solution
