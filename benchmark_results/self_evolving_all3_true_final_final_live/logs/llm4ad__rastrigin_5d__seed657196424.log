def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.minimum(np.maximum(x, lb), ub)

    def crossover(x1, x2, v):
        u = np.zeros_like(x1)
        for i in range(dim):
            if rng.random() < 0.5:
                u[i] = 0.5 * (x1[i] + bound(v[i]))
            else:
                u[i] = 0.5 * (bound(x2[i]) + v[i])
        return u

    def differential_evolution(func, lb, ub, budget):
        pop_size = 50
        pop = rng.uniform(lb, ub, size=(pop_size, dim))
        for _ in range(budget):
            fit = np.array([func(bound(x)) for x in pop])
            idx = np.argsort(fit)[:1]
            best_x = bound(pop[idx[0]])
            candidates = pop.copy()
            for i in range(pop_size):
                v = rng.uniform(lb, ub, size=dim)
                x1, x2 = candidates[i], candidates[(i + 1) % pop_size]
                child = crossover(x1, x2, v)
                if func(bound(child)) < fit[idx[0]]:
                    candidates[i] = child
            pop = candidates.copy()
        return best_x

    return differential_evolution(func, lb, ub, budget)
