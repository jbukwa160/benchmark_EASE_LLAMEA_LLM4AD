    def obj(x):
        return func(x)

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = obj(x_best)

    for i in range(budget):
        gp = BayesianGP(dim)
        gp.fit(rng.uniform(lb, ub, size=(100, dim)), [obj(x) for x in np.array([rng.uniform(lb, ub, size=dim) for _ in range(100)])])

        x_next = gp.predict(f_best)

        if obj(x_next) < f_best:
            f_best = obj(x_next)
            x_best = x_next

    return x_best
