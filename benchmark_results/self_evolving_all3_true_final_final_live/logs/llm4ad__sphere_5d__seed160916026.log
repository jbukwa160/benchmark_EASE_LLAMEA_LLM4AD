def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    x0 = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    sigma = 10.0
    c1 = 2.0
    lambda_ = 32

    best_x = x0.copy()
    best_f = func(clip(x0))

    for _ in range(budget):
        x = clip(best_x + rng.normal(size=dim, loc=0, scale=sigma))
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x

        sigma *= np.exp(c1 * (best_f - f) / lambda_)
        x_new = clip(best_x + rng.normal(size=dim, loc=0, scale=sigma))
        f_new = func(x_new)

        if f_new < best_f:
            best_f = f_new
            best_x = x_new

    return best_x
