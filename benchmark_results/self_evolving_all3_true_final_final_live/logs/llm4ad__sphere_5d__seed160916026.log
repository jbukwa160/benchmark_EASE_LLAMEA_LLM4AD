def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.uniform(size=dim) + lb
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        new_x = x + 0.1 * (ub - lb) * rng.uniform(size=dim)
        new_x = np.clip(new_x, lb, ub)
        
        new_f = func(new_x)
        
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f
            
        x = new_x.copy() if new_f < func(x) else x
    
    return best_x
