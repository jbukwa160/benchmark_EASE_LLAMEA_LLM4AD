def algorithm(func, dim, lb, ub, budget, rng):
    best = None
    for _ in range(budget):
        if best is not None:
            candidate = best + (ub - lb) * (rng.rand(dim) - 0.5)
        else:
            candidate = (ub - lb) * rng.rand(dim) + lb
        
        candidate = np.clip(candidate, lb, ub)
        
        fitness = func(candidate)
        if best is None or fitness < func(best):
            best = candidate
    
    return best
