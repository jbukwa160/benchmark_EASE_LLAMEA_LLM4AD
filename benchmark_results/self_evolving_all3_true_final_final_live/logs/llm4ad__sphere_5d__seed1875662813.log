def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = (ub - lb) * rng.rand(dim) + lb
    T = 1000
    alpha = 0.99
    best_x = x.copy()
    best_f = func(x)
    for _ in range(budget):
        n = clip(x + (ub - lb) * rng.randn(dim))
        f_n = func(n)
        if f_n < best_f:
            best_f = f_n
            best_x = n.copy()
        delta_f = best_f - f_n
        if np.exp(-delta_f / T) > rng.rand():
            x = n.copy()
        T *= alpha
    return best_x
