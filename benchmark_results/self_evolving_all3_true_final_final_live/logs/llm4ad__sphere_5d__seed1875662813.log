def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = np.copy(x)
    best_f = func(x)

    for _ in range(budget):
        i = rng.randint(0, dim)
        alpha = 1.5 * (ub - lb) / (np.sqrt(np.log(_ + 1)))
        x[i] += alpha * np.sign(rng.uniform(-1, 1))
        x[i] = np.clip(x[i], lb, ub)

        f = func(x)

        if f < best_f:
            best_x = np.copy(x)
            best_f = f

    return best_x
