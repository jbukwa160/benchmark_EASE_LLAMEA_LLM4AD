def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    for _ in range(budget):
        i = rng.choice(dim)
        dx = rng.uniform(-1, 1)
        new_x = x.copy()
        new_x[i] += dx
        new_x = np.clip(new_x, lb, ub)
        if func(new_x) < func(x):
            x = new_x
    return x
