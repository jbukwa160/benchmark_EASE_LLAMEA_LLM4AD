def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    N = int(budget / (D + 1))  # number of new points to be generated at each iteration
    
    x_best = np.random.uniform(lb, ub, size=(1, D))
    
    for i in range(1, budget + 1):
        if i < N:
            y_new = rng.normal(loc=0.5 * (x_best[0] + np.ones((1, D)) * lb), scale=ub - lb)
            x_new = np.clip(y_new, lb, ub).reshape(-1, D)  # clip to [lb, ub]
        else:
            break
        
        f_x_new = func(x_new)
        
        if f_x_new < func(x_best):
            x_best = x_new
        
    return x_best
