    T_max = 10 * (ub - lb)**2
    T_min = 0.01 * (ub - lb)**2

    for _ in range(budget):
        T = max(T_min, T_max * rng.uniform())
        x_new = clip(x_best + rng.normal(0, (ub - lb)/3, size=dim))
        f_new = func(x_new)
        
        if f_new < f_best:
            f_best = f_new
            x_best = x_new

