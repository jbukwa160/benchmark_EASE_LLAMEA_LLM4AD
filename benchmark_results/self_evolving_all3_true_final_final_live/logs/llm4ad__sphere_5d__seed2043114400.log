def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    T = 1e5
    alpha = 0.99
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        i = np.random.randint(0, dim)
        delta_x = (ub - lb) * rng.randn() + lb

        # Clip to bounds
        new_x_i = x[i] + delta_x
        new_x_i = np.clip(new_x_i, lb, ub)

        # Simulated Annealing step
        new_x = x.copy()
        new_x[i] = new_x_i
        f_new = func(new_x)
        if f_new < best_f:
            best_f = f_new
            best_x = new_x

        # Coordinate Descent step with exponential cooling schedule
        delta = new_x_i - x[i]
        exp_term = np.exp(-(f_new - best_f) / T)
        if rng.rand() < exp_term or (f_new <= best_f and rng.rand() < 0.5):
            x[i] = new_x_i

        # Update temperature
        T *= alpha

    return best_x
