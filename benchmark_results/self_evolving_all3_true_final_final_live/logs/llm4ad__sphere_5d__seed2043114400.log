def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = np.random.uniform(lb, ub, size=dim)
    best_val = func(best_sol)

    for i in range(budget):
        new_sol = best_sol + rng.normal(loc=0, scale=1.0, size=dim)
        new_sol = np.clip(new_sol, lb, ub)
        
        new_val = func(new_sol)
        
        if new_val < best_val:
            best_sol = new_sol
            best_val = new_val
    
    return best_sol
