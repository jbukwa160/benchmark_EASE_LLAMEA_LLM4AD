def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    current = rng.uniform(-5.0, 5.0, size=dim)
    best = current.copy()
    temperature = 1.0
    cooling_rate = 0.99

    for _ in range(budget):
        candidate = current + rng.normal(size=dim) * 1e-2
        candidate = clip(candidate)

        delta = func(candidate) - func(current)
        if delta < 0:
            current = candidate
            if func(candidate) < func(best):
                best = candidate
        elif np.random.rand() < np.exp(-delta / temperature):
            current = candidate

        temperature *= cooling_rate

    return best
