        return func(x)

    bounds = [(lb[i], ub[i]) for i in range(dim)]
    result = differential_evolution(wrapper, bounds, x0=rng.rand(dim), maxiter=budget)
    best_candidate = np.clip(result.x, lb, ub)
    return best_candidate
