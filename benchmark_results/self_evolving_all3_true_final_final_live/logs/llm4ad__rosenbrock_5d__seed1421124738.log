def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = f(x_best)

    n_iter = 0
    while n_iter < budget:
        sigma = 1.0
        mu = np.zeros(dim)

        for _ in range(budget - n_iter):
            z = rng.normal(size=(dim,))
            x_cand = mu + sigma * z

            # Clip candidates to [lb, ub]
            x_cand = np.clip(x_cand, lb, ub)

            f_cand = f(x_cand)
            if f_cand < f_best:
                x_best = x_cand
                f_best = f_cand

            z = rng.normal(size=(dim,))
            mu += 0.1 * (x_cand - mu) + sigma**2 * z

        n_iter += 1

    return x_best
