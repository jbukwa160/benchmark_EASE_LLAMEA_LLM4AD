def algorithm(func, dim, lb, ub, budget, rng):
    n = len(dim)
    sigma = 0.1
    mu = (np.array(lb) + np.array(ub)) / 2
    cov = np.eye(n)
    best_sol = None
    best_f = float('inf')
    
    for _ in range(budget):
        z = rng.randn(n)
        x = mu + sigma * np.dot(np.linalg.cholesky(cov), z)
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_sol = x
        
        # Update covariance matrix
        z = (x - mu) / sigma
        s = 1 + np.dot(z.T, np.dot(cov, z))
        cov *= (s - n) * rng.rand(n, n).T + n * rng.randn(n, n)
    
    return best_sol
