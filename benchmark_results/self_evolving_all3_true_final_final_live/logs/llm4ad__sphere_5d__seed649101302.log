def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    best_val = float('inf')
    for _ in range(budget):
        # Adaptively adjust learning rate
        if np.random.rand() < 0.1:
            lr = 2.5 / (_ + 1)**(1/3) * (ub - lb) / rng
        else:
            lr = (ub - lb) / rng
        
        candidate = best + np.random.normal(scale=lr, size=(dim,))
        # Clip candidate to [lb, ub]
        candidate = np.clip(candidate, a_min=lb, a_max=ub)
        
        val = func(candidate)
        if val < best_val:
            best_val = val
            best = candidate
    return best
