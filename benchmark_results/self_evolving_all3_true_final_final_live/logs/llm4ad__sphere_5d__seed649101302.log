def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget - 1):
        x_new = x_best.copy()
        for i in range(dim):
            delta = rng.uniform(-5.0, 5.0)
            x_new[i] += delta
            if lb <= x_new[i] <= ub:
                x_new[i] = np.clip(x_new[i], lb, ub)

        f_new = func(np.clip(x_new, lb, ub))

        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return np.array([np.round(x, 3) for x in x_best])
