def algorithm(func, dim, lb, ub, budget, rng):
    x = 2 * rng.rand(dim) - 1
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        if rng.rand() < 0.5:
            # Gradient-based search
            grad = np.zeros(dim)
            eps = 1e-4
            for i in range(dim):
                new_x = x.copy()
                new_x[i] += eps
                new_f = func(new_x)
                grad[i] = (new_f - best_f) / eps
                new_x[i] -= 2 * eps
                new_x[i] += eps
                new_f = func(new_x)
                grad[i] -= (new_f - best_f) / eps
                x[i] += rng.normal(0, 0.1)
                if func(x) < best_f:
                    best_f = func(x)
                    best_x = x.copy()
            x = np.clip(x, lb, ub)

        else:
            # Grid search with random step sizes
            for i in range(dim):
                s = rng.uniform(0.01, 1.0)
                x[i] += s * rng.choice([-1, 1])
                if func(np.clip(x, lb, ub)) < best_f:
                    best_f = func(np.clip(x, lb, ub))
                    best_x = np.clip(x, lb, ub).copy()

    return best_x
