def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    cov_init = 1e-3 * np.eye(dim)
    N = int(budget / (2 * dim))
    
    for _ in range(N):
        # Sample from multivariate normal distribution
        x_new = rng.multivariate_normal(x_best, cov_init)
        
        # Clip candidates to bounds
        x_new = np.clip(x_new, lb, ub)
        
        # Evaluate function at new sample
        f_new = func(x_new)
        
        # Update best solution if necessary
        if f_new < func(x_best):
            x_best = x_new
            
    return x_best
