def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget - 1):
        new_x = x + (ub - lb) * rng.uniform(-1, 1, size=dim)
        new_x = np.clip(new_x, lb, ub)
        
        if func(new_x) < best_f:
            best_x = new_x.copy()
            best_f = func(new_x)
            
        x = best_x.copy() + (ub - lb) * rng.uniform(-1, 1, size=dim)
        x = np.clip(x, lb, ub)
        
    return best_x
