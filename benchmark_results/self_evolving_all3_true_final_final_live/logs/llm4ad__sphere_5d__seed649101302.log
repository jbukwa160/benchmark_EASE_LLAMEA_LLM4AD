def algorithm(func, dim, lb, ub, budget, rng):
    x = np.full(dim, 0)
    best_x = x.copy()
    
    for _ in range(budget):
        i = rng.randint(0, dim)
        if x[i] < (lb + ub) / 2:
            x[i] += (ub - lb) * rng.uniform(0, 1)
        else:
            x[i] -= (ub - lb) * rng.uniform(0, 1)
        
        # Clip to bounds
        x = np.clip(x, lb, ub)
        
        # Check if new solution is better
        f_x = func(x)
        f_best_x = func(best_x)
        
        if f_x < f_best_x:
            best_x = x.copy()
    
    return best_x
