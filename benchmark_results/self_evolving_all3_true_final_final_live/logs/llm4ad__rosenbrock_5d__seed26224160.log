def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = x + rng.normal(size=dim) * 0.01
        y = np.clip(y, lb, ub)
        fy = func(y)

        if fy < best_f:
            best_f = fy
            best_x = y

        # Adaptive mutation
        if budget - _ <= 100:
            step_size = 1e-3 * (ub - lb) / np.sqrt(budget - _)
            for i in range(dim):
                if rng.uniform() < 0.05:
                    delta = rng.normal(size=1) * step_size * (ub - lb)
                    y[i] = best_x[i] + delta
                    y[i] = np.clip(y[i], lb, ub)

        x = y

    return best_x
