def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(n, dim, lb, ub):
        return np.random.uniform(lb, ub, (n, dim))

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def objective(x):
        return func(x)

    n = 20
    population_size = 100

    initial_population = generate_initial_population(n, dim, lb, ub)
    current_best = np.inf
    best_solution = None

    for i in range(budget):
        # CMA-ES step
        sigma = 1.0 + rng.uniform(-1e-2, 1e-2)
        offspring = initial_population + sigma * rng.normal(size=(population_size, dim))
        clipped_offspring = clip(offspring, lb, ub)

        fitnesses = [objective(x) for x in clipped_offspring]
        indices = np.argsort(fitnesses)[:n]

        new_initial_population = clipped_offspring[indices]

        # SA step
        temperature = 1.0 / (i + 1)
        current_best_candidate = new_initial_population[np.argmin(fitnesses)]

        if objective(current_best_candidate) < current_best:
            current_best = objective(current_best_candidate)
            best_solution = current_best_candidate

    return best_solution
