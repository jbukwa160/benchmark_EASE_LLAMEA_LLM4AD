def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    F = 1.0
    CR = 0.9
    max_iter = int(budget / (pop_size * dim))
    x_best = np.random.uniform(lb, ub, size=(pop_size, dim))
    f_best = np.array([func(x) for x in x_best])

    for i in range(max_iter):
        y = np.zeros((pop_size, dim))
        for j in range(pop_size):
            u, v, w = rng.choice(range(pop_size), 3, replace=False)
            if rng.random() < CR or func(x_best[u]) >= f_best[j]:
                y[j] = x_best[u] + F * (x_best[v] - x_best[w])
        for j in range(pop_size):
            y[j] = np.clip(y[j], lb, ub)
            fj = func(y[j])
            if fj < f_best[j]:
                f_best[j] = fj
                x_best[j] = y[j]
        best_x = x_best[np.argmin(f_best)]
        if func(best_x) == 0:
            break

    return np.clip(best_x, lb, ub)
