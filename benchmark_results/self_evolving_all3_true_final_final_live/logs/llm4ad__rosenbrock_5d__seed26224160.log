def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, a_min=lb, a_max=ub)

    n = 10
    lambda_ = 100
    mu = 1
    sigma = 0.1
    best_x = None
    best_f = float('inf')

    for _ in range(budget):
        x = rng.normal(size=(lambda_, dim))
        f = func(bound(x))

        # update best solution found so far
        idx = np.argsort(f)[:mu]
        new_best_f = np.sort(f[idx])
        if new_best_f[0] < best_f:
            best_x = bound(x[idx][0])
            best_f = new_best_f[0]

        # global step
        x = x + sigma * rng.normal(size=(lambda_, dim))
        f = func(bound(x))

        # update best solution found so far
        idx = np.argsort(f)[:mu]
        new_best_f = np.sort(f[idx])
        if new_best_f[0] < best_f:
            best_x = bound(x[idx][0])
            best_f = new_best_f[0]

    return best_x
