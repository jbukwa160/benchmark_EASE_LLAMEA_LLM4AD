def algorithm(func, dim, lb, ub, budget, rng):
    def mutation(x):
        delta = 0.1 * rng.uniform(-1, 1)
        return x + delta

    D = dim
    pop_size = int(np.sqrt(budget))
    w = 0.7298
    c1 = 2.05
    c2 = 2.05
    pbest = np.zeros((pop_size, D))
    gbest = np.zeros(D)
    fgbest = float('inf')
    x = rng.uniform(lb, ub, (pop_size, D))

    for _ in range(budget):
        fitness = func(x)
        for i in range(pop_size):
            pbest[i] = mutation(x[i])
            pf = func(pbest[i])
            if pf < fitness:
                x[i] = pbest[i]
            elif np.random.rand() < 0.1: # SA-inspired mutation
                xp = mutation(x[i])
                if func(xp) < fitness:
                    x[i] = xp

        gbest = np.mean(pbest, axis=0)
        fgbest = func(gbest)
        if fgbest < fgbest:
            gbest[:] = gbest.copy()
            fgbest = fgbest
        for i in range(pop_size):
            v = w * (gbest - x[i]) + c1 * rng.uniform(0, 1) * (pbest[i] - x[i]) + c2 * rng.uniform(0, 1) * gbest

            lbv = np.minimum(v, ub)
            ubv = np.maximum(v, lb)
            x[i] = lbv + rng.uniform(0, 1) * (ubv - lbv)

    return gbest
