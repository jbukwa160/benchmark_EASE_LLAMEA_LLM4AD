def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    x = rng.uniform(lb, ub, size=dim)
    pop_size = 10 * dim
    mu = 0.01
    sigma = 2.1
    c1 = 0.5
    c2 = 0.5

    for _ in range(budget):
        x_copy = np.array(x)

        # Generate a population of new candidates using CMA-ES with custom mutation distribution
        candidates = rng.randn(pop_size, dim)
        candidates = clip(candidates)

        for i in range(pop_size):
            candidates[i] += c1 * (candidates[i] - mu) + sigma * np.sqrt(2) * rng.normal(size=dim)

        # Evaluate the function at new candidates and select the best one
        scores = [func(candidate) for candidate in candidates]
        idx = np.argmin(scores)
        if scores[idx] < func(x):
            x = candidates[idx]

    return x
