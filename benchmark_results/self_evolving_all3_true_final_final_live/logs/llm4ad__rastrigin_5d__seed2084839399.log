def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    N = 50  # population size
    F = 1.0  # mutation factor
    CR = 0.9  # crossover probability
    best = None

    for t in range(budget):
        X = np.random.uniform(lb, ub, (N, D))
        if best is None:
            best = X[np.argmin([func(x) for x in X])]
        else:
            fit = np.array([func(x) for x in X])
            pidx = rng.choice(N, size=N, replace=False)
            mutant = X[pidx] + F * (X[rng.choice(N, size=D, replace=True)] - best)
            crossover = np.zeros((N, D))
            for i in range(D):
                if rng.random() < CR or mutant[rng.choice(N), i] == best[i]:
                    crossover[rng.choice(N), i] = mutant[rng.choice(N), i]
                else:
                    crossover[rng.choice(N), i] = X[rng.choice(N), i]
            new_X = np.clip(crossover, lb, ub)
            fit_new = np.array([func(x) for x in new_X])
            idx = np.argsort(fit_new)[:N//2]
            X[idx] = new_X[idx]

        best_idx = np.argmin([func(x) for x in X])
        if func(X[best_idx]) < func(best):
            best = X[best_idx]

    return best
