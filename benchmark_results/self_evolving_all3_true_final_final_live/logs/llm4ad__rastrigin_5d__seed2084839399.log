def algorithm(func, dim, lb, ub, budget, rng):
    def func_eval(x):
        x = np.clip(x, lb, ub)
        return func(x)

    def mutate(pop):
        mu, sigma = pop['mean'], pop['sigma']
        z = rng.normal(size=(pop['n_offspring'], dim))
        y = mu + sigma * z
        return {'y': y}

    pop = {'mean': np.zeros(dim), 'cov': np.eye(dim), 'fval': np.inf, 'n_evals': 0, 'n_offspring': 10}
    pop['sigma'] = 1.0

    for _ in range(budget):
        offspring = mutate(pop)
        fvals = [func_eval(offspring['y'][i]) for i in range(pop['n_offspring'])]
        pop['fval'] = np.min(fvals)
        pop['n_evals'] += pop['n_offspring']

        if pop['fval'] < pop['mean'].dot(pop['cov']).dot(pop['mean']):
            pop['mean'] = offspring['y'][np.argmin(fvals)]
