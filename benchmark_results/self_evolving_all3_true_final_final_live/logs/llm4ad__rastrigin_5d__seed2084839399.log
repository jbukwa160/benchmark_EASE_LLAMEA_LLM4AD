def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    
    # Initialize the mean vector and covariance matrix for CMA-ES
    mu = np.random.uniform(lb, ub, (pop_size, dim))
    sigma = 1.0
    D = np.eye(dim)
    
    # Evolution loop
    for _ in range(budget):
        # Evaluate the function at current population
        f_val = func(mu)
        
        # Update the covariance matrix using CMA-ES update rule
        D = (1 - 1 / (len(mu) + 3)) * D + 1 / (len(mu) + 3) * np.eye(dim)
        for i in range(len(mu)):
            if rng.random() < 0.5:
                mu[i] += sigma * np.sqrt(D[i, :]) * rng.normal(size=dim)
        
        # Clip the candidates to the bounds
        mu = np.clip(mu, lb, ub)
        
    # Return the best solution found
    return np.argmin(func(mu))
