def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    max_iter = budget // pop_size
    D = dim
    F = 0.5
    CR = 0.9
    
    def generate_candidate(x_i, i, j, k):
        y_i = x_i.copy()
        tmp = rng.uniform(-1, 1)
        for d in range(D):
            if rng.rand() < CR or d == k:
                y_i[d] += F * (x[j, d] - x[i, d])
        return np.clip(y_i, lb, ub)
    
    best = None
    for i in range(max_iter):
        x = rng.uniform(lb, ub, (pop_size, D))
        
        for j in range(pop_size):
            y_j = generate_candidate(x[j], 0, j, rng.randint(D))
            score_j = func(y_j)
            
            for k in range(pop_size - 1):
                y_k = generate_candidate(x[k], j, k, (k + 1) % D)
                score_k = func(y_k)
                
                if score_k < score_j:
                    x[j] = y_k
                    score_j = score_k
                    
            if score_j < func(x[0]):
                x[0] = y_j
                
        best_candidate = np.argmin([func(xi) for xi in x])
        candidate = np.clip(x[best_candidate], lb, ub)
        
        if best is None or func(candidate) < func(best):
            best = candidate
    
    return best
