def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    current = func(x)
    best = current
    temperature = 1.0
    step_size = 1e-6 * (ub - lb) / 2

    for _ in range(budget):
        new_x = x + rng.normal(0, step_size, size=dim)
        new_x = np.clip(new_x, lb, ub)

        delta = func(new_x) - current
        if delta < 0 or (delta >= 0 and np.random.rand() < np.exp(-delta / temperature)):
            x = new_x
            current = func(x)
            best = min(best, current)
        else:
            temperature *= 0.99999

    return x
