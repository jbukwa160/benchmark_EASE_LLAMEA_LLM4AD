def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    
    # Gaussian Process parameters
    sigma_f = 1.0
    length_scale = 1.0
    
    # Kernel function
    def kernel(x, y):
        sqdist = np.sum((x[:, None] - y[None, :])**2, axis=2) / (length_scale**2)
        return sigma_f**2 * np.exp(-sqdist) + 1e-8 * np.eye(len(y))
    
    # Acquisition function
    def acquisition(x):
        mu, _ = gp.predict(np.atleast_2d(x), full_cov=False)
        return -mu
    
    # Gaussian Process model
    gp = None
    
    for i in range(budget):
        if gp is None:
            X = np.atleast_2d(x)
            Y = func(x)
            K = kernel(X, X)
            alpha = np.linalg.solve(K, Y)
            gp = {'X': X, 'Y': Y, 'K': K, 'alpha': alpha}
        
        # Sample from the acquisition function
        x_next = rng.uniform(lb, ub, dim)
        
        # Predictive mean and variance
        mu, sigma2 = gp.predict(np.atleast_2d(x_next), full_cov=False)
        
        # Acquisition value
        a = acquisition(x_next)
        
        if a > np.max(acquisition(gp['X'])):
            x = x_next
            
    return x
