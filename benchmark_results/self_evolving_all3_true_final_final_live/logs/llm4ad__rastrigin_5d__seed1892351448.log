def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    x = (ub - lb) * rng.rand(dim) + lb
    current_best = objective(x)
    best_solution = x.copy()

    for _ in range(budget):
        # Simulated Annealing
        new_x = x + 0.1 * rng.randn(dim)
        new_x = np.clip(new_x, lb, ub)

        if func is f:
            new_value = 10*dim + np.sum(np.square(new_x) - 10*np.cos(2*np.pi*new_x))
        else:
            raise ValueError("Unknown function")

        delta = new_value - current_best
        if rng.rand() < np.exp(delta / 0.01):
            x = new_x.copy()
            current_best = new_value

        # Nelder-Mead Simplex
        simplex_size = int(np.ceil(np.sqrt(dim)))
        v = np.zeros((simplex_size, dim))
        for i in range(simplex_size):
            v[i] = (ub - lb) * rng.rand(dim) + lb

        centroid = np.mean(v, axis=0)
        rho = 2
        sigma = 1.3

        new_v = v.copy()
        if func is f:
            values = 10*dim + np.sum(np.square(v) - 10*np.cos(2*np.pi*v), axis=1)
        else:
            raise ValueError("Unknown function")

        for i in range(simplex_size):
            if i < simplex_size - 1 and values[i] < current_best:
                new_v[i] = v[i].copy()
            elif i == simplex_size - 1:
                vertex = np.argmin(values)
                new_v[i] = (centroid + rho * (v[vertex] - centroid)) / sigma
                if func is f:
                    new_value = 10*dim + np.sum(np.square(new_v[i]) - 10*np.cos(2*np.pi*new_v[i]))
                else:
                    raise ValueError("Unknown function")
            elif values[i] < current_best:
                new_v[i] = v[i].copy()
        for i in range(simplex_size):
            if func is f:
                new_value = 10*dim + np.sum(np.square(new_v[i]) - 10*np.cos(2*np.pi*new_v[i]))
            else:
                raise ValueError("Unknown function")
            if new_value < current_best:
                v[i] = new_v[i].copy()
        centroid_new = np.mean(v, axis=0)
        for i in range(simplex_size):
            if func is f:
                new_value = 10*dim + np.sum(np.square(v[i]) - 10*np.cos(2*np.pi*v[i]))
            else:
                raise ValueError("Unknown function")
            if new_value < current_best and centroid_new == v[i]:
                x = v[i].copy()
                current_best = new_value
        if func is f:
            best_solution[new_value < current_best] = v[np.argmin(values)]
        else:
            raise ValueError("Unknown function")

    return best_solution
