def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, (1, dim))
    T = 10 * (ub - lb)
    best_x = x.copy()

    for _ in range(budget):
        new_x = x + rng.normal(0, 2.38 / np.sqrt(dim)) * (ub - lb) * rng.uniform(-1, 1, (dim,))
        new_x = clip(new_x)

        delta = func(new_x) - func(x)
        if delta < 0 or T > np.exp(delta / (func(best_x) - func(x))):
            x = new_x
            if delta < 0:
                best_x = new_x

        T *= 0.9995

    return clip(best_x)
