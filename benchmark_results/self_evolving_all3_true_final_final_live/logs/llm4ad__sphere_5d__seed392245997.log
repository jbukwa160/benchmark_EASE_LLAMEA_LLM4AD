def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = clip(np.zeros(dim))
    min_val = func(x)
    best_x = x.copy()

    step_size = 1.0
    step_size_update_rate = 0.9

    for i in range(budget):
        if i > 100 and min_val == 0:
            break

        for _ in range(2**rng):
            direction = np.random.choice([-1, 1], size=dim)
            x_prime = clip(x + step_size * direction)

            val = func(x_prime)
            if val < min_val:
                min_val = val
                best_x = x_prime.copy()

        step_size *= step_size_update_rate

    return best_x
