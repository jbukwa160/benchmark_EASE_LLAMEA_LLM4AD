def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def mutate(x, step_size):
        return x + rng.normal(0, step_size, size=dim)

    def evaluate(x):
        return func(x)

    best_solution = None
    for _ in range(budget):
        if best_solution is not None:
            mean = np.copy(best_solution)
        else:
            mean = rng.uniform(lb, ub, size=dim)

        sigma = 1.0

        while True:
            new_mean = mutate(mean, sigma)
            new_mean = clip(new_mean, lb, ub)

            new_eval = evaluate(new_mean)
            if best_solution is None or new_eval < evaluate(best_solution):
                best_solution = np.copy(new_mean)

            if rng.uniform(0, 1) > 0.9:
                sigma *= 0.99
            else:
                break

    return best_solution
