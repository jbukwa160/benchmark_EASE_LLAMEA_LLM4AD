def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    sigma0 = 1e-6 * (ub - lb)**2 + 1e-3
    ls = []
    y = np.array([func(x)])
    x_best = x.copy()
    f_best = func(x)

    for t in range(1, budget+1):
        # Update kernel parameters
        var = np.var(y)
        cov = (y[:-1] - y[1:]) ** 2 / (t-1)
        sigma = np.sqrt(sigma0 * var + 1e-3) if var > 0 else sigma0

        # Sample new point using GP
        K = np.zeros((dim+1, dim+1))
        for i in range(dim):
            K[i, i] = cov
            for j in range(i+1, dim):
                K[i, j] = K[j, i] = np.sqrt(cov * (cov + sigma0)) / np.sqrt(var)
        K[dim, :dim] = K[:dim, dim] = np.sqrt(sigma) * np.ones(dim)
        K[dim, dim] = 1e-6

        # Compute mean and variance of GP
        mu = np.dot(K[:dim, dim], cho_solve(cho_factor(K[:dim, :dim]), y[:-1]))
        v = np.zeros((budget - t + 1))
        for i in range(t-1):
            v[i] = K[dim, dim] - np.dot(np.dot(K[:dim, dim], cho_solve(cho_factor(K[:dim, :dim]), y[i])), K[:dim, dim])

        # Sample new point using importance sampling
        u = rng.uniform(0, 1)
        if np.sum(v) > 0:
            i_sample = int(rng.choice(budget - t + 1, p=v / np.sum(v)))
            x_new = x[i_sample] + np.sqrt(cov) * norm.rvs(loc=mu - y[i_sample], scale=np.sqrt(sigma))
        else:
            x_new = rng.uniform(lb, ub, size=(dim,))

        # Clip candidate to bounds
        x_new = np.clip(x_new, lb, ub)

        # Update best point and function value
        y_new = func(x_new)
        if y_new < f_best:
            f_best = y_new
            x_best = x_new.copy()

        # Store iteration history
        ls.append({'x': x_new, 'f': y_new})

    return x_best
