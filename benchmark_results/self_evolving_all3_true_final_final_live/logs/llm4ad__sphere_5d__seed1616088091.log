    f_best = func(x_best)

    for _ in range(budget - 1):
        x_candidate = x_best + (ub - lb) * rng.randn(dim)
        clip_x_candidate = np.clip(x_candidate, lb, ub)
        f_candidate = func(clip_x_candidate)

        if f_candidate < f_best:
            x_best = clip_x_candidate
            f_best = f_candidate

