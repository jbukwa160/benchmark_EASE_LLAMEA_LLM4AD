def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    best_val = func(best)

    for i in range(budget):
        step_size = 1 / (i + 2) ** 0.5
        candidate = best.copy() + step_size * rng.randn(dim)

        # Clip candidates to [lb, ub]
        candidate = np.clip(candidate, lb, ub)

        new_val = func(candidate)
        if new_val < best_val:
            best = candidate
            best_val = new_val

    return best
