def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(dim, population_size):
        return rng.uniform(lb, ub, (population_size, dim))

    def differential_evolution(population, f, bounds, mutation_strategy, crossover_rate, tol, max_iter):
        n = len(bounds)
        pop_size = len(population)
        for _ in range(max_iter):
            distances = np.linalg.norm(population[:, np.newaxis] - population[np.newaxis, :], axis=2)
            targets = rng.choice(pop_size, pop_size, replace=False)
            trial_pop = population.copy()
            for i in range(pop_size):
                selected_indices = [i] + rng.choice(targets, 3, replace=False)
                mutant_vector = (bounds[rng.uniform(0, 1), :] - bounds[rng.uniform(0, 1), :]) if mutation_strategy == 'rand1exp' else \
                    (population[rng.choice(selected_indices), :] - population[(selected_indices + [i]) % pop_size, :])
                mutant_vector *= rng.uniform(0.5, 1.0)
                trial_vector = (population[i, :] + mutant_vector) if mutation_strategy == 'rand1exp' else \
                    (np.mean(population[selected_indices, :], axis=0) + mutant_vector)
                trial_pop[i] = np.where(rng.rand(n) < crossover_rate,
                                        clip(trial_vector),
                                        population[i])
            population = differential_evolution_helper(population, trial_pop, f, bounds, tol)
        return population

    def differential_evolution_helper(pop1, pop2, func, bounds, tol):
        best_pop = np.copy(pop1)
        for i in range(len(pop1)):
            if func(pop2[i]) < func(best_pop[i]):
                best_pop[i] = pop2[i]
        best_idx = np.argmin([func(x) for x in best_pop])
        if func(best_pop[best_idx]) - func(pop1[best_idx]) > tol:
            return differential_evolution_helper(pop2, pop1, func, bounds, tol)
        else:
            return best_pop

    def local_search(solution):
        for _ in range(budget // dim):
            idx = rng.choice(dim)
            new_solution = solution.copy()
            new_solution[idx] += rng.uniform(-0.01, 0.01)
            if func(new_solution) < func(solution):
                solution = new_solution
        return solution

    population_size = int(2 * (ub - lb)**dim / budget**0.5 + 1)
    initial_population = generate_initial_population(dim, population_size)

    mutated_population = differential_evolution(initial_population,
                                                 func,
                                                 np.array([[lb]*dim, [ub]*dim]),
                                                 'rand1exp',
                                                 0.8,
                                                 1e-6,
                                                 budget // dim * 2)

    best_solution = local_search(mutated_population[np.argmin([func(x) for x in mutated_population])])
    return best_solution
