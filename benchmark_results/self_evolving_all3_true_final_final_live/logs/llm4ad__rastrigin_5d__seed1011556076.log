def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    T = 10
    Tmin = 1e-6
    cooling_rate = 0.99
    
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        y = x.copy()
        
        # Cultural evolution step
        if rng.rand() < 0.01:
            sigma = 1e-3 * np.random.normal(size=dim)
            x += sigma
        
        f_x = func(x)
        f_y = func(y)
        
        delta_f = f_y - f_x
        if delta_f > 0 or rng.rand() < np.exp(-delta_f / T):
            x = y
            
            # Update best solution if necessary
            if f_y < best_f:
                best_f = f_y
                best_x = y
        
        # Cooling schedule
        T *= cooling_rate
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
        
    return best_x
