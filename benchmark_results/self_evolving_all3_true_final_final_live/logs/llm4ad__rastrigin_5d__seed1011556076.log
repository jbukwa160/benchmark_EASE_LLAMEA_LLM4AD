def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(budget):
        # Differential Evolution step
        y = x + rng.normal(size=x.shape) * 0.1
        y = clip(y, lb, ub)
        f = func(y)
        
        if f < best_f:
            best_x = y.copy()
            best_f = f
        
        # Simulated Annealing step
        alpha = 0.9
        beta = 10
        delta = rng.normal(size=x.shape)
        z = x + delta * (ub - lb) / 2
        
        if np.exp((best_f - func(z)) / beta) > rng.random():
            x = z.copy()
    
    return best_x
