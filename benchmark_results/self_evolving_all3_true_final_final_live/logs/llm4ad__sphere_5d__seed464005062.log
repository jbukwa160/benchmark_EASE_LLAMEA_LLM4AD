def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def get_step_size(budget):
        return 1 / (budget + 2)

    mean = rng.uniform(lb, ub, size=dim)
    step_size = get_step_size(budget)
    learning_rate = step_size
    cov_matrix = np.eye(dim) * (step_size ** 2)

    for _ in range(int(budget)):
        candidates = mean + rng.normal(size=(1 << 16, dim)) @ np.sqrt(cov_matrix)
        candidates = clip(candidates)

        function_values = func(candidates)
        best_candidate = candidates[np.argmin(function_values)]

        cov_matrix += (candidates - mean).T @ (candidates - mean) * learning_rate
        learning_rate *= 0.8

        if np.any(np.isnan(cov_matrix)):
            break

        mean = (mean + step_size * (best_candidate - mean)) / 2
    else:
        pass  # No break, all iterations were successful

    return best_candidate
