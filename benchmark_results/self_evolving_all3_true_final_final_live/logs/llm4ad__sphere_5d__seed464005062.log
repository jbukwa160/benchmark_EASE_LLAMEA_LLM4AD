def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(mu, sigma):
        candidate = mu + sigma * rng.normal(size=dim)
        return np.clip(candidate, lb, ub)

    def evaluate_candidate(candidate):
        return func(candidate), candidate

    x_best = -np.inf
    best_x = None
    population_size = 10

    for _ in range(budget):
        mu = np.zeros(dim)
        sigma = 1.0

        while True:
            candidates = [generate_candidate(mu, sigma) for _ in range(population_size)]
            f_values = [evaluate_candidate(candidate)[0] for candidate in candidates]

            best_idx = np.argmin(f_values)
            if f_values[best_idx] < x_best:
                x_best = f_values[best_idx]
                best_x = candidates[best_idx]

            average_f_value = np.mean(f_values)

            if average_f_value > x_best or population_size == 1:
                break

            sigma *= 1.1
            mu += (np.array(candidates[best_idx]) - mu) / population_size

    return best_x
