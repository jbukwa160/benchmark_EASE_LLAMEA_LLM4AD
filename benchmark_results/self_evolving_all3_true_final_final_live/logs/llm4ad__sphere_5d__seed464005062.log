def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(size=dim) * (ub - lb) + lb
    best_f = func(x_best)
    f_history = [best_f]
    
    for _ in range(budget):
        # Sample a random subset of dimensions
        idx_subset = rng.choice(dim, size=rng.integers(1, dim), replace=False)
        
        # Initialize the model
        g = np.zeros_like(x_best)
        
        # Gradient Boosting iterations
        for _ in range(rng.integers(3, 7)):
            # Sample a random subset of points
            idx_points = rng.choice(budget + 1, size=100, replace=False)
            
            # Fit the weak model to predict the gradient
            x_subset = x_best[idx_subset]
            y_grad = func(x_best + 0.01 * g[idx_subset]) - best_f
            
            # Update the model using gradient boosting
            g[idx_subset] += rng.uniform(-1, 1) * np.mean(y_grad)
        
        # Clip candidates to [lb, ub]
        x_candidate = x_best + 0.01 * g
        x_candidate = np.clip(x_candidate, lb, ub)
        
        # Evaluate the new candidate
        f_candidate = func(x_candidate)
        
        # Update the best solution if necessary
        if f_candidate < best_f:
            x_best = x_candidate
            best_f = f_candidate
        
        # Store the current function value
        f_history.append(best_f)
    
    return x_best
