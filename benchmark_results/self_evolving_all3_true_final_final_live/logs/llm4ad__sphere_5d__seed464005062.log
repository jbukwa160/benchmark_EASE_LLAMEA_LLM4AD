def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    T = 1000.0
    alpha = 0.99

    for _ in range(budget):
        y = x.copy()
        i = np.random.randint(0, dim)
        delta = rng.uniform(-1, 1)
        y[i] += delta * (ub - lb)

        clipped_y = np.clip(y, lb, ub)
        f_x = func(x)
        f_y = func(clipped_y)

        if f_y < f_x:
            x = clipped_y
        elif np.random.rand() < np.exp(-(f_y - f_x) / T):
            x = clipped_y

        T *= alpha

    return x
