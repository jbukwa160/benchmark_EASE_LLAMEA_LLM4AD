def algorithm(func, dim, lb, ub, budget, rng):
    def wrapper(x):
        return func(x)

    bounds = [(lb[i], ub[i]) for i in range(dim)]
    res = differential_evolution(wrapper, bounds)
    x_best = res.x
    f_best = res.fun
    
    while True:
        budget -= len(res.x)
        
        if budget <= 0:
            break
        
        new_x = x_best + rng.normal(size=dim) * 1e-2
        
        clipped_new_x = np.clip(new_x, lb, ub)
        
        new_f = func(clipped_new_x)
        
        if new_f < f_best:
            x_best = clipped_new_x
            f_best = new_f
    
    return x_best
