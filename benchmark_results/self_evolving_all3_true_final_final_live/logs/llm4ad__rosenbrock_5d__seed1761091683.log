def algorithm(func, dim, lb, ub, budget, rng):
    num_iter = budget * 10
    T_init = 1.0
    alpha = 0.9
    gamma = 0.99
    sigma_max = 5.0
    sigma_min = 0.01

    x_best = np.random.uniform(lb, ub, dim)
    f_best = func(x_best)

    for i in range(num_iter):
        sigma = max(sigma_min, min(sigma_max, alpha * (1 - gamma)**i))
        T = max(T_init * (1 + 0.01*i), 0.000001) # to avoid division by zero

        x_new = np.clip(x_best + sigma * rng.normal(size=dim), lb, ub)

        f_new = func(x_new)
        if f_new <= f_best:
            x_best = x_new
            f_best = f_new
        else:
            p_accept = np.exp(-(f_new - f_best) / T)
            r = rng.rand()
            if r < p_accept:
                x_best = x_new
                f_best = f_new

    return x_best
