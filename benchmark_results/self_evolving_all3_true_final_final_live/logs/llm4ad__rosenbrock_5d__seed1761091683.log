def algorithm(func, dim, lb, ub, budget, rng):
    def sample_x():
        return (ub - lb) * rng.rand(dim) + lb

    def sample_y(x):
        y = func(x)
        return x, y

    def update_model(model, x_best):
        model.update(x_best)

    def predict(model, x):
        mean, var = model.predict(x)
        return mean, np.sqrt(var)

    dim = int(dim)
    lb = float(lb)
    ub = float(ub)
    budget = int(budget)

    best_x = sample_x()
    best_y = func(best_x)
    model = None  # Initialize the probabilistic model

    for i in range(budget):
        x, y = sample_y(sample_x())
        update_model(model, x if y < best_y else best_x)
        mean, std = predict(model, np.array([best_x]))
        new_x = (ub - lb) * rng.randn(dim) + lb
        while not all(lb <= new_x[i] <= ub for i in range(dim)):
            new_x = (ub - lb) * rng.randn(dim) + lb

        if y < best_y:
            best_x = x
            best_y = y

    return np.clip(best_x, a_min=lb, a_max=ub)
