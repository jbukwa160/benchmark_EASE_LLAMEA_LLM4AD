def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    num_search_steps = int(budget * 0.8)
    search_step_size = (ub - lb) / rng
    gradient_descent_step_size = (ub - lb) / 10

    for _ in range(num_search_steps):
        candidate = rng.uniform(lb, ub, size=dim)
        new_candidate = clip(candidate + rng.normal(0, search_step_size, size=dim), lb, ub)

        if func(new_candidate) < func(candidate):
            candidate = new_candidate

    initial_guess = candidate
    num_gradient_descent_steps = int(budget * 0.2 / dim)
    for _ in range(num_gradient_descent_steps):
        gradient = np.zeros(dim)
        for i in range(dim):
            x_plus_h = np.copy(initial_guess)
            x_minus_h = np.copy(initial_guess)
            x_plus_h[i] += gradient_descent_step_size
            x_minus_h[i] -= gradient_descent_step_size

            plus_gradient = (func(clip(x_plus_h, lb, ub)) - func(initial_guess)) / gradient_descent_step_size
            minus_gradient = (func(clip(x_minus_h, lb, ub)) - func(initial_guess)) / gradient_descent_step_size

            gradient[i] = 0.5 * (plus_gradient + minus_gradient)

        initial_guess -= gradient * gradient_descent_step_size

    return clip(initial_guess, lb, ub)
