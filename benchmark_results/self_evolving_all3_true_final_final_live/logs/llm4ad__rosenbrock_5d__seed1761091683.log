def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def de(x, bounds):
        n = len(bounds)
        y = x + rng.normal(0, 1, size=n) * (ub - lb)
        for _ in range(budget // 2):
            i = np.random.choice(n)
            y[i] = clip(y[i])
            yield y

    def sa(x, bounds, T=10.0, alpha=0.99):
        n = len(bounds)
        y = x
        while T > 1e-6:
            for _ in range(budget // 2):
                i = np.random.choice(n)
                delta = rng.normal(0, 1) * (ub - lb)
                new_y = y.copy()
                new_y[i] = clip(y[i] + delta)
                f_new = func(new_y)
                f_best = func(y)
                if f_new < f_best:
                    y = new_y
                elif rng.random() < np.exp((f_best - f_new) / T):
                    y = new_y
            yield y
            T *= alpha

    x0 = (ub + lb) / 2 * np.ones(dim)
    pop = list(de(x0, [lb]*dim))
    best = min(pop, key=func)

    for _ in range(budget // 2):
        pop.extend(sa(best, [lb]*dim))

    best = min(pop, key=func)
    return clip(best)
