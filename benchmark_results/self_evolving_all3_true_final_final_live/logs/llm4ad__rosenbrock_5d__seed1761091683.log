def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.minimum(np.maximum(candidate, lb), ub)

    initial_solution = rng.uniform(lb, ub, size=dim)
    current_solution = initial_solution.copy()
    best_solution = initial_solution.copy()

    sigma_init = 0.1 * (ub - lb)
    learning_rate = 0.01
    adaptation_rate = 0.2

    for _ in range(budget):
        # Step 1: Generate a new candidate solution using CMA-ES
        new_candidate, step_size = cma_es(current_solution, sigma_init, learning_rate, adaptation_rate)
        
        # Clip the new candidate to ensure it is within the bounds
        clipped_candidate = clip(new_candidate)

        # Step 2: Evaluate both the new and current solutions using Simulated Annealing
        current_fitness = func(clip(current_solution))
        new_fitness = func(clipped_candidate)

        if rng.uniform() < np.exp((current_fitness - new_fitness) / step_size):
            current_solution = clipped_candidate.copy()
        
        # Update the best solution found so far
        if new_fitness < func(best_solution):
            best_solution = clipped_candidate.copy()

    return best_solution
