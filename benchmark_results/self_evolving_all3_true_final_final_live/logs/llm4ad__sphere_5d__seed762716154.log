def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    T = 1000.0
    alpha = 0.9
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        v1 = rng.uniform(lb, ub, size=dim)
        v2 = rng.uniform(lb, ub, size=dim)
        v3 = rng.uniform(lb, ub, size=dim)
        v = x + alpha * (v1 - v2) + 0.5 * (v2 - v3)

        v = clip(v)

        f_v = func(v)
        if f_v < best_f:
            best_x = v.copy()
            best_f = f_v

        delta = f_v - best_f
        if delta < 0 or np.random.rand() < np.exp(-delta / T):
            x = v.copy()

        T *= alpha

    return best_x
