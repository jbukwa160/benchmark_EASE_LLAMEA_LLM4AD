def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    population_size = 50
    initial_temperature = 1000
    cooling_rate = 0.99
    mutation_factor = 0.5
    crossover_probability = 0.9

    initial_population = rng.uniform(lb, ub, (population_size, dim))
    current_best = np.inf * np.ones(dim)
    temperature = initial_temperature

    for i in range(budget):
        for candidate in initial_population:
            clipped_candidate = clip(candidate)
            fitness = func(clipped_candidate)

            if fitness < current_best[0]:
                current_best = clipped_candidate
                print(f'Iteration {i}, Best fitness: {fitness}')

        new_population = np.copy(initial_population)
        for j in range(population_size):
            index1, index2, index3 = rng.choice(population_size, 3, replace=False)

            mutated_candidate = initial_population[index1] + mutation_factor * (initial_population[index2] - initial_population[index3])
            clipped_mutated_candidate = clip(mutated_candidate)
            new_population[j] = clipped_mutated_candidate

        if rng.random() < crossover_probability:
            index1, index2 = rng.choice(population_size, 2, replace=False)

            candidate1 = initial_population[index1]
            candidate2 = initial_population[index2]

            for k in range(dim):
                if rng.random() < 0.5:
                    new_population[index1][k], new_population[index2][k] = candidate2[k], candidate1[k]

        current_best = np.min(new_population, axis=0)

        temperature *= cooling_rate

    return clip(current_best)
