def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        y = x + 0.1 * (ub - lb) * np.random.randn(dim)
        y = np.clip(y, lb, ub)
        
        f_y = func(y)
        
        if f_y < best_f:
            best_x = y.copy()
            best_f = f_y
            
        bounds = [(lb[i], ub[i]) for i in range(dim)]
        res = differential_evolution(func, bounds, x0=y, disp=False, polish=False)
        z = np.array(res.x).copy()
        
        if func(z) < best_f:
            best_x = z.copy()
            best_f = func(z)
            
    return best_x
