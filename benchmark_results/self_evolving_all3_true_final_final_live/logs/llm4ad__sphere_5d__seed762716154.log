def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    x_best = rng.uniform(lb, ub)
    f_best = func(x_best)

    T0 = 1000 * (ub - lb) ** 2
    alpha = 0.9
    beta = 0.99
    step_size = 1

    for _ in range(budget):
        x_new = x_best + rng.uniform(-step_size, step_size, size=n)
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        delta_f = f_new - f_best

        if delta_f < 0:
            x_best = x_new
            f_best = f_new
        else:
            prob = np.exp(-delta_f / T0)
            r = rng.uniform(0, 1)

            if r < prob:
                T0 *= alpha
                step_size *= beta
                x_best = x_new

    return x_best
