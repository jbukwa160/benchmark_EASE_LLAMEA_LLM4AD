def algorithm(func, dim, lb, ub, budget, rng):
    n = int(budget / (dim * 10))  # number of iterations for each method
    x = np.random.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)

    # Differential Evolution
    for _ in range(n):
        v = x + rng.uniform(-1, 1, size=(dim,)) * (x - rng.uniform(lb, ub, size=(dim,)))
        v = np.clip(v, lb, ub)
        f = func(v)
        if f < best_f:
            best_x = v.copy()
            best_f = f

    # Simplex optimization
    for _ in range(n):
        x_new = (best_x + rng.uniform(lb, ub, size=(dim,)) * np.random.dirichlet(np.ones(dim), size=1)).flatten()
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new

    return best_x
