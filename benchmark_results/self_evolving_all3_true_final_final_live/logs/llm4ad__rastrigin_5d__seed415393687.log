def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x)

    x_best = np.zeros(dim)
    f_best = float('inf')
    T_max = 10 * (ub - lb) ** 2
    cooling_rate = 0.99

    for _ in range(budget):
        candidate1 = clip(rng.uniform(lb, ub, size=dim))
        candidate2 = clip(x_best + rng.uniform(-5, 5, size=dim))

        if evaluate(candidate1) < f_best:
            x_best = candidate1
            f_best = evaluate(candidate1)

        elif evaluate(candidate2) < f_best:
            x_best = candidate2
            f_best = evaluate(candidate2)

        T = max(T_max * cooling_rate ** (budget - _), 0.01)
        alpha = rng.uniform(0, 1)
        candidate3 = clip(x_best + alpha * (candidate1 - candidate2))

        if evaluate(candidate3) < f_best:
            x_best = candidate3
            f_best = evaluate(candidate3)

    return x_best
