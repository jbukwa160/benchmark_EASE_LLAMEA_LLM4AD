def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    f = func
    D = dim
    bounds = [(lb, ub) for _ in range(dim)]
    
    def clip(candidate):
        return np.clip(candidate, *bounds)
    
    x_best = np.random.uniform(*bounds, size=(pop_size, D))
    f_best = np.inf
    
    for i in range(budget):
        F = 0.5
        CR = 0.9
        
        Y = np.zeros((pop_size, D))
        for j in range(pop_size):
            r1, r2, r3 = rng.choice(pop_size, size=3, replace=False)
            while r1 == j or r2 == j or r3 == j:
                r1, r2, r3 = rng.choice(pop_size, size=3, replace=False)
            Y[j] = clip(x_best[r1] + F * (x_best[r2] - x_best[r3]))
        
        U = np.random.uniform(size=(pop_size, D))
        for j in range(pop_size):
            if np.random.rand() < CR or U[j, np.argmax(Y[j])] == 1:
                Y[j, np.argmax(Y[j])] = clip(x_best[j, np.argmax(Y[j])] + (Y[j, np.argmax(Y[j])] - x_best[j, np.argmax(Y[j])]))
        
        f_Y = func(Y)
        idx = np.argsort(f_Y)
        
        if f_Y[idx[0]] < f_best:
            f_best = f_Y[idx[0]]
            x_best[idx[0]] = Y[idx[0]]
        
        if f_best <= 1e-6 or i >= budget - 100:
            break
    
    return clip(x_best[np.argmin(f_best)])
