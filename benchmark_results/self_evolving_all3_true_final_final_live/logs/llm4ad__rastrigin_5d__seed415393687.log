def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidates(candidates, lower_bound, upper_bound):
        return np.clip(candidates, lower_bound, upper_bound)

    def generate_directions(dim):
        directions = np.random.normal(size=(dim, 100))
        for i in range(1, 100):
            directions[:, i] = (directions[:, i-1] + directions[:, i]) / 2
        return directions

    def mdcmaes(func, x0, dim, bounds, budget):
        mean = np.array(x0)
        sigma = 10.0
        n_directions = int(budget ** (1 / 3))
        directions = generate_directions(dim)

        for _ in range(n_directions):
            new_mean = mean + sigma * np.random.normal(size=dim)
            candidates = clip_candidates(new_mean, bounds[0], bounds[1])
            f_values = [func(candidate) for candidate in candidates]

            best_candidate_idx = np.argmin(f_values)
            best_candidate = candidates[best_candidate_idx]
            if func(best_candidate) < func(mean):
                mean = best_candidate

        return mean

    x0 = [(ub + ub - lb) / 2.0] * dim
    bounds = [lb, ub]

    best_candidate = mdcmaes(func, x0, dim, bounds, budget)
    return np.array(best_candidate)
