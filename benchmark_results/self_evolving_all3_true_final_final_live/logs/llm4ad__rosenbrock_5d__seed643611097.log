def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(x, sigma, rng):
        x_mut = x + sigma * rng.randn(dim)
        return np.clip(x_mut, lb, ub)

    def cma_es_step(x, sigma, func, rng):
        f_x = func(x)
        new_x = mutate(x, sigma, rng)
        f_new_x = func(new_x)
        if f_new_x < f_x:
            x = new_x
        return x

    dim_pop = 1000
    pop_size = 200
    sigma_0 = 1.5
    c1 = 2
    iterations_per_step = 10
    rng_state = rng.get_state()

    best_x = np.random.uniform(lb, ub, size=(dim,))
    for _ in range(budget):
        rng.set_state(rng_state)
        pop = [np.random.uniform(lb, ub, size=(dim,)) for _ in range(pop_size)]
        sigma = max(1e-6, sigma_0 * np.exp(-_ / c1))

        for _ in range(iterations_per_step):
            for i in range(pop_size):
                pop[i] = cma_es_step(pop[i], sigma, func, rng)
        best_x_new = min(pop, key=func)
        if func(best_x_new) < func(best_x):
            best_x = best_x_new

    return best_x
