def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    elitism = 2
    max_iter = int(budget / pop_size)
    mutation_rate = 0.01
    best_x = None
    best_f = float('inf')
    
    for _ in range(max_iter):
        x = np.random.uniform(lb, ub, (pop_size, dim))
        
        f = np.zeros(pop_size)
        for i in range(pop_size):
            f[i] = func(x[i])
            
        idx = np.argsort(f)[:elitism]
        f[idx] = 0
        
        for i in range(elitism, pop_size):
            mutation_rate = (np.mean(f[:i]) + np.mean(f[i:])) / np.mean(f)
            x[i] += rng.uniform(-mutation_rate, mutation_rate)
            
            # clip candidates to [lb, ub]
            x[i] = np.clip(x[i], lb, ub)
            
            f[i] = func(x[i])
            
        idx = np.argsort(f)[:elitism]
        if best_f > f[idx[0]]:
            best_x = x[idx[0]]
            best_f = f[idx[0]]
    
    return best_x
