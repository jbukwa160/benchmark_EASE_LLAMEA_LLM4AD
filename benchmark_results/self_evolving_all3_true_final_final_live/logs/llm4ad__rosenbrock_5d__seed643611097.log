def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = x + rng.uniform(-1, 1, size=dim) / (np.sqrt(np.sum(x**2)) + 1e-8)
        y = np.clip(y, lb, ub)

        f = func(y)
        if f < best_f:
            best_x = y.copy()
            best_f = f

        alpha = rng.uniform(0.5, 1.5)
        z = (alpha * x + (1 - alpha) * best_x) / (np.sqrt(np.sum(x**2)) + np.sqrt(np.sum(best_x**2))) / 2
        z = np.clip(z, lb, ub)

        f_z = func(z)
        if rng.uniform(0, 1) < np.exp((best_f - f_z) / (10 ** (budget - _))):
            best_x = z.copy()
            best_f = f_z

    return best_x
