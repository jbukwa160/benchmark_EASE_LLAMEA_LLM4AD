def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    x0 = (ub + lb) / 2 * np.ones(n)
    best_x = x0.copy()
    best_f = func(x0)

    def acq(x):
        return -func(x) - np.sum(np.abs(x))

    t = 0
    while t < budget:
        sigma = 1.5 / (t + 2) * rng.uniform(0, 1)
        xi = x0 + sigma * rng.normal(size=n)

        # Clip candidates to [lb, ub]
        for i in range(n):
            xi[i] = max(lb[i], min(xi[i], ub[i]))

        fi = func(xi)
        if fi < best_f:
            best_x = xi.copy()
            best_f = fi

        # Simulated Annealing
        if rng.uniform(0, 1) < np.exp((best_f - fi) / (t + 2)):
            x0 = xi.copy()

        # Bayesian Optimization
        acq_values = [acq(x0 + sigma * r) for _ in range(n)]
        i = np.argmax(acq_values)
        x0[i] += sigma * rng.normal(size=n)[i]

    return best_x
