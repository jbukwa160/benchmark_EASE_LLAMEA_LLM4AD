def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x)

    pop_size = int(np.sqrt(budget))
    max_iter = 1000
    w = 1.2
    c1 = 1.5
    c2 = 2.5
    v = np.random.uniform(-10, 10, (pop_size, dim))

    for i in range(max_iter):
        for j in range(pop_size):
            r1 = rng.randint(0, pop_size)
            r2 = rng.randint(0, pop_size)

            u = w * v[j] + c1 * np.random.uniform(-1, 1) * (v[r1] - v[j]) + \
                c2 * np.random.uniform(-1, 1) * (v[r2] - v[j])

            v[j] = clip(v[j] + u)

        f_values = np.array([evaluate(clip(x)) for x in v])
        idx_sorted = np.argsort(f_values)
        v[idx_sorted[:pop_size//2]] = np.random.uniform(lb, ub, (pop_size//2, dim))

    best_idx = np.argmin(f_values)
    return clip(v[best_idx])
