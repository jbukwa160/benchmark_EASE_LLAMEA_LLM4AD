def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        sigma = 0.1
        delta = rng.normal(size=dim) * sigma
        candidate = clip(x + delta)
        f_candidate = func(candidate)

        if f_candidate < best_f:
            best_x = candidate.copy()
            best_f = f_candidate

        p_accept = min(1, np.exp(-(best_f - f_candidate)/sigma))
        u = rng.uniform(size=1)[0]
        if u <= p_accept:
            x = candidate

    return best_x
