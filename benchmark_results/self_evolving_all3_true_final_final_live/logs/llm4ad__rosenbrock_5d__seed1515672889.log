def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.ceil(0.8 * dim))  # population size for DE
    x_best = rng.uniform(lb, ub, (1, dim))
    f_best = func(x_best)
    
    for i in range(budget):
        offspring = np.zeros((pop_size, dim))
        
        for j in range(pop_size):
            p = rng.choice(range(dim), size=3, replace=False)  # choose 3 random indices
            mu = x_best.copy()
            
            if rng.uniform(0, 1) < 0.5:
                mu[p] += rng.uniform(-1, 1)
            else:
                mu[p] -= rng.uniform(-1, 1)
                
            offspring[j] = clip(mu, lb, ub)
        
        scores = np.array([func(offspring[j]) for j in range(pop_size)])
        indices = np.argsort(scores)[:int(0.2 * pop_size)]  # select worst 20% of population
        offspring[indices] = x_best.copy()
        
        f_new = func(offspring[np.argmin(scores)])
        if f_new < f_best:
            x_best = offspring[np.argmin(scores)]
            f_best = f_new
    
    return clip(x_best, lb, ub)
