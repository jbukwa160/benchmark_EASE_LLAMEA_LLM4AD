def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    best_fitness = float('inf')
    
    for _ in range(budget):
        x = (ub - lb) * rng.rand(dim) + lb
        
        if func(x) < best_fitness:
            best_fitness = func(x)
            best = x
    
    return best
