def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget - 1):
        new_x = x + rng.normal(size=dim) / np.sqrt(_ + 2)
        new_x = np.clip(new_x, lb, ub)
        
        new_f = func(new_x)

        if new_f < best_f:
            best_f = new_f
            best_x = new_x

        if rng.uniform() < np.exp((best_f - new_f) / (_ + 2)):
            x = new_x.copy()

    return best_x
