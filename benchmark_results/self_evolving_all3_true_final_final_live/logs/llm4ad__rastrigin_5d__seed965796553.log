def algorithm(func, dim, lb, ub, budget, rng):
    n_iter = 0
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    while n_iter < budget:
        x_new = np.random.uniform(lb, ub, size=dim)
        
        if func(x_new) < f_best:
            x_best = x_new.copy()
            f_best = func(x_new)
        
        # probabilistic restart mechanism
        if rng.rand() < 0.1 and n_iter > budget // 10:
            x_best = np.random.uniform(lb, ub, size=dim)
            f_best = float('inf')
        
        n_iter += 1
    
    return x_best
