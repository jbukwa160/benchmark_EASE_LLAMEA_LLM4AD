def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    x_best = np.zeros(n)
    f_best = float('inf')

    for i in range(budget):
        x_new = x_best + rng.normal(size=n) * 0.1
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)

        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
