def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(low=lb, high=ub, size=(dim,))
    for _ in range(budget - 1):
        candidate = x + rng.normal(size=(dim,))
        candidate = np.clip(candidate, a_min=lb, a_max=ub)
        if func(candidate) < func(x):
            x = candidate
    return x
