def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    current = rng.uniform(lb, ub, size=dim)
    best = current.copy()
    temperature = 1.0
    sigma = 2.5

    for _ in range(budget):
        new = current + rng.normal(0, sigma, size=dim)
        new = clip(new)

        delta = func(new) - func(current)
        if delta < 0 or (rng.uniform(0, 1) < np.exp(-delta / temperature)):
            current = new

        if func(current) < func(best):
            best = current.copy()

        sigma *= 0.9995
        temperature *= 0.9995

    return best
