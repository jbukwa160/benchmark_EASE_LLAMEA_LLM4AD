def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_f = float('inf')
    
    for i in np.ndindex(*([rng.integers(lb, ub+1)]*dim)):
        x = i.astype(np.float64)
        
        if func(x) < best_f:
            best_f = func(x)
            best_x = x
            
        budget -= 1
        if budget <= 0:
            break
    
    return best_x
