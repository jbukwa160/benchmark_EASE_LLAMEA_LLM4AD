def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_x = np.zeros(dim)
    best_f = float('inf')

    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        f = func(clip(x))
        
        if f < best_f:
            best_f = f
            best_x = clip(x)

        new_x = rng.uniform(lb, ub, size=dim) + 0.5 * (rng.uniform(-1, 1, size=dim) * np.array([ub - lb for _ in range(dim)]))
        new_x = clip(new_x)
        
        f_new = func(new_x)

        if f_new < best_f:
            best_f = f_new
            best_x = new_x

    return best_x
