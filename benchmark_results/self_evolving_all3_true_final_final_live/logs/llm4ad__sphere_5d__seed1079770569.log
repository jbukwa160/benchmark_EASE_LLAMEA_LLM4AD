def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    step_size = 2 * (ub - lb)
    
    for _ in range(budget):
        new_x = best_x + rng.uniform(-step_size, step_size, size=(dim,))
        clipped_new_x = np.clip(new_x, lb, ub)
        
        if func(clipped_new_x) < func(best_x):
            best_x = clipped_new_x
            
        step_size *= 0.9
        
    return best_x
