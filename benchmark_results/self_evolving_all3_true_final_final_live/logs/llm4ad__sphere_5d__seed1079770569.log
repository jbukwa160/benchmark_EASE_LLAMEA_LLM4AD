def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = np.copy(x)
    best_f = func(x)

    for _ in range(budget):
        g = np.zeros(dim)
        for i in range(dim):
            eps = rng.uniform(-1e-5, 1e-5)
            x_plus_eps = np.copy(x)
            x_plus_eps[i] += eps
            f_plus_eps = func(x_plus_eps)
            g[i] = (f_plus_eps - best_f) / eps

        step_size = 0.01
        x -= step_size * g
        for i in range(dim):
            if x[i] < lb:
                x[i] = lb + (lb - x[i]) ** 2
            elif x[i] > ub:
                x[i] = ub - (x[i] - ub) ** 2

        f = func(x)
        if f < best_f:
            best_f = f
            np.copyto(best_x, x)

    return best_x
