def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.array([lb] * dim)
    best_f = float('inf')
    for _ in range(budget):
        x = rng.normal(size=dim) + 1e-5
        while not (np.all(x >= lb) and np.all(x <= ub)):
            x[rng.choice(dim)] += rng.uniform(-1, 1)
        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x.copy()
        alpha = 0.05 * (best_f - f)
        x += rng.normal(size=dim) * alpha + 1e-6
    return np.clip(best_x, lb, ub)
