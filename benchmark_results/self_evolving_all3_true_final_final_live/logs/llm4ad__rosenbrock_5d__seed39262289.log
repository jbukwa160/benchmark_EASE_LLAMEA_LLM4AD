def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)
    
    step_size = 1.0
    n_evals = 0
    
    while n_evals < budget:
        new_step_size = max(0.01, step_size * np.exp(-n_evals / (budget + 1)))
        
        for _ in range(int(budget / dim)):
            x_new = x.copy()
            i = rng.randint(dim)
            
            # Clip candidates to [lb, ub]
            delta = new_step_size * (rng.uniform(lb - x[i], ub - x[i]) if i == 0 else 
                                    rng.uniform(x[i-1] - x[i], ub - x[i]))
            x_new[i] += delta
            
            f_new = func(x_new)
            
            n_evals += 1
            
            if f_new < best_f:
                best_f = f_new
                best_x = x_new
                
        step_size *= 0.9
        
    return best_x
