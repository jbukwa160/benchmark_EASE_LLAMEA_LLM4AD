def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(mean, sigma):
        candidate = mean + sigma * np.random.randn(dim)
        return np.clip(candidate, lb, ub)

    def mutate(candidate, parent):
        delta = 0.1 * (candidate - parent)
        child = candidate + delta
        return np.clip(child, lb, ub)

    num_parents = int(np.sqrt(budget))
    population_size = budget - num_parents

    mean = rng.uniform(lb, ub, dim)
    sigma = 2.4 / dim
    best_candidate = mean

    for i in range(population_size):
        candidate = generate_candidate(mean, sigma)
        if func(candidate) < func(best_candidate):
            best_candidate = candidate

        parent = best_candidate
        child = mutate(candidate, parent)
        if func(child) < func(best_candidate):
            best_candidate = child

        mean = (mean * (population_size - 1) + best_candidate) / population_size

    return best_candidate
