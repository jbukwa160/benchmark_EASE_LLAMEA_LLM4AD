def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    best_f = func(x)

    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    for _ in range(budget):
        # Simulated Annealing
        T = 1000.0
        alpha = 0.99
        for _ in range(int(dim * 1.5)):
            x_new = x + (ub - lb) * rng.randn(dim)
            f_new = func(clip(x_new))
            if f_new < best_f:
                x = x_new
                best_x = x.copy()
                best_f = f_new
            elif np.exp(-(f_new - best_f) / T) > rng.rand():
                x = x_new

        # Differential Evolution
        for _ in range(int(dim * 0.5)):
            i, j, k = rng.randint(0, dim, size=3)
            while i == j or i == k or j == k:
                i, j, k = rng.randint(0, dim, size=3)
            x_new = x + 0.8 * (x[j] - x[i]) + 0.2 * (x[k] - x[i])
            f_new = func(clip(x_new))
            if f_new < best_f:
                x = x_new
                best_x = x.copy()
                best_f = f_new

        # Crossover
        for _ in range(int(dim * 1)):
            i, j = rng.randint(0, dim, size=2)
            while i == j:
                i, j = rng.randint(0, dim, size=2)
            x[i], x[j] = x[j], x[i]
            f_new = func(clip(x))
            if f_new < best_f:
                x = x.copy()
                best_x = x
                best_f = f_new

    return best_x
