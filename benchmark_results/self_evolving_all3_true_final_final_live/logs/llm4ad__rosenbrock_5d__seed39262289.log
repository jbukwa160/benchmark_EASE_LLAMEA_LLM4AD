def algorithm(func, dim, lb, ub, budget, rng):
    def gp_model(X, y):
        X = np.atleast_2d(X).T
        n = len(y)
        if n <= 5:
            return np.mean(y) + 0.1 * np.std(y) * rng.randn(n)
        else:
            K = np.zeros((n,n))
            for i in range(n):
                for j in range(i+1, n):
                    K[i,j] = K[j,i] = np.exp(-np.sum((X[i]-X[j])**2))
            alpha = np.linalg.inv(K).dot(y)
            return (K.dot(alpha))

    def acquisition(X, y, gp_model):
        mu, sigma = gp_model(X, y)
        ei = np.max(mu) + 1.96 * sigma
        idx = np.argmax(ei)
        return X[idx], ei[idx]

    dim = int(dim)
    best_x = np.zeros((dim,))
    best_f = float('inf')
    X = np.atleast_2d(np.array([np.mean(lb), np.mean(ub)])).T
    y = func(X)

    for i in range(budget):
        x, ei = acquisition(X, y, gp_model)
        if ei > 0:
            new_x = np.clip(x, lb, ub)
            new_y = func(new_x)
            X = np.vstack((X, new_x))
            y = np.hstack((y, new_y))

            best_idx = np.argmin(y)
            best_x[...] = X[best_idx]
            best_f = y[best_idx]

    return best_x
