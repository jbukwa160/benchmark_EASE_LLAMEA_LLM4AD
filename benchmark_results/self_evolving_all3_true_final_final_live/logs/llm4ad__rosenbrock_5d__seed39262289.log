def algorithm(func, dim, lb, ub, budget, rng):
    best = np.array([0.5 * (lb + ub) for _ in range(dim)])
    best_val = func(best)
    
    candidates = [best]
    
    while len(candidates) < budget:
        new_candidates = []
        
        for i in range(len(candidates)):
            noise = rng.uniform(lb, ub, size=dim)
            candidate = candidates[i] + 0.1 * noise
            
            if np.all(np.logical_and(candidate >= lb, candidate <= ub)):
                new_candidates.append(candidate)
            
            new_candidates.extend([candidate - 0.1 * noise])
        
        candidates.extend(new_candidates)
        
        for i in range(len(candidates) - len(best)):
            val = func(candidates[i])
            
            if val < best_val:
                best_val = val
                best = candidates[i]
    
    return best
