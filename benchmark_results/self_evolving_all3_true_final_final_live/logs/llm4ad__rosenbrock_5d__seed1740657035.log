def algorithm(func, dim, lb, ub, budget, rng):
    def init_simplex(size, dim):
        simplex = rng.uniform(lb, ub, (size, dim))
        return simplex

    def evaluate(x):
        if len(x) != dim:
            raise ValueError("Invalid dimension")
        return func(x)

    def clip(x, lb, ub):
        x = np.clip(x, lb, ub)
        return x

    def gaussian_process_regression(x_train, y_train, x_test):
        from sklearn.gaussian_process import GaussianProcessRegressor
        from sklearn.gaussian_process.kernels import Matern
        kernel = Matern(nugget=1e-3) + 0.5 * np.eye(dim)
        gpr = GaussianProcessRegressor(kernel=kernel)
        gpr.fit(x_train, y_train)
        return gpr.predict(x_test)

    def nelder_mead_simplex(x_simplex):
        from scipy.optimize import minimize

        def objective(x):
            return evaluate(clip(x, lb, ub))

        result = minimize(objective, x_simplex[0], method="Nelder-Mead", options={"disp": False})
        return result.x

    size = int(np.ceil(budget ** (1. / dim)))
    simplex = init_simplex(size, dim)
    best_x = None
    best_fval = float("inf")

    for _ in range(int(0.8 * budget)):
        y_train = [evaluate(clip(x, lb, ub)) for x in simplex]
        x_test = np.array([[np.random.uniform(lb, ub)] * dim for _ in range(size)])
        mean, std = gaussian_process_regression(simplex, y_train, x_test)
        new_x = x_test[np.argmax(mean - 3 * std)]
        new_x = clip(new_x[0], lb, ub)

        simplex[size - 1] = new_x
        y_train.append(evaluate(clip(new_x, lb, ub)))

    best_x = nelder_mead_simplex(simplex)
    return np.array(best_x)
