def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    pop_size = 50
    x0 = np.random.uniform(lb, ub, (pop_size, dim))
    x_best = x0[np.argmin([evaluate(xi) for xi in x0])]

    mutation_rate = 0.1

    gen = 0
    while gen < budget:
        parents = [x_best] + [xi for i, xi in enumerate(x0) if i != np.argmin([evaluate(xi) for xi in x0])]
        offspring = []
        
        for _ in range(pop_size - 2):
            parent1, parent2 = rng.choice(parents, 2, replace=False)
            child = parent1.copy()
            
            for i in range(dim):
                if rng.rand() < mutation_rate:
                    delta = (parent2[i] - parent1[i]) * rng.randn()
                    child[i] += delta
                child = np.clip(child, lb, ub)
                
            offspring.append(child)

        x0 = np.concatenate((x_best[np.newaxis, :], [np.array(xi) for xi in offspring]))
        
        if len(x0) > pop_size:
            x0 = x0[:pop_size]

        gen += 1

    return x_best
