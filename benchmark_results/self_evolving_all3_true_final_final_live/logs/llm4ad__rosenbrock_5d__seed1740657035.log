def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidates):
        return np.clip(candidates, lb, ub)

    def rand_bounds(lb, ub, n):
        candidates = []
        for i in range(n):
            r1 = rng.uniform(0.5 * (lb[i] + ub[i]), 0.9 * (lb[i] + ub[i]))
            r2 = rng.uniform(-10, 10)
            candidate = max(lb[i], min(r1 + r2, ub[i]))
            candidates.append(candidate)
        return np.array(candidates)

    def de(func, xbest, dim, lb, ub, niter, rng):
        for _ in range(niter):
            v = rand_bounds(lb, ub, dim) - xbest
            x = clip(xbest + 0.5 * v)
            f = func(x)
            if f < func(xbest):
                xbest = x
        return xbest

    def gradient(func, x, eps=1e-6):
        n = len(x)
        grad = np.zeros(n)
        for i in range(n):
            dx = np.zeros(n)
            dx[i] = 1
            fplus = func(clip(x + dx * eps))
            fminus = func(clip(x - dx * eps))
            grad[i] = (fplus - fminus) / (2.0 * eps)
        return grad

    xbest = rand_bounds(lb, ub, dim)
    niter = budget // 10
    for _ in range(budget):
        xnew = de(func, xbest, dim, lb, ub, niter, rng)
        g = gradient(func, xnew)
        step = -0.5 * (g / np.sum(g**2))
        new_x = clip(xnew + 1e-3 * step)
        if func(new_x) < func(xbest):
            xbest = new_x
    return xbest
