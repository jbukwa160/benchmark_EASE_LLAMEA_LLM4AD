def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(size, dim, lb, ub):
        population = np.random.uniform(lb, ub, size=(size, dim))
        return population

    def differential_evolution(population, func, dim, lb, ub, budget):
        for _ in range(budget):
            targets = rng.choice(population, size=3, replace=False)
            z = 0.5 * (targets[0] + targets[1])
            candidate = clip(z + rng.uniform(-1, 1) * (targets[2] - targets[0]))
            candidate = np.clip(candidate, lb, ub)
            offspring = func(candidate)
            best = np.argmin(func(population))
            if offspring < func(population[best]):
                population[best] = candidate
        return population

    def find_global_minimum(population):
        global_min = np.argmin(np.array([func(x) for x in population]))
        return population[global_min]

    population = generate_initial_population(100, dim, lb, ub)
    population = differential_evolution(population, func, dim, lb, ub, budget//2)
    best_candidate = find_global_minimum(population)
    return best_candidate
