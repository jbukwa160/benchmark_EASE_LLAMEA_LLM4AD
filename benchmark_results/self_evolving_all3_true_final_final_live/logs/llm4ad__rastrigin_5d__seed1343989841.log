def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def get_bounds():
        x = rng.uniform(-1e6, 1e6)
        return clip(x), clip(x + 0.5 * (ub - lb))

    n_samples = int(np.ceil(budget / dim))
    population_size = max(4 * dim, 10) if n_samples >= 10 else n_samples
    pop_size = [population_size] * dim

    x_best = np.zeros(dim)
    f_best = float('inf')

    for _ in range(n_samples):
        x_init, _ = get_bounds()
        cma_x = x_init

        for i in range(population_size):
            if rng.random() < 0.5:
                noise = rng.normal(0, 1, dim)
                cma_x += rng.uniform(-1e-3, 1e-3) * noise
                cma_x = clip(cma_x)

        f_cma = func(cma_x)

        if f_cma < f_best:
            x_best = cma_x.copy()
            f_best = f_cma

    return x_best
