def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    best_x = None
    best_f = float('inf')
    
    for _ in range(budget):
        X = rng.uniform(lb, ub, (pop_size, dim))
        
        for i in range(pop_size):
            f_i = func(X[i])
            
            if f_i < best_f:
                best_f = f_i
                best_x = X[i]
                
        F = 0.5 + 0.2*rng.rand()
        CR = 0.9 + 0.1*rng.rand()
        
        for i in range(pop_size):
            r1, r2, r3 = rng.choice(range(pop_size), size=3, replace=False)
            
            v_i = X[r1] + F*(X[r2] - X[r3])
            v_i[v_i < lb] = lb
            v_i[v_i > ub] = ub
            
            for j in range(dim):
                if rng.rand() < CR or X[r1, j] != v_i[j]:
                    X[r1, j] = v_i[j]
                    
    return best_x
