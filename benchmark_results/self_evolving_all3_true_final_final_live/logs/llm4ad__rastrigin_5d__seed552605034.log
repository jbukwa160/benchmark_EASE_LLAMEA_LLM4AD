def algorithm(func, dim, lb, ub, budget, rng):
    def fitness(x):
        return func(x) + 1e6 * (np.sum(np.abs(x - lb)) + np.sum(np.abs(ub - x)))

    pop_size = int(budget ** 0.5)
    population = np.random.uniform(lb, ub, (pop_size, dim))
    temperature = budget / np.log(pop_size)

    for _ in range(int(budget)):
        new_population = np.copy(population)
        fitness_values = np.array([fitness(x) for x in population])

        idx = np.argsort(fitness_values)[:int(0.2 * pop_size)]
        new_population[idx] = population[idx]

        for i in range(pop_size):
            if rng.random() < 0.1:
                x = population[i]
                delta = (rng.uniform(lb, ub) - x) / temperature
                new_x = np.clip(x + delta, lb, ub)
                new_population[i] = new_x

        fitness_new_values = np.array([fitness(x) for x in new_population])
        idx_sorted = np.argsort(fitness_new_values)

        if fitness_new_values[idx_sorted[0]] < fitness_values[idx_sorted[0]]:
            population = new_population
            temperature *= 0.99
        else:
            probability = np.exp((fitness_new_values[idx_sorted[0]] - fitness_values[idx_sorted[0]]) / (temperature * rng.random()))
            if rng.random() < probability:
                population = new_population

    best_idx = np.argmin([func(x) for x in population])
    return population[best_idx]
