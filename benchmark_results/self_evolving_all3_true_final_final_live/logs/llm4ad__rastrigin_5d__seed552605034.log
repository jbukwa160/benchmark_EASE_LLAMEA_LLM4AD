def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_y = float('inf')
    
    for i in range(budget):
        x = np.zeros(dim)
        
        # Generate a random solution within the bounds
        for j in range(dim):
            x[j] = lb + (ub - lb) * rng.uniform()
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
        
        y = func(x)
        
        if y < best_y:
            best_x = x
            best_y = y
        
        # Local refinement phase: perturb the current solution within a small radius
        alpha = 0.1 * (ub - lb)  # radius of perturbation
        for j in range(dim):
            x[j] += rng.uniform(-alpha, alpha)
        
        x = np.clip(x, lb, ub)  # clip to bounds
        
        y = func(x)
        
        if y < best_y:
            best_x = x
            best_y = y
    
    return best_x
