def algorithm(func, dim, lb, ub, budget, rng):
    def get_bounds(dim):
        bounds = []
        for i in range(dim):
            bounds.append([lb, ub])
        return bounds

    def differential_evolution(func, x0, bounds, mut, cross_prob, maxiter, rng=np.random):
        nvar = len(x0)
        pop_size = 50
        ngen = maxiter
        x = np.zeros((pop_size, nvar))
        for i in range(pop_size):
            x[i] = lb + (ub - lb) * rng.rand(nvar)

        score = np.zeros(pop_size)
        for i in range(pop_size):
            score[i] = func(x[i])

        for gen in range(ngen):
            mutated_pop = np.zeros((pop_size, nvar))
            for i in range(pop_size):
                r1, r2, r3 = rng.randint(0, pop_size, 3)
                while r1 == i or r2 == i or r3 == i:
                    r1, r2, r3 = rng.randint(0, pop_size, 3)

                mutated_pop[i] = x[r1] + mut * (x[r2] - x[r3])
                if rng.rand() < cross_prob:
                    mutated_pop[i][np.random.choice(nvar, nvar, replace=False)] = x[i]

            mutated_pop = np.clip(mutated_pop, bounds[0], bounds[1])

            score_mutated = np.zeros(pop_size)
            for i in range(pop_size):
                score_mutated[i] = func(mutated_pop[i])

            mask = score_mutated < score
            score[mask] = score_mutated[mask]
            x[mask] = mutated_pop[mask]

        return x[np.argmin(score)], np.min(score)

    best_x, best_score = differential_evolution(func, [0]*dim, get_bounds(dim), 0.5, 0.7, budget, rng)
    return best_x
