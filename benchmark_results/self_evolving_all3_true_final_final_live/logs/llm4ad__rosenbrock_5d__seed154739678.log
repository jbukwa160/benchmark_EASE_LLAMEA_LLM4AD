def algorithm(func, dim, lb, ub, budget, rng):
    def fitness(x):
        return func(x)

    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def mutation(x, t):
        v = rng.uniform(-1, 1, size=dim)
        return x + t * v

    def crossover(u, v, F):
        c = u + F * (v - u)
        return np.where(rng.uniform(0, 1, size=dim) < 0.5, clip(c), clip(u))

    def acceptance(x, x_new, T):
        if fitness(x_new) <= fitness(x) or rng.uniform(0, 1) < np.exp(-(fitness(x_new) - fitness(x)) / T):
            return x_new
        else:
            return x

    best = lb + (ub - lb) * rng.uniform(size=dim)
    t = 1.0
    for _ in range(budget):
        u = mutation(best, t)
        v = mutation(best, t)
        c = crossover(u, v, rng.uniform(0, 2))
        best_new = acceptance(c, clip(v), 100 * (budget - _) / budget)
        if fitness(best_new) < fitness(best):
            best = best_new
        t *= 0.99

    return best
