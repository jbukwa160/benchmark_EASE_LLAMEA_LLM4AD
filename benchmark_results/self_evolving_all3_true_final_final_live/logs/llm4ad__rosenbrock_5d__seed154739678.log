def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    temp = 1.0
    cooling_rate = 0.99
    perturbation_size = 1e-3
    perturbation_rate = 0.01

    best_x = clip(x.copy())
    best_y = func(best_x)

    for i in range(budget):
        y = np.inf

        # Differential Evolution
        candidate = x + perturbation_size * rng.uniform(-1, 1, size=dim)
        candidate = clip(candidate)
        y_candidate = func(candidate)

        if y_candidate < y:
            y = y_candidate
            best_x = candidate.copy()
            x = candidate.copy()

        # Simulated Annealing
        if rng.rand() < perturbation_rate or np.isinf(y):
            temp *= cooling_rate

            for j in range(dim):
                delta = rng.uniform(-temp, temp)
                candidate_j = x[j] + delta
                candidate_j = clip(candidate_j)

                y_candidate_j = func(np.copy(x))
                y_candidate_j -= 100 * (candidate_j - x[(j+1) % dim]**2)**2

                if y_candidate_j < y:
                    y = y_candidate_j
                    best_x[j] = candidate_j
                    x[j] = candidate_j

    return np.array(best_x)
