def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    def mutate(mean, std_dev):
        x = mean + std_dev * rng.randn(dim)
        return bound(x)

    def evaluate(x):
        return func(x)

    n_pop = 50
    pop = [rng.uniform(lb, ub) for _ in range(n_pop)]
    cov = np.eye(dim)
    learning_rate = 0.01

    for i in range(budget):
        new_pop = []
        for j in range(n_pop):
            if rng.rand() < 0.1:  # elitism
                new_pop.append(pop[j])
            else:
                x_mean = np.mean([x[j] for x in pop], axis=0)
                std_dev = np.sqrt(np.diag(cov))
                noise = mutate(x_mean, std_dev)
                new_x = evaluate(noise) - evaluate(x_mean)
                if rng.rand() < 0.5:  # adapt learning rate
                    learning_rate *= 1 + (new_x / rng.uniform(-1, 1)) * 0.01
                cov += learning_rate * np.outer(new_x, new_x)
                new_pop.append(pop[j] + learning_rate * new_x)

        pop = new_pop

    best_x = min(pop, key=evaluate)
    return bound(best_x)
