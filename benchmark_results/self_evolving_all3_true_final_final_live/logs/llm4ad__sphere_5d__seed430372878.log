def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    for _ in range(budget):
        x_new = np.clip(x_best + rng.randn(dim), lb, ub)
        f_new = func(x_new)
        if f_new < func(x_best):
            x_best = x_new
    return x_best
