def algorithm(func, dim, lb, ub, budget, rng):
    def eval(x):
        return func(np.clip(x, lb, ub)), []

    n = len(rng)
    mu = 1.0 / n * np.sum(rng, axis=0)
    c_cov = 1.0
    sigma = 2.0

    for _ in range(budget):
        z = rng - mu
        cov = (np.outer(z, z) + c_cov * np.eye(dim)) / n
        v, w = np.linalg.eig(cov)
        w = np.real(w[:, np.newaxis])
        u = sigma * np.sqrt(np.diag(1.0/v))
        x = mu + np.dot(u, w)

        f, grad = eval(x)
        if f < 0:
            return x

        c_cov *= 0.5
        z = (x - mu) / np.sqrt(c_cov)
        cov = np.outer(z, z)
        v, w = np.linalg.eig(cov)
        w = np.real(w[:, np.newaxis])
        u = np.diag(1.0/v)
        mu = x + np.dot(u, w)

    return mu
