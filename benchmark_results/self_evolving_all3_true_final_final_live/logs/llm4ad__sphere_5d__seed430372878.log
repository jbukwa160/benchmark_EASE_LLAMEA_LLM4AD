def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T0 = 1e2
    alpha = 0.95
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        x_new = x + (ub - lb) * rng.rand(dim) - (ub - lb) / 2
        f_new = func(np.clip(x_new, lb, ub))

        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new

        delta = f_new - best_f
        T = max(T0 * alpha ** _, 1e-5)

        if np.random.rand() < np.exp(-delta / T):
            x = x_new.copy()

    return best_x
