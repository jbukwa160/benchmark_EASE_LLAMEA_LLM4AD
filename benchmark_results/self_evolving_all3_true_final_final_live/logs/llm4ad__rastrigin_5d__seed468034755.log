def algorithm(func, dim, lb, ub, budget, rng):
    def func_eval(x):
        x = np.clip(x, lb, ub)
        return func(x)

    def mutation(x, sigma):
        x_mut = x + (rng.uniform(-1, 1, size=dim) * sigma)
        x_mut = np.clip(x_mut, lb, ub)
        return x_mut

    n = dim
    mu = int(0.5 * n)
    lambda_ = 2 * n
    weights = np.log(np.array([lambda_] * (n + 1))) - np.log(n)

    x_mean = rng.uniform(lb, ub, size=dim)
    sigma = 1.0
    cm = np.eye(dim) * 1e-4

    best_x = None
    best_f = float('inf')

    for _ in range(budget):
        y = func_eval(x_mean)

        if y < best_f:
            best_f = y
            best_x = x_mean.copy()

        F = (2 + 2 / (_ + 1)) ** 0.5 - 1
        sigma *= np.exp(F * rng.uniform(-1, 1))

        for _ in range(lambda_):
            z = mutation(x_mean, sigma)
            y_z = func_eval(z)

            if y_z < best_f:
                best_f = y_z
                best_x = z.copy()

            cm += (z - x_mean) * (z - x_mean).T

        x_mean += np.dot(cm / lambda_, rng.normal(size=dim))
        cm *= 1 - 1 / (_ + 2)

    return best_x
