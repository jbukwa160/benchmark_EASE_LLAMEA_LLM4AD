def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def objective(x):
        return func(x)

    x0 = np.random.uniform(lb, ub, size=dim)
    population_size = 10
    sigma = 1.0
    restarts = 5

    for _ in range(restarts):
        population = [clip(rng.normal(x0, scale=sigma, size=dim)) for _ in range(population_size)]
        cma_es(np.array([objective(clip(x)) for x in population]), population_size, sigma)

        best_x = np.array([x for x in population if objective(clip(x)) == min(objective(clip(p)) for p in population)])[0]
        budget -= 1
        if budget <= 0:
            return best_x

    def cma_es(population_fitnesses, n_pop, sigma):
        nonlocal x0
        mean = np.mean(np.array(population), axis=0)
        cov = np.cov(np.array(population).T) + 1e-8 * np.eye(dim)

        for _ in range(100):
            candidate_sigma = sigma * (1 + 2 / (n_pop + 3))
            sample_cov = np.linalg.cholesky(candidate_sigma ** 2 * cov)
            new_population = [clip(mean + sample_cov @ rng.normal(size=dim)) for _ in range(n_pop)]

            new_fitnesses = [objective(clip(x)) for x in new_population]
            if max(new_fitnesses) > min(population_fitnesses):
                population, population_fitnesses = new_population, new_fitnesses
                mean = np.mean(np.array(population), axis=0)
                cov = np.cov(np.array(population).T)

    return best_x
