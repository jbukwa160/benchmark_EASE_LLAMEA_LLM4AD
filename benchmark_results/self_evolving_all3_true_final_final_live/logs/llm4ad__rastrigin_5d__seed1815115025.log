def algorithm(func, dim, lb, ub, budget, rng):
    n = len(dim)
    x_best = -1e9 * np.ones(n)
    f_best = 1e9
    step_size = 2.0
    while budget > 0:
        x_candidate = rng.uniform(lb, ub, size=n) + x_best
        f_candidate = func(x_candidate)
        if f_candidate < f_best or rng.rand() < (f_candidate - f_best) / np.finfo(np.float64).eps:
            x_best = x_candidate
            f_best = f_candidate
        step_size *= 0.99
        budget -= 1
    return x_best
