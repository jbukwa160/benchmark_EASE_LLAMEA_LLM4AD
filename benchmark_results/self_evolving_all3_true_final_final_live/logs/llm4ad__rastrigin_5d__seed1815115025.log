def algorithm(func, dim, lb, ub, budget, rng):
    N = 50
    K = 10
    w = 0.72
    c1 = 2.05
    c2 = 2.05
    p_best = np.random.uniform(lb, ub, (N, dim))
    g_best = np.inf
    v = np.zeros((N, dim))

    for _ in range(budget):
        for i in range(N):
            r1 = rng.uniform(0, 1)
            r2 = rng.uniform(0, 1)
            v[i] = w * v[i] + c1 * r1 * (p_best[i] - np.clip(v[i], lb, ub)) + \
                   c2 * r2 * (g_best - np.clip(p_best[i], lb, ub))
            candidate = p_best[i] + v[i]
            candidate = np.clip(candidate, lb, ub)
            f_candidate = func(candidate)

            if f_candidate < g_best:
                g_best = f_candidate
                g_best_x = candidate

            if f_candidate < func(p_best[i]):
                p_best[i] = candidate

    return g_best_x
