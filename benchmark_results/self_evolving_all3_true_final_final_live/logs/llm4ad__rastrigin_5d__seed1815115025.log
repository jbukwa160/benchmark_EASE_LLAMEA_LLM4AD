def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    pop_size = 50
    population = rng.uniform(lb, ub, (pop_size, dim))
    best = None
    for _ in range(budget):
        differences = np.zeros((pop_size, dim))
        for i in range(pop_size):
            for j in range(pop_size):
                if i != j:
                    differences[i] += 0.5 * rng.uniform(-1, 1) * (population[j] - population[i])
        new_population = population + 0.01 * differences
        new_population = clip(new_population, lb, ub)
        for i in range(pop_size):
            if func(new_population[i]) < func(best):
                best = new_population[i]
    return best
