def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = evaluate(x)

    n_iter = 0
    while n_iter < budget:
        v = np.clip(rng.normal(size=(1, dim), loc=best_x, scale=np.mean(ub - lb)) + rng.uniform(size=(1, dim), low=-1, high=1),
                    a_min=lb, a_max=ub)
        u = np.clip(best_x + 0.5 * (v - best_x) + 0.5 * rng.normal(size=(1, dim)),
                    a_min=lb, a_max=ub)

        f_v = evaluate(v)
        f_u = evaluate(u)

        if f_v < f_u and f_v < best_f:
            best_x, best_f = v, f_v

        elif f_u < f_v and f_u < best_f:
            best_x, best_f = u, f_u

        n_iter += 1

    return best_x
