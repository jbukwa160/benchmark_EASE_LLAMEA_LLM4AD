def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        v1 = rng.normal(size=dim)
        v2 = rng.normal(size=dim)
        v3 = rng.normal(size=dim)
        a = 0.5
        b = 1.0

        y1 = clip(best_x + a * (v1 - best_x))
        f1 = func(y1)

        y2 = clip(best_x + b * (v2 - best_x))
        f2 = func(y2)

        if f1 < best_f:
            best_f = f1
            best_x = y1.copy()
        elif f2 < best_f:
            best_f = f2
            best_x = y2.copy()

        v3 = (v1 + v2) / np.linalg.norm(v1 + v2)
        y3 = clip(best_x + 0.5 * b * (v3 - best_x))
        f3 = func(y3)

        if f3 < best_f:
            best_f = f3
            best_x = y3.copy()

    return best_x
