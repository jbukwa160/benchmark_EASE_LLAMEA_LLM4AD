def algorithm(func, dim, lb, ub, budget, rng):
    def rbfn(x, centers, sigmas):
        return sum((1 / (2 * sigma_i ** 2)) * np.exp(-np.linalg.norm(x - center_i) ** 2 / (2 * sigma_i ** 2)) for i, (center_i, sigma_i) in enumerate(zip(centers.T, sigmas)))

    def nelder_mead_simplex(x0, func, dim):
        simplex = np.random.rand(dim + 1, dim) @ np.diag([1] * dim + [10])
        simplex -= lb + (ub - lb) * rng.uniform(size=(dim + 1, dim))
        for i in range(budget):
            centroid = np.mean(simplex[:-1], axis=0)
            f_centroid = func(centroid)

            # sort
            sort_idx = np.argsort([func(x) for x in simplex])
            simplex[sort_idx[-1]] = centroid

            # Reflection
            if f_centroid < func(simplex[-1]):
                new_x = 2 * centroid - simplex[sort_idx[-2]]
                if func(new_x) < f_centroid:
                    simplex[sort_idx[-1]] = new_x

            # Expansion
            elif np.any([func(x) < f_centroid for x in simplex[:-1]]) and i > budget / 3:
                new_x = centroid + (centroid - simplex[sort_idx[np.argmax([func(x) < f_centroid for x in simplex[:-1]])]])
                if func(new_x) < f_centroid:
                    simplex[sort_idx[-1]] = new_x

            # Contraction
            else:
                centroid = np.mean(simplex, axis=0)
                new_x = 2 * centroid - simplex[sort_idx[-2]]
                simplex[sort_idx[-1]] = new_x
        return simplex[0]

    centers = [np.array([i for i in rng.uniform(lb, ub, dim)]) for _ in range(dim)]
    sigmas = np.exp(rng.uniform(-3, 0, dim))
    best_candidate = nelder_mead_simplex(np.zeros(dim), func, dim)
    while len(centers) < budget:
        new_center = rbfn(best_candidate, centers, sigmas)
        if rng.random() < 1 / (len(centers) + 1):
            idx = np.argmax([rbfn(x, centers, sigmas) for x in [np.array([i for i in rng.uniform(lb, ub, dim)]) for _ in range(dim)]])
            new_center = np.array([i for i in rng.uniform(lb, ub, dim)])
        best_candidate = nelder_mead_simplex(new_center, func, dim)
        centers.append(best_candidate)

    return nelder_mead_simplex(np.mean(centers, axis=0), func, dim)
