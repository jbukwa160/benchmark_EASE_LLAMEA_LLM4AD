def algorithm(func, dim, lb, ub, budget, rng):
    def clipped(x):
        return np.clip(x, lb, ub)

    def rastrigin(x):
        return func(clipped(x))

    def generate_initial_population(size, dim):
        return rng.uniform(-5.0, 5.0, (size, dim))

    def calculate_fitness(population):
        return [rastrigin(x) for x in population]

    def select_parents(population, fitness, budget):
        indices = np.argsort(fitness)[:budget]
        return population[indices], fitness[indices]

    def crossover(parents, rng):
        children = []
        for i in range(budget // 2):
            p1, p2 = parents[i * 2], parents[i * 2 + 1]
            child = np.array(p1) + 0.5 * (np.array(p2) - np.array(p1)) * rng.uniform(0, 1)
            children.append(child)
        return children

    def mutate(children, dim):
        for i in range(len(children)):
            for j in range(dim):
                if rng.uniform(0, 1) < 0.01:
                    children[i][j] += 0.5 * rng.uniform(-5.0, 5.0)
        return children

    def restart(population, fitness, budget, dim, lb, ub, rng):
        return generate_initial_population(budget, dim), calculate_fitness(generate_initial_population(budget, dim))

    population = generate_initial_population(budget, dim)
    fitness = calculate_fitness(population)

    for i in range(1000):  # number of generations
        parents, _ = select_parents(population, fitness, budget // 2)
        children = crossover(parents, rng)
        mutated_children = mutate(children, dim)
        new_population = np.concatenate((parents, mutated_children))
        new_fitness = calculate_fitness(new_population)

        if i % 100 == 0:
            print('Generation:', i, 'Best fitness:', min(new_fitness))

        population, fitness = restart(population, fitness, budget // 2, dim, lb, ub, rng) if np.mean(fitness) > 10 else (new_population, new_fitness)

    best_idx = np.argmin(fitness)
    return population[best_idx]
