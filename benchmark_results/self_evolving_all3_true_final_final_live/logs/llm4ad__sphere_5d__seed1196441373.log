def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_so_far = None
    avg_best = 0
    num_restarts = 10
    restart_interval = int(budget / num_restarts)
    
    for i in range(1, budget + 1):
        candidate = rng.uniform(lb, ub, size=dim)
        clipped_candidate = clip(candidate)

        value = func(clipped_candidate)
        
        if best_so_far is None or value < avg_best:
            best_so_far = clipped_candidate
            avg_best = (i - 1) * avg_best / i + value / i
            
        # early stopping if the moving average of the best-so-far solution has not improved for a while
        if i % restart_interval == 0 and avg_best < func(best_so_far):
            avg_best = 0
            best_so_far = None

    return best_so_far
