def algorithm(func, dim, lb, ub, budget, rng):
    def gp_model(x, mu, sigma2):
        K = np.zeros((len(x), len(x)))
        for i in range(len(x)):
            for j in range(i+1, len(x)):
                K[i,j] = K[j,i] = np.exp(-np.sum(np.square(x[i]-x[j])))
        return mu + np.sqrt(sigma2) * np.dot(K, np.linalg.solve(np.eye(len(x)) + np.dot(K.T, K), np.random.randn(len(x))))

    def gp_acquisition(x, mu, sigma2):
        return -func(x)

    x = rng.uniform(lb, ub, (1, dim))
    best_x = x
    best_f = func(x)
    budget_used = 0

    while budget_used < budget:
        f, mu, sigma2 = gp_model(x, 0, 1), 0, 1
        acquisition = gp_acquisition(x, mu, sigma2)

        new_x = rng.normal(x, 0.5 * (ub - lb))
        new_x = np.clip(new_x, a_min=lb, a_max=ub)
        new_f = func(new_x)

        if new_f < f:
            x = new_x
            best_x = x
            best_f = new_f

        budget_used += 1

    return best_x
