def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)
    r = 5.0  # Initial radius
    for _ in range(budget):
        x_cand = x_best + r * np.random.normal(size=dim)
        x_cand = np.clip(x_cand, lb, ub)  # Clip to bounds
        f_cand = func(x_cand)
        if f_cand < f_best:
            x_best = x_cand
            f_best = f_cand
        r *= 0.9  # Reduce radius by 10%
    return x_best
