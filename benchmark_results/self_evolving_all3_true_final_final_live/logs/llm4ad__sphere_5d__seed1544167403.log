def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(dim,))
    for _ in range(budget):
        g = np.array([2 * x_i for x_i in func(x)])
        step_size = 0.1 / (1 + np.linalg.norm(g))
        x_new = x - step_size * g
        x_new = np.clip(x_new, lb, ub)
        if np.any(np.isnan(x_new)):
            return x
        x = x_new
    return x
