def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = clip(rng.uniform(lb, ub, size=dim))
    t = 1.0
    best_x = x.copy()
    best_fx = func(x)
    
    for _ in range(budget):
        y = clip(best_x + rng.normal(size=dim) * 0.01)
        
        if rng.random() < np.exp((best_fx - func(y)) / t):
            best_x = y
            best_fx = func(y)
        
        t *= 0.99
        
    return best_x
