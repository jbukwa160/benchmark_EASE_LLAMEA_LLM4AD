def algorithm(func, dim, lb, ub, budget, rng):
    D = 1e-6
    x_best = lb + (ub - lb) * rng.uniform(size=dim)
    best_f = func(x_best)

    for i in range(budget):
        # Sample a new point from the current model
        mu, sigma = gp.predict(np.array([x_best]).T, eval_MF=True)
        x_new = x_best + D * np.random.randn(dim) * sigma

        # Clip to bounds
        x_new = np.clip(x_new, lb, ub)

        # Evaluate function at new point
        f_new = func(x_new)

        # Update the model with new data
        gp.fit(np.array([x_best]).T, best_f + 1e-4 * rng.randn(), np.array([[sigma]]))

        # Check if new point is better than current best
        if f_new < best_f:
            x_best = x_new
            best_f = f_new

    return x_best
