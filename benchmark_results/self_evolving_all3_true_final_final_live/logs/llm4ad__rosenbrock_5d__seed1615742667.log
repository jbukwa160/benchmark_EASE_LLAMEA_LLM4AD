def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(mean, sigma):
        return mean + sigma * rng.normal(size=(dim,))

    def evaluate(x):
        return func(x)

    best_x = np.zeros((dim,))
    best_f = float('inf')

    pop_size = 10
    sigma = 2.0
    step_count = 0
    while step_count < budget:
        candidates = [get_candidate(best_x, sigma) for _ in range(pop_size)]
        clipped_candidates = np.clip(candidates, lb, ub)
        scores = [evaluate(x) for x in clipped_candidates]

        best_idx = np.argmin(scores)
        if scores[best_idx] < best_f:
            best_x = clipped_candidates[best_idx]
            best_f = scores[best_idx]

        if step_count % 10 == 0: # adaptive learning rate and variance reduction
            sigma *= 0.9

        for i in range(pop_size):
            if i != best_idx:
                sigma -= (scores[i] - best_f) * 0.01

        step_count += 1

    return best_x
