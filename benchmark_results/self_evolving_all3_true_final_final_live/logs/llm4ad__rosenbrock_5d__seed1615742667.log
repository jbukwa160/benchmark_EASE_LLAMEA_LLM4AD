def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(solution):
        return func(solution)

    pop_size = 50
    crossover_prob = 0.9
    mutation_prob = 0.1
    restart_budget = 10

    best_solution = np.random.uniform(lb, ub, size=dim)
    best_fitness = float('inf')

    for _ in range(budget):
        population = clip(rng.uniform(lb, ub, (pop_size, dim)))
        fitnesses = [evaluate(solution) for solution in population]

        idx_best = np.argmin(fitnesses)
        if fitnesses[idx_best] < best_fitness:
            best_solution = population[idx_best]
            best_fitness = fitnesses[idx_best]

        if rng.random() < mutation_prob:
            mutated_solutions = population + 0.5 * rng.uniform(-1, 1, size=(pop_size, dim))
            mutated_fitnesses = [evaluate(solution) for solution in mutated_solutions]
            idx_new_best = np.argmin(mutated_fitnesses)
            if mutated_fitnesses[idx_new_best] < best_fitness:
                population[idx_best] = mutated_solutions[idx_new_best]
                fitnesses[idx_best] = mutated_fitnesses[idx_new_best]

        if rng.random() < crossover_prob:
            parent1_idx, parent2_idx = np.random.choice(pop_size, 2, replace=False)
            child_solution = (population[parent1_idx] + population[parent2_idx]) / 2
            child_fitness = evaluate(child_solution)
            idx_child = np.argmin([fitnesses[parent1_idx], fitnesses[parent2_idx]])
            if child_fitness < fitnesses[idx_child]:
                population[idx_child] = child_solution
                fitnesses[idx_child] = child_fitness

        best_solution = clip(best_solution)

    return best_solution
