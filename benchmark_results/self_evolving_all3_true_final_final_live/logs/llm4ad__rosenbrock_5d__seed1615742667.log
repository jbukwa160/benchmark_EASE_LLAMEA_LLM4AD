def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(candidate):
        return func(candidate)

    population_size = 20
    mean = (ub + lb) / 2 * np.ones(dim)
    sigma = 0.5
    best_candidate = mean.copy()
    best_fitness = float('inf')

    restart_counter = 0
    while budget > 0:
        sample_indices = rng.choice(population_size, size=population_size, replace=False)
        candidates = clip(mean + np.sqrt(sigma) * rng.randn(dim, population_size))
        
        fitnesses = np.array([evaluate(candidate) for candidate in candidates.T])
        
        best_candidate_new = candidates[np.argmin(fitnesses)]
        if fitnesses.min() < best_fitness:
            mean = (mean + sigma * rng.randn(dim)) / 2
            sigma *= 0.95
            best_candidate, best_fitness = clip(best_candidate_new.copy(), lb, ub)
            restart_counter = 0
        else:
            mean = (mean + np.sum(candidates * fitnesses[:, None], axis=1) / population_size) 
            sigma = min(2 * sigma, (np.std(fitnesses) ** 2 + 1e-8) ** 0.5)
        
        budget -= 1
        
        if best_fitness < 1e-6 or restart_counter > 10:
            return clip(best_candidate)

    return clip(best_candidate)
