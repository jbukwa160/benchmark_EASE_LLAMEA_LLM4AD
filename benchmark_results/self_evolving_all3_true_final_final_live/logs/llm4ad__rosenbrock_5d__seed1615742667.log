def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    population_size = 100
    ensemble_size = 5
    mutation_rate = 0.1
    num_generations = int(budget / (dim * population_size))

    initial_population = rng.uniform(lb, ub, size=(population_size, dim))
    best_solution_found = np.inf

    for _ in range(num_generations):
        ensemble = []
        for _ in range(ensemble_size):
            candidate = clip(initial_population[rng.randint(0, population_size), :], lb, ub)
            ensemble.append(func(candidate))

        ensemble.sort()
        threshold = ensemble[int((len(ensemble) - 1) * (populationsize/ensemble_size))]

        new_population = np.zeros((population_size, dim))
        for i in range(population_size):
            if rng.random() < mutation_rate:
                idx = rng.randint(0, population_size)
                candidate = clip(initial_population[idx, :] + rng.uniform(-1, 1, size=dim), lb, ub)
            else:
                idx = rng.randint(0, population_size)
                candidate = initial_population[idx, :]
            new_population[i, :] = candidate

        new_population[:, :] = np.where(new_population > threshold, new_population, clip(initial_population[rng.randint(0, population_size), :], lb, ub))

        initial_population = new_population
        best_solution_found = min(best_solution_found, ensemble[-1])

    return np.array([best_solution_found])
