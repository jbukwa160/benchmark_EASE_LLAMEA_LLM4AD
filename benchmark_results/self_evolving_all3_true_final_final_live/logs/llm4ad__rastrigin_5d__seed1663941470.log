def algorithm(func, dim, lb, ub, budget, rng):
    def differential_evolution(pop_size=50, crossover_prob=0.5, mutation_factor=0.1, population=None, x_best=None):
        if population is None:
            population = rng.uniform(lb, ub, (pop_size, dim))
        if x_best is None:
            x_best = population[0]
        
        for _ in range(population.shape[0]):
            for i in range(pop_size):
                r1, r2, r3 = np.random.choice(range(pop_size), 3, replace=False)
                v = mutation_factor * (population[r1] - population[r2]) + crossover_prob * population[r3]
                if rng.uniform(0, 1) < 0.5:
                    v[i] = population[r1][i]
                v[v > ub] = ub
                v[v < lb] = lb
                
                f_v = func(v)
                f_x_best = func(x_best)
                
                if f_v < f_x_best:
                    x_best = v
        
        return x_best
    
    best_solution = np.zeros(dim)
    
    for _ in range(budget):
        solution = differential_evolution(population=np.array([best_solution]*10), 
                                           crossover_prob=rng.uniform(0.1, 0.9),
                                           mutation_factor=rng.uniform(0.01, 0.5),
                                           population=None,
                                           x_best=best_solution)
        
        if func(solution) < func(best_solution):
            best_solution = solution
    
    return best_solution
