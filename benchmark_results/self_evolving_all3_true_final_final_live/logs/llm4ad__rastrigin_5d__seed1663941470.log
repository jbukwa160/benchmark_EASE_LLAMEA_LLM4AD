def algorithm(func, dim, lb, ub, budget, rng):
    res = differential_evolution(lambda x: func(x), [(lb, ub)]*dim, 
                                maxiter=budget, 
                                polish=True, 
                                init='latinhypercube', 
                                x0=None, 
                                strategy='best1exp', 
                                mutation=0.5, 
                                recombination=1.0, 
                                seed=rng.randint(2**32))
    return res.x
