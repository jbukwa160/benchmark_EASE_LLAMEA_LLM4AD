def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    n = 20  # number of particles
    D = rng.uniform(lb, ub, size=(n, dim))  # initialize particles
    f_best = float('inf')  # best fitness found so far

    for _ in range(budget):
        F = rng.uniform(0.5, 1.5)  # mutation factor
        CR = rng.uniform(0.1, 0.9)  # crossover rate
        D_prime = np.zeros((n, dim))  # new particles

        for i in range(n):
            temp1 = clip(D[i] + F * (D[rng.randint(0, n), :] - D[i]))
            temp2 = clip(temp1 + rng.uniform(-1, 1) * (temp1 - D[i]))

            if rng.rand() < CR:
                D_prime[i] = temp2
            else:
                D_prime[i] = D[i]

        f_values = np.array([func(clip(candidate)) for candidate in D_prime])

        idx_best = np.argmin(f_values)
        if f_values[idx_best] < f_best:
            f_best = f_values[idx_best]
            best_candidate = clip(D_prime[idx_best])
        else:
            idx_worst = np.argmax(f_values)
            alpha = 0.95
            beta = 0.01

            for i in range(n):
                if rng.rand() < beta:
                    D[i] = clip(np.array([ub + (lb - ub) * rng.rand() for _ in range(dim)]))
                elif rng.rand() < (1 - alpha):
                    D[i] = clip(D_prime[idx_best])
                else:
                    temp3 = clip(D[i] + np.exp(rng.uniform(-10, 0)) * (D[rng.randint(0, n), :] - D[i]))
                    D[i] = temp3

    return best_candidate
