def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    n = int(np.ceil(budget / (2 * dim)))
    x_best = np.zeros(dim)
    f_best = float('inf')
    for i in range(n):
        if i == 0:
            x = rng.uniform(lb, ub, size=(1, dim))
        else:
            s = np.sqrt(ub - lb) / 2.0
            x = clip(x_best + (rng.normal(size=(1, dim)) * s))
        f = func(x)
        if f < f_best:
            x_best = x
            f_best = f
    return x_best
