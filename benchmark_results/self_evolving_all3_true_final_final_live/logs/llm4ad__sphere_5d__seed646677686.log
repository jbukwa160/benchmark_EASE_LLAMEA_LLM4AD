def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for i in range(budget):
        s_i = np.linalg.norm(rng.randn(dim))  # generate standard normal noise
        x_new = x_best + s_i * (x_best - lb) / np.linalg.norm(x_best - lb)
        f_new = func(np.clip(x_new, a_min=lb, a_max=ub))

        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return np.clip(x_best, a_min=lb, a_max=ub)
