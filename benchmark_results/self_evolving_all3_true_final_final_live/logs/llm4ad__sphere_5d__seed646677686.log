def algorithm(func, dim, lb, ub, budget, rng):
    def wrap_func(x):
        return func(x)

    bounds = [(lb, ub) for _ in range(dim)]
    res = differential_evolution(wrap_func, bounds, x0=rng.uniform(lb, ub, (dim,)), maxiter=budget)
    best_x = np.clip(res.x, lb, ub)
    
    return best_x
