def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.ones(dim)
    f_best = float('inf')
    
    def surrogate(x):
        return 0
    
    def gaussian_process(x):
        mu = np.zeros(len(x))
        sigma = 1
        return {'mu': mu, 'sigma': sigma}
    
    for _ in range(budget):
        gp = gaussian_process(rng.uniform(-5, 5, size=dim))
        
        # Sample from GP to get x_new
        mean, std = gp['mu'], gp['sigma']
        x_new = rng.normal(mean, std)
        
        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)
        
        # Evaluate the objective function f(x) at x_new
        f_new = func(x_new)
        
        # Update GP parameters using EI
        ei = 0.5 * (f_best - f_new)
        gp['mu'] += ei
        
        # Update best solution if necessary
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
    
    return x_best
