def algorithm(func, dim, lb, ub, budget, rng):
    x = 5 * np.random.rand(dim) - 2.5
    best_x = x.copy()
    lambda_ = int(np.sqrt(budget)) + 1
    mu = lambda_ // 2
    sigma = (ub - lb) / 3
    c = 0.8

    for _ in range(1, budget):
        x_new = np.clip(x + rng.randn(dim), lb, ub)
        f_new = func(x_new)
        f_best = func(best_x)

        if f_new < f_best:
            best_x = x_new.copy()

        if rng.rand() < 0.5:
            sigma *= (1 - c * rng.uniform(0, 1))

        x = x + rng.randn(dim) * sigma
        x = np.clip(x, lb, ub)

    return best_x
