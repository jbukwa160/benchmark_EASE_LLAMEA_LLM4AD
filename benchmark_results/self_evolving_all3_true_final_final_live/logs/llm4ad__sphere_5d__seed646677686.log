def algorithm(func, dim, lb, ub, budget, rng):
    def neg_func(x):
        return -func(x)

    res = minimize(neg_func, 0.5 * (ub + lb) * rng.randn(dim), method='SLSQP', bounds=[(lb, ub)] * dim)
    
    return res.x
