def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(best_x)
    f = func(x)

    t = 1.0
    while True:
        if budget <= 0:
            break

        new_x = clip(x + rng.normal(size=x.shape) * (ub - lb))
        new_f = func(new_x)

        if new_f < best_f:
            x = new_x.copy()
            f = new_f
            best_x = new_x.copy()
            best_f = new_f
        elif np.random.rand() < np.exp(-(new_f - f) / t):
            x = new_x.copy()
            f = new_f

        if rng.uniform(0, 1) < 0.01 and budget > 100:
            # Occasionally restart with a random solution
            x = clip(rng.uniform(lb, ub, size=(dim,)))
            f = func(x)
            best_x = x.copy()
            best_f = f

        t *= 0.99  # Decrease the temperature over time

        budget -= 1

    return best_x
