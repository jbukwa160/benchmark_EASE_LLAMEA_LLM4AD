def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    N = 10 * dim
    pop_size = min(N, budget)
    x = (ub - lb) * rng.rand(pop_size, dim) + lb

    for i in range(budget):
        f_x = np.array([evaluate(xi) for xi in x])
        idx = np.argsort(f_x)[:int(pop_size / 2)]
        y = x[idx]
        z = y.copy()
        for j in range(dim):
            r1, r2, r3 = rng.randint(0, pop_size, size=3)
            while r1 == r2 or r1 == r3 or r2 == r3:
                r1, r2, r3 = rng.randint(0, pop_size, size=3)
            F = 0.8
            V = F * (y[r1, j] - y[r2, j]) + z[r3, j]
            if rng.rand() < 0.5:
                x[r3, j] = z[r3, j] + V
            else:
                x[r3, j] = z[r3, j] - V

        # clip to bounds
        x = np.clip(x, lb, ub)
    return x[np.argmin(evaluate(x))]
