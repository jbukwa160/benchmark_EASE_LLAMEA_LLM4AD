def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    sigma = 0.5 * (ub - lb) / 1.4
    mu = int(budget / 10)
    lambda_ = mu + 1
    
    while budget > 0:
        z = rng.randn(mu, dim)
        
        y = np.clip(x_best + z * sigma, lb, ub)
        f_y = func(y)
        
        I = np.argsort(f_y)
        u = I[:lambda_]
        v = I[-mu:]
        w = np.arange(lambda_, mu)
        
        x_u = np.copy(y[u])
        x_v = np.copy(y[v])
        x_w = np.copy(y[w])
        
        for i in range(mu):
            if rng.random() < 0.1:
                x_w[i] = np.clip(x_best + z[i] * sigma, lb, ub)
            
            f_xw = func(np.clip(x_w[i], lb, ub))
            
            if f_xw < f_best and f_xw <= f_y[u[i]] or rng.random() < 0.1:
                x_u[i] = np.copy(x_w[i])
        
        if rng.random() < 0.05:
            for i in range(mu):
                r = rng.randn(dim)
                x_v[i] += np.clip(r * sigma, -sigma, sigma)
                f_xv = func(np.clip(x_v[i], lb, ub))
                
                if f_xv < f_best and f_xv <= f_y[u[i]]:
                    x_u[i] = np.copy(x_v[i])
        
        x_best_new = np.mean(x_u[:lambda_], axis=0)
        f_best_new = func(np.clip(x_best_new, lb, ub))
        
        if f_best_new < f_best:
            f_best = f_best_new
            x_best = np.copy(x_best_new)
        
        budget -= 1
    
    return np.copy(x_best)
