def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.minimum(np.maximum(x, lb), ub)

    def generate_initial_population(size, dim, lb, ub):
        return np.clip(rng.uniform(lb, ub, (size, dim)), lb, ub)

    def pso_step(population, best_solution, func, dim, budget):
        velocity = np.zeros_like(population)
        for _ in range(budget // 2):
            for i in range(len(population)):
                velocity[i] += rng.uniform(-1, 1) * population[i]
                new_position = clip(velocity[i], lb, ub)
                if func(new_position) < func(best_solution):
                    best_solution = new_position
        return best_solution

    def de_step(population, func, dim, budget):
        for _ in range(budget // 2):
            indices = rng.permutation(len(population))
            a = population[indices[0]]
            b = population[indices[1]]
            c = population[indices[2]]
            mutant = a + rng.uniform(-1, 1) * (b - c)
            new_position = clip(mutant, lb, ub)
            if func(new_position) < func(population):
                population[:] = new_position
        return population

    population = generate_initial_population(100, dim, lb, ub)
    best_solution = np.inf
    for _ in range(budget // 2):
        pso_best = pso_step(population.copy(), best_solution, func, dim, budget // 4)
        de_best = de_step(population.copy(), func, dim, budget // 4)
        if func(pso_best) < func(best_solution) or func(de_best) < func(best_solution):
            best_solution = min(pso_best, de_best, key=func)

    return best_solution
