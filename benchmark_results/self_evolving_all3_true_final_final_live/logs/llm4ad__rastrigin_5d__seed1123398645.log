def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def bounds_check(x):
        return all(clip(x_i) == x_i for x_i in x)

    def func_val(x):
        return func(x)

    pop_size = int(budget ** 0.5)
    population = rng.uniform(lb, ub, (pop_size, dim))

    best = None
    while budget > 0:
        # Differential Evolution phase
        for i in range(pop_size):
            j = rng.randint(0, pop_size, 3)
            mutation = 1 + rng.uniform(-1, 1) * 0.1
            offspring = population[j] + mutation * (population[j % pop_size] - population[(j + 1) % pop_size])
            if bounds_check(offspring):
                func_val_offspring = func_val(clip(offspring))
                if best is None or func_val_offspring < func_val(best):
                    best = clip(offspring)

        # Nelder-Mead simplex method
        x0 = np.array([best] * 5)
        a = 1 + rng.uniform(-1, 1) * 0.05
        b = rng.uniform(-1, 1) * 0.05
        c = rng.uniform(-1, 1) * 0.05
        d = np.array([x0[0] - a * (x0[1] - x0[2]),
                      x0[1] + b * (x0[2] - x0[3]),
                      x0[2] + c * (x0[3] - x0[4])])
        if bounds_check(d):
            func_val_d = func_val(clip(d))
            if best is None or func_val_d < func_val(best):
                best = clip(d)

        budget -= 1

    return np.array([best])
