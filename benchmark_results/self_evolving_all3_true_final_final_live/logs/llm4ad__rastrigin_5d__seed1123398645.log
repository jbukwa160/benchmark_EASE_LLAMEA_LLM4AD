def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x, lb, ub):
        return np.clip(x, lb, ub)

    def differential_evolution(current_solution, population, pop_size, F, CR):
        new_population = np.zeros((pop_size, dim))
        for i in range(pop_size):
            idx1, idx2, idx3 = rng.choice(range(pop_size), 3, replace=False)
            if rng.random() < CR:
                mutant = bound(current_solution + F * (population[idx1] - population[idx2]) + F * (population[idx3] - current_solution), lb, ub)
                new_population[i] = mutant
        return new_population

    def evaluate(candidate):
        return func(candidate)

    pop_size = 50
    F = 0.5
    CR = 0.9
    population = np.random.uniform(lb, ub, (pop_size, dim))
    current_solution = None

    for _ in range(budget):
        fitnesses = [evaluate(candidate) for candidate in population]
        best_idx = np.argmin(fitnesses)
        if current_solution is None or fitnesses[best_idx] < evaluate(current_solution):
            current_solution = population[best_idx]

        new_population = differential_evolution(current_solution, population, pop_size, F, CR)

        # Select the fittest candidate from the merged population
        merged_fitnesses = [evaluate(candidate) for candidate in np.concatenate((population, new_population))]
        best_idx = np.argmin(merged_fitnesses)
        if evaluate(population[best_idx]) < evaluate(current_solution):
            current_solution = population[best_idx]

    return bound(current_solution, lb, ub)
