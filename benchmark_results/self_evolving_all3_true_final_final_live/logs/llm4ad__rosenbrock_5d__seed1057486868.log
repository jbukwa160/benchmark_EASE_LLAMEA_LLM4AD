def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def objective(x):
        return func(x)

    population_size = 50
    mu = 0.7
    sigma = 1

    pop = rng.uniform(lb, ub, (population_size, dim))
    best_x = pop[np.argmin([objective(clip(x)) for x in pop])]

    for _ in range(budget):
        z = rng.normal(size=(population_size, dim))
        z = clip(z)

        x_new = pop + mu * (pop - np.array([best_x] * population_size)) + sigma * z

        fit_new = [objective(clip(x)) for x in x_new]
        idx = np.argsort(fit_new)[:population_size]

        pop = x_new[idx]
        best_x = pop[np.argmin(fit_new)]

    return best_x
