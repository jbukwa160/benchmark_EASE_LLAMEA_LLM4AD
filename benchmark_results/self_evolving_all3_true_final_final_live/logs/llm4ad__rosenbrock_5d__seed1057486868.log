def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    pop_size = 50
    bounds = [(lb[i], ub[i]) for i in range(dim)]
    x = [np.array([rng.uniform(b[0], b[1]) for b in bounds]) for _ in range(pop_size)]

    best_x = None
    best_f = np.inf

    for t in range(1, budget + 1):
        for i in range(pop_size):
            target = x[i]
            idx = rng.choice([j for j in range(pop_size) if j != i])
            mutant = target + 0.5 * (x[idx] - target)
            for j in range(dim):
                if rng.random() < 0.7:
                    mutant[j] += rng.uniform(-1, 1)
                    mutant[j] = max(bounds[j][0], min(mutant[j], bounds[j][1]))
            trial = [max(b[0], min(min(a[k], m[k]), b[1])) for k in range(dim) for a, m, b in zip(target, mutant, (bounds,))]

            f_trial = evaluate(trial)
            if f_trial < evaluate(target):
                x[i] = trial
                if f_trial < best_f:
                    best_x = trial
                    best_f = f_trial

    return np.array(best_x)
