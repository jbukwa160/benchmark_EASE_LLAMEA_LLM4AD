def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(-5, 5, size=dim)
    best_x = x.copy()
    best_f = func(best_x)

    cma_count = 0
    cmo_count = 0

    for _ in range(budget):
        if rng.rand() < 0.5:
            # CMA-ES step
            cma_count += 1
            mu, sigma = 1 / np.sqrt(np.sum((x - best_x) ** 2)), 10.0 * (ub - lb) / dim
            x_new = best_x + rng.normal(0, sigma, size=dim)
            x_new = clip(x_new)
        else:
            # CMO step
            cmo_count += 1
            v = np.random.uniform(-5, 5, size=dim)
            x_new = (ub - lb) * v + lb

        f_new = func(x_new)

        if f_new < best_f:
            best_f = f_new
            best_x = x_new.copy()

    return best_x
