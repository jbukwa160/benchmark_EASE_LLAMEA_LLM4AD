def algorithm(func, dim, lb, ub, budget, rng):
    def grad(x):
        x = x.astype(np.float64)
        dx = np.zeros_like(x)
        for i in range(dim-1):
            d = 100 * (x[i+1] - x[i]**2)**2
            dx[i] += 200 * x[i]**2 * (x[i+1] - x[i]**2) + 2 * (1 - x[i])
            dx[i+1] -= 400 * x[i+1] * (x[i+1] - x[i]**2)
        return dx

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for i in range(budget):
        x_candidate = x_best + rng.normal(size=dim) / np.sqrt(i + 1)
        g = grad(x_candidate)
        step_size = 0.01
        x_new = x_candidate - step_size * g

        if lb <= x_new.all() <= ub:
            f_new = func(x_new)

            if f_new < f_best:
                x_best = x_new
                f_best = f_new

    return x_best
