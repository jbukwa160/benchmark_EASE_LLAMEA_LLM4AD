def algorithm(func, dim, lb, ub, budget, rng):
    def get_next_candidate(current, delta):
        return current + np.random.uniform(-delta, delta, size=dim)

    temperature = 1.0
    current_solution = np.zeros(dim)
    best_solution = np.zeros(dim)
    best_fitness = func(best_solution)
    
    for _ in range(budget):
        next_candidate = get_next_candidate(current_solution, 0.01*(ub - lb))
        
        # Clip candidates to [lb, ub]
        clipped_candidate = np.clip(next_candidate, a_min=lb, a_max=ub)
        
        fitness = func(clipped_candidate)
        
        if fitness < best_fitness:
            best_fitness = fitness
            best_solution = clipped_candidate.copy()
            
        if rng.uniform(0, 1) > np.exp((fitness - best_fitness)/temperature):
            current_solution = clipped_candidate
            
        temperature *= 0.99
        
    return best_solution
