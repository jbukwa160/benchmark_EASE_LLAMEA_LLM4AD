def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    def objective(x):
        return func(x)

    x_best = np.random.uniform(lb, ub, size=(dim,))
    f_best = objective(x_best)
    budget_used = 0

    while budget_used < budget:
        # Differential Evolution
        x1 = clip(rng.normal(loc=x_best, scale=0.5, size=(dim,)))
        x2 = clip(rng.normal(loc=x_best, scale=0.5, size=(dim,)))
        x3 = clip(rng.normal(loc=x_best, scale=0.5, size=(dim,)))

        v = 0.5 * (x1 + x2) + 0.5 * rng.choice([-1, 1]) * rng.uniform(-1, 1)

        # Simulated Annealing
        f_v = objective(v)
        if f_v < f_best:
            x_best = v
            f_best = f_v

        budget_used += 1

    return x_best
