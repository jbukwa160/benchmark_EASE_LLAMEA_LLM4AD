def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    mu = 10
    sigma0 = 1.5
    lambda_ = 100
    iter_num = int(budget)
    best_x = np.random.uniform(lb, ub, (1, n))
    best_f = func(best_x)

    for i in range(iter_num):
        z = rng.normal(0, 1, (lambda_, n))
        x = best_x + sigma0 * np.exp(-i / iter_num) * z
        x = np.clip(x, lb, ub)
        
        f_values = func(np.array([x]))
        idx = np.argsort(f_values)[..., ::-1]
        
        new_best_f = f_values[idx[0]]
        if new_best_f < best_f:
            best_x = x[idx[0]]
            best_f = new_best_f

    return best_x
