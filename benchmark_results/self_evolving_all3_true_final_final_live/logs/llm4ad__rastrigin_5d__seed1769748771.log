def algorithm(func, dim, lb, ub, budget, rng):
    num_restarts = int(budget / 1000)
    
    best_solution = None
    
    for _ in range(num_restarts):
        solution = rng.uniform(lb, ub, size=dim)
        
        for _ in range(1, budget - 1):
            mutation = rng.uniform(-5.0, 5.0, size=dim)
            candidate = solution + mutation
            
            # Clip candidates to [lb, ub]
            candidate = np.clip(candidate, lb, ub)
            
            if func(candidate) < func(solution):
                solution = candidate
                
        if best_solution is None or func(solution) < func(best_solution):
            best_solution = solution
    
    return best_solution
