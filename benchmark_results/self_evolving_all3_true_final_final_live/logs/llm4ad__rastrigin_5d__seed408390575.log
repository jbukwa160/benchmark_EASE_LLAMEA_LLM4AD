def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    bounds = [(lb, ub) for _ in range(dim)]
    result_de = differential_evolution(objective, bounds)
    x0_best = result_de.x

    gp_model = {
        'mean': lambda X: np.sum(X**2 - 10*np.cos(2*np.pi*X), axis=1),
        'covf': lambda X, Y: np.exp(-np.linalg.norm(X-Y, axis=1)**2 / (2 * rng**2))
    }

    x_best = x0_best
    for t in range(budget):
        # Sample from the GP model
        n_samples = min(100, budget - t)
        X_samples = lb + (ub - lb) * np.random.rand(n_samples, dim)

        # Evaluate the function at the sampled points
        y_samples = objective(X_samples)

        # Update the GP model
        for i in range(n_samples):
            gp_model['covf'](X_samples[i], x_best)
            gp_model['mean'](X_samples[i])

        # Sample from the updated GP model
        X_gp, _ = norm.rvs(loc=gp_model['mean'](x_best), scale=np.sqrt(gp_model['covf'](x_best, x_best)), size=(n_samples, dim))

        # Clip sampled points to bounds
        X_gp = np.clip(X_gp, lb, ub)

        # Evaluate the function at the sampled points
        y_gp = objective(X_gp)

        # Select the best point
        idx_best = np.argmax(y_gp)
        x_new = X_gp[idx_best]

        # Update the best solution if necessary
        if y_gp[idx_best] < objective(x_best):
            x_best = x_new

    return x_best
