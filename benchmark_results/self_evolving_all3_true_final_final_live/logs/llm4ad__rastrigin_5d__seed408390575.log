def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    bounds = [(lb, ub)] * dim
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_rand = clip(lb + (ub - lb) * rng.randn(dim), lb, ub)
        f_rand = func(x_rand)

        if f_rand < f_best:
            x_best = x_rand
            f_best = f_rand

        # Local refinement
        for _ in range(5):  # max iterations per step
            x_new = clip(x_best + (ub - lb) * rng.randn(dim), lb, ub)
            f_new = func(x_new)

            if f_new < f_best:
                x_best = x_new
                f_best = f_new

    return x_best
