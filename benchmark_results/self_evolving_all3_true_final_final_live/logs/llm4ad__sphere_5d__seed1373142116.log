def algorithm(func, dim, lb, ub, budget, rng):
    bounds = [(lb[i], ub[i]) for i in range(dim)]
    best_x = np.random.uniform(bounds[0][0], bounds[0][1], size=(dim,))
    best_f = float('inf')
    
    num_samples = 0
    while True:
        if num_samples >= budget:
            break
        
        x = np.clip(best_x + rng.normal(size=best_x.shape), *bounds)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
        
        num_samples += 1
    
    return best_x
