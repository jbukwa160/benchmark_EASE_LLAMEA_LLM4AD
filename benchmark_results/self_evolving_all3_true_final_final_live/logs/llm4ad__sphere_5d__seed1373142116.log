def algorithm(func, dim, lb, ub, budget, rng):
    n = len(rng)
    assert dim == 5
    assert n == budget
    best_x = -np.inf * np.ones(dim)
    
    for i in range(n):
        x = rng * (ub - lb) + lb
        
        # Clip candidates to [lb, ub]
        clipped_x = np.clip(x, lb, ub)
        
        f_x = func(clipped_x)
        
        if f_x < best_x[-1]:
            best_x = clipped_x
    
    return best_x
