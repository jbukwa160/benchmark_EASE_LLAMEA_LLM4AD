def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidates):
        return np.clip(candidates, lb, ub)

    def generate_candidate(current_solution):
        noise = (ub - lb) * rng.random((dim)) + lb
        new_solution = current_solution + noise
        new_solution = clip(new_solution)
        return new_solution

    temperature = 1.0
    best_solution = np.zeros(dim)
    best_value = float('inf')

    for _ in range(budget):
        candidate = generate_candidate(best_solution)
        value = func(candidate)

        if value < best_value:
            best_value = value
            best_solution = candidate

        delta = value - best_value
        accept_probability = np.exp(-delta / temperature)
        r = rng.random()

        if r < accept_probability or delta <= 0.0:
            current_solution = candidate

        temperature *= 0.99

    return clip(best_solution)
