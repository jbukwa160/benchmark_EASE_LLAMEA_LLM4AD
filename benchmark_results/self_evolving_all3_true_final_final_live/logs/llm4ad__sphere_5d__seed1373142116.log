def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 5.0
    T = 100.0
    n_iter = int(budget / (dim * rng))
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(n_iter):
        x_new = x_best + sigma * np.random.normal(size=dim)
        x_new = np.clip(x_new, lb, ub)
        
        if rng < 1.0:
            alpha = (ub - lb) / T
            x_new = x_best + alpha * np.sign(np.random.uniform(-1, 1, size=dim)) * (x_new - x_best)
            x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)

        if f_new < f_best:
            x_best = x_new
            f_best = f_new

        sigma *= 0.99
        T -= 1

    return x_best
