def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    r = (ub - lb) / 2
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(budget):
        # Generate new candidate
        step_size = max(r * np.exp(-i / budget), 1e-6)
        new_x = x + rng.choice([-1, 1], size=dim) * step_size
        
        # Clip to bounds
        new_x = np.clip(new_x, lb, ub)
        
        # Evaluate function
        new_f = func(new_x)
        
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f
            
        # Update radius
        r *= 0.9
        
    return best_x
