def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.minimum(np.maximum(candidate, lb), ub)

    def sphere(x):
        return sum(i**2 for i in x)

    def differential_evolution(bounds, popsize=50, maxiter=1000, crossover_prob=0.7, mutation_prob=0.1, seed=None):
        if seed is not None:
            rng = np.random.default_rng(seed)
        else:
            rng = rng

        bounds = [(lb[i], ub[i]) for i in range(dim)]

        pop = rng.uniform(0, 1, (popsize, dim))
        pop = [clip(np.array([bounds[i][0] + bound * (bounds[i][1] - bounds[i][0]) for i, bound in enumerate(ind)])) for ind in pop]

        for _ in range(maxiter):
            new_pop = []
            for i in range(popsize):
                other_i = rng.choice(range(popsize), size=3, replace=False)
                if rng.uniform(0, 1) < crossover_prob:
                    child = pop[other_i[0]] + mutation_prob * (pop[other_i[1]] - pop[other_i[2]])
                    new_pop.append(clip(child))
                else:
                    new_pop.append(pop[i])
            pop = new_pop

        return min(pop, key=sphere)

    def simulated_annealing(bounds, popsize=50, maxiter=1000, temperature_init=1e-6, cooling_rate=0.9999):
        bounds = [(lb[i], ub[i]) for i in range(dim)]

        pop = rng.uniform(0, 1, (popsize, dim))
        pop = [clip(np.array([bounds[i][0] + bound * (bounds[i][1] - bounds[i][0]) for i, bound in enumerate(ind)])) for ind in pop]

        temperature = temperature_init
        best_solution = None

        for _ in range(maxiter):
            new_pop = []
            for i in range(popsize):
                other_i = rng.choice(range(popsize), size=3, replace=False)
                if rng.uniform(0, 1) < 0.5:
                    child = pop[other_i[0]] + temperature * (pop[other_i[1]] - pop[other_i[2]])
                    new_pop.append(clip(child))
                else:
                    new_pop.append(pop[i])
            pop = new_pop

            candidate = min(pop, key=sphere)
            if sphere(candidate) < sphere(best_solution):
                best_solution = candidate
            temperature *= cooling_rate

        return best_solution

    solution1 = differential_evolution((lb, ub))
    solution2 = simulated_annealing((lb, ub))

    if budget > 1000:
        popsize = int(np.sqrt(budget / 10) * rng.uniform(5, 20))
        maxiter = int(budget / 10)
        temperature_init = 1e-6
        cooling_rate = 0.9999

        bounds = [(lb[i], ub[i]) for i in range(dim)]

        pop = rng.uniform(0, 1, (popsize, dim))
        pop = [clip(np.array([bounds[i][0] + bound * (bounds[i][1] - bounds[i][0]) for i, bound in enumerate(ind)])) for ind in pop]

        temperature = temperature_init
        best_solution = None

        for _ in range(maxiter):
            new_pop = []
            for i in range(popsize):
                other_i = rng.choice(range(popsize), size=3, replace=False)
                if rng.uniform(0, 1) < crossover_prob:
                    child = pop[other_i[0]] + mutation_prob * (pop[other_i[1]] - pop[other_i[2]])
                    new_pop.append(clip(child))
                else:
                    new_pop.append(pop[i])
            pop = new_pop

            candidate = min(pop, key=sphere)
            if sphere(candidate) < sphere(best_solution):
                best_solution = candidate
            temperature *= cooling_rate

        return best_solution
    elif budget > 500:
        solution3 = differential_evolution((lb, ub), maxiter=int(budget / 5))
        return min([solution1, solution2, solution3], key=sphere)
    else:
        return solution1 if sphere(solution1) < sphere(solution2) else solution2
