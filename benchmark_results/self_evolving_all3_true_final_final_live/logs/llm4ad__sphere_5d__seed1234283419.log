def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = dim
    N = int(budget / (D + 1))
    mu = 1.0 / D * np.ones(D)
    sigma = 5.0
    cmu = np.eye(D) * .1
    ccov = np.eye(D) * .1

    for _ in range(N):
        for _ in range(D + 1):
            y = clip(mu + rng.randn(D) * sigma)
            fy = func(y)

        alpha = 0.01 / (sigma ** 2)
        cmu /= 1 - D * alpha
        ccov += alpha * np.outer(mu, mu) - cmu

        for _ in range(10):
            y = clip(mu + rng.randn(D) * sigma)
            fy = func(y)

            if fy < func(mu):
                mu = y
                cmu = alpha * np.eye(D)
                ccov = 0.5 * (ccov + alpha * np.outer(mu, mu))
                sigma *= 1 - D * alpha

    return clip(mu)
