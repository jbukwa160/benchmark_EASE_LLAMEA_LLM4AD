def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    def generate_candidates(pop_size, x_best):
        n_pop = int(np.sqrt(pop_size))
        x_candidate = np.zeros((pop_size, dim))
        
        for i in range(n_pop):
            for j in range(dim):
                if rng.random() < 0.5:
                    x_candidate[i * n_pop + j] = clip(x_best[j] + rng.uniform(-1, 1) * (ub - lb))
                else:
                    x_candidate[i * n_pop + j] = clip(lb + rng.uniform(0, ub - lb))
        
        return np.array([clip(np.random.normal(x_best, 0.5)) for _ in range(pop_size)])

    def evaluate_candidates(candidates):
        fitnesses = [func(candidate) for candidate in candidates]
        return np.array(fitnesses), np.argmin(fitnesses)

    x_best = lb + (ub - lb) * rng.random(dim)
    
    pop_size = 10
    for _ in range(budget // pop_size):
        candidates = generate_candidates(pop_size, x_best)
        fitnesses, idx_min = evaluate_candidates(candidates)
        
        if np.min(fitnesses) < func(x_best):
            x_best = clip(candidates[idx_min])
    
    return x_best
