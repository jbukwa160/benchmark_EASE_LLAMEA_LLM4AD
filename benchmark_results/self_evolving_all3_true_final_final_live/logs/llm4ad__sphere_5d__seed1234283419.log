def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_solution(dim, rng):
        return rng.uniform(lb, ub, size=dim)

    def compute_cooling_schedule(budget):
        t = 10000 / (budget + 1)
        return np.logspace(np.log10(100), -np.log10(t), budget)

    def sa(func, x0, lb, ub, dim, cooling_schedule, rng):
        x_current = x0
        best_x = x0.copy()
        for t in cooling_schedule:
            std_dev = 1 / (t + 1)
            step_size = min(ub - lb, rng.uniform(lb, ub))
            new_x = x_current + rng.normal(loc=0, scale=std_dev, size=dim) * step_size
            new_x = np.clip(new_x, lb, ub)
            if func(new_x) < func(x_current):
                x_current = new_x
                if func(x_current) < func(best_x):
                    best_x = x_current.copy()
        return best_x

    rng = np.random.default_rng(rng.randint(0, 2**32 - 1))
    cooling_schedule = compute_cooling_schedule(budget)
    x0 = generate_initial_solution(dim, rng)
    best_x = sa(func, x0, lb, ub, dim, cooling_schedule, rng)
    return best_x
