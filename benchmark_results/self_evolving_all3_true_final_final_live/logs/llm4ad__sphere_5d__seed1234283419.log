def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.ceil(np.power(budget, 1/dim)))
    best_sol = np.zeros(dim)
    best_val = float('inf')

    grid_size = int(np.ceil((ub - lb) / (ub - lb) * pop_size))
    for i in range(pop_size):
        sol = rng.uniform(lb, ub, dim)
        sol = np.round(sol, decimals=int(-np.log10(grid_size)))
        val = func(sol)
        if val < best_val:
            best_sol = sol
            best_val = val

    step = (ub - lb) / grid_size
    for d in range(dim):
        cur_sol = np.copy(best_sol)
        cur_sol[d] += step
        while True:
            new_sol = np.copy(cur_sol)
            new_sol[d] += step
            if new_sol[d] > ub:
                break
            val_new = func(new_sol)
            if val_new < best_val:
                best_sol = new_sol
                best_val = val_new

    for d in range(dim):
        cur_sol = np.copy(best_sol)
        cur_sol[d] -= step
        while True:
            new_sol = np.copy(cur_sol)
            new_sol[d] -= step
            if new_sol[d] < lb:
                break
            val_new = func(new_sol)
            if val_new < best_val:
                best_sol = new_sol
                best_val = val_new

    return best_sol
