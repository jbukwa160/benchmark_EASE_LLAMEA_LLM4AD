def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = -np.inf * np.ones(dim)
    best_val = float('inf')

    for i in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        x = clip(x)

        if func(x) < best_val:
            best_val = func(x)
            x_best = x

        t = 0.99 * np.exp(-i / budget)
        sigma = 2 * rng.uniform(0, 1)

        while True:
            x_try = x + sigma * rng.normal(size=dim)
            x_try = clip(x_try)

            if func(x_try) < best_val:
                x_best = x_try
                best_val = func(x_best)
                break

            if rng.uniform(0, 1) > np.exp((best_val - func(x_try)) / t):
                x_best = x_try
                best_val = func(x_best)
                break

    return x_best
