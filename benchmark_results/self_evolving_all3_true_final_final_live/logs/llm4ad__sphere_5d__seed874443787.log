def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = (ub - lb) * rng.uniform(size=dim) + lb
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
            
        alpha = 1 / (_ + 1)**0.5
        step_size = alpha * (ub - lb)
        for i in range(dim):
            new_x = np.copy(x)
            new_x[i] += rng.choice([-1, 1]) * step_size
            new_x = np.clip(new_x, lb, ub)
            
            new_f = func(new_x)
            
            if new_f < best_f:
                best_f = new_f
                best_x = new_x
                
    return best_x
