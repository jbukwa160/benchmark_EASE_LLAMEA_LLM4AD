def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        weights = np.ones(dim)
        variances = np.var(rng.random((1000,) + (1,) * dim), axis=0) / 100
        weights += 10 * variances

        idx = np.argmax(weights)
        x[idx] = rng.uniform(lb, ub)

        f = func(x)
        if f < best_f:
            best_x = x.copy()
            best_f = f

    return best_x
