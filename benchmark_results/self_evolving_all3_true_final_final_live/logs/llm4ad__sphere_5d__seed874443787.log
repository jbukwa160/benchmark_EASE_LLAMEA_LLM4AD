def algorithm(func, dim, lb, ub, budget, rng):
    candidate = (ub - lb) * rng.rand(dim)
    best_candidate = candidate.copy()
    best_value = func(candidate)

    for _ in range(budget):
        delta = 0.1
        while True:
            new_candidate = candidate + delta * rng.randn(dim)
            new_candidate = np.clip(new_candidate, lb, ub)
            value = func(new_candidate)

            if value < best_value:
                best_candidate = new_candidate.copy()
                best_value = value

            if (value - best_value) / abs(best_value + 1e-6) > 0.01 or delta < 1e-3:
                break
            else:
                candidate = new_candidate.copy()
                delta *= 0.5

    return best_candidate
