def algorithm(func, dim, lb, ub, budget, rng):
    best_candidate = np.random.uniform(lb, ub, size=dim)
    best_fitness = func(best_candidate)

    for i in range(budget):
        candidate = np.random.uniform(lb, ub, size=dim)
        step_size = 0.1

        for j in range(dim):
            gradient = (func(candidate + step_size * rng.randn(dim)) - 
                       func(candidate - step_size * rng.randn(dim))) / (
                           2 * step_size)

            candidate[j] -= 0.01 * gradient  # Simple gradient descent update rule

        fitness = func(candidate)
        if fitness < best_fitness:
            best_candidate = candidate
            best_fitness = fitness

    return np.clip(best_candidate, lb, ub)
