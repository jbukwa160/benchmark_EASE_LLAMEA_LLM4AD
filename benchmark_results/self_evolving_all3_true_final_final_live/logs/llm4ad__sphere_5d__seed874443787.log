def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    D = 0.1 * (ub - lb)
    x_best = np.random.uniform(lb, ub, size=n)
    f_best = func(x_best)

    for i in range(budget):
        x = np.clip(np.random.normal(loc=x_best, scale=D, size=n), a_min=lb, a_max=ub)
        f_x = func(x)

        if f_x < f_best:
            x_best = x
            f_best = f_x

        H_inv = np.eye(n)
        s = x - x_best
        y = f_x - f_best

        for j in range(i):
            z = np.random.normal(size=n)
            r = func(x_best + 0.1 * solve(H_inv, z))
            if r < f_best:
                H_inv += np.outer(z, z) / (r - f_best)**2
                s += z
                y += (r - f_best)

        delta = solve(H_inv, s)
        alpha = np.dot(delta, delta) / 2

        x_new = x_best + alpha * delta
        x_new = np.clip(x_new, a_min=lb, a_max=ub)

        if func(x_new) < f_best:
            x_best = x_new
            f_best = func(x_best)
            H_inv = np.eye(n)
            s = x_new - x_best
            y = f_best

    return x_best
