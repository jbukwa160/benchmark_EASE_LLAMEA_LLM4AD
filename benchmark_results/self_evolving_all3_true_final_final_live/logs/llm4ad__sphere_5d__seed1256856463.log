def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        i = rng.randint(0, dim)
        a = np.linspace(lb[i], ub[i], 100)[rng.randint(0, 99)]
        f_values = [func(np.insert(x, i, ai)) for ai in a]
        
        min_idx = np.argmin(f_values)
        a_min = a[min_idx]
        x_new = x.copy()
        x_new[i] = a_min
        new_f = func(x_new)
        
        if new_f < best_f:
            best_x = x_new
            best_f = new_f
            
        x = best_x
        
    return best_x
