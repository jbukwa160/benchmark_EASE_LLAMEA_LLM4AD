def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    for i in range(budget):
        while True:
            try:
                x_new = np.random.multivariate_normal(x_best, 0.1 * np.eye(dim))
                x_new = np.clip(x_new, lb, ub)
                break
            except np.linalg.LinAlgError:
                continue
        
        f_new = func(x_new)
        
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
    
    return x_best
