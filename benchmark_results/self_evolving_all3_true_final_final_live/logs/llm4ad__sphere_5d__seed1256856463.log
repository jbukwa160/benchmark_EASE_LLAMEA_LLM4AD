def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.zeros(dim)
    best_x = x.copy()
    best_f = func(x)
    
    T = 10.0  # initial temperature
    cooling_rate = 0.99
    
    for i in range(budget):
        x_new = clip(x + rng.normal(size=dim, scale=T))
        
        f_new = func(x_new)
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new
        
        if f_new > best_f and np.random.rand() < np.exp((best_f - f_new) / T):
            x = x_new.copy()
        
        T *= cooling_rate
    
    return best_x
