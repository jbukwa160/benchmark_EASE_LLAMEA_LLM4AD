def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    y_best = np.inf
    N = 0

    def kernel(x1, x2):
        return 1 + np.sum((x1 - x2) ** 2)

    def gp_predict(mean_func, X, Y, x_new):
        K_ss = [kernel(x_new, x) for x in X]
        K_s = np.array(K_ss)
        k_ss = kernel(x_new, x_new)
        mu = mean_func(X) + K_s @ np.linalg.solve(np.atleast_2d(kernel(X)).T + 1e-8 * np.eye(len(X)), Y - mean_func(X))
        var = k_ss - K_s @ np.linalg.solve(np.atleast_2q(kernel(X)).T + 1e-8 * np.eye(len(X)), K_s)
        return mu, var

    def acquisition(x):
        mean, _ = gp_predict(lambda X: 0, x_best[:N], func(x_best[:N]), x)
        return mean

    for i in range(budget):
        if rng.random() < 0.1:
            x_new = lb + (ub - lb) * rng.uniform(size=dim)
        else:
            mu, var = gp_predict(lambda X: np.mean(func(X)), x_best[:N], func(x_best[:N]), None)
            x_new = rng.normal(loc=np.argmax(acquisition(np.linspace(lb, ub, 100).reshape(-1, dim))), scale=np.sqrt(var))
            x_new = (x_new + lb) / 2 * (ub - lb) + lb

        y_new = func(x_new)

        if y_new < y_best:
            x_best[:N] = np.concatenate((x_best[:N], [x_new]))
            y_best = np.min(func(np.array(x_best)))

        N += 1
    return np.array([np.clip(i, a_min=lb, a_max=ub) for i in x_best[:budget]])
