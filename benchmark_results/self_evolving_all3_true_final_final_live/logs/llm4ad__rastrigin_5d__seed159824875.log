def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    D = 2*dim + 1
    F = 0.5
    CR = 0.9
    x_best = np.random.uniform(lb, ub, dim)
    f_best = func(x_best)
    
    for t in range(budget):
        for i in range(dim):
            r1, r2, r3 = rng.choice(dim, size=3, replace=False) % dim
            x_mut = clip(x_best + F * (x_best[r1] - x_best[r2]) + (t/budget)**0.5 * (x_best[r3] - x_best[r1]))
            y_mut = clip(x_best + F * (x_best[r1] - x_best[r2]) + (t/budget)**0.5 * (np.random.uniform(lb, ub, dim) - x_best))
            
            if rng.rand() < CR or np.linalg.norm(x_mut - x_best) > np.linalg.norm(y_mut - x_best):
                x_new = y_mut
            else:
                x_new = x_mut
            
            f_new = func(x_new)
            
            if f_new < f_best:
                f_best = f_new
                x_best = x_new
                
    return clip(x_best)
