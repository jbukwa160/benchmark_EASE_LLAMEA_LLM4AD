def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(pop_size, dim, lower_bound, upper_bound):
        population = []
        for _ in range(pop_size):
            individual = np.array([rng.uniform(lower_bound, upper_bound) for _ in range(dim)])
            population.append(individual)
        return population

    def calculate_fitness(individuals, func):
        fitness_values = [func(individual) for individual in individuals]
        return np.array(fitness_values)

    def mutation(candidate, mutation_factor, dim):
        mutated_candidate = candidate + mutation_factor * rng.uniform(-1, 1, size=dim)
        return clip(mutated_candidate)

    def selection(population, fitness_values, num_parents):
        indices = np.argsort(fitness_values)[:num_parents]
        selected_population = [population[i] for i in indices]
        return selected_population

    population_size = 100
    mutation_factor = 0.5
    num_parents = int(population_size * 0.2)
    initial_population = generate_initial_population(population_size, dim, lb, ub)

    for _ in range(budget):
        fitness_values = calculate_fitness(initial_population, func)
        parents = selection(initial_population, fitness_values, num_parents)

        for individual in initial_population:
            mutated_individual = mutation(individual, mutation_factor, dim)
            if rng.uniform(0, 1) < 0.01: # Simulated Annealing probability
                new_fitness_value = func(mutated_individual)
                if new_fitness_value < fitness_values[np.where(initial_population == individual)[0][0]]:
                    individual[:] = mutated_individual

        initial_population = parents + [individual for individual in initial_population if individual not in parents]

    best_individual = min(initial_population, key=lambda x: func(x))
    return np.array(best_individual)
