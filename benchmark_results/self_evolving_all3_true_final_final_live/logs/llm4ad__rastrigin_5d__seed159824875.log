def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def rastrigin(x):
        return func(clip(x))

    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = rastrigin(best_x)
    
    for _ in range(budget):
        sigma = 0.5 * (ub - lb)  # initial standard deviation
        lambda_ = dim + 10  # population size
        
        mu = x.copy()  # mean of the population
        
        while True:
            z = rng.normal(size=(lambda_, dim)) * sigma
            x_new = mu + z
            
            f_new = rastrigin(x_new)
            
            if np.any(f_new < best_f):
                best_x = x_new.copy()
                best_f = f_new
                break
        
        mu += 0.1 * rng.normal(size=dim) * (best_x - mu)
        
        sigma *= 0.5 if np.mean(rastrigin(mu + rng.normal(size=(lambda_, dim)) * sigma)) < best_f else 1
    
    return best_x
