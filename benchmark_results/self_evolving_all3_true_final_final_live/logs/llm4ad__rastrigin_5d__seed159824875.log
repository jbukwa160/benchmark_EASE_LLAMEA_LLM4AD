def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(dim, lb, ub, rng):
        population = np.zeros((budget, dim))
        for i in range(budget):
            population[i] = lb + (ub - lb) * rng.rand(dim)
        return population

    def differential_evolution(population, func, lb, ub, budget):
        parents = population[np.argsort(func(population))[:int(0.1*budget)]]
        offsprings = np.zeros((budget, dim))
        for i in range(budget):
            parent1 = parents[rng.randint(len(parents))]
            parent2 = parents[rng.randint(len(parents))]
            offspring = parent1 + rng.uniform(-1, 1) * (parent2 - parent1)
            offsprings[i] = clip_candidate(offspring, lb, ub)
        return offsprings

    def simulated_annealing(population, func, lb, ub, temperature):
        best_solution = population[np.argmin(func(population))]
        for i in range(budget):
            solution = clip_candidate(best_solution + rng.uniform(-temperature, temperature), lb, ub)
            if func(solution) < func(best_solution):
                best_solution = solution
            else:
                probability = np.exp(-(func(solution) - func(best_solution))/temperature)
                if rng.rand() > probability:
                    best_solution = solution
        return best_solution

    population = generate_initial_population(dim, lb, ub, rng)
    for _ in range(budget):
        population = differential_evolution(population, func, lb, ub, budget)

    return simulated_annealing(population, func, lb, ub, 0.1)
