def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(clip(x_best))

    for _ in range(budget):
        x_cand = clip(np.random.uniform(lb, 2*ub - ub, size=dim))
        
        if rng.random() < np.exp(-f_best / (ub - lb)):
            x_cand = clip(rng.normal(x_best, 0.1*np.abs(ub - lb), size=dim))
        
        f_cand = func(x_cand)
        
        if f_cand < f_best:
            x_best = x_cand
            f_best = f_cand
    
    return x_best
