def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(dim,))
    while True:
        for i in range(budget):
            idx = rng.randint(dim)
            delta = 0.1 * (rng.choice([-1, 1]) if rng.random() < 0.5 else rng.uniform(-1, 1))
            x[idx] += delta
            x = np.clip(x, lb, ub)
            f_x = func(x)
            if f_x < func(np.copy(x)):
                x = np.copy(x)
        return x
