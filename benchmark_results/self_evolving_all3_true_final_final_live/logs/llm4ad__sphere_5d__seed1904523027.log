def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -1 * np.ones(dim)
    f_best = float('inf')
    
    for i in range(budget):
        step_size = 2 / (i + 1) ** 0.5
        noise = rng.uniform(-step_size, step_size, size=dim)
        candidate = x_best + noise
        
        # Clip candidates to [lb, ub]
        candidate = np.clip(candidate, lb, ub)
        
        f_candidate = func(candidate)
        
        if f_candidate < f_best:
            x_best = candidate
            f_best = f_candidate
            
    return x_best
