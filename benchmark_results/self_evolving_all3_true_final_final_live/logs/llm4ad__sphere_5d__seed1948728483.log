def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.random.uniform(lb, ub, size=(dim,))
    f_best = func(clip(x_best))

    for _ in range(budget - 1):
        x_new = x_best + rng.normal(size=(dim,)) * 0.5
        x_new = clip(x_new)

        f_new = func(x_new)
        if f_new < f_best:
            f_best = f_new
            x_best = x_new

    return x_best
