def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        y = x + 0.5 * rng.randn(dim) / (1 + func(x))
        y = clip(y)
        
        if func(y) < best_f:
            best_f = func(y)
            best_x = y.copy()
            
        alpha = np.exp(-_ / budget * np.log(2))
        delta = rng.uniform(-1, 1, size=dim)
        z = best_x + alpha * delta
        z = clip(z)
        
        if func(z) < best_f:
            x = z
    
    return best_x
