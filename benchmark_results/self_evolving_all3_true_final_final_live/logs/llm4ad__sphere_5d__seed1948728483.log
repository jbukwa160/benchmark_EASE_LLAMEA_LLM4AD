def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    h = 0.1 * rng.uniform(-1, 1, size=dim)

    for _ in range(budget):
        x_new = x + h
        f_new = func(x_new)
        f_curr = func(x)

        if f_new < f_curr:
            x = x_new

        # Clip candidates to [lb, ub]
        x[:] = np.clip(x, lb, ub)

    return x
