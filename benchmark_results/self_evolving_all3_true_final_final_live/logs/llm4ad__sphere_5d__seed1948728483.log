def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    T = 10
    alpha = 0.99
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        y = x.copy()
        
        # Crossover operator
        idx = rng.choice(dim, replace=False, size=2)
        y[idx[0]] = (x[idx[0]] + ub) / 2
        y[idx[1]] = (x[idx[1]] + ub) / 2
        
        # Clip candidates to [lb, ub]
        y = np.clip(y, lb, ub)
        
        f_y = func(y)
        
        if f_y < best_f:
            best_x = y.copy()
            best_f = f_y
            
        delta = f_y - best_f
        if delta < 0 or np.random.rand() < np.exp(-delta / T):
            x = y.copy()
            
        T *= alpha
        
    return best_x
