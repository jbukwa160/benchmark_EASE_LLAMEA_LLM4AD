def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 10
    sigma_init = 1.0
    sigma_decay = 0.99
    
    x = (ub - lb) * rng.rand(pop_size, dim) + lb
    f = func(x)
    
    best_x = x[np.argmin(f)]
    best_f = np.min(f)
    
    for i in range(budget):
        new_sigma = max(sigma_init * sigma_decay ** i, 1e-6)
        
        z = rng.randn(pop_size, dim)
        y = z / (np.linalg.norm(z, axis=1)[:, None] + 1e-8)
        
        x_new = x + new_sigma * y
        
        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        
        mask = f_new < best_f
        x[mask] = x_new[mask]
        f[mask] = f_new[mask]
        
        if np.any(mask):
            best_x = x[np.argmin(f)]
            best_f = np.min(f)
    
    return best_x
