def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    x_best = np.zeros(n)
    f_best = float('inf')
    T0 = 1e2
    alpha = 0.99
    T = T0
    for _ in range(budget):
        x = np.clip(x_best + rng.uniform(-1, 1, n), lb, ub)
        f = func(x)
        if f < f_best:
            f_best = f
            x_best = x
        delta = f - f_best
        p = np.exp(-delta / T)
        r = rng.random()
        if delta <= 0 or r < p:
            continue
        for i in range(n):
            xi = x[i]
            x[i] += (ub[i] - lb[i]) * rng.uniform(-1, 1)
            f_new = func(x)
            if f_new < f_best:
                f_best = f_new
                x_best = x.copy()
            delta = f_new - f_best
            p = np.exp(-delta / T)
            r = rng.random()
            if delta <= 0 or r < p:
                continue
        T *= alpha
    return x_best
