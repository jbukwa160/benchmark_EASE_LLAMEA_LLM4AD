def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    sigma = 0.5 * (ub - lb) / 1.05
    N = int(np.ceil(budget / dim))
    temperature = 10000

    for n in range(N):
        if n < 10:
            x_new = np.random.uniform(lb, ub, size=dim)
        else:
            sigma *= 0.5
            x_new = x + np.random.normal(0, sigma, size=dim)

        x_new = np.clip(x_new, lb, ub)

        f_x = func(x)
        f_x_new = func(x_new)

        if f_x_new < f_x or rng.uniform() < np.exp((f_x - f_x_new) / temperature):
            x = x_new
            temperature *= 0.999

    return x
