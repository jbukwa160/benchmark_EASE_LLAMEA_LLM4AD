def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    initial_solution = np.array([random.uniform(lb, ub) for _ in range(dim)])
    initial_cost = func(initial_solution)
    
    current_solution = initial_solution
    current_cost = initial_cost
    
    temperature = 1.0
    
    for i in range(budget):
        new_solution = clip(current_solution + rng.normal(size=dim))
        
        # Simulated Annealing (SA) component
        delta = func(new_solution) - current_cost
        if delta < 0:
            current_solution = new_solution
            current_cost = current_cost + delta
        else:
            if np.random.rand() < np.exp(-delta / temperature):
                current_solution = new_solution
                current_cost = current_cost + delta
        
        # Random Search (RS) component
        if i % 100 == 0 and rng.uniform(0, 1) < 0.2:
            new_solution = clip(current_solution + rng.normal(size=dim))
            if func(new_solution) < current_cost:
                current_solution = new_solution
                current_cost = func(new_solution)
        
        temperature *= 0.999
    
    return current_solution
