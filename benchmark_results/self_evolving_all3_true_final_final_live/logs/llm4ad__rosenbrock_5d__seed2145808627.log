def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population():
        return rng.uniform(lb, ub, size=(dim * 10, dim))

    def evaluate(population):
        return [func(clip(individual)) for individual in population]

    def select_parents(population, fitnesses):
        return np.argsort(fitnesses)[:dim]

    def recombination(parents):
        weights = rng.uniform(0.5, 1.5, size=dim)
        children = np.zeros((len(parents), dim))
        for i in range(dim):
            children[:, i] = np.sum([parents[j, i] * weights[j] for j in range(len(parents))], axis=0) / np.sum(weights)
        return children

    def mutation(children):
        mu = 1e-4
        sigma = 1
        step_size = 10 / (1 + rng.uniform(0, 1))
        delta = rng.normal(0, sigma * step_size, size=(len(children), dim))
        return children + delta * mu

    def adapt_step_size(fitnesses):
        if np.mean(fitnesses) < 1e-3:
            return 10 / (1 + rng.uniform(0, 1))
        else:
            return 2.38 / (np.sqrt(2 * dim))

    population = generate_initial_population()
    fitnesses = evaluate(population)
    parents = select_parents(population, fitnesses)

    for _ in range(budget):
        children = recombination(parents)
        mutated_children = mutation(children)
        new_fitnesses = evaluate(mutated_children)
        sigma = adapt_step_size(new_fitnesses)
        best_individual = np.argmin(new_fitnesses)
        if new_fitnesses[best_individual] < fitnesses[np.argmin(fitnesses)]:
            parents = mutated_children
            fitnesses = new_fitnesses

    return clip(parents[np.argmin(fitnesses)])
