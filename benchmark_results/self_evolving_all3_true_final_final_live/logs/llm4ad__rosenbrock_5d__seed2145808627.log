def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    x = rng.uniform(lb, ub, size=(1, dim))
    best = func(x)
    for _ in range(budget):
        x_next = clip(x + rng.normal(size=x.shape) * 0.01)
        fx_next = func(x_next)
        alpha = np.exp(-abs(fx_next - best) / (best + 1e-8))
        if fx_next < best:
            best = fx_next
            x = x_next
        elif rng.uniform(0, 1) > alpha:
            x = x_next
    return clip(x)
