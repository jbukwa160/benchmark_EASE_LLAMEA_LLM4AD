def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(np.array(x))

    x = [ub] * dim
    cma = np.eye(dim)
    mu = np.zeros(dim)

    for _ in range(budget):
        y = cmu @ (x - mu) + mu
        sigma = 1.0

        while True:
            z = rng.normal(size=dim)
            candidate = y + sigma * z
            candidate = [max(lb, min(ub, x_i)) for x_i in candidate]

            if objective(candidate) < objective(x):
                x = candidate
                mu += 5e-6 * (candidate - mu)
                cma += 10e-6 * np.outer((candidate - mu), (candidate - mu))
                break

            sigma *= 0.9

    return np.array(x)
