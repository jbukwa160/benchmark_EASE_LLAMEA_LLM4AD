def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        f = func(x)
        grad = 2 * x
        step_size = 0.01 * np.max(np.abs(grad))

        while True:
            new_x = x - step_size * grad
            new_f = func(new_x)

            if new_f < f:
                x = new_x
                best_x = x.copy()
                best_f = new_f
                break

            if new_x[0, 0] < lb or new_x[0, 0] > ub or any(np.abs(new_x[:, i] - lb) < 1e-5 for i in range(1, dim)):
                step_size /= 2
            else:
                x = new_x
                break

    return best_x
