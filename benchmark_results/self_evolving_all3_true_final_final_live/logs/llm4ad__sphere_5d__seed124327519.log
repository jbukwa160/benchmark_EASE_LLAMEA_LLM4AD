def algorithm(func, dim, lb, ub, budget, rng):
    D = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    T = 1000.0
    alpha = 0.99
    T_min = 1e-6
    best_x = D.copy()
    best_f = func(D)
    
    for i in range(budget):
        if rng.uniform(0, 1) < 0.01:
            new_x = D + rng.normal(size=dim) * 5.0
            new_x = np.clip(new_x, lb, ub)
        else:
            new_x = D + rng.normal(size=dim) / (i+1)**2
            
        new_f = func(new_x)
        
        if new_f < best_f or rng.uniform(0, 1) < np.exp((best_f - new_f) / T):
            best_f = new_f
            best_x = new_x.copy()
            
        T *= alpha
        
    return best_x
