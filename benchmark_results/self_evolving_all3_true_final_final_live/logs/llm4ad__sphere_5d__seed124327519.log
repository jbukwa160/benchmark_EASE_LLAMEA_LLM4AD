def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget - 1):
        new_x = x + rng.normal(size=dim) * (ub - lb) / 2
        new_x = np.clip(new_x, lb, ub)

        f = func(new_x)
        if f < best_f:
            best_f = f
            best_x = new_x

        # Random search step
        new_x_rs = rng.uniform(lb, ub, size=dim)
        new_f_rs = func(new_x_rs)
        if new_f_rs < best_f:
            best_f = new_f_rs
            best_x = new_x_rs

    return best_x
