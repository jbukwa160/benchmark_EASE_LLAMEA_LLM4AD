def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    c = 1.0 / np.sqrt(2 * dim)
    sigma = 1.0
    lambda_ = int(np.ceil(budget ** (1 / dim)))
    mu = lambda_ // 2

    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = np.random.normal(loc=x, scale=sigma * c)
        y = np.clip(y, lb, ub)

        z = np.zeros(lambda_)
        idx = np.arange(lambda_)

        for i in range(mu):
            j = rng.choice(idx[i:], 1)[0]
            z[j] = y

        f_z = func(z.copy())
        accept = f_z < best_f

        if accept:
            best_x, best_f = z.copy(), f_z
            x = z.copy()
        else:
            idx = np.arange(lambda_)
            for i in range(mu):
                j = rng.choice(idx[i:], 1)[0]
                dx = z[j] - x
                x += dx * (1 - accept) ** (1 / (i + 1))

    return best_x
