def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.ceil(budget / dim))
    pop = (ub - lb) * rng.rand(pop_size, dim) + lb
    best_x = pop[np.argmin([func(x) for x in pop])]

    for _ in range(int(budget)):
        idx = np.random.choice(dim, size=1, replace=False)[0]
        new_pop = pop.copy()
        new_pop[:, idx] = (ub - lb) * rng.rand(pop_size) + lb
        new_pop[np.argmin([func(x) for x in new_pop])] = best_x
        pop = new_pop

    return best_x
