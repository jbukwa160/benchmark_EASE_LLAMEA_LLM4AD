def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 0.5
    lambda_ = 10
    mu = 1 / lambda_
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)
    n_evals = 1

    for i in range(1, budget + 1):
        x_cand = np.clip(x_best + sigma * rng.normal(size=(lambda_, dim)), lb, ub)
        fx_cand = np.array([func(x) for x in x_cand])

        f_rank = np.argsort(fx_cand)[::-1]
        x_ranked = x_cand[f_rank]

        x_new = np.zeros((dim,))
        weights = rng.uniform(0, 1, size=lambda_)
        sum_weights = np.sum(weights)

        for j in range(lambda_):
            x_new += weights[j] * x_ranked[j]

        if func(x_new) < f_best:
            x_best = x_new
            f_best = func(x_best)
        else:
            sigma *= 0.9

        n_evals += lambda_

    return x_best
