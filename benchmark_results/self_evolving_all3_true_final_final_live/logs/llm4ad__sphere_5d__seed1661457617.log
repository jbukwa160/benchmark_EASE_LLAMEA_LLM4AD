def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)
    step_size = 1.0
    max_iterations_without_improvement = 10
    iterations_without_improvement = 0

    for i in range(budget):
        x_candidate = x_best + np.random.normal(size=dim) * step_size
        x_candidate = clip(x_candidate)
        f_candidate = func(x_candidate)

        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate
            iterations_without_improvement = 0

        if i - iterations_without_improvement >= max_iterations_without_improvement:
            step_size *= np.sqrt(1.5)
            x_best = x_candidate
            f_best = f_candidate
            iterations_without_improvement = 0

    return clip(x_best)
