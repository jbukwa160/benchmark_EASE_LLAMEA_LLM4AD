def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidates(mu, sigma, x_best):
        candidates = mu + sigma * (rng.random((budget, dim)) - 0.5)
        return np.clip(candidates, lb, ub)

    def evaluate_candidates(func, candidates):
        values = func(candidates)
        return np.argsort(values)

    def update_strategy(func, x_best, mu, sigma):
        sorted_indices = evaluate_candidates(func, mu)
        best_index = sorted_indices[0]
        new_mu = mu + (mu[best_index] - mu) / sigma
        new_sigma = sigma * 0.1 + np.linalg.norm(mu - mu[best_index]) * 0.9
        return new_mu, new_sigma

    x_best = rng.uniform(lb, ub)
    mu = x_best
    sigma = 2.0

    for _ in range(budget):
        candidates = generate_candidates(mu, sigma, x_best)
        sorted_indices = evaluate_candidates(func, candidates)
        best_index = sorted_indices[0]

        if func(candidates[best_index]) < func(x_best):
            x_best = candidates[best_index]
            mu = candidates[best_index]

        mu, sigma = update_strategy(func, x_best, mu, sigma)

    return np.array([x_best])
