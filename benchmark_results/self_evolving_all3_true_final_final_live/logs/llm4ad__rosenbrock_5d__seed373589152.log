def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    alpha = 0.1
    beta = 0.5
    mu = 0.9
    sigma = 10 * (ub - lb) / 2
    
    x_best = np.random.uniform(lb, ub, size=(n,))
    f_best = func(x_best)
    
    for i in range(int(2/beta)):
        x_rand = np.random.uniform(lb, ub, size=(n,))
        fx_rand = func(x_rand)
        
        if fx_rand < f_best:
            f_best = fx_rand
            x_best = x_rand
            
    learning_rate = 1e-5 / (i + 1)**0.9
    
    for i in range(int(beta)):
        g = np.zeros(n)
        e = np.zeros(n)
        
        for j in range(10):
            e += np.random.normal(size=n) * sigma
            x = x_best + e
            
            for k in range(n):
                if 0 <= x[k] <= ub and lb <= x[k+1] <= 0:
                    pass
                elif (ub - x[k])**2 > (x[k+1] - lb)**2:
                    g[k] += 400 * (x[k+1] - x[k]**2)
                else:
                    g[k+1] += 200 * (x[k] - x[k+1])
                    
            e -= np.random.normal(size=n) * sigma
            if func(x) < f_best + 1e-6:
                f_best = func(x)
                x_best = x
                
        for k in range(n):
            x_best[k] += g[k] / (np.linalg.norm(g[:k+1]) + learning_rate)
            
    return x_best
