def algorithm(func, dim, lb, ub, budget, rng):
    N = 10 * dim  # population size
    x_mean = np.zeros(dim)
    sigma = 5.0 / np.sqrt(2 * dim)  # initial step size
    cov = np.eye(dim)
    n_evals = 0

    for _ in range(budget):
        y = rng.randn(N, dim)
        x = x_mean + sigma * np.dot(y, np.linalg.cholesky(cov))

        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)

        fitness = func(x)

        idx = np.argsort(fitness)[:int(0.1 * N)]
        y[idx] -= x_mean
        cov += np.dot(y[idx].T, y[idx]) / (2 * N)
        sigma *= 1 + 1 / (N * dim)
        x_mean = x[np.argmin(fitness)]

        n_evals += len(x)

    return x_mean
