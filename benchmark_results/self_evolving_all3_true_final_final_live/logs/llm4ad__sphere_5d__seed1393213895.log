def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    y_best = func(x_best)

    candidates = []
    for i in range(budget):
        candidate = np.zeros(dim)
        for j in range(dim):
            samples = rng.choice(i + 1, replace=True)
            idxs = np.argsort(samples)[j]
            candidate[j] = rng.uniform(lb, ub)
        candidate = np.clip(candidate, lb, ub)
        candidates.append(candidate)

    candidates = np.array(candidates)
    for i in range(budget):
        y_candidate = func(candidates[i])
        if y_candidate < y_best:
            x_best = candidates[i]
            y_best = y_candidate

    return x_best
