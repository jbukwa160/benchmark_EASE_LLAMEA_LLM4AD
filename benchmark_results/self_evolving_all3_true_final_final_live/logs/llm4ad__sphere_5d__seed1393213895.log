def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    for _ in range(budget):
        x = lb + (ub - lb) * rng.rand(dim)
        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x
        u = 1.0 / (1 + np.sum(np.exp(-10*(x-best_x))))
        delta = (ub-lb)*rng.randn(dim)
        new_x = best_x + u * delta
        new_x = np.clip(new_x, lb, ub)
        f_new = func(new_x)
        if f_new < best_f:
            best_f = f_new
            best_x = new_x
    return best_x
