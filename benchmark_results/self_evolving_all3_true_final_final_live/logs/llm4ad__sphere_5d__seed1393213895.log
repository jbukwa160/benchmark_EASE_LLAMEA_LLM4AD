def algorithm(func, dim, lb, ub, budget, rng):
    T = 1000.0
    alpha = 0.99
    x_best = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    f_best = func(x_best)
    f_curr = f_best

    for i in range(budget):
        x_new = x_best + rng.normal(size=dim) * 0.1
        for j in range(dim):
            x_new[j] = max(lb, min(ub, x_new[j]))

        f_new = func(x_new)
        delta = f_new - f_curr

        if delta < 0 or (delta >= 0 and np.random.rand() < np.exp(-delta / T)):
            f_curr = f_new
            x_best = x_new

        T *= alpha

    return x_best
