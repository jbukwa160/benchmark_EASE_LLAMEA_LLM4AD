    D = 10  # number of samples to use for the Gaussian process surrogate model
    sigma = 1.0  # initial standard deviation of the noise in the objective function
    x_best = np.random.uniform(lb, ub, size=(dim,))
    f_best = func(x_best)

    def gp(x):
        mu = norm(loc=0., scale=sigma).cdf(np.dot(X, x - x_mean) / sigma)
        K = np.exp(-np.sum((x - X[:, None])**2, axis=0) / (2 * sigma**2))
        return np.dot(K, f)

    for i in range(budget):
        if i % 100 == 0:
            print(f'Iteration {i} out of {budget}')

        # sample the Gaussian process surrogate model
        x = np.random.uniform(lb, ub, size=(D, dim))
        f = func(x)
        f_mean = gp(x)

        # update the parameters of the Gaussian process surrogate model
        idx_sorted = np.argsort(f_mean)[::-1]
        X = x[idx_sorted[:D]]
        f = f[idx_sorted[:D]]
        S = cho_factor(np.exp(-np.sum((X[:, None] - X)**2, axis=0) / (2 * sigma**2)))
        f_mean = cho_solve(S, np.dot(X, x_best - x_mean) / sigma)
        sigma = np.sqrt(np.exp(1 - 2 * f_mean))

        # select the next point to evaluate based on the expected improvement
        if len(f) > 0:
            EI = (f_max - f_mean) * norm(loc=0., scale=sigma).cdf((f_max - f_mean) / sigma)
            idxEI = np.argmax(EI)

            # clip the candidate to the bounds
            x_candidate = np.clip(x[idxEI], lb, ub)

            # evaluate the candidate and update the best solution found so far
            f_candidate = func(x_candidate)
            if f_candidate < f_best:
                x_best = x_candidate
                f_best = f_candidate

    return x_best
