def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(mu, sigma):
        return mu + sigma * rng.randn(dim)

    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    pop_size = 10
    sigma_init = 5.0 / np.sqrt(dim)
    c1 = 2.0

    population = [generate_candidate(np.zeros(dim), sigma_init) for _ in range(pop_size)]

    for t in range(budget):
        # Select the best candidate
        best_candidate = min(population, key=lambda x: func(x))
        
        # Adapt the distribution
        mean = np.array(best_candidate)
        sigma = c1 * np.linalg.norm(mean) / pop_size
        
        # Generate new candidates using a Gaussian distribution centered around the mean
        new_population = [clip(generate_candidate(mean, sigma)) for _ in range(pop_size)]
        
        # Update the population
        population = new_population

    return min(population, key=lambda x: func(x))
