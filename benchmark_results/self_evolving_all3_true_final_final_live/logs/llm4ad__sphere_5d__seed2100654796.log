def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.zeros(dim)
    f_best = float('inf')

    for _ in range(budget):
        simplex = np.zeros((dim + 1, dim))
        for i in range(dim + 1):
            simplex[i] = rng.uniform(lb, ub)

        while True:
            y = func(simplex[-1])
            if y < f_best:
                f_best = y
                x_best = simplex[-1]

            # Reflection step
            r = np.mean(simplex[:-1], axis=0)
            y_reflection = func(clip(r + 2 * (simplex[-1] - r)))
            if y_reflection < y and y_reflection < f_best:
                simplex = np.vstack((simplex, clip(r + 2 * (simplex[-1] - r))))
            else:
                # Expansion step
                e = np.mean(simplex[:-1], axis=0)
                y_expansion = func(clip(e + 4 * (r - e)))
                if y_expansion < y_reflection and y_expansion < f_best:
                    simplex = np.vstack((simplex, clip(e + 4 * (r - e))))
                else:
                    # Contraction step
                    c = np.mean(simplex[:-2], axis=0)
                    y_contraction = func(clip(c + (simplex[-1] - c) / 2))
                    if y_contraction < f_best:
                        simplex[-1] = clip(c + (simplex[-1] - c) / 2)

            # Shrink step
            if np.all(simplex[:-1, :] == simplex[-1]):
                break

            # Shrink the simplex by half
            simplex_shrunk = simplex[:-1]
            for i in range(dim):
                simplex_shrunk[:, i] -= (simplex[-1, i] - simplex_shrunk[:, i]) / 2
            simplex = np.vstack((simplex_shrunk, clip(simplex[-1])))

    return x_best
