def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(clip(x_best))

    temperature = 1.0
    iterations_without_improvement = 0

    for i in range(budget):
        if iterations_without_improvement > budget // 10:
            break

        x_new = clip(rng.uniform(lb, ub, size=dim))
        f_new = func(x_new)

        if f_new < f_best:
            f_best = f_new
            x_best = x_new

        delta_f = f_new - f_best
        probability = np.exp(-delta_f / temperature)
        if rng.random() < probability:
            iterations_without_improvement = 0
            temperature *= 0.99999
        else:
            iterations_without_improvement += 1

    return x_best
