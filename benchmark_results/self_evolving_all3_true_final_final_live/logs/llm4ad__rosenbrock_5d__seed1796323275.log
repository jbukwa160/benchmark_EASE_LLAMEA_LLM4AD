def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.ceil(budget / 2))
    x0 = (ub - lb) * rng.rand(pop_size, dim) + lb
    c1, c2 = 1.0, 1.0
    fmin = np.inf

    for _ in range(budget):
        y = x0.copy()
        for i in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size), rng.randint(0, pop_size), rng.randint(0, pop_size)
            while r1 == i or r2 == i or r3 == i:
                r1, r2, r3 = rng.randint(0, pop_size), rng.randint(0, pop_size), rng.randint(0, pop_size)

            x = y[i] + c1 * (y[r1] - y[r2]) + c2 * (y[r3] - y[r2])

            for j in range(dim):
                if rng.rand() < 0.5:
                    x[j] = np.clip(x[j], lb, ub)
                else:
                    x[j] = np.clip(lb + (ub - lb) * x[j], lb, ub)

        fnew = func(np.array([x]))
        x0[np.argmin(fnew)] = x[np.argmin(fnew)]

        if np.min(fnew) < fmin:
            fmin = np.min(fnew)
            best_x = x[np.argmin(fnew)]

    return np.clip(best_x, lb, ub)
