def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def local_search(x0, func, dim, lb, ub, max_iter=100, tol=1e-6):
        x = x0
        for _ in range(max_iter):
            dx = np.zeros(dim)
            for i in range(dim):
                x_i = x[i]
                if abs(x_i - 1) < tol:
                    dx[i] = rng.uniform(-tol, tol)
                else:
                    dx[i] = rng.uniform(-1, 1)
            x_new = clip(x + 0.01 * dx, lb, ub)
            if func(x_new) < func(x):
                x = x_new
        return x

    def differential_evolution(func, dim, lb, ub, budget, pop_size=10, fudge_factor=1):
        candidates = np.random.uniform(lb, ub, (pop_size, dim))
        for _ in range(budget):
            fitnesses = [func(candidate) for candidate in candidates]
            parents = np.argsort(fitnesses)[:pop_size]
            offspring = []
            for i in range(pop_size // 2):
                parent1, parent2 = candidates[parents[i]], candidates[parents[-i - 1]]
                child = clip(parent1 + fudge_factor * (parent2 - parent1), lb, ub)
                offspring.append(child)
            candidates = np.array(offspring + [local_search(candidate, func, dim, lb, ub) for candidate in candidates])

        best_candidate = np.argmin([func(candidate) for candidate in candidates])
        return candidates[best_candidate]

    initial_candidates = np.random.uniform(lb, ub, (10, dim))
    candidates = differential_evolution(func, dim, lb, ub, budget // 2)
    candidates = [local_search(candidate, func, dim, lb, ub) for candidate in candidates]
    best_candidate = np.argmin([func(candidate) for candidate in candidates])
    return candidates[best_candidate]
