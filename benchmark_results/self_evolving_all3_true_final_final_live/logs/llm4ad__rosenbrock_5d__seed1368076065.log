def algorithm(func, dim, lb, ub, budget, rng):
    def noise(x):
        return 1e-3 * np.random.randn(dim)

    def acquisition(x):
        mu, sigma = gp.predict(np.array([x]).reshape(1, -1), return_std=True)
        return mu + 0.5 * sigma

    dim_per_iter = int(budget ** (1 / dim))
    x_best = rng.uniform(lb, ub, size=dim)

    for t in range(dim_per_iter):
        gp = GaussianProcessRegressor(kernel=RBF(length_scale_bounds=(1e-3, 1e+3)),
                                      n_restarts_optimizer=5)
        gp.fit(np.array([x_best]).reshape(1, -1), func(x_best))

        x_candidates = np.clip(rng.uniform(lb, ub, size=(1000, dim)), lb, ub)
        f_candidates = func(x_candidates) + noise(x_candidates)

        acquisition_values = np.zeros((1000,))
        for i in range(1000):
            acquisition_values[i] = acquisition(x_candidates[i])

        x_next_idx = np.argmax(acquisition_values)
        x_next = x_candidates[x_next_idx]

        if func(x_next) < func(x_best):
            x_best = x_next

    return x_best
