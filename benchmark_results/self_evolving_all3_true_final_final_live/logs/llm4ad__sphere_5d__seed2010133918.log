def algorithm(func, dim, lb, ub, budget, rng):
    n = 4 * dim + 2  # number of parameters in CMA-ES
    mu = 1 / np.sqrt(dim)
    sigma = 0.5 * (ub - lb)
    x_best = rng.uniform(lb, ub, size=dim)
    for i in range(budget):
        if i < dim:
            sigma *= 2 ** (-1/2 * i)
        elif i == dim:
            mu += 2 ** (-i / 10) * (ub - lb) * np.random.randn(dim)
            x_new = rng.uniform(lb, ub, size=dim)
            for j in range(n):
                if j < dim:
                    sigma *= 2 ** (-1/2 * i)
                elif j == n // 2 + 1:
                    mu += 2 ** (-j / 10) * (ub - lb) * np.random.randn(dim)
                else:
                    x_new += 2 ** -(j - 1) * sigma * rng.normal(0, 1, size=dim)
            if func(x_new) < func(x_best):
                x_best = x_new
        elif i == n // 2 + 1:
            mu += 2 ** (-i / 10) * (ub - lb) * np.random.randn(dim)
        else:
            sigma *= 2 ** -(i - n // 2 - 1) * rng.normal(0, 1, size=dim)
            x_new = x_best + sigma
            for j in range(n):
                if j < dim:
                    sigma *= 2 ** (-1/2 * i)
                elif j == n // 2 + 1:
                    mu += 2 ** (-j / 10) * (ub - lb) * np.random.randn(dim)
                else:
                    x_new += 2 ** -(j - 1) * sigma * rng.normal(0, 1, size=dim)
            if func(x_new) < func(x_best):
                x_best = x_new
        x_best = np.clip(x_best, lb, ub)
    return x_best
