def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    def evaluate(x):
        return func(clip(x))

    def step_size_schedule(t, n_steps):
        return 0.5 * (1 - t / n_steps)

    x = rng.uniform(lb, ub, size=dim)
    sigma = 0.5
    n_steps = int(np.ceil(budget / dim))
    c_m = np.zeros(dim)
    d_m = np.zeros(dim)
    D_inv = np.eye(dim) * 1e-8

    for t in range(n_steps):
        x_new = x + rng.normal(size=dim)
        sigma_new = step_size_schedule(t, n_steps)

        f_new = evaluate(x_new)
        f_current = evaluate(x)

        if f_new < f_current:
            x = x_new
            c_m = 0.5 * (c_m + np.dot(rng.uniform(-1, 1, size=dim), rng.normal(size=dim)))
            d_m = 0.5 * (d_m + np.dot(rng.uniform(-1, 1, size=dim)**2, rng.normal(size=dim)))
        else:
            c_m = 0.5 * (c_m + np.dot(rng.uniform(-1, 1, size=dim), rng.normal(size=dim)))
            d_m = 0.5 * (d_m + np.dot(rng.uniform(-1, 1, size=dim)**2, rng.normal(size=dim)))

        sigma_new = sigma_new * max(1e-32, np.sqrt(np.sum(d_m**2) / np.sum(c_m**2)))
        D_inv += 0.5 * np.outer(d_m / (np.sqrt(np.sum(d_m**2)) + 1e-32), d_m / (np.sqrt(np.sum(d_m**2)) + 1e-32))

        x += c_m / (np.linalg.det(D_inv) ** 0.25)
        sigma = max(1e-32, min(sigma_new, np.sqrt(np.sum(c_m**2 * D_inv[range(dim), range(dim)]))))

    return clip(x)
