def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget - 1):
        # Generate new candidate by adding a perturbation to the current best solution
        delta = rng.uniform(-1, 1, size=dim) * 0.01
        new_x = best_x + delta

        # Clip candidate to [lb, ub]
        new_x = np.clip(new_x, lb, ub)

        # Evaluate function value of new candidate
        new_f = func(new_x)

        # Select the candidate with the lowest function value
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f

    return best_x
