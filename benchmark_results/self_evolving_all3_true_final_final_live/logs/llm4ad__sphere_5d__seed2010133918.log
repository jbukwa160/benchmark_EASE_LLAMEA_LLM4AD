    X = np.random.uniform(lb, ub, (1, dim))
    GP = GaussianProcessRegressor()
    GP.fit(X, func(X))
    
    for _ in range(budget - 1):
        mu, sigma = GP.predict(np.atleast_2d(np.linspace(lb, ub, 1000)), return_std=True)
        next_x = rng.choice(1000, p=norm.pdf(np.linspace(lb, ub, 1000), loc=np.mean(mu), scale=np.std(sigma)))
        
        next_x = np.clip(next_x + np.random.uniform(-1e-3, 1e-3, dim), lb, ub)
        GP.fit(np.vstack((X, next_x)), np.append(func(X), func(next_x)))
        
        if func(next_x) < func(X[-1]):
            X = np.vstack((X, next_x))
    
    return X[-1]
