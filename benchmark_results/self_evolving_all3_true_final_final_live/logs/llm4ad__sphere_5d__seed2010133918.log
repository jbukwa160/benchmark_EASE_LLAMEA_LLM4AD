def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(n):
        return np.random.uniform(lb, ub, (n, dim))

    def calculate_fitness(population):
        return func(population)

    def select_parents(population, fitness, n):
        indices = np.argsort(fitness)[:n]
        return population[indices]

    def crossover(parent1, parent2, rng):
        child = parent1 + 0.5 * (parent2 - parent1)
        return clip(child)

    def mutate(individual, rng):
        mutation = 0.01 * rng.randn(dim)
        return individual + mutation

    population_size = 50
    initial_population = generate_initial_population(population_size)

    for _ in range(budget):
        fitness = calculate_fitness(initial_population)
        parents = select_parents(initial_population, fitness, population_size // 2)
        
        children = []
        for i in range(0, len(parents), 2):
            parent1, parent2 = parents[i], parents[i + 1]
            child = crossover(parent1, parent2, rng)
            child = mutate(child, rng)
            children.append(child)

        initial_population = np.concatenate([parents, children])

    best_individual = select_parents(initial_population, calculate_fitness(initial_population), 1)[0]

    return best_individual
