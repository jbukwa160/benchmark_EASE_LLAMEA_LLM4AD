def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (1, dim))
    t = 1000
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = x + 0.05 * np.abs(np.random.normal(size=(1, dim)))
        y = np.clip(y, lb, ub)
        f = func(y)

        if rng.random() < np.exp((best_f - f) / t):
            x = y
            best_x = x.copy()
            best_f = min(best_f, f)

        t *= 0.9999

    return best_x.flatten()
