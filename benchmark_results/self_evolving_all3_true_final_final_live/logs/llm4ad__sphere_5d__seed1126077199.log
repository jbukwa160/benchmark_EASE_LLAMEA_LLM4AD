def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop = 10 * (ub - lb) + rng.uniform(0, 1, size=(dim, 10))
    for _ in range(budget):
        fit_pop = func(clip(pop))
        fit_best = np.min(fit_pop)
        pos_best = pop[np.argmin(fit_pop)]
        
        F = 0.5
        CR = 0.9
        
        for i in range(dim):
            temp1, temp2, temp3, temp4 = rng.random((4,))
            r1, r2, r3 = np.where(rng.uniform(0, 1, size=dim) < CR, pop[rng.randint(0, 10, size=(3)), i], pos_best[i])
            mutation = F * (r1 + r2 + r3 - pop[:, i])
            pop[:, i] = clip(pop[:, i] + mutation)
        
        fit_pop = func(clip(pop))
    return pop[np.argmin(func(clip(pop)))]
