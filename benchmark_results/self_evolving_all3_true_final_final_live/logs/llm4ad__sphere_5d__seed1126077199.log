def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T0 = 1.0
    alpha = 0.99
    T = T0
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        candidate = x + rng.uniform(-1, 1, size=dim) * (ub - lb)
        candidate = np.clip(candidate, lb, ub)
        fcandidate = func(candidate)
        
        if fcandidate < best_f:
            best_x = candidate
            best_f = fcandidate

        delta = fcandidate - best_f
        if delta < 0 or rng.uniform(0, 1) < np.exp(-delta / T):
            x = candidate

        T *= alpha

    return best_x
