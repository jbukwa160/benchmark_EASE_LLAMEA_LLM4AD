def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(clip(x))

    current = np.random.uniform(lb, ub, size=dim)
    best = current.copy()
    temperature = 1.0

    for _ in range(budget):
        step_size = rng.uniform(0.01, 0.1)
        new_candidate = current + rng.normal(size=dim) * step_size
        new_fitness = evaluate(new_candidate)

        if new_fitness < evaluate(current):
            current = new_candidate
            best = np.minimum(best, new_candidate)

        temperature *= 0.9999

        # SA acceptance criterion
        if rng.random() < np.exp((evaluate(current) - new_fitness) / temperature):
            current = new_candidate

    return clip(best)
