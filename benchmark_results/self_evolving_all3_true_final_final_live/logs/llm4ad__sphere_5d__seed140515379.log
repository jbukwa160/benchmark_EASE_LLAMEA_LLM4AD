def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_candidate = None
    best_func_value = float('inf')

    for _ in range(budget):
        initial_candidate = (ub - lb) * rng.rand(dim) + lb

        # Simple Nelder-Mead
        simplex = [clip(initial_candidate)]
        for _ in range(4):
            new_point = np.copy(simplex[-1])
            for i in range(dim):
                if rng.rand() < 0.5:
                    new_point[i] += 1e-3 * rng.randn()
                else:
                    new_point[i] -= 1e-3 * rng.randn()
            simplex.append(clip(new_point))

        while len(simplex) > 2 and _ < budget // 10:
            # Sort the points in descending order of their function values
            sorted_simplices = sorted(simplex, key=lambda x: func(x), reverse=True)

            # Compute centroid of best two points
            centroid = (sorted_simplices[0] + sorted_simplices[1]) / 2

            # Reflection
            reflection_point = 2 * centroid - sorted_simplices[-1]

            if func(reflection_point) < func(sorted_simplices[0]):
                new_simplex = [clip(reflection_point)]
                for i in range(dim):
                    new_simplex.append(clip(new_point := np.copy(reflection_point)))
                    new_point[i] += 1e-3 * rng.randn()
                simplex = sorted(new_simplex + simplex[:-1], key=lambda x: func(x), reverse=True)

            # Expansion
            elif func(reflection_point) < func(sorted_simplices[-2]):
                expansion_point = 2 * reflection_point - centroid
                if func(expansion_point) < func(reflection_point):
                    new_simplex = [clip(expansion_point)]
                    for i in range(dim):
                        new_simplex.append(clip(new_point := np.copy(expansion_point)))
                        new_point[i] += 1e-3 * rng.randn()
                    simplex = sorted(new_simplex + simplex[:-1], key=lambda x: func(x), reverse=True)

            # Contraction
            else:
                contraction_point = centroid - (centroid - sorted_simplices[-1]) / 2

                if func(contraction_point) < func(sorted_simplices[0]):
                    new_simplex = [clip(contraction_point)]
                    for i in range(dim):
                        new_simplex.append(clip(new_point := np.copy(contraction_point)))
                        new_point[i] += 1e-3 * rng.randn()
                    simplex = sorted(new_simplex + simplex[:-1], key=lambda x: func(x), reverse=True)

        # Update best candidate and function value
        if func(simplex[0]) < best_func_value:
            best_candidate = simplex[0]
            best_func_value = func(simplex[0])

    return np.array(best_candidate)
