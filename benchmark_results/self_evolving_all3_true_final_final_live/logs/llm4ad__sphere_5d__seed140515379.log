def algorithm(func, dim, lb, ub, budget, rng):
    def init_candidate(dim):
        return (ub - lb) * rng.rand(dim) + lb
    
    def surrogate(model, x):
        return model.predict(x.reshape(1, -1))
    
    def acquisition_function(model, x_best, x):
        mu, _ = model.predict(x.reshape(1, -1))
        sigma = model.std(x.reshape(1, -1))
        return (mu - func(x_best)) / sigma
    
    def local_search(func, current_x, bounds, budget):
        if budget < 0:
            return current_x
        new_x = current_x + (ub - lb) * rng.uniform(-1, 1, dim)
        new_x = np.clip(new_x, a_min=bounds[0], a_max=bounds[1])
        if func(new_x) < func(current_x):
            return local_search(func, new_x, bounds, budget-1)
        else:
            return current_x
    
    x_best = init_candidate(dim)
    
    for t in range(budget):
        model = GaussianProcessRegressor(kernel=Matern(nu=2.5))
        model.fit(np.array([x_best]).T, func(x_best))
        
        lower_bound = 0
        upper_bound = ub - lb
        
        x_acquisition = None
        max_acquisition_value = float('-inf')
        while upper_bound - lower_bound > 1e-3:
            mid_point = (lower_bound + upper_bound) / 2
            x_candidate = init_candidate(dim)
            candidate_score = surrogate(model, x_candidate)
            
            acquisition = acquisition_function(model, x_best, x_candidate)
            
            if acquisition > max_acquisition_value:
                max_acquisition_value = acquisition
                x_acquisition = x_candidate
        
        if x_acquisition is not None:
            x_new = local_search(func, x_acquisition, (lb, ub), budget - t - 1)
            if func(x_new) < func(x_best):
                x_best = x_new
    
    return np.clip(x_best, a_min=lb, a_max=ub)
