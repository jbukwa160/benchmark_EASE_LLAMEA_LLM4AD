def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    for i in range(budget):
        x_candidate = (ub - lb) * rng.rand(dim) + lb
        y_candidate = func(x_candidate)
        if y_candidate < func(x_best):
            x_best = x_candidate
    return x_best
