def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    T0 = 10.0  # Initial temperature
    T_min = 1e-5  # Minimum temperature
    alpha = 0.99  # Cooling rate
    x_best = -np.ones(n)
    f_best = float('inf')
    for i in range(budget):
        x_curr = rng.uniform(lb, ub, n)
        f_curr = func(x_curr)
        if f_curr < f_best:
            f_best = f_curr
            x_best = x_curr.copy()
        delta_f = f_curr - f_best
        T = max(T_min, T0 * (1 - i / budget))
        if delta_f <= 0 or np.random.rand() < np.exp(-delta_f / T):
            x_best = (x_best + x_curr) / 2.0
    return x_best
