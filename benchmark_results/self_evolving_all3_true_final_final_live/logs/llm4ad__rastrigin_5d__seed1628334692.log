def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    x_best = rng.uniform(lb, ub, size=(dim,))
    f_best = func(x_best)
    
    for _ in range(budget - 1):
        r = 0.5 * (ub - lb) / np.sqrt(_ + 2)
        x_rand = clip(rng.normal(loc=clip(rng.uniform(lb, ub, size=(dim,))), scale=r, size=(dim,)))
        
        if func(x_rand) < f_best:
            f_best = func(x_rand)
            x_best = x_rand
    
    return x_best
