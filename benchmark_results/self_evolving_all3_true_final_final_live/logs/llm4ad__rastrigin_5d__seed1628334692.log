def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(dim,))
    T = 1.0
    alpha = 0.99
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        new_x = rng.normal(size=x.shape)
        new_x = np.clip(new_x + x, lb, ub)
        
        delta_f = func(new_x) - best_f
        
        if delta_f < 0:
            x = new_x
            best_x = new_x.copy()
            best_f = func(best_x)
        elif rng.rand() < np.exp(-delta_f / T):
            x = new_x
            
        T *= alpha
    
    return best_x
