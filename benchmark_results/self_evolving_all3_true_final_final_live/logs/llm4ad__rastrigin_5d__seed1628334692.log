def algorithm(func, dim, lb, ub, budget, rng):
    D = len(dim)
    x0 = rng.uniform(lb, ub, size=D)  # initial solution
    sigma = max(np.abs(ub - lb)) / 2.0  # initial step size
    best_x = x0.copy()
    best_y = func(x0)

    for i in range(budget):
        x = np.clip(best_x + rng.normal(size=D, loc=0, scale=sigma), lb, ub)
        y = func(x)
        if y < best_y:
            best_y = y
            best_x = x.copy()
        sigma = 0.5 * sigma + 1e-6 / (1 + i)

    return best_x
