def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 10 * dim
    D = [np.random.uniform(lb, ub, size=dim) for _ in range(pop_size)]
    F = 0.5
    CR = 0.9
    G = 1

    while budget > 0:
        for i in range(pop_size):
            r1, r2, r3 = np.random.choice(pop_size, size=3, replace=False)
            mutation = D[r1] + F * (D[r2] - D[r3])
            if rng.rand() < CR or func(mutation) <= func(D[i]):
                D[i] = mutation
        for i in range(pop_size):
            x = np.clip(D[i], lb, ub)
            if func(x) < func(D[np.argmin([func(d) for d in D])]):
                best_x = x
        budget -= 1

    return np.array(best_x)
