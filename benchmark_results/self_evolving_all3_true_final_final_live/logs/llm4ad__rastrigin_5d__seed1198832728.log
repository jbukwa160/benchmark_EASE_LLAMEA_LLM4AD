def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = 50
    pbest_pos = np.random.uniform(lb, ub, (pop_size, dim))
    pbest_val = [func(clip(p)) for p in pbest_pos]

    sigma_init = 5.0

    for _ in range(budget):
        # Differential Evolution step
        new_pos = pbest_pos + rng.normal(0, sigma_init, size=(pop_size, dim))

        # Clip candidates to bounds
        new_pos = clip(new_pos)

        # Compute function values and update personal bests
        new_val = [func(p) for p in new_pos]
        for i in range(pop_size):
            if new_val[i] < pbest_val[i]:
                pbest_pos[i] = new_pos[i]
                pbest_val[i] = new_val[i]

        # Simulated Annealing step
        t = 0.9  # temperature
        alpha = 0.99  # cooling rate

        for i in range(pop_size):
            if rng.rand() < np.exp((pbest_val[i] - func(clip(pbest_pos[i]))) / (t * rng.uniform(1e-3, 1e-2))):
                pbest_pos[i] += rng.normal(0, sigma_init)
                pbest_pos[i] = clip(pbest_pos[i])
                pbest_val[i] = func(pbest_pos[i])

        t *= alpha

    return np.array([pbest_pos[np.argmin(pbest_val)]]).flatten()
