def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def generate_candidates(population, lb, ub):
        for i in range(len(population)):
            candidate = population[i] + 0.1 * rng.normal(size=dim)
            candidate = clip(candidate, lb, ub)
            population[i] = candidate
        return population

    def local_search(x_best, func, dim, lb, ub, rng):
        step_size = 0.01
        for _ in range(100):
            x_new = x_best + step_size * rng.normal(size=dim)
            x_new = clip(x_new, lb, ub)
            if func(x_new) < func(x_best):
                x_best = x_new
        return x_best

    population = np.random.uniform(lb, ub, size=(budget, dim))
    for _ in range(budget):
        population = generate_candidates(population, lb, ub)

        scores = [func(individual) for individual in population]
        best_index = np.argmin(scores)
        if func(population[best_index]) < func(local_search(population[best_index], func, dim, lb, ub, rng)):
            x_best = local_search(population[best_index], func, dim, lb, ub, rng)

    return x_best
