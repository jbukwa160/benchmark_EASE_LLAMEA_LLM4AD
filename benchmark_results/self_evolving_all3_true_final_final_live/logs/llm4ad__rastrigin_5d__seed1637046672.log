        elif f3 == max(f2, f5, f6):
            if rng.rand() < 0.1: # simple random search
                u = lb + (ub - lb) * rng.rand(dim)

            alpha = 0.9
            x = alpha*x + (1-alpha)*u

        elif f5 > max(f2, f3, f6):
            x = v.copy()
            best_x = v.copy()

        elif f5 == max(f2, f3, f6):
            if rng.rand() < 0.1: # simple random search
                u = lb + (ub - lb) * rng.rand(dim)

            alpha = 0.9
            x = alpha*x + (1-alpha)*u

        elif f6 > max(f2, f3, f5):
