def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x) + 10*dim

    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = int(np.sqrt(budget))
    mu = np.random.uniform(lb, ub, (pop_size, dim))

    for i in range(budget - pop_size):
        sigma = 0.5
        for _ in range(100):
            x_new = clip(mu + rng.normal(size=(mu.shape[0], dim))*sigma)
            f_new = evaluate(x_new)
            mu = np.where(f_new < func(mu), x_new, mu)

    return np.argmin(func(mu))
