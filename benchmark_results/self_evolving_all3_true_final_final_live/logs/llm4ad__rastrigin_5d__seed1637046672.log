    def rastrigin(x):
        return func(x) + sum(i**2 for i in x)

    x = lb + (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    best_f = rastrigin(x)

    for _ in range(budget):
        u = lb + (ub - lb) * rng.rand(dim)
        v = lb + (ub - lb) * rng.rand(dim)
        w = lb + (ub - lb) * rng.rand(dim)

        f1, f2, f3 = rastrigin(x), rastrigin(u), rastrigin(v)
        f4, f5, f6 = rastrigin(w), rastrigin(x + 0.5*(u - x)), rastrigin(x + 0.5*(v - x))

        if rng.rand() < 0.1: # simple random search
