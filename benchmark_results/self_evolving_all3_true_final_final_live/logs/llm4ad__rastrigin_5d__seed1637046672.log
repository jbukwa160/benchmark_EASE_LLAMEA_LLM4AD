def algorithm(func, dim, lb, ub, budget, rng):
    def surrogate(x):
        return 1e6 * func(x)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = float('inf')
    gp = None

    for _ in range(budget):
        if gp is None:
            gp = surrogate
        else:
            gp.x = x.copy()
            gp.y = surrogate(x).copy()

        mean, var = gp.predict(x)
        std = np.sqrt(var)

        # Sampling from the GP predictive distribution
        u = rng.uniform(0, 1, size=dim)
        s = np.log(-np.log(u))
        e = s * std + mean

        x_new = e.copy()
        f_new = surrogate(x_new).copy()

        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new
            gp.x = x_new.copy()
            gp.y = f_new.copy()

        # Probabilistic hill climbing
        x_climb = x + 0.1 * np.random.uniform(-1, 1, size=dim)
        f_climb = surrogate(x_climb).copy()

        if f_climb < best_f:
            x = x_climb.copy()
            gp.x = x.copy()
            gp.y = f_climb.copy()

    return best_x
