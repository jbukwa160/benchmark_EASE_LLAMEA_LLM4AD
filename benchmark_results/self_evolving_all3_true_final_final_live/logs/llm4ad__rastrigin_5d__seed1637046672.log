def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    n = int(budget / (dim * 10))
    sigma0 = 5.0
    mean = np.zeros(dim)
    cov = np.eye(dim) * 1e-4

    for _ in range(n):
        x = clip(mean + rng.normal(0, sigma0, size=dim))
        fval = func(x)

        new_x = clip(mean + rng.normal(0, sigma0, size=dim))
        fnew_val = func(new_x)

        if fnew_val < fval:
            mean = 0.5 * (mean + new_x)
            cov += 0.1 * np.outer(new_x - mean, new_x - mean)
            fval = fnew_val

    return clip(mean)
