def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    pop_size = 10
    temperature = 1000
    cooling_rate = 0.99
    mutation_factor = 0.5

    population = np.random.uniform(lb, ub, (pop_size, dim))
    best_candidate = clip(population[0])

    for _ in range(budget):
        new_population = np.copy(population)
        for i in range(1, pop_size):
            difference = population[i] - population[np.random.randint(0, i)]
            mutation = mutation_factor * difference + population[np.random.randint(0, i)]
            mutation = clip(mutation)
            new_population[i] = mutation

        for i in range(pop_size):
            if func(new_population[i]) < func(best_candidate):
                best_candidate = new_population[i]

        temperature *= cooling_rate
        noise = np.zeros_like(best_candidate)
        noise[rng.uniform(0, 1, dim) < (temperature / budget)] = rng.choice([-1, 1], size=dim)

        if rng.uniform(0, 1) > np.exp((func(best_candidate + noise) - func(best_candidate)) / temperature):
            best_candidate += noise

    return best_candidate
