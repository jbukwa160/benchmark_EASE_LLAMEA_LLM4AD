def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    def gaussian_process(x_train, y_train):
        from scipy.stats import norm
        X = np.array(x_train).T
        K = np.zeros((len(x_train), len(x_train)))
        for i in range(len(x_train)):
            for j in range(i, len(x_train)):
                K[i, j] = K[j, i] = np.exp(-np.sum((X[:, i]-X[:, j])**2)/ (2*0.1**2))
        lambd = 0.01
        K += lambd * np.eye(len(K))
        inv_K = np.linalg.inv(K)
        mu = np.dot(inv_K, y_train)
        sigma = np.sqrt(np.diag(K) - np.dot(mu.T, np.dot(inv_K, mu)))
        return mu, sigma

    def surrogate(x):
        x_train = []
        y_train = []
        for i in range(len(x)):
            if evaluate(x[:i]) < evaluate(x[i:]):
                x_train.append(i)
                y_train.append(evaluate(x))
        mu, sigma = gaussian_process(x_train, y_train)
        return np.dot(mu, x) + np.sqrt(np.sum(sigma**2 * x**2))

    population_size = 10
    x_best = rng.uniform(lb, ub, (population_size, dim))
    for _ in range(budget):
        scores = [evaluate(x) for x in x_best]
        idx = np.argsort(scores)[:population_size//2]
        x_best = [x_best[i] if i not in idx else rng.uniform(lb, ub, dim) for i in range(population_size)]
        offspring = []
        while len(offspring) < population_size:
            p1, p2 = rng.choice(idx, 2, replace=False)
            x1, x2 = np.copy(x_best[p1]), np.copy(x_best[p2])
            v = rng.normal(size=dim)
            for i in range(dim):
                if rng.uniform() < 0.5:
                    x1[i], x2[i] = x2[i], x1[i]
                if rng.uniform() < 0.3:
                    x1[i] += v[i]
                    x2[i] -= v[i]
            child = (x1 + x2) / 2
            offspring.append(child)
        x_best = [np.clip(np.array(offspring[i]), lb, ub) for i in range(population_size)]
    return np.min(x_best, key=evaluate)
