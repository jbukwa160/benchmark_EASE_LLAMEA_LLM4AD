def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = int(np.sqrt(budget))
    n_iter = 0
    x_best = np.random.uniform(lb, ub, (pop_size, dim))
    f_best = np.inf

    for _ in range(pop_size):
        y = x_best.copy()
        f = func(y)
        if f < f_best:
            f_best = f
            x_best[:] = y[:]

    while n_iter < budget:
        # Differential evolution step
        y = x_best + rng.uniform(-1, 1, (pop_size, dim)) * np.linalg.norm(x_best - x_best[:, np.newaxis], axis=2)
        y = clip(y)

        # Adaptive parameter tuning step
        CR = 0.5 + 0.5 * np.sin(np.pi * n_iter / budget)
        F = 1 - 0.9 * (n_iter / budget)

        for i in range(pop_size):
            u = rng.uniform(0, 1, dim)
            v = rng.permutation(dim)
            for j in range(dim):
                if u[j] < CR or j == 0:
                    y[i, j] = x_best[i, v[j]] + F * (y[i, v[j]] - x_best[i, v[j]])

        # Selection step
        f = func(y)
        mask = f < f_best
        x_best[mask] = y[mask]
        f_best = np.min(f)

        n_iter += 1

    return x_best[np.argmin(func(x_best))]
