def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.minimum(np.maximum(x, lb), ub)

    x = [random.uniform(lb, ub) for _ in range(dim)]
    sigma = 1.0
    mu = np.array(x)
    C = np.eye(dim)

    for i in range(budget):
        y = np.array(func(x))
        f = np.sum(y)
        z = rng.normal(0, 1, dim)
        new_x = clip(mu + sigma * np.dot(C, z), lb, ub)
        new_y = np.array(func(new_x))

        if np.sum(new_y) < f:
            x = new_x
            mu = (i * mu + new_x) / (i + 1)
            C = (1 - 2 / (i + 1)) * C + 1/(i+1) * np.outer(z, z)

        sigma *= 0.99

    return np.array(x)
