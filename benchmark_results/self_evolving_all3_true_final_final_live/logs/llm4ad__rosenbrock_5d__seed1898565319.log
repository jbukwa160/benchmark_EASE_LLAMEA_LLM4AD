def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    n = int(np.ceil(budget / (dim * 2)))
    step_size = 0.5
    for _ in range(n):
        x = rng.uniform(lb, ub, size=dim)
        for _ in range(dim - 1):
            next_x = clip(x + rng.uniform(-step_size, step_size, size=dim))
            if func(next_x) < func(x):
                x = next_x
        best_x = x.copy()
    return best_x
