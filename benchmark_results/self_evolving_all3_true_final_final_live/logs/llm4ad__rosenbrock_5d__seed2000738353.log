def algorithm(func, dim, lb, ub, budget, rng):
    def distance(x1, x2):
        return np.sum((x1 - x2)**2)

    pop_size = 100
    x = np.random.uniform(lb, ub, (pop_size, dim))
    y = func(x)
    best_x = x[np.argmin(y)]
    best_y = np.min(y)

    for i in range(budget):
        # Selection
        u = rng.choice(pop_size, pop_size, replace=True)
        v = rng.choice(pop_size, pop_size, replace=True)
        w = rng.choice(pop_size, pop_size, replace=True)
        x_new = x[u] + 0.5 * (x[v] - x[w])

        # Mutation
        for j in range(dim):
            if rng.random() < 0.1:
                x_new[j] += 10 * rng.uniform(-1, 1)

        # Clip to bounds
        x_new = np.clip(x_new, lb, ub)

        y_new = func(x_new)
        if y_new < best_y:
            best_x = x_new
            best_y = y_new

    return best_x
