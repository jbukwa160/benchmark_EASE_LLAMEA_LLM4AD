def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    n_dim, pop_size = dim, 50
    x_min, x_max = [lb] * n_dim, [ub] * n_dim

    population = [[random.uniform(x_min[i], x_max[i]) for i in range(n_dim)] for _ in range(pop_size)]
    best = [evaluate(np.array(p)) for p in population]

    crossover_rate = 0.7
    mutation_factor = 0.3
    local_search_prob = 0.1

    for t in range(budget):
        for i in range(pop_size):
            a, b, c = random.sample(range(pop_size), 3)
            v = population[a] + crossover_rate * (population[b] - population[c]) + mutation_factor * \
                np.random.uniform(-1, 1, n_dim)

            # Local search
            if random.random() < local_search_prob:
                for _ in range(10):
                    new_v = [v[j] + rng.truncatable_random() / (t + 1) for j in range(n_dim)]
                    new_v = clip(np.array(new_v))
                    if evaluate(new_v) < best[i]:
                        v = new_v

            population[i], best[i] = v, min(best)

        # Update global best
        global_best = min(best)
        if global_best < np.mean(best):
            for i in range(pop_size):
                if random.random() < 0.1:
                    population[i] = clip(np.array([global_best + rng.truncatable_random()] * n_dim))

    return min(population, key=evaluate)
