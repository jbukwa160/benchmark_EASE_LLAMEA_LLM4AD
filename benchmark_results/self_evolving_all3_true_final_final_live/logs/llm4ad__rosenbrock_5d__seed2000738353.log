def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    pop_size = 50
    population = rng.uniform(lb, ub, (pop_size, dim))
    best_x = population[np.argmin([evaluate(x) for x in population])]

    for _ in range(budget - 1):
        trial_pop = np.copy(population)
        for i in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size, 3), rng.randint(0, pop_size, 3), rng.randint(0, pop_size, 3)
            while r1 == i or r2 == i or r3 == i:
                r1, r2, r3 = rng.randint(0, pop_size, 3), rng.randint(0, pop_size, 3), rng.randint(0, pop_size, 3)

            trial_x = clip(population[r1] + 0.5 * (population[r2] - population[r3]))
            if evaluate(trial_x) < evaluate(population[i]):
                trial_pop[i] = trial_x

        population = trial_pop
        best_x = population[np.argmin([evaluate(x) for x in population])]

    return best_x
