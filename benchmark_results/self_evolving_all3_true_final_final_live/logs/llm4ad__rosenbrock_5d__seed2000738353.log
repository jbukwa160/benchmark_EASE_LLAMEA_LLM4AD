def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    D = len(dim)
    pop_size = 50
    F = 0.5
    CR = 0.9
    x_bounds = [(lb[i], ub[i]) for i in range(D)]

    pop = [np.random.uniform(lb, ub, size=D) for _ in range(pop_size)]
    g_best = np.inf
    g_best_x = None

    for budget_used in range(budget):
        scores = [f(x) for x in pop]

        for i in range(pop_size):
            if scores[i] < g_best:
                g_best, g_best_x = scores[i], pop[i].copy()

        r1, r2, r3 = rng.choice(pop_size, size=3, replace=False)
        while (r1 == r2) or (r1 == r3) or (r2 == r3):
            r1, r2, r3 = rng.choice(pop_size, size=3, replace=False)

        child = pop[r1] + F * (pop[r2] - pop[r3])

        for i in range(D):
            if np.random.rand() < CR or child[i] > ub[i]:
                child[i] = min(ub[i], max(lb[i], g_best_x[i] + 0.01 * rng.uniform(-1, 1)))

        scores.append(f(child))

        best_i = np.argmin(scores)
        pop[best_i] = child

    return g_best_x
