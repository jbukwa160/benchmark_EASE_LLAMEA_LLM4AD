def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    elite_size = int(0.2 * pop_size)
    max_iter = int(budget / (pop_size + 1))
    F = 0.5  # scale factor for differential evolution
    CR = 0.9  # crossover probability

    def get_initial_population(rng):
        return np.random.uniform(lb, ub, size=(pop_size, dim))

    def calculate_fitness(population):
        fitness_values = np.zeros((population.shape[0],))
        for i in range(population.shape[0]):
            candidate = population[i]
            fitness_values[i] = func(candidate)
        return fitness_values

    def differential_evolution(population, fitness_values):
        new_population = np.copy(population)
        for i in range(pop_size):
            idx1, idx2, idx3 = rng.choice(range(pop_size), size=3, replace=False)
            if rng.random() < CR or not np.all(np.isclose(new_population[i], population[idx1])):
                a = population[idx1] + F * (population[idx2] - population[idx3])
                new_population[i] = np.clip(a, lb, ub)
        return new_population

    def local_search(population):
        for i in range(pop_size):
            best_i = np.argmax(calculate_fitness(np.array([population[i]])))
            if func(population[best_i]) < func(population[i]):
                population[i] = population[best_i]
        return population

    population = get_initial_population(rng)
    fitness_values = calculate_fitness(population)

    for _ in range(max_iter):
        population = differential_evolution(population, fitness_values)
        fitness_values = calculate_fitness(population)
        population = local_search(population)

    best_individual_idx = np.argmax(calculate_fitness(population))
    return population[best_individual_idx]
