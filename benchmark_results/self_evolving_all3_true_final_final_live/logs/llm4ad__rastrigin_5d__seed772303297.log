def algorithm(func, dim, lb, ub, budget, rng):
    def get_initial_population(dim):
        return rng.uniform(lb, ub, size=(dim, budget))

    best_x = None
    best_fval = float('inf')
    
    for _ in range(10): # Random restarts
        pop = get_initial_population(dim)
        
        mean = np.mean(pop, axis=1)[:, np.newaxis]
        sigma = 1.0
        
        for _ in range(budget):
            dist = rng.randn(dim, 1)
            x_new = mean + sigma * dist
            
            # Clip candidates to [lb, ub]
            x_new = np.clip(x_new, lb, ub)
            
            fval = func(x_new.flatten())
            
            if fval < best_fval:
                best_fval = fval
                best_x = x_new.flatten()
                
            sigma *= 1.01 # Adapt step-size
            
            mean = (mean * (budget - _) + x_new) / (budget + 1)
    
    return best_x
