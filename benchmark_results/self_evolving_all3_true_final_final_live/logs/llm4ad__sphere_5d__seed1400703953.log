def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    current = rng.uniform(lb, ub, size=dim)
    best = current.copy()
    T = 1e5
    learning_rate = 0.01

    for _ in range(budget):
        # Adaptive learning rate and probabilistic cooling schedule
        T *= np.exp(-learning_rate * (_ / budget))

        candidate = current + rng.uniform(-T, T, size=dim)
        candidate = clip(candidate)

        if func(candidate) < func(best):
            best = candidate.copy()

        alpha = 0.9  # Acceptance probability
        if rng.random() < np.exp(-(func(candidate) - func(best)) / T) or rng.random() < alpha:
            current = candidate

    return best
