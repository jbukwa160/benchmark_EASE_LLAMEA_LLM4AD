def algorithm(func, dim, lb, ub, budget, rng):
    x = 5 * (np.random.rand(dim) - 0.5)
    T = 1000
    alpha = 0.99
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        v = np.zeros(dim)
        for i in range(dim):
            v[i] = rng.uniform(-1, 1) * T / (T + 1)
            if rng.random() < 0.5:
                x[i] += v[i]
            else:
                x[i] -= v[i]

        x = np.clip(x, lb, ub)

        f = func(x)
        if f < best_f:
            best_x = x.copy()
            best_f = f

        T *= alpha
        if _ % 100 == 0 or _ == budget - 1:
            print(f'Iteration {_+1}/{budget}, Best f: {best_f:.6f}')

    return best_x
