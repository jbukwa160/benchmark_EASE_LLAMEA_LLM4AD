def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    n_iter = 0
    
    while n_iter < budget:
        # L-BFGS optimization
        g = np.zeros(dim)
        H = np.eye(dim)
        
        for i in range(100):
            s = x - best_x
            y = (func(best_x + 1e-8*s) - func(best_x)) / 1e-8
            
            ysTsy = np.dot(y, s)
            ysTy = np.dot(y, H @ s)
            
            if abs(ysTsy) > 1e-6:
                alpha = ysTy / ysTsy
                delta = s - H @ y * alpha
                
                if i == 0 or ysTsy < 1e-8:
                    H -= np.outer(alpha*s, alpha*s)
                    
                g += y * (func(best_x + delta) - func(best_x))
                
        # Step calculation and line search
        direction = -H @ g
        step_size = 1.0
        
        for i in range(100):
            new_x = best_x + step_size * direction
            
            if all(lb <= new_x[:, i] <= ub) and func(new_x) < best_f:
                x = new_x.copy()
                best_x = new_x.copy()
                best_f = func(new_x)
                
        # Restart strategy
        if np.random.rand() < 0.1 or n_iter > budget // 2:
            x = rng.uniform(lb, ub, (1, dim))
        
        n_iter += 1
    
    return best_x.flatten()
