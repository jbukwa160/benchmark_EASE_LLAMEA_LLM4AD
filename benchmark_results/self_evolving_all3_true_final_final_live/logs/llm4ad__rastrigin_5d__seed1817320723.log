def algorithm(func, dim, lb, ub, budget, rng):
    D = 1.0 / (budget ** (2/len(dim)))
    T = 10 * np.log(budget)
    
    for i in range(1, budget+1):
        x_best = [np.random.uniform(lb[i-1], ub[i-1]) for i in range(len(dim))]
        
        for _ in range(int(budget / len(dim))):
            delta = [np.random.normal() * D + np.random.uniform(-D, D) for i in range(len(dim))]
            x_new = [(x_best[j] + delta[j]) if rng.random() < 0.5 else (x_best[j] - delta[j]) for j in range(len(dim))]
            
            clipped_x_new = [min(max(x_new_j, lb[j]), ub[j]) for j, x_new_j in enumerate(x_new)]
            
            if func(clipped_x_new) < func(x_best):
                x_best = clipped_x_new
        
        T *= np.exp(-0.01)
        
        if rng.random() < np.exp((func(x_best) - func([np.zeros(len(dim))])) / T):
            x_best = [np.clip(x_best_j, lb[j], ub[j]) for j, x_best_j in enumerate(x_best)]
    
    return np.array(x_best)
