def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 10
    lambda_ = pop_size
    mu = int(0.1 * lambda_)
    sigma = 0.5
    x_best = -np.inf
    x_best_sol = None
    iteration = 0

    while True:
        if iteration >= budget:
            break

        # Initialize population
        x_pop = np.random.uniform(lb, ub, size=(lambda_, dim))

        for i in range(lambda_):
            sigma *= (1 + 1e-6)
            x_new = x_pop[i] + np.random.normal(size=dim) * sigma
            if func(x_new) < func(x_best_sol):
                x_best = func(x_new)
                x_best_sol = x_new

        iteration += 1

    return x_best_sol
