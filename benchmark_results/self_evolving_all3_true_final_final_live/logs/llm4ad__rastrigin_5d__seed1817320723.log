def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def generate_initial_population(dim, pop_size):
        return rng.uniform(lb, ub, (pop_size, dim))

    def evaluate(population, func, dim):
        scores = [func(individual) for individual in population]
        return np.array(scores), np.argsort(scores)

    def crossover(parent1, parent2, rng):
        child = (parent1 + parent2) / 2
        return child

    def mutation(child, sigma, rng):
        mutated_child = child + rng.normal(0, sigma, size=dim)
        return mutated_child

    def adaptive_learning_rate(scores, pop_size):
        mean_score = np.mean(scores)
        std_dev = np.std(scores)
        learning_rate = 1 / (1 + np.exp(-mean_score))
        return learning_rate * std_dev / pop_size

    population = generate_initial_population(dim, 50)
    scores, indices = evaluate(population, func, dim)

    for _ in range(budget):
        new_population = []
        for i in range(10):
            parent1_idx, parent2_idx = indices[np.random.choice(len(indices), size=2, replace=False)]
            parent1, parent2 = population[parent1_idx], population[parent2_idx]
            child = crossover(parent1, parent2, rng)
            sigma = adaptive_learning_rate(scores, 50)
            mutated_child = mutation(child, sigma, rng)
            new_population.append(clip(mutated_child, lb, ub))
        new_scores, _ = evaluate(new_population, func, dim)
        scores = np.minimum(new_scores, scores)
        population = new_population

    best_individual_idx = np.argmin(scores)
    return clip(population[best_individual_idx], lb, ub)
