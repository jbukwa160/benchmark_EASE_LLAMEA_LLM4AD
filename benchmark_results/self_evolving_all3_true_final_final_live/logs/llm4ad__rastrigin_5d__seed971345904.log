def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    def clip(x):
        x = np.clip(x, lb, ub)
        return x

    best_x = rng.uniform(lb, ub, size=dim)
    best_f = f(best_x)
    
    for _ in range(budget):
        sigma = 1.0
        lam = dim * 10
        
        while True:
            x_new = best_x + rng.normal(size=dim) * sigma
            
            # Clip candidates to [lb, ub]
            x_new = clip(x_new)
            
            f_new = f(x_new)
            
            if f_new < best_f or rng.uniform(0, 1) < np.exp((best_f - f_new) / (sigma**2)):
                best_x = x_new
                best_f = f_new
                
            sigma *= 0.99
            
            if len(set(np.round(f(best_x), 3))) > 10:  # stop if local optima are found
                break
    
    return best_x
