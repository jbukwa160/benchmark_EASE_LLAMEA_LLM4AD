def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 1.0
    mu = np.zeros(dim)
    C = np.eye(dim) * 0.5
    D = np.zeros((dim,))
    x_best = mu.copy()
    f_best = float('inf')
    num_evals = 0

    while num_evals < budget:
        y = rng.normal(size=(50, dim))
        for i in range(50):
            z = sigma * (C @ y[i]) + mu
            z = np.clip(z, lb, ub)
            f = func(z)

            if f < f_best:
                x_best = z.copy()
                f_best = f

            D[:] += 1 / 49 * (z - mu) ** 2

        num_evals += 50
        sigma *= np.sqrt(np.mean(D)) / 0.5
        C = (C + C @ (np.eye(dim) - np.outer(C, C)) @ C) / 1.05
        D[:] *= 2 / 3

        if f_best < func(x_best):
            mu += 0.01 * (x_best - mu)
            C += 0.01 * (np.outer(x_best - mu, x_best - mu))
            D[:] = 0

    return x_best
