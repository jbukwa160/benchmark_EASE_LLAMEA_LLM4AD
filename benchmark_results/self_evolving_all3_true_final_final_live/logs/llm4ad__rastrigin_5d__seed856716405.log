def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(np.array(x))

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = evaluate(x)

    for _ in range(budget):
        # Differential Evolution (DE) step
        v = x + rng.normal(size=x.shape) * 0.1
        u = clip(v + rng.normal(size=v.shape))
        y = x + rng.normal(size=x.shape)
        z = clip(y + rng.normal(size=y.shape))

        f_v = evaluate(u)
        f_y = evaluate(y)
        f_z = evaluate(z)

        if f_v < best_f:
            best_x = u.copy()
            best_f = f_v
        elif f_y < best_f:
            best_x = y.copy()
            best_f = f_y
        elif f_z < best_f:
            best_x = z.copy()

        # Simulated Annealing (SA) step
        T = 10.0
        alpha = 0.9

        while True:
            i = rng.choice(dim)
            new_x = best_x.copy()
            new_x[i] += rng.normal(size=1) * 0.01
            new_x = clip(new_x)

            new_f = evaluate(new_x)

            if new_f < best_f:
                best_x = new_x.copy()
                best_f = new_f
            elif np.random.rand() < np.exp((best_f - new_f)/T):
                best_x[i] = new_x[i]
                best_f = new_f

            T *= alpha
            if T < 0.1 or rng.random() < 0.01:
                break

    return best_x
