def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.array(rng.uniform(lb, ub, size=dim))
    best_x = x.copy()
    best_y = func(x)
    
    for _ in range(budget):
        z = x + 0.5 * rng.normal(size=dim)
        z = clip(z)
        y = func(z)
        
        if np.random.rand() < 0.1 or y < best_y:
            x = z
            best_x = x.copy()
            best_y = y
            
    return best_x
