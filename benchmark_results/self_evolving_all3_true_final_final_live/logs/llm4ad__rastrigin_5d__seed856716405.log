def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    for i in range(budget):
        x_candidate = np.zeros(dim)
        for j in range(dim):
            if rng.rand() < 0.2:
                sigma = 1 / (i + 1)
                x_candidate[j] = lb + (ub - lb) * rng.randn() * sigma
        f_candidate = func(x_candidate)
        if f_candidate < func(x_best):
            x_best = x_candidate
    return np.clip(x_best, lb, ub)
