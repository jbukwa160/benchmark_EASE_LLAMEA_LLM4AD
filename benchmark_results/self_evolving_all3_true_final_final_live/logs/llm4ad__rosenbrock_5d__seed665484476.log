def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, (dim,))
    best_x = x.copy()
    best_f = func(x)
    
    learning_rate = 0.01
    alpha = 0.1
    
    for _ in range(budget):
        grad = np.zeros((dim,))
        
        for i in range(dim):
            eps = rng.uniform(-1, 1)
            noise = np.zeros((dim,))
            noise[i] = eps
            
            x_noise = x + learning_rate * (func(x + noise) - func(x)) * noise / np.sum(np.abs(noise))
            
            grad += (x_noise - x) / (learning_rate * rng.uniform(0.1, 10))
        
        grad /= dim
        
        step_size = 0.5 * alpha * learning_rate * np.sqrt(budget - _)
        x -= step_size * grad
        
        x = np.clip(x, lb, ub)
        
        if func(x) < best_f:
            best_x = x.copy()
            best_f = func(x)
    
    return best_x
