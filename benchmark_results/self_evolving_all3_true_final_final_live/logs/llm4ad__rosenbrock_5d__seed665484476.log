def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    n_iter = 0
    while n_iter < budget:
        alpha = 1e-2 if n_iter == 0 else 0.01
        step_size = np.sqrt(ub - lb) * rng.uniform(0, 1, size=dim)
        candidate_x = clip(x + alpha * step_size)

        f_candidate = func(candidate_x)
        if f_candidate < best_f:
            best_x = candidate_x.copy()
            best_f = f_candidate
            x = candidate_x
        else:
            alpha /= 2

        n_iter += 1

    return best_x
