def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lower, upper):
        return np.clip(candidate, lower, upper)

    def simulate_annealing(dim, lb, ub, func, temperature=1000, cooling_rate=0.99, steps=1000):
        x = np.random.uniform(lb, ub, size=(dim,))
        best_x = x.copy()
        for _ in range(steps):
            candidate = clip(x + 0.1 * rng.normal(size=(dim,)), lb, ub)
            if func(candidate) < func(best_x):
                best_x = candidate
            elif np.random.rand() < np.exp((func(x) - func(best_x)) / temperature):
                x = candidate
            temperature *= cooling_rate
        return best_x

    def genetic_algorithm(population_size=100, mutation_rate=0.01, generations=50):
        population = rng.uniform(lb, ub, size=(population_size, dim))
        for _ in range(generations):
            fitness = np.array([func(x) for x in population])
            best_x = population[np.argmin(fitness)]
            next_population = []
            while len(next_population) < population_size:
                parent1, parent2 = rng.choice(population, size=2, replace=False)
                child = (parent1 + parent2) / 2
                if np.random.rand() < mutation_rate:
                    child += rng.normal(size=(dim,))
                next_population.append(clip(child, lb, ub))
            population = np.array(next_population)
        return population[np.argmin([func(x) for x in population])]

    best_x_ga = genetic_algorithm()
    best_x_sa = simulate_annealing(dim, lb, ub, func)

    if func(best_x_sa) < func(best_x_ga):
        return clip(best_x_sa + 0.1 * rng.normal(size=(dim,)), lb, ub)
    else:
        return clip(best_x_ga + 0.1 * rng.normal(size=(dim,)), lb, ub)
