def algorithm(func, dim, lb, ub, budget, rng):
    def obj(x):
        return func(x)

    def clip(x):
        return np.clip(x, lb, ub)

    x0 = np.random.uniform(lb, ub, size=dim)
    best_x = x0
    best_f = obj(best_x)

    for i in range(budget):
        population_size = int(np.ceil(rng * dim))
        pop = [clip(np.random.uniform(lb, ub, size=dim)) for _ in range(population_size)]
        for j in range(dim):
            mean = np.mean([x[j] for x in pop], axis=0)
            diff = [(x[j] - mean) / rng for x in pop]
            new_pop = []
            for x in pop:
                idx = np.random.choice(range(len(pop)), size=int(np.ceil(rng)), replace=False)
                delta = np.array([np.mean([diff[x[1]][j] for x in zip(idx, pop)]) if diff[x[0]][j] == 0 else diff[x[0]][j] for x in zip(idx, pop)])
                new_x = x + rng * delta
                new_pop.append(clip(new_x))
            pop = new_pop

        best_f_new = np.inf
        for x in pop:
            f_new = obj(x)
            if f_new < best_f_new:
                best_f_new = f_new
                best_x = x

        if best_f_new < best_f:
            best_f = best_f_new
            best_x = best_x * 0.9 + best_x_new * 0.1

    return best_x
