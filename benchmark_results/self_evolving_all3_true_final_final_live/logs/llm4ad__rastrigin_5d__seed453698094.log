def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    max_iter = budget // pop_size
    alpha = 0.5
    crossover_prob = 1
    mutation_prob = 0.01
    n_pop = 10
    
    for i in range(max_iter):
        population = np.zeros((pop_size, dim))
        for j in range(pop_size):
            for k in range(dim):
                population[j, k] = rng.uniform(lb[k], ub[k])
        
        fitness = np.array([func(x) for x in population])
        
        for _ in range(n_pop):
            idx1, idx2, idx3 = random.sample(range(pop_size), 3)
            child = (alpha * population[idx1]) + ((1 - alpha) * (population[idx2] + population[idx3]))
            crossover_prob = max(0.5, crossover_prob - 0.01)
            if rng.random() < crossover_prob:
                for k in range(dim):
                    if rng.random() < mutation_prob:
                        child[k] += rng.uniform(-1, 1) * 0.2
                    child[k] = np.clip(child[k], lb[k], ub[k])
            
            fitness_child = func(child)
            idx_min = np.argmin(fitness)
            if fitness_child < fitness[idx_min]:
                population[idx_min] = child
                fitness[idx_min] = fitness_child
        
        best_solution = population[np.argmin(fitness)]
    
    return best_solution
