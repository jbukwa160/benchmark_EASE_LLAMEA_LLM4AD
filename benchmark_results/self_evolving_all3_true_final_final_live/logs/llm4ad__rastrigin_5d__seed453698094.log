def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(budget):
        return np.random.uniform(lb, ub, size=(budget, dim))

    def evaluate_candidates(candidates, func):
        return [func(individual) for individual in candidates]

    def differential_evolution(population, budget, func):
        while len(population) < budget:
            idx1 = rng.randint(0, len(population))
            idx2 = rng.randint(0, len(population))
            new_individual = population[idx1] + 0.5 * (population[idx2] - population[rng.randint(0, len(population))])
            population.append(np.clip(new_individual, lb, ub))
        return np.array(population)

    def simulated_annealing(population, budget, func):
        current_best = min(population, key=func)
        temperature = 1.0
        for _ in range(budget):
            if rng.random() < np.exp((func(current_best) - func(np.clip(np.random.uniform(lb, ub, size=(dim)), lb, ub))) / temperature):
                population.append(np.clip(np.random.uniform(lb, ub, size=(dim)), lb, ub))
                current_best = min(population, key=func)
            if rng.random() < 0.01: # occasional restart
                population[:] = [np.array([rng.uniform(lb, ub) for _ in range(dim)])]
        return np.array(population)

    def clip_candidates(candidates, lb, ub):
        return np.clip(candidates, lb, ub)

    population = generate_initial_population(budget)
    for _ in range(1000): # 1000 iterations of DE/SA
        new_population = differential_evolution(population, budget // 2, func)
        new_population = simulated_annealing(new_population, budget // 2, func)
        population = clip_candidates(new_population, lb, ub)

    return min(population, key=func)
