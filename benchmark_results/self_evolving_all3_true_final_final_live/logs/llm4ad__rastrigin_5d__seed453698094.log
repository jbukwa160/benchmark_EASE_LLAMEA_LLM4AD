def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    x_best = np.random.uniform(lb, ub, size=dim)
    best_fitness = f(x_best)

    for i in range(budget):
        n1, n2, n3 = rng.choice(dim, 3, replace=False)
        v = x_best + 0.5 * (np.array([x_best[n1], x_best[n2], x_best[n3]]) - np.array([x_best[(n1+1)%dim], x_best[(n2+1)%dim], x_best[(n3+1)%dim]]))
        v = lb + (ub-lb) * rng.uniform(size=dim)
        for j in range(dim):
            if rng.random() < 0.01:
                v[j] += 10**rng.uniform(-6, -4) * (v[j] - x_best[j])
        v = np.clip(v, lb, ub)
        fitness = f(v)

        if fitness < best_fitness:
            best_fitness = fitness
            x_best = v

    return x_best
