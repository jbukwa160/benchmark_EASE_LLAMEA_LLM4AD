def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    D = 0.7
    F = 0.8
    population = rng.uniform(lb, ub, (pop_size, dim))
    bestsol = population[np.argmin([func(x) for x in population])]

    for _ in range(budget):
        trial_pop = np.copy(population)
        for i in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size, 3)
            while r1 == i or r2 == i or r3 == i:
                r1, r2, r3 = rng.randint(0, pop_size, 3)

            trial_vector = population[r1] + F * (population[r2] - population[r3])
            trial_pop[i] = np.clip(trial_vector, lb, ub)
        population = trial_pop

    bestsol = np.clip(bestsol, lb, ub)
    return bestsol
