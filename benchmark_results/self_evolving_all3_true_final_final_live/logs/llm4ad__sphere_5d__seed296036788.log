def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        step_size = 1.0 / (budget + _)
        r = np.clip(rng.randn(dim) * step_size, -5.0, 5.0)
        new_x = x + r
        new_f = func(new_x)
        
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f
        
        x = np.clip(best_x + (new_x - best_x) * rng.rand(), lb, ub)

    return best_x
