def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(budget ** 0.5)
    pop = np.random.uniform(lb, ub, (pop_size, dim))
    best_sol = None
    best_val = np.inf
    
    for t in range(budget):
        F = 0.7 - (t / budget) * 0.3
        CR = 1 - (t / budget)
        
        pop_new = []
        for i in range(pop_size):
            x_i = pop[i]
            f_xi = func(x_i)
            
            if f_xi < best_val:
                best_sol = x_i
                best_val = f_xi
            
            r1, r2, r3 = rng.choice(range(pop_size), 3, replace=False)
            v_i = x_i + F * (pop[r1] - x_i) + F * (pop[r2] - x_i) + F * (pop[r3] - x_i)
            
            if rng.random() < CR or not np.all(v_i == x_i):
                v_i = np.clip(v_i, lb, ub)
                f_vi = func(v_i)
                
                if f_vi < best_val:
                    pop_new.append(v_i)
                else:
                    pop_new.append(x_i)
            else:
                pop_new.append(x_i)
        
        pop = np.array(pop_new)
    
    return best_sol
