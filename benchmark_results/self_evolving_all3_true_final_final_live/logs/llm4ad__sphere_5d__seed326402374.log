def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    for _ in range(budget):
        x_new = x + rng.normal(size=dim) * 0.1
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)
        if f_new < func(best_x):
            best_x = x_new
        x = best_x.copy() + rng.normal(size=dim) * 0.1
        x = np.clip(x, lb, ub)
    return best_x
