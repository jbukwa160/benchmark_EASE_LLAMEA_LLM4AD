def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def obj(candidate):
        candidate = clip(candidate)
        return func(candidate)

    def differential_evolution():
        population_size = 20
        generations = 10
        mutation_factor = 0.5
        crossover_probability = 0.8

        population = rng.uniform(lb, ub, size=(population_size, dim))
        best_candidate = np.zeros(dim)
        best_fitness = np.inf

        for _ in range(generations):
            offspring = population.copy()
            for i in range(population_size):
                target = population[i]
                a = rng.choice(population_size, replace=False)
                b = rng.choice(population_size, replace=False)
                while b == a or b == i:
                    b = rng.choice(population_size, replace=False)

                u = rng.uniform(0, 1, size=dim)
                v = rng.uniform(0, 1, size=dim)

                offspring[i] = target + mutation_factor * (b - target) * u
                if rng.rand() < crossover_probability:
                    offspring[i] += (population[a] - population[b]) * v

            fitnesses = np.array([obj(candidate) for candidate in offspring])
            best_idx = np.argmin(fitnesses)
            best_candidate = clip(offspring[best_idx])

            if fitnesses[best_idx] < best_fitness:
                best_fitness = fitnesses[best_idx]

        return best_candidate, best_fitness

    def simulated_annealing():
        temperature = 1000
        cooling_rate = 0.99
        candidate = rng.uniform(lb, ub)
        current_fitness = obj(candidate)

        while temperature > 1 and budget > 0:
            neighbor = candidate + rng.uniform(-temperature / 10, temperature / 10)
            neighbor = clip(neighbor)
            new_fitness = obj(neighbor)

            if new_fitness < current_fitness:
                candidate = neighbor
                current_fitness = new_fitness
            elif rng.rand() < np.exp((current_fitness - new_fitness) / temperature):
                candidate = neighbor
                current_fitness = new_fitness

            budget -= 1
            temperature *= cooling_rate

        return candidate, current_fitness

    # Hybrid algorithm
    population_size = 10
    generations = 5
    mutation_factor = 0.2
    crossover_probability = 0.6

    population = rng.uniform(lb, ub, size=(population_size, dim))
    best_candidate = np.zeros(dim)
    best_fitness = np.inf

    for _ in range(generations):
        offspring = population.copy()
        for i in range(population_size):
            target = population[i]
            a = rng.choice(population_size, replace=False)
            b = rng.choice(population_size, replace=False)
            while b == a or b == i:
                b = rng.choice(population_size, replace=False)

            u = rng.uniform(0, 1, size=dim)
            v = rng.uniform(0, 1, size=dim)

            offspring[i] = target + mutation_factor * (b - target) * u
            if rng.rand() < crossover_probability:
                offspring[i] += (population[a] - population[b]) * v

        fitnesses = np.array([obj(candidate) for candidate in offspring])
        best_idx = np.argmin(fitnesses)
        best_candidate = clip(offspring[best_idx])

        if fitnesses[best_idx] < best_fitness:
            best_fitness = fitnesses[best_idx]

    # Local refinement with Simulated Annealing
    temperature = 1000
    cooling_rate = 0.99
    current_fitness = obj(best_candidate)

    while temperature > 1 and budget > 0:
        neighbor = best_candidate + rng.uniform(-temperature / 10, temperature / 10)
        neighbor = clip(neighbor)
        new_fitness = obj(neighbor)

        if new_fitness < current_fitness:
            best_candidate = neighbor
            current_fitness = new_fitness
        elif rng.rand() < np.exp((current_fitness - new_fitness) / temperature):
            best_candidate = neighbor
            current_fitness = new_fitness

        budget -= 1
        temperature *= cooling_rate

    return best_candidate, best_fitness
