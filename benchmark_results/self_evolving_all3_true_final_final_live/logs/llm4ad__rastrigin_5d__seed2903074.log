def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    population_size = 10
    population = rng.uniform(lb, ub, (population_size, dim))
    best = None
    for _ in range(budget):
        new_population = []
        for candidate in population:
            clone = clip(candidate + rng.normal(0, 1e-3, dim))
            clone_new = clip(clone + rng.uniform(-5, 5, dim))
            new_population.append(clip((clone + clone_new) / 2))
        population = np.array(new_population)
        scores = func(population).flatten()
        best_candidate = population[np.argmax(scores)]
        if not best or np.max(scores) > func(best):
            best = best_candidate
    return best
