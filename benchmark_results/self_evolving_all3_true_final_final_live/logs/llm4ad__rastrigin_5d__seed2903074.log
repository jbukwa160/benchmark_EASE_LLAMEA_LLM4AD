def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    def differential_evolution(pop_size, max_iter, mu=0.5):
        pop = np.random.uniform(lb, ub, (pop_size, dim))
        for _ in range(max_iter):
            new_pop = pop + mu * (pop - np.expand_dims(pop[np.random.choice(pop_size, 1), :], 0) +
                                  np.expand_dims(pop[np.random.choice(pop_size, 1), :], 0) +
                                  np.expand_dims(pop[np.random.choice(pop_size, 1), :], 0))[:, None]
            new_pop = clip(new_pop)
            pop = np.where(np.random.rand(pop_size, dim) < 0.5, pop, new_pop)
        return pop

    def simulated_annealing(x0, max_iter, T=100):
        x = x0
        for _ in range(max_iter):
            delta = evaluate(np.clip(x + rng.uniform(-1, 1, dim), lb, ub)) - evaluate(x)
            if delta > 0 or np.random.rand() < np.exp(delta / T):
                x += rng.uniform(-1, 1, dim)
            else:
                T *= 0.99
        return x

    pop = differential_evolution(50, budget // 2)
    best_x = np.inf * np.ones(dim)
    for x in pop:
        local_best = simulated_annealing(x, budget // 4)
        if evaluate(local_best) < evaluate(best_x):
            best_x = local_best
    return best_x
