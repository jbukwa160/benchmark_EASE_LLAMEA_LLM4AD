def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    pop = np.random.uniform(lb, ub, (budget, dim))
    best = None

    for _ in range(budget):
        fit_pop = func(clip(pop))

        if best is None or np.min(fit_pop) < func(clip(best)):
            best = pop[np.argmin(fit_pop)]

        fit_diff = np.abs(np.diff(func(clip(np.concatenate((pop, pop[:, [0]]))))))
        idx = np.argsort(fit_diff)[::-1][:int(dim/2)]
        pop[idx] = rng.choice(pop[idx], (dim-2, dim), replace=False).T

    return clip(best)
