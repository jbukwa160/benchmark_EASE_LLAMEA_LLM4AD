def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    sigma = 1.0
    mu = x.copy()
    cm = np.eye(dim)
    
    for _ in range(budget):
        y = func(mu)
        
        if _ % 100 == 0:
            print(f"Iteration {_}, Best solution: {mu}, f(x) = {y}")
        
        z = rng.randn(dim)
        stepsize = 1.0 / np.linalg.norm(z, axis=0)
        new_x = mu + sigma * z
        
        # Clip candidates to [lb, ub]
        new_x = np.clip(new_x, lb, ub)
        
        y_new = func(new_x)
        
        if y < y:
            mu = new_x
            y = y_new
            
        cm += (np.outer((new_x - mu), (new_x - mu)) - cm) / (_ + 1)
        
        sigma = np.sqrt(np.dot(np.diag(cm), rng.randn(dim)))
    
    return mu
