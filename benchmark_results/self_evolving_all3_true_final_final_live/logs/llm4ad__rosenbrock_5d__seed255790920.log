def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_candidate = np.zeros(dim)
    best_fitness = float('inf')

    for _ in range(budget):
        candidate = lb + (ub - lb) * rng.uniform(size=dim)
        clipped_candidate = clip(candidate)
        fitness = func(clipped_candidate)

        if fitness < best_fitness:
            best_fitness = fitness
            best_candidate = clipped_candidate

        # Adaptive Random Search: Explore new areas based on the performance of previously evaluated candidates
        if fitness > 0.1 * best_fitness:
            std_dev = (ub - lb) / np.sqrt(_ + 1)
            candidate += rng.normal(size=dim, loc=0, scale=std_dev)
            clipped_candidate = clip(candidate)
            new_fitness = func(clipped_candidate)

            if new_fitness < fitness:
                candidate = clipped_candidate

        best_candidate = clip(best_candidate)

    return best_candidate
