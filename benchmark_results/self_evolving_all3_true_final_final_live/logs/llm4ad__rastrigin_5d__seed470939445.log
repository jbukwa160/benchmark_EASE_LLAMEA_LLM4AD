def algorithm(func, dim, lb, ub, budget, rng):
    def clipped(x):
        return np.clip(x, lb, ub)

    def rastrigin(x):
        return func(x) + np.sum([10 * (x_i ** 2 - 10 * np.cos(2 * np.pi * x_i)) for x_i in x])

    population_size = int(np.ceil(budget / 2))
    temperature = 100
    cooling_rate = 0.9

    x_population = rng.uniform(lb, ub, (population_size, dim))

    for i in range(int(budget)):
        f_values = np.array([rastrigin(clipped(x)) for x in x_population])
        best_idx = np.argmin(f_values)
        best_x = clipped(x_population[best_idx])

        delta_x = rng.normal(size=(1, dim))
        trial_x = clipped(best_x + delta_x)

        trial_f_value = rastrigin(trial_x)

        alpha = rng.uniform(0, 1)
        if trial_f_value < f_values[best_idx] or np.exp((f_values[best_idx] - trial_f_value) / temperature) > alpha:
            x_population[best_idx] = trial_x

        temperature *= cooling_rate

    return best_x
