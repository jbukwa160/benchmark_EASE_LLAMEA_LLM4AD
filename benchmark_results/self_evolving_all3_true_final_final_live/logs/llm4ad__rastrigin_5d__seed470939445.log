def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def mutate(candidates):
        a = rng.uniform(0, 1)
        b = rng.uniform(0, 1)
        c = rng.uniform(0, 1)
        d = rng.uniform(-1, 1)
        mutant = candidates + d * (candidates[b] - candidates[a])
        return mutant

    def mutate_poly(candidate):
        indices = np.random.choice(dim, size=3, replace=False)
        for i in range(dim):
            if i not in indices:
                candidate[i] += rng.uniform(-1, 1) * candidate[i]
        return candidate

    best_candidate = clip(rng.uniform(lb, ub, size=(dim)))
    best_fitness = func(best_candidate)

    for _ in range(budget // dim + 10):
        candidates = [clip(mutate_poly(clip(rng.uniform(lb, ub, size=(dim))))) for _ in range(dim)]
        fitnesses = [func(candidate) for candidate in candidates]

        if np.min(fitnesses) < best_fitness:
            best_candidate = clip(candidates[np.argmin(fitnesses)])
            best_fitness = np.min(fitnesses)

    return best_candidate
