def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    sigma = 0.5
    N_merge = int(pop_size * 0.2)
    
    population = np.random.uniform(lb, ub, (pop_size, dim))
    
    for i in range(budget):
        X_i = population[np.random.choice(range(pop_size), size=3, replace=False)]
        
        F_1 = func(X_i[0]) - func(X_i[2])
        F_2 = func(X_i[1]) - func(X_i[2])
        
        if F_1 < 0:
            X_merge = X_i[0] + sigma * (X_i[1] - X_i[2])
        elif F_2 < 0:
            X_merge = X_i[1] + sigma * (X_i[0] - X_i[2])
        else:
            X_merge = X_i[2]
        
        if rng.random() > 0.5 and i >= budget // 3:
            population[np.argmin([func(X) for X in population])] = X_merge
        
        population = np.clip(population, lb, ub)
    
    return population[np.argmin([func(X) for X in population])]
