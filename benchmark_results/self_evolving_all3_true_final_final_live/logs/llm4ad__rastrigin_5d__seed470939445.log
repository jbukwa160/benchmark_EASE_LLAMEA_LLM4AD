def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def gaussian_mutate(x1, x2, sigma):
        return x1 + (x2 - x1) * np.random.normal(0, 1) / np.sqrt(np.mean([np.var(x1), np.var(x2)]))

    n_population = 50
    population_size = int(budget // dim)
    population = rng.uniform(lb, ub, size=(n_population, dim))
    fitness = np.array([func(individual) for individual in population])

    sigma = 5.0
    best_individual = None

    for _ in range(population_size):
        indices = np.random.choice(n_population, size=3, replace=False)
        mutant = clip(gaussian_mutate(population[indices[0]], population[indices[1]], sigma))
        trial = clip(mutant + 0.5 * (population[indices[2]] - population[indices[0]]))
        trial_fitness = func(trial)

        if trial_fitness < fitness[indices[0]]:
            population[indices[0]] = trial
            fitness[indices[0]] = trial_fitness

        best_individual = np.argmin(fitness)
        sigma *= 1 + 1e-6 * (fitness[best_individual] - func(population[best_individual]))

    return population[best_individual]
