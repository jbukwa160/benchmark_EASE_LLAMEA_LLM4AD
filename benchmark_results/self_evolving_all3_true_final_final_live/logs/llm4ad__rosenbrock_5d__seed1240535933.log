def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        step_size = 0.01 * (ub - lb) / np.sqrt(_ + 1)
        new_x = x + rng.normal(size=x.shape) * step_size
        
        # Clip to bounds
        new_x = np.clip(new_x, lb, ub)
        
        f_new = func(new_x)
        if f_new < best_f:
            best_f = f_new
            best_x = new_x
            
        # Adaptive step size adjustment
        if _ > 0 and rng.uniform() < 0.1:
            step_size *= np.exp(rng.normal(scale=0.5))
            
    return best_x
