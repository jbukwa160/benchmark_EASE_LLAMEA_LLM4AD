def algorithm(func, dim, lb, ub, budget, rng):
    def bounds(x):
        return np.clip(x, lb, ub)

    pop_size = int(budget / (dim * 1.5))
    pop = rng.uniform(lb, ub, (pop_size, dim))

    gbest = None
    nfev = 0

    for i in range(pop_size):
        x = bounds(pop[i])
        f = func(x)
        nfev += 1

        if gbest is None or f < func(gbest):
            gbest = x

    def mutation_strategy(pop, gbest, best, p, lb, ub):
        return np.where(rng.uniform(0, 1, (pop_size, dim)) < p,
                        bounds(best + rng.normal(size=(pop_size, dim))),
                        bounds(gbest + rng.uniform(-1, 1, size=(pop_size, dim))))

    p = 0.5
    best = gbest

    for _ in range(budget - pop_size * nfev):
        mutation = mutation_strategy(pop, gbest, best, p, lb, ub)
        trial = bounds(mutation + rng.uniform(-1, 1, size=(pop_size, dim)))

        f_trial = np.zeros(pop_size)
        for i in range(pop_size):
            f_trial[i] = func(trial[i])
            nfev += 1

            if gbest is None or f_trial[i] < func(gbest):
                gbest = trial[i]

            if f_trial[i] < func(best):
                best = trial[i]

        p = (budget - _ * nfev) / (budget - pop_size * nfev)
        if p > 0.5:
            p = 1

        pop = np.where(rng.uniform(0, 1, (pop_size, dim)) < p,
                       mutation, trial)

    return best
