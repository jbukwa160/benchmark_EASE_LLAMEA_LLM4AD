        X_train = np.vstack([x_best.reshape(1,-1)])
        Y_train = np.array([y_best])
        gp.fit(X_train, Y_train)

        x_next = gp.predict(np.linspace(lb, ub, 100).reshape(-1,1))
        acquisition_func = AcquisitionFunction(x_next, gp)
        x_next = acquisition_func.get_next_point(gp, rng)

        x_next = np.clip(x_next, lb, ub)
        y_next = func(x_next)

        if y_next < y_best:
            x_best = x_next
