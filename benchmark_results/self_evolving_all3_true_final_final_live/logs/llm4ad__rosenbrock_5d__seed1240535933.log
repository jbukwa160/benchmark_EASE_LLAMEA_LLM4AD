def algorithm(func, dim, lb, ub, budget, rng):
    def func_wrapper(x):
        return func(x)

    initial_temperature = 10.0
    temperature = initial_temperature
    cooling_rate = 0.99
    best_solution = None
    best_fitness = float('inf')
    num_candidates = 100

    x_current = rng.uniform(-5, 5, size=dim)
    for t in range(budget):
        # Generate new candidates using K-Means clustering
        cluster_centers = kmeans(x_current.reshape(1, -1), num_candidates)

        for i in range(num_candidates):
            x_candidate = np.clip(cluster_centers[i] + rng.uniform(-0.5, 0.5, size=dim), lb, ub)
            fitness_candidate = func_wrapper(x_candidate)

            if fitness_candidate < best_fitness:
                best_fitness = fitness_candidate
                best_solution = x_candidate

        # Update temperature using adaptive cooling schedule
        temperature *= max(1 - (cooling_rate * t / budget), 0.01)

        # Accept new solution with probability based on temperature and fitness difference
        if func_wrapper(best_solution) < func_wrapper(x_current):
            x_current = best_solution
        elif rng.rand() < np.exp((func_wrapper(x_current) - func_wrapper(best_solution)) / temperature):
            x_current = best_solution

    return best_solution
