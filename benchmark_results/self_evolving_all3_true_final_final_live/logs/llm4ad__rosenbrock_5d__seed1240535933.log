def algorithm(func, dim, lb, ub, budget, rng):
    def bound(candidate):
        return np.clip(candidate, lb, ub)

    def mutate(parents, target):
        n = parents.shape[0]
        F = (np.abs(rng.normal(0, 1)) + 1) / 2
        trial = parents[rng.randint(n)]
        for i in range(dim):
            a = rng.choice(n)
            b = rng.choice(n)
            if rng.random() < 0.5:
                trial[i] = parent[a, i] + F * (parent[b, i] - parent[a, i])
            else:
                trial[i] = parent[a, i] + F * (trial[i] - parent[a, i])
        return bound(trial)

    def crossover(parents, target):
        n = parents.shape[0]
        child = np.zeros(dim)
        for i in range(dim):
            a = rng.randint(n)
            if rng.random() < 0.5:
                child[i] = parents[a, i] + (target[i] - parents[a, i]) / 2
            else:
                child[i] = target[i]
        return bound(child)

    population_size = 50
    learning_rate = np.ones(population_size)
    population = rng.uniform(lb, ub, (population_size, dim))
    best_candidate = None

    for _ in range(budget):
        scores = [func(candidate) for candidate in population]
        best_score = min(scores)
        if best_candidate is None or best_score < func(best_candidate):
            best_candidate = population[scores.index(best_score)]
        
        learning_rate *= 0.99
        for i in range(population_size):
            trial = mutate(population, bound(np.array(best_candidate)))
            crossover_trial = crossover(population, bound(trial))
            if rng.random() < 0.5:
                population[i] = crossover_trial
            else:
                population[i] = trial
            scores[i] = func(population[i])

    return best_candidate
