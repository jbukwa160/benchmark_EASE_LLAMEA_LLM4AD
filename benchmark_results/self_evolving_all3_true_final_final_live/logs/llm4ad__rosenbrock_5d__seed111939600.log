def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(parents):
        child = np.array(parents[0])
        for i in range(dim):
            if rng.random() < 0.1:
                child[i] += rng.uniform(-1, 1)
        return clip(child)

    def mutate(child, parents):
        mutant = child + np.dot(rng.randn(5), np.std(np.array(parents)))
        return clip(mutant)

    def select_parents(population):
        return population[np.argmin([func(x) for x in population])]

    population_size = 50
    population = [np.random.uniform(lb, ub, dim) for _ in range(population_size)]
    parents = None

    for i in range(budget):
        parents = select_parents(population)
        children = [generate_candidate(parents), mutate(generate_candidate(parents), parents)]
        population = np.vstack([population, children])
        population = population[np.argmin([func(x) for x in population])]

    return np.array(select_parents(population))
