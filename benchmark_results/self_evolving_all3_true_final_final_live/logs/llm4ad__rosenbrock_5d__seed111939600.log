def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    population_size = 10 * dim + 1  # Simple heuristic to balance exploration-exploitation trade-off
    learning_rate = 0.5  # Initial learning rate

    x0 = (ub - lb) * rng.rand(dim) + lb  # Initialize first candidate with random bounds
    f0 = func(x0)

    for _ in range(budget):
        if len(population) < population_size:
            new_candidate = clip((ub - lb) * rng.randn(dim) + lb)
            population.append(new_candidate)
        else:
            x1, f1 = select_best(population, func)
            x2, f2 = mutate(x0, x1, learning_rate)
            x3, f3 = mutate(x1, x2, learning_rate)

            # Update candidate with best fitness
            if f2 < f0 or f3 < f0:
                x0 = clip(learning_rate * x0 + (1 - learning_rate) * x3) if f3 < f2 else clip(learning_rate * x0 + (1 - learning_rate) * x2)
                f0 = min(f2, f3)

            # Update population with new candidate
            population.append(x3)

    best_x = select_best(population, func)[0]
    return best_x
