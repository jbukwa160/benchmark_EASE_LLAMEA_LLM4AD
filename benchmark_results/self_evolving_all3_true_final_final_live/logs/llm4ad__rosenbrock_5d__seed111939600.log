def algorithm(func, dim, lb, ub, budget, rng):
    def acceptance_criterion(x_new, f_new, x_best, f_best):
        return f_new < f_best or (f_new <= f_best + 0.01 * abs(f_best) and rng.random() < 0.1)

    mean = np.array([random.uniform(lb, ub) for _ in range(dim)])
    sigma = 10
    step_size = 1 / (dim ** 2)
    iteration = 0

    while iteration < budget:
        iteration += 1
        offspring = np.clip(mean + rng.normal(0, sigma, size=(100, dim)), lb, ub)

        f_offspring = func(offspring)

        mask = [acceptance_criterion(x, f, mean, func(np.array([1.0] * dim))) for x, f in zip(offspring, f_offspring)]

        offspring = np.array([x if m else mean for x, m in zip(offspring, mask)])

        mean = (sigma ** 2) * np.mean(offspring, axis=0)
        sigma *= np.exp(-step_size * iteration / budget)

    return mean
