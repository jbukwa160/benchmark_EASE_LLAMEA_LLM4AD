    pop_size = 50
    x_min = [ub] * dim
    x_max = [lb] * dim
    pop = init_population(pop_size, dim, lb, ub)
    best_individuals = []
    
    for _ in range(budget):
        # Evaluate fitness function for each individual
        fitness_values = func(pop)
        
        # Find the fittest individuals
        idx_best = np.argsort(fitness_values)[:5]
        best_individuals.append(pop[idx_best])
        
        # Differential evolution
        mutant_pop = differential_evolution(pop, pop_size, x_min, x_max)
        
        # Selection
        select = np.random.choice([0, 1], size=pop_size, p=[0.2, 0.8])
        new_population = mutant_pop * select + pop * (1 - select)
        
        # Clip candidates to [lb, ub]
        for i in range(pop_size):
            new_population[i] = np.clip(new_population[i], lb, ub)
            
        pop = new_population
    
    best_individuals = np.array(best_individuals)
    
    min_fitness_value = np.min(func(best_individuals))
    min_idx = np.argmin(min_fitness_value)
    
    return best_individuals[min_idx]
