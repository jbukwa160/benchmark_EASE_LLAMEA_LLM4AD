def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    x = np.zeros(dim)
    cov_matrix = np.eye(dim) * 1e-4

    for _ in range(budget):
        x_new = x + rng.randn(dim) / np.sqrt(np.sum(cov_matrix))
        x_new = clip(x_new)

        f_x_new = func(x_new)

        if f_x_new < func(x):
            x = x_new
            cov_matrix *= 1.0 + (f_x_new - func(x)) * 0.1

    return x
