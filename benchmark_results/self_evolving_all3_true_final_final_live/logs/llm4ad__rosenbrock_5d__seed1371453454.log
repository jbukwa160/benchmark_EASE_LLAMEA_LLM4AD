def algorithm(func, dim, lb, ub, budget, rng):
    def sim_anneal_schedule(t, current, new, T):
        delta = func(new) - func(current)
        if delta < 0:
            return new
        else:
            p = np.exp(-delta / T)
            r = rng.random()
            if r < p:
                return new
            else:
                return current

    def differential_evolution(current, lb, ub):
        a = rng.uniform(-1, 1, dim)
        b = rng.uniform(-1, 1, dim)
        new = current + (b - a) * rng.uniform(0.5, 1.5, dim)
        return np.clip(new, lb, ub)

    T = 10
    current = (ub - lb) * rng.random(dim) + lb
    best_solution = current.copy()
    for i in range(budget):
        new_solution = differential_evolution(current, lb, ub)
        new_solution = sim_anneal_schedule(i / budget, current, new_solution, T ** (1 - i / budget))
        if func(new_solution) < func(best_solution):
            best_solution = new_solution
        current = new_solution
    return best_solution
