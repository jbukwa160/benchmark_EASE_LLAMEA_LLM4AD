def algorithm(func, dim, lb, ub, budget, rng):
    def wrapper(x):
        return func(x)

    bounds = [(lb, ub) for _ in range(dim)]
    result_de = differential_evolution(wrapper, bounds)
    best_de = np.clip(result_de.x, [lb]*dim, [ub]*dim)

    def wrapper_cmaes(x):
        return -wrapper(x)

    result_cmaes = differential_evolution_wrapper(wrapper_cmaes, bounds, x0=np.random.uniform(lb, ub, size=dim), strategy='covariance_matrix_adaptation')
    best_cmaes = np.clip(result_cmaes.x, [lb]*dim, [ub]*dim)

    if wrapper(best_de) < wrapper(best_cmaes):
        return best_de
    else:
        return best_cmaes
