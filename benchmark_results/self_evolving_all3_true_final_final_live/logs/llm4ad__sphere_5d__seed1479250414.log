def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    for _ in range(budget):
        grad = np.zeros(dim)
        for i in range(dim):
            temp = x.copy()
            temp[i] += 0.1
            gradient_i = func(temp) - func(x)
            grad[i] = (gradient_i / 0.1)
        
        step_size = min(1, budget / dim)
        new_x = x + np.sign(grad) * step_size
        
        new_x = np.clip(new_x, lb, ub)
        
        if func(new_x) < func(best_x):
            best_x = new_x.copy()
        
        x = new_x
    
    return best_x
