def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.zeros(dim)
    f_best = float('inf')

    for _ in range(budget):
        x_new = clip(rng.normal(size=(dim,)))
        f_new = func(x_new)

        if f_new < f_best:
            f_best = f_new
            x_best = x_new

    return x_best
