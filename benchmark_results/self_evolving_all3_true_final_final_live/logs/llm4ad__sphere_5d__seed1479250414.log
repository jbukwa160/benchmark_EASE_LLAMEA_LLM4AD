def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 1e2 * (ub - lb) ** 2 / np.mean(np.abs(x))
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Random walk
        dx = rng.normal(size=dim)
        new_x = x + dx

        # Clip to bounds
        new_x = np.clip(new_x, lb, ub)

        f_new = func(new_x)
        delta = f_new - best_f

        if delta < 0 or (delta >= 0 and rng.random() < np.exp(-delta / T)):
            x = new_x.copy()
            best_x = new_x.copy()
            best_f = f_new
            T *= 0.99

        # Local search
        for i in range(dim):
            dx = 0.1 * (ub - lb) * rng.choice([-1, 1])
            new_x = x.copy()
            new_x[i] += dx
            new_x = np.clip(new_x, lb, ub)
            f_new = func(new_x)

            delta = f_new - best_f

            if delta < 0 or (delta >= 0 and rng.random() < np.exp(-delta / T)):
                x = new_x.copy()
                best_x = new_x.copy()
                best_f = f_new
                T *= 0.99

    return best_x
