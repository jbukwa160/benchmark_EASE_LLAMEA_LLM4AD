def algorithm(func, dim, lb, ub, budget, rng):
    def sample(bounds):
        return [rng.uniform(lb, ub) for _ in range(dim)]

    def evaluate(x):
        return func(x)

    def acquisition(x, model, bounds, n_samples=1000):
        x_samples = np.array([sample(bounds) for _ in range(n_samples)])
        y_samples = np.zeros(n_samples)
        for i in range(n_samples):
            y_samples[i] = evaluate(x_samples[i])
        mean, var = model.predict(x, return_var=True)
        acquisition_value = (y_samples - mean).mean() + 1.96 * var**0.5
        return acquisition_value

    def update_model(model, x, f_x):
        model.partial_fit(np.array([x]), np.array([f_x]))

    bounds = [(lb, ub) for _ in range(dim)]
    best_x = sample(bounds)
    best_f_x = evaluate(best_x)

    for i in range(budget):
        model = None
        while model is None or len(model.x_) == 0:
            x = np.array(sample(bounds))
            f_x = evaluate(x)
            update_model(model, x, f_x) if model else (model := GP())

        x_new = sample(bounds)
        acquisition_value_new = acquisition(x_new, model, bounds)

        if acquisition_value_new > acquisition(best_x, model, bounds):
            best_x = x_new
            best_f_x = evaluate(best_x)

    return np.array([best_x])
