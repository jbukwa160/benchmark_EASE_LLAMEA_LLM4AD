def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    x = clip(rng.uniform(size=dim))
    population_size = 50
    learning_rate = 0.5 / (1 + np.power(budget - 1, 0.2))

    for _ in range(budget):
        y = func(clip(x))
        child = x + rng.normal(size=dim) * learning_rate

        while True:
            child = clip(child)
            if child.all() > x.all():
                break

        x = np.where(rng.uniform(size=dim) < 0.5, child, x)

    return x
