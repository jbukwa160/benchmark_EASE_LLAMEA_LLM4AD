def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(best_x)

    for _ in range(budget - 1):
        new_x = x + rng.uniform(-5.0, 5.0, size=dim)
        new_x = clip(new_x)
        new_f = func(new_x)

        if new_f < best_f:
            best_x = new_x
            best_f = new_f

        idx = np.random.choice(dim, size=1, replace=False)[0]
        x[idx] = new_x[idx]

    return best_x
