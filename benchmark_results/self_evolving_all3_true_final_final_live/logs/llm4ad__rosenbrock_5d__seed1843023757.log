def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    bounds = [(lb, ub)] * dim
    result = minimize(objective, x0=np.array([1] * dim), method="SLSQP", bounds=bounds, options={"maxiter": 10000})

    best_solution = np.clip(result.x, lb, ub)
    return best_solution
