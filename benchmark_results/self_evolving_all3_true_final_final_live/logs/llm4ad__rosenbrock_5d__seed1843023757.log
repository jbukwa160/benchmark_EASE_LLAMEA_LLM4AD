def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget - 1):
        s = rng.normal(size=dim)
        v = np.sqrt(1 / (2 * _ + 1))
        x_new = clip(best_x + v * s)
        
        f_new = func(x_new)
        if f_new < best_f:
            best_f = f_new
            best_x = x_new
            
    return best_x
