def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    pop = rng.uniform(lb, ub, (pop_size, dim))
    best = None
    for i in range(budget):
        fit = func(pop)
        idx = np.argsort(fit)[:1]
        if best is None or fit[idx] < best[1]:
            best = (fit[idx], pop[idx])
        F = 0.5 * rng.uniform(0, 1)
        C = rng.uniform(0, 1)
        for j in range(pop_size):
            target = pop[j]
            trial = np.copy(target)
            idx2 = np.random.choice(range(pop_size), size=dim-1, replace=False)
            for k in range(dim-1):
                r1 = rng.randint(pop_size)
                while r1 == j:
                    r1 = rng.randint(pop_size)
                r2 = rng.randint(pop_size)
                while r2 in idx2 or r2 == j:
                    r2 = rng.randint(pop_size)
                trial[k] = target[k] + F * (pop[idx2[k]] - target[k]) + C * (best[0][idx2[k]] - target[k])
            trial[dim-1] = target[dim-1] + F * (best[0][dim-1] - target[dim-1])
            if rng.uniform(0, 1) < 0.5:
                trial[dim-1] = np.clip(trial[dim-1], lb, ub)
            else:
                for k in range(dim):
                    trial[k] = np.clip(trial[k], lb, ub)
            fit_trial = func(trial)
            if fit_trial < best[0][j]:
                best[0][j] = fit_trial
                best[1][j] = trial
        pop = np.copy(best[1])
    return best[1]
