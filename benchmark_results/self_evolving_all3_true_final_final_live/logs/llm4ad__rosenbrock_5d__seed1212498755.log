def algorithm(func, dim, lb, ub, budget, rng):
    def gp_mean(x):
        return 0.5 * (ub - lb) + (x - (ub + lb) / 2)

    def gp_var(x):
        return 1e-8 * ((ub - lb)**2)  # small value to prevent numerical issues

    def gp_cov(x, y):
        return np.exp(-np.sum((x - y)**2))

    def gp_pred(x, X, Y):
        mean = gp_mean(x)
        var = gp_var(x)
        cov = gp_cov(x, X)
        cov_inv = np.linalg.inv(np.dot(cov.T, cov) + (1e-8 * np.eye(dim)))
        pred_mean = mean + np.dot(cov, np.dot(cov_inv, Y - gp_mean(X)))
        pred_var = var - np.dot(cov, np.dot(cov.T, pred_mean))
        return pred_mean, pred_var

    def ei(x):
        mean, var = gp_pred(x, X, Y)
        return (mean - func(x)) * norm.cdf((func(x) - mean) / sqrt(var + 1e-8))

    X = np.zeros((budget, dim))
    Y = np.zeros(budget)

    for i in range(budget):
        x_new = np.random.uniform(lb, ub, size=dim)
        if i == 0:
            X[i] = x_new
            Y[i] = func(x_new)
        else:
            pred_mean, pred_var = gp_pred(x_new, X[:i], Y[:i])
            x_next = np.argmax([ei(np.clip(x, lb, ub)) for x in (x_new + 1e-8 * np.random.randn(dim))])
            if ei(X[i-1]) > ei(np.clip(x_next, lb, ub)):
                X[i] = X[i-1]
                Y[i] = Y[i-1]
            else:
                X[i] = x_next
                Y[i] = func(np.clip(x_next, lb, ub))

    return np.argmin(Y)
