def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    sigma = 0.5 * (ub - lb)
    mean = np.full(dim, (lb + ub) / 2)
    cov = np.eye(dim) * sigma**2

    for _ in range(budget):
        x = clip(mean + rng.normal(0, sigma, size=dim))
        f_x = func(x)

        cov += 0.1 * (x - mean).reshape(-1, 1) @ (x - mean).reshape(1, -1)
        cov /= 1 + 0.1
        chol = np.linalg.cholesky(cov)

        for _ in range(4):
            z = rng.normal(size=dim)
            y = clip(mean + chol @ z)
            f_y = func(y)

            if f_y < f_x:
                mean = y
                f_x = f_y

    return mean
