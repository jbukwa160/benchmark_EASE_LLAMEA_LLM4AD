def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(-5.0, 5.0, size=dim)
    t = 1.0
    n = 0
    v = np.zeros(dim)

    while n < budget:
        y = x + 0.01 * np.random.randn(dim) + v / (1e-4 + t**2)
        y = clip(y)

        f_x = func(x)
        f_y = func(y)

        if f_y <= f_x:
            x = y
            n += 1

            delta = y - x
            v += delta * np.exp(-t) / (1e-4 + t**2)
        else:
            p = np.exp(-(f_y - f_x) / (t**2))
            if rng.uniform() < p:
                x = y
                n += 1

                delta = y - x
                v += delta * np.exp(-t) / (1e-4 + t**2)
            else:
                t *= 0.99

    return clip(x)
