    def acquisition(x, mu, sigma, n_points):
        return -norm.cdf((func(x) - mu + 1e-8) / (sigma + 1e-8))

    def next_point(mu, sigma, x_best, n_points):
        scores = [acquisition(x, mu, sigma, n_points) for x in x_candidates]
        return x_candidates[np.argmax(scores)]

    x_candidates = np.array([np.random.uniform(lb, ub, dim) for _ in range(100)])
    x_best = None
    budget_used = 0

    while budget_used < budget:
        mu, sigma = get_posterior_stats(x_candidates, func)
        
        if x_best is None or func(next_point(mu, sigma, x_best, len(x_candidates))) < func(x_best):
            x_best = next_point(mu, sigma, x_best, len(x_candidates))

        new_x = np.clip(np.random.uniform(lb, ub, dim), lb, ub)
        func(new_x)

        budget_used += 1

    return x_best
