def algorithm(func, dim, lb, ub, budget, rng):
    x_best = lb + (ub - lb) * rng.rand(dim)
    y_best = func(x_best)

    for _ in range(budget):
        # Sample new candidate using EI acquisition function
        mean, var = gp.predict(np.array([x_best]), y_best, full_cov=False)
        cov = np.sqrt(var)
        ei = (func(np.array([mean])) - y_best) * norm.cdf((func(np.array([mean])) - y_best)/cov) + cov * norm.pdf(func(np.array([mean])), mean, cov)

        # Sample new candidate
        x_new = lb + (ub - lb) * rng.rand(dim)
        ei_new = func(x_new) if np.random.rand() < ei else float('inf')

        # Update GP model and select best solution so far
        gp.update(np.array([x_best, x_new]), np.array([y_best, ei_new]))
        if ei_new < y_best:
            x_best = x_new
            y_best = ei_new

    return x_best
