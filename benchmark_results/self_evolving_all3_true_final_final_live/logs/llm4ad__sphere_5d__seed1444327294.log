def algorithm(func, dim, lb, ub, budget, rng):
    population_size = int(np.sqrt(budget))
    x = rng.uniform(lb, ub, (population_size, dim))
    for _ in range(int(budget / population_size)):
        z = rng.uniform(-1, 1, (dim,))
        y = x + 0.5 * np.dot(z[:, np.newaxis], np.expand_dims(x, axis=1))
        y = np.clip(y, lb, ub)
        y_prob = func(y) - func(x)
        mask = y_prob > 0
        x[mask] = y[mask]
    return np.min(func(np.clip(x, lb, ub)), axis=0)
