def algorithm(func, dim, lb, ub, budget, rng):
    X = np.random.uniform(lb, ub, size=(dim,))
    best_X = X.copy()
    best_f = func(X)

    for _ in range(budget - 1):
        alpha = 0.01
        if rng.rand() < 0.5:
            delta = alpha * (best_X - X)
        else:
            delta = np.zeros_like(X)
            for i in range(dim):
                if rng.rand() < 0.7:
                    delta[i] = alpha * (np.random.uniform(lb, ub) - X[i])
                else:
                    delta[i] = alpha * (best_X[i] - X[i])

        new_X = X + delta
        new_X = np.clip(new_X, lb, ub)
        
        new_f = func(new_X)

        if new_f < best_f:
            best_f = new_f
            best_X = new_X.copy()

        X = new_X

    return best_X
