def algorithm(func, dim, lb, ub, budget, rng):
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_cand = x_best + rng.randn(dim) * 0.5
        for i in range(dim):
            if x_cand[i] < lb:
                x_cand[i] = lb + (ub - lb) * rng.rand()
            elif x_cand[i] > ub:
                x_cand[i] = lb + (ub - lb) * rng.rand()

        f_cand = func(x_cand)
        if f_cand < f_best:
            x_best = x_cand
            f_best = f_cand

    return x_best
