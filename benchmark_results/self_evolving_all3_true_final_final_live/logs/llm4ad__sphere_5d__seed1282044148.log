def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def f(x):
        return func(clip(x))

    x0 = np.zeros(dim)
    sigma = 1.0
    mean = np.copy(x0)
    cov = np.eye(dim) * 1e-4

    for _ in range(budget):
        samples, _ = np.random.multivariate_normal(mean, cov * (sigma**2), 10, rng=rng)
        f_values = [f(sample) for sample in samples]

        best_idx = np.argmin(f_values)
        sigma *= np.exp(1/5 + np.sqrt(-np.log(np.random.rand())))

        if _ % 100 == 0:
            mean += (samples[best_idx] - mean) * 0.01
            cov = (1 - 0.01) * cov + 0.01 * (np.outer(samples[best_idx] - mean, samples[best_idx] - mean))

    return np.copy(mean)
