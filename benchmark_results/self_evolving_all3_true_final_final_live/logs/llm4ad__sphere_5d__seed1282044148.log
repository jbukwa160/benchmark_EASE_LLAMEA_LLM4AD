def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = best_x + (ub - lb) * rng.uniform(size=dim)
        x = np.clip(x, lb, ub)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
    
    return best_x
