def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    N = 1000  # population size
    F = 1.5  # adaptive mutation factor
    CR = 0.9  # crossover probability
    x_best = -np.inf

    pop = rng.uniform(lb, ub, (N, dim))
    for _ in range(budget):
        f_pop = func(pop)
        idx = np.argmin(f_pop)

        if f_pop[idx] < x_best:
            x_best = f_pop[idx]
            best_x = clip(pop[idx], lb, ub)

        for i in range(N):
            r1, r2, r3 = rng.choice(N, 3, replace=False)
            u = pop[r1, :]
            v = pop[r2, :]
            w = pop[r3, :]

            if rng.rand() < CR or np.all(pop[i, :] == u):
                m = F * (v - u) + w
                m = clip(m, lb, ub)
                pop[i, :] = m

    return best_x
