def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_y = func(x)
    
    while budget > 0:
        candidate = clip(best_x + (ub - lb) * rng.randn(dim))
        
        y = func(candidate)
        
        if y < best_y:
            best_x = candidate
            best_y = y
        
        budget -= 1
    
    return best_x
