def algorithm(func, dim, lb, ub, budget, rng):
    def rastrigin(x):
        return func(x)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = rastrigin(best_x)

    current_f = rastrigin(x)
    for _ in range(budget - 1):
        # Simulated Annealing
        T = 1000.0  # initial temperature
        alpha = 0.9  # cooling rate

        for _ in range(int(budget / 2)):
            # Differential Evolution
            v = x + rng.uniform(-1, 1, size=dim) * (ub - lb)
            v[v < lb] = lb
            v[v > ub] = ub

            f_v = rastrigin(v)

            if f_v < current_f:
                x = v.copy()
                current_f = f_v
            elif rng.random() < np.exp((current_f - f_v) / T):
                x = v.copy()
                current_f = f_v

            # Simulated Annealing cooling schedule
            T *= alpha

        if current_f < best_f:
            best_x = x.copy()
            best_f = current_f

    return best_x
