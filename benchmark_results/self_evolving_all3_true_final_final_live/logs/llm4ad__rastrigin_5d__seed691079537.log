def algorithm(func, dim, lb, ub, budget, rng):
    def clipped_candidate(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def rastrigin(x):
        return 10*dim + np.sum((x**2) - 10*np.cos(2*np.pi*x))

    x = rng.uniform(lb, ub, size=dim)
    best_x = clipped_candidate(x.copy(), lb, ub)
    best_score = func(best_x)

    for _ in range(budget):
        for i in range(dim):
            candidate1 = clipped_candidate(x.copy() + 0.5*rng.uniform(-1, 1, size=dim), lb, ub)
            candidate2 = clipped_candidate(x.copy() - 0.5*rng.uniform(-1, 1, size=dim), lb, ub)

            score1 = rastrigin(candidate1)
            score2 = rastrigin(candidate2)

            if score1 < best_score:
                x[i] = candidate1
                best_x = clipped_candidate(x.copy(), lb, ub)
                best_score = func(best_x)
            elif score2 < best_score:
                x[i] = candidate2
                best_x = clipped_candidate(x.copy(), lb, ub)
                best_score = func(best_x)

    return best_x
