def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def sample_gaussian(mean, cov, rng=rng):
        noise = np.zeros(dim)
        for i in range(dim):
            noise[i] = rng.normal(0, 1)
        candidate = mean + np.sqrt(cov) * noise
        return clip(candidate)

    best_solution = None
    best_fitness = float('inf')
    budget_counter = 0

    while budget_counter < budget:
        mean = np.zeros(dim)
        cov = np.eye(dim)
        pop_size = int(budget / (budget // 20))
        population = [sample_gaussian(mean, cov, rng=rng) for _ in range(pop_size)]

        for candidate in population:
            fitness = func(candidate)
            if fitness < best_fitness:
                best_solution = candidate
                best_fitness = fitness

        for _ in range(int(budget * 0.2)):
            mean += np.mean(np.array([candidate - best_solution for candidate in population]), axis=0)
            cov += 1 / (len(population) - 1) * np.dot((np.array([candidate - best_solution for candidate in population])[:, None], 
                                                        np.array([candidate - best_solution for candidate in population])[:, None]).transpose() - np.eye(dim), np.ones((dim, dim)))
            pop_size = int(budget / (budget // 20))
            population = [sample_gaussian(mean, cov, rng=rng) for _ in range(pop_size)]

        for candidate in population:
            fitness = func(candidate)
            if fitness < best_fitness:
                best_solution = candidate
                best_fitness = fitness

        budget_counter += pop_size

    return np.array(best_solution)
