def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    std_dev = 1.0
    for _ in range(budget):
        x_candidate = x_best + np.random.normal(0, std_dev, size=dim)
        x_candidate = np.clip(x_candidate, lb, ub)
        f_candidate = func(x_candidate)
        if f_candidate < func(x_best):
            x_best = x_candidate
        if rng.uniform(0, 1) < 0.01:
            std_dev *= 1 + rng.normal(0, 0.5)
    return x_best
