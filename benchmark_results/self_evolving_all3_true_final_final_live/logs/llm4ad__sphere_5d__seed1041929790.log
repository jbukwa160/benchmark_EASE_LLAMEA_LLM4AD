def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x_best = np.zeros(dim)
    f_best = float('inf')

    for _ in range(budget):
        x_curr = clip(x_best + (ub - lb) * rng.uniform(-1.0, 1.0, size=dim))
        f_curr = func(x_curr)

        if f_curr < f_best:
            x_best = x_curr
            f_best = f_curr

    return x_best
