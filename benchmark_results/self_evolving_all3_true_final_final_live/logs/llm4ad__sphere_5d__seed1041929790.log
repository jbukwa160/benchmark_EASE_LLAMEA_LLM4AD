def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_candidate = -np.inf * np.ones(dim)
    best_fitness = float('inf')
    for i in range(budget):
        candidate = clip(rng.normal(size=dim))
        fitness = func(candidate)
        if fitness < best_fitness:
            best_candidate = candidate
            best_fitness = fitness

        # Gaussian perturbation around the current best candidate
        sigma = 1 / (i + 2) ** 0.5
        perturbed_candidate = clip(best_candidate + rng.normal(loc=best_candidate, scale=sigma))
        perturbed_fitness = func(perturbed_candidate)
        if perturbed_fitness < best_fitness:
            best_candidate = perturbed_candidate
            best_fitness = perturbed_fitness

    return best_candidate
