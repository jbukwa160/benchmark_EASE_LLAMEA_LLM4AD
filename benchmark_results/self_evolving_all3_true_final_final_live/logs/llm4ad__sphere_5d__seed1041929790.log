def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(current, sigma):
        candidate = current + np.random.normal(size=dim, loc=0.0, scale=sigma)
        return clip(candidate)

    def evaluate(x):
        return func(x)

    current_solution = rng.uniform(lb, ub, size=dim)
    current_value = evaluate(current_solution)
    best_solution = current_solution.copy()
    best_value = current_value

    temperature = 1.0
    sigma = 5.0

    for _ in range(budget):
        candidate_solution = generate_candidate(current_solution, sigma)
        candidate_value = evaluate(candidate_solution)

        if candidate_value < best_value:
            best_solution = candidate_solution.copy()
            best_value = candidate_value

        delta = candidate_value - current_value
        probability = np.exp(-delta / temperature) if delta > 0 else 1.0

        if rng.random() < probability:
            current_solution = candidate_solution
            current_value = candidate_value
        else:
            sigma *= 0.99  # Simulated Annealing cooling schedule
            temperature *= 0.9999

    return best_solution
