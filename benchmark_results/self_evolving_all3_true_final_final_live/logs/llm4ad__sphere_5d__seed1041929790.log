def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        t = 1 / (i + 1)  # adaptive temperature schedule
        step_size = rng.uniform(0.01, 0.05)  # random step size

        new_x = clip(best_x + rng.normal(size=dim) * step_size)
        new_f = func(new_x)

        if new_f < best_f:
            best_x = new_x
            best_f = new_f

        for _ in range(dim):
            j = np.random.randint(0, dim)
            new_x[j] += rng.uniform(-step_size, step_size)
            new_x = clip(new_x)
            new_f = func(new_x)

            if new_f < best_f:
                best_x = new_x
                best_f = new_f

    return best_x
