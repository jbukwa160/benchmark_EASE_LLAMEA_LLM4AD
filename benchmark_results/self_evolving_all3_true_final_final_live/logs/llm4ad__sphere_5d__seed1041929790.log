def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    pop_best = [np.random.uniform(lb, ub, dim) for _ in range(pop_size)]
    
    for i in range(budget):
        new_pop = []
        for j in range(pop_size // 2):
            parent1 = np.clip(np.mean([pop_best[j], pop_best[pop_size - j - 1]], axis=0), lb, ub)
            new_pop.append(parent1 + rng.uniform(-ub, ub, dim))
            new_pop.append(pop_best[j] + rng.uniform(-ub, ub, dim))
        
        for cand in new_pop:
            if func(cand) < func(pop_best[0]):
                pop_best = [cand]
            elif func(cand) == func(pop_best[0]):
                pop_best.append(cand)
        
        pop_size += 1
        pop_best = np.clip(pop_best, lb, ub)
    
    return np.array(min(pop_best, key=func))
