def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    def sample_from_trunc_normal(mean, std, lower_bound, upper_bound, rng):
        while True:
            sample = mean + rng.normal(0, 1) * std
            if lower_bound <= sample <= upper_bound:
                break
        return sample

    def generate_initial_population(size, dim, lb, ub, rng):
        population = np.zeros((size, dim))
        for i in range(size):
            for j in range(dim):
                population[i, j] = sample_from_trunc_normal(0, 1, lb, ub, rng)
        return population

    def generate_next_generation(parents, budget, func, lb, ub, rng):
        children = np.zeros((budget, dim))
        for i in range(budget):
            parent = rng.choice(parents, size=5, replace=False)
            mean = np.mean(parent, axis=0)
            std = 1 / np.sqrt(np.sum(1 / (parent[:, None] - mean[None, :])**2, axis=0) + 1e-8)
            child = sample_from_trunc_normal(mean, std, lb, ub, rng)
            children[i] = clip_candidate(child)
        return children

    def cma_es(func, dim, lb, ub, budget, population_size=10):
        rng = np.random.default_rng(rng)

        # Initial population
        population = generate_initial_population(population_size, dim, lb, ub, rng)

        for _ in range(budget // population_size):
            # Evaluate the current generation
            scores = [func(c) for c in population]
            parents = population[np.argsort(scores)]

            # Generate next generation
            children = generate_next_generation(parents, population_size, func, lb, ub, rng)
            population = np.concatenate((population, children))

        # Final evaluation and return best candidate
        scores = [func(c) for c in population]
        best_idx = np.argmin(scores)
        return clip_candidate(population[best_idx])

    return cma_es(func, dim, lb, ub, budget)
