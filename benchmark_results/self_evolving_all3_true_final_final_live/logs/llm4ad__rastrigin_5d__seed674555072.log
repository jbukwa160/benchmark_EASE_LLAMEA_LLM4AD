def algorithm(func, dim, lb, ub, budget, rng):
    def obj(x):
        return func(np.clip(x, lb, ub))

    x = np.zeros(dim)
    cov = 1e-6 * np.eye(dim)
    lambda_ = min(int(budget ** (2 / (dim + 3))), int(budget ** (4 / (5 * dim))))
    mu = lambda_ // 2

    for _ in range(budget):
        x_new = x + np.random.multivariate_normal(np.zeros(dim), cov)
        f_new = obj(x_new)

        if rng.rand() < 1 / (lambda_ + 1) and f_new < obj(x):
            x, cov = x_new, 0.5 * (1 - 1 / (lambda_ + 1)) * cov

        for _ in range(lambda_):
            y = np.random.multivariate_normal(np.zeros(dim), cov)
            f_y = obj(x + y)

            if f_y < f_new:
                x_new = x + y
                f_new = f_y

        dist = np.linalg.norm(x - x_new) / (np.sqrt(np.diag(cov)) * (1 + 0.5 * rng.rand()))
        cov *= 1 - dist ** 2

    return x
