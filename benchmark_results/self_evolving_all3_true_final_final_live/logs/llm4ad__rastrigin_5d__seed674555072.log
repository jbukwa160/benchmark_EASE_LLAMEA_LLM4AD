def algorithm(func, dim, lb, ub, budget, rng):
    def bounds(x):
        return [np.clip(xi, lb, ub) for xi in x]

    def crossover(parent1, parent2):
        child = [(parent1[i] + parent2[i]) / 2.0 for i in range(dim)]
        return bounds(child)

    def mutate(child):
        mutated_child = []
        for i in range(dim):
            if rng.random() < 0.01:
                mutant = child[i] + rng.uniform(-1, 1)
                mutated_child.append(np.clip(mutant, lb, ub))
            else:
                mutated_child.append(child[i])
        return bounds(mutated_child)

    def evaluate(x):
        return func(x) + np.sum([np.sin(10 * xi) for xi in x])

    def simulated_annealing(init_x, T0, alpha, budget):
        current_x = init_x
        current_f = evaluate(current_x)
        temperature = T0
        for _ in range(budget):
            new_x = [current_x[i] + rng.uniform(-1, 1) * (ub - lb) for i in range(dim)]
            new_x = bounds(new_x)
            new_f = evaluate(new_x)
            delta_f = new_f - current_f
            if delta_f < 0:
                current_x = new_x
                current_f = new_f
            else:
                prob = np.exp(-delta_f / temperature)
                if rng.random() < prob:
                    current_x = new_x
                    current_f = new_f
            temperature *= alpha
        return current_x

    def particle_swarm(x, budget):
        pos = [x]
        vel = [[0.0 for _ in range(dim)] for _ in range(budget)]
        pbest = x
        gbest = x
        best_f = evaluate(gbest)
        for i in range(1, budget):
            for j in range(dim):
                vel[i][j] = 2 * rng.uniform(0, 1) - 1
            new_x = [pos[i-1][k] + vel[i][k] for k in range(dim)]
            new_x = bounds(new_x)
            new_f = evaluate(new_x)
            if new_f < best_f:
                pbest = new_x
                best_f = new_f
            if new_f < evaluate(gbest):
                gbest = new_x
            pos.append(pbest)
        return gbest

    num_particles = 10
    init_x = [rng.uniform(lb, ub) for _ in range(dim)]
    T0 = 100.0
    alpha = 0.99
    budget_sa = int(budget * 0.5)

    x = simulated_annealing(init_x, T0, alpha, budget_sa)
    particles = [particle_swarm(x, int(budget / num_particles)) for _ in range(num_particles)]
    best_x = min(particles, key=evaluate)
    mutated_child = mutate(best_x)
    return mutated_child
