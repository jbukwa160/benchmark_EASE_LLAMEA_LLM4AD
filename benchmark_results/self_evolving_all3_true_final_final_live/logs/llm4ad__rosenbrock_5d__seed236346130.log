def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    population_size = 20
    mean = np.zeros(dim)
    sigma = 0.1
    cov = np.eye(dim)

    for _ in range(budget):
        offspring_population = np.clip(mean + sigma * np.dot(np.linalg.cholesky(cov), rng.randn(population_size, dim)), lb, ub)
        fitness_values = func(offspring_population)
        idx = np.argsort(fitness_values)[:population_size]
        new_mean = np.mean(offspring_population[idx], axis=0)
        cov = 0.5 * (cov + np.dot(np.transpose(cov), cov)) + 0.3 * np.outer(new_mean - mean, new_mean - mean)

        if _ % 10 == 0:
            print(f"Current best fitness: {func(x)}")

        x = new_mean

    return x
