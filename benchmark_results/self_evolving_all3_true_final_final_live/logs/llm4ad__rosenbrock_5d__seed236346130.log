def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.sqrt(budget))
    x_init = (ub - lb) * rng.rand(pop_size, dim) + lb
    best_x = x_init[np.argmin([func(x) for x in x_init])]
    
    while budget > 0:
        offspring = np.zeros((pop_size, dim))
        
        for i in range(pop_size):
            idx1, idx2 = rng.randint(0, pop_size, size=2)
            
            if func(best_x) < func(offspring[idx1]):
                offspring[i] = best_x
            elif func(x_init[idx1]) < func(offspring[i]):
                offspring[i] = x_init[idx1]
            else:
                step = (offspring[i] - x_init[idx2]) / np.linalg.norm(offspring[i] - x_init[idx2])
                offspring[i] = x_init[idx2] + 0.01 * step
                
        offspring = np.clip(offspring, lb, ub)
        
        best_offspring_idx = np.argmin([func(x) for x in offspring])
        if func(offspring[best_offspring_idx]) < func(best_x):
            best_x = offspring[best_offspring_idx]
            
        x_init = offspring
        budget -= 1
        
    return best_x
