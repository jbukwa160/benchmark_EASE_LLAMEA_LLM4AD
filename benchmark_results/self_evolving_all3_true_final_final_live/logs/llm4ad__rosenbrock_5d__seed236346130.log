def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    num_offspring = 100
    mean, std_dev = 0.5, 1.0
    
    # Initialize population and scores
    X = np.random.uniform(lb, ub, (pop_size, dim))
    Y = np.full(pop_size, budget)
    
    for _ in range(budget):
        # Select parents using tournament selection with replacement
        parents_idx = rng.choice(np.arange(pop_size), size=num_offspring, replace=True, p=Y/Y.sum())
        
        # Evaluate function and update scores
        X_parents = X[parents_idx]
        Y_new = func(X_parents)
        Y_update = (Y + Y_new) / 2
        
        # Update population
        X[:] = np.concatenate((X_parents, X_parents))
        Y[:] = Y_update
        
        # Sample new points using CMA-ES
        mean_cma, std_dev_cma = CMA_ES(X, Y)
        
        # Evaluate function and update scores
        X_new = np.random.normal(mean_cma, std_dev_cma, (pop_size, dim))
        Y_new = func(X_new)
        mask = (X_new >= lb) & (X_new <= ub)
        idx = np.where(mask.any(axis=1))[0]
        
        # Update population and scores
        X[idx] = X_new[idx]
        Y[idx] = Y_new
        
    # Select best solution
    idx_best = np.argmin(Y)
    return X[idx_best]
