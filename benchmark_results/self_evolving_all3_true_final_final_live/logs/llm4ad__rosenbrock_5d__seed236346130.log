def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, (dim,))
    step_size = 1.0
    for _ in range(budget):
        y = x + np.random.normal(0, step_size, (dim,))
        y = clip(y)
        if func(y) < func(x):
            x = y
        else:
            step_size *= 0.9
            z = x + rng.uniform(-1, 1, (dim,)) * step_size
            z = clip(z)
            if func(z) < func(x):
                x = z
    return x
