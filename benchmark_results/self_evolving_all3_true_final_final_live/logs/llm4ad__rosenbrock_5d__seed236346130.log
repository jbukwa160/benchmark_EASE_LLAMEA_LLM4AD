def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidates):
        return np.clip(candidates, lb, ub)

    def simulated_annealing(x0, T, func, dim, lb, ub):
        x = clip(x0)
        for i in range(budget):
            new_x = x + 0.1 * (ub - lb) * rng.standard_normal(dim)
            new_x = clip(new_x)
            delta = func(new_x) - func(x)
            if delta < 0:
                x = new_x
            else:
                T *= 0.99
                if np.random.rand() < np.exp(-delta / T):
                    x = new_x
        return x

    best_x = None
    best_f = float('inf')
    for _ in range(budget // dim):
        x = simulated_annealing(rng.uniform(lb, ub, size=dim), 1000, func, dim, lb, ub)
        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x

    return np.array(best_x)
