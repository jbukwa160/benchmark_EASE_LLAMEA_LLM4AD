def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lower, upper):
        return np.clip(x, lower, upper)

    def simulate_annealing(pop_size=50, T_initial=1e6, cooling_rate=0.99, iterations=10000):
        x = rng.uniform(lb, ub, size=(pop_size, dim))
        T = T_initial
        for i in range(iterations):
            new_x = rng.normal(size=(pop_size, dim), loc=x, scale=T)
            new_x = clip(new_x, lb, ub)
            energy_new = func(new_x)
            energy_old = func(x)
            accept_prob = np.exp(-(energy_new - energy_old) / T)
            mask = rng.uniform(0, 1, size=pop_size) < accept_prob
            x[mask] = new_x[mask]
            x[~mask] = clip(x[~mask], lb, ub)
            T *= cooling_rate
        return np.min(func(x))

    def cma_es(pop_size=50, mu=0.5, sigma_initial=1e-3, iterations=10000):
        x_mean = rng.uniform(lb, ub, size=(pop_size, dim))
        x_dev = rng.normal(size=(pop_size, dim), loc=0, scale=sigma_initial)
        for i in range(iterations):
            y = np.copy(x_mean + x_dev)
            y = clip(y, lb, ub)
            energy_y = func(y)
            energy_x = func(x_mean)
            if energy_y < energy_x:
                x_mean = y
                x_dev = rng.normal(size=(pop_size, dim), loc=0, scale=sigma_initial)
            else:
                sigma_new = np.sqrt(np.mean((y - x_mean) ** 2))
                mask = rng.uniform(0, 1, size=pop_size) < 0.5
                x_dev[mask] += (y[mask] - x_mean[mask]) * mu + rng.normal(size=(np.sum(mask), dim), loc=0, scale=sigma_new)
        return np.min(func(x_mean))

    def cma_es_mixture(pop_size=50, mu=0.5, sigma_initial=1e-3, iterations=10000):
        x_mean = rng.uniform(lb, ub, size=(pop_size, dim))
        x_dev = rng.normal(size=(pop_size, dim), loc=0, scale=sigma_initial)
        for i in range(iterations):
            y = np.copy(x_mean + x_dev)
            y = clip(y, lb, ub)
            energy_y = func(y)
            energy_x = func(x_mean)
            if energy_y < energy_x:
                x_mean = y
                x_dev = rng.normal(size=(pop_size, dim), loc=0, scale=sigma_initial)
            else:
                sigma_new = np.sqrt(np.mean((y - x_mean) ** 2))
                mask = rng.uniform(0, 1, size=pop_size) < 0.5
                x_dev[mask] += (y[mask] - x_mean[mask]) * mu + rng.normal(size=(np.sum(mask), dim), loc=0, scale=sigma_new)
            if i % (iterations // 100) == 0:
                y = np.copy(x_mean + rng.uniform(0, 1e-3, size=(pop_size, dim)) * x_dev)
                y = clip(y, lb, ub)
                energy_y = func(y)
                energy_x = func(x_mean)
                if energy_y < energy_x:
                    x_mean = y
                    x_dev = rng.normal(size=(pop_size, dim), loc=0, scale=sigma_initial)
        return np.min(func(x_mean))

    def hybrid(pop_size=50, mu=0.5, sigma_initial=1e-3, iterations=10000):
        best_x = None
        for i in range(iterations):
            x = rng.uniform(lb, ub, size=(pop_size, dim))
            y = np.copy(x + rng.normal(size=(pop_size, dim), loc=0, scale=sigma_initial))
            y = clip(y, lb, ub)
            energy_y = func(y)
            energy_x = func(x)
            mask = energy_y < energy_x
            x[mask] = y[mask]
            if best_x is None or np.min(func(x)) < np.min(func(best_x)):
                best_x = x
        return best_x

    results = []
    for _ in range(budget):
        try:
            result1 = simulate_annealing()
            results.append(result1)
        except Exception as e:
            print(f"Error: {e}")
        try:
            result2 = cma_es()
            results.append(result2)
        except Exception as e:
            print(f"Error: {e}")
        try:
            result3 = cma_es_mixture()
            results.append(result3)
        except Exception as e:
            print(f"Error: {e}")
        try:
            result4 = hybrid()
            results.append(result4)
        except Exception as e:
            print(f"Error: {e}")

    return np.min(results, axis=0)
