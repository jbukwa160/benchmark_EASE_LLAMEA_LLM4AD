def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    mu = 0.5
    sigma = 1.0
    best_x = np.zeros(dim)
    best_fval = np.inf

    for _ in range(budget):
        # Initialize population within bounds
        x = (ub - lb) * rng.rand(pop_size, dim) + lb

        # Evaluate fitness of each candidate
        fvals = func(x)

        # Update best solution found so far
        idx = np.argmin(fvals)
        if fvals[idx] < best_fval:
            best_x = x[idx]
            best_fval = fvals[idx]

        # Differential evolution step
        y = (1 + mu * rng.randn(pop_size, dim)) * best_x[:, None] + \
            sigma * rng.randn(pop_size, dim) * (x - np.mean(x, axis=0))[None, :]
        y = np.clip(y, lb, ub)
        fvals = func(y)

        # Update best solution found so far
        idx = np.argmin(fvals)
        if fvals[idx] < best_fval:
            best_x = y[idx]
            best_fval = fvals[idx]

    return best_x
