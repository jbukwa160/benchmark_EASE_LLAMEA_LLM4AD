def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def func_eval(x):
        x = clip(x)
        return func(x)

    current_best = np.zeros(dim)
    current_best_value = 0
    for i in range(budget):
        sigma = 2.1 / (i + 1) ** 0.5
        mean = rng.normal(size=dim, loc=0, scale=sigma)
        candidates = clip(mean + rng.normal(size=(10000, dim), loc=mean, scale=sigma))
        candidate_values = func_eval(candidates)

        best_candidate_index = np.argmin(candidate_values)
        best_candidate = candidates[best_candidate_index]

        if candidate_values[best_candidate_index] < current_best_value:
            current_best = best_candidate
            current_best_value = candidate_values[best_candidate_index]

    return current_best
