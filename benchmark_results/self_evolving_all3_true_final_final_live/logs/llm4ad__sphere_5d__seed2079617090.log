def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    for _ in range(budget):
        v1 = rng.normal(size=dim)
        v2 = rng.normal(size=dim)
        v3 = rng.normal(size=dim)
        trial = clip(x_best + 0.5 * (v1 - x_best) + 0.5 * (v2 - x_best))

        f_trial = func(trial)

        if f_trial < f_best:
            x_best = trial
            f_best = f_trial

    return x_best
