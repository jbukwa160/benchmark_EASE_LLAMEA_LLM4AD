def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    def clip(x):
        return np.clip(x, lb, ub)

    x0 = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    sigma = 1.0
    mu = 1 / dim
    c1 = 1 + 2 * (mu ** 2)
    c2 = 4 / (dim + 1.0)
    d = np.zeros((dim,))
    D = np.eye(dim) * (sigma ** 2)

    for _ in range(budget):
        y = clip(x0 + rng.normal(0, sigma, size=(1, dim)))
        f_val = f(y)
        
        # Update covariance matrix
        if not np.isfinite(f_val):
            D *= 0.9
        else:
            d = (y - x0) / sigma
            D += c1 * d @ d.T - c2 * D

        # Update step size
        sigma *= np.exp(rng.normal(0, 0.05))

        # Update position
        x0 = clip(x0 + rng.normal(0, sigma, size=(1, dim)))

    return x0
