def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    sigma = 0.1
    tau = 10
    chi = 1.49618
    c1 = 2 / (dim + 1.4)
    c2 = 2 / (dim + 1.4)

    x = np.random.uniform(lb, ub, [pop_size, dim])

    for t in range(budget):
        if rng.rand() < 0.5:
            sigma *= 1 - 1e-6
        else:
            sigma /= 1 - 1e-6

        fvals = func(x)
        y = x.copy()

        for i in range(pop_size):
            z = x[i] + sigma * rng.normal(size=dim)

            # Clip candidates to [lb, ub]
            z = np.clip(z, lb, ub)

            j = np.random.choice([k for k in range(pop_size) if k != i])

            u = c1 * rng.uniform(-1, 1)
            v = c2 * rng.uniform(-1, 1)

            y[i] += (u + v) * z[j]

        fvals_y = func(y)
        idx = np.argsort(fvals)[::-1][:pop_size//2]
        x[idx] = y[idx]

    best_idx = np.argmin(func(x))
    return x[best_idx]
