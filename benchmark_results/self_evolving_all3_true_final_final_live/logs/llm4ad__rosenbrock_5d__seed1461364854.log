def algorithm(func, dim, lb, ub, budget, rng):
    def fitness(x):
        return func(x)

    x = np.zeros(dim)
    for i in range(dim):
        x[i] = (ub - lb) * rng.rand() + lb

    best_x = x.copy()
    best_fitness = float('inf')

    n_evals = 0
    adaptive_restart = True
    while n_evals < budget:
        if not adaptive_restart:
            step_size = 1e-3
            for i in range(dim):
                x[i] += (ub - lb) * rng.uniform(-1, 1)
                n_evals += 1
                f_x = fitness(x)
                if f_x < best_fitness:
                    best_fitness = f_x
                    best_x = x.copy()
                else:
                    x[i] -= step_size

        # Adaptive restart
        x_try = best_x + (ub - lb) * rng.randn(dim)
        n_evals += 1
        f_x_try = fitness(x_try)

        if f_x_try < best_fitness:
            adaptive_restart = True
            best_fitness = f_x_try
            best_x = x_try.copy()

    return best_x
