def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget - 1):
        x_candidate = x_best + np.random.normal(scale=0.5, size=dim) * (ub - lb)
        clip_x = np.clip(x_candidate, lb, ub)
        fx_candidate = func(clip_x)

        if f_candidate < f_best:
            x_best = clip_x
            f_best = fx_candidate

        # local refinement
        step_size = 0.1
        for i in range(dim):
            x_candidate = x_best.copy()
            x_candidate[i] += np.sign(x_candidate[i]) * step_size * (ub - lb)
            clip_x = np.clip(x_candidate, lb, ub)
            fx_candidate = func(clip_x)

            if fx_candidate < f_best:
                x_best = clip_x
                f_best = fx_candidate

    return x_best
