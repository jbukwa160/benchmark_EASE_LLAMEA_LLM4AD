def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = clip(rng.uniform(lb, ub, size=dim))
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        x_prime = clip(best_x + 0.1 * rng.normal(size=dim))
        f_prime = func(x_prime)
        
        if f_prime < best_f:
            best_f = f_prime
            best_x = x_prime

    return best_x
