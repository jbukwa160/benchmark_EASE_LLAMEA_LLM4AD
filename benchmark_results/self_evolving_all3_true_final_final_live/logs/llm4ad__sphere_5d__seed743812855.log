def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.sqrt(budget))
    population = rng.uniform(lb, ub, (pop_size, dim))

    for _ in range(1, budget + 1):
        # Evaluate the fitness of each candidate and store it as a dictionary
        fits = {i: func(x) for i, x in enumerate(population)}

        # Select parents based on their fitness values using tournament selection
        parents = []
        while len(parents) < pop_size:
            idx1, idx2 = rng.randint(0, pop_size, 2)
            if fits[idx1] <= fits[idx2]:
                parents.append(population[idx1])
            else:
                parents.append(population[idx2])

        # Adapt the distribution of candidates to favor better solutions
        population = np.vstack((parents, rng.normal(size=(pop_size, dim))))

        # Clip candidates to the bounds
        population = np.clip(population, lb, ub)

    # Return the best candidate found so far
    return min(population, key=func)
