def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    x0 = np.random.uniform(lb, ub, size=n)
    mu = 1.0 / n
    c1 = 2.38 / (n + 1.3)
    c2 = 2.05 / (n ** 0.5 + 1.1)
    sigma = 0.5
    lambda_ = int(n * np.log(n))
    x_best = x0.copy()
    f_best = func(x0)
    
    for _ in range(budget):
        z = rng.normal(size=lambda_)
        y = c1 * mu * z + (1 - c1) * sigma * np.random.uniform(-1, 1, size=lambda_)
        
        for i in range(lambda_):
            x_trial = x_best.copy()
            idx = np.arange(n)
            np.random.shuffle(idx)
            
            for j in idx:
                x_trial[j] += y[i]
                if lb <= x_trial[j] <= ub:
                    f_trial = func(x_trial)
                    if f_trial < f_best:
                        f_best = f_trial
                        x_best = x_trial.copy()
        
        sigma *= np.exp(min(1, budget / (n * _)) ** 0.5 - 2)
    
    return x_best
