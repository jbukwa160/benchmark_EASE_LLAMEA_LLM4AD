def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    for i in range(budget):
        # Initial population generation
        x_pop = rng.uniform(lb, ub, size=(int(1e4), dim))
        
        # DE selection and mutation
        f_pop = func(x_pop)
        idx_best = np.argmax(f_pop)
        x_best_DE = x_pop[idx_best]
        for _ in range(int(budget * 0.9)):
            v_mutation = rng.uniform(lb, ub, size=dim) + rng.uniform(-1, 1, size=dim)
            x_new = (x_best_DE + v_mutation) / 2
            f_new = func(x_new)
            if f_new < f_pop[idx_best]:
                idx_best = np.argmax([f_pop[j] for j in range(int(1e4)) if rng.uniform(0, 1) < 0.5])
                x_best_DE = (x_pop[idx_best] + x_new) / 2
        # SA annealing and selection
        f_SA = func(x_best_DE)
        alpha = 0.99
        beta = 10
        for _ in range(int(budget * 0.01)):
            step_size = np.exp(-beta * i / budget)
            x_new = x_best_DE + rng.normal(0, step_size, size=dim) * (ub - lb)
            f_new = func(x_new)
            if f_new < f_SA:
                f_SA = f_new
                x_best_DE = x_new
        # Update best solution
        if f_SA < func(x_best):
            x_best = x_new
    return np.clip(x_best, lb, ub)
