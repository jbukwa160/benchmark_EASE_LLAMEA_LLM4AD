def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 1000
    strategy = 'rand1exp'
    crossover_prob = 0.9
    mutation_prob = 0.1
    sigma_range = (0.01, 0.1)
    
    best_x = np.zeros(dim)
    best_y = float('inf')
    
    for _ in range(budget):
        # Initialisation
        x = rng.uniform(lb, ub, size=(pop_size, dim))
        
        # Differential Evolution
        for _ in range(pop_size):
            y = func(x[_])
            if y < best_y:
                best_y = y
                best_x = x[_]
            
            # Crossover and mutation
            idx1, idx2, idx3 = rng.choice(pop_size, size=3, replace=False)
            trial_x = np.copy(x[idx1])
            for i in range(dim):
                if rng.random() < crossover_prob:
                    trial_x[i] += (x[idx2][i] - x[idx3][i]) * 0.5
                if rng.random() < mutation_prob:
                    trial_x[i] += rng.uniform(*sigma_range) * (ub - lb)
                
            # Clip candidates to bounds
            trial_x = np.clip(trial_x, lb, ub)
            
            # Function evaluation and update
            y_trial = func(trial_x)
            if y_trial < best_y:
                best_y = y_trial
                best_x = trial_x
                
    return best_x
