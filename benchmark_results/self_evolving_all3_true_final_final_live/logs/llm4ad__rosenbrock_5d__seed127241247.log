def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x)

    current_best = np.array([ub] * dim)
    current_best_fitness = float('inf')
    iteration_budget = 0

    while iteration_budget < budget:
        new_population = np.random.uniform(lb, ub, (dim + 1, dim))
        new_population[0] = clip(current_best)

        for i in range(1, dim + 1):
            random_index = rng.choice(dim, replace=False)
            parent_1 = new_population[i - 1]
            parent_2 = new_population[rng.randint(i)]
            child = np.copy(parent_1)
            child[random_index] = parent_2[random_index] + 0.5 * (parent_1[random_index] - parent_2[random_index])

            if rng.random() < 0.5:
                child = clip(child)
                new_population[i] = child
            else:
                child = np.copy(parent_1)
                child[random_index] = parent_2[random_index] - 0.5 * (parent_1[random_index] - parent_2[random_index])
                child = clip(child)
                new_population[i] = child

        for i in range(dim + 1):
            candidate = evaluate(new_population[i])
            iteration_budget += 1
            if candidate < current_best_fitness:
                current_best = new_population[i]
                current_best_fitness = candidate

        if rng.random() < 0.2 and iteration_budget > budget / 5:
            current_best = np.array([ub] * dim)
            current_best_fitness = float('inf')

    return clip(current_best)
