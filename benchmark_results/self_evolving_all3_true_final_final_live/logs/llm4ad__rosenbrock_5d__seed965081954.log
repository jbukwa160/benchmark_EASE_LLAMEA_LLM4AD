def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = np.copy(x)
    min_val = func(x)

    for i in range(budget):
        new_x = np.clip(x + 0.1 * (ub - lb) * rng.normal(size=dim), lb, ub)
        
        # Exploration-exploitation trade-off
        if rng.random() < 0.1:
            new_x += 0.01 * (ub - lb) * rng.uniform(low=-1, high=1, size=dim)

        new_val = func(new_x)
        if new_val < min_val:
            x = np.copy(new_x)
            best_x = np.copy(x)
            min_val = new_val

    return best_x
