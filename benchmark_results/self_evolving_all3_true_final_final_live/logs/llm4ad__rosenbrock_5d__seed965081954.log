def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    ngen = budget // D + 1
    npop = min(10 * D, 100) # population size

    x = rng.uniform(size=(npop, D)) * (ub - lb) + lb
    mu = np.mean(x, axis=0)
    sigma = 0.5 * (ub - lb)
    cc = 1 / np.sqrt(D)

    for gen in range(ngen):
        y = func(x)
        if gen == ngen - 1:
            break

        a = rng.normal(size=D) * cc
        z = x + sigma * a[:, None]
        y_new = func(z)

        sel_idx = (y_new < y).nonzero()[0]

        if len(sel_idx) > 0:
            x[sel_idx] = z[sel_idx]
            mu = np.mean(x, axis=0)
            sigma *= 1.1
        else:
            sigma *= 0.9

    return np.argmin(func(x))
