def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    def clip(x):
        return np.clip(x, lb, ub)

    def crossover(parent1, parent2, mu):
        v = rng.uniform(-mu, mu)
        return parent1 + v * (parent2 - parent1)

    def acceptance_probability(old_fitness, new_fitness, temperature):
        return np.exp((new_fitness - old_fitness) / temperature)

    best_individual = np.random.uniform(lb, ub, dim)
    best_fitness = objective(best_individual)
    for _ in range(budget):
        individual = clip(np.copy(best_individual))
        for i in range(dim):
            parent1 = np.copy(individual)
            parent2 = np.copy(best_individual)
            mutant = crossover(parent1, parent2, 0.5)
            trial = clip(mutant)
            trial_fitness = objective(trial)
            if rng.random() < acceptance_probability(-trial_fitness, -best_fitness, 1):
                individual[i] = trial
                best_fitness = min(best_fitness, trial_fitness)
        best_individual[:] = individual
    return best_individual
