def algorithm(func, dim, lb, ub, budget, rng):
    def de_population(size):
        x = rng.uniform(lb, ub, size=(size, dim))
        return x
    
    def de_fitness(x):
        return func(x)
    
    def de_mutate(x1, x2, x3, f):
        r1, r2, r3 = rng.uniform(0, 1, size=dim), rng.uniform(0, 1, size=dim), rng.uniform(0, 1, size=dim)
        return x1 + r1 * (x2 - x3) + f * rng.uniform(-1, 1, size=dim)
    
    def de_crossover(x1, x2):
        cr = rng.uniform(0, 1)
        if cr < 0.5:
            return x1
        else:
            return x2
    
    pop_size = 50
    num_generations = 100
    mutation_factor = 0.5
    crossover_rate = 0.7
    
    population = de_population(pop_size)
    
    for _ in range(num_generations):
        fitness = [de_fitness(x) for x in population]
        best_idx = np.argmax(fitness)
        best_x = population[best_idx]
        
        offspring = []
        for i in range(pop_size):
            mutant = de_mutate(best_x, population[i], population[(i+1)%pop_size], mutation_factor)
            crossovered = de_crossover(mutant, population[i])
            offspring.append(crossovered)
        population = np.array(offspring)
        
    # Bayesian Optimization Refinement Phase
    def bo_acquisition_function(x):
        return -func(x) + 0.01 * np.sum((x - best_x)**2)
    
    def bo_optimize(bounds, num_iterations, initial_guess):
        x = rng.uniform(bounds[0], bounds[1], size=dim)
        for _ in range(num_iterations):
            y = func(x)
            alpha = 1 / (np.sqrt(1 + np.sum((x - initial_guess)**2)))
            kappa = 10
            xi = rng.normal(0, 1, size=dim) * alpha / kappa
            x_new = best_x + xi + np.array(bounds)[0] * (x - best_x)
            y_new = func(x_new)
            if y_new < y:
                x = x_new
        return x
    
    initial_guess = population[best_idx]
    bounds = [lb, ub]
    num_iterations = 100
    optimized_x = bo_optimize(bounds, num_iterations, initial_guess)
    
    # Clip candidates to [lb, ub]
    optimized_x = np.clip(optimized_x, lb, ub)
    
    return optimized_x
