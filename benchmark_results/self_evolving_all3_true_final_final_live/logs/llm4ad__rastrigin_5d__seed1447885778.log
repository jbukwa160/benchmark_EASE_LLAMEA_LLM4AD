def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    n = 10 ** rng.variate(0)
    sigma_max = 2 * (ub - lb) / (dim + 1.4)
    T = ub
    best_x = np.zeros(dim)
    best_f = float('inf')

    for t in range(budget):
        x = clip(best_x + n * rng.variate(0))
        v = clip(x + sigma_max * rng.variate(0, size=dim))

        f_x = func(x)
        f_v = func(v)

        if f_v < f_x:
            best_f = min(best_f, f_v)
            best_x = x

        elif np.random.rand() < np.exp((f_x - f_v) / T):
            best_f = min(best_f, f_v)
            best_x = v

        sigma_max *= 0.97
        T *= 0.9995

    return clip(best_x)
