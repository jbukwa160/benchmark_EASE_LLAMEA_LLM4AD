def algorithm(func, dim, lb, ub, budget, rng):
    N = 10  # Population size
    M = 0.8  # Differential mutation scale factor
    CR = 0.9  # Crossover probability
    F = 1.0  # Adaptation rate for Gaussian distribution
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    def adapt_gaussian(dist, mean, std):
        if dist < 0:
            return max(mean - np.sqrt(-dist), 1e-8)
        elif dist == 0:
            return mean
        else:
            return mean + np.exp(2 * F / (1 + np.exp(F)) * (np.log(dist) - F))

    for _ in range(budget):
        x_new = x_best.copy()
        candidates = lb + (ub - lb) * rng.rand(N, dim)
        
        for i in range(dim):
            # Differential mutation
            v_i = x_new[i] + M * (candidates[0, i] - x_new[i])
            v_i = adapt_gaussian(np.sum((v_i - candidates[:, i]) ** 2), np.mean(candidates[:, i]), np.std(candidates[:, i]))
            
            # Crossover
            if rng.rand() < CR or abs(v_i - x_new[i]) > 1e-8:
                x_new[i] = v_i
        
        f_new = func(x_new)
        
        if f_new < f_best:
            x_best = x_new.copy()
            f_best = f_new
    
    return x_best
