def algorithm(func, dim, lb, ub, budget, rng):
    def mutation(population, best, mu):
        n = population.shape[0]
        v = np.zeros(n)
        idx1 = rng.randint(0, n)
        idx2 = rng.randint(0, n)
        while idx2 == idx1:
            idx2 = rng.randint(0, n)

        for i in range(n):
            v[i] = population[idx1, i] + mu * (population[idx2, i] - best[i])

        return v

    def selection(population, new_population, func):
        n = population.shape[0]
        return np.minimum(np.minimum(new_population, population), func(population) < func(new_population))

    population = rng.uniform(lb, ub, (100, dim))
    for _ in range(budget):
        best = np.min(func(population), axis=0)
        new_population = mutation(population, best, 1.5)

        # clip candidates to [lb, ub]
        new_population = np.clip(new_population, lb, ub)

        population = selection(population, new_population, func)

    return np.argmin(func(population), axis=0)
