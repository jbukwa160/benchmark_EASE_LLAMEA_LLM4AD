def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    x0 = (ub - lb) * rng.rand(dim) + lb
    pop_size = int(np.ceil(budget / 2))
    adapt_step = 1.0
    min_adapt_step = 1e-6
    max_adapt_step = 10.0

    for _ in range(int(5 * budget)):
        x1 = np.copy(x0)
        indices = np.arange(pop_size)
        np.random.shuffle(indices)

        for i in indices:
            x2 = np.copy(x0)
            j, k, l = rng.choice(dim, 3, replace=False)
            x2[j] += adapt_step * (x0[k] - x0[l])
            x2[j] = max(lb, min(ub, x2[j]))

            if objective(x2) < objective(x1):
                x1 = np.copy(x2)

        x0 = 0.5 * (x0 + x1)

    return x0
