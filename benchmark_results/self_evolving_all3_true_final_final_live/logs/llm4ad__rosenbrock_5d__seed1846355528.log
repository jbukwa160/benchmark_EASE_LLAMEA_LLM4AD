def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        sigma = 0.1 / (1 + _/budget)  # adaptive step size
        delta = rng.normal(size=dim, loc=0, scale=sigma)
        x_new = x_best + delta

        # clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
