def algorithm(func, dim, lb, ub, budget, rng):
    def gp_loss(x, y, X, Y, sigma_f):
        K = np.exp(-np.sum((X[:, None] - X[None, :])**2, axis=-1) / (2 * sigma_f**2))
        return np.sum(np.log(np.diag(K))) + 0.5 * np.sum(Y**2) / (sigma_f**2)

    def gp_loss_grad(x, y, X, Y, sigma_f):
        K = np.exp(-np.sum((X[:, None] - x)**2, axis=-1) / (2 * sigma_f**2))
        return np.dot(K, (y - np.dot(K, y)) / (sigma_f**2))

    def sample_gp(x0, X, Y, sigma_f):
        K = np.exp(-np.sum((X[:, None] - x0)**2, axis=-1) / (2 * sigma_f**2))
        return np.random.multivariate_normal(np.dot(K, Y), np.diag(np.diag(K)))

    def mcts(x, depth, X, Y, sigma_f, C_pu):
        if depth == 0:
            loss = func(x)
            return -loss

        n_samples = 100
        x_gp = sample_gp(x, X, Y, sigma_f)
        losses = np.zeros(n_samples)

        for i in range(n_samples):
            x_sample = np.clip(np.random.uniform(lb, ub), lb, ub)
            if rng.rand() < C_pu:
                x_sample[x > 0] = np.random.choice([-1, 1], size=np.sum(x > 0))
            losses[i] = func(x_sample)

        return -np.mean(losses) + gp_loss_grad(x_gp, Y, X, Y, sigma_f).dot(x_gp - x)

    best_x = np.zeros(dim)
    best_loss = float('inf')

    for _ in range(budget):
        X = []
        Y = []

        while True:
            x = np.clip(np.random.uniform(lb, ub), lb, ub)
            loss = func(x)
            if rng.rand() < 0.1:  # Use GP as a surrogate model
                sigma_f = 1
                gp_losses = [gp_loss_grad(x, Y, X, Y, sigma_f).dot(x - x0) for x0 in X]
                gp_loss = np.mean(gp_losses)
                if loss < best_loss:
                    best_loss = loss
                    best_x = x.copy()
            else:  # Use the true function as a surrogate model
                X.append(x)
                Y.append(loss)

            if len(X) > 1 and rng.rand() < 0.9:  # Perform MCTS to select the next candidate
                x_mcts = np.clip(np.random.uniform(lb, ub), lb, ub)
                loss_mcts = mcts(x_mcts, 5, X, Y, sigma_f, 0.1)
                if loss_mcts < best_loss:
                    best_loss = loss_mcts
                    best_x = x_mcts.copy()

            if rng.rand() > 0.99 or len(X) >= budget // 10:
                break

    return best_x
