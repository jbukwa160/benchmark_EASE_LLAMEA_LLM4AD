def algorithm(func, dim, lb, ub, budget, rng):
    D = len(lb)
    x = np.random.uniform(-5.0, 5.0, size=(D,))
    x_best = x.copy()
    f_best = func(x)

    T = 1.0
    a = 0.99

    for t in range(budget):
        y = x + rng.normal(size=x.shape) * 0.01
        y = np.clip(y, lb, ub)
        fy = func(y)
        if fy < f_best:
            x_best = y.copy()
            f_best = fy
        if T > 1e-6 and np.random.rand() < np.exp((f_best - fy) / T):
            x = y.copy()

        T *= a

    return x_best
