def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_gen = budget
    pop_size = 100
    sigma = 0.1
    mu = int(pop_size / 2)
    lambda_ = mu * 5
    x_best = np.random.uniform(lb, ub, (pop_size, D))
    f_best = np.inf
    c = np.eye(D) + np.zeros((D, D))

    for i in range(n_gen):
        if rng.rand() < 0.1:
            sigma *= 2

        x_new = x_best + rng.normal(0, sigma, (pop_size, D))
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        idx = np.argsort(f_new)[:mu]

        x_best[idx] = x_new[idx]
        f_best = min(f_best, np.min(f_new))

    return x_best[np.argmin(f_new)]
