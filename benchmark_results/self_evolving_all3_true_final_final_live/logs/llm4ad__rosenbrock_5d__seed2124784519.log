def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(np.atleast_1d(x))

    def expected_improvement(current_best, x, mean, var):
        mu = mean
        sigma_sq = var
        if sigma_sq == 0:
            return 0
        improvement = np.max([0, current_best - mu + (sigma_sq * np.log((budget + 1) / (np.atleast_1d(rng.uniform(0, budget + 1))[0])))])
        return improvement

    def sample_from_uniform(bounds):
        x = []
        for lb_i, ub_i in zip(bounds, bounds[1:]):
            x.append(rng.uniform(lb_i, ub_i))
        return np.atleast_1d(x)

    D = dim
    n_init = 10 * D
    pop_size = 100
    samples = [sample_from_uniform([lb] * D + [ub]) for _ in range(n_init)]
    best = float('inf')
    candidates = samples.copy()

    for t in range(budget):
        mean, var = np.zeros(D), np.ones(D)
        for x in candidates:
            mean += objective(x) / len(candidates)
            var += (objective(x) - mean)**2 / len(candidates)

        new_candidate = sample_from_uniform([lb] * D + [ub])
        ei = expected_improvement(best, new_candidate, mean, var)
        if np.random.rand() < (ei / pop_size):
            candidates.append(new_candidate)

        if objective(np.atleast_1d(new_candidate)) < best:
            best = objective(np.atleast_1d(new_candidate))

    clipped_candidates = [np.clip(candidate, lb, ub) for candidate in candidates]
    return np.min(clipped_candidates, axis=0)
