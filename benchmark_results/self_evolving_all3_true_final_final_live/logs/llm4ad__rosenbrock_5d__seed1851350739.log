def algorithm(func, dim, lb, ub, budget, rng):
    def estimate_lipschitz():
        x = rng.uniform(-5, 5, size=(dim,))
        y = func(x)
        for _ in range(100):
            epsilon = rng.uniform(1e-6, 1e-4)
            gradient = np.zeros(dim)
            for i in range(dim):
                x_try = x.copy()
                x_try[i] += epsilon
                gradient[i] = (func(x_try) - y) / epsilon
            if np.any(np.isnan(gradient)):
                return 0
        return max(abs(grad) for grad in gradient)

    def simulated_annealing():
        T = 100
        x = rng.uniform(lb, ub, size=(dim,))
        for _ in range(budget):
            y = func(x)
            Lipschitz = estimate_lipschitz()
            if Lipschitz == 0:
                break
            epsilon = rng.uniform(-1e-4, 1e-4, size=dim)
            x_try = x + epsilon
            for i in range(dim):
                if x_try[i] < lb or x_try[i] > ub:
                    x_try[i] = np.clip(x_try[i], lb, ub)
            y_try = func(x_try)
            if y_try <= y:
                x = x_try
            elif rng.uniform(0, 1) < np.exp(-(y_try - y) / (Lipschitz * T)):
                x = x_try
            T *= 0.99

    def random_search():
        best_x = None
        for _ in range(budget):
            x = rng.uniform(lb, ub, size=(dim,))
            y = func(x)
            if best_x is None or y < func(best_x):
                best_x = x
        return best_x

    Lipschitz = estimate_lipschitz()
    if budget > 1000:
        return random_search()
    else:
        simulated_annealing()
        return x
