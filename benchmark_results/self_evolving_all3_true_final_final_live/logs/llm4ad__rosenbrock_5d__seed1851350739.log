def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, (1, dim))
    f_best = func(x_best)
    
    grid_size = int(np.ceil((ub - lb) / 0.5)) + 1
    for i in range(grid_size):
        for j in range(grid_size):
            for k in range(grid_size):
                for m in range(grid_size):
                    for n in range(grid_size):
                        x_candidate = np.array([lb + (i * 0.5), lb + (j * 0.5), lb + (k * 0.5), lb + (m * 0.5), lb + (n * 0.5)])
                        f_candidate = func(x_candidate)
                        
                        if f_candidate < f_best:
                            x_best = x_candidate
                            f_best = f_candidate
                            
                        # Random perturbation around promising points
                        if rng.random() < 0.1 and i != grid_size // 2 or j != grid_size // 2 or k != grid_size // 2 or m != grid_size // 2 or n != grid_size // 2:
                            x_perturb = x_best + np.zeros((dim,)) + rng.uniform(-0.01, 0.01)
                            x_perturb = np.clip(x_perturb, lb, ub)
                            f_perturb = func(x_perturb)
                            
                            if f_perturb < f_best:
                                x_best = x_perturb
                                f_best = f_perturb
    
    return x_best
