def algorithm(func, dim, lb, ub, budget, rng):
    def log_likelihood(x):
        return -func(x)

    bounds = [(lb[i], ub[i]) for i in range(dim)]
    initial_design = np.random.uniform(bounds[0][0], bounds[0][1], size=(10, dim))
    gp_model = {'x': initial_design, 'y': func(initial_design), 'kernel': rng.choice(['mat32', 'mat52', 'se'])}
    best_x = initial_design[np.argmin(func(initial_design))]
    best_y = func(best_x)

    for _ in range(budget):
        x_new = gp_model['x']
        y_new = log_likelihood(gp_model['y'])
        if rng.random() < 0.1:
            x_new += np.random.normal(0, 0.5, size=(1, dim))
        elif rng.random() < 0.2:
            x_new -= np.random.normal(0, 0.5, size=(1, dim))

        for i in range(dim):
            if x_new[0, i] < bounds[i][0]:
                x_new[0, i] = bounds[i][0]
            elif x_new[0, i] > bounds[i][1]:
                x_new[0, i] = bounds[i][1]

        gp_model['x'] = np.vstack((gp_model['x'], x_new))
        gp_model['y'] = np.append(gp_model['y'], func(x_new))

        if rng.random() < 0.3:
            kernel_idx = rng.choice([i for i in range(3) if i != gp_model['kernel']])
            gp_model['kernel'] = kernel_idx

        x_new = gp_model['x']
        y_new = log_likelihood(gp_model['y'])
        x_mean, x_var = np.mean(x_new, axis=0), 1e-5 + np.var(x_new, axis=0)
        if rng.random() < 0.4:
            x_mean += np.random.normal(0, 0.05, size=(dim,))
        y_mean, y_var = gp_model['y'], 1e-6 + np.var(gp_model['y'])
        if rng.random() < 0.5:
            y_mean += np.random.normal(0, 0.01)
        posterior = np.array([x_mean, x_var, y_mean, y_var])

        x_next = rng.choice(gp_model['x'], size=1)[0]
        for i in range(dim):
            if rng.random() < 0.6:
                x_next[i] += np.random.normal(0, posterior[1, i])
        best_x_candidate = np.clip(x_next, bounds[0][0], bounds[0][1])

        best_y_candidate = log_likelihood(func(best_x_candidate))
        if best_y_candidate < best_y:
            best_y = best_y_candidate
            best_x = best_x_candidate

    return best_x
