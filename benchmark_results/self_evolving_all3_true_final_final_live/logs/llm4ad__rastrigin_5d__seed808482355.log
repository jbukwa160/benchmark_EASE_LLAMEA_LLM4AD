def algorithm(func, dim, lb, ub, budget, rng):
    def bound(c):
        return np.clip(c, lb, ub)

    D = 1 + int(np.floor(np.log(budget) / np.log(2)))
    N = int(budget / D)
    sigma0 = 10.0
    T0 = 100.0

    x_best = -np.ones(dim)
    f_best = float('inf')
    f_current = float('inf')

    for i in range(D):
        if i == 0:
            x_current = bound(rng.uniform(lb, ub, size=(N, dim)))
            f_current = func(x_current)

            for j in range(N):
                x_temp = bound(x_current[j] + rng.normal(size=dim) * sigma0)
                fx_temp = func(x_temp)
                if fx_temp < f_current:
                    f_current = fx_temp
                    x_current[j] = x_temp

        else:
            x_current = np.copy(x_best)
            f_current = f_best

            for j in range(N):
                x_temp = bound(x_current[j] + rng.normal(size=dim) * sigma0)
                fx_temp = func(x_temp)

                if fx_temp < f_current:
                    f_current = fx_temp
                    x_current[j] = x_temp

        T = max(T0 - i, 1e-6)
        alpha = np.exp(-T / (f_best + 1e-7))

        for j in range(N):
            r1 = rng.randint(0, N)
            while r1 == j:
                r1 = rng.randint(0, N)

            x_temp = bound(x_current[j] + alpha * (x_current[r1] - x_current[j]) + rng.normal(size=dim) * sigma0)
            fx_temp = func(x_temp)

            if fx_temp < f_best:
                f_best = fx_temp
                x_best = np.copy(x_current[j])

    return bound(x_best)
