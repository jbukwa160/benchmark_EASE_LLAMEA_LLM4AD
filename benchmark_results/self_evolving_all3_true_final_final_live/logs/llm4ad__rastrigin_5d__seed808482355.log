def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def gaussian_noise(p, sigma):
        noise = np.zeros_like(p)
        for i in range(len(noise)):
            noise[i] = rng.normal(0, sigma)
        return noise

    def evaluate(x):
        try:
            return func(x)
        except Exception as e:
            print(f"Error evaluating function: {e}")
            return float('inf')

    pop_size = 50
    sigma_max = 1.0
    sigma_min = 0.01
    learning_rate = 0.05

    x_pop = np.random.uniform(lb, ub, (pop_size, dim))
    fitness_pop = [evaluate(clip(x)) for x in x_pop]

    for _ in range(budget):
        sigma = max(sigma_min, min(sigma_max, sigma_max - (sigma_max - sigma_min) * np.exp(-learning_rate)))

        noise = gaussian_noise(np.zeros_like(fitness_pop), sigma)
        new_x_pop = x_pop + noise

        new_fitness_pop = [evaluate(clip(new_x)) for new_x in new_x_pop]

        indices = np.argsort(new_fitness_pop)[:pop_size]
        x_pop, fitness_pop = x_pop[indices], new_fitness_pop[indices]

    best_idx = np.argmin(fitness_pop)
    return clip(x_pop[best_idx])
