def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def objective(x):
        return func(x)

    pop_size = 50
    max_iter = int(budget / pop_size)
    mutation_rate = 0.5
    temp = 1.0

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = objective(clip(x_best))

    for _ in range(max_iter):
        for _ in range(pop_size):
            mutant = clip(x_best + mutation_rate * (rng.uniform(-1, 1, size=dim) - 0.5))
            if rng.rand() < 0.01:
                # Simulated annealing: occasionally accept worse solutions
                temp *= 0.99
                f_mutant = objective(clip(mutant))
                if f_mutant < f_best * (1 + 1e-6):
                    x_best, f_best = mutant, f_mutant
            else:
                # Differential evolution crossover
                trial = clip(0.5 * x_best + 0.5 * mutant)
                f_trial = objective(trial)
                if f_trial < f_best:
                    x_best, f_best = trial, f_trial

    return x_best
