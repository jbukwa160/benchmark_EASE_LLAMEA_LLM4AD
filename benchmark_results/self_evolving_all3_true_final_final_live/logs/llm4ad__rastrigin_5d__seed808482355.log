def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    x_best = -np.ones(dim)
    f_best = float('inf')
    pop_size = 10 * (dim + 1)
    cov = np.eye(dim) * 0.1
    mu = np.zeros((pop_size, dim))
    sigma = 5

    for t in range(budget):
        y = rng.randn(pop_size, dim)
        x = lb + (ub - lb) * (mu + sigma * y)
        f_values = [evaluate(x[i]) for i in range(pop_size)]
        
        # Select the best solutions
        indices = np.argsort(f_values)[:10]
        mu[indices] = x[indices]
        cov = 0.1 * np.eye(dim)

        # Update f_best and x_best
        if min(f_values) < f_best:
            f_best = min(f_values)
            x_best = mu[np.argmin(f_values)]

    return x_best
