def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.ceil(budget ** (1 / 4)))
    mean = np.zeros(dim)
    sigma = [0.5] * pop_size
    best = -np.inf
    x_best = None

    for i in range(budget):
        X = np.clip(mean + rng.randn(pop_size, dim) * sigma, lb, ub)
        f_X = func(X)

        idx = np.argsort(f_X)[:1]
        f_x = f_X[idx][0]
        x = X[idx][0]

        if f_x < best:
            best = f_x
            x_best = x

        delta = X - mean
        covariance_matrix = np.cov(delta.T) + 1e-8 * np.eye(dim)
        inv_covar = np.linalg.inv(covariance_matrix)

        grad_mean = (f_X[idx] - best) / sigma
        Hessian_approximation = np.dot(grad_mean.reshape(-1, dim), delta.T).T

        for j in range(pop_size):
            if f_X[j] < best:
                grad_j = (f_X[j] - best) / sigma[j]
                Hessian_approximation += np.outer(delta[j], grad_j)

        inv_covar_new = inv_covariance_update(inv_covar, Hessian_approximation)
        mean_new = update_mean(mean, delta, Hessian_approximation, inv_covar_new, sigma)

        for j in range(pop_size):
            if rng.uniform(0, 1) < 0.5:
                sigma[j] *= np.exp(rng.normal(loc=0, scale=0.1))
            else:
                sigma[j] = np.sqrt(np.mean(np.diag(covariance_matrix)))

        mean = mean_new

    return x_best
