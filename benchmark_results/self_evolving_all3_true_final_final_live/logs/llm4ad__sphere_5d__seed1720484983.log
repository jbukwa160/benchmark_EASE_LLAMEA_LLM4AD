def algorithm(func, dim, lb, ub, budget, rng):
    def sample_bounds(lb, ub):
        return lb + (ub - lb) * rng.uniform(0, 1)

    def feasible(x):
        return np.all(np.logical_and(x >= lb, x <= ub))

    best_x = None
    best_f = float('inf')
    
    for _ in range(budget):
        sample = np.array([sample_bounds(lb, ub) for _ in range(dim)])
        
        if not feasible(sample):
            continue
        
        f_value = func(sample)
        
        if f_value < best_f:
            best_x = sample
            best_f = f_value
    
    return best_x
