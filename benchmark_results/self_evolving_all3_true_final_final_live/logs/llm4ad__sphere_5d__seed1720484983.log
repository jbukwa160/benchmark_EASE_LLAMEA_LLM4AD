def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.full(dim, 0)
    f_best = float('inf')
    r = max(ub - lb, 1e-6)

    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim) + (rng.uniform(-r, r, size=dim) * (x_best - rng.uniform(lb, ub, size=dim)))
        x = np.clip(x, lb, ub)
        f = func(x)

        if f < f_best:
            f_best = f
            x_best = x

        if 2*r <= max(ub - lb):
            r /= 2

    return x_best
