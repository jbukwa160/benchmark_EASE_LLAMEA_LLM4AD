def algorithm(func, dim, lb, ub, budget, rng):
    x0 = np.random.uniform(lb, ub, dim)
    res = minimize(lambda x: func(x), x0, method="SLSQP", bounds=[(lb, ub)]*dim, options={"maxfun": int(budget)})
    return res.x
