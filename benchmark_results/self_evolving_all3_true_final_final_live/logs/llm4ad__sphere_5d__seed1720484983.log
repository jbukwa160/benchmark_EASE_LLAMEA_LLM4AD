def algorithm(func, dim, lb, ub, budget, rng):
    np.random.seed(rng)

    n = 10  # number of initial points
    init_points = np.random.uniform(lb, ub, size=(n, dim))

    best_point = None
    best_value = float('inf')

    for _ in range(budget):
        # DIRECT global optimization algorithm
        x_init = init_points[np.argmin([func(x) for x in init_points])]
        x_best = x_init

        while True:
            x_cand = (lb + ub) / 2.0 * np.random.uniform(size=dim)
            cand_value = func(x_cand)

            if cand_value < func(x_best):
                x_best = x_cand
                if cand_value < best_value:
                    best_point = x_best
                    best_value = cand_value

        init_points = np.vstack((init_points, [x_best]))

    return best_point
