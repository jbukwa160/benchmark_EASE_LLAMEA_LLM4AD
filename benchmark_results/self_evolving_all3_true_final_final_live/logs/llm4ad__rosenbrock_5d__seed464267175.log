def algorithm(func, dim, lb, ub, budget, rng):
    def sample_distribution(mu, sigma):
        return mu + sigma * rng.randn(dim)

    def clip(candidate):
        return np.clip(candidate, lb, ub)

    n_samples = int(budget)
    population_size = min(10*dim, n_samples//5)
    lambda_ = population_size
    mu = 0.1 * (ub - lb) + lb
    sigma = 1e-3
    weights = np.exp(-np.arange(lambda_)**2 / (2 * lambda_))
    weights /= weights.sum()
    counts = np.zeros((dim, lambda_))

    for _ in range(n_samples):
        samples = sample_distribution(mu, sigma)
        clipped_samples = clip(samples)
        fitnesses = func(clipped_samples)

        for i in range(lambda_):
            counts[:, i] += weights[i]
            if rng.rand() < 0.1:
                mu += counts[:, i] * clipped_samples[i]

        if rng.rand() < 0.05 and sigma < 10*sigma:
            sigma *= 2

    best_candidate = clipped_samples[np.argmin(fitnesses)]
    return best_candidate
