def algorithm(func, dim, lb, ub, budget, rng):
    def init_population():
        return np.random.uniform(lb, ub, size=(budget, dim))

    def clip_candidates(x):
        clipped = np.clip(x, lb, ub)
        return np.where(np.isnan(clipped), x, clipped)

    def evaluate(x):
        return func(x)

    def sa_step(current_best, current_population, T, cooling_rate):
        n = len(current_population)
        for i in range(n):
            new_individual = current_population[np.random.randint(0, n)]
            delta = evaluate(new_individual) - evaluate(current_best)
            if delta < 0 or np.random.rand() < np.exp(-delta / T):
                current_best = new_individual
                current_population[i] = new_individual
        return current_best

    def de_step(current_best, current_population, scaling_factor, crossover_prob):
        n = len(current_population)
        for i in range(n):
            r1, r2, r3 = np.random.randint(0, n, size=3)
            v = current_population[r1] + scaling_factor * (current_population[r2] - current_population[r3])
            u = np.random.rand(dim) < crossover_prob
            x = np.where(u, v, current_population[i])
            x = clip_candidates(x)
            delta = evaluate(x) - evaluate(current_best)
            if delta < 0:
                current_best = x
        return current_best

    population = init_population()
    best_individual = population[0]
    for i in range(1, budget):
        sa_step(best_individual, population, rng.uniform(1.0, 10.0), 0.9)
        de_step(best_individual, population, rng.uniform(0.5, 2.0), rng.uniform(0.7, 0.9))
    return best_individual
