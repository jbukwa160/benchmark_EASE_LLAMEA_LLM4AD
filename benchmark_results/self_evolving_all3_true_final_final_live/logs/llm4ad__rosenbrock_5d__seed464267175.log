def algorithm(func, dim, lb, ub, budget, rng):
    def bounds(i):
        return [(lb[i], ub[i]) for i in range(dim)]

    res = differential_evolution(func, bounds, maxiter=budget)
    best_x = res.x
    best_f = func(best_x)

    for _ in range(budget * 10): # local search
        x = best_x + rng.uniform(-1, 1) / np.abs(best_x - lb)
        f = func(x)
        if f < best_f:
            best_x = x
            best_f = f

    return best_x
