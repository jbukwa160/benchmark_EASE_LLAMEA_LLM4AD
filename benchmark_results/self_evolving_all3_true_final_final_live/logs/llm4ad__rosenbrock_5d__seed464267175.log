def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    T = 1000.0
    alpha = 1e-4
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        dx = np.zeros(dim)
        i = rng.choice(dim, p=np.ones(dim)/dim)
        if rng.rand() < 0.5:
            dx[i] = rng.uniform(-1e-3, 1e-3)
        else:
            grad = alpha * np.array([func(np.insert(x.copy(), j, x[j] + 1e-6)) - func(np.insert(x.copy(), j, x[j] - 1e-6))
                                    for j in range(dim)]) / (2e-6) if dim > 1 else 0
            dx[i] = rng.normal(0, 1e-3)
        step_x = clip(x + dx)
        
        f_step = func(step_x)
        delta = f_step - best_f
        
        if delta < 0 or rng.rand() < np.exp(-delta / T):
            x = step_x
            best_x = x.copy()
            best_f = f_step
            
        T *= 0.9999
    
    return best_x
