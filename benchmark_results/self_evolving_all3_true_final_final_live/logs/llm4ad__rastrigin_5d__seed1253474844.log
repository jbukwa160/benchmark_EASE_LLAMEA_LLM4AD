def algorithm(func, dim, lb, ub, budget, rng):
    D = 2.0 * (ub - lb)
    A = np.eye(dim) * D
    b = np.zeros((dim,))
    
    # Initialize GP hyperparameters and noise variance
    alpha0 = 1e-6
    eta0 = 1e-6
    
    # Initialize the initial sample
    x_init = rng.uniform(lb, ub, (1, dim))
    y_init = func(x_init)
    
    # Store the best found solution so far
    x_best = np.copy(x_init)
    f_best = np.copy(y_init)
    
    for i in range(budget):
        # Predict mean and variance at random points
        mu, var = gp_predict(A, b, alpha0, eta0, x_init)
        
        # Sample from the predicted distribution
        sAMP = norm.rvs(loc=mu, scale=np.sqrt(var), size=(1, dim))
        sAMP = clip(sAMP, lb, ub)
        
        # Compute the function value at the sampled point
        y_samp = func(sAMP)
        
        # Update GP hyperparameters and noise variance
        alpha0, eta0 = update_hyperparams(A, b, alpha0, eta0, x_init, sAMP, y_samp, y_init)
        
        # Store the best found solution so far
        if y_samp < f_best:
            x_best = np.copy(sAMP)
            f_best = np.copy(y_samp)
            
        # Update the GP model parameters and the initial sample
        A, b = update_gp(A, b, sAMP)
        x_init = np.copy(sAMP)
        
    return x_best
