def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    pop_size = 50
    mutation_strategy = 'rand1exp'
    crossover_prob = 0.5
    weight = 0.3

    population = np.random.uniform(lb, ub, (pop_size, dim))

    for _ in range(budget):
        distances = rng.uniform(0, 1, size=(pop_size, pop_size))
        targets = np.argsort(distances, axis=1)[:, 1:]

        mutant = np.zeros((pop_size, dim))
        for i in range(pop_size):
            if mutation_strategy == 'rand1exp':
                j = targets[i, rng.randint(0, pop_size - 1)]
                mutant[i] = population[j] + weight * (population[i] - population[j]) + rng.uniform(-1, 1) * np.abs(population[j])
            elif mutation_strategy == 'best1exp':
                j = targets[i, 0]
                mutant[i] = population[j] + weight * (population[i] - population[j]) + rng.uniform(-1, 1) * np.abs(population[j])

        crossover = np.zeros((pop_size, dim))
        for i in range(pop_size):
            if rng.rand() < crossover_prob:
                crossover[i] = (population[i] + mutant[i]) / 2
            else:
                crossover[i] = population[i]

        candidate = clip(crossover, lb, ub)

        score = func(candidate)
        best_candidate = np.copy(candidate)
        best_score = score

        for i in range(pop_size):
            score = func(clip(population[i], lb, ub))
            if score < best_score:
                best_score = score
                best_candidate = population[i]

        population = candidate

    return best_candidate
