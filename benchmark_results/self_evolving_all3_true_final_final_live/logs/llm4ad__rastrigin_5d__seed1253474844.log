def algorithm(func, dim, lb, ub, budget, rng):
    N = 100
    D = dim * N
    pop = (ub - lb) * rng.rand(N, D) + lb
    best = None
    for _ in range(budget):
        fit = np.array([func(p) for p in pop])
        idx = np.argsort(fit)
        if not best or fit[idx[0]] < func(best):
            best = pop[idx[0]]
        f_best, g_best = fit[idx[-1]], fit[idx[:-1]].max()
        if f_best - g_best <= 1e-6:
            break
        v = pop[idx[np.random.choice(N - 1, N, replace=False)]]
        u = (ub - lb) * rng.rand(N, D) + lb
        for i in range(D):
            mu = 0.5
            r1, r2, r3 = rng.uniform(0, 1, 3)
            if r1 < mu:
                pop[i // N, i % N] = v[i // N, i % N] + r2 * (pop[i // N, i % N] - u[i // N, i % N])
            elif r2 < mu:
                pop[i // N, i % N] = u[i // N, i % N] + r3 * (v[i // N, i % N] - pop[i // N, i % N])
            else:
                pop[i // N, i % N] = 0.5 * (u[i // N, i % N] + v[i // N, i % N]) + r1 * (pop[i // N, i % N] - u[i // N, i % N])
    return best
