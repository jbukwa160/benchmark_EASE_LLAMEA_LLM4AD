def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Random search to propose new candidates
        cand = (ub - lb) * rng.randn(dim) + lb

        # Evaluate candidate and update best if better
        f = func(cand)
        if f < best_f:
            best_x = cand.copy()
            best_f = f

        # Hill climbing: add a small perturbation to the current best
        p = (ub - lb) * rng.randn(dim) + lb
        new_x = best_x + 0.01 * p

        # Clip and evaluate new candidate, update best if better
        new_x = np.clip(new_x, lb, ub)
        f = func(new_x)
        if f < best_f:
            best_x = new_x.copy()
            best_f = f

    return best_x
