def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    x_best = np.zeros(dim)
    f_best = float('inf')
    
    t = 1.0
    for _ in range(budget):
        x_new = x_best + rng.uniform(-1, 1, size=dim) * (ub - lb)
        x_new = clip(x_new)
        
        f_new = func(x_new)
        if f_new < f_best:
            x_best = x_new
            f_best = f_new
        
        delta_f = f_new - f_best
        alpha = np.exp(-t * abs(delta_f))
        t *= 0.9999
        
        if rng.uniform(0, 1) > alpha or delta_f <= 0:
            continue
    
    return x_best
