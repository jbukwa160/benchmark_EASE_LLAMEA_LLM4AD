def algorithm(func, dim, lb, ub, budget, rng):
    n = len(dim)
    t = 1e6
    a = .9
    b = 0.1
    x_best = np.zeros(n)
    f_best = float('inf')
    
    for _ in range(budget):
        x = np.clip(rng.uniform(lb, ub, size=n), lb, ub)
        
        if func(x) < f_best:
            f_best = func(x)
            x_best = x
            
        delta_f = func(x) - f_best
        
        if delta_f <= 0 or rng.rand() * np.exp(-delta_f / t) > rng.rand():
            x_best = x
            f_best = func(x)
            
        t *= a + b * (1 - _ / budget)
        
    return x_best
