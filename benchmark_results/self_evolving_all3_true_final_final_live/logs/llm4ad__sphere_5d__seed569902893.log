def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_fval = float('inf')

    for _ in range(budget):
        x = np.clip(rng.uniform(size=dim) * (ub - lb) + lb, lb, ub)
        fval = func(x)

        if fval < best_fval:
            best_fval = fval
            best_x = x

        # Local Search refinement
        for i in range(dim):
            x1 = np.copy(x)
            x2 = np.copy(x)

            x1[i] += rng.uniform(-0.1, 0.1) * (ub - lb)
            x2[i] -= rng.uniform(-0.1, 0.1) * (ub - lb)

            fval1 = func(np.clip(x1, lb, ub))
            fval2 = func(np.clip(x2, lb, ub))

            if fval1 < best_fval:
                best_fval = fval1
                best_x = x1

            if fval2 < best_fval:
                best_fval = fval2
                best_x = x2

    return best_x
