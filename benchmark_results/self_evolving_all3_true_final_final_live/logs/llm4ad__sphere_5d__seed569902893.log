def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget - 1):
        e = rng.normal(size=dim) * 0.1
        step_size = 1e-2
        x_new = best_x + e * step_size
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)

        if f_new < best_f:
            best_f = f_new
            best_x = x_new

    return best_x
