def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(candidate):
        candidate = clip(candidate)
        return func(candidate)

    x = np.random.uniform(-5.0, 5.0, size=dim)
    population_size = 50
    step_size = 1.0
    sigma = 1.0

    for _ in range(budget):
        candidates = rng.normal(loc=x, scale=sigma, size=(population_size, dim))
        candidates = clip(candidates)

        evaluations = np.array([evaluate(candidate) for candidate in candidates])

        x = np.mean(candidates[evaluations == np.min(evaluations)], axis=0)
        sigma *= 0.99

    return x
