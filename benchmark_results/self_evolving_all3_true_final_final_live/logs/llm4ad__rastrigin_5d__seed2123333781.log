def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    best = None
    for _ in range(budget):
        x = np.random.uniform(lb, ub, size=dim)
        y = x + 0.1 * (np.random.rand(dim) - 0.5) * (ub - lb)
        v = clip(y)

        for i in range(100):  # Differential evolution iterations
            u = v + 0.5 * (np.random.rand(dim) - 0.5) * (v - x)
            u = clip(u)
            f_u = func(u)
            if f_u < func(v):
                v = u

        if best is None or func(v) < func(best):
            best = v
    return best
