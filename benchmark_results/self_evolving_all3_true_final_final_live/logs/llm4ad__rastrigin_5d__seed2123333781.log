def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_candidate(current_x):
        noise = rng.uniform(-1, 1, size=(dim,))
        candidate = current_x + 0.01 * (ub - lb) * noise
        return clip(candidate)

    x_best = rng.uniform(lb, ub)
    f_best = func(x_best)

    for _ in range(budget):
        x_current = generate_candidate(x_best)
        f_current = func(x_current)

        if f_current < f_best:
            f_best = f_current
            x_best = x_current

        delta = rng.uniform(-1, 1)
        x_neighbour = x_current + delta * (ub - lb) / 10
        x_neighbour = clip(x_neighbour)

        f_neighbour = func(x_neighbour)

        if f_neighbour < f_best:
            f_best = f_neighbour
            x_best = x_neighbour

    return x_best
