def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_f = float('inf')
    
    for _ in range(budget):
        x = np.zeros(dim)
        
        while True:
            trial_x = x + rng.uniform(-1, 1, size=dim) * (ub - lb)
            
            # Clip to bounds
            trial_x = np.clip(trial_x, lb, ub)
            
            f_trial = func(trial_x)
            
            if f_trial < best_f:
                best_f = f_trial
                best_x = trial_x.copy()
                
                if best_f == 0:  # Global minimum found
                    break
                    
        print(f'Best solution found after {_} iterations with function value {best_f}')
        
    return best_x
