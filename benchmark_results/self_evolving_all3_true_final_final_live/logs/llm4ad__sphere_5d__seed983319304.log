def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        x = np.clip(x, lb, ub)
        return func(x)

    n = 10 * dim
    sigma0 = (ub - lb) / 2.38
    lambda_ = int(n**0.5)
    mu = 1 / lambda_
    mean = rng.uniform(lb, ub, size=dim)
    cov = np.eye(dim) * sigma0**2
    step_size = 0.5

    for _ in range(budget):
        for _ in range(lambda_):
            x = np.random.multivariate_normal(mean, cov)
        x = np.clip(x, lb, ub)

        f_x = evaluate(x)

        for i in range(lambda_ - 1):
            y = x + rng.normal(0, sigma0, size=dim)
            y = np.clip(y, lb, ub)
            f_y = evaluate(y)

            if f_y < f_x:
                x = y
                f_x = f_y

        d = (x - mean) / sigma0**2
        cov += step_size * (d @ d.T + mu * np.eye(dim))
        mean += step_size * d

    return mean
