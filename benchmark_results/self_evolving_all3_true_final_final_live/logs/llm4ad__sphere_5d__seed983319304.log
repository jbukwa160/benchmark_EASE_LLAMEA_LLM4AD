def algorithm(func, dim, lb, ub, budget, rng):
    X = np.zeros((budget, dim))
    y = np.zeros(budget)
    
    for i in range(budget):
        x = (ub - lb) * rng.rand(dim) + lb
        X[i] = x
        y[i] = func(x)
        
    idx = np.argmin(y)
    return X[idx]
