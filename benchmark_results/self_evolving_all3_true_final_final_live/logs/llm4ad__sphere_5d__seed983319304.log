def algorithm(func, dim, lb, ub, budget, rng):
    D = np.prod((ub - lb))
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    for _ in range(budget):
        # Sample a candidate
        x_candidate = lb + (ub - lb) * rng.rand(dim)

        # Evaluate the function at the new point
        f_candidate = func(np.clip(x_candidate, lb, ub))

        # Update best solution if necessary
        if f_candidate < f_best:
            x_best = np.copy(x_candidate)
            f_best = f_candidate

    return x_best
