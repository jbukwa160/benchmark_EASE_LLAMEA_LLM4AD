def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    best_fitness = float('inf')
    
    for _ in range(budget):
        simplex = np.random.rand(10, dim) * (ub - lb) + lb
        while True:
            y = func(simplex)
            if np.any(y < best_fitness):
                idx = np.argsort(y)[:3]
                new_simplex = np.vstack([simplex[idx[0]], 
                                         simplex[idx[1]] + 1.05 * (simplex[idx[0]] - simplex[idx[2]]),
                                         simplex[idx[2]] - 1.05 * (simplex[idx[0]] - simplex[idx[2]]),
                                         (simplex[idx[0]] + simplex[idx[1]]) / 2,
                                         simplex[idx[2]] + 0.5 * (simplex[idx[0]] - simplex[idx[2]])])
                new_simplex = np.clip(new_simplex, lb, ub)
                if _ < budget // 10:
                    best_fitness = min(best_fitness, func(new_simplex[np.argmin(y)]))
                    best = new_simplex[np.argmin(y)]
                elif rng.rand() < 0.1 and _ == budget - 1:
                    return np.array([func(best) for i in range(100)][np.argmin(np.array([func(i) for i in new_simplex]))])
                simplex = new_simplex
            else:
                break
                
    return best
