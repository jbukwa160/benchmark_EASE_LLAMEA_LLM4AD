def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidates(mean, sigma, n_candidates):
        candidates = mean + sigma * rng.normal(size=(n_candidates, dim))
        return clip(candidates)

    def update_mean_and_sigma(previous_best, new_solution, mean, sigma):
        delta = new_solution - previous_best
        new_mean = (previous_best * (1 - 0.01) + new_solution * 0.01).astype(np.float64)
        new_sigma = sigma / np.sqrt(0.5 + rng.uniform())
        return new_mean, new_sigma

    def restart_search(mean, sigma):
        n_candidates = int(budget / 10)
        candidates = generate_candidates(mean, sigma, n_candidates)
        scores = [func(candidate) for candidate in candidates]
        best_candidate_idx = np.argmin(scores)
        return candidates[best_candidate_idx], mean, sigma

    def adaptive_search(previous_best, mean, sigma):
        n_candidates = int(budget / 5)
        candidates = generate_candidates(mean, sigma, n_candidates)
        scores = [func(candidate) for candidate in candidates]
        best_candidate_idx = np.argmin(scores)
        new_solution = candidates[best_candidate_idx]
        if func(new_solution) < func(previous_best):
            return update_mean_and_sigma(previous_best, new_solution, mean, sigma), new_solution
        else:
            return previous_best, mean, sigma

    current_best = rng.uniform(lb, ub, size=dim)
    for i in range(budget):
        current_best, mean, sigma = adaptive_search(current_best, mean, sigma)
    return current_best
