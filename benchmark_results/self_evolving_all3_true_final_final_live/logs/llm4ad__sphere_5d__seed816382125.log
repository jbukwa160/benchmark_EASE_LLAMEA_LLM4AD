def algorithm(func, dim, lb, ub, budget, rng):
    def simulate_annealing(best_x, T, step_size, t=0):
        x_new = best_x + np.random.uniform(-step_size, step_size, size=(dim,))
        x_new = np.clip(x_new, lb, ub)
        if func(x_new) < func(best_x):
            return x_new
        else:
            p = np.exp(-(func(x_new) - func(best_x)) / T)
            if rng.random() < p:
                return x_new
            else:
                return best_x

    best_x = None
    for _ in range(budget):
        if best_x is None or np.random.rand() < 0.1: # restart with random solution every 10% of budget
            best_x = np.random.uniform(lb, ub, size=(dim,))
        T = 100.0 / (t + 1) # adaptive temperature cooling schedule
        step_size = 0.5 * (ub - lb) / (t + 1) # adapt noise magnitude based on cooling factor
        best_x = simulate_annealing(best_x, T, step_size, t=_)
        t += 1

    return best_x
