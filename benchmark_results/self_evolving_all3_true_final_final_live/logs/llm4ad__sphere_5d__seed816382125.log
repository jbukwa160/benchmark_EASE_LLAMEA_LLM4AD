def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def objective(x):
        x = clip(x)
        return func(x)

    best_solution = np.zeros(dim)
    best_value = float('inf')

    num_restarts = 0
    while True:
        population_size = min(20, dim * 2)  # Use a smaller population size to avoid overpopulation
        population = rng.uniform(lb, ub, (population_size, dim))
        velocities = np.zeros((population_size, dim))

        for _ in range(budget):
            for i in range(population_size):
                r1, r2, r3 = rng.randint(0, population_size, 3)
                while r1 == i or r2 == i or r3 == i:
                    r1, r2, r3 = rng.randint(0, population_size, 3)

                velocities[i] = 0.5 * (population[r1] - population[r2]) + 0.5 * (population[r3] - population[r1])

            for i in range(population_size):
                crossover_rate = 0.7
                mutation_rate = 0.6

                trial_solution = population[i] + crossover_rate * velocities[i]
                trial_solution += rng.normal(0, 1, dim) * (mutation_rate * np.abs(trial_solution - population[rng.randint(0, population_size)]))

                if objective(trial_solution) < objective(population[i]):
                    population[i] = trial_solution

        num_restarts += 1
        if objective(population[0]) < best_value:
            best_solution = population[0]
            best_value = objective(best_solution)

        if num_restarts > 10 or budget <= 100:  # Restart after 10 iterations or when the budget is low
            break

    return best_solution
