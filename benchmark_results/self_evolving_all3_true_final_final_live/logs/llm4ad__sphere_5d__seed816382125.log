def algorithm(func, dim, lb, ub, budget, rng):
    def norm(x):
        return np.sqrt(np.sum(x**2))

    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    x = rng.uniform(lb, ub, size=dim)
    lambda_ = int(budget / (norm(x) + 1e-8)) ** 0.5
    sigma = norm(x) * 0.2
    c1 = np.zeros(dim)
    mu = x

    for _ in range(budget):
        u = rng.normal(size=(lambda_, dim))
        y = mu + sigma * u
        y = clip(y)

        f_y = func(y)
        f_x = func(x)

        if f_y < f_x:
            c1 += np.outer(u, (f_y - f_x) / 2)
            mu = y

        sigma *= 0.5 ** ((norm(mu) - norm(x)) / (norm(norm(x)) + 1e-8))
        lambda_ = int(budget / (norm(x) + 1e-8)) ** 0.5
        c1 /= lambda_

    return mu
