def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    T = 1e3
    alpha = 0.99
    c1 = 0.5
    c2 = 0.3
    sigma = 10.0

    for _ in range(budget):
        x_new = x + rng.uniform(-sigma, sigma, size=dim)
        x_new = np.clip(x_new, lb, ub)

        f_x = func(x)
        f_x_new = func(x_new)

        if f_x_new < f_x:
            x = x_new
            T *= alpha

        elif rng.rand() < np.exp((f_x - f_x_new) / T):
            x = x_new

        T *= alpha

    return x
