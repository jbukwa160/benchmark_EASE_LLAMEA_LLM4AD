def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        x_prime = x + 0.5 * (ub - lb) * rng.randn(dim)
        x_prime = np.clip(x_prime, lb, ub)
        
        f_prime = func(x_prime)
        if f_prime < best_f:
            best_x = x_prime.copy()
            best_f = f_prime
        
        # Local search
        step_size = 0.1 * (ub - lb) * rng.uniform(0, 1, size=dim)
        for i in range(dim):
            xi = best_x[i] + step_size[i]
            if lb <= xi <= ub:
                x_best_i = best_x.copy()
                x_best_i[i] = xi
                f_best_i = func(x_best_i)
                if f_best_i < best_f:
                    best_x = x_best_i
                    best_f = f_best_i

    return best_x
