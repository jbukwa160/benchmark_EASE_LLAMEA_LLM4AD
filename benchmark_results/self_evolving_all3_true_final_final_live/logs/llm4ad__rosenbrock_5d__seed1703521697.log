def algorithm(func, dim, lb, ub, budget, rng):
    init_step = 5.0
    alpha = 0.99
    sigma = 1.0
    temp = 1000.0

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        new_x = x + init_step * rng.normal(size=dim)
        new_x = np.clip(new_x, lb, ub)

        f_new = func(new_x)
        if f_new < best_f:
            best_f = f_new
            best_x = new_x

        prob_accept = np.exp(-(f_new - best_f) / temp)
        if rng.rand() < prob_accept:
            x = new_x

        init_step *= alpha
        sigma *= alpha ** 0.5
        temp *= alpha

    return best_x
