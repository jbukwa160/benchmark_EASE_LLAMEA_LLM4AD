def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(size=dim) * (ub - lb) + lb
    best_x = x.copy()
    best_f = func(x)
    learning_rate = 0.1
    for _ in range(budget):
        g = np.zeros(dim)
        for i in range(dim):
            x_plus = x.copy()
            x_plus[i] += 1e-8
            f_plus = func(x_plus)
            gradient = (f_plus - best_f) / 1e-8 if i == 0 else func(np.array([x[j] + 1e-8 if j == i else x[j] for j in range(dim)]))
            g[i] = gradient
        step_size = np.sqrt(2 * learning_rate)
        x += rng.normal(scale=step_size, size=dim)
        x = np.clip(x, lb, ub)
        f = func(x)
        if f < best_f:
            best_x = x.copy()
            best_f = f
    return best_x
