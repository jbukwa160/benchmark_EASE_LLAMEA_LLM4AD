def algorithm(func, dim, lb, ub, budget, rng):
    def process_candidate(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(num_candidates, rng):
        return np.random.uniform(lb, ub, (num_candidates, dim))

    def evaluate_candidates(candidates):
        scores = []
        for candidate in candidates:
            score = func(candidate)
            scores.append(score)
        return np.array(scores)

    def surrogate_model(X, Y):
        from scipy.stats import gaussian_kde
        kde = gaussian_kde(np.vstack([X, Y]))
        return lambda x: kde.pdf(x).max()

    def ucb_acquisition_function(model, X, alpha=0.1):
        scores = model(X)
        means = np.mean(scores)
        stds = np.std(scores) if len(scores) > 1 else 1
        return means + alpha * stds

    def acquisition_step(model, candidates, num_candidates):
        candidate_scores = evaluate_candidates(candidates)
        next_candidate_index = np.argmax(candidate_scores)
        next_candidate = process_candidate(candidates[next_candidate_index])
        scores = model(next_candidate)
        return next_candidate, scores

    num_initial_candidates = 10 * dim
    initial_population = generate_initial_population(num_initial_candidates, rng)
    best_candidate = None
    best_score = float('inf')

    for i in range(budget):
        model = surrogate_model(initial_population, evaluate_candidates(initial_population))
        current_best, _ = acquisition_step(model, initial_population, num_initial_candidates)
        if func(current_best) < best_score:
            best_score = func(current_best)
            best_candidate = process_candidate(current_best)

    return best_candidate
