def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidates(mu, sigma):
        candidates = mu + sigma * rng.randn(dim)
        return clip(candidates)

    def update_sigma(sigma, best_fitness, budget_remaining):
        if budget_remaining == 0:
            return sigma
        if best_fitness < func(np.zeros(dim)):
            sigma *= 1.01
        else:
            sigma /= 1.001
        return np.clip(sigma, 0.1, 10)

    def cma_step(mu, sigma, budget_remaining):
        candidates = generate_candidates(mu, sigma)
        new_population = [func(candidate) for candidate in candidates]
        best_fitness = min(new_population)
        best_candidate = candidates[new_population.index(best_fitness)]
        mu = (mu * 0.5 + np.array(best_candidate)) / 1.001
        sigma = update_sigma(sigma, best_fitness, budget_remaining - 1)
        return mu, sigma

    def initialize(dim):
        mu = rng.randn(dim)
        sigma = 10
        return mu, sigma

    mu, sigma = initialize(dim)
    for _ in range(budget):
        mu, sigma = cma_step(mu, sigma, budget)

    return clip(mu)
