def algorithm(func, dim, lb, ub, budget, rng):
    init_x = rng.uniform(lb, ub, size=dim)
    best_x = init_x.copy()
    best_f = func(init_x)

    T = 1000.0
    cooling_rate = 0.99
    alpha = 1e-4

    for _ in range(budget):
        new_x = rng.uniform(lb, ub, size=dim)
        delta_f = func(new_x) - best_f

        if delta_f < 0:
            best_x = new_x.copy()
            best_f = func(best_x)

        elif np.random.rand() < np.exp(-delta_f / (T * alpha)):
            best_x = new_x.copy()

        T *= cooling_rate

    return best_x
