def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 1
    x = np.array(rng.uniform(lb, ub, size=dim))
    best_x = np.copy(x)
    best_f = func(x)

    for _ in range(budget):
        x += np.random.normal(0, 0.01, size=dim)  # fixed learning rate
        x = np.clip(x, lb, ub)
        f = func(x)
        if f < best_f:
            best_x = np.copy(x)
            best_f = f

    return best_x
