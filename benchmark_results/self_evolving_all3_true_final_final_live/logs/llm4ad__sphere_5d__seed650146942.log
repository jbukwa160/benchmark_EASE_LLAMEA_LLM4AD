def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.array([0.1] * dim)
    f_best = func(x_best)
    
    for _ in range(budget):
        x_new = x_best + (ub - lb) * (np.random.rand(dim) - 0.5) / (1 + _/budget)
        
        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        
        if f_new < f_best:
            x_best = x_new
            f_best = f_new
    
    return x_best
