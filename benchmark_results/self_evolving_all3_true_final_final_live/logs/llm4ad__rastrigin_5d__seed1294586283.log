def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def func_wrapper(x):
        x = clip(x)
        return func(x)

    pop_size = 10 * (dim + 1)
    mu = pop_size / 2
    sigma = 0.5 * (ub - lb)
    mean = rng.uniform(lb, ub, size=dim)
    covar = np.eye(dim) * sigma ** 2

    for _ in range(budget):
        offspring = np.random.multivariate_normal(mean, covar, pop_size)

        fitness = np.array([func_wrapper(x) for x in offspring])
        idx = np.argsort(fitness)[:mu]

        selected_offspring = offspring[idx]
        new_mean = np.mean(selected_offspring, axis=0)
        covar_new = 1 / (1 + 1 / mu) * np.eye(dim)

        for i in range(pop_size):
            if i < mu:
                covar_new += np.outer(offspring[i] - new_mean, offspring[i] - new_mean)
            else:
                covar_new += np.linalg.inv(mu * np.eye(dim)) @ (offspring[i] - new_mean)[:, None] @ (offspring[i] - new_mean)

        covar = 1 / (mu + 1) * covar + 1 / (mu * (mu + 1)) * covar_new

        mean = new_mean
        sigma = np.sqrt(np.diag(covar)).mean()

    best_solution = clip(mean)
    return best_solution
