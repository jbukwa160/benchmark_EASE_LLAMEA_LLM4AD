def algorithm(func, dim, lb, ub, budget, rng):
    def log_pdf(x):
        return -func(x) / 10 + sum(np.log(1/np.pi))

    def gaussian_ellipse(x, mu, sigma):
        d = x - mu
        cov_inv = 1/sigma**2 * np.eye(dim)
        det_cov = np.linalg.det(cov_inv)
        inv_det_cov = np.linalg.inv(cov_inv)
        pdf = (1/(np.sqrt(det_cov) * np.sqrt(2*np.pi)**dim)) * \
              np.exp(-0.5 * d.T @ inv_det_cov @ d)
        return pdf

    def sample_gaussian_ellipse(mu, sigma):
        cov = sigma**2 * np.eye(dim)
        return mu + np.random.multivariate_normal(np.zeros(dim), cov)

    def importance_sample(func, log_pdf, num_samples=1000):
        samples = rng.uniform(lb, ub, (num_samples, dim))
        weights = [log_pdf(x) for x in samples]
        idx = rng.choice(num_samples, size=num_samples, replace=False, p=np.exp(weights)/np.sum(np.exp(weights)))
        sampled_x = samples[idx, :]
        return sampled_x

    def update_gmm(func, log_pdf, x_best, num_centers=5):
        centers = []
        for _ in range(num_centers):
            candidate = importance_sample(func, log_pdf)
            if len(centers) == 0 or np.mean(candidate) != np.mean(centers):
                centers.append(candidate)
        return centers

    def optimize_gmm(func, log_pdf, x_best, num_iter=10):
        for _ in range(num_iter):
            centers = update_gmm(func, log_pdf, x_best)
            x_sampled = []
            for c in centers:
                x_sampled.extend(importance_sample(func, log_pdf, num_samples=100))
            x_best = np.min(x_sampled, key=lambda x: func(x))

    x_best = rng.uniform(lb, ub, dim)
    optimize_gmm(func, log_pdf, x_best)
    return x_best
