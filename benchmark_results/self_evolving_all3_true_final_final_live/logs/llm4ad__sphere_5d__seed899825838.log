def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_y = func(x)

    T = 1.0
    cooling_rate = 0.99

    for _ in range(budget):
        y = clip(best_x + rng.randn(dim) * 0.01)
        y_prime = func(y)
        if y_prime < best_y:
            best_y = y_prime
            best_x = y.copy()
        elif np.random.rand() < np.exp(-(y_prime - best_y) / T):
            best_y = y_prime
            best_x = y.copy()

        T *= cooling_rate

    return best_x
