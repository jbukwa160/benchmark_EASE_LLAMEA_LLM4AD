def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    # Initialize with random points in bounds
    x = rng.uniform(lb, ub, size=(dim,))
    
    for _ in range(budget):
        # Evaluate the current point
        f_x = func(x)
        
        # Perform finite difference gradient estimation
        grad = np.zeros(dim)
        step_size = 1e-4
        for i in range(dim):
            x_plus_step = clip(x + step_size * np.eye(dim, k=i))
            x_minus_step = clip(x - step_size * np.eye(dim, k=i))
            grad[i] = (func(x_plus_step) - func(x_minus_step)) / (2.0 * step_size)
        
        # Update the current point
        alpha = 1e-3  # Learning rate
        x -= alpha * grad
        
    return clip(x)
