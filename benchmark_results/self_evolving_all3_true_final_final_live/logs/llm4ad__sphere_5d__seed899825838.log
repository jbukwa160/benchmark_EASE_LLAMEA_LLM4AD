def algorithm(func, dim, lb, ub, budget, rng):
    mu = 0 * np.ones(dim)
    sigma = 1e-3 + rng.uniform(0, 0.1, size=dim)
    best_so_far = np.inf
    best_x = None
    
    for _ in range(budget):
        z = rng.randn(dim) * sigma + mu
        
        # Clip candidates to [lb, ub]
        x = np.clip(z, lb, ub)
        
        f_x = func(x)
        
        if f_x < best_so_far:
            best_so_far = f_x
            best_x = x
            
        # Adapt step sizes using evolution strategy
        sigma *= 1 + rng.uniform(-0.05, 0.05, size=dim)
        
    return best_x
