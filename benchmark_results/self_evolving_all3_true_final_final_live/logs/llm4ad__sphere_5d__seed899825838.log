def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    N = int(budget)
    Lb = np.array([lb]*D)
    Ub = np.array([ub]*D)

    x_best = np.zeros(D)
    f_best = 1e10

    for i in range(N):
        x = rng.uniform(Lb, Ub)
        fx = func(x)
        
        if fx < f_best:
            f_best = fx
            x_best = x
        
        T = max(0.1, 1 - np.log(i+1)/np.log(N))
        step_size = 0.9 * (Ub - Lb) / N * T
        step_direction = rng.normal(size=D)
        
        while True:
            x_new = x_best + step_size * step_direction
            x_new = np.clip(x_new, Lb, Ub)
            
            fx_new = func(x_new)
            if fx_new < f_best:
                f_best = fx_new
                x_best = x_new
                
            if i > 0.1*N and rng.uniform(0, 1) > np.exp((f_best - fx_new)/T):
                break
            
            step_size *= 0.9

    return x_best
