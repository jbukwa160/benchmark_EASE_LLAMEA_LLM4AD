def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    max_iter = budget // pop_size
    best_sol = None
    best_val = float('inf')
    
    for _ in range(max_iter):
        x = rng.uniform(lb, ub, (pop_size, dim))
        
        for i in range(pop_size):
            y = np.copy(x[i])
            
            for j in range(dim):
                if rng.rand() < 0.1:
                    y[j] += rng.normal(0, 1)
                    
            y = clip(y, lb, ub)
            
            f_y = func(y)
            if f_y < func(x[i]):
                x[i] = y
                
        best_i = np.argmin([func(xi) for xi in x])
        
        if func(x[best_i]) < best_val:
            best_sol = x[best_i]
            best_val = func(x[best_i])
            
    return best_sol
