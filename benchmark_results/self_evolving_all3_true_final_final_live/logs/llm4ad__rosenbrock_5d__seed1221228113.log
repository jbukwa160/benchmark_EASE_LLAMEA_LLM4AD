def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    f = func
    x_min = -5
    x_max = 5
    c1 = 0.5
    c2 = 0.3
    F = 0.8

    def clip(x):
        return np.clip(x, lb, ub)

    def local_search(x_best):
        for _ in range(1000):
            x_try = x_best + rng.uniform(-1e-6, 1e-6) * rng.normal(size=dim)
            try:
                if f(x_try) < f(x_best):
                    return clip(x_try)
            except OverflowError:
                pass
        return clip(x_best)

    def differential_evolution():
        x = np.random.uniform(lb, ub, size=(pop_size, dim))
        for _ in range(budget - 1):
            u, v = rng.randint(0, pop_size, size=2), rng.randint(0, pop_size, size=1)
            trial_x = clip(x[u] + F * (x[v] - x[u]))
            if f(trial_x) < f(x[u]):
                x[u] = trial_x
        return clip(np.array([f(x_) for x_ in x]).argmin())

    def hybrid_algorithm():
        x_best = differential_evolution()
        best_f = f(x_best)
        new_best = local_search(x_best)
        if f(new_best) < best_f:
            x_best = new_best
        return x_best

    x_best = hybrid_algorithm()
    return x_best
