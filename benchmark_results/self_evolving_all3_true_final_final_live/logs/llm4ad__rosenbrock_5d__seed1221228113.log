def algorithm(func, dim, lb, ub, budget, rng):
    def bounds_transform(x):
        return np.clip(np.array(x), a_min=lb, a_max=ub)

    x = np.random.uniform(lb, ub, size=(1, dim))
    best_x = bounds_transform(x)
    best_f = func(best_x)

    for _ in range(budget-1):
        x_new = x.copy()
        for i in range(dim):
            r1 = rng.randint(0, x.shape[0])
            r2 = rng.randint(0, x.shape[0])

            while r1 == r2:
                r2 = rng.randint(0, x.shape[0])

            v = 0.5 * (x[r1] + x[r2]) + rng.uniform(-1, 1)
            x_new[i] = v

        x_new = bounds_transform(x_new)

        if func(x_new) < best_f:
            best_x = x_new
            best_f = func(best_x)

        x = np.vstack((x, x_new))

    return best_x[0]
