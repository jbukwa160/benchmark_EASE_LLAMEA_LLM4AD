def algorithm(func, dim, lb, ub, budget, rng):
    def bounded(x):
        return np.clip(x, lb, ub)

    def surrogate(x):
        return func(x) + 1e-10  # Add a small value to avoid division by zero

    best = bounded(rng.uniform(lb, ub, size=dim))
    best_f = surrogate(best)
    budget -= dim
    for i in range(budget):
        mean, var = gaussian_process.predict(np.array([best]))
        std = np.sqrt(var)
        proposal = best + rng.normal(0, std, size=dim)
        proposal = bounded(proposal)
        proposal_f = surrogate(proposal)
        if proposal_f < best_f:
            best = proposal
            best_f = proposal_f
    return best
