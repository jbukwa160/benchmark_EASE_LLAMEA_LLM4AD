def algorithm(func, dim, lb, ub, budget, rng):
    X = rng.uniform(lb, ub, (budget, dim))
    Y = func(X)

    sigma0 = 1e-6
    sigma = 2 * sigma0
    T = 1e10
    schedule = lambda t: T * np.exp(-t / budget)
    best_X = X[np.argmin(Y)]
    best_Y = np.min(Y)

    for i in range(budget):
        x_new = X[i] + rng.normal(0, sigma, dim)
        y_new = func(np.clip(x_new, lb, ub))

        delta = y_new - best_Y
        t = schedule(i)

        if (delta < 0) or (rng.uniform(0, 1) < np.exp(-delta / t)):
            X[i] = x_new
            Y[i] = y_new

            if delta < 0:
                best_X = x_new
                best_Y = y_new

    return best_X
