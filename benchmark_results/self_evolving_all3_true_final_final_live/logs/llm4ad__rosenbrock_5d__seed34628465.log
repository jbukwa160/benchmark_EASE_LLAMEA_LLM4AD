def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_x = np.random.uniform(lb, ub, size=dim)
    best_y = func(best_x)

    for _ in range(budget):
        x = np.copy(best_x)
        y = best_y

        # Simulated Annealing
        delta = rng.uniform(-1.0, 1.0)
        x += delta * (ub - lb) / 2
        x = clip(x)
        y_new = func(x)

        if y_new < y:
            best_x = np.copy(x)
            best_y = y_new

        # Differential Evolution
        p1 = rng.uniform(lb, ub, size=dim)
        p2 = rng.uniform(lb, ub, size=dim)
        v = 0.5 * (p1 + p2) - x
        x += v
        x = clip(x)
        y_new = func(x)

        if y_new < best_y:
            best_x = np.copy(x)
            best_y = y_new

    return best_x
