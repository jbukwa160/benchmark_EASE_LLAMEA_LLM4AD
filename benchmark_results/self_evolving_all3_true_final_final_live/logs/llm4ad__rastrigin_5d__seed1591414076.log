def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)
    T = 1000.0
    cooling_rate = 0.99

    for i in range(budget):
        # DE phase
        v = x + rng.normal(size=dim) * 0.1
        v = np.clip(v, lb, ub)

        # SA phase
        f_v = func(v)
        if f_v < best_f:
            best_x = v.copy()
            best_f = f_v

        # Accept worse solution with probability based on temperature
        if f_v > best_f:
            delta = f_v - best_f
            prob = np.exp(-delta / T)
            r = rng.uniform(0, 1)
            if r < prob:
                x = v.copy()
                best_x = v.copy()
                best_f = f_v

        # Cool down temperature
        T *= cooling_rate

    return best_x
