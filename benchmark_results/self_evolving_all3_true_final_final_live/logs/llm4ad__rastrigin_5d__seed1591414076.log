def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 1.0
    mu = np.zeros(dim)
    cov_mat = np.eye(dim)
    t_max = int(budget / (2 * dim))
    t = 0
    best_x = np.zeros(dim)
    best_f = float('inf')

    while t < t_max and budget > 0:
        budget -= 1

        # Step size adaptation using CMA-ES
        new_cov_mat, cov_mat = cma_es_step(cov_mat, sigma, rng)

        # Sampling from multivariate normal distribution
        x = np.random.multivariate_normal(mu, new_cov_mat)

        # Clip candidates to bounds
        x = np.clip(x, lb, ub)

        # Evaluate function at sampled point
        f = func(x)

        # Update best solution and parameters if necessary
        if f < best_f:
            best_x = x.copy()
            best_f = f

        # Simulated Annealing update
        t += 1
        acceptance_prob = np.exp(-((f - best_f) / (t ** 0.5)))
        if rng.uniform(0, 1) > acceptance_prob:
            mu = best_x

    return best_x
