def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    pop_size = 100
    sigma = 0.5
    mu = np.zeros(D)
    cov = np.eye(D) * 1e-4
    best_sol = None
    best_fval = np.inf

    for _ in range(budget):
        X = rng.normal(mu, cov**0.5, (pop_size, D))
        X = np.clip(X, lb, ub)
        
        fvals = func(X)

        if np.any(fvals < best_fval):
            idx = np.argmin(fvals)
            mu = X[idx]
            best_sol = mu
            best_fval = fvals[idx]

        cov = (1 - 0.01) * cov + 0.01 * (np.eye(D) * np.var(X, axis=0))

        # Adaptive step size using Cauchy distribution for exploration
        sigma_new = max(1e-4, min(1e2, 1 / (1 + np.mean(np.linalg.norm(X - mu, axis=1)))))

        sigma *= np.random.uniform(0.9, 1.1)
        if rng.rand() < 0.01:
            sigma = sigma_new

    return best_sol
