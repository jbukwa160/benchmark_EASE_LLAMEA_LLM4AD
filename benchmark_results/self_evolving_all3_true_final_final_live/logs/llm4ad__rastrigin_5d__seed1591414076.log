def algorithm(func, dim, lb, ub, budget, rng):
    def simulate_anneal(x, T, alpha):
        x_new = x + 0.1 * (ub - lb) * np.random.randn(dim)
        x_new = np.clip(x_new, lb, ub)
        delta = func(x_new) - func(x)
        if delta < 0 or rng.rand() < np.exp(-delta / T):
            return x_new
        else:
            return x

    def adaptation(x, dim, lb, ub):
        for i in range(dim):
            if rng.rand() < 0.1 and x[i] != lb and x[i] != ub:
                x[i] = (x[i] - lb) / (ub - lb)
        return x

    best_x = np.zeros(dim)
    best_val = float('inf')
    T = 100
    alpha = 0.99
    for _ in range(budget):
        x = adaptation(best_x, dim, lb, ub)
        for _ in range(int(1e4)):
            x_new = simulate_anneal(x, T, alpha)
            if func(x_new) < best_val:
                best_x = x_new
                best_val = func(x_new)
        T *= alpha

    return best_x
