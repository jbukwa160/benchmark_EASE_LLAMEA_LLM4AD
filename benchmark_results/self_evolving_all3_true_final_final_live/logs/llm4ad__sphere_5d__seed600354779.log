def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_y = float('inf')
    
    for i in range(budget):
        x = np.clip(lb + (ub - lb) * rng.uniform(size=dim), a_min=lb, a_max=ub)
        
        # Add Gaussian noise to the candidate
        x_noisy = x + 0.1 * rng.normal(size=dim)
        
        # Clip noisy candidate to bounds
        x_noisy = np.clip(x_noisy, a_min=lb, a_max=ub)
        
        y = func(x_noisy)
        
        if y < best_y:
            best_x = x_noisy
            best_y = y
    
    return best_x
