def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    bounds = [(lb, ub)] * n
    init_dist = 'uniform'
    
    if budget < 10:
        # If budget is low, use a simpler strategy for exploration-exploitation trade-off
        acquisition_func_name = 'lower_bound'
    else:
        # For larger budgets, use an adaptive epsilon-greedy strategy with a probability of exploitation that decreases as the budget increases
        acquisition_func_name = 'adaptive_epsilon_greedy'
    
    init_points = 10 * n
    
    def lower_bound(x):
        return np.sum(func(x))
    
    def adaptive_epsilon_greedy(x, f_x, best_f):
        epsilon = max(1e-2 - (budget - 10) / (n ** 3), 0)
        if rng.uniform(0, 1) < epsilon:
            return -np.inf
        else:
            return -f_x
    
    def objective(x):
        return func(x)
    
    best_f = np.inf
    for i in range(budget):
        x_init = rng.uniform(lb, ub, size=n)
        
        if acquisition_func_name == 'lower_bound':
            acq = lower_bound(x_init)
        else:
            acq = adaptive_epsilon_greedy(x_init, objective(x_init), best_f)
        
        x_next = rng.uniform(bounds[0][0], bounds[0][1])
        for j in range(1, n):
            if rng.uniform(0, 1) < 0.5:
                x_next = np.insert(x_next, j, rng.uniform(bounds[j][0], bounds[j][1]))
        
        # Use an adaptive epsilon-greedy strategy to choose between exploration and exploitation
        x = x_init if acquisition_func_name == 'lower_bound' else x_next
        
        f_x = func(x)
        best_f = min(best_f, f_x)
        
        print(f"Step {i+1}, Best function value: {best_f}")
    
    return np.array([0.0] * n)
