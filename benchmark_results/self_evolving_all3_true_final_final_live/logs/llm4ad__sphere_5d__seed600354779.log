def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.array([0.] * dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        if func(x) < best_f:
            best_x = x
            best_f = func(x)
            
        x += np.random.normal(size=(dim,))
        x = (x - lb) / (ub - lb) * 2 * np.pi - np.pi
        
        x = lb + (ub - lb) * (np.tanh(x) + 1) / 2
        x = np.clip(x, lb, ub)
        
        if func(x) < best_f:
            best_x = x
            best_f = func(x)
            
    return best_x
