def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_candidate = clip(np.random.uniform(lb, ub, size=dim))
        f_candidate = func(x_candidate)

        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate

        # local refinement
        if rng.rand() < 0.1 and f_candidate < 0.9 * f_best:  # 10% chance of refining
            step_size = 0.01 * (ub - lb)
            for i in range(dim):
                x_refine = clip(x_candidate + np.random.uniform(-step_size, step_size, size=dim))
                f_refine = func(x_refine)

                if f_refine < f_best:
                    x_best = x_refine
                    f_best = f_refine

    return x_best
