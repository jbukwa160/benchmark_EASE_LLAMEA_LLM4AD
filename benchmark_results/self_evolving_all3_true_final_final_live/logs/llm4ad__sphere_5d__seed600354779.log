def algorithm(func, dim, lb, ub, budget, rng):
    bounds = (np.ones(dim) * lb, np.ones(dim) * ub)
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    for _ in range(budget):
        x_new = np.clip(np.random.uniform(*bounds), *rng)
        f_new = func(x_new)
        
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
            
        # Focus on promising regions by sampling around the current best solution
        bounds = (x_best - 0.1, x_best + 0.1)
        bounds = (np.maximum(bounds[0], lb), np.minimum(bounds[1], ub))
        
    return x_best
