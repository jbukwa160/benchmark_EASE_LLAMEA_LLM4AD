def algorithm(func, dim, lb, ub, budget, rng):
    def clipped_bounds(bounds, x):
        return [max(min(x[i], bounds[1][i]), bounds[0][i]) for i in range(dim)]

    def fitness(x):
        return func(x)

    bounds = [(lb, ub) for _ in range(dim)]
    
    de_res = differential_evolution(fitness, bounds, maxiter=int(budget/4), 
                                    x0=np.random.uniform(lb, ub, size=(dim)), strategy='rand1exp', mutation=0.5)
    
    lbfgs_bounds = [(lb, ub) for _ in range(dim)]
    lbfgs_res = minimize(fitness, de_res.x, method="L-BFGS-B", bounds=lbfgs_bounds)
    
    clipped_de_res = differential_evolution(fitness, bounds, maxiter=int(budget/4), 
                                             x0=np.random.uniform(lb, ub, size=(dim)), strategy='rand1exp', mutation=0.5)
    
    if clipped_de_res.fun < de_res.fun:
        de_res.x = clipped_bounds(bounds, de_res.x)
        
    if lbfgs_res.fun < de_res.fun:
        de_res.x = lbfgs_res.x
        
    return np.array(de_res.x)
