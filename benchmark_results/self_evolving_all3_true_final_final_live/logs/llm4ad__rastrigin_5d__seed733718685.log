def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    population = rng.uniform(lb, ub, (budget, dim))
    for _ in range(budget - 1):
        scores = [func(clip(x)) for x in population]
        best_idx = np.argmin(scores)
        best_x = clip(population[best_idx])
        candidates = []
        for i in range(dim):
            x1, x2, x3 = rng.choice(population, 3, replace=False)
            x1, x2, x3 = clip(x1), clip(x2), clip(x3)
            f1, f2, f3 = func(clip(x1)), func(clip(x2)), func(clip(x3))
            candidate = x1 + rng.uniform(-1, 1) * (x2 - x1)
            candidates.append(candidate)
        for i in range(dim):
            x = np.array([candidates[j][i] if j != dim else rng.uniform(lb, ub) 
                          for j in range(budget)])
            f = func(clip(x))
            scores = np.append(scores, f)
            population = np.vstack((population, x))
    best_idx = np.argmin(np.array([func(clip(x)) for x in population]))
    return clip(population[best_idx])
