def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.zeros(dim)
    best_x = x.copy()
    best_f = float('inf')
    
    T0 = 1.0
    tau = 0.99
    alpha = 1e-6
    
    for _ in range(budget):
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x.copy()
        
        r = rng.uniform(0, 1)
        s = rng.normal(size=dim) * alpha
        
        new_x = clip(x + s)
        
        delta = func(new_x) - f
        
        if delta < 0 or np.exp(-delta / T0) > r:
            x = new_x
            
        T0 *= tau
    
    return best_x
