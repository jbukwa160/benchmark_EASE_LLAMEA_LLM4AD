def algorithm(func, dim, lb, ub, budget, rng):
    def sample_candidate(lb, ub):
        return [np.clip(rng.uniform(lb, ub), lb, ub) for _ in range(dim)]

    best_x = None
    best_f = float('inf')
    adjusted_bounds = [(lb + 0.5 * (ub - lb)) if i == dim-1 else (lb + 0.2 * (ub - lb)) for i in range(dim)]
    
    for _ in range(budget):
        candidate = sample_candidate(adjusted_bounds)
        
        f = func(candidate)
        
        if f < best_f:
            best_x = candidate
            best_f = f
        
        if np.random.rand() < 0.1: # 10% chance to adjust bounds
            adjusted_bounds = [max(lb, min(c, ub)) for c in candidate]
    
    return np.array(best_x)
