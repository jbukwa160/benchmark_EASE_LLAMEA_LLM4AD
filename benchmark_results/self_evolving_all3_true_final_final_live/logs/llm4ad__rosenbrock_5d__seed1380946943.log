def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(n, dim, lb, ub):
        return lb + (ub - lb) * rng.rand(n, dim)

    def clip_to_bounds(population, lb, ub):
        return np.clip(population, lb, ub)

    def evaluate_population(func, population):
        return func(population)

    def update_temperature(initial_temp, cooling_rate, iteration):
        return initial_temp * np.exp(-cooling_rate * iteration)

    def select_best_individual(population, fitnesses, best_individual_so_far):
        indices = np.argsort(fitnesses)
        new_best_individual = population[indices[0]]
        if func(new_best_individual) < func(best_individual_so_far):
            return new_best_individual
        else:
            return best_individual_so_far

    def differential_evolution(population, fitnesses, bounds, mutation_rate, crossover_probability):
        n = len(population)
        new_population = np.zeros((n, dim))
        for i in range(n):
            random_indices = rng.choice(n, 3, replace=False)
            trial_solution = population[random_indices[0]] + \
                              mutation_rate * (population[random_indices[1]] - 2*population[random_indices[2]]) + \
                              crossover_probability * (bounds[1] - bounds[0]) * rng.rand(dim)
            new_population[i] = np.clip(trial_solution, bounds[0], bounds[1])
        return evaluate_population(func, new_population), new_population

    def simulated_annealing(initial_temperature, cooling_rate, initial_population, initial_fitnesses):
        population = clip_to_bounds(initial_population, lb, ub)
        temperature = update_temperature(initial_temperature, cooling_rate, 0)
        best_individual_so_far = population[0]
        for iteration in range(1, budget + 1):
            fitnesses = evaluate_population(func, population)
            new_best_individual = select_best_individual(population, fitnesses, best_individual_so_far)
            if func(new_best_individual) < func(best_individual_so_far):
                best_individual_so_far = new_best_individual
            temperature = update_temperature(initial_temperature, cooling_rate, iteration)
            if rng.rand() < np.exp((func(best_individual_so_far) - func(new_best_individual)) / temperature):
                population[i] = new_best_individual
        return evaluate_population(func, population), population

    initial_population = generate_initial_population(1000, dim, lb, ub)
    initial_fitnesses, _ = evaluate_population(func, initial_population)

    _, final_population = simulated_annealing(1e6, 1e-5, clip_to_bounds(initial_population, lb, ub), initial_fitnesses)
    best_individual_so_far = select_best_individual(final_population, initial_fitnesses, np.zeros(dim))
    return best_individual_so_far
