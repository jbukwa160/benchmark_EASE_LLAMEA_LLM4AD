def algorithm(func, dim, lb, ub, budget, rng):
    best_candidate = None
    best_value = float('inf')

    for i in range(int(np.ceil((ub - lb) / (ub - lb) * rng))):
        candidate = np.linspace(lb, ub, int(np.ceil((ub - lb) / (ub - lb) * rng)))[i]
        candidate = np.full(dim, candidate)

        value = func(candidate)
        
        if value < best_value:
            best_candidate = candidate
            best_value = value

    return best_candidate
