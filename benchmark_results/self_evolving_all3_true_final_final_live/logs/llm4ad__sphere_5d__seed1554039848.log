def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x0 = rng.uniform(lb, ub, size=dim)
    best_x = x0.copy()
    best_f = func(x0)

    for i in range(budget):
        candidate = rng.normal(size=dim) * 2.0 + rng.uniform(-1.0, 1.0, size=dim)
        candidate = clip(candidate)
        f = func(candidate)

        if f < best_f:
            best_x = candidate.copy()
            best_f = f

    return best_x
