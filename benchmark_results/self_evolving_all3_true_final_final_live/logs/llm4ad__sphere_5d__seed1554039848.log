def algorithm(func, dim, lb, ub, budget, rng):
    best = np.inf * np.ones(dim)
    for _ in range(budget):
        x = np.zeros(dim)
        for i in range(dim):
            x[i] = np.random.normal(0, 1)
            while not (lb <= x[i] <= ub):
                x[i] = np.random.uniform(lb, ub)
        f_x = func(x)
        if f_x < best[-1]:
            best = x
    return best
