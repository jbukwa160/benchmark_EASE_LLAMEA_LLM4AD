def algorithm(func, dim, lb, ub, budget, rng):
    def clip(c):
        return np.clip(c, lb, ub)

    x = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)
    
    num_successes = 0
    total_mutations = 0
    
    for _ in range(budget):
        if rng.rand() < 0.5:
            # Perturb one dimension of the current solution
            i = rng.choice(dim)
            step_size = rng.uniform(-1, 1)
            new_x = x.copy()
            new_x[i] += step_size
            new_x = clip(new_x)
            new_f = func(new_x)
            
            if new_f < best_f:
                best_x = new_x.copy()
                best_f = new_f
                num_successes = 0
            else:
                total_mutations += 1
                
        else:
            # Generate a completely new solution
            new_x = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
            new_x = clip(new_x)
            new_f = func(new_x)
            
            if new_f < best_f:
                best_x = new_x.copy()
                best_f = new_f
                num_successes = 0
                
        total_mutations += 1
        
        # Adapt the probability of mutation based on recent successes
        p_mutation = max(0.01, min(0.99, (num_successes / total_mutations) ** 2))
        
    return best_x
