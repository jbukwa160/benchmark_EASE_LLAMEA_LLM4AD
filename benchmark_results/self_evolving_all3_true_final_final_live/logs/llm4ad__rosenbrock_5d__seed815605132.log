def algorithm(func, dim, lb, ub, budget, rng):
    def clipped(x):
        return np.clip(x, lb, ub)

    def objective(x):
        return func(clipped(x))

    def de_objective(x, y):
        diff = x - y
        return 0.5 * np.dot(diff, diff) + objective(x)

    def sa_objective(x):
        return objective(x)

    pop_size = int(1e4)
    init_pop = rng.uniform(lb, ub, (pop_size, dim))
    best = None

    for _ in range(budget):
        for i in range(pop_size):
            x1, x2 = init_pop[i], init_pop[(i + 1) % pop_size]
            offspring = x1 + rng.uniform(-5.0, 5.0) * (x2 - x1)
            diff = np.dot(rng.uniform(-5.0, 5.0), [1 if j == i else 0 for j in range(dim)])
            mutant = init_pop[i] + diff
            mutant = clipped(mutant)

            # Simulated Annealing component
            temperature = 1000
            sa_offspring = mutant
            while objective(sa_offspring) < objective(x1):
                sa_offspring = x1 + rng.uniform(-5.0, 5.0) * (x2 - x1)
                sa_offspring = clipped(sa_offspring)

            # Differential Evolution component
            de_mutant = mutant
            if rng.random() > 0.9:
                for j in range(dim):
                    de_mutant[j] += np.dot(rng.uniform(-5.0, 5.0), [1 if k == j else 0 for k in range(dim)])
                de_mutant = clipped(de_mutant)

            # Combine DE and SA
            offspring = sa_offspring if objective(sa_offspring) < objective(offspring) else offspring
            offspring = de_mutant if objective(de_mutant) < objective(offspring) else offspring

            init_pop[i] = offspring

        best = np.argmin([objective(x) for x in init_pop])

    return init_pop[best]
