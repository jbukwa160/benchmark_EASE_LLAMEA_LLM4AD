def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    init_budget = int(0.1 * budget)
    initialisations = np.random.uniform(lb, ub, size=(init_budget, dim))

    for _ in range(init_budget):
        best_candidate = initialisations[_]
        best_func_value = func(best_candidate)
        
        for _ in range(budget - init_budget):
            candidate = clip(np.random.normal(loc=best_candidate, scale=0.1))
            
            if rng.uniform(0, 1) < 0.05:
                new_candidate = np.clip(candidate + np.random.normal(size=dim), lb, ub)
            else:
                gradient = np.zeros(dim)
                for i in range(dim-1):
                    gradient[i] += 2*100*(candidate[i+1]-candidate[i]**2)*(-2*candidate[i])
                    gradient[i+1] -= 2
                new_candidate = candidate + 0.01 * gradient
            
            func_value = func(new_candidate)
            
            if func_value < best_func_value:
                best_candidate = new_candidate
                best_func_value = func_value
                
    return best_candidate
