def algorithm(func, dim, lb, ub, budget, rng):
    D = len(lb)
    X = rng.uniform(ub - 1e-3, ub, (budget, D))
    Y = np.zeros(budget)
    for i in range(budget):
        x = X[i]
        y = func(x)
        X[i] = np.clip(x, lb, ub)
        Y[i] = y
        gp = np.array([[Y[:i+1]]])
        K = np.eye(i+1)
        mu = np.zeros((D,))
        sigma2 = 1e-4 + (y - np.dot(mu, X[:i]))
        while i < budget:
            x_new = np.clip(rng.normal(loc=mu, scale=sigma2, size=(1,D)), lb, ub)
            y_new = func(x_new[0])
            gp = np.vstack([gp, [y_new]])
            X[i+1] = np.clip(x_new[0], lb, ub)
            Y[i+1] = y_new
            i += 1
    idx = np.argmax(Y)
    return X[idx]
