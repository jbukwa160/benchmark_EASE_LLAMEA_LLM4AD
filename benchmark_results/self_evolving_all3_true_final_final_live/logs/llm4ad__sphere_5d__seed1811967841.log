def algorithm(func, dim, lb, ub, budget, rng):
    init = [np.random.uniform(lb, ub) for _ in range(dim)]
    best = init.copy()
    simplex_size = 10 + (dim - 1) * 2

    for i in range(budget):
        new_simplex = []
        for j in range(simplex_size):
            if j < dim:
                x = best[j]
                noise = rng.uniform(-1, 1)
                x_new = np.clip(x + noise, lb, ub)
                new_simplex.append(x_new)
            else:
                x = [best[k] + (np.random.choice([-1, 1]) * rng.uniform(0.01, 0.1)) for k in range(dim)]
                x = np.array(x)
                x = np.clip(x, lb, ub)
                new_simplex.append(x)

        fitness_new = [func(new_x) for new_x in new_simplex]

        if np.all(np.array(fitness_new) > func(best)):
            best = new_simplex[np.argmin(fitness_new)].copy()
        else:
            idx_sort = np.argsort(fitness_new)
            sorted_fitness = np.sort(fitness_new)

            if (sorted_fitness < func(best)).all():
                best = new_simplex[idx_sort[0]].copy()

    return np.array(best)
