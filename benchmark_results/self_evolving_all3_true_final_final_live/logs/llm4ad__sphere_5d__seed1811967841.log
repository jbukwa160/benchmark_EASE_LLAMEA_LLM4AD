def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n = 10 * D  # population size
    mu = int(n / 2)  # number of parents
    sigma = (ub - lb) / 3.0
    C = np.eye(D)
    dC = np.zeros((D, D))

    for _ in range(budget):
        X = rng.uniform(lb, ub, size=(n, D))
        F = func(X)

        # selection
        idx = np.argsort(F)[:mu]

        # recombination
        muX = X[idx]
        w = 1.0 / (1 + F[idx] - F[idx[0]])
        w /= w.sum()
        muX = (muX.T * w).T

        # mutation
        Cn = np.linalg.cholesky(C)
        dCn = np.linalg.cholesky(dC)

        Xn = muX + sigma * (np.eye(D) @ Cn)[:, None] @ rng.randn(n, D)

        # clip to bounds
        for i in range(n):
            Xn[i] = np.clip(Xn[i], lb, ub)

        # update step-size and covariance matrix
        s = sigma * rng.randn(D)
        Fm = func(muX + s)
        if Fm < F[0]:
            sigma *= 1.01
            dC += (s ** 2)[:, None]
            for i in range(n):
                C += Xn[i, :] @ Xn[i, :].T

    return muX
