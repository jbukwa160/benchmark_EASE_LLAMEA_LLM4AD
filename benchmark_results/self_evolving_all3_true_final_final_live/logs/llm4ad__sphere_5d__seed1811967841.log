def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 10 * dim
    sigma = (ub - lb) / 2
    x_best = rng.uniform(lb, ub, size=dim)
    for _ in range(budget):
        y = rng.normal(size=pop_size, loc=x_best, scale=sigma)
        y = np.clip(y, lb, ub)
        f_y = func(y)
        indices = np.argsort(f_y)[:pop_size//2]
        x_best = y[indices].mean(axis=0)
    return x_best
