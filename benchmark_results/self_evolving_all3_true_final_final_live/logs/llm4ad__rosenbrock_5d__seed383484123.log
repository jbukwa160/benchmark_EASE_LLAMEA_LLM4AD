def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        c1, c2, c3 = rng.uniform(0.5, 1.5), rng.uniform(-0.5, 0.5), rng.uniform(-0.01, 0.01)
        x_candidate = (x + c1 * np.random.uniform(lb, ub, size=dim)) / 2
        x_candidate = x_candidate + c2 * (best_x - x) + c3 * np.random.uniform(-1e-3, 1e-3, size=dim)
        
        f_candidate = func(x_candidate)

        if f_candidate < best_f:
            best_x, best_f = x_candidate.copy(), f_candidate

        if rng.rand() < 0.05:
            gradient = np.zeros(dim)
            for j in range(dim):
                eps = 1e-6
                x_eps = x + eps * np.eye(dim)[j]
                f_eps = func(x_eps)

                gradient[j] = (f_eps - best_f) / eps

            step_size = 0.5 * rng.uniform(1e-2, 1e-1)
            for j in range(dim):
                x_candidate = best_x + step_size * gradient[j]
                f_candidate = func(x_candidate)

                if f_candidate < best_f:
                    best_x, best_f = x_candidate.copy(), f_candidate

        x = np.clip(best_x, lb, ub)

    return best_x
