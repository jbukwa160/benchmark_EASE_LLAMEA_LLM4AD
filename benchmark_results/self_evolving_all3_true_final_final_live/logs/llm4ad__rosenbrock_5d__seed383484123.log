def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return func(np.array([1.0] + list(x)))

    def rand(xmin, xmax):
        return (xmax - xmin) * rng.rand() + xmin

    def clip(x, lb, ub):
        return np.clip(x, a_min=lb, a_max=ub)

    def acceptance_probability(current_best, new_solution, T):
        if new_solution < current_best:
            return 1
        else:
            return np.exp((current_best - new_solution) / T)

    def simulated_annealing(bounds, budget, rng, objective_func):
        x = [rand(*bounds[i]) for i in range(dim)]
        best_x = x[:]
        best_obj = objective_func(x)
        
        T = 1.0
        cooling_rate = 0.99
        
        for _ in range(budget):
            new_x = []
            for j in range(dim):
                delta = rng.uniform(-1, 1)
                new_x_j = x[j] + delta
                new_x_j = clip(new_x_j, bounds[j][0], bounds[j][1])
                new_x.append(new_x_j)
            
            new_obj = objective_func(np.array([1.0] + new_x))
            
            if rng.rand() < acceptance_probability(best_obj, new_obj, T):
                x = new_x
                best_obj = new_obj
            
            T *= cooling_rate
        
        return np.array(x)

    def differential_evolution(bounds, budget, rng, objective_func):
        pop_size = 50
        population = [[rand(*bounds[i]) for i in range(dim)] for _ in range(pop_size)]
        
        for _ in range(budget):
            for i in range(pop_size):
                # Mutation
                mutant_i = [population[j] for j in rng.choice(pop_size, size=3, replace=False)][0]
                
                # Crossover
                trial_i = [mutant_i[k] if rng.rand() < 0.5 else population[i][k] for k in range(dim)]
                
                # Selection
                if objective_func(np.array([1.0] + list(trial_i))) < objective_func(np.array([1.0] + list(population[i]))):
                    population[i] = trial_i
        
        return population[np.argmin([objective_func(np.array([1.0] + list(x))) for x in population])]

    bounds = [[lb, ub]] * dim
    bounds.insert(0, [-5.0, 5.0])

    x_sa = simulated_annealing(bounds, budget // 2, rng, Rosenbrock)
    x_de = differential_evolution(bounds, budget - (budget // 2), rng, Rosenbrock)

    return np.array(x_de[:dim])
