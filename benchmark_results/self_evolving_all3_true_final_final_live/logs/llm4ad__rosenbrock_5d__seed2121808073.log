def algorithm(func, dim, lb, ub, budget, rng):
    N = 20 + int(np.ceil(np.log(budget)))
    sigma0 = 1.5 * (ub - lb) / N
    lambda_ = N / (N - 1)
    cov = np.eye(dim)
    
    x = rng.uniform(lb, ub, size=dim)
    f_x = func(x)
    best_x = x.copy()
    best_f = f_x
    
    for n in range(N):
        while True:
            u = np.random.normal(size=dim)
            y = x + lambda_ * sigma0 * u
            y = np.clip(y, lb, ub)
            
            if rng.rand() < 1 - (n / N)**(3/2):
                f_y = func(y)
                if f_y < best_f:
                    best_x = y.copy()
                    best_f = f_y
                x = y
                break
            
            cov_update = np.outer(u, u) + lambda_ * np.eye(dim)
            cov += cov_update / (n + 1)
            
            sigma2 = rng.gamma(1, 0.01) + 1e-6
            new_sigma = sigma0 * np.sqrt(sigma2)
            y = x + new_sigma * np.dot(np.linalg.cholesky(cov), rng.normal(size=dim))
            y = np.clip(y, lb, ub)
            
            f_y = func(y)
            if f_y < best_f:
                best_x = y.copy()
                best_f = f_y
            elif rng.rand() < (n / N)**(3/2):
                x = y
    
    return best_x
