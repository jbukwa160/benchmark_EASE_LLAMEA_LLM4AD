def algorithm(func, dim, lb, ub, budget, rng):
    N = 20  # population size
    F = 1.0  # differential evolution factor
    CR = 0.9  # crossover rate
    best_x = lb + (ub - lb) * rng.rand(dim)
    best_y = func(best_x)

    for _ in range(budget):
        x = np.zeros((N, dim))
        y = np.zeros(N)
        
        for i in range(N):
            x[i] = lb + (ub - lb) * rng.rand(dim)
            
            if i > 0:
                d1 = F * (x[i-1] - best_x)
                d2 = F * (x[i-1] - x[(i-1)%N])
                x[i] += d1 + d2
            y[i] = func(x[i])

        indices = np.argsort(y)[:int(N/3)]
        parents = x[indices]

        for i in range(N):
            u = rng.randint(0, N)
            v = rng.randint(0, N)

            if rng.rand() < CR or (x[i] == parents[u]).all():
                c = parents[u] + F * (parents[v] - parents[u])
            else:
                c = x[i]

            l = lb + (ub - lb) * rng.rand(dim)
            candidate = 0.5 * (c + l)

            if func(candidate) < y[i]:
                x[i] = candidate
                y[i] = func(x[i])

        best_idx = np.argmin(y)
        best_x = x[best_idx]
        best_y = y[best_idx]

    return best_x
