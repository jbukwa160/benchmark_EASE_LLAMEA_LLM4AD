def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_f = float('inf')
    
    for _ in range(100): # number of random restarts
        x = rng.uniform(lb, ub, size=dim)
        
        for t in range(budget):
            dx = rng.normal(loc=0, scale=1e-2, size=dim)  # small step size
            new_x = x + dx
            
            # clip candidates to [lb, ub]
            new_x = np.clip(new_x, lb, ub)
            
            new_f = func(new_x)
            if new_f < best_f:
                best_f = new_f
                best_x = new_x
                
    return best_x
