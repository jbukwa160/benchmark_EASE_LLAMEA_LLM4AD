def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    T = 1000.0
    alpha = 0.99
    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(best_x)
    
    for _ in range(budget):
        x = clip(np.copy(best_x) + rng.normal(size=dim), lb, ub)
        
        f = func(x)
        
        delta = f - best_f
        
        if delta < 0 or (delta >= 0 and np.random.rand() < np.exp(-delta/T)):
            best_x = x
            best_f = f
            
        T *= alpha
            
    return best_x
