def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lower_bound, upper_bound):
        return np.clip(candidate, lower_bound, upper_bound)

    def differential_evolution(func, bounds, population_size=10, mutation_factor=0.5, crossover_probability=0.7):
        bounds = [(lb[i], ub[i]) for i in range(dim)]
        candidates = rng.uniform(lb, ub, (population_size, dim))
        fitnesses = np.array([func(candidate) for candidate in candidates])

        while True:
            for i in range(population_size):
                difference = candidates[np.random.choice(range(population_size), size=3)] - candidates[i]
                mutation = np.dot(mutation_factor * rng.uniform(-1, 1, (dim)), difference)
                crossover = candidates[i] + rng.binomial(1, crossover_probability) * mutation
                candidate_new = clip(crossover, lb, ub)
                fitness_new = func(candidate_new)

                if fitness_new < fitnesses[i]:
                    candidates[i] = candidate_new
                    fitnesses[i] = fitness_new

            yield {'candidates': candidates, 'fitnesses': fitnesses}

    def simulated_annealing(func, bounds, initial_temperature=1000, cooling_rate=0.99):
        current_candidate = rng.uniform(lb, ub)
        current_fitness = func(current_candidate)

        for _ in range(budget - 1):
            candidate_new = clip(rng.normal(current_candidate, 0.1), lb, ub)
            fitness_new = func(candidate_new)

            if fitness_new < current_fitness:
                current_candidate = candidate_new
                current_fitness = fitness_new
            else:
                acceptance_probability = np.exp((current_fitness - fitness_new) / initial_temperature)
                if rng.uniform(0, 1) < acceptance_probability:
                    current_candidate = candidate_new
                    current_fitness = fitness_new

            yield {'candidate': current_candidate, 'fitness': current_fitness}

    best_individual = None
    best_fitness = np.inf

    for iteration in range(budget):
        de = differential_evolution(func, bounds)
        sa = simulated_annealing(func, bounds)

        try:
            de_next = next(de)
            if de_next['fitnesses'].min() < best_fitness:
                best_individual = de_next['candidates'][np.argmin(de_next['fitnesses'])]
                best_fitness = de_next['fitnesses'].min()
        except StopIteration:
            pass

        try:
            sa_next = next(sa)
            if sa_next['fitness'] < best_fitness:
                best_individual = sa_next['candidate']
                best_fitness = sa_next['fitness']
        except StopIteration:
            break

    return np.array(best_individual)
