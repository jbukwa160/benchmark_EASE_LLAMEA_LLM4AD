def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        new_x = x.copy()
        for i in range(dim):
            sigma = 0.1 / np.sqrt(_ + 1)
            noise = (ub - lb) * rng.randn() * sigma
            new_x[i] += noise

            if func(new_x) < best_f:
                best_f = func(new_x)
                best_x = new_x.copy()

        x = best_x.copy()
        x[(x < lb)] = lb
        x[(x > ub)] = ub

    return np.clip(best_x, lb, ub)
