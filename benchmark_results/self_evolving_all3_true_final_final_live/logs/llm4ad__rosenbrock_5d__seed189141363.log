def algorithm(func, dim, lb, ub, budget, rng):
    def sample(mu, sigma):
        return mu + sigma * rng.normal(size=(1, dim))

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x = np.zeros((budget, dim))
    y = np.zeros(budget)
    lambda_ = 10  # population size
    mu = np.random.uniform(lb, ub, (1, dim))  # initial mean
    sigma = 0.5 * (ub - lb)  # initial standard deviation

    for i in range(budget):
        x[i] = sample(mu, sigma)
        y[i] = func(x[i])

        if i >= lambda_:
            mu_new = np.zeros((1, dim))
            for j in range(lambda_):
                mu_new += x[i-j]
            mu_new /= lambda_
            C = (np.outer(x[i-lambda_:i], x[i-lambda_:i]) / lambda_) - np.outer(mu_new, mu_new)
            sigma_new = 1 + 2 * (C[0][0] / np.sqrt(np.linalg.det(C) + 1e-8))
            sigma_new = np.maximum(sigma_new, 0.01)  # ensure positive standard deviation
            mu = mu_new
            sigma = sigma_new

    best_idx = np.argmin(y)
    return clip(x[best_idx], lb, ub)
