def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    sigma = 0.5
    t = 1
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = x + sigma * np.random.randn(dim)
        clipped_y = np.clip(y, lb, ub)
        f_y = func(clipped_y)
        
        if f_y < best_f:
            best_f = f_y
            best_x = clipped_y
        
        y = x - (x - clipped_y) / np.linalg.norm(x - clipped_y) * sigma
        clipped_y = np.clip(y, lb, ub)
        f_y = func(clipped_y)
        
        if f_y < best_f:
            best_f = f_y
            best_x = clipped_y
        
        x = (1 + 2.38 / t) * rng.randn(dim)

    return best_x
