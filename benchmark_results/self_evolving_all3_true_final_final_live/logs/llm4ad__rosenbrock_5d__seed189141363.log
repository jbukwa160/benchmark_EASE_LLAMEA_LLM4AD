def algorithm(func, dim, lb, ub, budget, rng):
    X = rng.uniform(lb, ub, size=(dim,))
    cov = np.eye(dim)
    for _ in range(budget):
        while True:
            new_X = rng.multivariate_normal(X, cov)
            new_X = np.clip(new_X, lb, ub)
            f_new = func(new_X)
            f_best = func(X)
            if f_new < f_best or rng.uniform() < np.exp(-(f_new - f_best)):
                X = new_X
                break
        cov += 0.1 * (X - X[:, np.newaxis]) @ (X - X[:, np.newaxis]).T
    return X
