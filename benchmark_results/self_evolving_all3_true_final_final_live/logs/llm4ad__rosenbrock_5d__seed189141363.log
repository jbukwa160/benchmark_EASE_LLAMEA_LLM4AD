def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        c = 0.1 * np.random.choice([-1, 1], size=dim) + 0.5
        f_p = func(x + c)
        
        if rng.uniform() < (f_p - best_f) / (f_p - func(x - c)):
            x = x + c
            best_x = x.copy()
            best_f = func(x)
    
    return best_x
