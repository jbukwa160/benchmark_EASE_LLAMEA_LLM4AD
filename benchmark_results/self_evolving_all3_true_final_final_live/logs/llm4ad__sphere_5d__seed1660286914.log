def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    for _ in range(budget):
        y = x + 0.5 * (ub - lb) * (rng.rand(dim) - 0.5)
        y = np.clip(y, lb, ub)
        f_x = func(x)
        f_y = func(y)
        if f_y < f_x:
            x = y
    return x
