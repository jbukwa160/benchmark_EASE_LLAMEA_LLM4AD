def algorithm(func, dim, lb, ub, budget, rng):
    best = -np.inf * np.ones(dim)
    candidate = (ub - lb) * rng.rand(dim) + lb
    
    for _ in range(budget):
        if func(candidate) < func(best):
            best = candidate
        new_candidate = (ub - lb) * rng.rand(dim) + lb
        
        # Clip candidates to [lb, ub]
        new_candidate = np.clip(new_candidate, lb, ub)
        
        # Iterate over all dimensions independently with uniformly distributed probabilities
        for i in range(dim):
            if rng.uniform(0, 1) < 0.5:
                candidate[i] = new_candidate[i]
        
    return best
