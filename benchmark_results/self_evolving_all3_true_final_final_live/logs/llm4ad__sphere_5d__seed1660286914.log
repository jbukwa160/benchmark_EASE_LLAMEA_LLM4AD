def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    current_best = func(x)
    temperature = 1.0
    accepted = 1

    for _ in range(budget):
        new_x = clip(x + np.random.uniform(-5.0, 5.0, size=dim))
        new_cost = func(new_x)

        if new_cost <= current_best:
            x = new_x
            current_best = new_cost
            accepted += 1

        if (new_cost - current_best) / temperature > rng.uniform(0, 1):
            x = new_x
            current_best = new_cost

        temperature *= 0.9995
        if temperature < 1e-6:
            break

    return clip(x)
