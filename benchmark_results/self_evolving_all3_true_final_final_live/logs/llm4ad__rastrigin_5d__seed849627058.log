def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_mutation(x, sigma):
        return x + sigma * rng.normal(size=dim)

    mu = 0.5 * (ub - lb)
    sigma = 1.0

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_mutated = gaussian_mutation(x_best, sigma)
        x_clipped = np.clip(x_mutated, lb, ub)

        f_mutated = func(x_clipped)

        if f_mutated < f_best:
            x_best = x_clipped
            f_best = f_mutated

    return x_best
