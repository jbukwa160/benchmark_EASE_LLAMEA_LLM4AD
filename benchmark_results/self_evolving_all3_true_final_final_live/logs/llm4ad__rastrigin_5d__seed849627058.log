def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    T = 1e6

    for _ in range(budget):
        v = rng.normal(size=dim)
        u = clip(best_x + v)
        f_u = func(u)

        if f_u < best_f:
            best_f = f_u
            best_x = u.copy()

        alpha = np.exp(np.log(T) / (1e6 + _))
        T *= 0.99

        if rng.uniform(0, 1) > np.exp((best_f - f_u) / alpha):
            x = u.copy()
            best_f = f_u

    return best_x
