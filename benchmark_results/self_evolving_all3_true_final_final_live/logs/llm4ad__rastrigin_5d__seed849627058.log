def algorithm(func, dim, lb, ub, budget, rng):
    def rastrigin(x):
        return func(x)

    def clip(x):
        return np.clip(x, lb, ub)

    def mutate(x, sigma):
        return x + sigma * (np.random.uniform(-1, 1, size=dim) - 0.5)

    def crossover(parent, child):
        for i in range(dim):
            if rng.uniform(0, 1) < 0.5:
                child[i] = parent[i]
        return child

    best_x = np.zeros(dim)
    best_f = rastrigin(best_x)

    for t in range(budget):
        sigma = 10 / (1 + np.log(t + 2))
        candidates = np.array([best_x + sigma * np.random.uniform(-1, 1, size=dim) for _ in range(50)])
        candidates = clip(candidates)
        fitnesses = [rastrigin(candidate) for candidate in candidates]

        best_candidate_idx = np.argmin(fitnesses)
        if fitnesses[best_candidate_idx] < best_f:
            best_x = candidates[best_candidate_idx]
            best_f = fitnesses[best_candidate_idx]

        parents = np.array([best_x + sigma * np.random.uniform(-1, 1, size=dim) for _ in range(50)])
        parents = clip(parents)
        children = [crossover(best_x, mutate(parent, sigma)) for parent in parents]
        children = clip(children)

        for child in children:
            if rastrigin(child) < best_f:
                best_x = child
                best_f = rastrigin(child)

    return best_x
