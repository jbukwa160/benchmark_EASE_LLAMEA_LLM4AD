def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    init = np.random.uniform(lb, ub, (budget, dim))
    init = clip(init, lb, ub)
    
    for _ in range(budget - 1):
        x_best = init[np.argmin([func(clip(x, lb, ub)) for x in init])]
        init = np.vstack((init, x_best + rng(np.random.uniform(-1, 1, dim))))
        init = clip(init, lb, ub)
        
    return np.clip(init[np.argmin([func(x) for x in init])], lb, ub)
