def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        step_size = 0.1
        x_new = x + step_size * np.clip(rng.randn(dim), -10, 10)
        f_new = func(np.clip(x_new, lb, ub))
        
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new
            
        x = best_x

    return best_x
