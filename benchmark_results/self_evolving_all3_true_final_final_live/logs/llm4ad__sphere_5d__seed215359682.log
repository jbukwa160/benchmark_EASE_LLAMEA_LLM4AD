def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_y = float('inf')
    step_size = max(ub - lb, 1e-5)

    for _ in range(budget):
        x = best_x + (np.random.rand(dim) * 2 - 1) * step_size
        x = np.clip(x, lb, ub)
        
        y = func(x)
        if y < best_y:
            best_x = x
            best_y = y

    return best_x
