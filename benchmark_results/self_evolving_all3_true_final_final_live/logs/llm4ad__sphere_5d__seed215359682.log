def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    step_size = 1.0
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        new_x = x + (np.random.uniform(-step_size, step_size, dim) * (x - lb))
        new_x = np.clip(new_x, lb, ub)
        new_f = func(new_x)

        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f

        if _ % 100 == 0 or _ == budget - 1:  # Reduce step size every 100 iterations
            step_size /= 2.0

    return best_x
