def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def mutate(pop, x_best):
        for i in range(dim):
            mutation = 0.1 * (ub - lb) * rng.rand()
            pop[i] += mutation
        return pop

    def crossover(parent, donor):
        p_cross = 0.5 + 0.2 * rng.rand()
        child = parent + p_cross * (donor - parent)
        return clip(child)

    pop_size = int(budget ** 0.5)
    pop = np.random.uniform(lb, ub, size=(pop_size, dim))
    x_best = np.inf
    x_best_pos = None

    for t in range(1, budget + 1):
        for i in range(pop_size):
            donor = mutate(np.copy(pop), x_best)
            child = crossover(pop[i], donor)
            fit_child = func(child)

            if fit_child < func(pop[i]):
                pop[i] = child
                if fit_child < x_best:
                    x_best = fit_child
                    x_best_pos = child

    return x_best_pos
