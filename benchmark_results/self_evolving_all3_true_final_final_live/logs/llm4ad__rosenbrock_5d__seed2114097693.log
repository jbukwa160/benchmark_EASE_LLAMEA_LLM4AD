def algorithm(func, dim, lb, ub, budget, rng):
    n_init = int(np.sqrt(budget))
    x_init = rng.uniform(lb, ub, (n_init, dim))
    f_values = [func(x) for x in x_init]
    
    best_x = x_init[np.argmin(f_values)]
    best_f = np.min(f_values)
    
    gp_model = {'mean': 0, 'cov': 1}
    
    for i in range(n_init, budget):
        x_new = rng.normal(loc=best_x, scale=2, size=(1, dim))
        x_new = np.clip(x_new, lb, ub)[0]
        
        f_new = func(x_new)
        y_new = [f_new, x_new]
        
        gp_model['mean'], gp_model['cov'] = update_gp(gp_model, best_x, best_f, x_new, f_new)
        
        if f_new < best_f:
            best_x = x_new
            best_f = f_new
    
    return best_x
