def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)
    
    T = 1.0
    alpha = 0.99
    
    for _ in range(budget):
        x_candidate = clip(x_best + rng.uniform(-1, 1, size=dim))
        
        f_candidate = func(x_candidate)
        
        delta_f = f_candidate - f_best
        
        if delta_f < 0 or np.random.rand() < np.exp(-(delta_f / T)):
            x_best = x_candidate
            f_best = f_candidate
            
        T *= alpha
        
    return x_best
