def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        x = np.clip(x, lb, ub)
        return func(x)

    D = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    best = evaluate(D)
    D_best = D.copy()

    for _ in range(budget - 1):
        M = rng.choice(D.shape[0], size=3, replace=False)
        u = D[M]
        v = np.mean(u, axis=0)

        F = 0.5 / (1 + np.linalg.norm(v - D_best))
        a = F * (v - D_best) + D
        b = F * (u - D_best) + D

        x_new = F * a + (1 - F) * b

        for i in range(dim):
            if rng.random() < 0.5:
                x_new[i] += rng.uniform(-F, F)
            else:
                x_new[i] += rng.uniform(0, F)

        f_new = evaluate(x_new)
        if f_new < best:
            best = f_new
            D_best = x_new

    return D_best
