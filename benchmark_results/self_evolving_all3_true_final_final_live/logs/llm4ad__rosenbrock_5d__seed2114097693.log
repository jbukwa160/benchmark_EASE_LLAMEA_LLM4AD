def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, (1, dim))
    step_size = 2 * (ub - lb) / 10.
    best_x = x.copy()
    best_y = func(x)
    
    for _ in range(budget):
        y_new = func(x + step_size * np.sign(rng.normal(size=(dim,)) - 0.5))
        
        if y_new < best_y:
            best_y = y_new
            best_x = (x + step_size * np.sign(rng.normal(size=(dim,)) - 0.5)).copy()
            
        for i in range(dim):
            x_new = x.copy()
            x_new[i] += step_size
            if func(x_new) < best_y:
                best_y = func(x_new)
                best_x = x_new
                
            x_new = x.copy()
            x_new[i] -= step_size
            if func(x_new) < best_y:
                best_y = func(x_new)
                best_x = x_new
                
        for i in range(dim):
            y_mid = func(x + 0.5 * step_size * np.sign(rng.normal(size=(dim,)) - 0.5))
            
            if y_mid < best_y:
                best_y = y_mid
                best_x = (x + 0.5 * step_size * np.sign(rng.normal(size=(dim,)) - 0.5)).copy()
                
            if i == dim-1:
                break
        
        x = best_x.copy()
        
    return best_x
