def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    n = int(budget ** (1 / dim))
    x_best = np.random.uniform(lb, ub, size=(n, dim))

    for _ in range(10000): # maximum iterations
        for i in range(n):
            x_new = clip(x_best[i] + rng.normal(size=dim), lb, ub)
            
            f_x_new = func(x_new)
            f_x_best = func(x_best[i])
            
            if f_x_new < f_x_best:
                x_best[i] = x_new

    return x_best[np.argmin([func(x) for x in x_best])]
