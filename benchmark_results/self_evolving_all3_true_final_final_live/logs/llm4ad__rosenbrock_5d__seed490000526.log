def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        step_size = 0.1
        direction = np.zeros(dim)
        for i in range(dim):
            if rng.random() < 0.2:
                direction[i] = -np.sign(best_x[i])
            elif rng.random() < 0.4:
                direction[i] = np.sign(best_x[i])

        new_x = best_x + step_size * direction
        new_x = np.clip(new_x, lb, ub)

        new_f = func(new_x)
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f

    return best_x
