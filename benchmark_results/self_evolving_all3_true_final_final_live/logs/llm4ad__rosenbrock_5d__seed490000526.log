def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 10 * dim + 1
    sigma = 0.2
    lambda_ = 3
    mu = pop_size // lambda_
    c1 = 2 / (dim + 1)
    c2 = 2 / (dim + 1)

    x = rng.uniform(lb, ub, size=(pop_size, dim))
    y = np.copy(x)

    for i in range(budget):
        v = np.zeros((lambda_, mu, dim))

        for j in range(lambda_):
            u = rng.choice(pop_size)
            z = rng.normal(0, sigma, dim)
            v[j] = x[u] + c1 * (y[u] - x[u]) + c2 * z

            # Clip candidates to [lb, ub]
            v[j] = np.clip(v[j], lb, ub)

        for j in range(lambda_):
            u = rng.choice(pop_size)
            f_u = func(x[u])
            f_v = func(v[j])

            if f_v < f_u:
                x[u] = v[j]

        y[:] = x

    best_x = np.argmin(func(x))
    return x[best_x]
