def algorithm(func, dim, lb, ub, budget, rng):
    def fitness(x):
        return func(x)

    bounds = [(lb, ub) for _ in range(dim)]
    result_de = differential_evolution(fitness, bounds, maxiter=budget//2)
    
    # Simulated Annealing
    x0 = np.array(result_de.x)
    T = 1e3  # initial temperature
    alpha = 0.99  # cooling rate
    
    for _ in range(budget//2):
        x_new = x0 + rng.uniform(-5, 5, dim) * (ub - lb)
        clip_x = np.clip(x_new, lb, ub)
        
        if func(clip_x) < fitness(x0):
            x0 = clip_x
        elif np.random.rand() < np.exp(-(func(clip_x) - fitness(x0)) / T):
            x0 = clip_x
        
        T *= alpha
    
    return x0
