def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(current_x, sigma):
        x = current_x + rng.normal(size=(dim,), loc=0., scale=sigma)
        return clip(x)

    def update_learning_rate(learning_rate, momentum):
        # Simulated annealing
        learning_rate = max(1e-6, learning_rate * 0.99 ** (rng.uniform(0, 1)))
        # Momentum
        momentum = min(1, momentum + rng.normal(size=(dim,), loc=0., scale=0.01))
        return learning_rate, momentum

    def covariance_matrix_adaptation(population):
        cov = np.cov(np.array(population).T)
        sigma = 10 / (cov[0, 0] ** 2 + 1e-6)
        return sigma

    population = [rng.uniform(lb, ub, size=(dim,)) for _ in range(50)]
    learning_rate = 1.0
    momentum = np.zeros((dim,))
    best_x = None

    for _ in range(budget):
        current_best = float('inf')
        for x in population:
            current_value = func(x)
            if current_value < current_best:
                current_best = current_value
                best_x = x
            learning_rate, momentum = update_learning_rate(learning_rate, momentum)

        sigma = covariance_matrix_adaptation(population)
        new_population = [generate_candidate(current_best, sigma) for _ in range(50)]
        population = population + new_population

    return best_x
