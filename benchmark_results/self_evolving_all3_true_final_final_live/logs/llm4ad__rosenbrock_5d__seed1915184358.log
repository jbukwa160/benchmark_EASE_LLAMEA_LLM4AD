def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    d = 1 + int(np.log2(n))
    c = 0.5 * (ub - lb)
    x = lb + c * (rng.random((n,)) - 0.5)
    y = np.zeros(n)
    mu = np.mean(x)
    sigma = 10
    t = 1

    for _ in range(budget):
        s2 = sigma ** 2
        w = 1 / (1 + s2)

        # Covariance matrix adaptation
        for i in range(d):
            p = 0.5 * rng.random((n,))
            v = np.exp(-(np.sum((x - mu) ** 4)) / (s2 ** 3))
            y[i % n] += v * p

        # Selection and mutation
        u = x + y
        f1, g1 = func(u), None
        if f1 < func(x):
            x, y, mu, sigma, t = u, np.zeros(n), np.mean(u), 10, t + 1
        else:
            p = 0.5 * rng.random((n,))
            v = np.exp(-(np.sum((x - mu) ** 4)) / (s2 ** 3))
            y += v * p

        # Adaptation of the step size
        sigma = sigma + 1e-6 * (t ** 0.5) * ((f1 < func(x)) - 1)

    return x
