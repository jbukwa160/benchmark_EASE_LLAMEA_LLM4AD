def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    x_best = np.array([1.] * n)
    for i in range(budget):
        x_trial = np.clip(x_best + 0.9 * (ub - lb) * rng.uniform(-1., 1., n), lb, ub)
        f_trial = func(x_trial)
        if f_trial < func(x_best):
            x_best = x_trial
    return x_best
