def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    x0 = 1 + (ub - 1) * rng.rand(dim)
    sigma = 5.0 / 2.0
    D = np.eye(dim)
    mu = x0

    for i in range(budget):
        z = rng.randn(dim)
        v = np.dot(D, z)
        x_new = mu + sigma * v
        x_new = np.clip(x_new, lb, ub)

        f_new = f(x_new)
        f_old = f(mu)

        if f_new < f_old:
            mu = x_new
            D += 0.1 * (v @ v.T - D)

    return mu
