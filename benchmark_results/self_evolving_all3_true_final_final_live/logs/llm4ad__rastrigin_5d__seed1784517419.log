def algorithm(func, dim, lb, ub, budget, rng):
    N = 10
    mu = np.zeros(dim)
    sigma2 = np.ones(dim) * 1e-3
    cov = np.diag(sigma2)
    
    for _ in range(budget):
        x = np.random.multivariate_normal(mu, cov, 1000)
        x = np.clip(x, lb, ub)
        
        y = func(x)
        idx = np.argsort(y)[:N]
        new_x = x[idx]
        new_y = y[idx]
        
        for i in range(N):
            sigma2 = sigma2 * (1 + 1e-3) ** (new_y[i] - y.mean())
            cov = np.diag(sigma2)
            
            n = new_x[i] - mu
            cov += np.outer(n, n)
            L = np.linalg.cholesky(cov)
            m = np.random.multivariate_normal(np.zeros(dim), L)
            delta_mu = 0.1 * (new_y[i] - y.mean()) / N * m
            
            mu += delta_mu
            sigma2 = cov.diagonal()
            
    return mu
