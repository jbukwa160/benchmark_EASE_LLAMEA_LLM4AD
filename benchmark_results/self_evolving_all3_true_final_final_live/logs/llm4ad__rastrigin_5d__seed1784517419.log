def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    best = np.full(dim, 0)
    score_best = float('inf')
    pop = np.random.uniform(lb, ub, (50, dim))
    scores = np.zeros(50)

    for i in range(budget):
        for j in range(50):
            x_j = clip(pop[j])
            scores[j] = func(x_j)

        p1, p2, p3 = rng.choice(50, 3, replace=False)
        trial = pop[p1] + 0.5 * (pop[p2] - pop[p3])

        for d in range(dim):
            m = rng.uniform(-1, 1)
            trial[d] += m * (trial[d] - best[d])
            trial[d] = clip(trial[d])

        score_trial = func(clip(trial))
        if score_trial < scores[p1]:
            pop[p1], scores[p1] = trial, score_trial

        if score_trial < score_best:
            score_best, best = score_trial, trial

    return best
