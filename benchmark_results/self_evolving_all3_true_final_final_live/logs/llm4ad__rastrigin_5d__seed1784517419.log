def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.minimum(np.maximum(x, lb), ub)

    def quantum_adaptation(x, pop_size, sigma):
        candidate = x + sigma * (np.random.rand(dim) - 0.5)
        for i in range(pop_size):
            candidate += sigma * (populations[i] - x)
        return clip(candidate, lb, ub)

    populations = np.random.uniform(lb, ub, (10, dim))
    best_individual = rng.uniform(lb, ub, dim)
    best_fitness = func(best_individual)
    budget_count = 0

    while budget_count < budget:
        for i in range(10):
            candidate = quantum_adaptation(populations[i], 9, 0.1)
            fitness = func(candidate)
            if fitness < best_fitness:
                best_fitness = fitness
                best_individual = candidate
        populations += np.random.uniform(-0.01, 0.01, (10, dim))
        budget_count += 1

    return best_individual
