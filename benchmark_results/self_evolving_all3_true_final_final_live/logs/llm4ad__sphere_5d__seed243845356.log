def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    x_best = np.random.uniform(lb, ub, size=(n,))
    f_best = func(x_best)

    step_size = (ub - lb) / 2.0
    sigma = (ub - lb) / 3.0

    for i in range(budget):
        x_new = rng.normal(loc=x_best, scale=sigma, size=(n,))
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)

        if f_new < f_best:
            x_best = x_new
            f_best = f_new

        step_size *= 0.99
        sigma *= 0.995

    return x_best
