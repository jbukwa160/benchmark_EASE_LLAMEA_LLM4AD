def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    best_fitness = float('inf')

    for _ in range(budget):
        new_point = best + 0.1 * (ub - lb) * rng.randn(dim)

        # Clip to bounds
        clipped_point = np.clip(new_point, lb, ub)

        new_fitness = func(clipped_point)

        if new_fitness < best_fitness:
            best_fitness = new_fitness
            best = clipped_point

    return best
