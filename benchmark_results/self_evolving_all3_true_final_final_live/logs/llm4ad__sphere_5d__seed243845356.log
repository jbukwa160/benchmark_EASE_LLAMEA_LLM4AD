def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = dim
    sigma = 0.5
    lambda_ = 1
    mu = D / 2
    cmu = np.zeros(D)
    c1 = 1 + 2 / (D * (D + 4))
    c2 = 1 - 1 / (D + 3)

    x_best = rng.uniform(lb, ub, size=D)
    f_best = func(x_best)

    for t in range(budget):
        x_cand = np.zeros((lambda_, D))

        for i in range(lambda_):
            for j in range(D):
                csigma = rng.normal(0, 1) * sigma
                ccmu = cmu.copy()
                ccmu[j] += csigma

                x_cand[i, j] = clip(x_best[j] + ccmu[j])

        f_cand = np.array([func(clip(x)) for x in x_cand])

        idx_sorted = np.argsort(f_cand)
        f_cand_sorted = f_cand[idx_sorted]
        x_cand_sorted = x_cand[idx_sorted]

        if t < budget - 1:
            sigma *= 0.5 * c2 + rng.normal(0, 0.01)

        for i in range(lambda_):
            if i < mu:
                cmu += (x_cand_sorted[i] - x_best) / lambda_
            else:
                cmu = c1 * cmu + (x_cand_sorted[i] - x_best) / lambda_

        sigma_new = np.sqrt(np.dot(cmu, cmu))

        if f_cand_sorted[0] < f_best or rng.uniform(0, 1) < np.exp(-(f_cand_sorted[0] - f_best) / (2 * sigma_new**2)):
            x_best = clip(x_cand_sorted[0])
            f_best = f_cand_sorted[0]
        elif rng.uniform(0, 1) < c1:
            idx_parent = np.random.choice(np.arange(lambda_), size=lambda_, replace=False)
            for i in range(lambda_):
                if idx_parent[i] == 0 or (f_cand_sorted[idx_parent[i]] > f_best and rng.uniform(0, 1) < np.exp(-(f_cand_sorted[idx_parent[i]] - f_best) / (2 * sigma_new**2))):
                    x_best = clip(x_cand_sorted[idx_parent[i]])
                    f_best = f_cand_sorted[idx_parent[i]]

    return x_best
