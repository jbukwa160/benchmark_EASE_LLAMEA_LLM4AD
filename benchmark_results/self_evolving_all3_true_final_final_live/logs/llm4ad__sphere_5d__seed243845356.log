def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x), []

    def clip(x):
        return np.clip(x, lb, ub)

    x = (ub + rng.uniform(-1, 0) * (ub - lb)) * np.ones(dim)
    best_x = x.copy()
    best_f = func(best_x)

    sigma = 10
    step_size = 0.2
    temperature = budget

    for i in range(int(budget)):
        if i % int(0.1 * budget) == 0:
            temperature *= 0.95

        for _ in range(int(dim / 2)):
            noise = rng.normal(size=dim)
            new_x = clip(x + step_size * sigma * np.dot(noise, noise))

            new_f, _ = objective(new_x)

            if new_f < best_f:
                best_f = new_f
                best_x = new_x

            accept_probability = min(1, np.exp((best_f - new_f) / temperature))
            u = rng.uniform()

            if u < accept_probability or i > int(budget * 0.7):
                x = new_x

        sigma += 0.01
        step_size *= 0.9995

    return best_x
