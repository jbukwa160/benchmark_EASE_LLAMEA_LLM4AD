def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    def get_initial_solution():
        x = np.zeros(dim)
        for i in range(dim):
            if rng.random() < 0.5:
                x[i] = lb + (ub - lb) * rng.uniform()
            else:
                x[i] = ub - (ub - lb) * rng.uniform()
        return x

    def gradient(x):
        return 2 * x

    def simulated_annealing(x, temperature, cooling_rate):
        new_x = np.copy(x)
        for i in range(dim):
            if rng.random() < 0.5:
                new_x[i] += lb + (ub - lb) * rng.uniform()
            else:
                new_x[i] -= ub - (ub - lb) * rng.uniform()
            new_x[i] = clip(new_x[i])
        new_x = np.clip(clip(new_x), a_min=0, a_max=np.inf)
        if func(new_x) < func(x):
            return new_x
        else:
            probability = np.exp(-(func(new_x) - func(x)) / temperature)
            if rng.random() < probability:
                return new_x
            else:
                return x

    def gradient_descent(x, step_size):
        dx = -gradient(x)
        for i in range(dim):
            x[i] += step_size * dx[i]
        return clip(x)

    x = get_initial_solution()
    temperature = 100.0
    cooling_rate = 0.99
    step_size = 0.01

    for _ in range(budget):
        x = simulated_annealing(x, temperature, cooling_rate)
        if rng.random() < 0.9:
            x = gradient_descent(x, step_size)

    return clip(x)
