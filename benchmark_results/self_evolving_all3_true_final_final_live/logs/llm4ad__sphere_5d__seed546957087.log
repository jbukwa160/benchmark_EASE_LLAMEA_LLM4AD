def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(dim, lb, ub):
        population = []
        for _ in range(budget):
            candidate = rng.uniform(lb, ub, size=dim)
            population.append(candidate)
        return np.array(population)

    def evaluate_candidates(candidates, func):
        return np.array([func(candidate) for candidate in candidates])

    def select_parents(population, fitness_values, budget):
        idx = np.argsort(fitness_values)[:budget]
        parents = population[idx]
        return parents

    def adapt_covariance_matrix(population):
        cov = np.cov(np.transpose(population))
        return cov

    def gaussian_mutate(candidate, covariance_matrix):
        noise = rng.multivariate_normal(mean=np.zeros(dim), cov=covariance_matrix)
        mutant = candidate + noise
        return mutant

    population = generate_initial_population(dim, lb, ub)
    fitness_values = evaluate_candidates(population, func)

    for _ in range(budget - 1):
        parents = select_parents(population, fitness_values, budget // 2)
        covariance_matrix = adapt_covariance_matrix(parents)

        for parent in parents:
            mutant = gaussian_mutate(parent, covariance_matrix)
            mutant = clip(mutant)
            if func(mutant) < func(parent):
                parent[:] = mutant

        population = parents
        fitness_values = evaluate_candidates(population, func)

    best_candidate = np.argmin(fitness_values)
    return clip(population[best_candidate])
