def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    n = int(budget ** 0.5)
    mean = rng.uniform(lb, ub, size=dim)
    cov = np.eye(dim) * (ub - lb) / 2
    step_size = (ub - lb) / 10

    for i in range(n):
        candidate = clip(mean + rng.normal(0, step_size, size=dim))
        value = func(candidate)

        if value < func(mean):
            mean = candidate
            cov += (candidate - mean).reshape(-1, 1) @ (candidate - mean)
            step_size *= 0.9

    return clip(mean)
