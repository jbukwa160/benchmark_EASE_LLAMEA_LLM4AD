def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(x):
        candidate = x + rng.uniform(-1, 1, size=dim) * (ub - lb)
        return np.clip(candidate, lb, ub)

    def differential_evolution(x0, candidates):
        best = x0
        for _ in range(10):
            for i, c in enumerate(candidates):
                y = (x0[i] + c[i]) / 2
                if func(y) < func(best):
                    best = y
        return best

    def simulated_annealing(x0, temperature=1000, cooling_rate=0.99):
        current = x0
        for _ in range(budget):
            candidate = generate_candidate(current)
            delta = func(candidate) - func(current)
            if delta < 0 or rng.random() < np.exp(-delta / temperature):
                current = candidate
            temperature *= cooling_rate
        return current

    best_x = None
    for i in range(1, budget + 1):
        x0 = rng.uniform(lb, ub, size=dim)
        candidates = [generate_candidate(x0) for _ in range(dim)]
        best_x = differential_evolution(x0, candidates)
        best_x = simulated_annealing(best_x)

    return best_x
