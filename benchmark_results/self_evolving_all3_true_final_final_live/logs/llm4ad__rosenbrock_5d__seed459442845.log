def algorithm(func, dim, lb, ub, budget, rng):
    def clipped_bounds(x):
        return np.clip(x, lb, ub)

    def generate_candidate(rand, x_best):
        candidate = x_best + rand * (ub - lb)
        return clipped_bounds(candidate)

    def evaluate_candidate(candidate, func):
        return func(candidate)

    def differential_evolution(x_best, rand, budget):
        for _ in range(budget):
            candidate1 = generate_candidate(rand, x_best)
            candidate2 = generate_candidate(rand, x_best)
            candidate3 = generate_candidate(rand, x_best)
            candidate4 = np.mean([candidate1, candidate2, candidate3])
            if evaluate_candidate(candidate4, func) < evaluate_candidate(x_best, func):
                x_best = candidate4
        return x_best

    best_x = rng.uniform(lb, ub, size=dim)
    for _ in range(budget * 10): # Probabilistic restarts with 10 times the original budget
        rand = rng.uniform(-1, 1, size=dim)
        best_x = differential_evolution(best_x, rand, budget)

    return best_x
