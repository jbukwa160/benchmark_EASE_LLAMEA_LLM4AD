def algorithm(func, dim, lb, ub, budget, rng):
    X = np.random.uniform(lb, ub, size=(budget, dim))
    Y = func(X)
    
    gp_model = {'X': [], 'Y': []}
    best_x = None
    
    for i in range(1, budget):
        # Update GP model
        X_gp = np.array(gp_model['X'])
        Y_gp = np.array(gp_model['Y'])
        
        mu, sigma2 = norm.fit(Y_gp)
        alpha = 1 / (sigma2 + 1e-8)
        L = np.linalg.cholesky(np.exp(-alpha * (X_gp - X_gp[:, None])**2))
        
        k = i / budget
        f = (1 - k) * mu + k * norm.rvs(loc=mu, scale=np.sqrt(sigma2), size=dim)
        
        # Sample new point using GP model
        x_new = X[i-1] + np.random.normal(0, 1e-3, size=dim)
        f_new = func(x_new)
        
        # Update GP model with new point
        gp_model['X'].append(x_new)
        gp_model['Y'].append(f_new)
        
        # Check if the new point is better than current best
        if f_new < np.min(Y[:i]):
            best_x = x_new
            
    return best_x
