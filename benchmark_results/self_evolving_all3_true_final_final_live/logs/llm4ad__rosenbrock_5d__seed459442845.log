def algorithm(func, dim, lb, ub, budget, rng):
    def clipped_candidate(bounds, candidate):
        return np.clip(candidate, bounds[0], bounds[1])

    def evaluate(candidate):
        return func(candidate)

    best_solution = None
    best_fitness = float('inf')

    for _ in range(budget):
        # Differential Evolution
        population_size = 20
        population = rng.uniform(lb, ub, (population_size, dim))
        weights = rng.normal(0, 1.5, (dim))

        for i in range(population_size):
            candidate = population[i]
            trial_candidate = clipped_candidate((lb, ub), candidate + weights * rng.uniform(-2, 2, dim))
            fitness = evaluate(trial_candidate)
            if fitness < best_fitness:
                best_solution = trial_candidate
                best_fitness = fitness

        # Simulated Annealing
        alpha = 0.99
        temperature = 1000.0
        for _ in range(10):
            candidate = clipped_candidate((lb, ub), rng.normal(best_solution, np.sqrt(temperature)))
            fitness = evaluate(candidate)
            if fitness < best_fitness:
                best_solution = candidate
                best_fitness = fitness
            temperature *= alpha

    return best_solution
