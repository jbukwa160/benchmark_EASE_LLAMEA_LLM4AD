def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.minimum(np.maximum(x, lb), ub)

    D = len(dim)
    x_best = np.random.uniform(lb, ub, size=D)
    f_best = func(x_best)
    
    simplex_size = 20
    simplex = np.zeros((simplex_size, D))
    for i in range(simplex_size):
        simplex[i] = clip(np.random.uniform(lb, ub, size=D), lb, ub)

    for _ in range(budget):
        y = func(clip(simplex, lb, ub))
        order = np.argsort(y)
        
        if y[order[0]] < f_best:
            x_best = simplex[order[0]]
            f_best = y[order[0]]
        
        a = 2 * (simplex[order[-1]] - simplex[order[0]])
        b = len(order) / (len(order) + 1)
        
        for i in range(1, len(order)):
            if rng.random() < 0.5:
                y[i] = func(clip(simplex[order[i-1]] + a * np.random.uniform(-b, b), lb, ub))
                order = np.argsort(y)
                
                if y[order[0]] < f_best:
                    x_best = simplex[order[0]]
                    f_best = y[order[0]]
                    
        a = 2 * (simplex[order[-1]] - simplex[order[0]])
        b = len(order) / (len(order) + 1)
        
        for i in range(1, len(order)):
            if rng.random() < 0.5:
                y[i] = func(clip(simplex[order[i-1]] - a * np.random.uniform(-b, b), lb, ub))
                order = np.argsort(y)
                
                if y[order[0]] < f_best:
                    x_best = simplex[order[0]]
                    f_best = y[order[0]]

    return x_best
