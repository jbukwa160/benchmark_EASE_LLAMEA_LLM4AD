def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    x_best = rng.uniform(lb, ub, size=dim)
    best_fitness = func(x_best)

    for _ in range(budget):
        delta = rng.normal(size=dim)  # random perturbation
        step_size = np.sqrt(np.sum(delta ** 2)) + 1e-6

        new_x = clip(x_best + (delta / step_size), lb, ub)
        new_fitness = func(new_x)

        if new_fitness < best_fitness:
            x_best = new_x
            best_fitness = new_fitness

    return x_best
