def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    sigma = 1.0
    lambda_ = int(4 + 3 * np.log(dim))
    mu = lambda_ // 2
    w_cma = np.zeros(lambda_)
    c_1 = 1 / (dim + 1.25)
    c_mu = 2 / ((dim + 1.25) ** 2)
    c_cov = 2 / ((dim + 2) ** 2)
    d = dim

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = evaluate(x_best)

    for _ in range(budget):
        x = np.clip(rng.randn(dim) * sigma + x_best, lb, ub)
        f = evaluate(x)

        if rng.rand() < np.exp((f - f_best) / (sigma ** 2)):
            x_best = x
            f_best = f

        w_cma[:] = 0
        for i in range(lambda_):
            w_cma[i] = evaluate(np.clip(rng.randn(dim) * sigma + x_best, lb, ub))
        y = np.copy(x_best)
        c1_i = 1 / (i + 1)
        c_mu_i = 2 / ((i + 1) ** 2)
        for i in range(lambda_):
            w_cma[i] -= f_best
        for i in range(d):
            d_i = np.sqrt(np.sum((x_best - x[i]) ** 2))
            y[i] += c1_i * (x_best[i] - x[i]) / d_i + \
                c_mu_i * w_cma[i] / (d_i + 1e-8) + \
                rng.randn() * sigma * np.sqrt(c_cov / (d_i + 1e-8))
        y = np.clip(y, lb, ub)
        f_y = evaluate(y)

        if rng.rand() < np.exp((f_y - f_best) / (sigma ** 2)):
            x_best = y
            f_best = f_y

    return x_best
