def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for _ in range(budget):
        # Differential Evolution step
        diff = np.zeros(dim)
        for i in range(dim):
            idx1 = rng.choice(range(dim), replace=False)
            idx2 = rng.choice(range(dim), replace=False)
            if idx1 != i and idx2 != i:
                diff[i] = best_x[idx1] - best_x[idx2]
        candidate = clip(best_x + 0.5 * np.sqrt((ub - lb) / dim) * diff)

        # Simulated Annealing step
        accept_prob = 1 - (1 / (_ + 10)) ** rng.uniform(0, 1)
        if rng.random() < accept_prob or func(candidate) < best_f:
            best_x = candidate
            best_f = func(best_x)

    return best_x
