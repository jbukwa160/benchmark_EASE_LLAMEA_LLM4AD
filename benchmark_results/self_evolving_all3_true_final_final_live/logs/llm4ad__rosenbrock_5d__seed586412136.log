def algorithm(func, dim, lb, ub, budget, rng):
    if dim == 1:
        return (lb + ub) / 2
    
    x = rng.uniform(lb, ub, size=dim)
    
    for _ in range(budget):
        n_samples = 10
        samples = np.array([rng.uniform(lb, ub, size=dim) for _ in range(n_samples)])
        
        f_values = np.array([func(x=x_i) for x_i in samples])
        
        best_idx = np.argmin(f_values)
        new_x = samples[best_idx]
        
        if func(new_x) < func(x):
            x = new_x
        
        grid_size = 0.1
        for i in range(dim):
            x_grid = np.linspace(lb, ub, int((ub - lb) / grid_size))
            x_new = x.copy()
            for j in x_grid:
                x_new[i] = j
                if func(x_new) < func(x):
                    x = x_new
                    break
    
    return x
