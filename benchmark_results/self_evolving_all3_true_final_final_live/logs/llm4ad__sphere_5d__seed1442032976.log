def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, (1, dim))
    sigma = 1.0
    c1 = 2 / (dim + 1.3)
    c2 = 2 * (dim + 4.7) ** 2
    d = np.zeros((1, dim))
    D = rng.uniform(0, 5, (1, dim))

    for i in range(budget):
        y = x.copy()
        for j in range(dim):
            e = rng.normal(0, 1)
            dj = c1 * e + D[j]
            d[j] = dj
            y[0, j] += sigma * d[j]

        y = np.clip(y, lb, ub)

        f_y = func(y.flatten())
        f_x = func(x.flatten())

        if f_y < f_x:
            x = y
            D = rng.uniform(0, 5, (1, dim))

        delta = y - x
        covar = np.outer(delta, delta)
        d = covar @ np.linalg.inv(covar + c2 * np.eye(dim)) / sigma

        sigma *= np.exp(c1 / np.sqrt(np.trace(covar) / dim))
        D += rng.normal(0, 5, (1, dim))

    return x
