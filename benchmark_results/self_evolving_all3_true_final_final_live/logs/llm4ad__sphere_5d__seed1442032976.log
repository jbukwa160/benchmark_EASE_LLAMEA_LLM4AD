def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    step_size = 1e-3
    for _ in range(budget):
        g = np.zeros(dim)
        f_x = func(x)
        for i in range(dim):
            x_i = x[i]
            x[-i-1] = x_i + step_size * (f_x - func(np.clip(x_i - 2*step_size, lb, ub)))/(2*step_size)
            g[-i-1] = (func(np.clip(x_i - 2*step_size, lb, ub)) - f_x)/2/step_size
        x = np.clip(x, lb, ub)
    return x
