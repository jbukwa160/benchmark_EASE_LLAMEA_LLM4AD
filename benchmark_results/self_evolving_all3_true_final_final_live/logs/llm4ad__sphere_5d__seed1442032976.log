def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x0 = rng.uniform(-5, 5, size=dim)
    x_best = clip(x0)
    f_best = func(clip(x0))

    for _ in range(budget):
        x_mutant1 = clip(x0 + 0.3*rng.normal(size=dim))
        x_mutant2 = clip(x0 - 0.5*rng.normal(size=dim))
        x_mutant3 = clip(x_best + rng.uniform(-1, 1, size=dim))

        f_mutant1 = func(clip(x_mutant1))
        f_mutant2 = func(clip(x_mutant2))
        f_mutant3 = func(clip(x_mutant3))

        if f_mutant1 < f_best:
            x0 = clip(x_mutant1)
            f_best = f_mutant1
        elif f_mutant2 < f_best:
            x0 = clip(x_mutant2)
            f_best = f_mutant2
        elif f_mutant3 < f_best:
            x0 = clip(x_mutant3)
            f_best = f_mutant3

    return np.array([x_best])
