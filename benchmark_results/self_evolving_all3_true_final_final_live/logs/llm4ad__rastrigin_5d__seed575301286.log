def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    def f(x):
        x = bound(x)
        return func(x)

    pop_size = 50
    x0 = (ub - lb) * rng.rand(pop_size, dim) + lb

    for i in range(1, budget):
        F = 0.5 / np.log10(i + 2)
        C_r = 0.9
        mutation = rng.uniform(-F, F, size=(pop_size, dim))
        crossover = rng.rand(pop_size, dim) < C_r

        y = x0 + crossover[:, None] * mutation

        fitness = f(y)

        ind = np.argmin(fitness)
        if fitness[ind] < f(x0[ind]):
            x0[ind] = y[ind]

    return x0[np.argmin([f(x) for x in x0])]
