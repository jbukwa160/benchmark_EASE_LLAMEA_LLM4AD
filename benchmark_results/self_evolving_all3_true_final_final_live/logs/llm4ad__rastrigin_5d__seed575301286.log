def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = 0.5 * (ub - lb) + lb + (ub - lb) * rng.uniform(size=dim)
    y = np.zeros(dim)

    for _ in range(budget):
        z = np.zeros(dim)
        for i in range(dim):
            z[i] = x[i] + rng.uniform(-1, 1) * (x[i] - y[i])
        z = clip(z)

        f_z = func(z)
        if f_z < func(x):
            x = z

        f_y = func(y)
        if f_z < f_y:
            y = z

    return clip(x)
