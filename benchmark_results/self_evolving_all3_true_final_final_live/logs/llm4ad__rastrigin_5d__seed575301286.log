def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_samples = 1
    sigma0 = 2.4 * (ub - lb) / np.sqrt(D)
    mu = np.zeros(D)
    cov = np.eye(D)
    population_size = int(budget / n_samples)

    for _ in range(budget):
        # Sample from normal distribution with mean mu and covariance matrix cov
        population = rng.normal(mu, cov, (population_size, D))

        # Clip candidates to [lb, ub]
        population = np.clip(population, lb, ub)

        # Evaluate the function at each candidate
        fitnesses = func(population)

        # Select the best candidate
        best_idx = np.argmax(fitnesses)
        best_candidate = population[best_idx]

        # Update mu and cov based on the best candidate
        delta = best_candidate - mu
        cov += 1 / population_size * np.outer(delta, delta)
        mu += 1 / population_size * delta

    return best_candidate
