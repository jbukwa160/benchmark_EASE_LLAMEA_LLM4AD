def algorithm(func, dim, lb, ub, budget, rng):
    x = 5 * rng.rand(dim) - 2.5
    sigma = 0.1
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        # CMA-ES step
        y = np.random.randn(dim)
        z = np.exp(-0.5 * (y ** 2).sum()) * y / np.sqrt(y ** 2).sum() + x
        f_z = func(z)

        if f_z < best_f:
            best_x = z.copy()
            best_f = f_z

        # Mutation step
        w = rng.uniform(0, 1)
        if w < 0.01 and np.random.rand() < 0.5:
            y = np.random.normal(best_x, sigma)
            x = np.clip(y, lb, ub)

        # Update sigma
        if f_z > best_f:
            sigma *= 0.9

    return best_x
