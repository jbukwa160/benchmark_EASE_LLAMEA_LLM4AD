def algorithm(func, dim, lb, ub, budget, rng):
    def fitness(x):
        return func(x)

    n = len(dim)
    sigma = 0.5 * (ub - lb)
    lambda_ = int(np.floor(budget / (n + 1)))
    mu = lambda_ // 2
    x_mean = np.zeros(n)
    p_c = 1 / (n + 1)

    for _ in range(budget):
        y = rng.normal(size=(lambda_, n)) * sigma + x_mean

        # Clip candidates to [lb, ub]
        y = np.clip(y, lb, ub)

        fit_y = fitness(y)
        f_x = func(x_mean)

        if f_x < fit_y:
            x_mean += (y - x_mean) / lambda_
        else:
            p_c = 1.01
            mu = int(np.floor(budget / (n + 2)))
            x_mean += (x_mean - y) / lambda_

            # Polynomial mutation
            for i in range(n):
                if rng.rand() < p_c:
                    sigma_i = np.abs(y[i] - x_mean[i])
                    xi = np.clip(rng.normal(x_mean[i], sigma_i), lb, ub)
                    y[i] = xi

        fit_y = fitness(np.clip(y, lb, ub))

        # Elitism
        idx = np.argsort(fit_y)[:mu]
        y[idx] = np.clip(y[idx], lb, ub)

    return x_mean
