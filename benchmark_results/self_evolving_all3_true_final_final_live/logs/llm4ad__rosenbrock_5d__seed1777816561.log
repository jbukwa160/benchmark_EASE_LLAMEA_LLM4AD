def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, (1, dim))
    y = x.copy()
    best_x = x
    best_y = func(x)
    while budget > 0:
        for _ in range(dim):
            i = rng.choice(dim)
            z = y.copy()
            z[i] += 0.5 * rng.uniform(-1, 1) * (y[i] - x[i]) + rng.uniform(0, 1) * (best_x[i] - y[i])
            z = clip(z, lb, ub)
            f_z = func(z)
            if f_z < best_y:
                best_y = f_z
                best_x = z
        y = np.array([np.mean(np.vstack((x, best_x)), axis=0), np.min(x, axis=0), np.max(x, axis=0)])
        x = clip(y, lb, ub)
        budget -= 1
    return best_x
