def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    def objective(params):
        params = [p if i % 2 == 0 else p**2 for i, p in enumerate(params)]
        return func(params)

    pop_size = int(budget ** (1 / dim))
    initial_guesses = rng.uniform(lb, ub, size=(pop_size, dim))

    best_solution = None
    best_value = float('inf')
    temperature = budget

    for _ in range(pop_size):
        solution = clip(initial_guesses[_])
        value = objective(solution)

        if value < best_value:
            best_solution = solution.copy()
            best_value = value

    while temperature > 1e-6 * budget:
        temperature *= 0.99
        solutions = [clip(best_solution + rng.uniform(-1, 1, size=dim)) for _ in range(pop_size)]
        values = [objective(solution) for solution in solutions]

        for i, value in enumerate(values):
            if value < best_value:
                best_solution = solutions[i].copy()
                best_value = value

    return np.array(best_solution)
