def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = 0.5 * (lb + ub) + rng.normal(0, 1, size=dim)
    x_best = x.copy()
    f_best = func(x_best)

    T = 100
    alpha = 0.99

    for _ in range(budget):
        for i in range(dim):
            dx = rng.normal(0, 1)
            x_try = clip(x + 1e-3 * dx)

            f_try = func(x_try)
            delta = f_try - f_best

            if delta < 0 or (delta >= 0 and np.exp(-delta / T) > rng.uniform()):
                x_best = x_try.copy()
                f_best = f_try
        x = x_best.copy()

        T *= alpha

    return x_best
