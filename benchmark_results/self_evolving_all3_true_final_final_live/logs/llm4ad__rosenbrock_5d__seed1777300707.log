def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(current_x, sigma):
        candidate_x = current_x + rng.normal(size=dim) * sigma
        return clip(candidate_x)

    def acceptance_probability(old_f, new_f, temperature):
        if old_f < new_f:
            return 1.0
        else:
            return np.exp((new_f - old_f) / temperature)

    def simulated_annealing(func, dim, lb, ub, budget, rng):
        current_x = np.random.uniform(lb, ub, size=dim)
        best_x = current_x.copy()
        current_best_f = func(current_x)
        best_best_f = current_best_f
        temperature = 1.0

        for _ in range(budget):
            candidate_x = generate_candidate(current_x, 2.5 * (ub - lb) / np.sqrt(_ + 1))
            candidate_f = func(candidate_x)

            if rng.uniform(0, 1) < acceptance_probability(current_best_f, candidate_f, temperature):
                current_x = candidate_x
                current_best_f = candidate_f

                if candidate_f < best_best_f:
                    best_x = candidate_x.copy()
                    best_best_f = candidate_f

            if np.random.uniform(0, 1) > 0.9999:
                current_x = rng.uniform(lb, ub, size=dim)

            temperature *= 0.99

        return best_x

    def restart_simulated_annealing(func, dim, lb, ub, budget, rng):
        num_restarts = 10
        for _ in range(num_restarts):
            best_x = simulated_annealing(func, dim, lb, ub, int(budget / num_restarts), rng)
            current_x = best_x.copy()
            current_best_f = func(current_x)

            for _ in range(int(budget * (num_restarts - 1) / num_restarts)):
                candidate_x = generate_candidate(current_x, 2.5 * (ub - lb))
                candidate_f = func(candidate_x)

                if rng.uniform(0, 1) < acceptance_probability(current_best_f, candidate_f, temperature=1.0):
                    current_x = candidate_x
                    current_best_f = candidate_f

            if current_best_f < best_best_f:
                best_best_f = current_best_f
                best_x = current_x.copy()

        return best_x

    def algorithm(func, dim, lb, ub, budget, rng):
        best_x = restart_simulated_annealing(func, dim, lb, ub, budget, rng)
        return best_x

    return algorithm(func, dim, lb, ub, budget, rng)
