def algorithm(func, dim, lb, ub, budget, rng):
    def local_search(x, lb, ub):
        x_new = x + rng.uniform(-0.1, 0.1)
        x_new = np.clip(x_new, lb, ub)
        return func(x_new) < func(x)

    def de(pop_size=10, cr=0.9, f=0.5):
        x = rng.uniform(lb, ub, (pop_size, dim))
        y = x.copy()
        for _ in range(budget // 2):
            for i in range(pop_size):
                r1, r2, r3 = np.random.choice(range(pop_size), size=3, replace=False)
                v = y[r1] + f * (y[r2] - y[r3])
                if rng.uniform(0, 1) < cr:
                    x[i] = local_search(v, lb, ub) and v or x[i]
        return x[np.argmin([func(x_) for x_ in x])]

    def sa(T=100):
        x = rng.uniform(lb, ub, dim)
        T /= 2
        for _ in range(budget // 4):
            x_new = np.copy(x)
            for i in range(dim):
                if rng.random() < 0.1:
                    x_new[i] += rng.uniform(-0.5, 0.5)
                    x_new[i] = local_search(x_new[i], lb, ub) and x_new[i] or x[i]
            delta = func(x_new) - func(x)
            if delta < 0 or np.exp(-delta / T) > rng.random():
                x = x_new
        return x

    return de() if budget >= 50 else sa()
