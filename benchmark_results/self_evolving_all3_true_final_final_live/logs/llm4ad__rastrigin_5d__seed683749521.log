def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    def fitness(x):
        return func(x)

    def clip_x(x):
        return np.clip(x, lb, ub)

    def cma_es(x, sigma, weights=None):
        if weights is None:
            weights = 1 / (sigma ** 2) * np.exp(-np.sum((x - x_best) ** 2, axis=1))
        weights /= np.sum(weights)
        return np.dot(weights, x)

    def de(x, x_best, sigma):
        candidates = []
        for _ in range(dim):
            n = rng.choice(np.arange(dim), size=3, replace=False)
            mutation = np.multiply(sigma, np.random.normal(size=(dim)))
            mutation[n] += (x[n] - x_best[n])
            candidate = x + mutation
            candidates.append(candidate)
        return clip_x(candidates)

    sigma = 1.0
    weights = None

    for _ in range(budget):
        x_new = de(x_best, x_best, sigma)
        f_new = fitness(x_new)
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
        weights = cma_es(x_best, sigma, weights)
        sigma *= 1 + (0.1 / np.sqrt(_ + 1))
        if rng.random() > 0.9:
            sigma /= 2

    return x_best
