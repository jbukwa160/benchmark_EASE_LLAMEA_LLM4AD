def algorithm(func, dim, lb, ub, budget, rng):
    bounds = [(lb, ub)] * dim
    result_de = differential_evolution(func, bounds)
    x_best_de = result_de.x
    
    n_iter = 1
    while n_iter < budget:
        sigma = np.mean(np.abs(x_best_de)) + 0.01
        n_candidates = int(4*dim*(3+np.log(dim)))
        
        candidates = rng.normal(size=(n_candidates, dim))
        candidates *= sigma
        
        for i in range(n_candidates):
            x_candidate = x_best_de + candidates[i]
            
            # Clip candidate to bounds
            x_candidate = np.clip(x_candidate, lb, ub)
            
            if func(x_candidate) < func(x_best_de):
                x_best_de = x_candidate
                
        result_de = differential_evolution(func, bounds)
        if result_de.fun < func(x_best_de):
            x_best_de = result_de.x
            
        n_iter += 1
        
    return np.array([np.round(x_best_de[i], 4) for i in range(dim)])
