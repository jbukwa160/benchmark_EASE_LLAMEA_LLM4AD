def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    x0 = 1 + (ub - lb) * rng.random(dim)
    sigma = 10
    mu = np.zeros(dim)
    c_1 = 1
    c_mu = 2 / (dim + 3.0 / 4.0)
    c_cov = (4 / (dim + 6.0))

    for _ in range(budget):
        x_new = mu + sigma * rng.normal(size=dim)
        f_new = f(x_new)
        if f_new < f(mu):
            mu = x_new
        else:
            x_new = mu + c_1 * np.random.choice([-1, 1], size=dim) * sigma * np.sqrt(np.random.uniform(0, 1, dim))
            f_new = f(x_new)
            if f_new < f(mu):
                mu = x_new

    return mu
