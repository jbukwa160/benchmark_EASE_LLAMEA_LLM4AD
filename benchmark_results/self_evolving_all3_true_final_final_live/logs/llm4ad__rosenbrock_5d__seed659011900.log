def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(current, step_size):
        candidate = current + rng.normal(size=dim) * step_size
        return clip(candidate)

    def evaluate(current, x):
        return func(x)

    current = np.random.uniform(lb, ub, dim)
    best = current.copy()
    temperature = 1.0

    for _ in range(budget):
        candidate = generate_candidate(current, 0.5)
        new_value = evaluate(candidate, candidate)
        value = evaluate(current, current)
        
        if new_value < value:
            current = candidate
            best = np.minimum(best, current)
            
        elif rng.uniform(0, 1) < np.exp((value - new_value) / temperature):
            current = candidate
            
        temperature *= 0.99
        
    return best
