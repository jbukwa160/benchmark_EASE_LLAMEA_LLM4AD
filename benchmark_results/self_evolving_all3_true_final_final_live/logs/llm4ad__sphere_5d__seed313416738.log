def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 5 * (ub - lb) ** 2
    beta = 0.99
    step_size = 0.01 * (ub - lb)

    for _ in range(budget):
        y = x + rng.uniform(-step_size, step_size, size=dim)
        y = np.clip(y, lb, ub)

        f_x = func(x)
        f_y = func(y)

        if f_y < f_x:
            x = y
        elif T * rng.rand() > (f_x - f_y):
            x = y

        T *= beta

    return x
