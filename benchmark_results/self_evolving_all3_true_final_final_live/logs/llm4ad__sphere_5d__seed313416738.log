def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    N = int(budget)
    x_best = np.zeros(D)
    f_best = float('inf')
    
    for i in range(N):
        t = 1 / (i + 1)
        
        while True:
            x_new = x_best.copy()
            for d in rng.choice(D, D, replace=False):
                s = rng.uniform(-5, 5)
                x_new[d] += s
                x_new[d] = np.clip(x_new[d], lb, ub)
            
            f_new = func(x_new)
            
            if f_new < f_best:
                x_best = x_new
                f_best = f_new
                
            delta = f_new - f_best
            p = np.exp(-delta / (t * rng.uniform(1e-6, 1)))
            
            if rng.random() < p or delta <= 0:
                break
    
    return x_best
