def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    for _ in range(budget):
        noise = rng.uniform(size=dim) * (ub - lb)
        new_x = best_x + noise
        new_x = np.clip(new_x, lb, ub)
        new_f = func(new_x)
        if new_f < func(best_x):
            best_x = new_x.copy()
    return best_x
