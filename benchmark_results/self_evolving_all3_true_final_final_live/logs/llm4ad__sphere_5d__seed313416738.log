def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    for _ in range(budget):
        grad = 2 * x
        step_size = 0.01
        new_x = x - step_size * grad
        new_x = np.clip(new_x, lb, ub)
        if func(new_x) < func(best_x):
            best_x = new_x
        x = new_x
    return best_x
