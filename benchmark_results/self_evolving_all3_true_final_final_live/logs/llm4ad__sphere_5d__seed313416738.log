def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    sigma = 1.0
    for _ in range(budget):
        x += sigma * (np.random.rand(dim) - 0.5) * 2
        x = np.clip(x, lb, ub)
        if func(x) < func(np.zeros(dim)):
            sigma *= 1.01
        else:
            sigma /= 1.01
    return x
