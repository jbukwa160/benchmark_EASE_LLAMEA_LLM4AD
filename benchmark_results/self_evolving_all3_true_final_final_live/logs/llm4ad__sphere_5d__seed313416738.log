def algorithm(func, dim, lb, ub, budget, rng):
    x = 5 * (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        s = 0.9 ** (_ / budget) * np.sqrt(np.sum((x - best_x) ** 2))
        delta = 5 * (ub - lb) * rng.randn(dim)
        next_x = x + delta
        next_x = next_x.clip(lb, ub)

        if func(next_x) < best_f:
            best_x = next_x.copy()
            best_f = func(best_x)

        if _ % 100 == 0 or _ == budget - 1:
            print(f'Iteration {_}, Best f: {best_f}')

    return best_x
