def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf + func(np.zeros(dim))
    for _ in range(budget):
        x_candidate = rng.uniform(lb, ub, size=dim)
        f_candidate = func(x_candidate)
        
        if f_candidate < x_best:
            x_best = f_candidate
            x_best_candidate = x_candidate
        
        # Gradient information is not available for Rastrigin function
        # If gradient was available, we would use it to refine the candidate here
        step_size = 0.1
        noise_scale = 0.1
        for i in range(dim):
            if rng.uniform(0, 1) < 0.2:
                x_candidate[i] += step_size * (rng.normal(loc=0, scale=noise_scale) - 0.5)
        
        # Clip candidate to [lb, ub]
        x_candidate = np.clip(x_candidate, lb, ub)
        
        f_candidate = func(x_candidate)
        
        if f_candidate < x_best:
            x_best = f_candidate
            x_best_candidate = x_candidate
    
    return x_best_candidate
