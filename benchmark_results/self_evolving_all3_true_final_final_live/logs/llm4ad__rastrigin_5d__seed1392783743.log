def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x)

    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = evaluate(best_x)
    population_size = 1

    for _ in range(budget):
        offspring_population = np.array([clip(x + (ub - lb) * rng.randn(dim)) for _ in range(population_size)])
        f_values = np.array([evaluate(offspring) for offspring in offspring_population])

        mean_f = np.mean(f_values)
        std_dev = np.std(f_values)

        if std_dev == 0:
            break

        # Selection
        indices = np.argsort(f_values)
        offspring_population = offspring_population[indices]
        f_values = f_values[indices]

        # Mutation
        cov_matrix = (1 / population_size) * np.outer(offspring_population - best_x, offspring_population - best_x)
        mutation_step = np.linalg.cholesky(cov_matrix).dot(rng.randn(dim))

        # Polynomial mutation
        for i in range(population_size):
            r = rng.uniform(0, 1)
            if r < 0.5:
                mutation_step[i] *= (1 + (2 * (f_values[i] - mean_f) / std_dev))
            else:
                mutation_step[i] *= (1 + (2 * std_dev / (f_values[i] - mean_f)))

        # Adapt population size
        if f_values[0] < best_f:
            best_x = offspring_population[0].copy()
            best_f = f_values[0]
        elif f_values[-1] > 3 * best_f and len(f_values) < 100:
            population_size *= 2

    return best_x
