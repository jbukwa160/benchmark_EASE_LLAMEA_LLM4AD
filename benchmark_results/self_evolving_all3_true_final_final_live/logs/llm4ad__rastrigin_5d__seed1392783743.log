def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    n_particles = 50
    max_iter = int(budget / n_particles)
    w_init = 0.9
    c1 = 2
    c2 = 2
    w_min = 0.4
    adapt_step = 10

    best_solution = None
    best_fitness = np.inf

    for _ in range(max_iter):
        particles = rng.uniform(lb, ub, size=(n_particles, dim))
        velocities = np.zeros((n_particles, dim))

        for iter_ in range(adapt_step):
            fitnesses = func(clip(particles))

            best_particle = np.argmin(fitnesses)
            if fitnesses[best_particle] < best_fitness:
                best_solution = clip(particles[best_particle])
                best_fitness = fitnesses[best_particle]

            for i in range(n_particles):
                r1 = rng.uniform(0, 1)
                r2 = rng.uniform(0, 1)

                velocities[i] += w_init * (particles[i] - clip(best_solution)) + c1 * r1 * (
                            clip(particles[best_particle]) - particles[i]) + c2 * r2 * (
                                                  clip(particles[best_particle]) - particles[i])

                particles[i] += velocities[i]

            w_init = max(w_min, w_init - 0.001)

        if (max_iter - iter_) * n_particles <= budget:
            break

    return best_solution
