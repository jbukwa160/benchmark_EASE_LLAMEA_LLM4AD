def algorithm(func, dim, lb, ub, budget, rng):
    def neg_func(x):
        return -func(x)

    best_x = rng.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for _ in range(budget):
        gp = GaussianProcessRegressor(kernel=np.sqrt(10)*RBF(length_scale=[1.0]*dim),
                                      alpha=1e-6,
                                      random_state=rng)
        X = np.vstack([best_x.reshape(-1, dim)])
        y = np.array([best_f])
        gp.fit(X, y)

        mean, std = gp.predict(np.atleast_2d(rng.uniform(lb, ub, size=dim)), return_std=True)
        next_x = rng.choice([rng.normal(mean[i], std[i], size=1)[0] for i in range(dim)],
                            p=[max(0, 1 - np.exp(-10*(x-mean[i])**2/np.std(x)**4)) for i,x in enumerate(rng.uniform(lb, ub, size=dim))])

        next_x = clip(next_x, lb, ub)
        next_f = func(next_x)

        if next_f < best_f:
            best_x = next_x
            best_f = next_f

    return best_x
