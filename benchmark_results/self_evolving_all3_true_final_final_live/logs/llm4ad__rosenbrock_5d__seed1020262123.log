def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def sa_step(x, temp, cooling_rate, rng):
        n = len(x)
        for i in range(n):
            y = x.copy()
            j = rng.randint(0, n)
            k = (rng.rand() * 2 - 1) * 0.5
            y[j] += k
            y = clip(y)
            delta = func(y) - func(x)
            if delta < 0 or rng.rand() < np.exp(-delta / temp):
                x = y
        return x

    def de_step(population, bounds, rng):
        n = len(population)
        crossover_prob = 0.8
        mutation_prob = 0.1
        offspring = []
        for i in range(n):
            j = (rng.randint(0, n) + i) % n
            u, v = population[i], population[j]
            if rng.rand() < crossover_prob:
                k = rng.randint(0, len(u))
                u[k] = np.mean([u[k], v[k]])
            offspring.append(u)
        for u in offspring:
            v = rng.choice(population)
            if rng.rand() < mutation_prob:
                k = rng.randint(0, len(v))
                u[k] += (rng.randn() * 2 - 1) * 0.5
            u = clip(u)
            offspring.append(u)
        return np.array(offspring)

    def optimize(func, dim, lb, ub, budget, rng):
        population_size = int(np.sqrt(budget))
        temp = 10
        cooling_rate = 0.99
        population = [np.random.uniform(lb, ub, dim) for _ in range(population_size)]
        best_x = np.inf * np.ones(dim)
        for i in range(int(budget)):
            if rng.rand() < 0.5:
                x = sa_step(clip(np.array(best_x)), temp, cooling_rate, rng)
            else:
                population = de_step(population, (lb, ub), rng)
                x = clip(population[np.argmin([func(u) for u in population])])
            if func(x) < func(best_x):
                best_x = x
        return best_x

    return optimize(func, dim, lb, ub, budget, rng)
