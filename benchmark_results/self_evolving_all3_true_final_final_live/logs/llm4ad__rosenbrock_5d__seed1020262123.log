def algorithm(func, dim, lb, ub, budget, rng):
    def func_wrapper(x):
        return func(np.clip(x, a_min=lb, a_max=ub))

    x = lb + (ub - lb) * rng.rand(dim)
    c = 0.1
    sigma = np.std(x)
    mu = np.mean(x)

    for _ in range(budget):
        x_new = x + sigma * rng.randn(*x.shape)
        f_new = func_wrapper(x_new)

        if f_new < func_wrapper(x):
            x, f_new = x_new, f_new

        sigma = (1 - c) * sigma + np.sqrt(c * (2 - c)) * np.std(x_new - x)
        mu = (1 - c) * mu + np.sqrt(c * (2 - c)) * np.mean(x_new - x)

    return x
