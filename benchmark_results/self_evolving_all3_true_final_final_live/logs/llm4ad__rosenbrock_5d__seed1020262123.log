def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def generate_candidate(current, sigma):
        candidate = current + sigma * (np.random.rand(dim) - 0.5)
        return clip(candidate, lb, ub)

    best_solution = None
    best_fitness = float('inf')
    
    temperature = 1.0
    step_size = 1.0
    
    for i in range(budget):
        candidate = generate_candidate(current=np.random.rand(dim), sigma=step_size)
        
        fitness = func(candidate)
        
        if fitness < best_fitness:
            best_solution = candidate
            best_fitness = fitness
            
        temperature *= np.exp(-i / budget * 1.0)
        step_size = max(temperature, 0.01)  # minimum step size
        
    return best_solution
