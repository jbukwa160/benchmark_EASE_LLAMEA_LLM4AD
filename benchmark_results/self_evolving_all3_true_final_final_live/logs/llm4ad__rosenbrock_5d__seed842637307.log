def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    x = np.array([np.random.uniform(lb[i], ub[i]) for i in range(n)])
    T = 1000.0
    t = 0
    best_x = x.copy()
    best_f = func(x)

    while t < budget:
        # Simulated Annealing phase
        new_x = x + np.array([np.random.uniform(-1, 1) for i in range(n)])
        new_x = np.clip(new_x, lb, ub)
        delta_f = func(new_x) - best_f
        if delta_f <= 0:
            x = new_x
            if func(x) < best_f:
                best_x = x.copy()
                best_f = func(x)
        else:
            if rng.uniform(0, 1) < np.exp(-delta_f / T):
                x = new_x

        # Differential Evolution phase
        y = x + np.array([np.random.uniform(-1, 1) for i in range(n)])
        z = x + np.array([np.random.uniform(-1, 1) for i in range(n)])

        # Clip to bounds
        y = np.clip(y, lb, ub)
        z = np.clip(z, lb, ub)

        f_y = func(y)
        f_z = func(z)

        if (f_y < best_f and f_y < f_z) or (f_z < best_f and f_y == f_z):
            c1 = 0.5
            c2 = 1.0

            new_x = x + c1 * (y - x) + c2 * (z - x)

            # Clip to bounds
            new_x = np.clip(new_x, lb, ub)
        elif f_y < best_f and f_z > best_f:
            c1 = 0.5
            c2 = 1.0

            new_x = y + c1 * (y - x) + c2 * (z - x)

            # Clip to bounds
            new_x = np.clip(new_x, lb, ub)
        elif f_z < best_f and f_y > best_f:
            c1 = 0.5
            c2 = 1.0

            new_x = z + c1 * (y - x) + c2 * (z - x)

            # Clip to bounds
            new_x = np.clip(new_x, lb, ub)
        else:
            continue

        delta_f = func(new_x) - best_f
        if delta_f <= 0:
            x = new_x
            if func(x) < best_f:
                best_x = x.copy()
                best_f = func(x)

        T *= np.exp(-1e-6 * t)
        t += 1

    return best_x
