def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def objective(x):
        x = clip(x, lb, ub)
        return func(x)

    D = dim
    N = 100  # population size
    M = int(budget / (D * N))  # number of generations

    X = rng.uniform(lb, ub, (N, D))

    for _ in range(M):
        F1 = rng.uniform(0.5, 1)
        F2 = rng.uniform(0.5, 1)

        Y = np.zeros((N, D))
        for i in range(N):
            idx1 = (i + rng.randint(N)) % N
            idx2 = (i + rng.randint(N)) % N

            V = X[idx1] + F1 * (X[idx2] - X[i]) + F2 * (rng.uniform(-1, 1, D))
            Y[i] = clip(V, lb, ub)

        for i in range(N):
            r = np.random.randint(0, N)
            if rng.rand() < 0.5:
                X[i] = Y[r]
            else:
                X[i] = (X[i] + Y[r]) / 2

    return clip(np.mean(X, axis=0), lb, ub)
