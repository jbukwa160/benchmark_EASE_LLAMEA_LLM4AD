def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidates):
        return np.clip(candidates, lb, ub)

    x = 1 + (ub - lb) * np.random.rand(dim)
    best_x = clip(x.copy())
    best_f = func(best_x)

    for _ in range(budget):
        u = rng.uniform(0, 1, size=(dim))
        v = rng.uniform(0, 1, size=(dim))
        c = clip(best_x + (ub - lb) * np.random.randn(dim))

        f_c = func(c)
        if f_c < best_f:
            best_f = f_c
            best_x = c.copy()
        elif rng.rand() < 0.5:
            x1 = clip(best_x + (ub - lb) * u * v**2)
            f_x1 = func(x1)

            if f_x1 < best_f:
                best_f = f_x1
                best_x = x1.copy()

    return best_x
