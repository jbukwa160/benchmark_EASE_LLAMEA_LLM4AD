def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    y_best = float('inf')

    for _ in range(budget):
        x = np.clip(lb + (ub - lb) * rng.uniform(size=dim), a_min=lb, a_max=ub)
        y = func(x)

        if y < y_best:
            x_best = x
            y_best = y

        delta = 0.1 * (ub - lb)
        x_perturbed = np.clip(x_best + rng.uniform(-delta, delta, size=dim), a_min=lb, a_max=ub)
        y_perturbed = func(x_perturbed)

        if y_perturbed < y_best:
            x_best = x_perturbed
            y_best = y_perturbed

    return x_best
