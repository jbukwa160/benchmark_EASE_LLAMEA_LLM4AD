def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = clip(rng.uniform(lb, ub, (1, dim)))
    pop_size = 5
    sigma = 0.5
    mu = 2
    c_c = 0.8
    c_m = 2

    for _ in range(budget):
        y = func(clip(x))
        Z = rng.normal(size=(pop_size, dim))
        X = x + sigma * (1 + 2 / (dim + 1)) ** 0.5 * np.sqrt(np.cov(Z, rowvar=False) + mu * np.eye(dim)) @ Z.T
        y_new = func(clip(X))

        idx = np.argsort(y_new)
        f = y_new[idx]
        X = X[idx]

        if len(f) > pop_size:
            f = f[:pop_size]
            X = X[:pop_size]

        if not np.all(np.isclose(f, 0)):
            x = c_c * X[0] + c_m * np.sum(X / (1 + np.arange(pop_size)) ** 2, axis=0) / np.sum(1 / (1 + np.arange(pop_size)) ** 2)
        else:
            break

    return clip(x)
