def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    best_f = float('inf')

    for _ in range(budget):
        s = (ub - lb) * rng.uniform(size=dim)
        x_new = x + s

        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new

        sigma = 1 / np.sqrt(_ + 1)  # Adaptative decay of the step size
        s = (ub - lb) * rng.uniform(size=dim)
        x += sigma * s

        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)

    return best_x
