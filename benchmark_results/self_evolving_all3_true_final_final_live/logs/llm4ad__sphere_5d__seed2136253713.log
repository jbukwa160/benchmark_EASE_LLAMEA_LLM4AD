def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget - 1):
        # Random step
        r = np.random.normal(size=dim)
        new_x = x + 0.01 * r / np.linalg.norm(r)
        new_x = np.clip(new_x, lb, ub)
        
        f = func(new_x)
        if f < best_f:
            best_f = f
            best_x = new_x

        # Gradient-based step
        d = np.zeros(dim)
        for i in range(10):
            noise = 0.1 * rng.normal(size=dim)
            s = np.clip(x + noise, lb, ub)
            f_s = func(s)
            if f_s < best_f:
                best_f = f_s
                best_x = s

            d += (s - x) / (f_s - func(x))
        new_x = x + 0.001 * d / np.linalg.norm(d)
        new_x = np.clip(new_x, lb, ub)

        f = func(new_x)
        if f < best_f:
            best_f = f
            best_x = new_x

    return best_x
