def algorithm(func, dim, lb, ub, budget, rng):
    def grad(x):
        return 2 * x
    
    def get_candidate(rng):
        candidate = (ub - lb) * rng + lb
        return np.clip(candidate, lb, ub)
    
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = get_candidate(rng)
        
        f = func(x)
        g = grad(x)
        
        if f < best_f:
            best_f = f
            best_x = x
        
        step_size = 0.1
        for i in range(dim):
            candidate1 = x - step_size * g[i]
            candidate2 = x + step_size * g[i]
            
            candidate1 = np.clip(candidate1, lb, ub)
            candidate2 = np.clip(candidate2, lb, ub)
            
            f1 = func(candidate1)
            f2 = func(candidate2)
            
            if f1 < best_f:
                best_f = f1
                best_x = candidate1
            elif f2 < best_f:
                best_f = f2
                best_x = candidate2
                
    return best_x
