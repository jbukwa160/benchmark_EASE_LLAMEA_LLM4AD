def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def fitness(x):
        return func(x)

    pop_size = 100
    mutation_rate = 0.1
    population = rng.uniform(lb, ub, (pop_size, dim))
    best = None

    for _ in range(budget):
        fitness_values = [fitness(clip(individual)) for individual in population]
        sorted_indices = np.argsort(fitness_values)
        population = population[sorted_indices]

        for i in range(pop_size // 2):
            parent1, parent2 = population[i], population[-i - 1]
            child = (parent1 + parent2) / 2
            if rng.rand() < mutation_rate:
                child += rng.normal(size=dim)
            child = clip(child)
            population[i] = population[-i - 1] = child

        best_individual = population[0]
        best_fitness = fitness_values[0]

        if not best or best_fitness > func(best):
            best = np.copy(best_individual)

    return best
