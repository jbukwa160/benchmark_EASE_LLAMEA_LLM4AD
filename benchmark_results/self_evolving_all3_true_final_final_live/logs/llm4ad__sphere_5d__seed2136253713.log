def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = func(x)
    step_size = 1.0
    n_iter = 0

    while n_iter < budget:
        direction = rng.randn(dim)
        step_size *= np.exp(rng.uniform(-0.5, 0))
        new_x = x + step_size * direction
        new_x = np.clip(new_x, lb, ub)

        new_f = func(new_x)
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f

        n_iter += 1
        x = new_x

    return best_x
