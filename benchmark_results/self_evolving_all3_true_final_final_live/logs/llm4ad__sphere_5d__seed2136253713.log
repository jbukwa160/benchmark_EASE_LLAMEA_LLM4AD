def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(x, sigma):
        candidate = x + np.random.normal(size=dim, loc=0, scale=sigma)
        return clip(candidate)

    x_best = np.zeros(dim)
    f_best = func(x_best)
    
    for i in range(budget):
        lambda_ = 10. / (i + 1) ** 0.9
        sigma = (ub - lb) * rng.uniform(0, 1)
        
        population_size = int(lambda_ * dim)
        x_population = np.array([generate_candidate(x_best, sigma) for _ in range(population_size)])
        
        f_values = func(x_population)
        
        idxs = np.argsort(f_values)[:int(population_size/2)]
        x_population = x_population[idxs]
        
        if i % 10 == 0:
            print('Iteration {}: {:.4f}'.format(i, f_best))
        
        for j in range(population_size):
            candidate = generate_candidate(x_population[j], sigma)
            f_value = func(candidate)
            
            if f_value < f_best:
                x_best = candidate
                f_best = f_value
                
    return x_best
