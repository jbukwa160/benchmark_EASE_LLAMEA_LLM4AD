def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    step_size = 1.0
    for _ in range(budget):
        grad = func(x)
        best_x = x.copy()
        best_f = np.sum(best_x**2)

        for i in range(dim):
            x_candidate = x.copy()
            x_candidate[i] += (ub - lb) * rng.uniform(-1, 1) * step_size
            x_candidate = np.clip(x_candidate, lb, ub)
            f_candidate = func(x_candidate)
            if f_candidate < best_f:
                best_x = x_candidate
                best_f = f_candidate

        x = best_x
        if budget - _ <= 1000 and np.random.rand() < 0.1:
            step_size *= 0.9
        elif budget - _ >= 500 and np.random.rand() < 0.1:
            step_size /= 0.9
    return x
