def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    v = np.zeros(dim)
    s = 1.0
    best_x = x.copy()
    best_f = func(x)

    for t in range(budget):
        new_x = clip(x + s * rng.normal(size=dim))
        new_f = func(new_x)

        if new_f < best_f:
            best_f = new_f
            best_x = new_x

        f_x = func(clip(x + v * rng.normal(size=dim)))
        if f_x < best_f and np.random.rand() < 0.1:
            s *= 1.5
            x = clip(x + v)
            continue

        alpha = 2 / (t + 2) - 1
        s = s * np.exp(alpha * (best_f - func(clip(x + v * rng.normal(size=dim)))))

    return best_x
