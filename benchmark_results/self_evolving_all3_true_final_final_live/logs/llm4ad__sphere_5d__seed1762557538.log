def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    for _ in range(budget):
        cov = np.eye(dim)
        for i in range(1000):
            x_new = x_best + rng.normal(size=dim) * np.sqrt(np.diag(cov))
            for j in range(dim):
                if x_new[j] < lb:
                    x_new[j] = 2*lb - x_new[j]
                elif x_new[j] > ub:
                    x_new[j] = 2*ub - x_new[j]
        f_new = func(x_new)
        if f_new < f_best:
            x_best = x_new
            f_best = f_new
        cov += np.outer(rng.normal(size=dim), rng.normal(size=dim))
    return x_best
