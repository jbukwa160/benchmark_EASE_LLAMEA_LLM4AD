def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = np.zeros(dim)
    best_val = float('inf')
    
    for _ in range(budget):
        candidate = np.clip(rng.uniform(lb, ub, size=dim), lb, ub)
        new_val = func(candidate)
        
        if new_val < best_val:
            best_sol = candidate
            best_val = new_val
    
    return best_sol
