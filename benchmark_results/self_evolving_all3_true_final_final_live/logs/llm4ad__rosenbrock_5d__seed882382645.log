def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.sqrt(budget))
    sigma = (ub - lb) * 0.01
    temperature = 1e10

    def clipped_candidate(dim, lower, upper):
        return np.clip(rng.normal(loc=0, scale=sigma, size=dim), lower, upper)

    candidates = [clipped_candidate(dim, lb, ub) for _ in range(pop_size)]
    best_solution = np.array([lb] * dim)
    best_value = float('inf')

    for i in range(budget):
        new_candidates = []
        temperature *= 0.99999

        for candidate in candidates:
            noise = clipped_candidate(dim, -1, 1) * sigma
            new_candidate = candidate + noise
            new_value = func(new_candidate)

            if new_value < best_value:
                best_solution = new_candidate
                best_value = new_value

            if np.random.rand() < 0.5 or (new_value < best_value and temperature > 1):
                new_candidates.append(new_candidate)
            else:
                new_candidates.append(candidate)

        candidates = new_candidates

    return best_solution
