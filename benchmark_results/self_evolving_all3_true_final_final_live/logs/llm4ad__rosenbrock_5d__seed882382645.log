def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 1e5
    alpha = 0.99
    for i in range(budget):
        y = x + (ub - lb) * rng.normal(size=dim)
        y_clipped = np.clip(y, lb, ub)
        f_y = func(y_clipped)
        if f_y < func(x):
            x = y_clipped
        elif rng.rand() < np.exp((func(x) - f_y) / T):
            x = y_clipped
        T *= alpha
    return x
