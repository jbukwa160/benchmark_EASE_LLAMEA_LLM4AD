def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lower, upper):
        return np.clip(candidate, lower, upper)

    def evaluate(x):
        x = [x]
        for i in range(dim - 1):
            x.append(clip(x[i] + 0.01 * (np.random.rand() - 0.5), lb, ub))
        return func(x)

    population_size = int(np.sqrt(budget)) * 2
    initial_population = rng.uniform(lb, ub, size=(population_size, dim))

    best_solution = None
    best_fitness = np.inf

    for _ in range(budget):
        # Differential Evolution step
        solutions = [evaluate(clip(initial_population[i], lb, ub)) for i in range(population_size)]
        fitnesses = np.array(solutions)
        indices = np.argsort(fitnesses)[:population_size // 2]
        new_population = initial_population[indices]

        # Simulated Annealing step
        temperature = 1.0
        while temperature > 1e-6:
            temperature *= 0.99

            for i in range(population_size):
                solution = evaluate(clip(new_population[i], lb, ub))
                new_fitness = np.array(solution)

                if new_fitness < fitnesses[i]:
                    new_population[i] = clip(initial_population[rng.randint(population_size)], lb, ub)
                    solutions[i] = evaluate(new_population[i])
                    fitnesses[i] = np.array(solutions[i])

        # Update best solution
        best_solution_index = np.argmin(fitnesses)
        if fitnesses[best_solution_index] < best_fitness:
            best_fitness = fitnesses[best_solution_index]
            best_solution = clip(initial_population[best_solution_index], lb, ub)

    return np.array(best_solution)
