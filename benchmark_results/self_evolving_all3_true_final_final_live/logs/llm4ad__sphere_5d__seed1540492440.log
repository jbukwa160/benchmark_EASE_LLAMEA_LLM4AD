def algorithm(func, dim, lb, ub, budget, rng):
    def sample(rng, lb, ub):
        return lb + (ub - lb) * rng.uniform(0, 1, size=dim)

    best_x = sample(rng, lb, ub)
    best_y = func(best_x)
    
    for _ in range(budget - 1):
        x = sample(rng, lb, ub)
        
        # Evaluate function at new candidate
        y = func(x)
        
        # If current solution is better than the known best, update it
        if y < best_y:
            best_x = x
            best_y = y
    
    return best_x
