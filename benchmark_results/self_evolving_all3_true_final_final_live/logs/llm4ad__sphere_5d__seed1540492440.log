def algorithm(func, dim, lb, ub, budget, rng):
    def temperature(t, t_max):
        return max(0.01 * t_max, 1e-5)

    x = np.random.uniform(-5.0, 5.0, size=dim)
    t = 100
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = x + rng.normal(size=dim) * 1e-2
        y = np.clip(y, lb, ub)
        
        f = func(y)
        if f < best_f:
            best_x = y.copy()
            best_f = f

        delta = f - best_f
        if delta < 0 or rng.uniform() < np.exp(-delta / temperature(t, 100)):
            x = y.copy()

        t *= 0.99

    return best_x
