def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_candidate(rng):
        return (ub - lb) * rng.rand(dim) + lb

    def generate_neighbour(candidate, rng):
        neighbour = candidate.copy()
        idx = rng.randint(0, dim)
        neighbour[idx] += (ub - lb) * (2.0 * rng.rand() - 1.0)
        return clip(neighbour)

    def simulated_annealing(candidate, current_value, initial_temperature, cooling_rate, rng):
        temperature = initial_temperature
        for _ in range(budget):
            neighbour = generate_neighbour(candidate, rng)
            neighbour_value = func(neighbour)
            if neighbour_value < current_value:
                candidate = neighbour
                current_value = neighbour_value
            else:
                probability = np.exp((current_value - neighbour_value) / temperature)
                if rng.rand() < probability:
                    candidate = neighbour
                    current_value = neighbour_value
            temperature *= cooling_rate

    def random_search(candidate, budget, rng):
        for _ in range(budget):
            new_candidate = generate_initial_candidate(rng)
            new_value = func(new_candidate)
            if new_value < func(candidate):
                candidate = new_candidate
        return candidate

    initial_candidate = generate_initial_candidate(rng)
    current_value = func(initial_candidate)

    simulated_annealing(initial_candidate, current_value, 1.0, 0.99, rng)

    random_search(initial_candidate, budget // 2, rng)

    best_candidate = initial_candidate.copy()
    best_value = func(best_candidate)

    for _ in range(budget - (budget // 2) * 2):
        neighbour = generate_neighbour(initial_candidate, rng)
        neighbour_value = func(neighbour)
        if neighbour_value < best_value:
            best_candidate = neighbour
            best_value = neighbour_value

    return best_candidate
