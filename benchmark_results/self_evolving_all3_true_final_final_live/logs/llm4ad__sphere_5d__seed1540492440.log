def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_x = rng.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for _ in range(budget):
        learning_rate = 1 / (budget + _)
        candidate = best_x + learning_rate * (ub - lb) * rng.normal(size=dim)
        candidate = clip(candidate)
        f_candidate = func(candidate)

        if f_candidate < best_f:
            best_f = f_candidate
            best_x = candidate

    return best_x
