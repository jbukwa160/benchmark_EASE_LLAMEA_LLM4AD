def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.zeros(dim)
    f_best = float('inf')

    for _ in range(budget):
        x = lb + (ub - lb) * rng.rand(dim)
        x = clip(x)

        f = func(x)
        if f < f_best:
            f_best = f
            x_best = x

        radius = 1.0 / (budget - _ + 1) ** 0.5
        x_new = lb + (ub - lb) * rng.randn(dim)
        x_new = clip(x_new)

        for i in range(dim):
            if abs(x_new[i] - x_best[i]) > radius:
                x_new[i] = x_best[i]

        f_new = func(x_new)
        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
