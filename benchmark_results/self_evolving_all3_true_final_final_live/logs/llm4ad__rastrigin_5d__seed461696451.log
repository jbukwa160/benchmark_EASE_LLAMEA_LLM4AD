def algorithm(func, dim, lb, ub, budget, rng):
    n = len(dim)
    init_x = (np.random.rand(n) * (ub - lb)) + lb
    best_x = init_x.copy()
    curr_x = init_x.copy()

    schedule = lambda t: 0.99 ** t
    sigma = 1.0

    for _ in range(budget):
        f_val_curr = func(curr_x)
        f_val_best = func(best_x)

        if f_val_curr < f_val_best:
            best_x = curr_x.copy()

        tau = schedule(_ // 100)
        sigma *= np.sqrt(tau)

        delta = rng.randn(n) * sigma
        new_x = curr_x + delta

        for i in range(n):
            new_x[i] = max(lb, min(ub, new_x[i]))

        f_val_new = func(new_x)
        alpha = 0.9 if rng.rand() < 0.5 else 1.1

        if f_val_new < f_val_curr:
            curr_x = new_x
        elif np.exp((f_val_curr - f_val_new) / (rng.rand() * sigma)) > rng.rand():
            curr_x = new_x

    return best_x
