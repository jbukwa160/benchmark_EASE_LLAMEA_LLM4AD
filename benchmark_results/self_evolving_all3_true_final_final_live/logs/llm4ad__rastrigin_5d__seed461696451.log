def algorithm(func, dim, lb, ub, budget, rng):
    def sample_bounds(bounds):
        return [rng.uniform(lb[i], ub[i]) for i in range(dim)]

    def evaluate(x):
        return func(x)

    x_best = np.array([lb[i] + (ub[i] - lb[i])*rng.uniform(0, 1) for i in range(dim)])
    y_best = evaluate(x_best)
    history = [(x_best.copy(), y_best)]

    gp = None
    iteration = 0

    while iteration < budget:
        iteration += 1
        x = sample_bounds([[-5.0, 5.0] for _ in range(dim)])

        if gp is not None:
            mean, var = gp.predict(x)
            acquisition = np.exp(-mean - 2*var)
            x = x[np.argmax(acquisition)]

        y = evaluate(x)

        history.append((x.copy(), y))

        if y < y_best:
            y_best = y
            x_best = x

        # Update GP model
        X, Y = np.array([h[0] for h in history]), np.array([h[1] for h in history])
        gp = gp if gp is not None else np.random.normal(0, 1, (X.shape[0], dim))
        gp = update_gp(gp, X, Y)

    return x_best
