def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=dim)
    best_fitness = func(x_best)

    N = 10
    n_iter = int(budget / (2 * dim))

    for iter in range(n_iter):
        for _ in range(N):
            x_candidate = x_best.copy()
            delta = rng.normal(size=dim) * 0.1
            index = rng.choice(dim, size=N)
            x_candidate[index] += delta

            # Clip candidates to [lb, ub]
            x_candidate = np.clip(x_candidate, lb, ub)

            fitness_candidate = func(x_candidate)
            if fitness_candidate < best_fitness:
                x_best = x_candidate.copy()
                best_fitness = fitness_candidate

        # Simulated Annealing
        alpha = 0.99
        T = 100 * (iter + 1) / n_iter
        sigma = np.exp(-T)

        for _ in range(dim):
            i = rng.choice(dim)
            x_best[i] += rng.normal(scale=sigma, size=1)
            x_best[i] = np.clip(x_best[i], lb, ub)
            if func(x_best) < best_fitness:
                best_fitness = func(x_best)

    return x_best
