def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 1.0
    mu = rng.uniform(lb, ub, (dim,))
    best = mu.copy()
    success_history = []
    
    for i in range(budget):
        if len(success_history) > 10 and np.random.rand() < 0.1:
            sigma *= 2
        elif len(success_history) > 20 and np.all([x <= y for x, y in zip(mu, best)]):
            sigma /= 2
        
        trial = mu + rng.normal(0, sigma, (dim,))
        clipped_trial = np.clip(trial, lb, ub)
        
        f_trial = func(clipped_trial)
        if f_trial < func(best):
            success_history.append(i)
            best = clipped_trial
        else:
            success_history.append(-1)
    
    return best
