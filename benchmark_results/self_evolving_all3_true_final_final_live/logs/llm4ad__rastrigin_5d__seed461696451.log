def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    n = dim
    mu = 0.5 * (ub - lb)
    sigma = (ub - lb) / 1.4
    x_best = lb + rng.uniform(size=n) * (ub - lb)
    f_best = func(x_best)

    for i in range(budget):
        delta = rng.normal(scale=sigma, size=n)
        x = clip(x_best + mu * delta)

        f = func(x)
        if f < f_best:
            f_best = f
            x_best = x

        sigma = (1 - 1 / (i + 10)) * sigma + 0.01
        mu = (1 - 1 / (i + 10)) * mu + rng.normal(scale=sigma, size=n) / np.sqrt(i + 10)

    return clip(x_best)
