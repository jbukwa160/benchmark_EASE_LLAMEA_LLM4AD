def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def f(x):
        return func(x)

    x = np.random.uniform(lb, ub, size=dim)
    x_best = x.copy()
    y_best = f(x)

    T = 1
    alpha = 0.9

    for _ in range(budget):
        x_new = x + rng.normal(size=dim) * (ub - lb) / 2
        x_new = clip(x_new)
        y_new = f(x_new)

        if y_new < y_best:
            x_best = x_new.copy()
            y_best = y_new

        delta = y_new - y_best
        T *= alpha

        if np.exp(-delta/T) > rng.uniform():
            x = x_new.copy()

    return x_best
