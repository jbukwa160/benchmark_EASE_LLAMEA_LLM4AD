def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(x, alpha, f):
        x_new = x + alpha * (ub - lb) * (np.random.rand(dim) - 0.5)
        return np.clip(x_new, lb, ub)

    def crossover(x1, x2, cr):
        u = rng.uniform(0, 1)
        if u < cr:
            x_new = (x1 + u * (x2 - x1)) / (1 + u)
        else:
            x_new = x1
        return np.clip(x_new, lb, ub)

    def local_search(x, f):
        best_x = x.copy()
        best_f = f(best_x)
        for _ in range(100):
            x_new = mutate(x, 0.5, f)
            if f(x_new) < best_f:
                best_x = x_new
                best_f = f(x_new)
        return best_x

    x = np.random.rand(dim) * (ub - lb) + lb
    f_best = func(x)

    for _ in range(budget):
        y = crossover(mutate(x, 0.5, func), mutate(x, 0.5, func), 0.5)
        y = local_search(y, func)
        if func(y) < f_best:
            x = y
            f_best = func(x)

    return x
