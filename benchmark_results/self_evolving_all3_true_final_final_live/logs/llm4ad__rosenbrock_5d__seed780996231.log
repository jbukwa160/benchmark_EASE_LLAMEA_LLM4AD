def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def objective(x):
        return func(x)

    pop_size = int(1e4)  # initial population size
    max_iter = budget // pop_size
    sigma = 0.5 * (ub - lb)
    F = 0.6

    x_best = np.random.uniform(lb, ub, dim)
    f_best = objective(x_best)

    for iter in range(max_iter):
        trial_pop = np.zeros((pop_size, dim))
        f_trial = np.zeros(pop_size)
        for i in range(pop_size):
            trial_pop[i] = clip(x_best + rng.normal(0, sigma, dim))
            f_trial[i] = objective(trial_pop[i])

        indices = np.argsort(f_trial)[:int(pop_size * 0.1)]
        trial_pop[indices] = x_best

        for i in range(pop_size):
            vector_1 = trial_pop[(i - 1) % pop_size]
            vector_2 = trial_pop[(i + 1) % pop_size]
            candidate = clip(x_best + F * (vector_1 - vector_2))
            f_candidate = objective(candidate)

            if f_candidate < f_trial[i]:
                x_best = candidate
                f_best = f_candidate

    return x_best
