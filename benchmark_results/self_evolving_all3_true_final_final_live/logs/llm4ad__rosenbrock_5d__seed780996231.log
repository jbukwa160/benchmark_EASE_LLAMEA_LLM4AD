def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    best_x = rng.uniform(lb, ub, size=dim)
    best_f = evaluate(best_x)

    learning_rate = 1.0
    for _ in range(budget - 1):
        new_x = np.copy(best_x) + learning_rate * (rng.normal(size=dim) / np.sqrt(dim))
        new_x = clip(new_x)
        new_f = evaluate(new_x)

        if new_f < best_f:
            best_x, best_f = new_x, new_f
            learning_rate *= 0.99

    return best_x
