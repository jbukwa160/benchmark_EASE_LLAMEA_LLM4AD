def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    N = 20
    M = 100
    T = int(budget * 0.8)
    alpha = 0.99

    x0 = (ub - lb) * rng.rand(dim) + lb
    x_best = clip(x0)
    f_best = func(clip(x_best))

    for t in range(T):
        for _ in range(M):
            x1 = np.copy(x_best)
            while True:
                idx = np.random.choice(dim, size=3, replace=False)
                x2 = np.copy(x1[idx])
                for i in range(len(idx)):
                    if rng.rand() < 0.5:
                        x2[i] += (ub - lb) * rng.randn()
                x2 = clip(x2)
                f2 = func(clip(x2))
                if f2 < f_best:
                    x_best = x2
                    f_best = f2
                elif np.random.rand() < np.exp(-(f2-f_best)/T):
                    x1[idx] = x2
        T *= alpha

    for _ in range(budget - T):
        idx = np.random.choice(dim, size=3, replace=False)
        x = np.copy(x_best[idx])
        for i in range(len(idx)):
            if rng.rand() < 0.5:
                x[i] += (ub - lb) * rng.randn()
        x = clip(x)
        f = func(clip(x))
        if f < f_best:
            x_best = x
            f_best = f

    return x_best
