def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    initial_guess = 1 + (ub - lb) * rng.uniform(size=dim)
    best_candidate = clip(initial_guess)
    best_fitness = func(best_candidate)

    for _ in range(budget - 1):
        variation_type = rng.choice(['mutation', 'crossover'])
        
        if variation_type == 'mutation':
            variation = rng.normal(loc=0, scale=np.sqrt(ub - lb), size=dim)
            candidate = clip(initial_guess + variation)
        elif variation_type == 'crossover':
            parent1 = initial_guess
            parent2 = best_candidate
            child = 0.5 * (parent1 + parent2) + rng.normal(loc=0, scale=np.sqrt(ub - lb), size=dim)
            candidate = clip(child)

        fitness = func(candidate)
        
        if fitness < best_fitness:
            initial_guess = candidate
            best_candidate = candidate
            best_fitness = fitness

    return best_candidate
