def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    D = 5 * n
    x_best = np.random.uniform(-5, 5, (1, n))
    f_best = func(x_best[0])
    
    for i in range(budget):
        x_new = x_best + 0.05 * rng.normal(size=(1, n))
        for j in range(n):
            if x_new[0][j] < lb[j]:
                x_new[0][j] = lb[j]
            elif x_new[0][j] > ub[j]:
                x_new[0][j] = ub[j]
        
        f_new = func(x_new[0])
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
        
        # Bayesian optimization part
        sigma = 1.5 / np.sqrt(i + 1)
        cov = np.eye(n) * sigma**2
        mu = rng.normal(size=(1, n))
        
        for _ in range(D):
            z = rng.multivariate_normal(mu.flatten(), cov)
            x_trial = x_best + 0.05 * z
            for j in range(n):
                if x_trial[0][j] < lb[j]:
                    x_trial[0][j] = lb[j]
                elif x_trial[0][j] > ub[j]:
                    x_trial[0][j] = ub[j]
            
            f_trial = func(x_trial[0])
            if f_trial < f_best:
                f_best = f_trial
                x_best = x_trial
                
    return x_best
