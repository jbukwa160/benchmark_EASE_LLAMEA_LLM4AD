def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 10.0
    temperature = 100.0
    alpha = 0.99
    step_size = 1e-4
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = np.random.uniform(lb, ub, size=dim)
        
        if rng.rand() < 0.5:
            # Simulated Annealing
            new_x = x + np.random.normal(0, sigma, size=dim)
            new_x = np.clip(new_x, lb, ub)
            new_f = func(new_x)
            
            delta = new_f - func(x)
            if delta < 0 or rng.rand() < np.exp(-delta / temperature):
                x = new_x
                func_val = new_f
                
        else:
            # CMA-ES
            mean = x
            cov = sigma * np.eye(dim)
            
            for _ in range(int(budget / (dim + 1))):
                z = np.random.normal(0, 1, size=dim)
                offspring = mean + np.dot(cov, z)
                offspring = np.clip(offspring, lb, ub)
                offspring_f = func(offspring)
                
                delta = offspring_f - func_val
                if delta < 0:
                    x = offspring
                    func_val = offspring_f
                    
            # Adapt covariance matrix
            cov = (1 - step_size) * cov + step_size * np.outer(z, z)
            
        if func(x) < best_f:
            best_x = x
            best_f = func(x)
        
        temperature *= alpha
    
    return best_x
