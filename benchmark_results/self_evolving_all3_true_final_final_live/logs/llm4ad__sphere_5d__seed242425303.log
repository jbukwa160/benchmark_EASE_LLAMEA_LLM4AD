def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_x = None
    best_f = float('inf')
    for _ in range(budget):
        x0 = lb + (ub - lb) * rng.rand(dim)
        x_best = x0.copy()
        f_best = func(clip(x_best))

        T = 1.0
        alpha = 0.99

        for _ in range(budget // dim):
            x_new = clip(x0 + rng.randn(dim) * 0.01)
            f_new = func(x_new)

            if f_new < f_best:
                x_best = x_new.copy()
                f_best = f_new
            elif np.random.rand() < np.exp((f_best - f_new) / T):
                x_best = x_new.copy()
                f_best = f_new

            T *= alpha

        if f_best < best_f:
            best_x = x_best.copy()
            best_f = f_best

    return best_x
