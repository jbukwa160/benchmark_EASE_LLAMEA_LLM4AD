def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(1, dim))
    best_x = x.copy()
    best_f = func(x)
    step_size = 1.0
    
    for _ in range(budget):
        # Generate a new candidate
        x_new = x + rng.uniform(-step_size, step_size, size=(1, dim))
        
        # Clip the candidate to the valid bounds
        x_new = np.clip(x_new, lb, ub)
        
        # Evaluate the function at the new candidate
        f_new = func(x_new)
        
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new
        
        # Update the step size based on a simple geometric progression
        step_size *= 0.9
    
    return best_x
