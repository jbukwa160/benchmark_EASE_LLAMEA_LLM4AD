def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    sigma0 = 1.4 * (ub - lb) / np.sqrt(n)
    c_c = (ub - lb) / 2
    D = n * np.eye(n)
    
    x_best = np.random.uniform(lb, ub, size=(n,))
    f_best = func(x_best)
    budget -= 1
    
    for _ in range(budget):
        y = rng.normal(size=n)
        z = sigma0 * y + c_c
        x_candidate = x_best + z
        
        # Clip candidates to [lb, ub]
        x_candidate = np.clip(x_candidate, lb, ub)
        
        f_candidate = func(x_candidate)
        
        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate
            
    return x_best
