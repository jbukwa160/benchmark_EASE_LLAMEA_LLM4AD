def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    y = func(x)

    learning_rate = 1.0
    temperature = 100.0

    for _ in range(budget):
        v = rng.normal(size=dim)
        for i in range(dim):
            x_new = clip(x + learning_rate * v[i] / np.linalg.norm(v[:i+1]))
            y_new = func(x_new)

            if y_new < y:
                y = y_new
                x = x_new

            elif rng.rand() < np.exp((y - y_new) / temperature):
                y = y_new
                x = x_new

        learning_rate *= 0.99
        temperature *= 0.9999

    return clip(x)
