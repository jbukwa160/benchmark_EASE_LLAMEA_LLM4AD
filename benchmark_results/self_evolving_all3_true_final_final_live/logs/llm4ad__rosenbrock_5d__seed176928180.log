def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def objective(x):
        return func(x)

    x0 = np.random.uniform(lb, ub, size=dim)
    best_x = x0.copy()
    best_f = objective(best_x)

    t_max = 1.0
    t_min = 1e-6
    alpha = 0.99

    for _ in range(budget):
        t = max(t_min, min(t_max, np.power(alpha, _)))

        # Simulated Annealing (SA) step
        new_x = x0 + t * rng.normal(size=dim)
        new_x = clip(new_x)

        if objective(new_x) < best_f:
            x0 = new_x.copy()
            best_x = new_x.copy()
            best_f = objective(best_x)

        # Nelder-Mead Simplex Algorithm (NMSA) step
        simplex_size = 20
        simplex = np.vstack([best_x + t * rng.normal(size=dim), 
                             np.tile(ub, (1, dim)), 
                             np.tile(lb, (1, dim))])
        for _ in range(simplex_size):
            new_simplex = np.zeros((simplex.shape[0], dim))
            for i in range(dim):
                new_simplex[:, i] = simplex[:, i]
                if i > 0:
                    new_simplex[i-1, i] += t * rng.normal(size=dim)
                    new_simplex[i+1, i] -= t * rng.normal(size=dim)
                new_simplex = clip(new_simplex)

            # Refine the best point
            for i in range(simplex.shape[0]):
                if objective(new_simplex[i]) < best_f:
                    simplex[i] = new_simplex[i].copy()
                    if objective(simplex[i]) < best_f:
                        x0 = simplex[i].copy()
                        best_x = simplex[i].copy()
                        best_f = objective(best_x)

    return best_x
