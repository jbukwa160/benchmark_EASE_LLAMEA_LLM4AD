def algorithm(func, dim, lb, ub, budget, rng):
    def get_next_point(x_best, n_samples, bounds):
        x_new = []
        for i in range(n_samples):
            x_sample = rng.uniform(lb, ub, size=dim)
            if len(x_best) > 0:
                x_diff = np.array(x_sample) - np.array(x_best[-1])
                distance = np.linalg.norm(x_diff)
                if distance < 1e-2:
                    continue
            x_new.append(x_sample)
        return np.stack(x_new, axis=0)

    def gp_mean(y_samples):
        mean = np.mean(y_samples)
        return mean

    def gp_variance(y_samples):
        var = np.var(y_samples)
        return var

    def acquisition_function(mu_gp, sigma_gp, x_best, bounds):
        # Acquisition function based on the probability of improvement
        pi = norm.cdf(0 - (mu_gp - 1e-3))
        # Add a nugget to ensure positive variance for numerical stability
        sigma_gp += 1e-6
        return mu_gp + 0.01 * np.sqrt(sigma_gp) * np.exp(-((bounds[1] - bounds[0])**2 / (4 * sigma_gp)) * ((x_best - bounds[0])/(bounds[1]-bounds[0]))**2)

    n_samples = int(budget ** (1/dim))
    x_best = None
    y_best = np.inf

    for t in range(n_samples):
        # Random search for initial exploration
        if len(x_best) == 0 or rng.rand() < 0.5:
            x_sample = rng.uniform(lb, ub, size=dim)
            y_sample = func(x_sample)
            if y_sample < y_best:
                x_best = [x_sample]
                y_best = y_sample
        else:
            # GP regression and optimization of acquisition function
            x_samples = get_next_point(x_best[-1], n_samples - len(x_best), (lb, ub))
            y_samples = func(x_samples)
            mu_gp = gp_mean(y_samples)
            sigma_gp = gp_variance(y_samples)
            acquisition_values = acquisition_function(mu_gp, sigma_gp, x_best[-1], (lb, ub))
            idx_max_acquisition = np.argmax(acquisition_values)
            x_sample = x_samples[idx_max_acquisition]
            y_sample = func(x_sample)
            if y_sample < y_best:
                x_best.append(x_sample)
                y_best = y_sample

    return np.array(x_best[-1])
