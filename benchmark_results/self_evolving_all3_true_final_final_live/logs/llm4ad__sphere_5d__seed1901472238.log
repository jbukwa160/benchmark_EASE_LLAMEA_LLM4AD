def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_candidate(x, mu):
        for i in range(dim):
            sigma = 0.1 * (ub - lb)
            candidate_i = x[i] + mu * sigma
            yield clip(candidate_i)

    def differential_evolution_step(x, budget_remaining):
        for _ in range(budget // 2):
            y = np.array([next(generate_candidate(x, rng.uniform(-1, 1))) for _ in range(dim)])
            if func(y) < func(x):
                x = y
            elif rng.random() < 0.5:
                break
        return x

    def simulated_annealing_step(x, budget_remaining):
        temperature = 100
        while budget_remaining > 0 and temperature > 1e-3:
            new_temperature = temperature * np.exp(-temperature)
            y = next(generate_candidate(x, rng.uniform(-1, 1)))
            if func(y) < func(x):
                x = y
            elif rng.random() < np.exp((func(x) - func(y)) / new_temperature):
                x = y
            budget_remaining -= 1
            temperature *= 0.999
        return x

    population_size = int(np.sqrt(budget))
    x = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    for _ in range(population_size):
        differential_evolution_step(x, budget)
        x = simulated_annealing_step(x, budget)

    return x
