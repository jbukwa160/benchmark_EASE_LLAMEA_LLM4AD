def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    best_f = float('inf')
    
    for _ in range(budget):
        learning_rate = 1 / (np.sqrt(_ + 1) * rng)
        
        if rng.uniform(0, 1) < 0.5:
            new_x = x + np.random.normal(size=dim) * learning_rate
        else:
            new_x = x - np.random.normal(size=dim) * learning_rate
        
        # Clip bounds
        new_x = np.clip(new_x, lb, ub)
        
        f_new = func(new_x)
        
        if f_new < best_f:
            best_f = f_new
            best_x = new_x.copy()
    
    return best_x
