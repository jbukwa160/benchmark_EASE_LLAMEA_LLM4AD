def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidates):
        return np.clip(candidates, lb, ub)

    def lhs(n_samples, n_dim):
        samples = rng.uniform(0, 1, size=(n_samples, n_dim))
        order = np.argsort(np.tile(np.arange(1, n_samples+1), (n_dim, 1)).T, axis=1)
        return samples[np.arange(n_samples)[:, None], order]

    def simulated_annealing(func, x0, lb, ub, max_iter):
        current_solution = x0
        temperature = 100
        for _ in range(max_iter):
            new_candidate = clip(x0 + rng.uniform(-1, 1, size=dim))
            delta = func(new_candidate) - func(current_solution)
            if delta < 0 or np.random.rand() < np.exp(-delta / temperature):
                current_solution = new_candidate
            temperature *= 0.99
        return current_solution

    x_best = np.zeros(dim)
    f_best = float('inf')
    for _ in range(budget):
        candidates = clip(lhs(100, dim))
        solutions = [simulated_annealing(func, c, lb, ub, 10) for c in candidates]
        f_values = [func(s) for s in solutions]
        idx = np.argmin(f_values)
        if f_values[idx] < f_best:
            x_best = solutions[idx]
            f_best = f_values[idx]

    return x_best
