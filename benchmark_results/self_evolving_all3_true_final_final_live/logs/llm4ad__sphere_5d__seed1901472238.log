def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    x = np.zeros(dim)
    best = x.copy()
    f_best = func(best)

    for _ in range(budget):
        y = x + 0.5 * (ub - lb) * (rng.rand(dim) - 0.5)
        y = clip(y)
        f_y = func(y)

        if f_y < f_best:
            best = y.copy()
            f_best = f_y

    return best
