def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    for _ in range(budget):
        x_try = clip(x_best + 0.1*rng.normal(size=dim), lb, ub)
        
        if rng.random() < 0.5:
            x_try = (x_try + x_best) / 2
        
        f_try = func(clip(x_try + 0.1*rng.normal(size=dim), lb, ub))
        
        if f_try < f_best:
            x_best = x_try
            f_best = f_try

    return x_best
