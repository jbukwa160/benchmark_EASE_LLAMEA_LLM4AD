def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(current, step_size):
        candidate = current + step_size * rng.normal(size=dim)
        return np.clip(candidate, a_min=lb, a_max=ub)

    x_best = rng.uniform(low=lb, high=ub, size=dim)
    f_best = func(x_best)
    best_history = [f_best]

    for _ in range(budget):
        step_size = 0.1 * (ub - lb) / np.sqrt(np.random.rand() + 1e-8)

        for i in range(dim):
            candidate = get_candidate(x_best, step_size)
            f_candidate = func(candidate)

            if f_candidate < f_best:
                x_best = candidate
                f_best = f_candidate

            step_size *= np.exp(-0.01 * (_ / budget + 1))

        best_history.append(f_best)

    return x_best
