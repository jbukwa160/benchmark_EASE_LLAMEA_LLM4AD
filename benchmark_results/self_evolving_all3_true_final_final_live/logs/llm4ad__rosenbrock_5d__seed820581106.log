def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    v = rng.normal(size=dim) * 0.1
    sigma = 1.0

    for _ in range(budget):
        f_x = func(x)
        f_v = func(clip(x + v))

        if f_v < f_x:
            x = clip(x + v)
            v = 2 * rng.normal(size=dim) - 1
        else:
            sigma *= np.exp(-f_x / (1 + f_v) * 1e-4)

        for _ in range(dim):
            y = rng.uniform(0, 1, size=dim)
            idx = np.argsort(y)[np.random.choice(np.arange(1, dim), size=np.random.randint(1, dim))]

            x_new = clip(x + sigma * (rng.normal(size=dim) + v[idx]))

            f_x_new = func(x_new)

            if f_x_new < f_v:
                f_v = f_x_new
                v = x_new - x

    return clip(x)
