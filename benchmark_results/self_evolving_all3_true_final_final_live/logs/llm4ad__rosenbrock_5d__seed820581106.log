def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def fitness(x):
        return func(x)

    x = rng.uniform(lb, ub, size=dim)
    sigma = 1.0
    mu = 0.5 * (ub - lb)
    c_m = 0.8 * np.eye(dim) + 0.2 * np.ones((dim, dim))
    damps = 1e-4

    for _ in range(budget):
        x_new = clip(x + sigma * rng.normal(size=dim))
        f_new = fitness(x_new)
        f_x = fitness(clip(x))

        if f_new < f_x:
            x = x_new
            mu += 0.01 * (x - np.mean(x, axis=0))
            c_m += 0.001 * (np.outer(x - np.mean(x, axis=0), x - np.mean(x, axis=0)) - c_m)
        else:
            sigma *= np.exp(-f_new / (1 + f_x) * damps)

    return clip(x)
