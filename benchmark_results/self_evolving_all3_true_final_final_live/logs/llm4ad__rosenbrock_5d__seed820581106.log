def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(size, dim, lb, ub):
        return rng.uniform(lb, ub, (size, dim))

    def calculate_fitness(individuals, func):
        fitness = np.array([func(individual) for individual in individuals])
        return fitness

    def select_parents(fitness, size, rng):
        indices = np.argsort(fitness)[:size]
        parents = individuals[indices]
        return parents

    def crossover(parents, size, rng):
        children = np.zeros((size, dim))
        for i in range(size):
            if rng.random() < 0.5:
                idx1, idx2 = rng.choice(range(len(parents)), 2, replace=False)
                children[i] = (parents[idx1] + parents[idx2]) / 2
            else:
                idx1, idx2 = rng.choice(range(len(parents)), 2, replace=False)
                children[i] = np.where(rng.random((dim)) < 0.5, parents[idx1], parents[idx2])
        return children

    def mutate(individuals, size, dim, lb, ub, rng):
        mutants = individuals.copy()
        for i in range(size):
            idx = rng.choice(range(dim))
            if rng.random() < 0.01:
                mutants[i][idx] += rng.uniform(-1, 1)
                mutants[i][idx] = np.clip(mutants[i][idx], lb, ub)
        return mutants

    def generate_new_population(parents, children, mutants, size):
        new_population = np.concatenate((parents[:size//2], children, mutants))
        return new_population

    individuals = generate_initial_population(100, dim, lb, ub)
    fitness = calculate_fitness(individuals, func)

    for _ in range(budget):
        parents = select_parents(fitness, 50, rng)
        children = crossover(parents, 50, rng)
        mutants = mutate(parents, 50, dim, lb, ub, rng)
        individuals = generate_new_population(parents, children, mutants, 100)
        fitness = calculate_fitness(individuals, func)

    best_individual = individuals[np.argmin(fitness)]
    return best_individual
