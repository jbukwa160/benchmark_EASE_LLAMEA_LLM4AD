def algorithm(func, dim, lb, ub, budget, rng):
    def mutation_cmaES(pop, mu, sigma):
        n = pop.shape[0]
        for i in range(n):
            noise = rng.normal(0, 1, (dim,))
            noise *= sigma
            pop[i] += noise[:dim]

    def crossover_DE(pop):
        n = pop.shape[0]
        children = np.zeros((n, dim))
        for i in range(n):
            parent_idx = rng.choice(n, 2)
            children[i] = 0.5 * (pop[parent_idx[0]] + pop[parent_idx[1]])
        return children

    def clip(pop, lb, ub):
        return np.clip(pop, a_min=lb, a_max=ub)

    pop_size = int(budget ** 0.5)
    mu = 0.8
    sigma = 0.2
    DE_c = 1.0
    pop = rng.uniform(lb, ub, (pop_size, dim))
    best_individual = pop[rng.choice(pop_size)]
    best_fitness = func(best_individual)

    for _ in range(budget):
        children = np.zeros((pop_size, dim))
        for i in range(pop_size):
            mutation_cmaES(children[i], mu, sigma)
            children[i] += crossover_DE(pop[i])
            children[i] = clip(children[i], lb, ub)
        
        fitnesses = func(children)
        argmin_idx = np.argmin(fitnesses)
        best_individual = children[argmin_idx]
        best_fitness = fitnesses[argmin_idx]

    return best_individual
