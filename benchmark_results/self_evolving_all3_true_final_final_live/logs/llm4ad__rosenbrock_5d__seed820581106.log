def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        alpha = 1 / (i + 1) ** 0.5
        delta = rng.uniform(-alpha * 1, alpha * 1)
        new_x = np.clip(x + delta, lb, ub)

        f_new = func(new_x)
        if f_new < best_f:
            best_f = f_new
            best_x = new_x

        u = rng.uniform(0, 1)
        if u <= 0.02 or i == budget - 1:  # 2% chance to accept new solution in each iteration
            x = new_x.copy()

    return best_x
