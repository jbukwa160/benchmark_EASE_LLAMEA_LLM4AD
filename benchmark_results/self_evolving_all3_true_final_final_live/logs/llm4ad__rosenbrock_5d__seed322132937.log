def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(dim, lb, ub, rng):
        population = np.zeros((budget, dim))
        for i in range(budget):
            population[i] = lb + (ub - lb) * rng.rand()
        return population

    def simulate_annealing(population, func, lb, ub, budget, rng):
        temperature = 1.0
        for _ in range(budget):
            idx = np.random.choice(budget, 2, replace=False)
            child = clip(population[idx[0]] + (population[idx[1]] - population[idx[0]]) * rng.rand())
            if func(child) < func(clip(population[idx[0]])):
                population[idx[0]] = child
            temperature *= 0.99

    def differential_evolution(population, func, lb, ub, budget, rng):
        for _ in range(budget // 10):
            idx = np.random.choice(budget, 3, replace=False)
            child = clip(population[idx[0]] + rng.uniform(0, 1) * (population[idx[1]] - population[idx[2]]))
            if func(child) < func(clip(population[idx[0]])):
                population[idx[0]] = child

    population = generate_initial_population(dim, lb, ub, rng)
    simulate_annealing(population, func, lb, ub, budget // 10, rng)
    differential_evolution(population, func, lb, ub, (budget - budget // 10) * 9, rng)
    return clip(population[np.argmin([func(clip(ind)) for ind in population])])
