def algorithm(func, dim, lb, ub, budget, rng):
    n = int(budget ** 0.5)
    D = dim
    K = n * [1]
    mu = np.zeros(n)
    sigma = np.ones(n) * 10
    x_best = np.random.uniform(lb, ub, (D,))
    y_best = func(x_best)

    for t in range(n):
        # Update GP model parameters
        K[t] += rng.uniform(0, 1e-6)
        mu[t] = y_best - sigma[t] ** 2 / K[t]
        sigma[t] *= np.sqrt(K[t])

        # Generate new candidate
        x_new = np.random.normal(mu[t], sigma[t], (D,))
        x_new = np.clip(x_new, lb, ub)

        # Evaluate new candidate and update best solution
        y_new = func(x_new)
        if y_new < y_best:
            x_best = x_new
            y_best = y_new

    return x_best
