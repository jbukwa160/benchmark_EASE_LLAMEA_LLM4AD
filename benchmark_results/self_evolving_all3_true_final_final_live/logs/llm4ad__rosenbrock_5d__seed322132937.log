def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 1
    
    # Initialize population with random candidates
    x_best = rng.uniform(lb, ub, size=dim)
    
    for _ in range(budget - 1):
        # Create new candidate by perturbing the best one
        x_new = x_best + rng.uniform(-0.5, 0.5, size=dim)
        
        # Clip candidates to [lb, ub]
        x_best_clipped = np.clip(x_best, lb, ub)
        x_new_clipped = np.clip(x_new, lb, ub)
        
        # Evaluate new candidate
        f_new = func(x_new_clipped)
        f_best = func(x_best_clipped)
        
        # Update best candidate if necessary
        if f_new < f_best:
            x_best = x_new_clipped
    
    return x_best
