def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(x_best, x_curr, f_best, bounds, mu, sigma, rng):
        z = np.zeros(dim)
        for i in range(dim):
            if rng.random() < 0.5:
                z[i] = rng.uniform(lb[i], ub[i])
            else:
                z[i] = x_best[i] + mu * (x_curr[i] - x_best[i]) + sigma * rng.normal(size=1)[0]
        return np.clip(z, bounds[0], bounds[1])

    def crossover(x1, x2):
        u = rng.uniform(0, 1, dim)
        return x1 + u * (x2 - x1)

    best_x = np.zeros(dim)
    best_f = float('inf')

    for _ in range(budget):
        x_best = np.array([rng.uniform(lb[i], ub[i]) for i in range(dim)])
        f_best = func(x_best)

        for _ in range(1000): # 1000 iterations
            x_curr = generate_candidate(best_x, x_best, best_f, (lb, ub), 0.5, 1, rng)
            y = crossover(x_curr, best_x)
            y_eval = func(y)

            if y_eval < f_best:
                f_best = y_eval
                best_x = y

    return best_x
