def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    x_best = clip(x.copy())
    f_best = func(clip(x))
    T = 1e2
    alpha = 0.99

    for _ in range(budget):
        T *= alpha
        if T < 1e-3:
            break

        y = x + rng.normal(size=dim)
        y_best = clip(y.copy())
        f_y = func(clip(y))

        if f_y < f_best:
            x_best = y_best
            f_best = f_y

        elif np.random.rand() < np.exp((f_best - f_y) / T):
            x = y.copy()

    return x_best
