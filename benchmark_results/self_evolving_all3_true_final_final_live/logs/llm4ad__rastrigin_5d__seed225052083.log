def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(n, dim):
        x = rng.uniform(lb, ub, (n, dim))
        return x

    def evaluate(x):
        return func(x)

    def differential_evolution(population, budget):
        while budget > 0:
            for i in range(len(population)):
                n1 = np.random.choice(len(population), replace=False)
                n2 = np.random.choice(len(population), replace=False)
                if n1 != i and n2 != i:
                    mutation = population[n1] + rng.uniform(-1, 1) * (population[n2] - population[n1])
                    mutation = clip(mutation)
                    population[i] = evaluate(mutation) < evaluate(population[i]) and mutation or population[i]
            budget -= 1
        return population

    def gaussian_mixture_model(population):
        while True:
            n = len(population)
            mean = np.mean(np.array([x for x in population if evaluate(x) < func(np.zeros(dim))]), axis=0)
            sigma = np.std(np.array([x for x in population if evaluate(x) < func(np.zeros(dim))]), axis=0)
            new_population = []
            for _ in range(n):
                weight = rng.uniform(0, 1)
                if weight < 0.5:
                    x = mean + rng.normal(0, sigma, dim)
                    x = clip(x)
                else:
                    x = np.random.choice([x for x in population if evaluate(x) < func(np.zeros(dim))])
                new_population.append(x)
            new_population = differential_evolution(new_population, budget)
            if len(set([evaluate(x) for x in new_population])) == 1:
                return new_population

    initial_population = generate_initial_population(1000, dim)
    best_solution = np.min(np.array([evaluate(x) for x in initial_population]))
    population = [x for x in initial_population if evaluate(x) < best_solution]
    best_solution = differential_evolution(population, budget)
    return np.min(best_solution)
