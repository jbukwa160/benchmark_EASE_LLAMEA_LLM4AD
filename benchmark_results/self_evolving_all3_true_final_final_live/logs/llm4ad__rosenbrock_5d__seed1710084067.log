def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    best = None
    for i in range(budget):
        if best is None or objective(np.array([1, 1, 1, 1, 1])) < objective(best):
            best = np.copy(np.array([1, 1, 1, 1, 1]))

        pca = PCA(n_components=dim)
        X_train = rng.uniform(lb, ub, (1000, dim))
        Y_train = func(X_train)

        X_pca = pca.fit_transform(X_train)
        gp = GaussianProcessRegressor(kernel=RBF(), n_restarts_optimizer=9)
        gp.fit(X_pca, Y_train)

        x_new = pca.inverse_transform(gp.sample_fi(n_samples=1))
        if objective(x_new) < objective(best):
            best = np.copy(x_new)

        learning_rate = 0.01 / (1 + i * 0.001)
        for j in range(dim):
            mu, sigma = gp.predict(pca.transform(np.array([best])))
            x_try = np.copy(best)
            x_try[j] += learning_rate * (mu - objective(x_try))
            if lb <= x_try[j] <= ub:
                if objective(x_try) < objective(best):
                    best = np.copy(x_try)

    return best
