def algorithm(func, dim, lb, ub, budget, rng):
    def simplex_search(x0, sigma):
        x = [x0 + 1.5 * np.random.normal(0, sigma, dim) for _ in range(dim+1)]
        while True:
            y = np.array([func(np.clip(xi, lb, ub)) for xi in x])
            idx_sorted = np.argsort(y)
            if y[idx_sorted[0]] - y[idx_sorted[-1]] < 1e-6 * max(y):
                break
            s = 2 / (dim + 1) * ((np.sum(x[i] > x[j]) + 0.5) for i in range(dim+1) for j in range(i))
            for i, j in enumerate(s):
                if np.random.uniform() < 0.25:
                    x[i] = 2*x[idx_sorted[0]] - x[i]
                else:
                    x[i] += (x[j] - x[i]) * np.sign(np.random.normal(0, 1) + np.random.normal(0, 1))
            sigma *= 0.9
        return x[0]

    budget_remain = budget
    best_x = None
    best_f = float('inf')
    while budget_remain > 0:
        if rng.random() < 0.2:
            sigma = (ub - lb) * rng.uniform()
            new_x = simplex_search(rng.uniform(lb, ub, dim), sigma)
            f_new = func(new_x)
            if f_new < best_f:
                best_x = new_x
                best_f = f_new
        else:
            step_size = np.random.uniform(0.01, 1) * (ub - lb)
            new_x = best_x + rng.uniform(-1, 1) * step_size
            f_new = func(new_x)
            if f_new < best_f:
                best_x = new_x
                best_f = f_new
        budget_remain -= 1

    return np.clip(best_x, lb, ub)
