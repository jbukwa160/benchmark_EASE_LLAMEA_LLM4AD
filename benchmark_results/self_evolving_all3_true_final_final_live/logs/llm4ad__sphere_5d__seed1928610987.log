def algorithm(func, dim, lb, ub, budget, rng):
    best_x = -np.ones(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        # Generate a new candidate within the current bounds
        x = np.clip(np.random.uniform(lb, ub, size=dim), lb, ub)
        
        # Evaluate the function at the candidate
        f = func(x)
        
        if f < best_f:
            best_x = x
            best_f = f
        
        # Update bounds by iteratively refining them based on the new candidate
        for i in range(dim):
            if x[i] != lb and np.random.rand() < 0.5:
                lb[i] -= (x[i] - lb[i]) / rng
            elif x[i] != ub and np.random.rand() < 0.5:
                ub[i] += (ub[i] - x[i]) / rng
    
    return best_x
