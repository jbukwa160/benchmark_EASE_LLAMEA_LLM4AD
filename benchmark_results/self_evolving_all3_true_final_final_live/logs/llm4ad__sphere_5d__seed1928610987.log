def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    temp = 1.0
    restarts = 0
    for _ in range(budget):
        if rng.random() < 0.2:
            # Controlled Restart
            x = np.random.uniform(lb, ub, size=dim)
            restarts += 1
        else:
            # Simulated Annealing with Adaptive Cooling Schedule
            delta_f = func(x) - best_f
            if delta_f <= 0 or rng.random() < np.exp(-delta_f / temp):
                best_x = x.copy()
                best_f = func(best_x)
            temp *= 0.99  # adaptive cooling schedule
        x = clip(x)
    return best_x
