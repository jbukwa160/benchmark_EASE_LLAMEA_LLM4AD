def algorithm(func, dim, lb, ub, budget, rng):
    n = int(np.ceil(budget ** (1 / dim)))
    T0 = 1000
    alpha = 0.99
    sigma = 0.5
    x_best = -np.ones(dim)
    f_best = float('inf')

    for i in range(n):
        x_candidate = rng.uniform(lb, ub, size=dim)

        while True:
            dist = np.linalg.norm(x_candidate - x_best)
            if dist > sigma * T0 ** (1 / (i + 1)):
                break
            x_candidate = rng.uniform(lb, ub, size=dim)

        f_candidate = func(x_candidate)

        if f_candidate < f_best:
            f_best = f_candidate
            x_best = x_candidate

        T = T0 * alpha ** i

        if np.random.rand() < np.exp(-(f_candidate - f_best) / T):
            x_best = (x_best + x_candidate) / 2

    return x_best
