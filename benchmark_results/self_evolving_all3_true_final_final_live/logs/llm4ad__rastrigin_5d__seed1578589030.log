def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    alpha_min = 0.1
    alpha_max = 2.5
    t_max = budget / (10 * dim)
    T = 20
    sigma = np.sqrt((ub - lb) ** 2 / dim)

    for _ in range(budget):
        for _ in range(T):
            v = x + rng.uniform(-1, 1, size=dim) * sigma
            v = clip(v)
            f = func(v)

            if f < best_f:
                best_x = v.copy()
                best_f = f

            if rng.uniform(0, 1) < np.exp(-(f - best_f) / T):
                x = v.copy()

        alpha = alpha_max * (1 - _ / budget) ** 2
        sigma *= alpha

    return best_x
