def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def multi_start_evolutionary_algorithm(pop_size, max_iter, rng):
        pop = rng.uniform(lb, ub, (pop_size, dim))
        for _ in range(max_iter):
            pop = clip(pop)
            scores = [func(x) for x in pop]
            order = np.argsort(scores)[:int(0.1 * pop_size)]
            pop[order] = rng.uniform(lb, ub, (len(order), dim))
        return pop[np.argmin(scores)]

    def local_search(x, rng):
        while True:
            step = rng.uniform(-1, 1, size=dim)
            x_new = clip(x + step)
            if func(x_new) < func(x):
                x = x_new
            else:
                break
        return x

    best_x = None
    for _ in range(budget // (dim * pop_size)):
        pop = multi_start_evolutionary_algorithm(pop_size, max_iter, rng)
        scores = [func(x) for x in pop]
        order = np.argsort(scores)
        pop[order] = pop[:pop_size]
        scores = scores[:pop_size]
        for i in range(pop_size):
            x = local_search(pop[i], rng)
            if func(x) < scores[i]:
                best_x = x
    return best_x
