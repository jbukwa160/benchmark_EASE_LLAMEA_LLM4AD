def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    x_best = np.zeros(n)
    f_best = float('inf')
    
    T = 1000
    alpha = 0.9
    
    for t in range(budget):
        x_candidate = x_best + (ub - lb) * rng.uniform(-1, 1, n)
        x_candidate = np.clip(x_candidate, lb, ub)
        
        f_candidate = func(x_candidate)
        
        if f_candidate < f_best:
            f_best = f_candidate
            x_best = x_candidate
            
        delta_f = f_candidate - f_best
        
        if delta_f <= 0 or rng.uniform(0, 1) < np.exp(-delta_f / T):
            x_best = x_candidate
            f_best = f_candidate
            
        T *= alpha
        
    return x_best
