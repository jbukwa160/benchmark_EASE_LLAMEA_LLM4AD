def algorithm(func, dim, lb, ub, budget, rng):
    n = int(np.ceil(budget ** (1 / dim)))
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    def accept_probability(current, previous):
        return 1 if current < previous else np.exp((previous - current) / budget)

    for n in range(1, int(np.ceil(budget ** (1 / dim))) + 1):
        x_cand = x_best.copy()
        for i in range(dim):
            x_cand[i] += rng.normal(0, 0.5)
            x_cand[i] = max(lb, min(x_cand[i], ub))
        f_cand = func(x_cand)

        if f_cand < f_best:
            x_best = x_cand
            f_best = f_cand

        alpha = accept_probability(f_cand, f_best)
        u = rng.uniform(0, 1)
        if u > alpha:
            f_best -= np.log(u) * budget

    return x_best
