def algorithm(func, dim, lb, ub, budget, rng):
    def func_wrapper(x):
        return func(x)

    x0 = np.random.uniform(lb, ub, size=dim)
    best_x = x0.copy()
    best_fval = func_wrapper(best_x)

    for _ in range(budget):
        trial_x = np.copy(best_x)
        for i in range(dim):
            v1 = rng.uniform(0, 1)
            v2 = rng.uniform(0, 1)
            v3 = rng.uniform(-1, 1)
            trial_x[i] += v3 * (best_x[i] - x0[i]) + v1 * (ub - lb) + v2 * (trial_x[i] - best_x[i])
            trial_x[i] = np.clip(trial_x[i], lb, ub)

        trial_fval = func_wrapper(trial_x)
        if trial_fval < best_fval:
            best_fval = trial_fval
            best_x = trial_x.copy()

    return best_x
