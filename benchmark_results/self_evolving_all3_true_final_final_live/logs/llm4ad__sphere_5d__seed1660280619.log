def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    def mutation(sigma, x):
        return x + sigma * np.random.randn(dim)

    def evaluate(x):
        return func(clip(x))

    def gaussian_mixture_model(samples, k):
        n_samples = samples.shape[0]
        weights = np.ones(k) / k
        means = np.split(samples, k)
        covariances = [np.cov(means[i], rowvar=False) for i in range(k)]
        return weights, means, covariances

    def sampling(weights, means, covariances):
        indices = []
        for _ in range(n_samples):
            u = rng.uniform(0, 1)
            cumulative_prob = 0
            for i in range(len(weights)):
                cumulative_prob += weights[i]
                if u < cumulative_prob:
                    indices.append(i)
                    break
        samples = [means[i] + np.sqrt(np.linalg.det(covariances[i])) * rng.multivariate_normal(mean=np.zeros(dim), cov=covariances[i]) for i in indices]
        return np.array(samples)

    def cma_es(budget, dim, lb, ub, rng):
        n_samples = 10
        n_parents = 2
        n_offspring = 100
        sigma = 1.0
        x_best = np.zeros(dim)
        f_best = np.inf

        for i in range(budget):
            samples = sampling(np.ones(n_samples) / n_samples, [np.zeros(dim) + lb] * n_samples, [(ub - lb) ** 2 * np.eye(dim)] * n_samples)
            weights, means, covariances = gaussian_mixture_model(samples, n_samples)

            for _ in range(int(n_offspring)):
                x_new = mutation(sigma, samples[rng.choice(len(samples))])
                f_new = evaluate(x_new)

                if f_new < f_best:
                    f_best = f_new
                    x_best = x_new

            sigma *= 1 + (f_best / n_samples - 1) * 0.01

        return x_best, f_best

    return cma_es(budget, dim, lb, ub, rng)
