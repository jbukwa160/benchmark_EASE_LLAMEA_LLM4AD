def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    f_best = np.inf

    for i in range(budget):
        x_rand = lb + (ub - lb) * rng.rand(dim)
        x_candidate = x_best + 0.01 * (x_rand - x_best)

        # Clip candidates to [lb, ub]
        x_candidate = np.clip(x_candidate, lb, ub)

        f_candidate = func(x_candidate)

        if f_candidate < f_best:
            f_best = f_candidate
            x_best = x_candidate

    return x_best
