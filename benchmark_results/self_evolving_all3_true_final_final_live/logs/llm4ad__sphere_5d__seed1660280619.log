def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    best_val = func(x)

    for _ in range(budget):
        x_prime = x.copy() + 0.1 * rng.randn(dim)
        x_prime = np.clip(x_prime, lb, ub)

        val = func(x_prime)
        prob = np.exp(-val / (best_val + 1e-8))
        if rng.rand() < prob:
            x = x_prime

        best_val = min(best_val, val)
        best_x = x.copy()

    return best_x
