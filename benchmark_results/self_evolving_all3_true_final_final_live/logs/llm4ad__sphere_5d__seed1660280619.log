def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    best_score = np.inf
    
    for n in range(1, dim + 1):
        for _ in range(budget // (dim + 1)):
            if rng.rand() < 0.5:
                # Generate a new solution by adding or removing dimensions
                x_new = rng.randn(n)
                x_new[x_new > lb] = np.clip(x_new[x_new > lb], lb, ub)
                x_new[x_new < ub] = np.clip(x_new[x_new < ub], lb, ub)
            else:
                # Generate a new solution by perturbing the best known solution
                x_new = rng.randn(n) + x_best[:n]
                x_new[x_new > lb] = np.clip(x_new[x_new > lb], lb, ub)
                x_new[x_new < ub] = np.clip(x_new[x_new < ub], lb, ub)
            
            # Evaluate the new solution
            score = func(x_new)
            
            if score < best_score:
                best_score = score
                x_best = x_new
    
    return x_best
