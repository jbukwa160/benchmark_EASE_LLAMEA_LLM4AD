def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    step_size = 1.0
    for i in range(budget):
        x = np.clip(best_x + rng.normal(size=dim) * (step_size / (i+1)), lb, ub)
        f = func(x)
        
        if f < best_f:
            best_x = x
            best_f = f
            
    return best_x
