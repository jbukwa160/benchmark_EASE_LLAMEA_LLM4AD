def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n = 10 * D  # initial population size
    candidates = rng.uniform(lb, ub, (n, D))
    best_x = None
    best_y = float('inf')
    
    for t in range(budget):
        gp = GaussianProcessRegressor()
        X = np.array(candidates)
        Y = func(X)
        
        gp.fit(X, Y)
        
        mu, sigma = gp.predict(np.atleast_2d(rng.uniform(lb, ub)), return_std=True)
        
        ei = ExpectedImprovement(gp, rng.uniform(lb, ub), func)
        next_x = ei.maximize(mu, sigma)
        
        next_y = func(next_x.reshape(1, -1))
        
        if next_y < best_y:
            best_x = next_x
            best_y = next_y
        
        candidates = np.vstack((candidates, next_x))
    
    return best_x
