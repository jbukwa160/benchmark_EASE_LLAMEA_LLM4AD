def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(1, dim))
    best_x = x.copy()
    
    for _ in range(budget - 1):
        new_x = rng.uniform(lb, ub, size=(1, dim))
        
        if func(new_x) < func(best_x):
            best_x = new_x
            
    return best_x
