    D = len(lb)
    x_best = np.array([lb + (ub - lb) * rng.rand(D)])
    y_best = func(x_best)

    for i in range(budget):
        X = np.zeros((100, D))
        Y = np.zeros(100)

        for j in range(100):
            x_new = x_best.copy()
            for d in range(D):
                mu = x_new[d]
                sigma = 0.1 + 0.9 * norm.cdf(np.abs(x_best[d] - lb[d]) / (ub[d] - lb[d]))
                x_new[d] += rng.normal(0, sigma)
                x_new[d] = np.clip(x_new[d], lb[d], ub[d])

            X[j] = x_new
            Y[j] = func(x_new)

        idx = np.argmax([Y[k] for k in range(100)])
        x_best = X[idx]
        y_best = Y[idx]

    return x_best
