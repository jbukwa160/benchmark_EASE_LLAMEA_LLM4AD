def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    max_iter = int(budget / pop_size)
    c1, c2 = 0.5, 0.3
    sigma, t = 100, 1
    temp = 1e6

    for _ in range(max_iter):
        x = rng.uniform(lb, ub, (pop_size, dim))
        y = np.zeros((pop_size, dim))

        for i in range(pop_size):
            for j in range(dim):
                if rng.rand() < c1:
                    y[i, j] = x[(i-1)%pop_size, j] + sigma * (x[(i+1)%pop_size, j] - 2*x[i, j])

        f_x, f_y = func(x), func(y)
        idx = np.argsort(f_y)[:int(pop_size/10)]

        y[idx] = x[idx]
        f_y[idx] = f_x[idx]

        for i in range(pop_size):
            for j in range(dim):
                if rng.rand() < c2:
                    y[i, j] += sigma * (x[(i-1)%pop_size, j] - 2*x[i, j])
                    f_y[i] = func(y[i])

                if temp > 0 and f_y[i] < f_x[i]:
                    x[i], y[i] = y[i], x[i]
                    f_x[i], f_y[i] = f_y[i], f_x[i]

                temp *= 1 - t
                if rng.rand() < np.exp(-(f_x[i]-f_y[i])/temp):
                    x[i], y[i] = y[i], x[i]
                    f_x[i], f_y[i] = f_y[i], f_x[i]

    return x[np.argmin(f_x)]
