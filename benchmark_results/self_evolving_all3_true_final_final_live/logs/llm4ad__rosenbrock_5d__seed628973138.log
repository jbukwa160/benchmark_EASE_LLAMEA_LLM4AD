def algorithm(func, dim, lb, ub, budget, rng):
    x = 5 * np.random.rand(dim) - 5
    best_x = x.copy()
    best_val = func(x)
    
    for _ in range(budget):
        c = np.exp(-_ / (budget / 10))
        
        delta_x = c * (ub - lb) * rng.randn(dim)
        new_x = x + delta_x
        
        # Clip to bounds
        new_x = np.clip(new_x, lb, ub)
        
        new_val = func(new_x)
        
        if new_val < best_val:
            best_x = new_x.copy()
            best_val = new_val
            
        if rng.uniform(0, 1) < c * (best_val - new_val):
            x = new_x
    
    return best_x
