def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        dx = 0.1 * (ub - lb) * np.random.normal(size=dim)
        x_new = x + dx
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new
        
        # Adjust step size based on gradient magnitude
        grad_mag = np.sqrt(np.sum((func(np.array(x) + 1e-6) - f_new) ** 2))
        dx *= (0.9 if grad_mag < 1e-3 else 1.1)
        
        x = x_new

    return best_x
