def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.ceil(budget / (dim + 1)))
    population = np.random.uniform(lb, ub, size=(pop_size, dim))
    best_solution = None
    best_fitness = float('inf')

    for _ in range(int(0.9 * budget)):
        for i in range(pop_size):
            # Gaussian mutation with sigma scaled by the problem dimensionality
            mutant = population[i] + rng.normal(size=dim) * 1e-2 * (ub - lb)
            cross_indices = np.random.choice(population.shape[0], size=int(0.05 * pop_size), replace=False)
            trial = mutant.copy()
            for j in cross_indices:
                trial[j % dim] = population[j, j % dim]
            # Clip the candidate to the bounds
            trial = np.clip(trial, lb, ub)

            fitness = func(trial)
            if fitness < best_fitness:
                best_solution = trial
                best_fitness = fitness

    return best_solution
