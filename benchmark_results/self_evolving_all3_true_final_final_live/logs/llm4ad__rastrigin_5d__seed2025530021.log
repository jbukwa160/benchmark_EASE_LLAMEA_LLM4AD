def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.sqrt(budget))
    max_iter = int(budget / pop_size)
    population = rng.uniform(lb, ub, (pop_size, dim))

    for _ in range(max_iter):
        new_population = np.zeros((pop_size, dim))
        for i in range(pop_size):
            r1, r2, r3 = rng.choice(range(pop_size), size=3, replace=False)
            while r2 == r1 or r3 == r1 or r3 == r2:
                r2, r3 = rng.choice(range(pop_size), size=2, replace=False)

            u = population[r1] + 0.5 * (population[r2] - population[r3])
            new_population[i] = np.clip(u + rng.uniform(-1, 1, dim) * 0.01, lb, ub)
        population = new_population

    best_candidate = np.min([func(population[i]) for i in range(pop_size)], axis=0)
    return np.array(best_candidate)
