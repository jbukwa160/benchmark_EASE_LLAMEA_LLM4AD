def algorithm(func, dim, lb, ub, budget, rng):
    D = 0.5
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for i in range(budget):
        x_candidate = x_best + np.random.normal(size=dim) * D
        for j in range(dim):
            if x_candidate[j] < lb:
                x_candidate[j] = 2*lb - x_candidate[j]
            elif x_candidate[j] > ub:
                x_candidate[j] = 2*ub - x_candidate[j]

        f_candidate = func(x_candidate)
        
        if f_candidate < f_best:
            f_best = f_candidate
            x_best = x_candidate

        D *= np.exp(-0.01*i)

    return x_best
