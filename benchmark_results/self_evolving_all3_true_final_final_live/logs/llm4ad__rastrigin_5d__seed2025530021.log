def algorithm(func, dim, lb, ub, budget, rng):
    def sample(rng):
        return rng.uniform(lb, ub, size=dim)

    def clip(x):
        return np.clip(x, lb, ub)

    def eval(x):
        x = clip(x)
        return func(x)

    def mutate(x):
        sigma = 0.1
        mutation_step_size = 20 / (x + 1e-7)
        y = x + rng.uniform(-mutation_step_size, mutation_step_size, size=dim) * sigma
        return np.clip(y, lb, ub)

    def update_best(best, x, eval):
        if eval(x) < eval(best):
            best = x
        return best

    n_offsprings = int(np.ceil(budget ** (1 / 5)))
    pop_size = n_offsprings + 1
    population = np.zeros((pop_size, dim))
    evaluations = np.zeros(pop_size)
    best = np.zeros(dim)

    for _ in range(pop_size):
        population[_] = sample(rng)
        evaluations[_] = eval(population[_])
        if evaluations[_] < evaluations[0]:
            best = population[_]

    for _ in range(budget - pop_size):
        offspring = np.zeros((n_offsprings, dim))
        for i in range(n_offsprings):
            mu = rng.uniform(0, 1)
            sigma = rng.uniform(0, 1) * (ub - lb)
            x = best + mu * sigma
            x = mutate(x)
            offspring[i] = x

        evaluations_offspring = np.zeros(n_offsprings)
        for i in range(n_offsprings):
            evaluations_offspring[i] = eval(offspring[i])
            best = update_best(best, offspring[i], evaluations)

    return best
