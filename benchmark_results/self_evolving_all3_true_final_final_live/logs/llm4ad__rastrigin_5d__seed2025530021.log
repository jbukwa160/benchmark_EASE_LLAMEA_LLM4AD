def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(dim, lb, ub, rng):
        population = np.zeros((budget, dim))
        for i in range(budget):
            population[i] = lb + (ub - lb) * rng.rand(dim)
        return population

    def evaluate_population(func, population):
        fitness = func(population)
        return fitness

    def adaptive_step_size(fitness, step_size):
        return 0.5 * np.median(np.abs(fitness))

    def differential_evolution(func, population, lb, ub, rng):
        n = len(population)
        while True:
            for i in range(n):
                a, b, c = rng.choice(range(n), replace=False, size=3)
                if i == a or i == b or i == c:
                    continue
                candidate = population[i] + adaptive_step_size(evaluate_population(func, population[a]), step_size=rng.rand())
                for j in range(dim):
                    candidate[j] += rng.choice([-1, 1]) * (rng.rand() - 0.5) * 2.38
                    candidate[j] = clip_candidate(candidate[j], lb, ub)
                yield candidate

    population = generate_initial_population(dim, lb, ub, rng)
    best_individual = np.zeros(dim)

    for i in differential_evolution(func, population, lb, ub, rng):
        if func(i) < func(best_individual):
            best_individual = i

    return best_individual
