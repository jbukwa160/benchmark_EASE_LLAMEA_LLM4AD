def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    x0 = (ub - lb) * rng.random((1, dim)) + lb
    best = x0.copy()
    best_eval = f(best)
    
    for _ in range(budget):
        y = np.zeros_like(x0)
        for i in range(dim):
            r1, r2, r3 = rng.randint(0, budget), rng.randint(0, budget), rng.randint(0, budget)
            while r1 == _ or r2 == _ or r3 == _:
                r1, r2, r3 = rng.randint(0, budget), rng.randint(0, budget), rng.randint(0, budget)
            u = rng.uniform(0, 1)
            y[i] = x0[r1, i] + u * (x0[r2, i] - x0[r3, i])
        
        y = np.clip(y, lb, ub)
        y_eval = f(y)
        if y_eval < best_eval:
            best_eval = y_eval
            best = y.copy()
        
        x0 = np.where(rng.uniform(0, 1, size=dim) < 0.5, best, y)
    
    return best
