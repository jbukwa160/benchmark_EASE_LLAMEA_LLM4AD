def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(candidate):
        return func(candidate)

    x = (ub - lb) * rng.rand(dim) + lb
    sigma = 0.1 * (ub - lb)
    n_restart = int(budget / dim ** 2)
    best_x = None

    for i in range(n_restart):
        mu, cov = np.mean(x), np.cov(x, rowvar=False)
        x_new = np.random.multivariate_normal(mu, cov * sigma ** 2)

        for _ in range(dim ** 2):
            trial = clip(x_new + (ub - lb) * rng.randn(dim))
            fx_trial = evaluate(trial)

            if best_x is None or fx_trial < evaluate(clip(best_x)):
                best_x = trial

        x_new = np.append(x_new, best_x)
        x = np.array_split(x_new, dim)[0]

    return clip(best_x)
