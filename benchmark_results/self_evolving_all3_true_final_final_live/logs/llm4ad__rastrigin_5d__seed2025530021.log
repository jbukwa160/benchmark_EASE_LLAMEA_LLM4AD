def algorithm(func, dim, lb, ub, budget, rng):
    mu = 10 * rng.randn(dim)
    sigma = 2.0
    lambda_ = 50
    nu = 1 / (dim + 1.9)
    cmu = np.eye(dim) * 10**-4
    c1 = 1 + 2 / (dim ** 2 + 5)

    best_x = mu.copy()
    best_f = func(mu)

    for i in range(budget):
        x = mu + sigma * rng.randn(lambda_, dim)
        x = np.clip(x, lb, ub)

        f = func(x)

        if f < best_f:
            best_f = f
            best_x = x.copy()

        d = x - mu
        c2 = 1 / (dim ** 0.5 * sigma**2 + 1)
        cmu = (1 - c1) * cmu + c2 * np.outer(d, d)
        sigma *= np.exp(min(0.1, max(-0.5, (budget - i) / budget)**nu))
        nu += 1 / (dim ** 2 + 13)

        mu += (c1 * rng.randn(dim) + np.dot(cmu / (sigma**2), d)) * sigma

    return best_x
