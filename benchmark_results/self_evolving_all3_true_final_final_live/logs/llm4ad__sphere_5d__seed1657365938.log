def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.sqrt(budget))
    D = dim
    x_best = -np.inf
    y_best = None
    cov_mat = np.eye(D)
    step_size = 0.5 * (ub - lb)
    cumul_step_size = 1

    for _ in range(pop_size):
        x = rng.uniform(lb, ub, D)
        y = func(x)
        if y < x_best:
            x_best = y
            y_best = x.copy()

        z = np.random.multivariate_normal(np.zeros(D), cov_mat, 2 * D + 1)
        z[0] = 0

        for i in range(2 * D):
            x_new = x_best + cumul_step_size * np.dot(z[i], cov_mat).dot(rng.uniform(-1, 1, D))
            x_new = np.clip(x_new, lb, ub)

            y_new = func(x_new)
            if y_new < x_best:
                x_best = y_new
                y_best = x_new.copy()

        cov_mat = 0.8 * cov_mat + 0.2 * z[0].reshape(-1, D).dot(z[0].reshape(D, -1))
        cumul_step_size *= np.exp(0.01)

    return y_best
