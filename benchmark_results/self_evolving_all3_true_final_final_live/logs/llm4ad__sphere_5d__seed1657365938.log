def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    x_best = -np.ones(dim)
    f_best = float('inf')
    for _ in range(budget):
        x = clip(rng.uniform(lb, ub, size=dim))
        f = func(x)
        if f < f_best:
            f_best = f
            x_best = x.copy()
        
        step_size = 0.1 * (ub - lb) / np.sqrt(_ + 1)
        dx = rng.normal(size=dim) * step_size
        x_perturb = clip(x_best + dx)
        fperturb = func(x_perturb)
        if fperturb < f_best:
            f_best = fperturb
            x_best = x_perturb.copy()
    
    return x_best
