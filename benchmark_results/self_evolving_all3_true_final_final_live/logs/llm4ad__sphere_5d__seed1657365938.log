def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    init_x = rng.uniform(lb, ub, size=dim)
    best_x = clip(init_x.copy())
    min_val = func(clip(best_x))

    curr_temp = 1.0
    n_no_improvement = 0

    for _ in range(budget):
        noise = rng.normal(size=dim) * 0.5
        new_x = clip(best_x + noise)

        if func(new_x) < min_val:
            best_x = new_x.copy()
            min_val = func(clip(best_x))

            curr_temp = 1.0
            n_no_improvement = 0

        elif rng.rand() < np.exp((min_val - func(new_x)) / curr_temp):
            best_x = new_x.copy()

        else:
            n_no_improvement += 1

        if n_no_improvement > budget // 5:
            curr_temp *= 0.9
            n_no_improvement = 0

    return best_x
