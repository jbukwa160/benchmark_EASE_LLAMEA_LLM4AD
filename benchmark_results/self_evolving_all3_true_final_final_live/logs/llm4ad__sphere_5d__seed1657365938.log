def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(x_best, sigma):
        x = x_best + rng.randn(dim) * sigma
        return clip(x)

    def update_sigma(sigma, step_size):
        return max(1e-6, min(sigma * (1 + 0.1 * step_size), 1.5))

    def evaluate(candidate):
        return func(candidate)

    x_best = np.zeros(dim)
    best_fitness = float('inf')
    sigma = 1.0
    step_size = 0

    for _ in range(budget):
        candidate = generate_candidate(x_best, sigma)
        fitness = evaluate(candidate)

        if fitness < best_fitness:
            x_best = candidate
            best_fitness = fitness

        step_size += 1
        sigma = update_sigma(sigma, step_size)

    return x_best
