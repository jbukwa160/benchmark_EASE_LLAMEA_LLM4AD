def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.minimum(np.maximum(x, lb), ub)

    def differential_evolution(pop_size=50, cr=0.5, f=1.0, bounds=None):
        if bounds is None:
            bounds = [(lb, ub) for _ in range(dim)]
        
        pop = rng.uniform(lb, ub, (pop_size, dim))
        scores = np.zeros(pop_size)
        
        for generation in range(budget // pop_size):
            for i in range(pop_size):
                target = pop[i]
                difference = rng.uniform(-f, f, dim)
                trial = clip(target + cr * difference, lb, ub)
                
                score_trial = func(trial)
                score_target = func(target)
                
                if score_trial < score_target:
                    pop[i] = trial
                    scores[i] = score_trial
                    
            # Stochastic ranking selection with elite preservation
            indices = np.argsort(scores)[:int(0.1 * pop_size)]
            pop[indices] = rng.uniform(lb, ub, (len(indices), dim))
            
        return pop[np.argmin(scores)]

    best_solution = None
    for _ in range(budget // pop_size):
        solution = differential_evolution()
        if best_solution is None or func(solution) < func(best_solution):
            best_solution = solution
            
    return best_solution
