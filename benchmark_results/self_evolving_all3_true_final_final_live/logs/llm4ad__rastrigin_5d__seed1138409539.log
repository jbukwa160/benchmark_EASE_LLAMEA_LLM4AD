def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        n1, n2, n3 = rng.choice(dim, 3, replace=False), rng.choice(dim, 3, replace=False)
        v = np.copy(x[n1])
        v[n1] = x[n2]
        v[n1][n3] = x[n3]

        f_v = func(v)
        if f_v < best_f:
            best_f = f_v
            best_x = v

        elif rng.rand() < 0.01 and np.random.uniform(0, 1) > np.exp((best_f - f_v)/100):
            x[n1] = v[n2]
            x[n1][n3] = v[n3]

    return best_x
