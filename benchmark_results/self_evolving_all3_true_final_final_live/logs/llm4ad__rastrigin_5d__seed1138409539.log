def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        s = 0.01
        while True:
            y = x + s * (rng.uniform(-1, 1, size=dim) - 0.5)
            
            # Clip candidates to [lb, ub]
            y = np.clip(y, lb, ub)
            
            f_y = func(y)
            if f_y < best_f:
                best_x = y
                best_f = f_y
            
            s *= 0.99
            if s < 1e-6 or rng.uniform(0, 1) > 0.5:
                break
    
    return best_x
