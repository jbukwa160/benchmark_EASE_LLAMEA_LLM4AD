def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(n, dim, lb, ub):
        return [lb + (ub - lb) * rng.rand(dim) for _ in range(n)]

    def probabilistic_hill_climbing(func, x0, step_size, budget, rng):
        best_x = x0
        best_f = func(x0)
        
        for i in range(budget):
            # Adaptively adjust the step size based on performance of previous iterations
            step_size *= 1 - (i / budget)**2
            
            new_x = clip(best_x + step_size * rng.randn(dim))
            new_f = func(new_x)
            
            if new_f < best_f:
                best_x, best_f = new_x, new_f
        
        return best_x

    population = generate_initial_population(10, dim, lb, ub)
    
    best_x = min(population, key=func)
    
    for _ in range(budget):
        x0 = best_x
        best_x = probabilistic_hill_climbing(func, x0, 1, budget - _, rng)
        
        if func(best_x) < func(x0):
            population.remove(x0)
            population.append(best_x)
            
        else:
            population.append(x0)

    return min(population, key=func)
