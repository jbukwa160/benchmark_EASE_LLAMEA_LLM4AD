def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    ngen = int(budget)
    nvar = D
    nbits = 32
    nmin = 10 * ngen / (nbits + 1) ** 2
    alpha = 0.01
    beta = 0.001

    def f(x):
        return np.sum(np.clip(x, lb, ub)**2)

    def cmaes():
        sigma0 = 5.0
        ngen = 50 * D
        mu, sigma = np.zeros(D), sigma0
        for i in range(ngen):
            xnew = mu + rng.normal(0, sigma, (D,))
            fnew = func(xnew)
            if fnew < func(mu):
                mu, sigma = xnew, 0.9 * sigma
            else:
                acceptance_prob = np.exp(-alpha * (fnew - func(mu)) / sigma)
                u = rng.rand()
                if u < acceptance_prob:
                    mu = (1 + alpha) * mu + (alpha ** 2) * (xnew - mu)
        return mu

    def sa():
        T, tstep, tmin = 1000.0, 0.9, 10
        xbest, fbest = np.zeros(D), func(np.zeros(D))
        for i in range(ngen):
            xtemp = rng.normal(size=D) * (ub - lb) + lb
            ftemp = func(xtemp)
            if ftemp < fbest:
                xbest, fbest = xtemp, ftemp
            T *= tstep
            if T < tmin:
                break
        return xbest

    def main():
        xbest = np.zeros(D)
        for i in range(ngen):
            xnew = cmaes()
            fnew = func(xnew)
            if fnew < func(xbest):
                xbest = xnew
            xnew = sa()
            fnew = func(xnew)
            if fnew < func(xbest):
                xbest = xnew
        return np.clip(xbest, lb, ub)

    return main()
