def algorithm(func, dim, lb, ub, budget, rng):
    n_iter = int(budget ** (1/4))  # Number of iterations to allocate budget evenly
    init_budget = budget / n_iter
    
    x_best = None
    f_best = np.inf
    
    for t in range(n_iter):
        if t == 0:
            x_init = rng.uniform(lb, ub, size=(dim,))
            x_candidate = x_init.copy()
        else:
            x_candidate = rng.uniform(lb, ub, size=(dim,))
        
        n_acq = int(init_budget ** (1/4))  # Number of acquisition points
        acq_points = []
        
        for _ in range(n_acq):
            if t == 0:
                x_new = x_init.copy()
            else:
                x_new = rng.uniform(lb, ub, size=(dim,))
            
            f_x = func(x_new)
            acq_points.append((x_new, f_x))
        
        # Sort acquisition points by acquisition function value
        sorted_acq_points = sorted(acq_points, key=lambda x: x[1])
        
        x_selected = None
        for i in range(n_acq):
            if i % 2 == 0:
                x_selected = sorted_acq_points[i][0]
            else:
                f_x_new = func(x_selected)
                if f_x_new < sorted_acq_points[i][1]:
                    break
        
        # Update best solution
        f_x_new = func(x_selected)
        if f_x_new < f_best:
            x_best = x_selected.copy()
            f_best = f_x_new
        
        # Clip candidates to [lb, ub]
        for i in range(dim):
            x_candidate[i] = np.clip(x_candidate[i], lb, ub)
    
    return x_best
