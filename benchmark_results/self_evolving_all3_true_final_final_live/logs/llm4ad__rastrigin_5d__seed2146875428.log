def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    n = len(lb)
    x_best = -np.inf * np.ones(n)
    t = 1.0
    T_max = 10 ** 6
    restart_count = 0

    while budget > 0:
        for i in range(dim):
            if rng.random() < 0.5:
                x_new = x_best.copy()
                step_size = np.exp(-t)
                sigma = (ub - lb) * step_size
                noise = rng.normal(0, sigma)
                x_new[i] += noise
                x_new[i] = max(lb, min(x_new[i], ub))
            else:
                x_new = rng.uniform(lb, ub, size=n)

        delta_f = f(x_new) - f(x_best)
        if delta_f < 0 or (delta_f >= 0 and np.exp(-delta_f / t) > rng.random()):
            x_best = x_new

        budget -= 1
        t *= 0.99  # cooling schedule

        if t < 0.01:
            restart_count += 1
            if restart_count % 10 == 0:
                t = T_max
                x_best = -np.inf * np.ones(n)

    return x_best
