def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(size, dim, lb, ub):
        return (ub - lb) * rng.rand(size, dim) + lb

    def evaluate_candidates(population, func):
        return [func(candidates[i]) for i in range(len(population))]

    def clip_candidates(population, lb, ub):
        return np.clip(population, lb, ub)

    def update_sigma(sigma, temperature, cooling_rate, delta):
        if delta < 0:
            sigma *= (1 - temperature * cooling_rate)
        return sigma

    population_size = int(np.sqrt(budget))
    initial_population = generate_initial_population(population_size, dim, lb, ub)
    best_individual = None
    current_solution = evaluate_candidates(initial_population, func)[0]
    sigma = 5.0 / np.sqrt(dim)

    for iteration in range(1, budget + 1):
        temperature = 1 - (1 / iteration)
        population = generate_initial_population(population_size, dim, lb, ub)
        clipped_population = clip_candidates(population, lb, ub)
        evaluated_population = evaluate_candidates(clipped_population, func)

        delta = np.array(evaluated_population) - current_solution
        if any(delta < 0):
            best_individual_index = np.argmin(np.array(evaluated_population))
            best_individual = clipped_population[best_individual_index]
            current_solution = evaluated_population[best_individual_index]

        sigma = update_sigma(sigma, temperature, 0.01, delta)

    return best_individual
