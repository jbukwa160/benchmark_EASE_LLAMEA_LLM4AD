def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_candidate = -np.inf * np.ones(dim)
    num_samples = 0
    restarts = 0

    while num_samples < budget:
        candidate = rng.uniform(lb, ub, size=dim)
        candidate = clip(candidate)

        value = func(candidate)

        if value > -np.inf and (num_samples == 0 or value < func(clip(best_candidate))):
            best_candidate = candidate
            num_samples += 1

        if np.random.rand() < 0.05:
            restarts += 1
            print(f'Restart {restarts}')
            best_candidate = rng.uniform(lb, ub, size=dim)
            best_candidate = clip(best_candidate)

    return best_candidate
