def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    f_best = func(x_best)
    
    for _ in range(budget):
        k = rng.randint(0, dim)
        step_size = 0.1
        x_new = x_best.copy()
        x_new[k] += np.sign(rng.uniform(-1, 1)) * step_size
        
        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        if f_new < f_best:
            x_best = x_new
            f_best = f_new
    
    return x_best
