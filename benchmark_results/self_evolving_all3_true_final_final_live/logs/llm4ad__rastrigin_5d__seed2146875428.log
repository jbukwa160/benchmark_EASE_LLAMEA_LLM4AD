def algorithm(func, dim, lb, ub, budget, rng):
    def clipped(x):
        return np.clip(x, lb, ub)

    best_x = np.zeros(dim)
    best_f = float('inf')
    num_restarts = 0
    for _ in range(budget // (dim + 1)):
        num_restarts += 1
        sigma = 0.5 * (ub - lb) / rng.rand()
        mu = clipped(rng.normal(0, sigma, dim))
        lambda_ = int((ub - lb) * 10)
        distribution = np.zeros(lambda_)
        for i in range(lambda_):
            distribution[i] = clipped(mu + rng.randn(dim) * sigma)
        x = np.copy(distribution)
        f_x = func(x)
        if f_x < best_f:
            best_f = f_x
            best_x = np.copy(x)
        for _ in range(lambda_ - 1):
            c_x = clipped((x + distribution[:, None]) / 2)
            f_c_x = func(c_x)
            if f_c_x < f_x:
                x = np.copy(c_x)
                f_x = f_c_x
            elif rng.rand() > 0.5:
                x = np.copy(distribution[np.random.choice(lambda_), :])
        sigma *= 1 + rng.randn() / (dim + 1)
    return best_x
