def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(current, sigma):
        return current + rng.normal(size=dim) * sigma
    
    def clip(candidate, lb, ub):
        return np.clip(candidate, a_min=lb, a_max=ub)
    
    x = rng.uniform(low=lb, high=ub, size=dim)
    best_x = x.copy()
    temperature = 1.0
    sigma = 5.0
    
    for _ in range(budget):
        candidate = generate_candidate(x, sigma)
        candidate = clip(candidate, lb, ub)
        
        fCandidate = func(candidate)
        fBest = func(best_x)
        
        if fCandidate < fBest:
            best_x = candidate
        elif np.random.rand() < np.exp(-(fCandidate - fBest) / temperature):
            x = candidate
        
        sigma *= 0.9999  # decrease perturbation over time
        temperature *= 0.99  # decrease temperature over time
        
    return best_x
