def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    n = int(budget ** (1 / 2))
    pop_size = min(100, n * dim)
    x = np.random.uniform(lb, ub, (pop_size, dim))

    for _ in range(n):
        y = clip(x + rng.uniform(-1, 1, size=(pop_size, dim)))
        fitness_y = func(y)

        idx = np.argsort(fitness_y)[:int(pop_size / 2)]
        x[idx] = y[idx]

        p = np.random.permutation(range(int(pop_size / 2), pop_size))
        for i in p:
            new_x = clip(x[i] + rng.uniform(-1, 1, size=dim))
            fitness_new_x = func(new_x)
            if fitness_new_x < fitness_y[i]:
                x[i] = new_x

    best_idx = np.argmin(func(x))
    return clip(x[best_idx])
