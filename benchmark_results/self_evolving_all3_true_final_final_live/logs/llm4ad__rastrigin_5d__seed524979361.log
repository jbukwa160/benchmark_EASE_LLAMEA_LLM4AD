def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    w = 0.8
    c1 = 2
    c2 = 2
    n_iter = int(budget / (pop_size * dim))
    x_best = -np.ones(dim)
    f_best = float('inf')
    
    for i in range(n_iter):
        x = np.random.uniform(lb, ub, size=(pop_size, dim))
        
        for j in range(pop_size):
            v = x[j] + 0.1 * rng.rand(dim) - 0.05
            y = x[j]
            
            for k in range(dim):
                r1 = rng.randint(0, pop_size)
                r2 = rng.randint(0, pop_size)
                
                if rng.random() < 0.5:
                    v[k] = x[r1, k] + w * (x[r2, k] - x[j, k]) + c1 * rng.uniform(-1, 1) * (x_best[k] - x[j, k])
                else:
                    v[k] = y[k] + c2 * rng.uniform(-1, 1) * (x_best[k] - y[k])
                
            if func(v) < func(y):
                y[:] = v
        
        f = func(x)
        
        for j in range(pop_size):
            if f[j] < f_best:
                f_best = f[j]
                x_best[:] = x[j]
            
        x_best = np.clip(x_best, lb, ub)
    
    return x_best
