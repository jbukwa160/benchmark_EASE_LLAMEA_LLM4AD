def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    for _ in range(budget):
        x = lb + (ub - lb) * rng.rand(dim)
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, a_min=lb, a_max=ub)
        
        f_x = func(x)
        
        if f_x < f_best:
            x_best = x
            f_best = f_x
            
    return x_best
