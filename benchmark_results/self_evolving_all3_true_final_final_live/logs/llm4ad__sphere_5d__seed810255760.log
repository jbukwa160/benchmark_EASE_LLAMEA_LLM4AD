def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_y = float('inf')
    
    for i in range(budget):
        std_dev = max(1e-3, 2 / (i + 1)**0.5)
        
        x_candidate = best_x + std_dev * rng.normal(size=dim)
        x_candidate = np.clip(x_candidate, lb, ub)
        
        y_candidate = func(x_candidate)
        
        if y_candidate < best_y:
            best_x = x_candidate
            best_y = y_candidate
    
    return best_x
