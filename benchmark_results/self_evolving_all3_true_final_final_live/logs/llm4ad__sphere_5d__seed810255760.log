def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(size=dim) * (ub - lb) + lb
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        y = x + rng.normal(scale=np.sqrt(0.1), size=dim)
        y = np.clip(y, lb, ub)
        
        if func(y) < best_f:
            best_f = func(y)
            best_x = y.copy()
            
        if rng.uniform() > 0.5: # mutation rate
            x = best_x + rng.normal(scale=np.sqrt(0.1), size=dim)
            x = np.clip(x, lb, ub)
        
    return best_x
