def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_y = float('inf')
    
    for _ in range(budget):
        x = lb + (ub - lb) * rng.rand(dim)
        
        y = func(x)
        
        if y < best_y:
            best_y = y
            best_x = x
        
        # Gradient descent step
        alpha = 0.1
        g = np.zeros(dim)
        for i in range(dim):
            eps = 1e-6
            dx = np.copy(x)
            dx[i] += eps
            dy_pos = func(dx)
            dx[i] -= 2 * eps
            dy_neg = func(dx)
            g[i] = (dy_pos - dy_neg) / (2 * eps)
        x -= alpha * g
        
        # Clip to bounds
        x = np.clip(x, lb, ub)
        
    return best_x
