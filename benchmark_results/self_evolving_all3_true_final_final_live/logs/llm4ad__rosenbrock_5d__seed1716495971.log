def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(size):
        return rng.uniform(lb, ub, size=(size, dim))

    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        return func(x)

    population_size = 50
    lambda_ = int(population_size * 0.1)
    sigma = 1.0

    initial_population = generate_initial_population(population_size)
    best_solution = None

    for iteration in range(budget):
        if best_solution is not None and evaluate(best_solution) == 0:
            break

        clipped_population = clip(initial_population)
        evaluations = np.array([evaluate(x) for x in clipped_population])
        sorted_indices = np.argsort(evaluations)

        selected_parents = clipped_population[sorted_indices[:lambda_]]
        selected_parents_evaluations = evaluations[sorted_indices[:lambda_]]

        sigma_new = (1 + 2 / (iteration + 1)) * sigma
        mu = np.mean(selected_parents, axis=0)
        cov = np.cov(selected_parents.T)

        offspring_population = []
        for _ in range(population_size - lambda_):
            noise = rng.normal(size=dim) * np.sqrt(sigma_new)
            new_individual = mu + cov @ noise
            clipped_new_individual = clip(new_individual)
            offspring_population.append(clipped_new_individual)

        initial_population = np.vstack((selected_parents, np.array(offspring_population)))
        best_solution = initial_population[np.argmin(evaluations)][np.newaxis]

    return best_solution[0]
