def algorithm(func, dim, lb, ub, budget, rng):
    N = 50  # population size
    M = int(budget / (dim * N))  # number of generations
    F = 0.7  # scaling factor
    CR = 0.9  # crossover probability

    pop = np.random.uniform(lb, ub, (N, dim))
    pop_best = pop.copy()
    best = func(pop)

    for i in range(M):
        for j in range(N):
            r1, r2, r3 = rng.randint(0, N), rng.randint(0, N), rng.randint(0, N)
            if r1 != j and r2 != j and r3 != j:
                u = F * (pop[r1] - pop[j]) + pop[j]
                v = F * (pop[r2] - pop[r3]) + pop[r3]

                if rng.random() < CR or func(u) < best:
                    u = np.where(rng.uniform(0, 1, dim) < 0.5, v, u)
                    pop[j] = u

        for j in range(N):
            pop_best[j] = pop[j]
            if func(pop[j]) < best:
                best = func(pop[j])

    return pop_best[np.argmin([func(p) for p in pop_best])]
