def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        x_new = x + 0.1 * np.clip(rng.normal(size=(1, dim)), -2, 2)
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)

        if f_new < best_f:
            best_x = x_new
            best_f = f_new

        if rng.uniform(0, 1) < 0.01: # 1% chance to apply local refinement
            step_size = 0.001 * np.clip(rng.normal(size=(1, dim)), -2, 2)
            x_new = best_x + step_size
            x_new = np.clip(x_new, lb, ub)
            
            f_new = func(x_new)

            if f_new < best_f:
                best_x = x_new
                best_f = f_new

    return best_x
