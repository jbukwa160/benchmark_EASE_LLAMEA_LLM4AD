def algorithm(func, dim, lb, ub, budget, rng):
    mean = np.zeros(dim)
    cov = np.eye(dim)
    sigma = 1.0
    n_iter = 0
    best_x = mean.copy()
    best_f = float('inf')

    while n_iter < budget:
        # Sample a candidate
        x = rng.normal(mean, sigma) * np.sqrt(cov.diagonal())
        x = np.clip(x, lb, ub)

        # Evaluate the function at the candidate
        f = func(x)

        # Store the best found so far
        if f < best_f:
            best_x = x.copy()
            best_f = f

        # Update the mean and covariance matrix using the CMA-ES update rule
        z = (x - mean) / sigma
        cov += 0.1 * np.outer(z, z)
        mean += 0.01 * sigma * np.dot(cov, rng.normal(mean, 1))

        n_iter += 1

    return best_x
