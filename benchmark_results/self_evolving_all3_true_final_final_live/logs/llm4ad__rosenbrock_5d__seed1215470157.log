            idx1 = rng.randint(0, dim)
            idx2 = rng.randint(0, dim)
            children[i] = x_curr.copy()
            children[i, idx1], children[i, idx2] = children[i, idx2], children[i, idx1]

        f_children = np.array([obj(x) for x in children])

        idx_best = np.argmin(f_children)
        if f_children[idx_best] < f_curr:
            x_curr = children[idx_best]
            f_curr = f_children[idx_best]

    x_best = np.clip(x_curr, lb, ub)

    return x_best
