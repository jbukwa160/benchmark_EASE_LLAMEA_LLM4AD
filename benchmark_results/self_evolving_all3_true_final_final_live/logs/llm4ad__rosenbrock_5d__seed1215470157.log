def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = dim
    N = 50
    pop_size = int(budget / (D * N))
    max_iter = budget
    CR = 0.9
    F = 0.5

    pop = rng.uniform(lb, ub, size=(pop_size, D))

    for t in range(max_iter):
        x_new = np.copy(pop)
        
        for i in range(N):
            idx1, idx2, idx3 = rng.choice(pop_size, size=3, replace=False)
            
            u = clip(pop[idx1] + F * (pop[idx2] - pop[idx3]))
            v = clip(pop[idx1] + F * (pop[np.random.choice(pop_size, p=rng.dirichlet(np.ones(D), size=pop_size))]))

            x_new[idx1] = np.where(rng.rand(D) < CR, u, v)

        pop = x_new

    return clip(func(pop[rng.choice(pop_size)]))
