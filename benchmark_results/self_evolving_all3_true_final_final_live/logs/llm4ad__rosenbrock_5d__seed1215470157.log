    x_best = res_de.x
    f_best = res_de.fun

    x_curr = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    f_curr = obj(x_curr)

    pop_size = 20
    generations = budget // (pop_size * dim)

    for gen in range(generations):
        children = np.zeros((pop_size, dim))
