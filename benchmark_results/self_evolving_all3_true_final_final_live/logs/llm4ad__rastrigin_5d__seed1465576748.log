def algorithm(func, dim, lb, ub, budget, rng):
    def func_wrapper(x):
        return func(x)

    x = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func_wrapper(best_x)
    pop_size = int(np.ceil(budget / (dim + 1)))
    pop = [x.copy() for _ in range(pop_size)]
    velocities = np.array([[0.0] * dim for _ in range(pop_size)])

    for i in range(1, budget):
        f_values = [func_wrapper(x) for x in pop]
        idx_best = np.argmax(f_values)
        if f_values[idx_best] < best_f:
            best_x = pop[idx_best].copy()
            best_f = f_values[idx_best]

        for j in range(pop_size):
            velocities[j] = 0.5 * rng.rand(dim) - 0.25
            r1, r2 = rng.randint(0, pop_size, size=2)
            while r1 == r2:
                r2 = rng.randint(0, pop_size)

            for k in range(dim):
                velocities[j][k] += 0.5 * (pop[r1][k] - pop[r2][k]) + \
                    0.3 * (best_x[k] - pop[j][k])

        for j in range(pop_size):
            x[j] = pop[j].copy()
            for k in range(dim):
                if rng.rand() < 0.5:
                    x[j][k] += velocities[j][k]
                elif rng.rand() < 0.5:
                    x[j][k] -= velocities[j][k]

        # clip to bounds
        for j in range(pop_size):
            for k in range(dim):
                if x[j][k] < lb:
                    x[j][k] = lb
                elif x[j][k] > ub:
                    x[j][k] = ub

        pop = [np.clip(x, a_min=lb, a_max=ub).copy() for x in x]

    return best_x
