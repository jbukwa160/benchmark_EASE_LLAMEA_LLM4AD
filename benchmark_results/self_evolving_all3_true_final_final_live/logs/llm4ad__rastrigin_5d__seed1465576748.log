def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_bests = 5
    sigma = 0.1
    mu = np.zeros(D)
    cov = np.eye(D) * (ub - lb)**2 / 4
    best_f = float('inf')
    best_x = None

    for _ in range(budget):
        if rng.random() < 0.01:
            sigma *= 0.1 + rng.uniform(0, 1)

        z = np.zeros(D)
        v = np.random.multivariate_normal(mu, cov)
        for i in range(n_bests):
            z += v / (n_bests * (sigma**2))
            x = mu + z
            f = func(x)

            if not -5 <= x[0] <= 5:
                continue

            for j in range(1, D):
                if not -5 <= x[j] <= 5:
                    x[j] = np.clip(x[j], lb, ub)
                    break

            f = func(x)
            if f < best_f:
                best_f = f
                best_x = x

        mu += (ub - lb) * sigma**2 / np.sqrt(D) * z
        cov *= 1 + 2 / D - 1 / (D + 3)

    return np.array(best_x)
