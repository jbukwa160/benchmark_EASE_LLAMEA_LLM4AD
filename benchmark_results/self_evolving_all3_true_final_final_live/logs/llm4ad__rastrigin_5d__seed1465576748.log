def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = 5 * (ub - lb) * rng.random((dim)) + lb
    T = 10 * (ub - lb)
    step_size = (ub - lb) / 100

    for _ in range(budget):
        f_value = func(x)
        
        x_new = clip(x + step_size * np.random.normal(size=(dim)))
        f_new = func(x_new)

        if f_new < f_value:
            x = x_new
        else:
            probability = np.exp((f_value - f_new) / T)
            if rng.random() < probability:
                x = x_new

        T *= 0.9995
        step_size *= 0.9999

    return clip(x)
