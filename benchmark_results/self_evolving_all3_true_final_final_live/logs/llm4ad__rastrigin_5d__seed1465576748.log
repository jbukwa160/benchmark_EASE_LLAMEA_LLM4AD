def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate():
        return rng.uniform(lb, ub, size=dim)

    n_samples = 50
    sigma = 2.1 / (1 + (np.arange(1, dim+1) - 1)**0.5)
    best_candidate = None

    for _ in range(budget):
        candidates = np.array([generate_candidate() for _ in range(n_samples)])
        
        # Clip candidates to [lb, ub]
        clipped_candidates = np.clip(candidates, lb, ub)

        fitnesses = func(clipped_candidates)

        if best_candidate is None:
            argmin_idx = 0
        else:
            argmin_idx = np.argmin(np.add(fitnesses, -func(best_candidate)))

        selected_candidate = clipped_candidates[argmin_idx]
        
        # Calculate step size for next iteration
        step_size = (sigma * rng.normal(size=dim) + sigma)**2
        
        # Update covariance matrix and mean of the distribution
        if best_candidate is None:
            mean = selected_candidate
        else:
            mean = 0.7*best_candidate + 0.3*selected_candidate

        for i in range(dim):
            step_size[i] *= (1 - rng.uniform(0, 0.01))

        # Update covariance matrix
        if best_candidate is None or np.random.rand() < 0.5:
            cov = np.eye(dim)
        else:
            cov = mean * mean.T / n_samples

        # Add noise to the covariance matrix
        cov += step_size[np.newaxis, i] * rng.normal(size=(dim, dim))

        best_candidate = selected_candidate if func(best_candidate) < func(selected_candidate) else selected_candidate

    return best_candidate
