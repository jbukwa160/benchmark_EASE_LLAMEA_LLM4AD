def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = clip(np.random.rand(dim))
    x_best = x.copy()
    y_best = func(x)
    best = y_best

    for _ in range(budget - 1):
        v = np.zeros(dim)
        for i in range(dim):
            r = rng.rand(dim)
            r[i] = 0
            v += r * (x_best - x)
        v *= rng.uniform(0.5, 2.0) ** (budget - _ - 1)
        v = clip(v + x)

        y = func(v)
        if y < best:
            best = y
            x_best = v

    return x_best
