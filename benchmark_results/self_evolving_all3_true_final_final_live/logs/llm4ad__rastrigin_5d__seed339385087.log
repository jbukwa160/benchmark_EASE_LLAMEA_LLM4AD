def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, (1, dim))
    n_evals = 0
    cov = np.eye(dim) * 1e-3
    sigma = 1.0

    for i in range(budget):
        y = func(clip(x))
        n_evals += 1

        if n_evals > 100:
            cov = (1 - 2 / (n_evals + 10)) * cov + (2 / (n_evals + 10)) * np.outer((y - x), (y - x))
            sigma *= 0.5

        for _ in range(dim):
            z = rng.normal(size=(1, dim))
            u = clip(x + sigma * np.sqrt(cov) @ z)
            y_u = func(clip(u))

            if y_u < y:
                x = u
                y = y_u
                n_evals = 0

    return x
