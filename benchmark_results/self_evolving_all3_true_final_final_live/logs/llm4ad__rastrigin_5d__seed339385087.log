def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(x):
        return np.clip(x, lb, ub)

    def mutation(candidates, x_best, f_best):
        r1 = rng.uniform(0, 1)
        r2 = rng.uniform(0, 1)
        r3 = rng.uniform(0, 1)
        a = get_candidate(x_best + r1 * (ub - lb) * candidates[rng.randint(0, len(candidates)), :])
        b = get_candidate(r2 * x_best + (1 - r2) * a)
        c = get_candidate(r3 * f_best + (1 - r3) * func(b))
        return np.mean([a, b, c], axis=0)

    def crossover(parents, children):
        for i in range(len(children)):
            if rng.random() < 0.5:
                children[i] = get_candidate(np.where(rng.randint(0, 2, size=dim) == 1, parents[i], x_best))
            else:
                children[i] = get_candidate(np.where(rng.randint(0, 2, size=dim) == 1, parents[i-1], x_best))

    candidates = np.random.uniform(lb, ub, (budget, dim))
    f_values = np.array([func(candidates[i]) for i in range(budget)])
    best_idx = np.argmin(f_values)
    x_best = candidates[best_idx]
    f_best = f_values[best_idx]

    for _ in range(budget):
        new_candidates = np.copy(candidates)
        for i in range(len(new_candidates)):
            if rng.random() < 0.5:
                new_candidates[i] = mutation(candidates, x_best, f_best)
            else:
                parent1_idx = rng.randint(0, len(candidates))
                parent2_idx = rng.randint(0, len(candidates))
                child = get_candidate(mutation([candidates[parent1_idx], candidates[parent2_idx]], x_best, f_best))
                new_candidates[i] = crossover([candidates[parent1_idx], candidates[parent2_idx]], [child])[0]
        f_values_new = np.array([func(new_candidates[i]) for i in range(len(new_candidates))])
        best_idx_new = np.argmin(f_values_new)
        if f_values_new[best_idx_new] < f_best:
            x_best, f_best = new_candidates[best_idx_new], f_values_new[best_idx_new]
        candidates = new_candidates

    return get_candidate(x_best)
