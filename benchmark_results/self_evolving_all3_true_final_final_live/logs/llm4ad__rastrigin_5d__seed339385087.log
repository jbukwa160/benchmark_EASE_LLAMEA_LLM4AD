def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(n, dim, lb, ub):
        return lb + (ub - lb) * rng.uniform(size=(n, dim))

    def evaluate(population, func):
        return func(population)

    def clip_population(population, lb, ub):
        return np.clip(population, a_min=lb, a_max=ub)

    def differential_evolution(population, budget, func):
        for _ in range(budget // 2):
            differences = population[:, np.newaxis] - population
            indices = rng.choice(dim, size=(len(population), dim), replace=False)
            mutated_population = population + 0.5 * (differences * rng.uniform(size=(len(population), dim)))
            selected_indices = np.argmin(evaluate(mutated_population, func), axis=1)
            population[selected_indices] = clip_population(mutated_population[selected_indices], lb, ub)

    def random_restart(population, budget, func):
        for _ in range(budget // 2):
            initial_population = generate_initial_population(len(population), dim, lb, ub)
            population[:] = evaluate(initial_population, func).argmin()

    population = generate_initial_population(10, dim, lb, ub)
    differential_evolution(population, budget, func)
    random_restart(population, budget // 2, func)

    best_solution = np.argmin(evaluate(population, func))
    return clip_population(population[best_solution], lb, ub)
