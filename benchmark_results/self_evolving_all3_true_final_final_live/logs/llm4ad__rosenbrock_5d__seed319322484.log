def algorithm(func, dim, lb, ub, budget, rng):
    def sample(bounds):
        return [rng.uniform(lb, ub) for _ in range(dim)]

    def clip(candidate):
        return [max(lb, min(ub, x)) for x in candidate]

    def evaluate(x):
        return func(x)

    best_x = sample([lb]*dim)
    best_y = evaluate(best_x)

    for i in range(budget-1):
        candidates = []
        for _ in range(min(dim+1, budget-i)):
            candidate = clip(sample([lb]*dim))
            candidates.append(candidate)
        
        # Add the current best solution as a candidate
        candidate = clip(np.array(best_x))
        candidates.append(candidate)

        # Calculate the probability of each candidate based on its fitness
        probabilities = np.array([evaluate(x) for x in candidates])
        probabilities /= probabilities.sum()

        # Select the next candidate using weighted random sampling
        r = rng.rand()
        cumulative_prob = 0
        for i, p in enumerate(probabilities):
            cumulative_prob += p
            if r < cumulative_prob:
                next_x = candidates[i]
                break

        # Update the best solution
        y = evaluate(next_x)
        if y < best_y:
            best_y = y
            best_x = next_x

    return np.array(best_x)
