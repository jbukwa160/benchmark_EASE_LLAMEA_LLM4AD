def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = clip(rng.uniform(lb, ub, size=(dim)))
    y = func(x)
    best_x = x.copy()
    best_y = y
    cooling_rate = 0.99
    sigma_max = 10
    sigma_min = 1e-6

    for _ in range(budget):
        for i in range(dim):
            perturb = rng.uniform(-sigma_max, sigma_max)
            trial_x = x.copy()
            trial_x[i] += perturb
            trial_x = clip(trial_x)
            trial_y = func(trial_x)

            if trial_y < y:
                x = trial_x
                y = trial_y
            elif np.random.rand() < np.exp(-(y - trial_y) / (sigma_max + sigma_min)):
                x = trial_x
                y = trial_y

        if y < best_y:
            best_x = x.copy()
            best_y = y

        sigma = max(sigma_min, min(sigma_max, sigma_max * (1 - cooling_rate)**_))
        for i in range(dim):
            perturb = rng.uniform(-sigma, sigma)
            trial_x = x.copy()
            trial_x[i] += perturb
            trial_x = clip(trial_x)
            trial_y = func(trial_x)

            if trial_y < y:
                x = trial_x
                y = trial_y

    return best_x
