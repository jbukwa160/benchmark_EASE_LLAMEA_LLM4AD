def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    pop_size = max(10 * dim**2 // (dim + 1), 4)
    mu = 1 / pop_size
    sigma = (ub - lb) / (3 * rng.randn() + 1.0)
    while budget > 0:
        budget -= pop_size
        x = rng.normal(loc=mu, scale=sigma, size=(pop_size, dim))
        x = clip(x)
        y = func(x)
        best_idx = np.argmin(y)
        if y[best_idx] < mu**2 * pop_size:
            sigma *= 0.5 ** (1 / (dim + 3))
            mu += rng.normal(loc=mu, scale=sigma, size=dim) * (ub - lb) / 2
            budget += pop_size
        else:
            x[best_idx] = clip(mu + rng.normal(loc=0, scale=sigma, size=dim))
            y[best_idx] = func(x[best_idx])
    return np.argmin(func(clip(rng.normal(loc=mu, scale=sigma, size=(1, dim)))))
