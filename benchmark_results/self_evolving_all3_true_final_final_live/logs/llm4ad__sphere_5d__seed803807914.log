def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    T = 1e3
    cooling_rate = 0.99

    x_best = clip(np.zeros(dim))
    f_best = func(x_best)
    f_current = f_best

    for _ in range(budget):
        x_new = clip(x_best + rng.randn(dim) * (ub - lb))

        delta_f = func(x_new) - f_current
        if delta_f < 0:
            x_best = x_new
            f_best = func(x_best)
            f_current = f_best

        elif np.random.rand() < np.exp(-delta_f / T):
            x_best = x_new
            f_best = func(x_best)
            f_current = f_best

        T *= cooling_rate

    return x_best
