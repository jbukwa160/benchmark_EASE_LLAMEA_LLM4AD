def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.maximum(np.minimum(candidate, ub), lb)

    candidates = np.random.uniform(lb, ub, size=(budget, dim))
    for i in range(budget - 1):
        scores = func(candidates[i])
        indices = np.argsort(scores)[:int(0.2 * budget)]
        candidates[i + 1] = clip(np.mean(candidates[indices], axis=0))

    best_candidate = clip(np.argmin(func(candidates)))
    return best_candidate
