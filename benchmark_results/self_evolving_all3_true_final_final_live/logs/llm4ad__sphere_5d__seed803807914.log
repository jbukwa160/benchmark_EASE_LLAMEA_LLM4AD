def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        step_size = 1.0 / np.sqrt(_ + 1)
        new_x = x + rng.uniform(-step_size, step_size, size=dim)
        new_x = np.clip(new_x, lb, ub)
        
        if func(new_x) < best_f:
            best_x = new_x.copy()
            best_f = func(new_x)

        x = new_x

    return best_x
