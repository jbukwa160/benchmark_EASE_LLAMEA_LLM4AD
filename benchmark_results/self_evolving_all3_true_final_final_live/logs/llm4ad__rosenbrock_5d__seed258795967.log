def algorithm(func, dim, lb, ub, budget, rng):
    def gp(model, X, y):
        mu, s2 = model.predict(X)
        return mu, s2
    
    class GPModel:
        def __init__(self, kernel, noise_var, lengthscale):
            self.kernel = kernel
            self.noise_var = noise_var
            self.lengthscale = lengthscale
        
        def predict(self, X):
            K_XX = self.kernel(X)
            L = np.linalg.cholesky(K_XX + self.noise_var * np.eye(len(X)))
            v = 1 / (self.lengthscale**2) * np.ones((len(X), 1))
            mu = K_XX @ v
            s2 = self.kerneldiag(X) - K_XX @ v.T @ v
            return mu, s2
        
        def kerneldiag(self, X):
            return self.kernel(X).diagonal()
    
    class Kernel:
        def __init__(self, sigma_f, l):
            self.sigma_f = sigma_f
            self.l = l
        
        def __call__(self, X):
            return self.sigma_f**2 * np.ones((len(X), len(X))) + self.sigma_f**2 * np.exp(-np.linalg.norm(X[:, None] - X[None, :], axis=2)**2 / (2 * self.l**2))
    
    kernel = Kernel(sigma_f=1.0, l=1.0)
    gp_model = GPModel(kernel, noise_var=1e-6, lengthscale=np.sqrt(10))
    
    def surrogate(model, X):
        return model.predict(X)[0]
    
    x_best = rng.uniform(lb, ub, (dim,))
    f_best = func(x_best)
    budget_used = 1
    
    while budget_used < budget:
        N = int(np.ceil(np.sqrt(budget - budget_used)))
        X = rng.uniform(lb, ub, (N, dim))
        
        y = np.array([func(x) for x in X])
        mu, s2 = gp(gp_model, X)
        
        w = rng.normal(size=(len(X), dim))
        step_size = 0.5 * s2 / np.sum(s2)
        w /= np.sqrt(np.sum(w**2, axis=1))[:, None]
        x_new = X + step_size * w
        
        f_new = surrogate(gp_model, x_new)
        
        if budget_used < budget - N:
            for i in range(N):
                if f_new[i] < f_best:
                    x_best = x_new[i]
                    f_best = f_new[i]
                elif np.random.rand() < (f_new[i] - f_best) / (f_best - f_new[i]):
                    x_best = x_new[i]
                    f_best = f_new[i]
        
        X = np.vstack((X, x_new))
        y = np.append(y, f_new)
        
        mu, s2 = gp(gp_model, X)
        
        budget_used += N
    
    return x_best
