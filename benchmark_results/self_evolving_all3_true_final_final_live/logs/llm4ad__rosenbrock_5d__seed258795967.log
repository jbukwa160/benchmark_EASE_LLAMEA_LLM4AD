def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        x = np.clip(x, lb, ub)
        return func(x)

    sigma0 = 1.5 * (ub - lb) / (dim ** 0.5)
    mu = np.random.uniform(lb, ub, size=dim)
    cov = np.eye(dim) * sigma0 ** 2
    step_size = 1e-8

    for i in range(budget):
        x_new = mu + rng.normal(size=dim) @ cov
        x_new = np.clip(x_new, lb, ub)

        f_new = objective(x_new)
        f_old = func(mu)

        if f_new < f_old:
            mu = x_new
            cov += step_size * (x_new - mu) @ (x_new - mu).T

        else:
            probability = np.exp(-(f_new - f_old) / 100)
            if rng.uniform(0, 1) > probability:
                mu = x_new
                cov += step_size * (x_new - mu) @ (x_new - mu).T

    return mu
