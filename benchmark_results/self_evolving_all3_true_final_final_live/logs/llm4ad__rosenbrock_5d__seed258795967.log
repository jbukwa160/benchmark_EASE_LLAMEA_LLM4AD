def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    for _ in range(budget):
        score = func(x)
        if score < func(best_x):
            best_x = x
        directive = rng.uniform(-1, 1, size=dim)
        step_size = rng.uniform(0.01, 0.1)
        new_x = clip(best_x + (directive * step_size))
        x = np.where(rng.uniform(size=dim) < 0.5, new_x, x)
    return best_x
