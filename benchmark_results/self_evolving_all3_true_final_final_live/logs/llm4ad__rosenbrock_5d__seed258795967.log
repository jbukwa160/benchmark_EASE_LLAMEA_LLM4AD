def algorithm(func, dim, lb, ub, budget, rng):
    x_best = (ub + lb) / 2 * np.ones(dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_candidate = x_best + (ub - lb) * (rng.rand(dim) - 0.5)
        x_candidate = np.clip(x_candidate, lb, ub)

        f_candidate = func(x_candidate)
        
        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate

    return x_best
