def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    N = int(budget)
    T = 1000.0
    cooling_rate = 0.99
    step_size = 1e-3

    x_best = np.array([rng.uniform(lb, ub) for _ in range(D)])
    f_best = func(x_best)

    for i in range(N):
        k = rng.randint(0, D)
        delta = rng.normal(0, step_size, size=D)
        delta[k] = 0

        x_new = x_best + delta
        f_new = func(np.clip(x_new, lb, ub))

        if f_new < f_best:
            x_best = x_new
            f_best = f_new
        elif rng.uniform(0, 1) < np.exp((f_best - f_new) / T):
            x_best = x_new
            f_best = f_new

        T *= cooling_rate

    return x_best
