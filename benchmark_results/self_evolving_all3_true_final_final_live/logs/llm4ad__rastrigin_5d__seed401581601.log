def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    x = np.zeros(dim)
    best_x = np.copy(x)
    best_f = float('inf')
    pop_size = 50
    sigma = 0.5
    F = 0.7
    CR = 0.9

    for _ in range(budget):
        candidates = rng.normal(loc=x, scale=sigma, size=(pop_size, dim))
        candidates = np.clip(candidates, lb, ub)
        fitnesses = objective(candidates)

        if np.min(fitnesses) < best_f:
            best_f = np.min(fitnesses)
            best_x = candidates[np.argmin(fitnesses)]

        ranks = np.argsort(fitnesses)
        for i in range(pop_size):
            idx1, idx2, idx3 = rng.choice(pop_size, size=3, replace=False)
            u = candidates[ranks[i], :]
            v = candidates[ranks[idx1], :]
            w = candidates[ranks[idx2], :]
            z = candidates[ranks[idx3], :]

            a = F * (u - x) + v
            b = F * (v - x) + w
            c = F * (w - x) + u

            if rng.random() < CR or np.all(a == u):
                mutant = a
            elif rng.random() < CR or np.all(b == u):
                mutant = b
            else:
                mutant = c

            mutant = np.clip(mutant, lb, ub)

            y = objective(mutant)
            if y < fitnesses[i]:
                candidates[ranks[i], :] = mutant
                fitnesses[i] = y

        x = np.copy(candidates[np.argsort(fitnesses)[:1]])

    return best_x
