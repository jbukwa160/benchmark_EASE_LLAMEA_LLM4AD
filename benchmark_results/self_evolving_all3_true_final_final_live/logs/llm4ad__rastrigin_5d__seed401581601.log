def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    cr = 0.9
    f = 0.5
    sigma_init = 0.1
    x_best = None
    f_best = float('inf')
    
    for _ in range(budget):
        if rng.uniform(0, 1) < 0.2:
            sigma = sigma_init
        else:
            mu = np.mean([individual[:dim] for individual in rng.choice(10000, size=pop_size, replace=False)], axis=0)
            cov = np.cov(np.array([individual[:dim] for individual in rng.choice(10000, size=pop_size, replace=False)]).T)
            sigma = np.sqrt(np.diag(cov) + 1e-8)
        
        offspring = []
        for _ in range(pop_size):
            trial = rng.uniform(lb, ub, dim)
            mutation = f * rng.normal(0, sigma, dim)
            crossover = cr * rng.choice([individual[:dim] for individual in rng.choice(10000, size=pop_size, replace=False)], size=1)[0]
            new_individual = trial + mutation + crossover
            offspring.append(np.clip(new_individual, lb, ub))
        
        offspring_scores = [func(individual) for individual in offspring]
        scores = np.array(offspring_scores)
        indices = np.argsort(scores)
        offspring = [offspring[i] for i in indices]
        
        if scores[0] < f_best:
            x_best = offspring[0]
            f_best = scores[0]
    
    return np.array(x_best[:dim])
