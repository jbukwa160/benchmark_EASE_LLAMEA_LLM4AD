def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best = None
    current = rng.uniform(lb, ub, size=dim)
    temperature = 1.0
    for i in range(budget):
        candidate = clip(current + rng.uniform(-1, 1, size=dim))
        new_temperature = max(0.01, temperature * 0.9999)
        
        if func(candidate) < func(best) or rng.random() < np.exp((func(current) - func(candidate)) / new_temperature):
            current = candidate
            best = current
            
            # Accept the new solution with probability 1 (since it's better)
            temperature = new_temperature
        
        elif i % 100 == 0:  # Reduce temperature every 100 iterations
            temperature = new_temperature
    
    return best
