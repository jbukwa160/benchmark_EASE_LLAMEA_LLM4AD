def algorithm(func, dim, lb, ub, budget, rng):
    def get_bounds(dim):
        return (np.full((dim,), lb), np.full((dim,), ub))

    def generate_initial_population(budget, rng):
        population = np.random.uniform(get_bounds(dim)[0], get_bounds(dim)[1], size=(budget, dim))
        return population

    def evaluate_fitness(population, func):
        fitness = func(population)
        return fitness

    def differential_evolution(population, func, bounds):
        N = population.shape[0]
        D = population.shape[1]

        for i in range(N):
            p1, p2, p3 = rng.choice(range(N), size=3, replace=False)

            # mutation
            mutant = population[p1] + 0.5 * (population[p2] - population[p3])

            # crossover
            trial = np.where(rng.uniform(size=D) < 0.5, mutant, population[i])

            # selection
            if func(trial) < func(population[i]):
                population[i] = trial

        return population

    def bayesian_optimization(population, budget):
        best_idx = np.argmax(np.abs(population))
        best_point = population[best_idx]
        new_points = np.array([get_bounds(dim)[0] + (get_bounds(dim)[1] - get_bounds(dim)[0]) * rng.uniform(size=dim) for _ in range(budget // 2)])

        for i, point in enumerate(new_points):
            if func(point) < func(best_point):
                best_idx = len(population)
                population = np.vstack((population, point))
            else:
                population[best_idx] = point

        return population

    def run_algorithm(func, dim, lb, ub, budget, rng):
        population = generate_initial_population(budget, rng)
        for _ in range(10):  # 10 iterations of DE and BO
            population = differential_evolution(population, func, get_bounds(dim))
            population = bayesian_optimization(population, budget)

        best_idx = np.argmax(np.abs(population))
        return population[best_idx]

    return run_algorithm(func, dim, lb, ub, budget, rng)
