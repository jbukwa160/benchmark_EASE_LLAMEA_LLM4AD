def algorithm(func, dim, lb, ub, budget, rng):
    def obj(x):
        return func(x)

    init = rng.uniform(lb, ub, (dim,))
    res = minimize(obj, init, method='SLSQP', bounds=[(lb, ub)]*dim)
    
    best_x = np.clip(res.x, lb, ub)
    return best_x
