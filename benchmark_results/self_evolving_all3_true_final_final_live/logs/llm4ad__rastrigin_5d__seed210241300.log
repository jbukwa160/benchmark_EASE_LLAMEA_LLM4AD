def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    x = rng.uniform(lb, ub, size=(1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    alpha = 0.5
    T = 10000
    
    for _ in range(budget):
        y = x + alpha * (rng.normal(size=x.shape) - rng.uniform(0, 2*np.pi, size=x.shape))
        y = clip(y)
        
        f_y = func(y)
        if f_y < best_f:
            best_x = y.copy()
            best_f = f_y
        
        delta = T / (_ + 1)
        if np.random.rand() < np.exp(-(best_f - f_y) / delta):
            x = y.copy()
    
    return best_x
