def algorithm(func, dim, lb, ub, budget, rng):
    D = np.diag([1] * dim)
    X = np.zeros((budget, dim))
    Y = np.full(budget, -np.inf)

    for i in range(1, budget + 1):
        mu, s2 = gp_posterior(X[:i], Y[:i])
        
        def acquisition(x):
            mu_x = x @ D @ mu
            std_x = np.sqrt(x @ D @ np.diag(s2) @ D @ x)
            return mu_x - np.sqrt(rng.uniform(0, 1)) * std_x
        
        best_so_far = np.min(Y[:i])
        next_candidate = minimize(acquisition, bounds=[{'name': 'x_%d' % j, 'type': 'continuous', 'domain': [-5.0, 5.0]} for j in range(dim)], method='SLSQP')
        
        # Clip candidate to bounds
        next_x = np.array([ub if x >= ub else lb if x <= lb else x for x in next_candidate.x])
        
        Y[i - 1] = func(next_x)
        X[i - 1, :] = next_x

    best_idx = np.argmax(Y)
    return X[best_idx, :]
