def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_y = func(x)
    
    for _ in range(budget):
        step_size = 0.1
        noise = np.zeros(dim)
        for i in range(dim):
            if rng.random() < 0.5:
                noise[i] = rng.uniform(-step_size, step_size)
            else:
                noise[i] = -rng.uniform(0, step_size)
        
        candidate_x = best_x + noise
        candidate_x = np.clip(candidate_x, lb, ub)
        
        candidate_y = func(candidate_x)
        if candidate_y < best_y:
            best_x = candidate_x
            best_y = candidate_y
    
    return best_x
