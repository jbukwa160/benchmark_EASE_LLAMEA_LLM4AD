def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    best_candidate = rng.uniform(low=lb, high=ub, size=(dim,))
    best_fitness = func(clip(best_candidate))

    for _ in range(budget):
        new_candidate = clip(rng.normal(loc=best_candidate, scale=1.0, size=(dim,)))
        new_fitness = func(new_candidate)
        
        if new_fitness < best_fitness:
            best_candidate = new_candidate
            best_fitness = new_fitness

    return best_candidate
