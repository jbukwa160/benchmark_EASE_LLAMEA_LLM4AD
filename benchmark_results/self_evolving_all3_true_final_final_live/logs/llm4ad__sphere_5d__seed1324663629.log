def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_val = float('inf')

    # Set initial learning rate and maximum iterations for each restart
    lr = 1.0
    max_iter = int(budget / dim)

    # Define a helper function to perform SGD with adaptive learning rate
    def sgd(x, iter):
        nonlocal lr
        for i in range(dim):
            if rng.uniform() < 0.5:
                x[i] += np.sign(rng.normal()) * (ub - lb) * (lr / (iter + 1))**2
            else:
                x[i] -= np.sign(rng.normal()) * (ub - lb) * (lr / (iter + 1))**2
        x = np.clip(x, lb, ub)
        return func(x)

    # Perform random restarts and SGD iterations
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        iter = 0
        while iter < max_iter:
            new_val = sgd(x.copy(), iter)
            if new_val < best_val:
                best_x = x.copy()
                best_val = new_val
            iter += 1

    return best_x
