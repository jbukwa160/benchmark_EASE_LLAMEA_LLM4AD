def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.sqrt(budget))
    x_pop = rng.uniform(lb, ub, (pop_size, dim))
    best_x = None
    best_f = float('inf')
    
    for _ in range(budget):
        y_pop = np.zeros((pop_size, dim))
        
        for i in range(pop_size):
            a, b, c = rng.choice(pop_size, 3, replace=False)
            
            if rng.uniform(0, 1) < 0.5:
                y_pop[i] = x_pop[a] + rng.uniform(-1, 1) * (x_pop[b] - x_pop[c])
            else:
                y_pop[i] = x_pop[a] - rng.uniform(-1, 1) * (x_pop[b] - x_pop[c])
            
            y_pop[i] = np.clip(y_pop[i], lb, ub)
        
        f_values = [func(x) for x in y_pop]
        
        best_idx = np.argmin(f_values)
        new_best_f = f_values[best_idx]
        
        if new_best_f < best_f:
            best_f = new_best_f
            best_x = y_pop[best_idx]
        
        x_pop = np.where(rng.uniform(0, 1, size=(pop_size, dim)) < 0.5, y_pop, x_pop)
    
    return best_x if best_x is not None else np.zeros(dim)
