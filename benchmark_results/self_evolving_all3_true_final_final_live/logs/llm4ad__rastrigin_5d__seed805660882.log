def algorithm(func, dim, lb, ub, budget, rng):
    def gp_model(x, X, Y, sigma_sq):
        K = np.exp(-np.sum((x[:, None] - X) ** 2, axis=2) / (2 * sigma_sq))
        mu = np.mean(Y)
        s2 = 1 / (1 / sigma_sq + 1 / np.var(Y) + np.sum(1 / (sigma_sq * K), axis=0))
        s2 = 1 / (1 / sigma_sq + 1 / np.var(Y)) if np.isinf(s2) else s2
        return mu + np.dot(K, (Y - mu) / s2)

    def predict(x, X, Y, sigma_sq):
        return gp_model(x, X, Y, sigma_sq)

    def sample_gp(x_mean, x_std, num_samples):
        return np.random.normal(x_mean, x_std, size=(num_samples, dim))

    X = np.zeros((0, dim))
    Y = np.zeros(0)
    sigma_sq = 1.0
    for _ in range(budget):
        if len(X) == 0:
            x_new = (ub - lb) * rng.rand(dim) + lb
        else:
            x_new_mean, x_new_std = predict(x_new=0, X=X, Y=Y, sigma_sq=sigma_sq)
            x_new = sample_gp(x_mean=x_new_mean, x_std=x_new_std, num_samples=1)[0]
        f_x_new = func(x_new)
        X = np.vstack((X, x_new))
        Y = np.hstack((Y, f_x_new))
        argmin_idx = np.argmin(Y)
        best_x = X[argmin_idx]
        if len(X) > 100:
            sigma_sq = np.mean(np.var(Y[:argmin_idx]) + np.var(Y[argmin_idx+1:]))
    return best_x
