def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    N = 50
    F = 0.5
    CR = 0.9
    
    pop = rng.uniform(lb, ub, (N, D))
    
    for t in range(1, budget + 1):
        targets = np.zeros((N,))
        
        for i in range(N):
            candidate = pop[i] + F * (pop[rng.randint(0, N), :] - pop[rng.randint(0, N), :] +
                                      pop[rng.randint(0, N), :] - pop[rng.randint(0, N), :])
            candidate = np.clip(candidate, lb, ub)
            
            if rng.random() < CR or func(candidate) <= func(pop[i]):
                targets[i] = candidate
            else:
                targets[i] = pop[i]
        
        pop = targets
        
    best_candidate = pop[np.argmin([func(x) for x in pop])]
    
    return np.clip(best_candidate, lb, ub)
