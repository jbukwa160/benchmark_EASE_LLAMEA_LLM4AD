def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    current_best = None
    grid_size = 10 * (ub - lb) / rng.randint(1, 100)
    for _ in range(budget):
        if current_best is not None:
            grid_size *= 0.9

        grid = np.linspace(lb, ub, int((ub - lb) / grid_size))
        grid = np.array(np.meshgrid(*[grid]*dim)).T.reshape(-1, dim)
        grid = [clip(x) for x in grid]

        scores = []
        for point in grid:
            score = func(point)
            if current_best is None or score < func(current_best):
                current_best = point
            scores.append(score)

        best_idx = np.argmin(scores)
        grid[best_idx] = clip(grid[best_idx] + rng.uniform(-grid_size/10, grid_size/10))
        
    return current_best
