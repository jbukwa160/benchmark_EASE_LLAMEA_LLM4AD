def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_population(size, dim):
        return rng.uniform(lb, ub, (size, dim))

    def evaluate(population):
        return np.array([func(ind) for ind in population])

    def mutate(individuals, mutation_rate):
        mutated = individuals.copy()
        mask = rng.random((len(individuals), len(individuals[0]))) < mutation_rate
        mutated[mask] += rng.uniform(-1, 1, size=(np.sum(mask), dim))
        return clip(mutated)

    def select_best(population, fitnesses):
        indices = np.argsort(fitnesses)
        return population[indices[:int(len(indices) * 0.2)]], fitnesses[indices[:int(len(indices) * 0.2)]]

    def gradient_descent(population, step_size):
        gradients = np.array([func(np.append(individuals[i], func(individuals[i])))[1:] for i in range(len(individuals))])
        return clip(population - step_size * gradients)

    population = generate_population(100, dim)
    best_individual = None
    best_fitness = float('inf')

    for _ in range(budget):
        fitnesses = evaluate(population)
        population, fitnesses = select_best(population, fitnesses)
        
        # Apply gradient descent to the selected individuals
        population = gradient_descent(population, 0.01)

        mutated_population = mutate(population, 0.1)
        merged_population = np.vstack((population, mutated_population))

        best_individuals, _ = select_best(merged_population, evaluate(merged_population))
        
        # Update the best individual
        if best_fitness > np.min(evaluate(best_individuals)):
            best_individual = best_individuals[np.argmin(evaluate(best_individuals))]
            best_fitness = np.min(evaluate(best_individuals))

    return clip(best_individual)
