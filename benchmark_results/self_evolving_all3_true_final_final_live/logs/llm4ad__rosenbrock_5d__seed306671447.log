def algorithm(func, dim, lb, ub, budget, rng):
    def wrapper(x):
        return func(np.clip(x, lb, ub))

    bounds = [(lb, ub) for _ in range(dim)]
    result = differential_evolution(wrapper, bounds, maxiter=budget)
    best_x = np.array(result.x)
    
    # Local search around the global optimum
    for i in range(budget):
        x = best_x + 0.1 * (ub - lb) * rng.randn(dim)
        x = np.clip(x, lb, ub)
        if wrapper(x) < result.fun:
            best_x = x
    
    return best_x
