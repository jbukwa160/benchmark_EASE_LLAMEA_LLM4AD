def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([lb + (ub - lb) * rng.random(dim)])
    
    for _ in range(budget):
        dx = 0.1 * np.clip(rng.normal(size=dim), -2, 2)
        new_x = np.clip(x + dx, lb, ub)
        
        if func(new_x) < func(x):
            x = new_x
            
    return x
