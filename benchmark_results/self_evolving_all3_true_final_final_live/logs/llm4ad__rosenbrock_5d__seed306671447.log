def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(x, sigma, p):
        return x + rng.uniform(-sigma, sigma) * rng.choice([-1, 1], size=dim)

    def crossover(x1, x2, cr):
        u = rng.random(size=dim)
        return x1 + cr * (x2 - x1)

    def evaluate(x):
        return func(x)

    best_x = np.copy(np.linspace(lb, ub, dim))
    best_f = float('inf')

    for i in range(budget):
        sigma = 0.5 / (i + 1)
        cr = 0.9
        p = 0.3

        x = mutate(best_x, sigma, p)

        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)

        f = evaluate(x)

        if f < best_f:
            best_f = f
            best_x = np.copy(x)

        for j in range(budget - 1):
            x1 = mutate(best_x, sigma, p)
            # Clip candidates to [lb, ub]
            x1 = np.clip(x1, lb, ub)

            f1 = evaluate(x1)

            if f1 < best_f:
                best_f = f1
                best_x = np.copy(x1)

                for k in range(budget - 2):
                    x2 = crossover(best_x, x1, cr)
                    # Clip candidates to [lb, ub]
                    x2 = np.clip(x2, lb, ub)

                    f2 = evaluate(x2)

                    if f2 < best_f:
                        best_f = f2
                        best_x = np.copy(x2)

    return best_x
