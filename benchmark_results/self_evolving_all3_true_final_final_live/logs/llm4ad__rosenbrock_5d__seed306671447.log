def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    n_dim = dim
    x_mean = np.random.uniform(lb, ub, n_dim)
    sigma = 10.0 * (ub - lb) / np.sqrt(n_dim)
    n_samples, s_count, c_count = 0, 0, 0

    while n_samples < budget:
        if rng.rand() < 0.5:
            x_new = clip(x_mean + rng.normal(0, sigma, n_dim))
        else:
            x_new = clip(x_mean - rng.normal(0, sigma, n_dim))

        y_new = func(x_new)
        n_samples += 1
        s_count += 1

        if y_new < func(x_mean):
            x_mean = x_new.copy()
            c_count = max(c_count - 3, 0)
        else:
            c_count += 1

        sigma *= np.exp(-c_count / (n_samples + 10))
        if s_count > n_samples * 0.5 and rng.rand() < 0.01:
            sigma /= np.sqrt(n_samples)

    return x_mean
