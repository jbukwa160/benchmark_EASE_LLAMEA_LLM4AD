def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def nelder_mead(x0, func, dim, max_iter=100):
        x = x0.copy()
        y = func(x)
        for _ in range(max_iter):
            z = x + 0.5 * rng.randn(dim) / np.sqrt(np.sum(rng.rand(dim)))
            z = clip(z)
            zy = func(z)
            if zy < y:
                y, x = zy, z
            else:
                s = 1
                for i in range(1, dim+1):
                    r = rng.rand()
                    s *= (2 * r - 1) ** 2 / i
                x += s * (x - z)
        return x

    def genetic_multi_start(func, dim, lb, ub, budget, pop_size=50):
        best_x = np.zeros(dim)
        for _ in range(budget // pop_size):
            population = rng.randn(pop_size, dim) * 0.1 + (lb + ub) / 2
            population = clip(pop_size, population)
            for x in population:
                nelder_mead(x, func, dim)
        return best_x

    rng.seed(0)
    budget //= 5
    return genetic_multi_start(func, dim, lb, ub, budget)
