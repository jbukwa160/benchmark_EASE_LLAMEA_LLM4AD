def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(best_x)
    current_x = np.random.uniform(lb, ub, size=dim)
    
    T = 1000.0
    t = 0
    
    while t < budget:
        for _ in range(dim):
            i = rng.choice(dim)
            step = np.random.normal(0, 1, size=1) * (ub - lb)
            current_x[i] += clip(current_x + step)[i]
        
        current_f = func(current_x)
        
        if current_f < best_f:
            best_f = current_f
            best_x = current_x[:]
        
        if rng.random() < np.exp((best_f - current_f) / T):
            current_x = best_x[:]
        
        T *= 0.9999
        
        t += 1
    
    return best_x
