def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=(dim))
    f_best = func(x_best)

    for _ in range(budget):
        x1, x2, x3 = rng.choice(dim, 3, replace=False), rng.choice(dim, 3, replace=False)
        v = lb + (ub - lb) * rng.uniform(0, 1, size=(dim))
        v[x1] = x_best[x1]
        v[x2] = func(x_best + 0.01 * rng.normal(size=dim)) > f_best and x_best[x2] or x_best[x2]
        if np.random.rand() < 0.5:
            v[x3] = func(x_best - 0.01 * rng.normal(size=dim)) > f_best and x_best[x3] or x_best[x3]
        else:
            v[x3] = (func(x_best + 0.01 * rng.normal(size=dim)) > f_best and
                     func(x_best + 0.01 * rng.normal(size=dim)) < func(x_best - 0.01 * rng.normal(size=dim))) and x_best[x3] or np.mean([x_best[x3], ub])

        v = np.clip(v, lb, ub)
        f_new = func(v)
        if f_new < f_best:
            f_best = f_new
            x_best = v

    return x_best
