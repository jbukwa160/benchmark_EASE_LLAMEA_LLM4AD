def algorithm(func, dim, lb, ub, budget, rng):
    D = len(dim)
    x_best = np.zeros(D)
    f_best = float('inf')
    
    for t in range(budget):
        sigma = max(1e-6, 0.01 * (ub - lb) / (t + 1))
        
        while True:
            x_new = rng.uniform(lb, ub, D) if np.random.rand() < 0.5 else x_best + rng.normal(size=D) * sigma
            
            # Clip to bounds
            for i in range(D):
                x_new[i] = max(lb[i], min(x_new[i], ub[i]))
            
            f_new = func(x_new)
            
            if f_new < f_best:
                x_best = x_new
                f_best = f_new
                break
            
            # Epsilon-greedy exploration
            if np.random.rand() < 0.01:
                break
        
        if t % (budget // 10) == 0:
            print(f'Iter {t+1}/{budget}, best objective: {f_best:.4e}')
    
    return x_best
