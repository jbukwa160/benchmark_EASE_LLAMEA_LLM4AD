def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    pop_size = 20  # population size
    x_best = np.zeros(dim)
    f_best = float('inf')
    pop = np.random.uniform(lb, ub, (pop_size, dim))

    for _ in range(budget):
        for i in range(pop_size):
            x_new = x_best.copy()
            idx = rng.choice(pop_size, size=dim, replace=False)
            x_new[idx] += 0.1 * pop[idx] - 0.5 * (ub - lb) * np.random.uniform(size=(dim))
            x_new = clip(x_new)
            f_new = func(x_new)

            if f_new < f_best:
                f_best = f_new
                x_best = x_new

        pop = pop_size * [x_best]

    return x_best
