def algorithm(func, dim, lb, ub, budget, rng):
    def gradient(x):
        return 2 * x - 20 * np.sin(2 * np.pi * x)

    def func_value(x):
        return func(np.array([x]))

    current = rng.uniform(lb, ub, size=dim)
    best = current.copy()
    temperature = budget / (budget + dim**2)
    step_size = rng.uniform(0.01, 1) ** 4

    for _ in range(budget):
        new = current + step_size * gradient(current)
        new = np.clip(new, lb, ub)

        if rng.random() < temperature:
            if func_value(new) < func_value(best):
                best = new
                current = new
            else:
                if rng.random() < 0.5 and _ > budget // 2:
                    current = best.copy()
        elif np.any(np.isnan(new)):
            continue

    return best
