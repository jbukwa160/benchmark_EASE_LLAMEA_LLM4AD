def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def polynomialMutation(x, etaMu, mu):
        y = x + (np.random.uniform(-1.0, 1.0) * etaMu ** (mu - 1)) * (x - np.floor(x))
        y = clip(y, lb, ub)
        return y

    def differentialEvolution(func, dim, lb, ub, budget, rng):
        popSize = int(budget / (dim + 2))
        best_x = None
        archive = []
        for i in range(popSize):
            x = np.zeros(dim)
            for j in range(dim):
                x[j] = rng.uniform(lb, ub)
            y = func(x)
            if y < np.inf:
                archive.append((x, y))
                if best_x is None or y < archive[-1][1]:
                    best_x = x
        if best_x is not None:
            for _ in range(budget - popSize):
                p1, p2, p3 = rng.choice(archive, 3, replace=False)
                xNew = p1[0] + (p2[0] - p3[0]) * np.random.uniform(-1.0, 1.0)
                xNew = clip(xNew, lb, ub)
                yNew = func(xNew)
                if yNew < archive[-1][1]:
                    archive.append((xNew, yNew))
        return best_x

    def aDE(func, dim, lb, ub, budget, rng):
        popSize = 50
        etaMu = 20
        mu = 20
        best_x = None
        archive = []
        for _ in range(popSize):
            x = np.zeros(dim)
            for j in range(dim):
                x[j] = rng.uniform(lb, ub)
            y = func(x)
            if y < np.inf:
                archive.append((x, y))
                if best_x is None or y < archive[-1][1]:
                    best_x = x
        for _ in range(budget - popSize):
            p1, p2, p3 = rng.choice(archive, 3, replace=False)
            xNew = polynomialMutation(p1[0], etaMu, mu) + (p2[0] - p3[0]) * np.random.uniform(-1.0, 1.0)
            xNew = clip(xNew, lb, ub)
            yNew = func(xNew)
            if yNew < archive[-1][1]:
                archive.append((xNew, yNew))
        return best_x

    return aDE(func, dim, lb, ub, budget, rng)
