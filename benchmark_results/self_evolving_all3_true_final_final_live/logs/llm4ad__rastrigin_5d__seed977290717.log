def algorithm(func, dim, lb, ub, budget, rng):
    def get_next_point(x0, F, Cr):
        x = x0 + F * (np.random.rand(dim) - 0.5)
        u1 = np.random.rand(dim)
        u2 = np.random.rand(dim)
        while True:
            v = u1 * x0 + u2 * x
            if np.all(v >= lb) and np.all(v <= ub):
                return v
            elif rng.random() < 0.5:
                break

    def simulated_annealing(x0, T_max, cooling_rate, budget):
        current_solution = x0
        best_solution = x0
        for t in range(budget):
            next_point = get_next_point(current_solution, rng.uniform(-1, -0.2), rng.uniform(0, 0.5))
            delta = func(next_point) - func(current_solution)
            if delta < 0:
                current_solution = next_point
                best_solution = next_point
            else:
                probability = np.exp(-delta / T_max)
                if rng.random() < probability:
                    current_solution = next_point
            T_max *= (1 + cooling_rate)
        return best_solution

    initial_guess = lb + (ub - lb) * np.random.rand(dim)
    solution = simulated_annealing(initial_guess, 100, 0.01, budget // 2)
    for _ in range(budget - (budget // 2)):
        next_point = get_next_point(solution, rng.uniform(-1, -0.2), rng.uniform(0, 0.5))
        delta = func(next_point) - func(solution)
        if delta < 0:
            solution = next_point
    return np.clip(solution, lb, ub)
