def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def objective(x):
        return func(x) + 1e6 * sum(np.abs(x))

    pop_size = int(budget ** (2/3))
    temp = budget / pop_size
    x_best = clip(rng.uniform(lb, ub, size=(dim)))

    for _ in range(pop_size):
        y = x_best + rng.normal(0, 1e-1, size=(dim))
        y = clip(y)
        if objective(y) < objective(x_best):
            x_best = y

        temp *= 0.99
        sigma = 1 / np.sqrt(temp)

        for _ in range(pop_size // 2):
            z = x_best + rng.normal(0, sigma, size=(dim))
            z = clip(z)
            if objective(z) < objective(x_best):
                x_best = z

    return x_best
