def algorithm(func, dim, lb, ub, budget, rng):
    def sample_gp(mean, cov):
        z = np.zeros(dim)
        for i in range(dim):
            if rng.random() < 0.5:
                z[i] = np.random.normal(0, 1)
            else:
                z[i] = -np.random.normal(0, 1)
        return mean + np.dot(cov, z)

    def acquire_samples(mean, cov, x_best):
        samples = []
        for _ in range(budget // dim):
            new_x = sample_gp(mean, cov)
            new_x = lb + (ub - lb) * (new_x + 5) / 10
            samples.append(new_x)
        return np.array(samples)

    def update_gp(x_best, x_new, f_x_best, f_x_new):
        cov = np.eye(dim)
        for _ in range(budget // dim):
            z = np.zeros(dim)
            for i in range(dim):
                if rng.random() < 0.5:
                    z[i] = np.random.normal(0, 1)
                else:
                    z[i] = -np.random.normal(0, 1)
            cov += np.outer(z, z)

    mean = np.zeros(dim)
    cov = np.eye(dim)
    x_best = None
    f_x_best = float('inf')

    for i in range(budget):
        samples = acquire_samples(mean, cov, x_best)
        if len(samples) > 0:
            f_samples = func(np.array([samples[0]]))
            for sample in samples[1:]:
                f_sample = func(sample)
                if f_sample < f_samples:
                    f_samples = f_sample
                    x_best = sample
        else:
            x_best = np.random.uniform(lb, ub, dim)

        if f_x_best > f_samples and len(samples) > 0:
            f_x_best = f_samples
            mean = mean + (x_best - mean) / (i + 1)
            cov = (1 - 1/(i+1)) * cov + 1/(i+1) * np.outer(x_best - mean, x_best - mean)

        if i % (budget // 10) == 0:
            print(f'Iter {i} | f_x_best = {f_x_best}')

    return x_best
