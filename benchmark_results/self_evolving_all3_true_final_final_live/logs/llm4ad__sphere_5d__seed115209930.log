def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.array([ub + (lb - ub) * rng.random(dim)])
    
    for _ in range(budget):
        x_new = np.clip(lb + (ub - lb) * rng.random((1, dim)), a_min=lb, a_max=ub)
        
        if func(x_new[0]).item() < func(x_best[0]).item():
            x_best = x_new
    
    return x_best
