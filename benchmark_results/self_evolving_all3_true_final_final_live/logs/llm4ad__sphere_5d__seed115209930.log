def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
            
        lb_clip = np.clip(best_x - 0.1 * (ub - lb), lb, ub)
        ub_clip = np.clip(best_x + 0.1 * (ub - lb), lb, ub)
        
        for _ in range(10):
            candidate = rng.uniform(lb_clip, ub_clip, size=dim)
            f_candidate = func(candidate)
            
            if f_candidate < best_f:
                best_f = f_candidate
                best_x = candidate
                
    return best_x
