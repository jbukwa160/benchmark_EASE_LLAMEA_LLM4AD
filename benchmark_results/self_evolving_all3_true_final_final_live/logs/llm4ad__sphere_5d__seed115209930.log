def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = dim + 1
    x0 = rng.uniform(lb, ub, size=dim)
    x = [clip(x0)]
    
    for _ in range(budget - 1):
        simplex = np.array(x)
        order = np.argsort([func(clip(y)) for y in simplex])
        
        if func(simplex[order[-1]]) < func(simplex[order[0]]):
            centroid = (simplex[order[:-1]].mean(axis=0) + simplex[order[-1]]) / 2
            x.append(clip(centroid))
        else:
            shrink_factor = 0.5 if _ > budget // 3 else np.power(0.5, _ / (budget - 1))
            centroid = (simplex[order[:-1]].mean(axis=0) + simplex[order[-1]]) / 2
            x.append(clip(shrink_factor * simplex[order[0]] + (1 - shrink_factor) * centroid))
    
    best_x = np.array(x)[-1]
    return best_x
