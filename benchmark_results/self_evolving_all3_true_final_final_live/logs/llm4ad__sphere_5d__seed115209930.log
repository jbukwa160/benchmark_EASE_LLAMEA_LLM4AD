def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidates(mean, cov, n):
        return mean + np.dot(cov, rng.standard_normal((n, dim)))

    def evaluate_candidates(candidates):
        return [func(candidate) for candidate in candidates]

    n = budget
    mean = np.zeros(dim)
    cov = 1e6 * np.eye(dim)

    for i in range(n):
        candidates = generate_candidates(mean, cov, budget)
        clipped_candidates = clip(candidates)
        fitnesses = evaluate_candidates(clipped_candidates)
        best_index = np.argmin(fitnesses)
        new_mean = mean + (clipped_candidates[best_index] - mean) / (i + 1)

        if i < n - 1:
            cov *= 1 + (clipped_candidates[best_index].dot(clipped_candidates[best_index]) - new_mean.dot(new_mean)) / (2 * (i + 1))
            mean = new_mean

    return clip(mean)
