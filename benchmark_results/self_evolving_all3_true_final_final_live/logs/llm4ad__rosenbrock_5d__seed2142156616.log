def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    def evaluate(x):
        x = clip(x)
        return func(x), x

    def differential_evolution(bounds, cost_func, pop_size=20, f=0.5, cr=0.9, budget=budget//2):
        pop = rng.uniform(lb, ub, (pop_size, dim))
        for _ in range(budget):
            targets = pop[np.random.choice(pop_size, size=3, replace=False)]
            trial = np.copy(targets[0])
            for i in range(dim):
                mask = np.random.rand(dim) < cr
                trial[mask] = rng.uniform(lb, ub, size=np.sum(mask))
                trial[~mask] = targets[np.random.choice(3, size=np.sum(~mask))][i]
            trial = clip(trial)
            _, target = evaluate(target=targets[0])
            _, trial = evaluate(trial)
            if cost_func(trial) < cost_func(target):
                pop[np.argmax([evaluate(x)[0] for x in targets])] = trial
        return np.array(pop)

    def simulated_annealing(bounds, cost_func, budget=budget//2, T=10.0, alpha=0.9):
        x = rng.uniform(lb, ub)
        for _ in range(budget):
            new_x = clip(rng.normal(x, scale=T))
            _, current = evaluate(x)
            _, new_x = evaluate(new_x)
            if new_x < current:
                x = new_x
            else:
                T *= alpha
                x = rng.choice([x, new_x], p=[1-T/10.0, T/10.0])
        return np.array(x)

    population = differential_evolution(bounds=(lb, ub), cost_func=evaluate, budget=budget//2)
    best_x = simulated_annealing(bounds=(lb, ub), cost_func=lambda x: evaluate(clip(x))[0], budget=budget//2)
    
    _, best_x = evaluate(best_x)

    return best_x
