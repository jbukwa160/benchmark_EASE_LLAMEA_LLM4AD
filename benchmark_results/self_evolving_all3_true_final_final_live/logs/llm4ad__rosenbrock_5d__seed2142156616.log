def algorithm(func, dim, lb, ub, budget, rng):
    def init_population(n_dim, population_size):
        return rng.uniform(lb, ub, (population_size, n_dim))

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def crossover(x1, x2, cr):
        u = rng.random(size=(dim,))
        v = rng.random(size=(dim,))
        return (x1 + cr * (x2 - x1)) / 2, (x2 + cr * (x1 - x2)) / 2

    def mutate(x, f_best, f_max):
        u = rng.uniform(lb, ub)
        return x + rng.normal(0, f_max) * (f_best - x)

    def adapt_step_size(f_max, iteration):
        return 0.5 if iteration < budget // 10 else 0.1

    population = init_population(dim, 20)
    best_candidate = None
    f_best = float('inf')

    for iteration in range(1, budget + 1):
        for i in range(len(population)):
            x1, x2 = population[i], population[(i + rng.randint(0, len(population))) % len(population)]
            cr = rng.random()
            child1, child2 = crossover(x1, x2, cr)
            child1 = mutate(child1, f_best, 100.0 * (iteration / budget))
            child2 = mutate(child2, f_best, 100.0 * (iteration / budget))

            population[i] = clip((child1 + child2) / 2, lb, ub)

        for i in range(len(population)):
            candidate = population[i]
            candidate_value = func(candidate)
            if candidate_value < f_best:
                best_candidate = candidate
                f_best = candidate_value

    return best_candidate
