def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def fitness(candidate):
        candidate = clip(candidate)
        return func(candidate)

    cma_es = [np.random.uniform(lb, ub) for _ in range(dim)]
    c = 1.0
    sigma = (ub - lb) / 3.0

    for _ in range(budget):
        offspring = np.zeros((20, dim))
        for i in range(20):
            noise = rng.normal(size=dim)
            offspring[i] = cma_es + sigma * noise

        fitnesses = [fitness(offspring[i]) for i in range(20)]
        best_offspring = clip(offspring[np.argmin(fitnesses)])

        if np.mean([fitness(cma_es), fitness(best_offspring)]) < np.mean([fitnesses]):
            cma_es, sigma = best_offspring, 0.5 * sigma
            sigma *= (np.abs(np.mean(fitnesses) - fitness(cma_es)) / np.std(fitnesses) + 1e-6)

    return clip(cma_es)
