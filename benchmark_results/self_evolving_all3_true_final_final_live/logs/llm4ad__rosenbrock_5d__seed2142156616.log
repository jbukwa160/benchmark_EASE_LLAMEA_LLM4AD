def algorithm(func, dim, lb, ub, budget, rng):
    def rand(*size):
        return rng.uniform(lb, ub, size)

    # Initialize population
    x = np.zeros((budget, dim))
    for i in range(budget):
        x[i] = [rand() for _ in range(dim)]

    # Define parameters
    F_min, F_max = 0.1, 0.9
    CR_min, CR_max = 0.1, 0.9

    best_x = None
    best_f = float('inf')

    for i in range(budget):
        # Calculate fitness
        f = func(x[i])

        # Update best solution
        if f < best_f:
            best_f = f
            best_x = x[i]

        # Adapt mutation strategy and crossover rate
        F = F_min + (F_max - F_min) * np.random.rand()
        CR = CR_min + (CR_max - CR_min) * np.random.rand()

        for j in range(budget):
            if i != j:
                # Differential evolution step
                delta_x = F * (x[j] - x[i])
                u = x[i] + CR * delta_x

                # Clip to bounds
                u = [max(lb, min(ub, xi)) for xi in u]

                f_new = func(u)

                if f_new < f:
                    x[i] = u
                    f = f_new

    return best_x
