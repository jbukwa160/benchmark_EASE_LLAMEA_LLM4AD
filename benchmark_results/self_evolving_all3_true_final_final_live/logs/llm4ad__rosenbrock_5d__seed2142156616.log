def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    N = 50
    pop_size = 1000
    F = 1.5
    CR = 0.9
    best_solution = None

    for i in range(budget):
        X = rng.uniform(lb, ub, (pop_size, dim))
        V = np.zeros((pop_size, dim))

        for j in range(N):
            for k in range(pop_size):
                r1, r2, r3 = rng.randint(0, pop_size, 3)
                while r1 == k or r2 == k or r3 == k:
                    r1, r2, r3 = rng.randint(0, pop_size, 3)

                V[k] = X[r1] + F * (X[r2] - X[r3])

        u = np.random.rand(pop_size, dim) < CR
        for j in range(pop_size):
            if not np.any(u[j]):
                continue

            V[j] = np.where(u[j], V[j], X[j])
            V[j] = clip(V[j], lb, ub)

        fit = func(V)
        idx = np.argmin(fit)

        if best_solution is None or fit[idx] < func(best_solution):
            best_solution = V[idx]

    return best_solution
