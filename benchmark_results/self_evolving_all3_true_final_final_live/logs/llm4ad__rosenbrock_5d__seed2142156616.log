def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(x):
        return x + 0.1 * rng.normal(size=dim)

    def accept(x, x_new):
        if func(x_new) < func(x):
            return True
        else:
            return np.exp(-func(x_new)/func(x)) > norm.rvs()

    current_solution = lb + (ub - lb) * rng.uniform(size=dim)
    best_solution = current_solution.copy()
    best_score = func(best_solution)

    for i in range(budget):
        candidate = get_candidate(current_solution)
        clipped_candidate = np.clip(candidate, a_min=lb, a_max=ub)
        if accept(current_solution, clipped_candidate):
            current_solution = clipped_candidate
        if func(clipped_candidate) < best_score:
            best_solution = clipped_candidate.copy()
            best_score = func(best_solution)

    return best_solution
