def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    pop_size = int(np.ceil(budget**0.5))
    x = rng.uniform(lb, ub, (pop_size, n))
    for _ in range(int(budget)):
        u = np.zeros((pop_size, n))
        v = np.zeros((pop_size, n))
        for i in range(n):
            j = (np.random.randint(0, pop_size) + np.arange(pop_size)) % pop_size
            u[:,i] = x[j,i]
            j = (np.random.randint(0, pop_size) + np.arange(pop_size)) % pop_size
            v[:,i] = x[j,i]
        f_x = func(x)
        f_u = func(u)
        f_v = func(v)
        for i in range(n):
            x[np.argmin(f_u + 1e-8*(u - x)**2),i] = u[np.argmin(f_u + 1e-8*(u - x)**2),i]
            x[np.argmin(f_v + 1e-8*(v - x)**2),i] = v[np.argmin(f_v + 1e-8*(v - x)**2),i]
        for i in range(pop_size):
            for j in range(n):
                x[i,j] = np.clip(x[i,j], lb[j], ub[j])
    return np.min(x, axis=0)
