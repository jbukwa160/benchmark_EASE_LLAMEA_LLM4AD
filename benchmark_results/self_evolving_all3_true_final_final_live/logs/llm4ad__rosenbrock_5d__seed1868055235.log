def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        # Local gradient descent optimization
        x_best = x.copy()
        f_best = func(x_best)
        
        def grad_func(y):
            return np.sum(2 * 100 * (y[1:] - y[:-1]**2) * (y[1] - y[:-1]**2) + (y[:-1] - 1))
        
        for i in range(dim):
            learning_rate = 0.01
            step_size = learning_rate / np.sqrt(i)
            
            x_try = x_best.copy()
            x_try[i] += step_size * grad_func(x_try)
            f_try = func(np.clip(x_try, lb, ub))
            
            if f_try < f_best:
                x_best = x_try
                f_best = f_try
        
        # Grid search refinement
        step_size = 0.1
        for i in range(dim):
            x_try = np.copy(x_best)
            x_try[i] += step_size
            
            if func(np.clip(x_try, lb, ub)) < f_best:
                x_best = x_try
                f_best = func(np.clip(x_best, lb, ub))
            
            x_try = np.copy(x_best)
            x_try[i] -= step_size
            
            if func(np.clip(x_try, lb, ub)) < f_best:
                x_best = x_try
                f_best = func(np.clip(x_best, lb, ub))
        
        # Update best solution
        if f_best < best_f:
            best_x = x_best.copy()
            best_f = f_best
    
    return np.array(best_x)
