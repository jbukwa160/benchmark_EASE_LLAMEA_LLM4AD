def algorithm(func, dim, lb, ub, budget, rng):
    def expected_improvement(mean, sigma, best_y, x):
        z = (func(x) - best_y) / sigma
        if sigma == 0:
            return float('inf')
        elif mean >= best_y:
            return 0.0
        else:
            return (best_y - mean) * np.exp(-z**2/2) + sigma * z * np.erf(z/np.sqrt(2))

    def acquisition_function(mean, sigma, best_y):
        return expected_improvement(mean, sigma, best_y, x)

