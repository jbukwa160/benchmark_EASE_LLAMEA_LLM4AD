def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        if any(xi < lb or xi > ub for xi in x):
            return 1e10
        return func(x)

    def sample_gp(gp_mean, gp_var):
        return np.random.normal(loc=gp_mean, scale=np.sqrt(gp_var))

    def expected_improvement(gp_mean, gp_var, best_eval, gp_xmean, gp_xvar):
        z = (best_eval - gp_mean + 1e-8) / np.sqrt(gp_var)
        phi_z = rng.norm.cdf(z)
        omega_sq = gp_xvar / (gp_xvar + 1e-8)
        return (best_eval - gp_mean) * phi_z + np.sqrt((gp_xvar + 1e-8) * omega_sq * rng.norm.pdf(z))

    x_best = rng.uniform(lb, ub, size=dim)
    best_eval = evaluate(x_best)

    dim_x = np.zeros([budget, dim])
    for i in range(budget):
        gp_mean = sample_gp(0.0, 1e-8) if i == 0 else np.mean(gp_means)
        gp_var = sample_gp(1.0, 1e-8) if i == 0 else np.var(gp_vars)
        dim_x[i] = x_best + expected_improvement(gp_mean, gp_var, best_eval, gp_mean, gp_var) * rng.uniform(-1, 1, size=dim)

        for j in range(dim):
            clip = lb[j] if dim_x[i][j] < lb[j] else ub[j]
            dim_x[i][j] = max(min(clip, dim_x[i][j]), -5.0)
        x_candidate = dim_x[i]

        candidate_eval = evaluate(x_candidate)
