def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        v = x + rng.uniform(-1.0, 1.0, size=(dim,))
        v = clip(v)
        
        f_v = func(v)
        if f_v < best_f:
            best_x = v.copy()
            best_f = f_v
            
        F = rng.uniform(0.5, 1.0)
        u = rng.choice(dim)
        y = x.copy()
        y[u] = clip(x[u] + F * (v[u] - x[u]))
        
        f_y = func(y)
        if f_y < best_f:
            best_x = y.copy()
            best_f = f_y
            
        T = 1.0 / np.log(rng.uniform(1e-10, 1e10))
        prob = np.exp(-(best_f - f_y) / T)
        
        if rng.random() < prob:
            x[u] = clip(y[u])
            
    return best_x
