def algorithm(func, dim, lb, ub, budget, rng):
    n = 1 + int(np.floor(np.log2(budget)))
    mu = 10
    sigma0 = 1
    lambda_ = int(4 + 3 * (dim - 2) / dim)
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for t in range(budget):
        if rng.rand() < 0.1 and n > 10:
            # restart
            n = int(np.floor(np.log2(t + 1)))
            x_best = np.random.uniform(lb, ub, size=dim)
            f_best = func(x_best)

        C = (t / budget) * rng.normal(0, sigma0, size=(lambda_, dim)) + rng.normal(0, sigma0, size=(lambda_, dim))
        x = x_best + C

        # clip
        x = np.clip(x, lb, ub)

        f = func(x)
        if f < f_best:
            f_best = f
            x_best = x.copy()

        y = (f - f_best) / (sigma0 * rng.normal(0, 1))

    return x_best
