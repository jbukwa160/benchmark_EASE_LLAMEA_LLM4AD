def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidates(mean, sigma):
        return mean + sigma * rng.normal(size=(1, dim))

    def calculate_fitness(candidate):
        candidate = np.clip(candidate, lb, ub)
        return func(candidate)

    def update_mean(mean, candidates):
        weights = np.exp(-np.linalg.norm(candidates - mean, axis=1))
        weights /= np.sum(weights)
        return np.dot(candidates.T, weights)

    def adapt_sigma(sigma, candidates, best_fitness):
        if len(candidates) > 1:
            diff = candidates - np.repeat(best_candidate.mean(axis=0), len(candidates), axis=0)
            cov = np.cov(diff.T)
            sigma *= np.sqrt(np.linalg.det(cov))
        return sigma

    def cma_es(func, dim, lb, ub, budget, rng):
        mean = np.zeros((1, dim)) + (lb + ub) / 2
        sigma = 0.5 * (ub - lb)
        best_candidate = None
        best_fitness = float('inf')

        for _ in range(budget):
            candidates = generate_candidates(mean, sigma)
            fitnesses = np.array([calculate_fitness(candidate) for candidate in candidates])
            best_candidate_idx = np.argmin(fitnesses)
            best_candidate = candidates[best_candidate_idx]
            best_fitness = fitnesses[best_candidate_idx]

            if best_fitness < 0:
                break

            mean = update_mean(mean, candidates)
            sigma = adapt_sigma(sigma, candidates, best_fitness)

        return best_candidate

    rng.seed(1) # seed for reproducibility
    best_candidate = cma_es(func, dim, lb, ub, budget, rng)
    return best_candidate
