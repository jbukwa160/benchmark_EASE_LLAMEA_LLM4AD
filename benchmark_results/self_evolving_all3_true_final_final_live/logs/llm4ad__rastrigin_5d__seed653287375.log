def algorithm(func, dim, lb, ub, budget, rng):
    T = 1000 * (ub - lb)
    cooling_rate = 0.99
    pop_size = 50
    cr = 0.5
    f = lambda x: func(x)

    # Initial population
    x = np.zeros((pop_size, dim))
    for i in range(pop_size):
        x[i] = rng.uniform(lb, ub, (1, dim))[0]

    # Simulated Annealing
    for t in range(budget):
        # Evaluate fitness
        f_values = np.array([f(xi) for xi in x])

        # Differential Evolution mutation
        r1, r2, r3 = rng.choice(pop_size, 3, replace=False)
        v = x[r1] + cr * (x[r2] - x[r3])

        # Clip to bounds
        v = np.clip(v, lb, ub)

        # Selection
        if f(v) < f(x[r1]):
            x[r1] = v

        # Simulated Annealing cooling schedule
        T *= cooling_rate

    return x[np.argmin(f_values)]
