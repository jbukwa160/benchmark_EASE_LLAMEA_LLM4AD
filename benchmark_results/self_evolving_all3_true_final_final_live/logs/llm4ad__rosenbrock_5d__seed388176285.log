def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(mu, sigma):
        if sigma == 0:
            return mu
        candidate = mu + sigma * np.random.normal(size=dim)
        for i in range(dim):
            if candidate[i] < lb or candidate[i] > ub:
                candidate[i] = clip(candidate[i], lb, ub)
        return candidate

    def clip(x, lb, ub):
        if x < lb:
            return lb
        elif x > ub:
            return ub
        else:
            return x

    D = 1.0 + np.sqrt(dim) * rng.uniform(size=dim)
    mu = (ub - lb) * rng.uniform(size=dim) + lb
    sigma = max(D, 0.5)

    for _ in range(budget):
        candidate = generate_candidate(mu, sigma)
        fCandidate = func(candidate)
        if fCandidate < func(mu):
            mu = candidate
        sigma *= (1 + 2 * rng.uniform() - np.log(1 + 2 * rng.uniform()))
        sigma = max(sigma, 0.01)

    return mu
