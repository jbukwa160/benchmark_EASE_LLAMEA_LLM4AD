def algorithm(func, dim, lb, ub, budget, rng):
    x = 5 * (np.random.rand(dim) - 0.5)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        for i in range(dim):
            new_x = x.copy()
            noise = np.zeros_like(new_x)
            if rng.uniform(0, 1) < 0.5:
                noise[i] += rng.uniform(-1, 1)
            elif rng.uniform(0, 1) > 0.75:
                noise[i] -= rng.uniform(-1, 1)

            new_x = np.clip(new_x + noise * (ub - lb), lb, ub)
            new_f = func(new_x)

            if new_f < best_f:
                x = new_x.copy()
                best_x = x.copy()
                best_f = new_f

    return best_x
