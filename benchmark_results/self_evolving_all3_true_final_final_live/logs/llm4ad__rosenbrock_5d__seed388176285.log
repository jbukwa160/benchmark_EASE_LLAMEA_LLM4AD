def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    mu = 1e-4 * rng.uniform(-1, 1, size=n)
    sigma = 0.2
    best_x = mu.copy()
    best_f = func(best_x)

    for i in range(budget):
        x = mu + sigma * np.random.randn(n)
        x = np.clip(x, lb, ub)
        f = func(x)

        if f < best_f:
            best_f = f
            best_x = x

        delta = (x - mu) / sigma
        M = np.outer(delta, delta) - np.eye(n)
        c1 = 0.01
        c2 = 1 - 2 * c1
        p = n + 10
        C = np.eye(n) + c1 * M
        for _ in range(p):
            z = rng.normal(size=n)
            H = np.linalg.inv(C)
            y = mu + sigma * np.dot(H, z)
            y = np.clip(y, lb, ub)
            fy = func(y)

            if fy < best_f:
                best_f = fy
                best_x = y

        M /= n
        C += c2 * (M - C)
        inv_C = np.linalg.inv(C)
        sigma *= 1 + 0.1 * rng.uniform(-1, 1)

    return best_x
