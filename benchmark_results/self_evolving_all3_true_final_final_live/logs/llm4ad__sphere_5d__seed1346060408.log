def algorithm(func, dim, lb, ub, budget, rng):
    def clipped(candidate):
        return np.clip(candidate, lb, ub)

    x = clipped(rng.uniform(lb, ub, size=dim))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        y = x + 0.5 * rng.normal(size=dim)
        y = clipped(y)
        
        f_y = func(y)
        
        if f_y < best_f:
            best_f = f_y
            best_x = y.copy()
            
        v = np.zeros(dim)
        for i in range(dim):
            v[i] = rng.normal() * (ub - lb) / 2 + (ub + lb) / 2
        
        z = x + 0.1 * v + 0.5 * rng.normal(size=dim)
        z = clipped(z)
        
        f_z = func(z)
        
        if f_z < best_f:
            best_f = f_z
            best_x = z.copy()
            
    return best_x
