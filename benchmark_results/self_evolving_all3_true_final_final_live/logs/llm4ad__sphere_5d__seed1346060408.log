def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    def generate_candidate(mean, sigma):
        candidate = mean + sigma * np.random.randn(dim)
        return clip_candidate(candidate)

    def evaluate(candidate):
        return func(candidate)

    population_size = int(np.sqrt(budget))
    current_best = np.zeros(dim)
    best_fitness = float('inf')
    iteration = 0

    while True:
        # Sample initial population
        mean = rng.uniform(lb, ub, size=dim)
        candidates = [generate_candidate(mean, 1.0) for _ in range(population_size)]

        # Evolve the population using CMA-ES
        for _ in range(budget // population_size):
            iteration += 1

            # Evaluate and rank the population
            fitnesses = np.array([evaluate(candidate) for candidate in candidates])
            sorted_indices = np.argsort(fitnesses)

            mean = candidates[sorted_indices[-1]]
            best_fitness = fitnesses[-1]

            if best_fitness < 0.001:  # Early stopping criterion
                break

            # Adapt the step-size and covariance matrix
            sigma = max(1e-6, (np.mean(fitnesses) - best_fitness) ** 2)
            for i in range(population_size):
                candidate = candidates[sorted_indices[i]]
                if rng.uniform(0, 1) < 0.5:
                    candidates[i] = generate_candidate(mean, sigma * 2)
                else:
                    candidates[i] = candidate + sigma * np.random.randn(dim)

        # Perform a final restart
        mean = current_best
        sigma = 1.0

        # Generate new candidates using the adapted parameters
        for _ in range(population_size):
            candidate = generate_candidate(mean, sigma)
            fitness = evaluate(candidate)

            if fitness < best_fitness:
                current_best = candidate
                best_fitness = fitness

        # Check termination condition
        if iteration >= budget // population_size and best_fitness > 0.001:
            break

    return current_best
