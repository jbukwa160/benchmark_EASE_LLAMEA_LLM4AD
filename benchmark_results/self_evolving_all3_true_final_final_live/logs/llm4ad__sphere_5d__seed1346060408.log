def algorithm(func, dim, lb, ub, budget, rng):
    def gumbel(rng):
        return -np.log(-np.log(rng))

    class GaussianProcess:
        def __init__(self, X, Y):
            self.X = X
            self.Y = Y
            self.mean = np.zeros(dim)
            self.cov = 1

        def predict(self, x):
            cov = np.exp(-(x - self.X)**2 / (2 * self.cov**2))
            return self.mean + np.dot(cov.T, self.Y)

    X = np.zeros((budget, dim))
    Y = np.zeros(budget)
    gp = GaussianProcess(X[:1], Y[:1])

    for i in range(1, budget):
        x_new = gp.mean.copy()
        for j in range(dim):
            noise = gumbel(rng) * (ub[j] - lb[j]) + lb[j]
            x_new[j] += np.sqrt(np.exp(gp.cov)) * noise
            if not (lb <= x_new <= ub).all():
                x_new[j] = gp.mean[j]

        y_pred = func(x_new)
        X[i] = x_new
        Y[i] = y_pred

        gp.cov *= 0.5
        Y_pred = np.zeros(dim)
        for j in range(budget):
            cov = np.exp(-(x_new - X[j])**2 / (2 * gp.cov**2))
            Y_pred += cov * Y[j]
        gp.mean = x_new - np.sqrt(np.exp(gp.cov)) * Y_pred

    idx = np.argmin(Y)
    return X[idx]
