def algorithm(func, dim, lb, ub, budget, rng):
    best = np.zeros(dim)
    best_val = float('inf')
    
    for _ in range(budget):
        x = np.clip(rng.normal(size=dim, loc=0, scale=1) * (ub - lb) / 2 + (lb + ub) / 2, lb, ub)
        
        if func(x) < best_val:
            best_val = func(x)
            best = x.copy()
            
    return best
