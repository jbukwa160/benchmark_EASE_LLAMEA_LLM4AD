def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Apply local search with random restarts
        num_restarts = 0
        while True:
            try:
                niter = 100
                f_best = best_f
                for _ in range(niter):
                    x_try = x.copy()
                    ind = np.random.randint(dim)
                    x_try[ind] += rng.uniform(-1, 1) * (ub - lb)
                    x_try = clip(x_try, lb, ub)
                    if func(x_try) < best_f:
                        x = x_try
                        best_x = x_try
                        best_f = func(x_try)
                break
            except Exception as e:
                num_restarts += 1
                if num_restarts >= 10:
                    break

        # Randomly perturb the neighborhood
        ind = np.random.randint(dim, size=2)
        x[ind[0]] += rng.uniform(-1, 1) * (ub - lb)
        x[ind[1]] += rng.uniform(-1, 1) * (ub - lb)
        x = clip(x, lb, ub)

    return best_x
