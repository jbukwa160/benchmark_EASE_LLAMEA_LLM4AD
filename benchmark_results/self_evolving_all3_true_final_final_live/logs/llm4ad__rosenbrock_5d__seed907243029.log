def algorithm(func, dim, lb, ub, budget, rng):
    def sample(rng, lb, ub):
        return [rng.uniform(lb, ub) for _ in range(dim)]

    best_x = None
    best_fval = 1e20

    learning_rate = 0.01
    step_size = 0.001
    n_samples = 10

    for i in range(budget):
        x = sample(rng, lb, ub)
        fval = func(x)

        if fval < best_fval:
            best_x = np.array(x)
            best_fval = fval

        dir_ = [0.0] * dim
        for j in range(n_samples):
            v = sample(rng, -1, 1)
            dir_[j % dim] += v[j % dim]

        dir_ = [d / np.linalg.norm(dir_) if d != 0 else 1e-6 for d in dir_]
        step_size *= (i + 1) ** (-3/4)

        x = [(x[k] + learning_rate * dir_[k]) for k in range(dim)]
        x = [max(lb, min(ub, xi)) for xi in x]

        fval_new = func(x)
        if fval_new < best_fval:
            best_x = np.array(x)
            best_fval = fval_new

    return best_x
