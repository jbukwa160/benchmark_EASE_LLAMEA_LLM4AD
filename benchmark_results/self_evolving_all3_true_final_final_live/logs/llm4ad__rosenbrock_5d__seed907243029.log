def algorithm(func, dim, lb, ub, budget, rng):
    population_size = 50
    mutation_rate = 0.5
    
    current_best = np.random.uniform(lb, ub, size=(1, dim))
    
    for _ in range(budget):
        new_population = np.concatenate((current_best, 
                                         np.random.uniform(lb, ub, size=(population_size-1, dim))), axis=0)
        
        # Clip candidates to [lb, ub]
        new_population = np.clip(new_population, lb, ub)
        
        fitnesses = func(new_population)
        
        best_index = np.argmin(fitnesses)
        current_best = new_population[best_index]
        
    return current_best
