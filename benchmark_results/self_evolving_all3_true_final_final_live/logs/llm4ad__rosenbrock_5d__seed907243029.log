def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(2 * dim)
    n_iter = min(budget, dim * 10)
    x_best = rng.uniform(lb, ub, size=(pop_size, dim))
    f_best = float('inf')
    best_x = None

    for _ in range(n_iter):
        v_best = np.copy(x_best)

        for i in range(pop_size):
            idx1 = rng.randint(0, pop_size)
            idx2 = (idx1 - 1) % pop_size
            idx3 = (idx1 + 1) % pop_size

            mu = 0.5 * rng.uniform(-1, 1)

            v = x_best[idx1] + mu * (x_best[idx2] - x_best[idx3])

            for j in range(dim):
                v[j] = lb + (ub - lb) * v[j]
                if i == 0 or np.random.rand() < 0.5:
                    v[j] = rng.uniform(lb, ub)

            f_v = func(v)
            if f_v < f_best:
                f_best = f_v
                best_x = v

            x_best[i] = v

        for i in range(pop_size):
            u = np.copy(x_best[i])
            idx1 = rng.randint(0, pop_size)

            mu = 0.5 * rng.uniform(-1, 1)
            sigma = 0.2 + 0.8 / (1 + _ / (dim * 10))

            for j in range(dim):
                u[j] += sigma * (x_best[idx1][j] - x_best[i][j])

            for j in range(dim):
                u[j] = lb + (ub - lb) * u[j]
                if np.random.rand() < 0.5:
                    u[j] = rng.uniform(lb, ub)

            f_u = func(u)
            if f_u < f_best:
                f_best = f_u
                best_x = u

    return best_x
