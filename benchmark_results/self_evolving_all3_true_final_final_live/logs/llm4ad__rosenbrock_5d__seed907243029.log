def algorithm(func, dim, lb, ub, budget, rng):
    def Rosenbrock(x):
        return func(np.array([1, 2, 3, 4, 5])) if x is None else sum(100*(x[1:]-x[:-1]**2)**2 + (1-x[:-1])**2)

    pop_size = int(budget ** 0.5)
    n_gen = budget // pop_size
    sigma_init = 1.0
    sigma_decay = 0.9

    x_best = None
    f_best = np.inf
    gp = None

    for _ in range(n_gen):
        x = rng.uniform(lb, ub, (pop_size, dim))
        f = [Rosenbrock(x_i) for x_i in x]
        idx = np.argsort(f)[:int(pop_size * 0.2)]

        for i in range(len(idx)):
            x_cand = x[idx[i]] + rng.normal(0, sigma_init, size=(1, dim))
            f_cand = Rosenbrock(x_cand)
            if f_cand < f[idx[i]]:
                x[idx[i]] = x_cand
                f[idx[i]] = f_cand

        if gp is None:
            gp = {'x': x, 'f': f}
        else:
            gp['x'] = np.vstack((gp['x'], x))
            gp['f'] = np.hstack((gp['f'], f))

        if len(gp['x']) > 1:
            X = gp['x']
            Y = gp['f'].reshape(-1, 1)
            gp['model'] = {'kernel': 'rbf', 'alpha': np.zeros((X.shape[0],))}

        for _ in range(pop_size):
            if gp['model'] is not None:
                x_cand = gp['x'][rng.choice(X.shape[0], size=1, replace=False)] + rng.normal(0, sigma_init, size=(1, dim))
                f_cand = Rosenbrock(x_cand)

                # GP model prediction
                X_pred = np.array([x_cand])
                Y_pred = gp['model']['kernel'].predict(X_pred, gp['x'], y_train=gp['f'])
                if Y_pred < f_best:
                    x_best = x_cand
                    f_best = Y_pred

            # Random mutation
            x_mut = rng.uniform(lb, ub, size=(1, dim))
            f_mut = Rosenbrock(x_mut)
            if f_mut < f_best and (x_mut <= lb).any() or (x_mut >= ub).any():
                x_best = x_mut
                f_best = f_mut

        # Adaptive penalty for infeasible solutions
        idx = np.where((gp['x'] <= lb).any(axis=1) | ((gp['x'] >= ub).any(axis=1)))[0]
        if len(idx) > 0:
            gp['f'][idx] += 100 * (lb - ub)

    return x_best
