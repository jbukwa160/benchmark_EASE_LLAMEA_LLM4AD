def algorithm(func, dim, lb, ub, budget, rng):
    def sample_Gaussian(mean, cov, size=1):
        return mean + np.sqrt(cov) * rng.randn(size, dim)

    def log_likelihood(x, y):
        f = func(x)
        ll = -0.5 * np.log(2 * np.pi) - 0.5 * np.log(np.diag(y)) \
            - 0.5 * np.sum((np.log(y) + x**2)/y, axis=1)
        return np.mean(ll)

    def predict(mean, cov, x):
        return mean + np.dot(cov, x)

    x_best = ub + rng.uniform(-ub, 0, size=(dim,))
    y_best = func(x_best)

    for _ in range(budget):
        sample_x = sample_Gaussian(np.zeros(dim), np.ones(dim))
        clip_sample_x = np.clip(sample_x, lb, ub)
        sample_f = func(clip_sample_x)
        
        if sample_f < y_best:
            x_best = clip_sample_x
            y_best = sample_f

        mean = log_likelihood(x_best, y_best) * np.ones((dim,))
        cov = np.eye(dim) + 0.1 * np.ones((dim, dim))
        pred = predict(mean, cov, (clip_sample_x - x_best) / np.linalg.norm(clip_sample_x - x_best))

        if np.random.rand() < 0.1:
            sample_x = sample_Gaussian(np.zeros(dim), np.ones(dim))
            sample_f = func(sample_x)
            if sample_f < y_best:
                x_best = sample_x
                y_best = sample_f

    return x_best
