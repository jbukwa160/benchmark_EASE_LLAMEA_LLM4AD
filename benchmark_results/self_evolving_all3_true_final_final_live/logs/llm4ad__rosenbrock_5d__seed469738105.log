def algorithm(func, dim, lb, ub, budget, rng):
    n = int(np.ceil(np.sqrt(budget)))
    x_best = np.zeros(dim)
    y_best = 1e6
    for i in range(1, budget + 1):
        x = np.zeros((n, dim))
        y = np.zeros(n)
        for j in range(n):
            x[j] = rng.uniform(lb, ub, size=dim)
            y[j] = func(x[j])
        y_min = np.min(y)
        if y_best < y_min:
            continue
        x_mean, x_var = np.mean(x, axis=0), np.var(x, axis=0) + 1e-5
        gp = lambda x: -100 * (x[:, 1:] - x[:, :-1]**2)**2 - (x[:, :-1] - 1)**2 + y_min
        z = rng.uniform(0, 1)
        ei = np.zeros(n)
        for j in range(n):
            f_mean, f_var = gp(x[j]), gp(x[j])**2 * x_var[j]
            if z < (f_mean - y[j] + np.sqrt(f_var)):
                ei[j] = 1
        idx = np.argmax(ei)
        x_best[idx] = x[idx]
        y_best = y_min
    return x_best
