def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = dim
    mu = 1 / D * np.ones(D)
    sigma = 10.0 * np.sqrt(2 * np.log(D))
    popsize = 50
    lambda_ = int(popsize / 2)
    weights = np.array([1.0] * lambda_)
    weights[:lambda_] = rng.uniform(0, 1, size=lambda_) + 0.5
    weights /= sum(weights)

    def generate():
        return mu + sigma * (rng.randn(D) + np.eye(D))

    best = None

    for _ in range(budget):
        offspring = [clip(generate()) for _ in range(popsize)]
        if popsize == lambda_:
            fit, off_best = func(offspring), offspring[0]
        else:
            fit = np.array([func(o) for o in offspring])
            off_best = offspring[np.argmin(fit)]

        weights = 0.9 * weights + 0.1 / (1e-7 + fit)**2

        if popsize == lambda_:
            mu = weights[0] * off_best
        else:
            mu = np.sum(weights[:, None] * offspring, axis=0)

        sigma *= 1 - 0.05 / (1 + _**1.2)  # adaptive learning rate for sigma

        if best is None or fit < func(best):
            best = off_best

    return best
