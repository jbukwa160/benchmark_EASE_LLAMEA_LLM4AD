def algorithm(func, dim, lb, ub, budget, rng):
    def mutation(cmu, sigma, rands):
        noise = np.dot(np.sqrt(rands), cmu)
        return c + noise

    def selection(c, f_c, c_new, f_new):
        if f_new < f_c:
            return c_new
        else:
            return c

    dim = int(dim)
    budget = int(budget)

    x0 = (ub - lb) * rng.rand(dim) + lb
    cmu = x0.copy()
    sigma = 1.0
    popsize = 100
    lambda_ = popsize
    mu = int(lambda_/2)
    step_size = 0.5

    for i in range(budget):
        f_x = func(x0)

        # Selection
        children = np.zeros((lambda_, dim))
        for j in range(lambda_):
            rands = rng.randn(dim)
            c = mutation(cmu, sigma, rands)
            f_c = func(c)
            children[j] = selection(x0, f_x, c, f_c)

        # Update mean
        cmu = np.mean(children[:mu], axis=0)

        # Update step size
        sigma_new = (1 + 2 * rng.rand() - 1) * step_size
        if sigma_new > 0:
            sigma = sigma_new

        # Update population
        x0 = children[0]

    return x0.clip(lb, ub)
