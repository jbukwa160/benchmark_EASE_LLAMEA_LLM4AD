def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(mean, std, n):
        return mean + std * np.random.randn(n)

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = np.copy(x)
    best_f = func(x)

    cma_mean = np.mean(x, axis=0)
    cma_cov = np.cov(x.T, rowvar=False) + 1e-8 * np.eye(dim)
    cma_step_size = 0.01

    for _ in range(budget):
        new_x = mutate(cma_mean, np.sqrt(np.diag(cma_cov)), dim)
        new_x = clip(new_x, lb, ub)

        delta_f = func(new_x) - best_f
        if delta_f < 0:
            x = new_x
            cma_mean = (cma_mean * 0.9 + new_x * 0.1) / 0.9
            np.fill_diagonal(cma_cov, (1 - 0.9**2) * np.diag(cma_cov))
        else:
            u = rng.uniform(0, 1)
            p = np.exp(-delta_f / (cma_step_size * (func(new_x) - best_f)))
            if u < p:
                x = new_x
                cma_mean = (cma_mean * 0.9 + new_x * 0.1) / 0.9
                np.fill_diagonal(cma_cov, (1 - 0.9**2) * np.diag(cma_cov))

        best_f = min(best_f, func(x))
        if best_f < 1e-6:
            break

    return best_x
