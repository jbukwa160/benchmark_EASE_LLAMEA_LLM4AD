def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.sqrt(budget))
    x = rng.uniform(lb, ub, (pop_size, dim))
    best_x = x[np.argmin([func(x_) for x_ in x])]

    for _ in range(budget - pop_size):
        # Mutation
        v = np.zeros_like(x)
        for i in range(pop_size):
            idx1, idx2, idx3 = rng.choice(pop_size, 3, replace=False)
            if rng.rand() < 0.5:
                v[i] = x[idx1] + rng.uniform(-1, 1) * (x[idx1] - x[idx2])
            else:
                v[i] = x[idx2] + rng.uniform(-1, 1) * (x[idx3] - x[idx2])

        # Selection
        for i in range(pop_size):
            u = rng.rand()
            if u < 0.5 or func(v[i]) <= func(x[i]):
                x[i] = v[i]
            elif rng.rand() < 0.1:
                x[i] = np.clip(np.array(v[i]), lb, ub)

        # Update best_x
        new_best_idx = np.argmin([func(x_) for x_ in x])
        if func(x[new_best_idx]) < func(best_x):
            best_x = x[new_best_idx]

    return best_x
