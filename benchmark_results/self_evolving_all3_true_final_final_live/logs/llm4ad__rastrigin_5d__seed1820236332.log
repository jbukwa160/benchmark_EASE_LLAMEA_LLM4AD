def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    pop_size = 50
    particles = rng.uniform(lb, ub, (pop_size, dim))
    velocity = np.zeros((pop_size, dim))

    pbest = particles.copy()
    gbest = np.inf

    for i in range(budget):
        for j in range(pop_size):
            candidate = clip(particles[j] + velocity[j])
            fitness_candidate = func(candidate)
            if fitness_candidate < func(pbest[j]):
                pbest[j] = candidate
                if fitness_candidate < gbest:
                    gbest = fitness_candidate
                    gbest_particle = pbest[j]

        for j in range(pop_size):
            r1, r2, r3 = rng.uniform(0, 1), rng.uniform(0, 1), rng.uniform(0, 1)
            velocity[j] = (r1 * particles[j] + r2 * pbest[j] + r3 * gbest_particle) / pop_size

        particles += velocity
        for j in range(pop_size):
            particles[j] = clip(particles[j])

    return gbest_particle
