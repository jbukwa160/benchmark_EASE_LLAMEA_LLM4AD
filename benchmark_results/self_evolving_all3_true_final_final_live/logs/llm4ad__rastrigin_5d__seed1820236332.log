def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(candidates, x_best, alpha, F, sigma):
        return candidates + alpha * F * (x_best - candidates) + sigma * rng.normal(size=(dim,))

    def crossover(u, v, cr):
        u_v = np.zeros(dim)
        for i in range(dim):
            if rng.random() < cr:
                u_v[i] = u[i]
            else:
                u_v[i] = v[i]
        return u_v

    candidates = lb + (ub - lb) * rng.uniform(size=(budget, dim))
    population_diversity = 1
    best = np.inf

    for i in range(budget):
        scores = func(candidates)
        idx = np.argmin(scores)

        if scores[idx] < best:
            best = scores[idx]
            x_best = candidates[idx]

        alpha = (ub - lb) * rng.uniform(size=(budget,)) + 1
        F = (ub - lb) * rng.uniform(size=(budget,))
        sigma = (ub - lb) * rng.uniform(size=(budget,))

        population_diversity *= np.mean(np.abs(candidates - x_best))
        if population_diversity < 0.5:
            for j in range(budget):
                candidates[j] = mutate(candidates[j], x_best, alpha[j], F[j], sigma[j])

        new_candidates = np.copy(candidates)
        for j in range(budget):
            cr = rng.uniform()
            for k in range(dim):
                if rng.random() < 0.5:
                    u = crossover(new_candidates[k], candidates[j], cr)
                    v = crossover(new_candidates[k], x_best, cr)
                    new_candidates[k] = (u + v) / 2
        candidates = new_candidates

    return x_best
