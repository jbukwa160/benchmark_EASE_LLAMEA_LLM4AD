def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(-5, 5, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        mutant = np.zeros_like(x)
        for i in range(dim):
            r1, r2, r3 = rng.choice(range(dim), replace=False, size=3)
            if r1 == i:
                continue
            mutant[i] = x[r1] + 0.5 * (x[r2] - x[r3])
        
        trial = clip(mutant + 0.01 * rng.randn())
        
        f = func(trial)
        if f < best_f:
            best_x = trial.copy()
            best_f = f
    
    return best_x
