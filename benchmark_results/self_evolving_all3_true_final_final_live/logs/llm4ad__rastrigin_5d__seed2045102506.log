def algorithm(func, dim, lb, ub, budget, rng):
    best_candidate = np.array([lb + (ub - lb) * rng.rand(dim)])
    for _ in range(budget):
        candidate = best_candidate.copy()
        for i in range(dim):
            noise = 1e-3 * rng.randn()
            step_size = 0.01
            new_candidate_i = candidate[i] + step_size * noise
            clipped_candidate_i = np.clip(new_candidate_i, lb, ub)
            candidate[i] = clipped_candidate_i
        value = func(candidate)
        if value < func(best_candidate):
            best_candidate = candidate
    return best_candidate
