def algorithm(func, dim, lb, ub, budget, rng):
    def rastrigin(x):
        return func(x)

    x = np.random.uniform(lb, ub, size=dim)
    T = 1.0
    cooling_rate = 0.99
    learning_rate = 0.01
    best_x = x.copy()
    best_f = rastrigin(best_x)
    for i in range(budget):
        new_x = x + np.random.normal(size=dim) * learning_rate * T
        new_x = np.clip(new_x, lb, ub)
        new_f = rastrigin(new_x)
        
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f
        
        delta = new_f - best_f
        if delta < 0 or rng.rand() < np.exp(-delta / T):
            x = new_x.copy()
        
        T *= cooling_rate
    
    return best_x
