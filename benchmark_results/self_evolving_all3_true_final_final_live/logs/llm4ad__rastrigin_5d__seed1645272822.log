def algorithm(func, dim, lb, ub, budget, rng):
    def generate_individual():
        return rng.uniform(lb, ub, size=dim)

    def clip_candidate(candidate):
        clipped = np.clip(candidate, lb, ub)
        if not np.allclose(clipped, candidate):
            return clipped
        else:
            return candidate

    best_solution = generate_individual()
    best_fitness = func(best_solution)

    current_solution = best_solution.copy()

    for _ in range(budget):
        # Differential Evolution (DE) component
        mutated_solution = current_solution + rng.uniform(-1, 1, size=dim)
        mutated_solution = clip_candidate(mutated_solution)

        # Simulated Annealing (SA) component
        delta_fitness = func(mutated_solution) - best_fitness

        if delta_fitness < 0:
            current_solution = mutated_solution
            best_fitness = func(current_solution)
        else:
            probability = np.exp(-delta_fitness / rng.uniform(1e-3, 1))
            if rng.random() < probability:
                current_solution = mutated_solution

    return best_solution
