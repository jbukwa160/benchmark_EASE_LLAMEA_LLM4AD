def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(dim, lb, ub):
        return rng.uniform(lb, ub, size=(10, dim))

    def adaptive_control(sig, mean, std_dev):
        alpha = 0.1
        if sig < mean:
            return alpha * (sig - mean) + mean
        else:
            return alpha * (sig - mean) / std_dev + mean

    def iade(population, func, dim, lb, ub, budget):
        for _ in range(budget // 10):
            for i in range(10):
                mutation = rng.uniform(-1, 1, size=(dim))
                trial = population[i] + mutation
                trial = np.clip(trial, lb, ub)
                if func(trial) < func(population[i]):
                    population[i] = trial

        sigma = np.std([func(x) for x in population])
        mean_func = np.mean([func(x) for x in population])

        for i in range(10):
            mu = adaptive_control(func(population[i]), mean_func, sigma)
            mutation = rng.normal(mu, 0.1 * sigma, size=(dim))
            trial = population[i] + mutation
            trial = np.clip(trial, lb, ub)
            if func(trial) < func(population[i]):
                population[i] = trial

        return population

    population = generate_initial_population(dim, lb, ub)

    for _ in range(budget // 10):
        population = iade(population, func, dim, lb, ub, budget // 10)

    best_individual = np.argmin([func(x) for x in population])
    return population[best_individual]
