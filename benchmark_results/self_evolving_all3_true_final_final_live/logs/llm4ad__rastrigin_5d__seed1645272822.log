def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = 1.0 / (ub - lb) ** 2
    sigma = 0.5 * (ub - lb)
    n_parents = 10
    lambda_ = 20
    mu = int(lambda_ / 2)

    x_best = clip(rng.uniform(lb, ub, size=(dim,)))
    f_best = func(x_best)
    pop_size = lambda_

    for _ in range(budget):
        if rng.rand() < 0.1:
            sigma *= 0.9
        else:
            sigma *= 1.1

        x = clip(rng.normal(loc=x_best, scale=sigma, size=(pop_size, dim)))
        f = func(x)

        indices = np.argsort(f)[:mu]
        x_parents = x[indices]

        C = (x - x_parents[:, None]) / D
        H = np.eye(dim) + np.sum(C * C, axis=1, keepdims=True) / mu

        A = rng.normal(size=(dim,))
        B = np.linalg.solve(H, A)
        x_new = x_best + sigma * clip(B)

        f_new = func(x_new)
        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
