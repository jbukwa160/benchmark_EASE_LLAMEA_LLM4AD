def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(rng, dim, bounds):
        return rng.uniform(bounds[:, 0], bounds[:, 1], (100, dim))

    def gaussian_mutation(population, step_size=10.0):
        mutation = rng.normal(0, step_size / population.shape[0], size=(population.shape[0], dim))
        return population + mutation

    def differential_evolution(population, func, lb, ub, budget):
        for _ in range(budget):
            offspring = np.copy(population)
            for i in range(offspring.shape[0]):
                r1 = rng.randint(0, offspring.shape[0])
                r2 = (r1 + 1) % offspring.shape[0]
                offspring[i] = clip(
                    population[r1] + rng.uniform(-1, 1) * (population[r2] - population[r1]) +
                    rng.normal(0, step_size / population.shape[0], size=dim)
                )
            population = optimize.fmin(func, population, args=(lb, ub), x0=np.mean(offspring, axis=0))
        return population

    initial_population = generate_initial_population(rng, dim, [np.array([lb] * dim), np.array([ub] * dim)])
    best_candidate = differential_evolution(initial_population, func, lb, ub, budget)
    return clip(best_candidate)
