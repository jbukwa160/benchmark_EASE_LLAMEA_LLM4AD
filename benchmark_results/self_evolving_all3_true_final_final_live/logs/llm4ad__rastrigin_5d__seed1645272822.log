def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    N = 50  # population size
    F = 0.5  # scaling factor for mutation
    CR = 0.9  # crossover rate
    
    pop = rng.uniform(lb, ub, (N, D))
    
    best = np.inf
    best_sol = None
    
    for t in range(budget):
        for i in range(N):
            x_i = pop[i]
            
            u = rng.choice(range(N), size=D, replace=False)
            v = pop[u]
            
            z = x_i + F * (v - x_i)
            
            for j in range(D):
                if rng.random() < CR or z[j] == x_i[j]:
                    z[j] = np.round(z[j], 8)
                    
            f_z = func(z)
            
            if f_z < func(x_i):
                pop[i] = z
                
        best = np.inf
        for i in range(N):
            f_xi = func(pop[i])
            if f_xi < best:
                best = f_xi
                best_sol = pop[i]
                
    return best_sol
