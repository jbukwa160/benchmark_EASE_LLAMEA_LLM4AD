def algorithm(func, dim, lb, ub, budget, rng):
    assert len(lb) == len(ub) == dim, "Bounds must have the same length as dimension"
    
    # Initialize the best solution and its function value
    x_best = (lb + ub) / 2.0 * np.ones(dim)
    y_best = func(x_best)
    
    # Set initial hyperparameters for Gaussian Process model
    init_var = 1e-5
    lengthscale = 1e-3
    
    # Initialize the current iteration and the history of solutions
    iter_count = 0
    x_history = [x_best]
    y_history = [y_best]
    
    while iter_count < budget:
        # Sample a new candidate solution using a Gaussian Process model
        if len(x_history) == 1:
            sigma = init_var + lengthscale ** 2 * rng.random()
            x_new = np.array(rng.uniform(lb, ub, dim))
        else:
            mean, var = compute_gp_mean_var(x_history[-1], y_history[-1],
                                            [x - x_history[-1] for x in x_history[:-1]],
                                            [y - y_history[-1] for y in y_history[:-1]], init_var,
                                            lengthscale)
            
            # Sample a new candidate solution
            sigma = np.sqrt(var) * rng.random() + init_var
            
            if var == 0:
                x_new = x_best.copy()
            else:
                x_new = x_history[-1] + mean / var * (sigma - init_var)
        
        # Clip the new candidate to the bounds
        x_new = np.clip(x_new, lb, ub)
        
        # Evaluate the function at the new candidate solution
        y_new = func(x_new)
        
        # Update the history of solutions and their function values
        x_history.append(x_new)
        y_history.append(y_new)
        
        # Update the best solution found so far
        if y_new < y_best:
            y_best = y_new
            x_best = x_new
        
        iter_count += 1
    
    return x_best
