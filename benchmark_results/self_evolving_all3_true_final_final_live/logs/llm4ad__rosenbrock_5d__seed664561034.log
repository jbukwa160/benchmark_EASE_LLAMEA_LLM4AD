def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_dim = 10 * D
    X = rng.uniform(lb, ub, size=(n_dim + 1, D))
    Y = func(X)
    idx_sort = np.argsort(Y)

    for i in range(1, budget + 1):
        X_new = []
        Y_new = []

        for j in range(n_dim):
            x_old = X[idx_sort[j]]
            y_old = Y[idx_sort[j]]

            x_new = (ub - lb) * rng.rand(D) + lb
            y_new = func(x_new)

            if y_new < y_old:
                X_new.append(x_new)
                Y_new.append(y_new)
            else:
                X_new.append(x_old)
                Y_new.append(y_old)

        X = np.vstack((X, np.array(X_new)))
        Y = np.hstack((Y, np.array(Y_new)))

        idx_sort = np.argsort(Y[-n_dim:])

        best_idx = idx_sort[0]
        best_x = X[best_idx]

        if func(best_x) < func(X[idx_sort[0]]):
            X[idx_sort[0]] = best_x
            Y[idx_sort[0]] = func(best_x)

    return X[idx_sort[0]]
