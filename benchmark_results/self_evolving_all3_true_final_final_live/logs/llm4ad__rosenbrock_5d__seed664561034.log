def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    class Particle:
        def __init__(self, lb, ub):
            self.lb = lb
            self.ub = ub
            self.x = rng.uniform(lb, ub, dim)
            self.pbest_x = self.x.copy()
            self.fitness = func(self.x)

        def update_pbest(self, fitness, x):
            if fitness < self.fitness:
                self.fitness = fitness
                self.pbest_x = x

    class DE:
        def __init__(self, lb, ub, dim):
            self.lb = lb
            self.ub = ub
            self.dim = dim
            self.pop_size = 50
            self.c1 = 0.5
            self.c2 = 0.3
            self.mutation_strategy = 'rand/1/bin'
            self.x = rng.uniform(lb, ub, (self.pop_size, dim))
            self.fitness = func(self.x)

        def update_x(self):
            for i in range(self.pop_size):
                x_new = clip(np.zeros(dim) + self.x[i])
                if self.mutation_strategy == 'rand/1/bin':
                    r1, r2, r3 = rng.choice(range(self.pop_size), 3)
                    x_new[0] += self.c1 * (self.x[r1][0] - self.x[i][0]) + \
                                self.c2 * (self.x[r2][0] - self.x[r3][0])
                elif self.mutation_strategy == 'best/1/bin':
                    r1 = rng.choice(range(self.pop_size))
                    x_new[0] += self.c1 * (self.x[r1][0] - self.x[i][0]) + \
                                self.c2 * (self.x[rng.choice(range(self.pop_size))][0] - self.x[r3][0])
                self.x[i] = x_new
            self.fitness = func(self.x)

    def PSO_DE(budget, rng):
        population = [Particle(lb, ub) for _ in range(50)]
        de = DE(lb, ub, dim)
        for i in range(budget):
            if (i % 10 == 0 or i < 5) and budget - i > 20:
                de.update_x()
                best_de_idx = np.argmin(de.fitness)
                population[best_de_idx].update_pbest(de.fitness[best_de_idx], de.x[best_de_idx])
            else:
                for particle in population:
                    r1, r2 = rng.choice(range(50), 2)
                    x_new = clip(particle.x + rng.uniform(-5.0, 5.0, dim))
                    particle.update_pbest(func(x_new), x_new)
        best_particle_idx = np.argmin([particle.fitness for particle in population])
        return population[best_particle_idx].x

    return PSO_DE(budget, rng)
