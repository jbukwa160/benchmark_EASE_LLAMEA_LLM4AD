def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.sqrt(budget))
    x = np.random.uniform(lb, ub, size=(pop_size, dim))
    y = x.copy()

    for _ in range(budget - 1):
        F = 0.5
        CR = 0.9

        for i in range(pop_size):
            r1, r2, r3 = np.random.randint(0, pop_size, size=3)
            while r1 == i or r2 == i or r3 == i:
                r1, r2, r3 = np.random.randint(0, pop_size, size=3)

            x_new = x[i] + F * (x[r1] - 2*x[r2] + x[r3])

            for j in range(dim):
                u = rng.uniform(0, 1)
                if u < CR or j == np.random.randint(0, dim):
                    x_new[j] = min(max(x_new[j], lb), ub)

            fx_new = func(x_new)
            fx_i = func(x[i])

            if fx_new < fx_i:
                x[i] = x_new
                y[i] = x_new

        for i in range(pop_size):
            r1, r2, r3 = np.random.randint(0, pop_size, size=3)
            while r1 == i or r2 == i or r3 == i:
                r1, r2, r3 = np.random.randint(0, pop_size, size=3)

            x_new = y[i] + 0.1 * (x[r1] - 2*y[r2] + y[r3])

            for j in range(dim):
                u = rng.uniform(0, 1)
                if u < CR or j == np.random.randint(0, dim):
                    x_new[j] = min(max(x_new[j], lb), ub)

            fx_new = func(x_new)
            fx_i = func(y[i])

            if fx_new < fx_i:
                y[i] = x_new

    best_x = x[np.argmin([func(xi) for xi in x])]
    return best_x
