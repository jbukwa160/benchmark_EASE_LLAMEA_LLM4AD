def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    def evaluate(x):
        return func(x)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = evaluate(clip(x_best))

    T = 100.0
    alpha = 1e-2

    for _ in range(budget):
        n1, n2, n3 = rng.choice(dim, replace=False, size=3)

        x_diff = np.zeros(dim)
        x_diff[n1] = clip(x_best[n1] + rng.uniform(-alpha * T, alpha * T))
        x_diff[n2] = clip(x_best[n2] + rng.uniform(-alpha * T, alpha * T))
        x_diff[n3] = clip(x_best[n3] + rng.uniform(-alpha * T, alpha * T))

        f_diff = evaluate(clip(x_best + x_diff))
        if f_diff < f_best:
            x_best = clip(x_best + x_diff)
            f_best = f_diff

        T *= 0.99
        if T < 1e-3:
            break

    return clip(x_best)
