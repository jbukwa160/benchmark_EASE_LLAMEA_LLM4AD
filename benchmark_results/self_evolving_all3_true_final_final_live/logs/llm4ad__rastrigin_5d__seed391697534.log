def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 1000
    n_gen = 1000
    cr = 0.9
    f = 0.5
    
    pop = rng.uniform(lb, ub, (pop_size, dim))
    
    for _ in range(n_gen):
        offspring = np.copy(pop)
        
        for i in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size, size=3)
            
            while r1 == r2 or r1 == r3 or r2 == r3:
                r1, r2, r3 = rng.randint(0, pop_size, size=3)
                
            v = offspring[r1] + cr * (offspring[r2] - offspring[r3])
            
            u = np.zeros(dim)
            for j in range(dim):
                if rng.random() < f:
                    u[j] = np.random.uniform(lb, ub)
                else:
                    u[j] = v[j]
                    
            offspring[i] = u + 0.1 * rng.normal(size=dim)  # clip to [lb, ub]
            
        pop = np.clip(offspring, lb, ub)
        
    return np.argmin(np.array([func(x) for x in pop]), axis=0)
