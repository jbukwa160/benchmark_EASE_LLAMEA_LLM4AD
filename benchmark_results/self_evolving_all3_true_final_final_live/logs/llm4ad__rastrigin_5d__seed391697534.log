def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(mean, sigma):
        candidate = mean + sigma * rng.randn(dim)
        return np.clip(candidate, lb, ub)

    n = 4 * dim  # number of parents
    lambda_ = min(n, int(np.sqrt(budget)))
    mu = n // lambda_

    x_best = None
    f_best = float('inf')
    for i in range(lambda_):
        mean = np.zeros(dim)
        sigma = 1.0

        for _ in range(mu):
            candidate = get_candidate(mean, sigma)
            f_candidate = func(candidate)

            if f_candidate < f_best:
                x_best = candidate
                f_best = f_candidate

        sample_mean, covar = compute_cma_es_stats(x_best, mean, lambda_)
        mean = sample_mean
        covar = 0.1 * covar + 0.9 * np.eye(dim)
        sigma = np.sqrt(np.diag(covar))

    return x_best
