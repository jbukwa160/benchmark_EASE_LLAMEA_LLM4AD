def algorithm(func, dim, lb, ub, budget, rng):
    def mutation(x_best, x_curr, fbest, bounds):
        noise = 0.1 * rng.uniform(-1, 1, size=dim)
        return (bounds[1] - bounds[0]) * noise + x_curr

    def crossover(x1, x2, cr):
        if rng.random() < cr:
            idx = np.arange(dim) % 5
            return x1[idx] + cr * (x2[idx] - x1[idx])
        else:
            return x1

    n_pops = int(np.log(budget)) // 3 + 1
    pop_sizes = [10, 20, 50]
    crs = [0.7, 0.5, 0.9]

    best_x = np.random.uniform(lb, ub, size=dim)
    fbest = func(best_x)

    for _ in range(budget):
        for pop_size, cr in zip(pop_sizes, crs):
            pop = np.random.uniform(lb, ub, size=(pop_size, dim))
            for i in range(100):
                x_best = np.copy(pop[np.random.choice(pop_size)])
                fbest_pop = func(x_best)
                if fbest_pop < fbest:
                    fbest = fbest_pop
                    best_x = x_best

                for j in range(pop_size):
                    x_curr = pop[j]
                    x_mut = mutation(x_best, x_curr, fbest, (lb, ub))
                    x_cross = crossover(x_mut, x_curr, cr)
                    if func(x_cross) < fbest_pop:
                        fbest_pop = func(x_cross)
                        pop[j] = x_cross

            best_x = np.clip(best_x, lb, ub)

    return best_x
