def algorithm(func, dim, lb, ub, budget, rng):
    n = len(rng)
    best_x = rng.copy()
    best_f = func(best_x)

    for i in range(budget):
        x_new = rng.copy() + 0.1 * (ub - lb) * np.random.normal(size=dim)
        x_new = np.clip(x_new, lb, ub)

        # calculate the gradient
        grad = np.zeros(dim)
        h = 0.00001
        for j in range(dim):
            x_temp = x_new.copy()
            x_temp[j] += h
            temp_f = func(x_temp)
            grad[j] = (temp_f - best_f) / h

        # local gradient descent
        alpha = 1e-3 * np.exp(-i / budget)
        x_new -= alpha * grad

        # clip the new candidate to [lb, ub]
        x_new = np.clip(x_new, lb, ub)

        f = func(x_new)

        if f < best_f:
            best_x = x_new
            best_f = f

    return best_x
