def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(pop_size, dim):
        return rng.uniform(lb, ub, (pop_size, dim))

    def evaluate_population(population):
        return [func(individual) for individual in population]

    def selection(population, scores, pop_size):
        indices = np.argsort(scores)[:pop_size]
        return population[indices], scores[indices]

    def crossover(parent1, parent2, rng):
        child = parent1.copy()
        idx = rng.choice(dim)
        child[idx] = parent2[idx]
        return child

    def mutation(child, lb, ub, rng):
        for i in range(dim):
            if rng.random() < 0.5:
                child[i] += (ub - lb) * rng.uniform(-1, 1)
                child[i] = clip(child)
        return child

    population_size = int(budget ** 0.5)
    population = generate_initial_population(population_size, dim)

    scores = evaluate_population(population)
    best_individual = np.argmin(scores)
    best_score = scores[best_individual]

    for _ in range(int(budget / population_size)):
        offspring = []
        for i in range(population_size):
            parent1, parent2 = rng.choice(population_size, 2, replace=False), rng.choice(population_size, 2, replace=False)
            child = crossover(population[parent1], population[parent2], rng)
            child = mutation(child, lb, ub, rng)
            offspring.append(child)

        new_population = np.array(population + offspring)
        scores = evaluate_population(new_population)
        population, scores = selection(new_population, scores, population_size)

        best_individual = np.argmin(scores)
        best_score = min(best_score, scores[best_individual])

    return clip(population[best_individual])
