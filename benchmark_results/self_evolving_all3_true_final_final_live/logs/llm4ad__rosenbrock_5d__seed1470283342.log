def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for i in range(1, budget + 1):
        x_candidate = rng.normal(loc=x_best, scale=np.sqrt((ub - lb) / 2), size=dim)
        x_candidate = clip(x_candidate)

        f_candidate = func(x_candidate)

        alpha = 0.9
        T = 1000.0

        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate
        elif rng.uniform(0, 1) > np.exp((f_best - f_candidate) / (alpha * T)):
            x_best = x_candidate
            f_best = f_candidate

    return x_best
