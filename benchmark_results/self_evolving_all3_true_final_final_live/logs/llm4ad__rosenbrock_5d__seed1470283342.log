def algorithm(func, dim, lb, ub, budget, rng):
    def init_particles(budget):
        particles = rng.uniform(lb, ub, size=(budget, dim))
        velocities = rng.uniform(-1, 1, size=(budget, dim))
        return particles, velocities

    def pso(particles, velocities, best_particle, func, lb, ub, budget):
        for i in range(budget):
            r1, r2, r3 = rng.uniform(0, 1), rng.uniform(0, 1), rng.uniform(-4, 4)
            velocities[i] += r1 * (best_particle - particles[i]) + r2 * (particles[rng.randint(0, budget)] - particles[i]) + r3 * np.random.rand(dim)
            particles[i] += velocities[i]
            for j in range(dim):
                if particles[i, j] < lb:
                    particles[i, j] = lb
                elif particles[i, j] > ub:
                    particles[i, j] = ub
        return particles

    def nmss(particles, best_particle, func, lb, ub):
        simplex = np.column_stack((particles, [best_particle]))
        while True:
            sorted_simplex = np.argsort(func(np.take(simplex, range(dim+1), axis=0)), axis=0)
            if sorted_simplex[0] == 0:
                break
            x_new = (np.sum(simplex, axis=0) / (dim + 1)) - (2 * (func(np.take(simplex, [0], axis=0)) - func(np.take(simplex, [1], axis=0))) / ((simplex[1] - simplex[0])**2))
            for i in range(dim):
                if x_new[i] < lb:
                    x_new[i] = lb
                elif x_new[i] > ub:
                    x_new[i] = ub
            best_particle = np.take(simplex, [0], axis=0)
            simplex[1:] = simplex[:-1]
            simplex[0] = x_new
        return best_particle

    particles, velocities = init_particles(budget)
    for i in range(budget):
        particles = pso(particles, velocities, np.max(np.take(func(particles), range(dim+1)), axis=0), func, lb, ub, budget)
        best_particle = nmss(particles, np.max(np.take(func(particles), range(dim+1)), axis=0), func, lb, ub)
    return best_particle
