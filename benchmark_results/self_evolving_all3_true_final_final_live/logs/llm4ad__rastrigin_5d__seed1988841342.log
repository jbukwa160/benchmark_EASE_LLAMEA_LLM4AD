def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def func_eval(x):
        x = clip(x)
        return func(x)

    pop_size = 50
    x0 = np.random.uniform(lb, ub, (pop_size, dim))
    f_x0 = func_eval(x0)

    for _ in range(budget):
        # Differential Evolution step
        u1, u2, u3 = rng.choice(pop_size, size=3, replace=False)
        v = x0[u1] + 0.5 * (x0[u2] - x0[u3])
        f_v = func_eval(v)

        if f_v < np.min(f_x0):
            x0[u1] = v
            f_x0[np.argmin(f_x0)] = f_v

        # Local Search step using Random Search
        for i in range(pop_size):
            if rng.random() < 0.01:
                p = x0[i] + np.random.uniform(-ub, ub, dim)
                f_p = func_eval(p)

                if f_p < f_x0[np.argmin(f_x0)]:
                    x0[i] = p
                    f_x0[np.argmin(f_x0)] = f_p

    return x0[np.argmin(f_x0)]
