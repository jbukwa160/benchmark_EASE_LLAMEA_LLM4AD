        y = clip(y)
        f_y = func(y)
        alpha = np.exp(-temp / (i + 1))
        if f_y < func(x):
            temp *= 1 - 0.001
            x = y
        elif rng.rand() < np.exp((func(x) - f_y) / temp):
            temp *= 1 - 0.001
