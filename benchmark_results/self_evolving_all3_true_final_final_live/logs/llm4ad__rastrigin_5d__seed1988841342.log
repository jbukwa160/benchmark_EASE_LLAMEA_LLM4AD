def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    step_size = 0.1
    for _ in range(budget):
        x_new = x_best + rng.normal(size=dim) * step_size
        x_new = clip(x_new)

        if func(x_new) < f_best:
            x_best = x_new
            f_best = func(x_best)

        step_size *= 0.99  # reduce the step size over time

    return x_best
