def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = 5  # dimensionality of the problem
    N = int(np.sqrt(budget))  # population size (approximate)

    x = rng.uniform(lb, ub, size=(N, dim))
    y = func(x)
    y_best = y.copy()
    x_best = x.copy()

    for _ in range(N):
        r1, r2, r3 = np.random.choice(N, 3, replace=False)
        v = clip(x[r1] + rng.uniform(-0.5, 0.5, size=dim))
        if func(v) < y[r2]:
            x[r2], y[r2] = v, func(v)

    for _ in range(budget - N):
        r1, r3 = np.random.choice(N, 2, replace=False)
        f = rng.uniform(0.5, 1.0)
        c = rng.uniform(-1.0, 1.0)
        if rng.rand() < 0.5:
            v = clip(x[r1] + f * (x[r3] - x[r1]) + c * (x[r3] - 2*x[r1]))
        else:
            v = clip(clip(x[r1] + f * (x[r3] - x[r1]), lb, ub) +
                     c * rng.uniform(-np.sqrt(np.mean((x[r3] - x[r1])**2)), np.sqrt(np.mean((x[r3] - x[r1])**2))))
        if func(v) < y[r1]:
            x[r1], y[r1] = v, func(v)
            if func(v) < y_best:
                y_best = func(v)
                x_best = v.copy()

    return x_best
