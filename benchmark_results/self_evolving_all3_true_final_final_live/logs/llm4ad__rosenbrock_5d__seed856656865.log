def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best = np.array([lb + (ub - lb) * rng.uniform(0, 1) for _ in range(dim)])
    temperature = 1
    current_best = func(best)
    current_best_so_far = current_best

    for iteration in range(budget):
        candidate = clip(best + temperature * rng.normal(size=dim))
        new_cost = func(candidate)

        if new_cost < current_best:
            best = candidate
            current_best = new_cost

        if new_cost < current_best_so_far or np.random.rand() < np.exp((current_best - new_cost) / temperature):
            current_best_so_far = new_cost

        temperature *= 0.99

    return best
