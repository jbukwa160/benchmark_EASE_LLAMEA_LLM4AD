def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    for _ in range(budget):
        x_new = x_best + 0.1 * (ub - lb) * rng.randn(dim)
        x_new = np.clip(x_new, lb, ub)
        if func(x_new) < func(x_best):
            x_best = x_new
    return x_best
