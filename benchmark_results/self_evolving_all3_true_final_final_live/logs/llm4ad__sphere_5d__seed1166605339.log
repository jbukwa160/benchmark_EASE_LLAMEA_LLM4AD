def algorithm(func, dim, lb, ub, budget, rng):
    n = len(dim)
    x = np.array([rng.uniform(lb[i], ub[i]) for i in range(n)])
    T = 1000.0
    alpha = 0.99
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        f = func(x)
        delta = f - best_f

        if delta < 0:
            best_f = f
            best_x = x.copy()

        if np.random.rand() < np.exp(-delta / T):
            for i in range(n):
                x[i] = rng.uniform(lb[i], ub[i])

        T *= alpha

    return best_x
