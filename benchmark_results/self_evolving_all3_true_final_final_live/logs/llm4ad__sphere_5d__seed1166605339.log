def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    
    for _ in range(budget):
        grad_x = np.zeros(dim)
        
        for i in range(dim):
            x_i = np.copy(x)
            x_i[i] += 1e-8
            grad_x[i] = func(x_i) - func(np.copy(x))
            
            if rng.random() < 0.5:
                x_i[i] -= 2 * 1e-8
                grad_x[i] = -(func(x_i) - func(np.copy(x)))
                
            x[i] += np.sign(grad_x[i]) * min(abs(grad_x[i]), 1)
            
        for i in range(dim):
            if rng.random() < 0.5:
                x[i] = max(lb, min(ub, x[i]))
    
    return np.clip(x, lb, ub)
