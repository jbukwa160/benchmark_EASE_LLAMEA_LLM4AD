        # Sample a new point using the acquisition function
        x_new = sample_acquisition(X, func, gp_n_restarts, gp_n_iter, ei_n_samples, ei_epsilon)
        
        # Evaluate the objective function at the sampled point
        f_new = func(x_new)
        
        # Update the best solution and its fitness value if necessary
        if f_new < f_best:
            x_best = x_new.copy()
            f_best = f_new
        
        # Add the new point to the design space for future iterations
        X = np.vstack((X, x_new))
    
