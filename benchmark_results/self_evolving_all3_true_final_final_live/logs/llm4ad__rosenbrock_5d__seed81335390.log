def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    n_dim = len(x)
    x_best = np.zeros(n_dim)
    f_best = float('inf')
    temp = 1000.0
    step_size = 1e-3
    sigma = 0.2
    weights = np.ones(n_dim) / n_dim

    for i in range(budget):
        y = rng.normal(size=n_dim, loc=0, scale=sigma)
        x = x_best + (y * np.sqrt(weights))
        while True:
            for j in range(n_dim):
                x[j] = max(lb, min(ub, x[j]))
            f_x = objective(x)
            if f_x < f_best:
                x_best = x
                f_best = f_x
            p_accept = np.exp(-(f_x - f_best) / temp)
            u = rng.rand()
            if u < p_accept or i == 0:
                break
            else:
                y *= np.sqrt(-np.log(u))
        weights += (n_dim + 2) * y**2
        sigma *= np.exp(-temp)
        temp *= 0.99

    return x_best
