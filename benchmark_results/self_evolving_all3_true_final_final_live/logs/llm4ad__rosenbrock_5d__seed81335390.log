def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 10
    sigma = 1.0
    pc = 1.0
    x_best = -np.ones(dim)
    f_best = np.inf
    
    for i in range(budget):
        N = int(np.ceil(rng.uniform(5, 30)))
        
        while True:
            X = rng.normal(loc=x_best, scale=sigma, size=(N, dim))
            
            # Clip candidates to [lb, ub]
            X = np.clip(X, lb, ub)
            
            F = func(X)
            idx = np.argsort(F)[:int(N/2)]
            x_new = X[idx].mean(axis=0)
            
            if rng.uniform(0, 1) < pc:
                sigma *= (1 + rng.normal(loc=0, scale=0.05))
                
            if f_best > F.mean():
                f_best = F.mean()
                x_best = x_new
                pop_size = N
            
            if np.all(np.isclose(F, F[0])):
                break
        
        # Reduce population size to maintain budget
        pop_size = int(pop_size * 0.9)
        
    return x_best
