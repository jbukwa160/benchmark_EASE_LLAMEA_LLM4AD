def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    pop_size = 50
    x_min = np.array([lb] * dim)
    x_max = np.array([ub] * dim)
    p = np.random.uniform(lb, ub, (pop_size, dim))

    for i in range(budget):
        fit = np.zeros(pop_size)
        for j in range(pop_size):
            fit[j] = evaluate(p[j])

        fit_idx = np.argsort(fit)[:int(0.2 * pop_size)]

        p[fit_idx] = np.clip(p[fit_idx], lb, ub)

        diff = rng.uniform(-1, 1, (pop_size, dim))
        for j in range(pop_size):
            if j not in fit_idx:
                x_j = p[j] + diff[j]
                x_j = np.clip(x_j, lb, ub)
                fit[j] = evaluate(x_j)

        best_idx = np.argmin(fit)
        p[best_idx] = np.clip(p[best_idx], lb, ub)

    return np.clip(np.array([evaluate(rng.uniform(lb, ub, dim))]), lb, ub)
