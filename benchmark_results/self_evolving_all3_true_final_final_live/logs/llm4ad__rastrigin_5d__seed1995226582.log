def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x) + 1e10 * sum(np.abs(x - lb) < 1e-6)

    pop_size = int(budget ** (1 / 3))
    sigma = 0.5
    mu = np.zeros(dim)
    cov = np.eye(dim) * 1e8

    for i in range(pop_size):
        z = rng.normal(size=dim)
        x_new = mu + sigma * np.sqrt(cov).dot(z)
        x_new = np.clip(x_new, lb, ub)
        yield objective(x_new)

    best_x = None
    best_f = 1e10

    for _ in range(budget - pop_size):
        z = rng.normal(size=dim)
        x_new = mu + sigma * np.sqrt(cov).dot(z)
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        if f_new < best_f:
            best_f = f_new
            best_x = x_new

        cov += 1 / (2 * pop_size) * np.outer(z, z)
        sigma *= 0.5 + (3 * rng.uniform() ** 2 - 1.5)

    return best_x
