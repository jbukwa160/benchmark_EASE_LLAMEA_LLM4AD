def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    learning_rate = 0.01
    noise_stddev = 1e-2
    sigma = 10
    x_best = -np.inf
    
    for _ in range(budget):
        # Generate initial population
        pop = rng.uniform(lb, ub, (pop_size, dim))
        
        for i in range(pop_size):
            # Evaluate function at each point
            y_i = func(pop[i])
            
            if y_i < x_best:
                x_best = y_i
                best_point = pop[i]
                
            # Generate noisy points around the current point
            noise = rng.normal(0, sigma, (pop_size - 1, dim))
            new_pop = pop[i] + learning_rate * noise
            
            # Clip new population to bounds
            new_pop = np.clip(new_pop, lb, ub)
            
            # Evaluate function at each noisy point
            y_new = func(new_pop)
            
            for j in range(pop_size - 1):
                if y_new[j] < y_i:
                    pop[i] = new_pop[j]
                    y_i = y_new[j]
                    
    return best_point
