def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        return func(x)

    x = lb + (ub - lb) * rng.random((dim,))
    pop_size = 10
    sigma = 0.5
    C = np.eye(dim)
    mean = x
    for _ in range(budget):
        offspring = []
        for _ in range(pop_size):
            z = rng.randn(dim)
            v = np.dot(C, z) + mean
            candidate = clip(v)
            offspring.append((evaluate(candidate), candidate))
        offspring.sort(key=lambda x: x[0])
        if len(offspring) > 1:
            next_mean = np.array([x[1] for x in offspring[:int(pop_size/2)]]).mean(axis=0)
        else:
            next_mean = mean
        f_next_mean, _ = evaluate(next_mean)
        C *= (1 + rng.random((dim, dim)) / pop_size) ** 0.5
        C += (np.outer(next_mean - mean, next_mean - mean) / pop_size - C) * 0.01
        sigma *= np.exp(rng.normal(0, 1))
        mean = next_mean
    return mean
