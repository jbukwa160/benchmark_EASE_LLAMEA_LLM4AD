def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def sample(rng, best, std_dev):
        return best + std_dev * (rng.uniform(-1, 1, dim) - 0.5)

    def mutate(best, mut_rate):
        mutated = best.copy()
        for i in range(dim):
            if rng.rand() < mut_rate:
                mutated[i] += (rng.uniform(-1, 1) - 0.5)
        return mutated

    def crossover(parent1, parent2, cr):
        child = parent1.copy()
        for i in range(dim):
            if rng.rand() < cr:
                child[i] = parent2[i]
        return child

    best = np.zeros(dim)
    std_dev = 10.0
    mut_rate = 0.01
    cr = 0.5

    for _ in range(budget):
        candidate = sample(rng, best, std_dev)
        candidate = clip(candidate)
        score = func(candidate)

        if score < func(best):
            best = candidate

        mutated = mutate(best, mut_rate)
        mutated = clip(mutated)
        score_mut = func(mutated)

        if score_mut < score:
            best = mutated

        child1 = crossover(best, candidate, cr)
        child2 = crossover(candidate, best, cr)
        child1 = clip(child1)
        child2 = clip(child2)
        score_child1 = func(child1)
        score_child2 = func(child2)

        if score_child1 < score:
            best = child1
        elif score_child2 < score:
            best = child2

        std_dev *= 0.99  # decay the standard deviation over time

    return best
