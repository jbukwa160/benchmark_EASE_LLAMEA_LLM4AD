def algorithm(func, dim, lb, ub, budget, rng):
    def neg_func(x):
        return -func(x)

    def gp_model(X, Y, X_new):
        Sigma = np.exp(-np.sum((X[:, None] - X_new[None, :])**2, axis=2) / (2 * 1e-6))
        mu = np.dot(Sigma, Y)
        return mu

    def acquisition_function(x_best, x_gp, gp_mean, gp_var):
        std = np.sqrt(gp_var)
        z = (x_gp - x_best) / std
        return np.exp(-(np.sum(z**2) + 1)**(-5))

    X = rng.uniform(lb, ub, size=(budget, dim))
    Y = neg_func(X)

    for i in range(budget):
        gp_mean, gp_var = gp_model(X[:i+1], Y[:i+1], X[i])
        x_gp = np.argmax(acquisition_function(X[i], X[i], gp_mean, gp_var))
        if acquisition_function(X[i], X[x_gp], gp_mean, gp_var) > 0.05:
            X_new = rng.uniform(lb, ub, size=(dim,))
            Y_new = neg_func(np.array([X_new]))
            X = np.vstack((X[:i+1], X_new))
            Y = np.append(Y[:i+1], Y_new)
        x_best = X[np.argmin(Y)]
        if i % 100 == 0:
            print(f'Best function value after {i} iterations: {np.min(Y)}')
    return x_best
