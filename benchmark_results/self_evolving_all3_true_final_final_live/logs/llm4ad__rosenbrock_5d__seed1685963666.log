def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    sa_T = 1000.0
    cma_sigma = 10.0
    
    for i in range(budget):
        # Simulated Annealing
        x_new = x + rng.uniform(-sa_T, sa_T, size=(1, dim))
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        
        if f_new < best_f:
            best_f = f_new
            best_x = x_new.copy()
            
        # Covariance Matrix Adaptation Evolution Strategy (CMA-ES)
        cma_rho = 0.1
        
        delta = x_new - x
        delta = np.clip(delta, -cma_sigma, cma_sigma)
        
        delta_mean = np.mean(delta, axis=0)
        
        for j in range(dim):
            if rng.rand() < cma_rho:
                delta[j] += rng.randn()
                delta[j] = np.clip(delta[j], -cma_sigma, cma_sigma)
                
        x += delta / (1 + i ** (-0.5))
        x = np.clip(x, lb, ub)
        
    return best_x
