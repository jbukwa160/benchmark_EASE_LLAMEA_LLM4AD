def algorithm(func, dim, lb, ub, budget, rng):
    def gaussianMutation(x, mu, sigma):
        return x + sigma * (np.random.randn(dim) - mu)

    population = rng.uniform(lb, ub, size=(budget // 2, dim))
    for _ in range(budget):
        fitnesses = np.array([func(individual) for individual in population])
        indices = np.argsort(fitnesses)
        population = population[indices[:int(0.1 * len(population))]]
        population = np.vstack((population, gaussianMutation(np.mean(population, axis=0), 0, 0.5)))
        if len(population) > budget // 2:
            population = population[:budget // 2]
    fitnesses = np.array([func(individual) for individual in population])
    indices = np.argsort(fitnesses)
    return population[indices[0]]
