def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=(1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget - 1):
        y = x + rng.normal(size=(1, dim)) * 0.2
        y = clip(y)
        f = func(y)
        
        if f < best_f:
            best_x = y.copy()
            best_f = f
            
        x = (x * 0.9) + (best_x * 0.1) + rng.normal(size=(1, dim)) * 0.01
        x = clip(x)

    return best_x
