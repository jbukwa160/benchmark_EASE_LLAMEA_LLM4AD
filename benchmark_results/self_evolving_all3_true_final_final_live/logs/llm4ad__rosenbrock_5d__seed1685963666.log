def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = dim
    mu = np.zeros(D)
    sigma = 0.1
    lambda_ = 100
    N = 10
    iteration = 0

    while iteration < budget:
        iteration += 1
        x = clip(mu + rng.normal(size=(lambda_, D)) * sigma)

        y = func(x)
        if iteration % N == 0:
            if sigma > 1e-3: # avoid division by zero
                sigma *= np.exp(1 / (4.0 + iteration))
            else:
                break

    x_best = clip(mu - rng.normal(size=D) * sigma)

    return x_best
