    x = np.zeros(dim)
    cov = 1.0 * np.eye(dim)

    for _ in range(budget):
        if rng.rand() < 0.2:  # 20% chance to reset the search
            x = np.array([rng.uniform(lb, ub) for _ in range(dim)])

        else:
            n_stepsize = 1 / (np.sqrt(np.diag(cov)) + 1e-8)
            step_size = rng.normal(0, 1, size=dim) * n_stepsize
            x_try = x + np.dot(step_size, cov)

            # Clip to bounds
