def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_init(mu, sigma, dim):
        return mu + sigma * rng.randn(dim)

    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def evaluate(x, func, rng):
        return func(np.array([x]))

    mu = (lb + ub) / 2
    sigma = 0.5 * (ub - lb)
    n_evals = 0
    pop_size_max = dim * 30
    lambda_ = min(pop_size_max, int(budget / 10))
    while n_evals < budget:
        x_pop = gaussian_init(mu, sigma, lambda_)
        for i in range(lambda_):
            x_pop[i] = clip(x_pop[i], lb, ub)
        f_pop = evaluate(x_pop, func, rng)
        cov = np.eye(dim) * (ub - lb)**2 / 4
        mean = np.mean(x_pop, axis=0)
        for i in range(lambda_):
            delta = x_pop[i] - mean
            s = delta.reshape(-1, 1) @ delta
            cov += np.linalg.matrix_power(delta.reshape(1, -1), 2) / (lambda_ * (lambda_ - 1))
            cov -= np.linalg.matrix_power(cov @ delta.reshape(1, -1), 2) / lambda_
        n_evals += lambda_
        if n_evals >= budget:
            break
        mu_new = mean + cov @ rng.randn(dim)
        sigma_new = np.sqrt(np.diag(cov)) * 0.5
        mu = mu_new
        sigma = sigma_new
    x_best = clip(mu, lb, ub)
    return evaluate(x_best, func, rng)
