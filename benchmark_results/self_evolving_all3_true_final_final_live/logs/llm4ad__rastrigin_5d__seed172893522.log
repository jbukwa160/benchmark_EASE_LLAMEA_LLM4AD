def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(1, dim))
    best_x = x.copy()
    for _ in range(budget):
        noise = np.random.normal(size=(1, dim), loc=0, scale=rng)
        candidate = x + noise
        clipped_candidate = np.clip(candidate, lb, ub)
        fitness = func(clipped_candidate)
        if fitness < func(best_x):
            best_x = clipped_candidate.copy()
        for i in range(dim-1):
            sigma = rng * np.random.uniform(size=(1,))
            noise = np.random.normal(size=(1, dim), loc=0, scale=sigma)
            candidate = x + noise
            clipped_candidate = np.clip(candidate, lb, ub)
            fitness = func(clipped_candidate)
            if fitness < func(best_x):
                best_x = clipped_candidate.copy()
    return best_x
