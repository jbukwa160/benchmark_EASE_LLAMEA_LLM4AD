def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def sample(bounds, rng):
        return np.array([rng.uniform(a, b) for a, b in zip(bounds[0], bounds[1])])

    def evaluate(x, func, dim):
        return func(np.array([x] * dim))

    def sa_step(current, best, T, cooling_rate, step_size, func, dim):
        new = current + np.random.uniform(-step_size, step_size, dim)
        if evaluate(new, func, dim) < evaluate(best, func, dim):
            return new
        else:
            p = np.exp(-(evaluate(new, func, dim) - evaluate(current, func, dim)) / T)
            if rng.uniform(0, 1) < p:
                return new
            else:
                return current

    def de_step(parents, bounds, func, dim):
        offspring = [parents[0] + np.random.uniform(-1, 1, dim)]
        for i in range(1, len(parents)):
            x_i = parents[i]
            x_j = parents[np.random.choice(range(len(parents)), replace=False)]
            mutation = np.random.uniform(-1, 1, dim)
            offspring.append(x_i + mutation * (x_j - x_i))
        return clip(np.array(offspring), bounds[0], bounds[1])

    def sade_step(parents, bounds, func, dim):
        indices = np.argsort([evaluate(x, func, dim) for x in parents])[:3]
        best = [parents[i] for i in indices]
        new_parents = de_step(best, bounds, func, dim)
        return clip(new_parents[0], bounds[0], bounds[1])

    current_best = sample([(lb, ub)] * dim, rng)
    T = 100
    cooling_rate = 0.99

    for _ in range(budget):
        best_so_far = evaluate(current_best, func, dim)

        # Simulated Annealing phase
        while True:
            new = sa_step(current_best, current_best, T * (1 - cooling_rate) ** _, 0.01, 0.05, func, dim)
            if evaluate(new, func, dim) < best_so_far:
                current_best = new
                best_so_far = evaluate(new, func, dim)
                break
            else:
                p = np.exp(-(evaluate(new, func, dim) - best_so_far) / T * (1 - cooling_rate) ** _)
                if rng.uniform(0, 1) < p:
                    current_best = new
                    best_so_far = evaluate(new, func, dim)

        # Differential Evolution phase
        parents = [sade_step(current_best, [(lb, ub)] * dim, func, dim), sade_step(current_best, [(lb, ub)] * dim, func, dim)]
        while len(parents) < 10:
            parents.append(sade_step(parents[-1], [(lb, ub)] * dim, func, dim))

    return clip(current_best, lb, ub)
