def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    N = 50  # population size
    mu = 1.0 / (D + 2) * budget  # total budget for each strategy
    lambda_ = int(N / 4)
    sigma_max = 10.0
    c_c = 0.8
    c_m = 1.2
    beta = 0.7

    x_best = np.zeros(D)
    f_best = float('inf')

    for t in range(budget):
        x = rng.uniform(lb, ub, (N, D))
        z = rng.normal(0, sigma_max, (lambda_, D))

        # differential evolution
        y = x + z / N

        # covariance matrix adaptation
        C = np.eye(D)
        for i in range(lambda_):
            s = np.linalg.det(C) ** 0.5 * np.random.randn(D)
            y[i] += C @ s

        f = func(y)

        I_best = np.argmin(f)
        if f[I_best] < f_best:
            x_best = y[I_best]
            f_best = f[I_best]

        # update covariance matrix
        u = y - x_best
        for i in range(lambda_):
            v = u[i] / (1 + f[I_best] - f[i])
            s = np.linalg.det(C) ** 0.5 * np.random.randn(D)
            C += c_c * (v @ v.T - C) + c_m * (s @ s.T)

        # update strategy
        mu *= beta

    return x_best
