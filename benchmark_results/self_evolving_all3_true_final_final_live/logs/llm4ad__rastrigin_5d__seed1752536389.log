def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(size, rng):
        return rng.uniform(lb, ub, size=(size, dim))

    def objective(x, func):
        return func(x)

    population_size = 50
    temperature = 10.0

    initial_population = generate_initial_population(population_size, rng)
    best_solution = None

    for _ in range(budget):
        # Simulated Annealing (SA) phase
        new_temperature = max(temperature - 1e-6, temperature * np.exp(-_ / 10000))
        temperature = new_temperature

        for solution in initial_population:
            # Differential Evolution (DE) mutation and selection
            candidate = clip(solution + rng.uniform(-0.5, 0.5, size=dim))
            if objective(candidate, func) < objective(solution, func):
                solution[:] = candidate

        # Simulated Annealing (SA) acceptance
        for i in range(population_size):
            candidate = initial_population[i]
            if objective(candidate, func) < objective(initial_population[0], func):
                initial_population[i] = candidate

    best_solution = initial_population[np.argmin([objective(solution, func) for solution in initial_population])]
    return best_solution
