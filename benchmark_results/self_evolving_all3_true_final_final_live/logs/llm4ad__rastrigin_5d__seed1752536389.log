def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    x = 5 * (rng.rand(dim) - 0.5)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = clip(best_x + 0.1 * rng.randn(dim))
        f_y = func(y)
        if f_y < best_f:
            best_f, best_x = f_y, y

        alpha = np.exp(-_ / (2 * budget))
        s = clip(best_x + alpha * rng.randn(dim))
        fs = func(s)
        if fs < best_f:
            best_f, best_x = fs, s
        elif rng.rand() < 0.01 and _ > budget // 10:
            x = s.copy()

    return best_x
