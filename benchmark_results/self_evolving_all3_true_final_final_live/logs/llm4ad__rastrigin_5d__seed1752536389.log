def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.array([random.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        n1, n2, n3 = [clip(x + rng * (ub - lb)) for _ in range(3)]
        
        v1 = clip(best_x + 0.5*rng*(n1-best_x) + 0.5*rng*(n2-best_x))
        v2 = clip(n3 + 0.5*rng*(best_x-n3) + 0.5*rng*(n1-best_x))
        
        f1, f2 = func(v1), func(v2)
        
        if f1 < best_f:
            x = v1
            best_f = f1
            
        elif f2 < best_f:
            x = v2
            best_f = f2
            
    return x
