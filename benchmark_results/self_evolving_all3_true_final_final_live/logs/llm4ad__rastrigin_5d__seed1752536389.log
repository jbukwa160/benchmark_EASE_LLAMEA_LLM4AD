def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    n_pop = 100
    n_gen = budget // (dim * n_pop)
    pop_size = 50
    mutation_rate = 0.1
    crossover_rate = 0.5

    x_best = np.random.uniform(lb, ub, size=(pop_size, dim))
    f_best = func(x_best)

    for _ in range(n_gen):
        x_mut = np.copy(x_best)
        for i in range(pop_size):
            for j in range(dim):
                if rng.random() < mutation_rate:
                    x_mut[i, j] += rng.uniform(-1, 1) * (ub - lb)

        f_mut = func(clip(x_mut))
        idx = np.argsort(f_mut)[:pop_size]
        x_mut = x_mut[idx]

        x_cross = np.copy(x_best)
        for i in range(pop_size):
            if rng.random() < crossover_rate:
                j, k = rng.choice(pop_size, size=2, replace=False)
                x_cross[i] = (x_best[j] + x_mut[k]) / 2

        f_cross = func(clip(x_cross))
        idx = np.argsort(f_cross)[:pop_size]
        x_cross = x_cross[idx]

        f_best = min(f_best, min(f_mut[:pop_size], f_cross[:pop_size]))

    return clip(x_best[np.argmin(f_best)])
