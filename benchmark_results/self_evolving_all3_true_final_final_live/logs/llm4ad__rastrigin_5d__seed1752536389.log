def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    D = dim
    n_evals = 0
    x_mean = np.zeros(D)
    cov_mat = np.eye(D) * 1e-3

    for _ in range(budget):
        while True:
            z = rng.multivariate_normal(np.zeros(D), cov_mat)
            x = clip(x_mean + z)

            if n_evals < budget / 2 and func(x) < func(x_mean):
                x_mean = x
            elif n_evals >= budget / 2 or func(x) < func(x_mean):
                break

        n_evals += 1
        cov_mat = (D - 1) / D * cov_mat + np.outer(z, z)
    return x_mean
