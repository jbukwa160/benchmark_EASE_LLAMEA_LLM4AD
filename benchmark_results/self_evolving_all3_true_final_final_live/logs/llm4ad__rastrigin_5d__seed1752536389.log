def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        y = x + 0.1 * (ub - lb) * rng.normal(size=(dim,))
        y = clip(y)
        
        f_y = func(y)
        if f_y < best_f:
            best_x = y.copy()
            best_f = f_y
            
        for _ in range(dim):
            z = y + 0.1 * (ub - lb) * rng.normal(size=(dim,))
            z = clip(z)
            
            f_z = func(z)
            if f_z < best_f:
                x = z.copy()
                
    return best_x
