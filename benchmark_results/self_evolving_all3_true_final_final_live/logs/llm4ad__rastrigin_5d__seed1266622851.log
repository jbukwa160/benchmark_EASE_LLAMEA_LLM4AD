def algorithm(func, dim, lb, ub, budget, rng):
    def wrapped_func(x):
        return func(x) + 1e-9 * np.sum(np.abs(x))

    bounds = [(lb[i], ub[i]) for i in range(dim)]
    res = differential_evolution(wrapped_func, bounds, tol=0.01)
    x_best = res.x

    gp_model = None
    for _ in range(budget - 1):
        if rng.rand() < 0.5:
            # Gaussian process-based search
            mean, cov = gp(gp_model, x_best)
            std_devs = np.sqrt(np.diag(cov))
            perturbations = np.random.normal(0, std_devs, size=(dim,))
            new_x = x_best + perturbations
        else:
            # Gradient-based search
            grad = gradient(func, x_best)
            step_size = 1e-3 * rng.rand()
            new_x = x_best - step_size * grad

        new_x = clip(new_x, lb, ub)

        if func(new_x) < func(x_best):
            gp_model = None  # Reset GP model
            x_best = new_x

    return x_best
