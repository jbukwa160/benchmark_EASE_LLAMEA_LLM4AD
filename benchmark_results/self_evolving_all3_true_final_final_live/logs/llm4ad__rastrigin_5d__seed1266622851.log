def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    max_iter = int(budget / (dim * pop_size))
    mu = 0.5  # Initial mutation scale
    x_min = -3.0  # Lower bound for mutation scale
    x_max = 4.0  # Upper bound for mutation scale

    def ade_step(pop):
        z = np.zeros((pop_size, dim))
        v = np.zeros((pop_size, dim))

        for i in range(max_iter):
            for j in range(pop_size):
                r1 = rng.randint(0, pop_size)
                r2 = rng.randint(0, pop_size)

                if j != r1 and j != r2:
                    v[j] = pop[r1] + mu * (pop[r2] - pop[r1]) + \
                            np.dot(np.random.normal(size=dim), np.array([np.sin(2 * np.pi * pop[r2, 0]),
                                                                        np.cos(2 * np.pi * pop[r2, 1]),
                                                                        np.sin(2 * np.pi * pop[r2, 2]),
                                                                        np.cos(2 * np.pi * pop[r2, 3]),
                                                                        np.sin(2 * np.pi * pop[r2, 4])]))

                    z[j] = (pop[r1] + pop[r2]) / 2

        for i in range(pop_size):
            if rng.random() < 0.5:
                pop[i] = z[i]
            else:
                pop[i] = v[i]

        return np.clip(pop, lb, ub)

    pop = np.random.uniform(lb, ub, (pop_size, dim))

    for i in range(max_iter):
        pop = ade_step(pop)
        best_x = pop[np.argmin([func(x) for x in pop])]
        if func(best_x) == 0:
            return best_x

    # If the budget is exceeded and the function value is not 0
    return best_x
