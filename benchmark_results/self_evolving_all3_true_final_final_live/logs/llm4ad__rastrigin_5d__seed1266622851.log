def algorithm(func, dim, lb, ub, budget, rng):
    def clip(c):
        return np.clip(c, lb, ub)

    n = int(budget / (dim * 1e5))
    N = min(int(np.sqrt(dim)), budget)
    mu = 0.1
    cma_sigma0 = 0.1
    restart_counter = 0

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for i in range(n):
        sigma = max(cma_sigma0 * (1 - i / n), 1e-6)
        x = clip(rng.normal(x_best, sigma, size=(N, dim)))
        
        for _ in range(10):
            f_x = np.array([func(clip(xi)) for xi in x])
            
            idx_sorted = np.argsort(f_x)
            x[idx_sorted] = x[idx_sorted[::-1]]
            f_x = f_x[idx_sorted]
            
            if f_best > f_x[0]:
                restart_counter = 0
                x_best = clip(x[0, :])
                f_best = f_x[0]

        if f_best == 10 * dim:
            break

        if i % (n // 5) == 0 and f_best != 10 * dim:
            restart_counter += 1
            
            if restart_counter > 10:
                x_best = rng.uniform(lb, ub, size=dim)
                f_best = func(x_best)
                restart_counter = 0

    return x_best
