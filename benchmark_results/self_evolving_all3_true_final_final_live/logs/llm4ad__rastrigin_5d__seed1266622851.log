def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    D = 0.8
    F = 1.5
    N = int(budget / (dim * pop_size))

    def clip(x):
        return np.clip(x, lb, ub)

    best = None

    for _ in range(N):
        X = rng.uniform(lb, ub, size=(pop_size, dim))
        Y = X.copy()

        for i in range(pop_size):
            u = rng.choice(pop_size, size=3, replace=False)
            v = rng.rand(3) - 0.5
            p = clip(X[u] + D * (X[u] - X[i]) + F * v)

            if func(p) < func(Y[i]):
                Y[i] = p

        best_candidate = np.argmax(func(Y))
        best_candidate = clip(Y[best_candidate])

        if best is None or func(best_candidate) < func(best):
            best = best_candidate

    return best
