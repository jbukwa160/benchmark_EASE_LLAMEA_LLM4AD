def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    # Initialize population and temperature
    pop_size = int(1e3)
    population = rng.uniform(lb, ub, (pop_size, dim))
    temperature = 100.0

    for _ in range(budget):
        # Evaluate population fitness
        fitness = np.array([objective(x) for x in population])

        # Differential Evolution step
        candidates = []
        for i in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size, 3)
            while [r1, r2, r3] == [i]:
                r1, r2, r3 = rng.randint(0, pop_size, 3)

            candidate = population[r1] + 0.5 * (population[r2] - population[r3])
            candidates.append(candidate)

        # Simulated Annealing step
        for i in range(pop_size):
            if rng.rand() < np.exp(-fitness[i] / temperature):
                candidate = candidates[i]
                if objective(candidate) < fitness[i]:
                    population[i] = candidate
                    fitness[i] = objective(candidate)
                else:
                    u = rng.uniform(0, 1)
                    if u > np.exp(-(objective(candidate) - fitness[i]) / temperature):
                        population[i] = candidate
                        fitness[i] = objective(candidate)

        # Update temperature and clip candidates to [lb, ub]
        temperature *= 0.99
        population = np.clip(population, lb, ub)

    return population[np.argmin(fitness)]
