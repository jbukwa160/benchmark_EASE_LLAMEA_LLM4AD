def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    population_size = 50
    step_size = 0.5
    crossover_rate = 0.7
    population = np.random.uniform(lb, ub, (population_size, dim))

    for _ in range(budget):
        candidates = clip(population + rng.normal(0, step_size, (population_size, dim)), lb, ub)
        fitnesses = func(candidates)

        best_candidate = candidates[np.argmin(fitnesses)]
        worst_fitness = np.max(fitnesses)

        for i in range(population_size):
            mutation_index = rng.choice([j for j in range(population_size) if j != i])
            donor_candidate = clip(best_candidate + crossover_rate * (candidates[i] - candidates[mutation_index]), lb, ub)
            population[i] = donor_candidate

    return np.argmin(func(clip(population, lb, ub)))
