def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(mean, sigma, n):
        candidate = mean + sigma * (rng.randn(n) - 0.5)
        return clip(candidate)

    def evaluate(candidates):
        scores = []
        for candidate in candidates:
            score = func(candidate)
            scores.append(score)
        return np.array(scores)

    population_size = int(np.sqrt(budget))
    n_restart = int(population_size / 10)

    mean = (ub + lb) / 2 * np.ones(dim)
    sigma = (ub - lb) / 3

    for _ in range(n_restart):
        candidates = [generate_candidate(mean, sigma, dim) for _ in range(population_size)]
        scores = evaluate(candidates)
        best_idx = np.argmin(scores)
        mean += 0.1 * (candidates[best_idx] - mean)

        if np.any(np.isnan(scores)):
            break

    population_size *= 2
    candidates = [generate_candidate(mean, sigma, dim) for _ in range(population_size)]
    scores = evaluate(candidates)

    best_idx = np.argmin(scores)
    return candidates[best_idx]
