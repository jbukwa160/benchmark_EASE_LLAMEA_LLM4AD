def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidates, bounds):
        return np.clip(candidates, bounds[0], bounds[1])

    def objective(x):
        return func(np.array(x))

    def mutation(candidates, weights, strategy):
        if strategy == 'rand/1/bin':
            mutated = candidates + weights * (candidates[rng.integers(0, dim, size=dim)] - candidates)
        elif strategy == 'best/1/bin':
            best = np.min(candidates, axis=0)
            mutated = candidates + weights * (best - candidates)
        return clip(mutated, (lb, ub))

    def crossover(parents, children):
        if rng.random() < 0.5:
            return parents
        else:
            return np.where(rng.randint(2, size=(len(parents), dim)) == 1, children, parents)

    def selection(candidates, fitness):
        return candidates[np.argsort(fitness)]

    x = np.array([ub + (ub - lb) * rng.random(size=dim) for _ in range(budget)])

    for i in range(50): # number of iterations for DE
        y = mutation(x, 0.5, 'rand/1/bin')
        z = crossover(y, mutation(y, 0.5, 'best/1/bin'))
        x = selection(z, [objective(c) for c in z])

    return np.min(selection(x, [objective(c) for c in x]), axis=0)
