def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.minimum(np.maximum(x, lb), ub)

    D = dim
    pop_size = 50
    F = 0.5
    CR = 0.1
    Nelder_Mead_iter = 10

    x0 = rng.uniform(lb, ub, size=(pop_size, D))
    best_x = np.inf * rng.randn() - np.inf
    best_fx = float('inf')

    for _ in range(budget):
        for i in range(pop_size):
            idx1, idx2, idx3 = rng.choice(range(D), size=3, replace=False)
            trial_x = x0.copy()
            trial_x[i, idx1], trial_x[i, idx2], trial_x[i, idx3] = \
                trial_x[i, idx2] + F * (trial_x[i, idx3] - trial_x[i, idx2]), \
                trial_x[i, idx1], \
                trial_x[i, idx1] + F * (trial_x[i, idx2] - trial_x[i, idx1])

            noise = rng.normal(size=D)
            trial_fx = func(clip(trial_x + noise, lb, ub))

            u = rng.uniform(0, 1, size=D)
            for j in range(D):
                if u[j] < CR or j == idx1 or j == idx2 or j == idx3:
                    trial_x[i, j] = np.clip(trial_x[i, j] + rng.normal() * (trial_x[i, j] - x0[i, j]), lb, ub)

            trial_fx = func(clip(trial_x, lb, ub))
            if trial_fx < best_fx:
                best_fx = trial_fx
                best_x = trial_x

        for i in range(pop_size):
            for _ in range(Nelder_Mead_iter):
                new_x = Nelder_Mead(x0[i], func, lb, ub)
                if func(clip(new_x, lb, ub)) < func(clip(x0[i], lb, ub)):
                    x0[i] = clip(new_x, lb, ub)

    return best_x
