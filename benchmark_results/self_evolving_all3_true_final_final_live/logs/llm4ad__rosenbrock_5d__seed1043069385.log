def algorithm(func, dim, lb, ub, budget, rng):
    def generate_init_pop(n, dim, lb, ub):
        return lb + (ub - lb) * rng.random((n, dim))

    def crossover(x1, x2):
        y = x1.copy()
        idx = rng.choice(dim, size=dim, replace=False)
        y[idx] = x2[idx]
        return y

    def mutate(x, cr):
        return x + cr * (ub - lb) * rng.random((dim))

    def evaluate(x, func, dim):
        return func(x)

    n = 50
    pop_size = int(np.ceil(n / budget))
    init_pop = generate_init_pop(pop_size, dim, lb, ub)
    best_x = init_pop[np.argmin([evaluate(x, func, dim) for x in init_pop])]

    t_max = int(1e5)
    cr_best = 0.9
    t = 0
    while t < t_max and budget > 0:
        cr = cr_best * (t / t_max)**2
        pop_new = []
        for i in range(pop_size):
            x1, x2 = init_pop[i], best_x
            y = crossover(x1, x2)
            y_m = mutate(y, cr)
            y_m_clipped = np.clip(y_m, lb, ub)
            pop_new.append(y_m_clipped)
        budget -= 1

        for i in range(pop_size):
            if evaluate(pop_new[i], func, dim) < evaluate(init_pop[i], func, dim):
                init_pop[i] = pop_new[i]

        t += 1
        best_x = np.argmin([evaluate(x, func, dim) for x in init_pop])
    return init_pop[best_x]
