def algorithm(func, dim, lb, ub, budget, rng):
    def fitness(x):
        return func(x)

    D = dim - 1
    n = 10 * dim + 3
    mu = (ub - lb) / 2
    sigma_init = (ub - lb) / 4
    lambda_ = 20

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = fitness(x_best)

    for _ in range(budget):
        if rng.rand() < 0.1:
            x = np.clip(np.random.normal(loc=x_best, scale=sigma_init, size=dim), lb, ub)
        else:
            x = np.clip(x_best + np.random.normal(loc=0, scale=sigma_init * (mu / np.linalg.norm(x_best)**D), size=dim), lb, ub)

        f = fitness(x)
        if f < f_best:
            f_best = f
            x_best = x

    return x_best
