def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(budget, dim, rng):
        population = np.zeros((budget, dim))
        for i in range(budget):
            population[i] = lb + (ub - lb) * rng.rand(dim)
        return population

    population = generate_initial_population(budget, dim, rng)
    best_solution = clip(population[0])
    best_fitness = func(best_solution)

    for generation in range(1, budget + 1):
        # DE
        mutated_population = np.zeros((budget, dim))
        for i in range(budget):
            donor_index = (i + rng.randint(0, budget)) % budget
            donor_vector = clip(population[donor_index])
            mutation_factor = 0.5 * rng.randn(dim)
            mutated_population[i] = population[i] + mutation_factor * (donor_vector - population[i])

        # SA
        acceptance_probabilities = np.exp(-(func(mutated_population) - best_fitness) / generation)

        for i in range(budget):
            if rng.rand() < acceptance_probabilities[i]:
                population[i] = mutated_population[i]

        # Update best solution and fitness
        current_solution = clip(population[0])
        current_fitness = func(current_solution)
        if current_fitness < best_fitness:
            best_solution = current_solution
            best_fitness = current_fitness

    return best_solution
