def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    for _ in range(budget):
        x_rand = rng.uniform(lb, ub, size=(dim,))
        f_rand = func(x_rand)
        
        if f_rand < func(x_best):
            x_best = x_rand
            
        v = rng.uniform(lb, ub, size=(dim,))
        u = rng.uniform(0, 1, size=(dim,))
        
        for i in range(dim):
            si = lb + (ub - lb) * np.random.choice([-1, 1], p=[0.5, 0.5])
            v[i] += u[i] * (x_best[i] - x_rand[i]) + si * (f_rand - func(x_best))
        
        x_new = x_best + v
        f_new = func(np.clip(x_new, lb, ub))
        
        if f_new < func(x_best):
            x_best = x_new
            
    return np.clip(x_best, lb, ub)
