def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        sigma = 1.0 / (1 + (_ / budget) ** 2)
        epsilon = rng.normal(size=dim, loc=0, scale=sigma)

        new_x = x + epsilon
        new_x = np.clip(new_x, lb, ub)

        new_f = func(new_x)

        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f

        for i in range(dim):
            if rng.uniform(0, 1) < (np.exp(best_f - new_f) / (1 + np.exp(-5 * sigma))):
                x[i] = new_x[i]

    return best_x
