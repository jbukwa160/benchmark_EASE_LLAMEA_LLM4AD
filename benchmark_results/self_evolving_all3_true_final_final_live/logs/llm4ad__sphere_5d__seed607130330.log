def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(size):
        return np.random.normal(0, 1, (size, dim))

    def sample_gaussian(mean, cov):
        sigma = np.linalg.cholesky(cov)
        return mean + rng.normal(0, 1, size=(1, dim)).dot(sigma)

    def update_covariance(population):
        population_centered = population - population.mean(axis=0)[None, :]
        covariance = (population_centered.T).dot(population_centered) / len(population)
        return covariance

    def restart():
        nonlocal population
        population = generate_initial_population(size=budget)

    def run_cma_es():
        nonlocal population, mean, cov
        for _ in range(budget):
            y = func(clip(mean))
            population[:] = clip(sample_gaussian(mean, cov))
            for x in population:
                y_new = func(clip(x))
                if y_new < y:
                    y = y_new
                    mean = x
            cov = update_covariance(population)

    size = min(budget, 100)  # initial population size
    population = generate_initial_population(size)
    mean = np.zeros(dim)
    cov = np.eye(dim) * 1e-5

    run_cma_es()

    best_x = clip(mean)
    return best_x
