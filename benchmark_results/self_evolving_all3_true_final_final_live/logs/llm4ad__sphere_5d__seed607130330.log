def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.zeros(dim)
    x0 = x.copy()
    sigma = 1.0
    C = np.eye(dim) * sigma**2
    D = rng.uniform(-sigma, sigma, size=(dim,))
    D /= np.linalg.norm(D)
    mu = np.array([0.0] * dim)

    for i in range(budget):
        x += D
        x = clip(x)
        f_x = func(x)
        
        if i > 0 and f_x < func(x0):
            x0 = x.copy()
        
        C += (x - mu) @ (x - mu).T

        D = rng.multivariate_normal(mean=np.zeros(dim), cov=C, size=1)[0]
        D /= np.linalg.norm(D)

    return x0
