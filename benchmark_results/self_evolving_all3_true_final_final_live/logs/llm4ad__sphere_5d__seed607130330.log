def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    best_candidate = rng.uniform(size=(dim,))
    best_value = func(clip(best_candidate))

    for _ in range(budget):
        new_candidate = clip(rng.normal(loc=best_candidate, scale=0.1))
        value = func(new_candidate)
        
        if value < best_value:
            best_candidate = new_candidate
            best_value = value

    return best_candidate
