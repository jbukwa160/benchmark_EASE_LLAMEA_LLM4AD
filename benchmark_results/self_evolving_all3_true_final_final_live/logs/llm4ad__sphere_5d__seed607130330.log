def algorithm(func, dim, lb, ub, budget, rng):
    init = (ub - lb) * rng.rand(dim)
    step_size = 5.0
    best_sol = init.copy()
    best_val = func(init)

    for _ in range(budget):
        candidate = best_sol + step_size * rng.randn(dim)
        candidate = np.clip(candidate, lb, ub)
        
        if func(candidate) < best_val:
            best_sol = candidate
            best_val = func(best_sol)
            
        step_size *= 0.9

    return best_sol
