def algorithm(func, dim, lb, ub, budget, rng):
    pop = rng.uniform(lb, ub, size=(budget, dim))
    best = None

    for i in range(budget):
        for j in range(budget):
            if i == j:
                continue
            x1 = pop[j]
            x2 = pop[i]

            delta = 0.5 * rng.normal(size=dim)
            mutant = x1 + delta

            crossover_prob = 0.5
            if rng.random() < crossover_prob:
                trial = (1 - rng.uniform(0, 1)) * x2 + mutant
            else:
                trial = mutant

            trial = np.clip(trial, lb, ub)

            fitness = func(trial)
            if best is None or fitness < func(best):
                best = trial

        pop[i] = best.copy()

    return best
