def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    x = np.array([np.random.uniform(lb[i], ub[i]) for i in range(n)])
    temperature = 1.0
    step_size = 0.5 * (ub - lb) / 2.0
    cma_step_size = 0.01
    sigma = 0.5 * (ub - lb)
    mu = np.zeros(n)
    sigma_history = []
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        # Simulated Annealing
        new_x = x + np.random.uniform(-1, 1) * step_size
        new_x = np.clip(new_x, lb, ub)
        f_new = func(new_x)

        if f_new < best_f:
            x = new_x.copy()
            best_x = new_x.copy()
            best_f = f_new

        # CMA-ES update
        sigma_history.append(sigma)
        delta = new_x - x
        mu += cma_step_size * np.dot(delta, (delta / sigma**2))
        sigma = np.sqrt(np.mean((delta + mu)**2))

        # Acceptance criterion
        if f_new < best_f or np.random.uniform(0, 1) < np.exp(-1.0 * (f_new - best_f) / temperature):
            x = new_x.copy()
            best_x = new_x.copy()
            best_f = f_new

        temperature *= 0.999
        if temperature < 1e-6:
            break

    return best_x
