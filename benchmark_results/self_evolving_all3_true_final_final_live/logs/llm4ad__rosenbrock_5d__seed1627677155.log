def algorithm(func, dim, lb, ub, budget, rng):
    n = int(budget ** (1 / dim))
    gp = GaussianProcessRegression(dim)
    gp.set_bounds(lb, ub)
    x_best = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    f_best = float('inf')

    for i in range(n):
        mu, sigma = gp.predict(np.atleast_2d(x_best))
        f_new = func(x_best)

        if f_new < f_best:
            f_best = f_new
            x_best_gp = x_best

        x_new = gp.acquisition_function(x_best, mu, sigma)
        x_new = np.clip(x_new, lb, ub)

        _, sigma_new = gp.predict(np.atleast_2d(x_new))
        gp.update(x_new, func(x_new), np.atleast_2d(x_new))

        if func(x_new) < f_best:
            f_best = func(x_new)
            x_best_gp = x_new

    return x_best_gp
