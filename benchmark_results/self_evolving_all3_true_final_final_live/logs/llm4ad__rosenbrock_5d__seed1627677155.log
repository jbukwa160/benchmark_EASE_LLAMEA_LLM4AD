def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)

    N = 0
    while N < budget:
        gp = GaussianProcessRegressor(kernel=1.0 * RBF(length_scale_bounds=(1e-5, 1e5), len_constant=1e-5),
                                      alpha=np.finfo(float).eps)
        gp.fit(np.vstack([x[:N], best_x[:N]]).T, np.hstack([func(x[:N]), func(best_x[:N])]))

        mean, std = gp.predict(np.atleast_2d(x[N]))
        x_next = x[N] + 0.1 * rng.uniform(-1, 1, size=(1, dim))

        # clip to bounds
        for i in range(dim):
            if x_next[0, i] < lb:
                x_next[0, i] = lb
            elif x_next[0, i] > ub:
                x_next[0, i] = ub

        f_next = func(x_next)

        # gradient-based step
        grad_next = np.zeros((1, dim))
        for d in range(dim):
            eps = 1e-6 * rng.uniform(-1, 1)
            x_eps = x_next.copy()
            x_eps[0, d] += eps

            # clip to bounds
            if x_eps[0, d] < lb:
                x_eps[0, d] = lb
            elif x_eps[0, d] > ub:
                x_eps[0, d] = ub

            f_eps = func(x_eps)
            grad_next[0, d] = (f_eps - f_next) / eps

        # update best solution
        if f_next < best_f:
            best_x = x_next.copy()
            best_f = f_next

        # update Gaussian process
        gp.fit(np.vstack([x[:N], best_x[:N]]).T, np.hstack([func(x[:N]), func(best_x[:N])]))

        N += 1

    return best_x
