def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    t = 1.0
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        y = x + rng.uniform(-5.0, 5.0, size=dim)
        y = np.clip(y, lb, ub)  # clip to bounds

        delta_f = func(y) - best_f
        if delta_f < 0 or (rng.random() < np.exp(-delta_f / t)):
            x = y.copy()
            if func(x) < best_f:
                best_x = x.copy()
                best_f = func(x)

        # decrease temperature over time
        t *= 0.99

    return best_x
