def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = np.array([-5.0] * dim)
    best_eval = float('inf')
    
    for _ in range(budget):
        candidate = best_sol + (ub - lb) * (rng.random(size=dim) - 0.5)
        candidate = np.clip(candidate, lb, ub)
        
        eval = func(candidate)
        if eval < best_eval:
            best_sol = candidate
            best_eval = eval
    
    return best_sol
