def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (1, dim))
    sigma = 1.
    c = 0.5
    mu = np.zeros(dim)
    u = np.zeros((dim,))
    cmu = np.eye(dim)

    for _ in range(budget):
        f_x = func(x)
        
        if not np.isfinite(f_x):
            x = np.random.uniform(lb, ub, (1, dim))
            continue
        
        y = 2 * rng.rand() - 1
        z = x + sigma * np.sqrt(c) * y

        for i in range(dim):
            u[i] = (z[i] - x[i]) / sigma
            cmu[i, :] += c * (y[i]**2 - 1) * u[i]
        
        mu = cmu @ rng.randn(*mu.shape)
        z = x + sigma * np.sqrt(c) * mu
        
        for i in range(dim):
            z[i] = min(max(z[i], lb), ub)
        
        f_z = func(z)
        
        if not np.isfinite(f_z):
            continue
        
        if f_z < f_x:
            x = z
            sigma *= 1 + c / dim ** 0.5 * (f_z - f_x) ** 0.5
            
            for i in range(dim):
                cmu[i, :] = u[i] * u[i]
                
            mu = np.zeros(dim)
        
        else:
            sigma /= 1 + c / dim**0.5 * (f_x - f_z)**0.5
    
    return x
