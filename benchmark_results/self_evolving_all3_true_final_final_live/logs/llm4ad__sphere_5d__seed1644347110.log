def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_evals = 0
    x_best = lb + (ub - lb) * rng.rand(D)
    f_best = func(x_best)

    while n_evals < budget:
        c = 1.4 / np.sqrt(2 + D)
        mu = 1 / (D + 1.5)

        sigma = 0.1
        x_new = x_best + c * rng.randn(D) * sigma

        for i in range(D):
            if x_new[i] < lb:
                x_new[i] = lb
            elif x_new[i] > ub:
                x_new[i] = ub

        f_new = func(x_new)

        n_evals += 1
        if f_new < f_best:
            f_best = f_new
            x_best = x_new

    return x_best
