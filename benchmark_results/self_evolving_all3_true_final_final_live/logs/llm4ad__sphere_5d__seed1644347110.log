def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.ones(dim)
    f_best = float('inf')
    
    for _ in range(budget):
        x_candidate = x_best.copy()
        
        for i in range(dim):
            r1, r2, r3 = rng.uniform(0, 1), rng.uniform(0, 1), rng.uniform(0, 1)
            j = (i + np.floor(rng.uniform(0, dim))) % dim
            
            x_candidate[i] += r1 * (x_best[j] - x_candidate[i])
            x_candidate[j] -= r2 * (x_candidate[j] - x_best[i])
            
        f_candidate = func(x_candidate)
        
        if f_candidate < f_best:
            f_best = f_candidate
            x_best = x_candidate
            
        # Clip candidates to [lb, ub]
        for i in range(dim):
            x_best[i] = max(lb, min(ub, x_best[i]))
            
    return x_best
