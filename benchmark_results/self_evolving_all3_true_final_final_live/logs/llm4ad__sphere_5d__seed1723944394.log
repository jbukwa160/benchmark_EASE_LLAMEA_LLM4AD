def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_gen = int(np.sqrt(budget))
    x0 = (ub - lb) * rng.rand(D) + lb
    sigma = 5.0
    mu = 1 / D
    c_c = 1.0
    c_m = 2.0
    w_c = 0.8
    w_d = 0.6
    cmu = np.full((D,), 1)
    ccov = np.eye(D) * (ub - lb)**2

    for _ in range(n_gen):
        z = (ub - lb) * rng.randn(D) + lb
        x = x0 + sigma * np.cumsum(z)

        # clip to bounds
        x = np.clip(x, lb, ub)

        f_x = func(x)
        cov = ccov + mu * cmu @ ccov

        if f_x < func(x0):
            x0 = x
            sigma *= c_c
            cmu = w_c * cmu
            ccov = w_d * (cov - np.outer(cmu, cmu) / D)
        else:
            s = (x - x0) / sigma
            cov += mu * np.outer(s, s)

    return x0
