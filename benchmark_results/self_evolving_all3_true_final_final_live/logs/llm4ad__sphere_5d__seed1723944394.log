def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    max_iter = int(budget / pop_size)
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    for _ in range(max_iter):
        population = rng.uniform(lb, ub, size=(pop_size, dim))
        
        for i in range(pop_size):
            f_x = func(population[i])
            
            if f_x < f_best:
                x_best = population[i]
                f_best = f_x
        
        r_ga = 1.0
        r_lo = 5e-2
        r_hi = 1e3
        c1 = 10.0 ** rng.uniform(-2, -1)
        c2 = 10.0 ** rng.uniform(0, 2)
        
        for _ in range(pop_size):
            x_new = population[rng.randint(pop_size)]
            
            while True:
                r_lo_min = max(r_lo, r_ga / (r_hi + r_ga))
                r_lo_max = min(r_hi, r_ga * (1 - c2) + 1)
                r = rng.uniform(r_lo_min, r_lo_max)
                
                for j in range(dim):
                    delta_j = rng.normal(0, 1)
                    
                    if rng.random() < c1:
                        x_new[j] += r * delta_j
                    elif rng.random() < 0.5:
                        x_new[j] -= r * delta_j
                    
                f_x_new = func(np.clip(x_new, lb, ub))
                
                if f_x_new < f_best:
                    population[rng.randint(pop_size)] = x_new
                    break
                
                if rng.random() < 0.1:
                    break
            
            if rng.random() < 0.9:
                r_ga *= (1 + rng.uniform(-1, 1) * 0.5)
    
    return np.clip(x_best, lb, ub)
