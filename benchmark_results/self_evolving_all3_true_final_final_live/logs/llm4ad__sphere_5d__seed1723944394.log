def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([0] * dim)
    T = 10.0 / (1 + func(x))
    alpha = 0.99
    best_x = x.copy()
    best_f = func(best_x)

    for _ in range(budget):
        dx = rng.uniform(-5, 5, size=dim)
        x_new = np.clip(x + dx, lb, ub)
        
        f_new = func(x_new)

        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new
        elif rng.rand() < np.exp((best_f - f_new) / T):
            x = x_new.copy()

        T *= alpha

    return best_x
