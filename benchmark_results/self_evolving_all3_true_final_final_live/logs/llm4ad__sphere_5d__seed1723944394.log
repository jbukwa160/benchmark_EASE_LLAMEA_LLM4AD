def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.zeros(dim)
    T0 = 100.0
    alpha = 0.99
    t = 1
    step_size = 1.0
    best_x = x.copy()
    best_f = float('inf')
    best_g = 0

    while t <= budget:
        for i in range(dim):
            xi = clip(x[i] + rng.randn() * step_size)
            fj = func(xi)
            if fj < best_f:
                best_f = fj
                best_x = xi.copy()
                best_g = 1
            else:
                best_g += 0.01

        # adaptive cooling schedule
        T = T0 / (t ** alpha)

        # adaptive step size
        step_size *= np.exp(-best_g * rng.rand() + 0.5)

        t += 1

    return best_x
