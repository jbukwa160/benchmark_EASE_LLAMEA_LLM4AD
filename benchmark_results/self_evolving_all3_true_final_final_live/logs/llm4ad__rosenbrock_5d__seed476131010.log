def algorithm(func, dim, lb, ub, budget, rng):
    def wrapper(x):
        return func(x)

    bounds = [(lb, ub)] * dim
    result = differential_evolution(wrapper, bounds)
    best_x = result.x
    temp = 1.0
    while True:
        step_size = np.full(dim, rng.uniform(0.01, 0.1))
        new_x = best_x + step_size * (rng.choice([-1, 1], size=dim) - 0.5)
        new_x = np.clip(new_x, lb, ub)
        new_x = [min(max(x, lb), ub) for x in new_x]
        if wrapper(new_x) < wrapper(best_x):
            best_x = new_x
        temp *= 0.99
        budget -= 1
        if budget == 0 or temp < 1e-6:
            break
    return np.array(best_x)
