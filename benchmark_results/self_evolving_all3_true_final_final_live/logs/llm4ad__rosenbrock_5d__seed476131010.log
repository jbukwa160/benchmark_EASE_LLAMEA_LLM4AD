def algorithm(func, dim, lb, ub, budget, rng):
    def get_bounds(dim):
        bounds = [(lb, ub)] * dim
        return bounds

    def generate_individual(rng, bounds):
        individual = [np.random.uniform(bounds[i][0], bounds[i][1]) for i in range(len(bounds))]
        return np.array(individual)

    def evaluate(individual, func, rng=None):
        if rng is not None:
            np.random.seed(rng)
        return func(individual)

    best_individual = generate_individual(rng, get_bounds(dim))
    population_size = 50
    population = [generate_individual(rng, get_bounds(dim)) for _ in range(population_size)]
    weights = [(1.0 / dim) * i for i in range(1, dim + 1)]

    for _ in range(budget):
        for i in range(population_size):
            individual = np.array(population[i])
            candidate = best_individual.copy()
            F = 0.5
            CR = 0.9

            for j in range(dim):
                r1, r2 = np.random.choice(range(population_size), size=2, replace=False)
                while r1 == i or r2 == i:
                    r1, r2 = np.random.choice(range(population_size), size=2, replace=False)

                candidate[j] += F * (population[r1][j] - individual[j]) + CR * (population[r2][j] - individual[j])

            # Gaussian perturbation
            for j in range(dim):
                if np.random.rand() < 0.01:
                    candidate[j] += np.random.normal(0, 0.5)

            candidate = np.clip(candidate, lb, ub)
            fitness_candidate = evaluate(candidate)
            fitness_best_individual = evaluate(best_individual)

            if fitness_candidate < fitness_best_individual:
                best_individual = candidate.copy()

        # Update population
        for i in range(population_size):
            r1 = np.random.choice(range(population_size), replace=False)
            while r1 == i:
                r1 = np.random.choice(range(population_size), replace=False)

            v = 0.5 * (best_individual + population[r1])
            candidate = best_individual.copy()
            for j in range(dim):
                v[j] += weights[j] * (population[i][j] - individual[j])

            # Gaussian perturbation
            for j in range(dim):
                if np.random.rand() < 0.01:
                    v[j] += np.random.normal(0, 0.5)

            candidate = np.clip(v, lb, ub)
            fitness_candidate = evaluate(candidate)
            fitness_individual = evaluate(population[i])
            population[r1] = np.array(np.where(fitness_candidate < fitness_individual, candidate, population[r1]))

    return best_individual
