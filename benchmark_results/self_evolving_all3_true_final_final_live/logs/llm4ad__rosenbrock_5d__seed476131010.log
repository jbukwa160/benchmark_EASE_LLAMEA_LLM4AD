def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(size, dim):
        return (ub - lb) * rng.rand(size, dim) + lb
    
    def clip(x, lb, ub):
        return np.minimum(np.maximum(x, lb), ub)

    def objective(x):
        return func(x)

    initial_population = generate_initial_population(50, dim)
    
    for i in range(budget):
        # Differential evolution
        offspring = initial_population + 0.5 * (rng.rand(50, dim) - 0.5) * (initial_population[:, np.newaxis] - initial_population[np.newaxis, :])
        
        # Clip to bounds
        offspring = clip(offspring, lb, ub)
        
        # Select the best solution based on objective function value
        fitness = [objective(x) for x in offspring]
        idx = np.argmin(fitness)
        new_best_solution = offspring[idx]
        
        # Simulated annealing adaptation
        T = 0.1 / (i + 1)**(3/4)
        prob_acceptance = np.exp(-(objective(new_best_solution) - np.min(fitness)) / T)
        
        if rng.rand() < prob_acceptance:
            initial_population[idx] = new_best_solution
    
    # Return the best solution found
    fitness = [objective(x) for x in initial_population]
    idx = np.argmin(fitness)
    return clip(initial_population[idx], lb, ub)
