def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x0 = np.array([ub] * dim)
    best_x = x0.copy()
    current_x = x0.copy()

    T = 1.0
    alpha = 0.99

    for _ in range(budget):
        for i in range(dim - 1):
            new_x = clip(current_x + rng.uniform(-1, 1) * (ub - lb))
            new_x[i+1] += rng.uniform(-1, 1) * 10 * current_x[i]**2
            delta = func(new_x) - func(current_x)

            if delta < 0 or rng.rand() < np.exp(-delta / T):
                current_x = new_x

        if func(current_x) < func(best_x):
            best_x = current_x.copy()

        T *= alpha

    return best_x
