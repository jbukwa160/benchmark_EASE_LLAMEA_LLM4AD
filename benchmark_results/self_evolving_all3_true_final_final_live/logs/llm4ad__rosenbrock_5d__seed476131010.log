def algorithm(func, dim, lb, ub, budget, rng):
    candidates = rng.uniform(lb, ub, (budget, dim))
    temperature = 1.0
    T_min = 0.01

    for i in range(budget-1):
        new_candidate = candidates[i]
        delta = func(new_candidate) - func(candidates[np.random.choice(range(i+1))])

        if delta < 0 or (np.random.rand() < math.exp(-delta/temperature)):
            candidates[i+1] = new_candidate
            temperature *= 0.99

    best_candidate = candidates[np.argmin(func(candidates))]
    clipped_best_candidate = np.clip(best_candidate, lb, ub)

    return clipped_best_candidate
