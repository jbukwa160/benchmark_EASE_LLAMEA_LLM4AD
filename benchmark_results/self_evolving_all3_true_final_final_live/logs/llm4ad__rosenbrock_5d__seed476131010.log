def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def differential_evolution(population, lb, ub, func):
        population = clip(population, lb, ub)
        scores = [func(individual) for individual in population]
        n_best_idx = np.argsort(scores)[:int(len(population)/3)]
        return population[n_best_idx], scores[n_best_idx]

    def hybrid_selection(population, scores, best_individual, best_score):
        population = clip(population, lb, ub)
        new_scores = [func(individual) for individual in population]
        n_new_best_idx = np.argsort(new_scores)[:int(len(population)/3)]
        new_population = [population[i] if scores[i] <= new_scores[i] else population[n_new_best_idx[i-int(len(population)/3)]] 
                          for i in range(int(len(population)))]

        return new_population, new_scores

    def initialize_population(dim, lb, ub):
        return rng.uniform(lb, ub, (1, dim))

    population = initialize_population(dim, lb, ub)
    scores = [func(individual) for individual in population]
    
    best_individual = population[np.argmin(scores)]
    best_score = np.min(scores)

    t = 0
    while t < budget:
        t += 1
        population, scores = differential_evolution(population, lb, ub, func)
        
        if len(best_individual) == dim and len(np.shape(best_individual)) == 2:
            best_individual = best_individual[0]
            best_score = np.min(scores)

        new_population, new_scores = hybrid_selection(population, scores, best_individual, best_score)
        population, scores = differential_evolution(new_population, lb, ub, func)
        
        if len(best_individual) == dim and len(np.shape(best_individual)) == 2:
            best_individual = best_individual[0]
            best_score = np.min(scores)

    return clip(best_individual, lb, ub)
