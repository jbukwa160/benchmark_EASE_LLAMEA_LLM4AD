def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    for _ in range(budget):
        x_candidate = x_best + rng.normal(0, 1e-2, size=dim) * (ub - lb)
        candidate_x = np.clip(x_candidate, lb, ub)
        if func(candidate_x) < func(x_best):
            x_best = candidate_x
    return x_best
