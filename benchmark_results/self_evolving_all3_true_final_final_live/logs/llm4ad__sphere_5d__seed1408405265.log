def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    D = dim
    F = 0.5
    CR = 0.9
    pop = np.random.uniform(lb, ub, (pop_size, D))
    
    for _ in range(budget):
        dist = np.zeros((pop_size, D))
        
        for i in range(pop_size):
            for j in range(i+1, pop_size):
                temp = rng.uniform(0, 1) < CR
                if temp:
                    for k in range(D):
                        dist[i, k] += F * (pop[j, k] - pop[i, k])
        
        for i in range(pop_size):
            dist[i] /= np.linalg.norm(dist[i])
        
        best = np.argmin(func(pop))
        worst = np.argmax(func(pop))
        temp = rng.uniform(0, 1)
        
        if temp < 0.5:
            pop[worst] += np.random.uniform(-1, 1, D)
        else:
            for i in range(D):
                r1 = rng.randint(0, pop_size-1)
                while r1 == worst or r1 == best:
                    r1 = rng.randint(0, pop_size-1)
                pop[worst, i] += F * (pop[r1, i] - pop[worst, i])
        
        pop = np.clip(pop, lb, ub)
    
    return pop[best]
