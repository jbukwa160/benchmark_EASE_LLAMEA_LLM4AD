def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best = np.zeros(dim)
    best_cost = float('inf')

    for _ in range(budget):
        candidate = np.zeros(dim)
        for i in range(dim):
            if rng.random() < 0.5:
                candidate[i] = clip(rng.uniform(lb, ub))
            else:
                candidate[i] = best[i]
        
        cost = func(candidate)

        if cost < best_cost:
            best_cost = cost
            best = candidate

    return best
