def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def cauchy_distribution(mu, sigma, n):
        return mu + sigma * (np.random.standard_cauchy(n) * rng + 1 - 0.5)

    x_best = lb + (ub - lb) * rng
    f_best = func(x_best)
    population = [x_best]
    for _ in range(budget - 1):
        n = len(population)
        if n < 2:
            break
        mu, sigma = 0.5, 1.0
        x_new = []
        for i in range(n):
            r1, r2, r3 = np.random.choice(np.arange(n), replace=False, size=3)
            u1, u2, u3 = cauchy_distribution(0, 1, dim)
            x_new.append(clip(population[r1] + u1 * (population[r2] - population[r3]) +
                              mu * (population[r1] - x_best) / np.linalg.norm(population[r1] - x_best)))
        f_new = [func(x_i) for x_i in x_new]
        j_best = np.argmin(f_new)
        if f_new[j_best] < f_best:
            x_best, f_best = x_new[j_best], f_new[j_best]
        population.append(x_best)
    return x_best
