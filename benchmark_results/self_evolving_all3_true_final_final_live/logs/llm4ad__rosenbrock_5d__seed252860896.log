def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    current_best = func(bound(x))

    for _ in range(budget):
        new_x = x + 0.5 * (rng.normal(size=dim) - rng.normal(size=dim))
        new_x = bound(new_x)

        if func(new_x) < current_best:
            current_best = func(new_x)
            x = new_x

    return x
