def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def evaluate(solution):
        return func(solution)

    pop_size = 100
    bounds = [(lb, ub)] * dim
    x = rng.uniform(lb, ub, (pop_size, dim))
    y = evaluate(x)
    best_x = x[np.argmin(y)]
    best_y = np.min(y)

    for _ in range(budget):
        # Differential Evolution step
        candidates = []
        for i in range(pop_size):
            v = rng.uniform(lb, ub, dim)
            u = clip(v + 0.5 * (x[i] - x[rng.randint(0, pop_size), :]), lb, ub)
            candidates.append(u)

        # Evaluate new candidates
        y_new = evaluate(np.array(candidates))
        for i in range(pop_size):
            if y_new[i] < best_y:
                best_x = candidates[i]
                best_y = y_new[i]

        # Simulated Annealing step (local search)
        alpha = 0.9
        T = 100.0
        x_best = clip(best_x + rng.normal(0, 1, dim), lb, ub)
        for _ in range(10):
            u = x_best + rng.normal(0, 1, dim)
            if evaluate(u) < best_y:
                best_x = u
                best_y = evaluate(u)

            # Simulated Annealing cooling schedule
            T *= alpha

    return clip(best_x, lb, ub)
