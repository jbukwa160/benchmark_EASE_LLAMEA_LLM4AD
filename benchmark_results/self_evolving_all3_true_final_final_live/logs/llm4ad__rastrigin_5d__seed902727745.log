def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    init_x = rng.uniform(lb, ub, size=dim)
    init_sol = func(init_x)

    best_sol = init_sol
    best_x = init_x

    for _ in range(budget):
        x = clip(best_x + rng.normal(0, 1e-3, size=dim))
        sol = func(x)

        if sol < best_sol:
            best_sol = sol
            best_x = x

        # Simulated Annealing part
        if rng.random() < np.exp((best_sol - sol) / (budget * _)):
            best_sol = sol
            best_x = x

    return best_x
