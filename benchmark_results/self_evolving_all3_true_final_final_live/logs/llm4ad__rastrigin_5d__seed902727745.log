def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    sigma = 1.0
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        # Simulated Annealing (SA) phase
        sa_prob = np.exp(-i / budget)
        if rng.uniform(0, 1) < sa_prob:
            x_new = clip(x + sigma * rng.normal(size=dim))
            f_new = func(x_new)

            # CMA-ES phase
            if f_new < best_f or rng.uniform(0, 1) < np.exp((best_f - f_new) / (sigma ** 2)):
                x = x_new.copy()
                sigma *= 0.99

        # Update best_x and best_f
        if func(x) < best_f:
            best_x = x.copy()
            best_f = func(x)

    return best_x
