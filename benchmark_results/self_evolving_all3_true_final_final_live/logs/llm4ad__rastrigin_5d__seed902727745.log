def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def objective(x):
        x = clip(x)
        return func(x)

    def cma_es(budget, dim, rng):
        n_iter = 0
        x_mean = np.zeros(dim)
        sigma = 1.0
        lambda_ = int(4 + (dim / 2)**3) if dim < 30 else 200
        mu = rng.rand(lambda_)
        while n_iter < budget:
            f_x = [objective(x_mean + rng.randn(dim) * sigma)]
            for i in range(lambda_ - 1):
                f_x.append(objective(x_mean + (rng.randn(dim) * sigma + mu[i]).clip(lb, ub)))
            indices = np.argsort(f_x)
            mu[indices[:-lambda_]] = rng.randn(dim) * sigma
            x_mean = x_mean + (1 / lambda_) * np.sum(mu[:, np.newaxis] - x_mean, axis=0)
            sigma *= 0.5**((n_iter + 3) / (3 + n_iter))
            n_iter += 1
        return x_mean

    def nelder_mead(x0, budget):
        dim = len(x0)
        lb = np.full(dim, lb)
        ub = np.full(dim, ub)
        x_best = clip(x0)
        f_best = objective(x_best)
        while budget > 0:
            for i in range(budget * 10):
                x1 = x_best + rng.uniform(-1, 1) * (ub - lb)
                f_x1 = objective(clip(x1))
                if f_x1 < f_best:
                    x_best = x1
                    f_best = f_x1
            budget -= 1
        return x_best

    x0 = np.full(dim, rng.rand() * (ub - lb) + lb)
    x_cma_es = cma_es(budget // 2, dim, rng)
    if objective(x_cma_es) > objective(nelder_mead(x_cma_es, budget // 4)):
        return nelder_mead(x_cma_es, budget // 4)
    else:
        return x_cma_es
