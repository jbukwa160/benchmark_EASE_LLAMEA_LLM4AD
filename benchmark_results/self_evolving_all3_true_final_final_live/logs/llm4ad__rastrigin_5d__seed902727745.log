def algorithm(func, dim, lb, ub, budget, rng):
    def obj(x):
        return func(x)

    x0 = (ub - lb) * rng.rand(dim) + lb
    best_x = x0.copy()
    best_obj = float('inf')

    for _ in range(budget):
        # Differential Evolution step
        X1 = best_x + 0.5 * (ub - lb) * rng.randn(dim)
        X2 = best_x + 0.5 * (ub - lb) * rng.randn(dim)
        X3 = best_x + 0.5 * (ub - lb) * rng.randn(dim)
        offspring = 0.7 * X1 + 0.3 * X2 + 0.01 * X3

        # Clip candidate to bounds
        clipped_offspring = np.clip(offspring, lb, ub)

        # Simulated Annealing step
        if rng.rand() < 0.5:
            try:
                res = optimize.minimize(obj, clipped_offspring, method='SLSQP', bounds=[(lb, ub)] * dim)
                offspring = res.x
            except Exception as e:
                print(e)

        # Evaluate and update best solution
        obj_val = obj(offspring)
        if obj_val < best_obj:
            best_x = offspring.copy()
            best_obj = obj_val

    return best_x
