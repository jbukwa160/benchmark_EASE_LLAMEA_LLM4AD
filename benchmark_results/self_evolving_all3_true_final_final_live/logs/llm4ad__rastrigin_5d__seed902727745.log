def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def objective(x):
        x = clip(x)
        return func(x)

    def de(x0, bounds, f, budget):
        x = x0
        for _ in range(budget):
            y = x + 0.5 * rng.uniform(-1, 1) * (rng.uniform(size=dim) - 0.5)
            if objective(y) < objective(x):
                x = y
        return x

    def sa(x0, bounds, f, budget, T_init, alpha, rho):
        x = x0
        T = T_init
        for _ in range(budget):
            delta = rng.uniform(size=dim)
            y = x + delta
            if objective(y) < objective(x):
                x = y
            else:
                beta = np.exp((objective(x) - objective(y)) / (T * alpha))
                if beta > rng.uniform():
                    x = y
            T *= rho
        return x

    def hybrid_de_sa(bounds, f, budget, rng):
        x0 = lb + rng.uniform(size=dim) * (ub - lb)
        de_budget = int(budget * 2 / 3)
        sa_budget = budget - de_budget
        de_x = de(x0, bounds, objective, de_budget)
        T_init = 100.0
        alpha = 1e-6
        rho = 0.99
        sa_x = sa(de_x, bounds, objective, sa_budget, T_init, alpha, rho)
        return sa_x

    x_best = lb + rng.uniform(size=dim) * (ub - lb)
    for _ in range(budget):
        x = hybrid_de_sa((lb, ub), objective, budget // 5, rng)
        if objective(x) < objective(x_best):
            x_best = x
    return x_best
