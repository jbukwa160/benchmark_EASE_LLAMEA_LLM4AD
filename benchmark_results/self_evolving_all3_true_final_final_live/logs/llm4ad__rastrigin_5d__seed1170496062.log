def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    x_best = np.array([random.uniform(lb, ub) for _ in range(dim)])
    f_best = func(x_best)
    
    temperature = 1.0
    alpha = 0.98
    
    for _ in range(budget):
        x_new = clip(x_best + rng.normal(size=dim))
        
        f_new = func(x_new)
        
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
            
        delta = np.mean(np.abs(rng.uniform(size=(5, dim)) * x_best - x_new))
        
        if delta > 1e-3 and rng.random() < np.exp(-delta / temperature):
            x_best = x_new
        
        temperature *= alpha
    
    return clip(x_best)
