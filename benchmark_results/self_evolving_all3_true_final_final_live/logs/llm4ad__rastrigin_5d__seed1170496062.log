def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def candidate():
        x = lb + (ub - lb) * rng.rand(dim)
        while func(clip(x)) == 0:
            x = lb + (ub - lb) * rng.rand(dim)
        return x

    best_x = None
    budget_used = 0

    for _ in range(budget):
        x0 = candidate()
        res = minimize(func, x0, method="Nelder-Mead", options={"xatol": 1e-12})
        if budget_used < budget:
            best_x = res.x
            budget_used += 1

    return best_x
