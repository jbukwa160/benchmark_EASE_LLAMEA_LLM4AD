def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_candidate(rng, dim, lb, ub):
        return (ub - lb) * rng.rand(dim) + lb

    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    population_size = 10
    generation = 0
    best_candidate = generate_initial_candidate(rng, dim, lb, ub)
    best_fitness = func(best_candidate)

    while generation < budget:
        parent_pool = [generate_initial_candidate(rng, dim, lb, ub) for _ in range(population_size)]
        clipped_parent_pool = [clip(parent, lb, ub) for parent in parent_pool]
        
        children = []
        for _ in range(population_size):
            parents = np.array([clipped_parent_pool[(i-1)%population_size], clipped_parent_pool[i]]) if i > 0 else np.array([clipped_parent_pool[0]])
            child = (parents[0] + parents[1]) / 2
            children.append(clip(child, lb, ub))
        
        for child in children:
            fitness = func(child)
            if fitness < best_fitness:
                best_candidate = child
                best_fitness = fitness
        
        generation += 1

    return best_candidate
