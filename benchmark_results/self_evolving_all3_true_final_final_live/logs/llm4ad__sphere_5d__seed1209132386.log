def algorithm(func, dim, lb, ub, budget, rng):
    bounds = [(lb[i], ub[i]) for i in range(dim)]
    best_x = None
    best_y = float('inf')

    for _ in range(budget):
        mean, var = 0.0, 1e-3
        x = np.zeros((dim,))
        
        for d in range(dim):
            x[d] = np.random.normal(mean, np.sqrt(var), size=1)[0]
            x[d] = np.clip(x[d], bounds[d][0], bounds[d][1])
            
            if _ > 10:
                mean += (x[d] - mean) / (_ + 1)
                var *= 0.9
                
        y = func(x)

        if y < best_y:
            best_x = x
            best_y = y

    return np.array(best_x)
