def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for i in range(budget):
        num_samples = 10 if i < 100 else max(50, int(i ** 0.5))
        x_candidates = np.random.uniform(lb, ub, size=(num_samples, dim))

        gp = None
        y = [func(x) for x in x_candidates]
        X = np.column_stack((x_candidates, np.ones(num_samples)))

        if i > 50:
            if gp is not None:
                f_mean, _ = gp.predict(X[:, :-1], return_std=True)
            else:
                f_mean = y
            gp = None

        for j in range(10):
            X_propose = np.random.uniform(lb, ub, size=(num_samples, dim))
            if i > 50 and gp is not None:
                _, std = gp.predict(X_propose[:, :-1], return_std=True)
                f_mean = gp.predict(X_propose[:, :-1])
                X_propose_sorted = np.column_stack((X_propose, -f_mean - 3 * std))
            else:
                X_propose_sorted = np.column_stack((X_propose, y))

            idx_sorted = np.argsort(-X_propose_sorted[:, -1])

            for k in range(num_samples):
                x_new = X_propose[idx_sorted[k], :-1]
                f_new = func(x_new)

                if f_new < f_best:
                    f_best = f_new
                    x_best = x_new

        x_best = np.clip(x_best, lb, ub)
    return x_best
