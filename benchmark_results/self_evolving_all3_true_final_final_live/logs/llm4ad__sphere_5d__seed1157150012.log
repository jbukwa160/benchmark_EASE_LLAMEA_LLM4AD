def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    count = 0
    while True:
        if count >= budget:
            break
        step_size = rng.uniform(1e-6, 1.0)
        new_x = clip(best_x + rng.normal(size=dim) * step_size)
        new_f = func(new_x)
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f
        count += 1
    return best_x
