def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    current_solution = func(x)
    best_solution = current_solution

    sigma = 5.0
    T = 1000.0

    for i in range(1, budget):
        new_x = clip(x + rng.normal(size=dim) * sigma / np.sqrt(i + 1))
        new_solution = func(new_x)

        if new_solution < current_solution:
            x = new_x
            current_solution = new_solution
            if new_solution < best_solution:
                best_solution = new_solution

        elif rng.uniform(0, 1) < np.exp((current_solution - new_solution) / T):
            x = new_x
            current_solution = new_solution

        sigma *= 0.99
        T -= 10

    return clip(x)
