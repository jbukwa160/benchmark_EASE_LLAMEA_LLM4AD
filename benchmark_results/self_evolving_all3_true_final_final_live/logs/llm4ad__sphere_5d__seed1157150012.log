def algorithm(func, dim, lb, ub, budget, rng):
    def sample_gaussian(mean, cov, rng=rng):
        return mean + np.dot(rng.normal(size=(dim,)), np.linalg.cholesky(cov))

    best_x = None
    best_f = np.inf
    for _ in range(budget):
        x = sample_gaussian(np.zeros(dim), np.eye(dim))
        x = np.clip(x, lb, ub)
        fx = func(x)
        if fx < best_f:
            best_f = fx
            best_x = x

        sigma = 0.1 * (ub - lb) / (dim ** 0.5)
        mean = best_x + np.zeros(dim)
        cov = sigma ** 2 * np.eye(dim)

        new_mean, new_cov = sample_gaussian(mean, cov), cov
        new_x = np.clip(new_mean, lb, ub)
        new_fx = func(new_x)

        if new_fx < best_f:
            mean, cov = new_mean, new_cov
            x, fx = new_x, new_fx

    return best_x
