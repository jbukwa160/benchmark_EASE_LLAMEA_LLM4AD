def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = len(dim)
    temp = 1.0
    x = np.array([rng.uniform(lb, ub) for _ in range(D)])
    best_x = x.copy()
    best_f = func(best_x)

    for _ in range(budget):
        y = clip(x + rng.normal(size=D))
        f_y = func(y)
        
        if f_y < best_f:
            best_f = f_y
            best_x = y

        alpha = 0.5 * np.exp(-temp)
        delta = y - x
        
        if rng.random() < alpha or f_y <= best_f:
            x = y
        else:
            temp *= 0.95  # Decrease temperature over time
            
            for i in range(D):
                if rng.random() < 0.5:
                    x[i] += delta[i]
                else:
                    x[i] -= delta[i]

    return best_x
