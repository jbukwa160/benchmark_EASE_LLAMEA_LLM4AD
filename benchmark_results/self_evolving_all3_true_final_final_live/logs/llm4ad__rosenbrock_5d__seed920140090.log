def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        x_new = x + 0.1 * rng.normal(size=x.shape)
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)

        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new

        # Local optimization step
        grad = np.zeros_like(x)
        eps = 1e-8
        for i in range(dim):
            x_try = x.copy()
            x_try[i] += eps
            grad[i] = (func(x_try) - func(x_try - eps)) / (2 * eps)

        # Gradient descent step
        step_size = 0.01
        for _ in range(10):
            x_new = x - step_size * np.clip(grad, -1e6, 1e6)
            x_new = np.clip(x_new, lb, ub)
            f_new = func(x_new)

            if f_new < best_f:
                best_x = x_new.copy()
                best_f = f_new

            # Backtrack if necessary
            if (best_f - f_new) / best_f > 0.9:
                break

            step_size *= 0.5

        x = best_x.copy()

    return best_x
