def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    mutation_prob = 0.01
    
    def generate_individual():
        return np.clip(rng.uniform(lb, ub, size=dim), a_min=lb, a_max=ub)
    
    def mutate(individual):
        for i in range(dim):
            if rng.random() < mutation_prob:
                individual[i] += rng.normal(0, 0.1)
                individual[i] = np.clip(individual[i], lb, ub)
        return individual
    
    best_individual = generate_individual()
    
    for _ in range(budget):
        population = [mutate(generate_individual()) for _ in range(pop_size)]
        
        scores = [func(x) for x in population]
        min_idx = np.argmin(scores)
        
        if scores[min_idx] < func(best_individual):
            best_individual = population[min_idx]
    
    return best_individual
