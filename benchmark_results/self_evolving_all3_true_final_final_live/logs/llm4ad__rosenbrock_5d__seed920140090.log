def algorithm(func, dim, lb, ub, budget, rng):
    def fitness(x):
        return func(x)

    def sample(bounds):
        x = [rng.uniform(bounds[i][0], bounds[i][1]) for i in range(dim)]
        return np.array(x)

    best_x = sample([(lb, ub) for _ in range(dim)])
    best_f = fitness(best_x)
    budget_used = 1

    while budget_used < budget:
        tree = {}
        queue = [(best_x, best_f)]

        while len(queue) > 0 and budget_used < budget:
            x, f = queue.pop()
            for i in range(dim):
                if i not in tree.keys():
                    bounds = [(lb, ub)] * dim
                    bounds[i] = (min(bounds[i][0], x[i]), max(bounds[i][1], x[i]))
                    new_x = sample(bounds)
                    new_f = fitness(new_x)

                    if new_f < f:
                        queue.append((new_x, new_f))
                        tree[(tuple(x), i)] = (new_x, new_f)
                elif np.random.rand() < 0.5 and budget_used < budget:
                    new_i = rng.choice(list(tree.keys())[i])
                    new_x, new_f = tree[new_i]
                    queue.append((new_x, new_f))
                    tree[(tuple(x), i)] = (new_x, new_f)

            if np.random.rand() < 0.5 and budget_used < budget:
                x_idx = rng.choice(range(dim))
                bounds = [(lb, ub)] * dim
                bounds[x_idx] = (min(bounds[x_idx][0], x[x_idx]), max(bounds[x_idx][1], x[x_idx]))
                new_x = sample(bounds)
                new_f = fitness(new_x)

                if new_f < f:
                    queue.append((new_x, new_f))
