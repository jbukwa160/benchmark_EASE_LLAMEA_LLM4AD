def algorithm(func, dim, lb, ub, budget, rng):
    n = len(dim)
    T = 10 * max(ub - lb)
    alpha = 0.99
    x_best = np.array([lb] * n)
    f_best = float('inf')
    
    for _ in range(budget):
        x_candidate = x_best + rng.normal(size=n) * (ub - lb)
        for i in range(n):
            x_candidate[i] = max(lb, min(ub, x_candidate[i]))
        
        f_candidate = func(x_candidate)
        
        if f_candidate < f_best:
            f_best = f_candidate
            x_best = x_candidate
        
        if _ == budget - 1 or np.random.rand() < (T / (alpha ** (_ // 100))):
            T *= alpha
            
    return x_best
