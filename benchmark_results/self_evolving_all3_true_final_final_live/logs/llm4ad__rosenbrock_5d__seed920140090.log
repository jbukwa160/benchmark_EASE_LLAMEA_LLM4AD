def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x) + 1e10 * sum(max(0, x_i - ub) for x_i in x)

    def is_feasible(x):
        return all(lb <= x_i <= ub for x_i in x)

    T = 100
    T_min = 0.01
    cooling_rate = 0.999
    difficulty_level = np.inf

    best_x = rng.uniform(low=lb, high=ub, size=(dim,))
    best_f = evaluate(best_x)

    current_x = rng.uniform(low=lb, high=ub, size=(dim,))
    for _ in range(budget):
        current_f = evaluate(current_x)
        if current_f < best_f:
            best_f = current_f
            best_x = current_x

        # Update difficulty level based on number of iterations and acceptance ratio
        if _ > T:
            difficulty_level = (T - _) / (_ + 1) * np.exp((best_f - evaluate(current_x)) / (_ + 1))

        # Adaptively adjust temperature based on difficulty level
        if difficulty_level < T_min or (current_f - best_f) < difficulty_level:
            current_x = rng.uniform(low=lb, high=ub, size=(dim,))
        else:
            x_prime = current_x + rng.normal(size=(dim,))
            while not is_feasible(x_prime):
                x_prime = rng.uniform(low=lb, high=ub, size=(dim,))
            if evaluate(x_prime) < current_f or rng.random() < np.exp((current_f - evaluate(x_prime)) / T):
                current_x = x_prime

        # Cooling schedule
        T *= cooling_rate

    return best_x
