def algorithm(func, dim, lb, ub, budget, rng):
    def init_clusters(num_clusters, dim):
        cluster_centers = rng.rand(num_clusters, dim) * (ub - lb) + lb
        clusters = []
        for i in range(num_clusters):
            clusters.append(cluster_centers[i] + rng.normal(0, 1, size=dim))
        return np.array(clusters)

    def acceptance_probability(old_cost, new_cost, temperature):
        if new_cost < old_cost:
            return 1.0
        else:
            return np.exp((old_cost - new_cost) / temperature)

    num_clusters = int(np.sqrt(budget))
    clusters = init_clusters(num_clusters, dim)
    
    best_solution = None
    best_cost = float('inf')
    
    for i in range(budget):
        current_cluster = clusters[i % num_clusters]
        candidate = current_cluster + rng.normal(0, 1, size=dim)
        
        # Clip candidate to [lb, ub]
        candidate = np.clip(candidate, lb, ub)
        
        cost = func(candidate)
        
        if cost < best_cost:
            best_solution = candidate
            best_cost = cost
        
        alpha = 0.99 ** i  # adaptive temperature reduction
        temperature = 1 / (alpha * (i + 1))
        
        if rng.rand() < acceptance_probability(best_cost, cost, temperature):
            current_cluster = candidate
            
    return best_solution
