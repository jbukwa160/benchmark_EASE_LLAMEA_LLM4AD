        pop = np.array([bound(optimize.differential_evolution(fitness, bounds).x) for _ in range(dim)])

        if rng.rand() < 0.5:
            pop = optimize.differential_evolution(fitness, bounds).x
        else:
            new_pop = []
            for j in range(dim):
                new_x = best_x.copy()
                new_x[j] += rng.uniform(-1, 1)
                new_pop.append(bound(new_x))

            new_pop = np.array(new_pop)

            fit_new_pop = fitness(new_pop)
            fit_init_pop = fitness(pop)

            if np.mean(fit_new_pop) < np.mean(fit_init_pop):
                pop = new_pop

        best_x, best_fitness = optimize.differential_evolution(fitness, bounds).x, fitness(optimize.differential_evolution(fitness, bounds).x)

    return bound(best_x)
