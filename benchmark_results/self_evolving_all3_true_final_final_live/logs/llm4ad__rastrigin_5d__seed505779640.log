def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = clip(rng.uniform(size=dim))
    best_x = x.copy()
    best_y = func(x)
    
    radius = 1.0
    for _ in range(budget - 1):
        candidate_count = 0
        while candidate_count < dim:
            dx = rng.uniform(-radius, radius, size=dim)
            new_x = clip(best_x + dx)
            
            if not np.all(np.isclose(new_x, best_x)):
                y = func(new_x)
                if y < best_y:
                    best_x = new_x
                    best_y = y
                candidate_count += 1
                
        radius *= 0.9
    
    return best_x
