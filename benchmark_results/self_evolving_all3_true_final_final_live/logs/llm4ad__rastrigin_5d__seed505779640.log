def algorithm(func, dim, lb, ub, budget, rng):
    n = len(rng)
    D = 1e-8 * np.eye(dim) + np.eye(dim)
    x_best = np.zeros((dim))
    f_best = float('inf')
    
    for _ in range(budget):
        sigma = 0.5
        while True:
            z = rng.randn(n, dim)
            x = x_best + sigma * np.dot(np.linalg.cholesky(D), z.T).T
            
            # clip candidates to [lb, ub]
            x = np.clip(x, lb, ub)
            
            f = func(x)
            if f < f_best:
                f_best = f
                x_best = x
                
            D = (1 - 2/D.shape[0]) * D + sigma**2 * z @ z.T
            
            # stop if the step size is too small or we reached a limit
            if np.linalg.det(D) < 1e-10:
                break
            elif len(x_best[x != x_best].flatten()) == dim:
                break
            
            sigma *= 0.7
    
    return x_best
