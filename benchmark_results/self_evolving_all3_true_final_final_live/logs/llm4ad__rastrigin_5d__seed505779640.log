def algorithm(func, dim, lb, ub, budget, rng):
    def grad(x):
        eps = 1e-8
        return np.array([(
            (func(x + np.eye(dim)[i]) - func(x)) / eps if i == j else
            (func(x + np.eye(dim)[j]) - func(x)) / eps
        ) for i, j in enumerate(range(dim))])

    def de(x0, y0, f0, y1):
        x1 = y1 + rng.uniform(-1, 1) * 0.01 * (x0 - y0)
        while True:
            x2 = y1 + rng.uniform(-1, 1) * 0.1 * (y0 - y1)
            f2 = func(x2)
            g2 = grad(x2)
            if f2 < f0 and np.linalg.norm(g2) < 1e-6:
                return x2
            elif np.linalg.norm(g2) > 10 or f2 < f0:
                return x1

    lb, ub = float(lb), float(ub)

    pop_size = int(budget ** (1 / dim))
    population = rng.uniform(lb, ub, size=(pop_size, dim))

    for _ in range(int(budget)):
        for i in range(pop_size):
            y0, f0 = population[i], func(population[i])
            j = np.random.choice(pop_size, replace=False)
            y1 = population[j]
            x1 = de(population[j], y0, f0, y1)
            if func(x1) < f0:
                population[i] = x1
        best_x = population[np.argmin([func(x) for x in population])]
        if budget - _ <= 10:
            break

    return best_x
