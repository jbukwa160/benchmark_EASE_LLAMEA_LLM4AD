def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(1, dim))
    T = 10 * (ub - lb) ** 2
    t = 0
    best_x = x.copy()
    while t < budget:
        new_x = x + rng.normal(size=(1, dim)) * (ub - lb) / 3
        new_x = np.clip(new_x, lb, ub)
        delta = func(new_x) - func(best_x)
        if delta <= 0 or np.random.rand() < np.exp(-delta / T):
            x = new_x.copy()
            best_x = new_x.copy()
        T *= 1 - (t + 1) / budget
        t += 1
    return best_x[0]
