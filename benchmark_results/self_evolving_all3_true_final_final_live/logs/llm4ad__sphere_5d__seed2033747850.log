def algorithm(func, dim, lb, ub, budget, rng):
    niter = int(budget)
    x0 = (lb + 1) * rng.rand(dim)
    gp_params = {'lengthscale': 1.0, 'noise': 1e-3}
    for i in range(niter):
        # Sample candidate
        x = minimize(lambda x: -func(x), x0, method='SLSQP', bounds=[(lb, ub)]*dim).x
        
        # Evaluate function and update GP model
        y = func(x)
        
        # Predict probability of improvement
        gp_mean, gp_var = predict_gp(gp_params, x)
        prob_improve = 1 - norm.cdf(y + 1e-3, loc=gp_mean, scale=np.sqrt(gp_var))
        
        # Update GP parameters if necessary
        if i > niter // 10:
            gp_params['lengthscale'] *= np.exp(-0.1)
            gp_params['noise'] *= np.exp(-0.01)
        
        # Update x0 for next iteration
        x0 = x
        
    return x
