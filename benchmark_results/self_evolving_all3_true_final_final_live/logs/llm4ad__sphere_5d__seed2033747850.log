def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = lb + (ub - lb) * rng.rand(dim)
        
        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x
        
        sigma = 0.1 * (ub - lb)
        s = rng.randn(dim)
        new_x = best_x + sigma * s
        
        if np.all(new_x >= lb) and np.all(new_x <= ub):
            new_f = func(new_x)
            if new_f < best_f:
                best_f = new_f
                best_x = new_x
                
    return best_x
