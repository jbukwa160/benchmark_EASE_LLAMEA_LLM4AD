def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(mean, sigma):
        candidate = mean + sigma * rng.normal(size=dim)
        return clip(candidate)

    population_size = 10
    x_mean = np.zeros(dim)
    x_cov = np.eye(dim) * 1e-4
    budget_used = 0

    while budget_used < budget:
        candidates = np.array([generate_candidate(x_mean, np.sqrt(np.diag(x_cov))) for _ in range(population_size)])

        fitnesses = [func(candidate) for candidate in candidates]

        best_idx = np.argmin(fitnesses)
        x_mean = x_mean + 1e-2 * (candidates[best_idx] - x_mean)

        for i in range(dim):
            x_cov[i, i] = 0.8 * x_cov[i, i] + 0.2 * (candidates[best_idx][i] - x_mean[i])**2

        budget_used += population_size

    return x_mean
