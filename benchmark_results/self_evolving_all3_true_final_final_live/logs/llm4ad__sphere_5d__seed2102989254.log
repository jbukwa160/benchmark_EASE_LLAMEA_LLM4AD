def algorithm(func, dim, lb, ub, budget, rng):
    D = 5
    sigma0 = 10.0
    mu = np.zeros(dim)
    cov = np.eye(dim) * (ub - lb)**2
    best_x = None
    best_f = float('inf')
    
    for i in range(budget):
        x = rng.multivariate_normal(mu, cov)
        x = np.clip(x, lb, ub)
        
        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x
        
        if rng.random() < 0.1: # 10% chance to reset covariance matrix
            cov = np.eye(dim) * (ub - lb)**2
            
        elif f > best_f:
            sigma = max(0, sigma0 / np.sqrt(i + 1))
            dist = x - mu
            cov += sigma**2 * np.outer(dist, dist)
            
    return best_x
