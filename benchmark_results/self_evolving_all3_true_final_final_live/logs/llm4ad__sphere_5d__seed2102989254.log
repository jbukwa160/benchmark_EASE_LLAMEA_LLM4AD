def algorithm(func, dim, lb, ub, budget, rng):
    n_dim = len(dim)
    x_best = np.array([rng.uniform(lb, ub) for _ in range(n_dim)])
    best_fitness = func(x_best)

    schedule = lambda t: 0.95 ** (t / budget)

    t = 0
    while t < budget:
        x_new = x_best + rng.normal(size=n_dim, loc=0, scale=schedule(t))
        for i in range(n_dim):
            x_new[i] = np.clip(x_new[i], lb, ub)
        
        fitness_new = func(x_new)

        if fitness_new <= best_fitness:
            x_best = x_new
            best_fitness = fitness_new

        t += 1

    return x_best
