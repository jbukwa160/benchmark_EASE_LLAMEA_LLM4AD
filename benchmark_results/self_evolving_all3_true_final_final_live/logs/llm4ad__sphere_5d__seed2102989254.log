def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget - 1):
        for i in range(dim):
            new_x = x.copy()
            new_x[i] += np.random.choice([-0.5, 0.5])
            new_x[new_x < lb] = lb
            new_x[new_x > ub] = ub

            f_new = func(new_x)
            if f_new < best_f:
                best_f = f_new
                best_x = new_x.copy()

        x = rng.uniform(lb, ub, size=dim)

    return best_x
