def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 1e2
    alpha = 0.95
    best_x = x.copy()
    best_y = func(x)

    for _ in range(budget):
        y = func(x)
        if y < best_y:
            best_x = x.copy()
            best_y = y

        dx = rng.uniform(-1e-2, 1e-2, size=dim)
        new_x = np.clip(x + dx, lb, ub)

        dy = func(new_x) - y
        if dy < 0 or rng.random() * (dy + 1e-6) < T:
            x = new_x

        T *= alpha

    return best_x
