def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    D = 1e-4 * np.eye(n)
    sigma = 0.5 * (ub - lb) / np.sqrt(n)
    x = rng.uniform(lb, ub, size=n)
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        if i > 0:
            D = 0.1 * D + 0.9 * (np.outer((x - best_x), (x - best_x)) / n)

        # Hybrid mutation
        z = np.random.randn(n)
        x_new = x + sigma * z

        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new

        # Adaptive restart
        if i % 100 == 0 or f_new > best_f + 1e-6 * (ub - lb):
            sigma *= np.sqrt(2 / n)

        # Selection
        x = x_new if rng.uniform() < 0.5 else x

    return best_x
