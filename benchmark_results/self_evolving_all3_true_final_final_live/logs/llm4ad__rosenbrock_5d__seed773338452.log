def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    D = np.array([0.1 * rng.uniform(-1, 1) for _ in range(dim)])
    F = 0.6
    best_x = np.full(dim, (ub + lb) / 2)
    best_f = float('inf')

    for t in range(budget):
        x = clip(best_x + D)
        f = func(x)

        if f < best_f:
            best_f = f
            best_x = x

        if rng.random() < np.exp(-(best_f - f) / 10 ** (t / budget)):
            D *= F
            D += 0.1 * rng.uniform(-1, 1, size=dim)

    return best_x
