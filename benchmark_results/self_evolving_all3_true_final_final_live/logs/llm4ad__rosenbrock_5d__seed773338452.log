def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_population(pop_size):
        return rng.uniform(lb, ub, size=(pop_size, dim))

    def evaluate(population):
        return func(clip(population))

    population = generate_population(budget)
    minima = [evaluate(population)]

    for _ in range(budget - 1):
        diffs = np.diff(np.array(minima[-1]), axis=0)
        offspring = population + 0.5 * rng.uniform(-1, 1, size=(population.shape))
        for i in range(offspring.shape[0]):
            j = rng.randint(3, population.shape[0])
            k = rng.randint(3, population.shape[0])
            diff1 = diffs[j]
            diff2 = diffs[k]
            offspring[i] += 0.5 * (diff1 + diff2)
        minima.append(min(evaluate(offspring), key=func))

    return np.array([minima[-1].argmin()])
