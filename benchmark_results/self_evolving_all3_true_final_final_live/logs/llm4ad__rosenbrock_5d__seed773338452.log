def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        if not (lb <= x).all() or not (x <= ub).all():
            return 1e10
        return func(x)

    population = [np.array([random.uniform(lb, ub) for _ in range(dim)]) for _ in range(budget)]
    fitness = [evaluate(x) for x in population]

    for i in range(1000): # Run DE for a fixed number of iterations
        for j in range(len(population)):
            r1 = random.randint(0, len(population)-1)
            while r1 == j:
                r1 = random.randint(0, len(population)-1)

            r2 = random.randint(0, len(population)-1)
            while r2 == j or r2 == r1:
                r2 = random.randint(0, len(population)-1)

            u = population[r1] + rng*(population[r2] - population[j])
            uf = evaluate(u)

            if uf < fitness[j]:
                population[j] = u
                fitness[j] = uf

    best_idx = np.argmin(fitness)
    return population[best_idx]
