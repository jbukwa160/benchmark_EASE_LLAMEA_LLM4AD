def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    for _ in range(budget):
        x_cand = ub + (ub - lb) * rng.uniform(size=dim)
        x_cand = np.clip(x_cand, lb, ub)
        f_cand = func(x_cand)
        if f_cand < func(x_best):
            x_best = x_cand
    return x_best
