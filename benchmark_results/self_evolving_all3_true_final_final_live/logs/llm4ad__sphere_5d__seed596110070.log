def algorithm(func, dim, lb, ub, budget, rng):
    X = rng.uniform(lb, ub, size=(dim, budget))
    Y = np.zeros(budget)

    for i in range(budget):
        mean, var = gp.predict(X[:, i:i+1], full_cov=True)
        mu = mean[0]
        sigma = np.sqrt(var[0, 0])
        acq = -mu + 2 * np.log(1 + 1e-8) - np.log(sigma)

        idx_next = np.argmax(acq)
        Y[i] = func(X[:, idx_next])

        X_new = np.copy(X[:, idx_next]).reshape(-1, 1)
        gp.update_model(X_new, Y[i])
        gp._X = np.vstack((gp._X, X_new))

    best_idx = np.argmin(Y)
    return X[:, best_idx]
