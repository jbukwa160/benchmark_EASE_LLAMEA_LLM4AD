def algorithm(func, dim, lb, ub, budget, rng):
    min_val = float('inf')
    best_sol = None
    
    step_size = 1.0
    while True:
        if budget <= 0:
            break
        
        x = rng.uniform(lb, ub, size=dim)
        
        val = func(x)
        
        if val < min_val:
            min_val = val
            best_sol = x
            
        budget -= 1
        
        step_size /= 2.0
        
        x_min = np.full(dim, lb - step_size, dtype=float)
        x_max = np.full(dim, ub + step_size, dtype=float)
        
        for i in range(dim):
            if rng.uniform(0, 1) < 0.5:
                x_min[i] += step_size
                x_max[i] -= step_size
            else:
                x_max[i] += step_size
                x_min[i] -= step_size
        
        best_x = np.clip((x + x_min) / 2, lb, ub)
        
        val = func(best_x)
        
        if val < min_val:
            min_val = val
            best_sol = best_x
            
        budget -= 1
    
    return best_sol
