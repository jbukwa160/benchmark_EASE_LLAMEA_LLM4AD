def algorithm(func, dim, lb, ub, budget, rng):
    X = np.random.uniform(lb, ub, (budget, dim))
    Y = np.zeros(budget)
    for i in range(budget):
        Y[i] = func(X[i])
        
    def gp_model(x):
        return norm(loc=np.mean(Y), scale=np.std(Y)).cdf(func(x))

    best_x = None
    best_f = float('inf')
    
    for _ in range(10 * budget):  # 10 times as many iterations
        x_new = np.zeros(dim)
        for d in range(dim):
            X_s, Y_s = X[rng.randint(budget), :], Y[rng.randint(budget)]
            m = gp_model(X_s + (ub - lb) / 2 * rng.randn(dim))
            if m < 0.5:
                x_new[d] = np.random.uniform(lb, ub)
            else:
                x_new[d] = X_s[d]
        
        f_new = func(x_new)
        if f_new < best_f:
            best_x = x_new
            best_f = f_new
    
    return np.clip(best_x, lb, ub)
