def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = 5 * rng.random((dim)) - 5  # initial random candidate in [-5, 5]
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        f = func(clip(x))
        if f < best_f:
            best_f = f
            best_x = clip(x)
        
        # adaptive sampling density around promising regions
        sigma = 2 / (1 + _ / budget) * np.std(np.clip([func(clip(x + rng.normal(size=(dim)))) for i in range(10)], -np.inf, np.inf))
        x += rng.normal(size=(dim)) * sigma

    return best_x
