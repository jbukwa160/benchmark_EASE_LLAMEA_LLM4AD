def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        new_x = np.clip(rng.normal(loc=x, scale=0.1, size=(dim,)), lb, ub)
        f_new = func(new_x)
        
        if f_new < best_f:
            best_x = new_x
            best_f = f_new

    return best_x
