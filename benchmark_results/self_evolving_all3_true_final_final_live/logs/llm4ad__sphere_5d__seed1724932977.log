def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    def generate_candidate(params):
        x = params['x']
        sigma = params['sigma']
        x = [rng.normal(loc=xi, scale=sigma) for xi in x]
        x = clip(np.array(x))
        return x

    def update_best(x, best):
        if func(x) < func(best):
            return x
        else:
            return best

    def cma_es(params):
        x = params['x']
        sigma = params['sigma']
        step_size = 0.1
        for _ in range(budget):
            new_x = [xi + rng.normal(loc=0, scale=sigma*step_size) for xi in x]
            new_x = clip(np.array(new_x))
            if func(new_x) < func(x):
                x = new_x
            sigma *= 1.01 - 2/(budget+1)
        return {'x': x}

    def de(params):
        x = params['x']
        y = [rng.uniform(lb, ub) for _ in range(dim)]
        v = np.array(y) - np.array(x)
        new_x = clip(np.array(x) + 0.5 * v)
        if func(new_x) < func(x):
            return {'x': new_x}
        else:
            return params

    best = [rng.uniform(lb, ub) for _ in range(dim)]
    sigma = np.sqrt((ub - lb)**2 / dim)
    restarts = 0
    while restarts < budget:
        params = {'x': generate_candidate({'sigma': sigma}), 'sigma': sigma}
        cma_es_params = cma_es(params)
        if func(cma_es_params['x']) > func(best):
            de_params = de(cma_es_params)
            best = update_best(de_params['x'], best)
        else:
            best = cma_es_params['x']
        restarts += 1
    return np.array(best)
