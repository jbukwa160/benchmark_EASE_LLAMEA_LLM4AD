def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, (1, dim))
    f_best = func(x_best)
    
    for _ in range(budget):
        x_candidate = np.clip(rng.normal(loc=x_best, scale=np.abs(ub - lb) / 2, size=(1, dim)), a_min=lb, a_max=ub)
        
        if func(x_candidate) < f_best:
            f_best = func(x_candidate)
            x_best = x_candidate
        
    return x_best
