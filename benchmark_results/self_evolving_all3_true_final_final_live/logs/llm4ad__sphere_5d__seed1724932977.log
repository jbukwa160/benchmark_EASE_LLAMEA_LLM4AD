def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def generate_population(size):
        population = np.random.rand(size, dim)
        return clip(population * (ub - lb)) + lb

    def evaluate(candidate):
        return func(candidate)

    best_candidate = None
    best_fitness = float('inf')

    population_size = 100
    for _ in range(budget):
        population = generate_population(population_size)
        fitnesses = np.array([evaluate(individual) for individual in population])
        mean_fitness = np.mean(fitnesses)

        if mean_fitness < best_fitness:
            best_candidate = population[np.argmin(fitnesses)]
            best_fitness = mean_fitness

    return best_candidate
