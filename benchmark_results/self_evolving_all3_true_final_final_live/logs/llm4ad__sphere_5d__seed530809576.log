def algorithm(func, dim, lb, ub, budget, rng):
    n_samples = 1000
    std_dev = 1.0
    noise_var = 1e-4
    
    gp_model = GaussianProcess(x_init=np.zeros((n_samples, dim)), y_init=func(np.zeros((n_samples, dim))).reshape(-1),
                               kernel=lambda x, y: np.exp(-(np.linalg.norm(x - y) ** 2)),
                               noise_var=noise_var)
    
    best_candidate = np.zeros(dim)
    best_value = float('inf')
    
    for _ in range(budget):
        new_x = gp_model.sample()
        
        # Clip candidate to [lb, ub]
        new_x = np.clip(new_x, lb, ub)
        
        new_y = func(new_x)
        
        gp_model.update(new_x, new_y)
        
        if new_y < best_value:
            best_candidate = new_x
            best_value = new_y
    
    return best_candidate
