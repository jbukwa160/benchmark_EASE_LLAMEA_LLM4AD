def algorithm(func, dim, lb, ub, budget, rng):
    x = 5 * (rng.rand(dim) - 0.5)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        if np.any(best_x < lb) or np.any(best_x > ub):
            x = np.clip(best_x, lb, ub)
        
        g = rng.rand(dim)
        step_size = 0.1 / (np.linalg.norm(g) + 1e-6)

        new_x = best_x - step_size * g
        new_x = np.clip(new_x, lb, ub)

        f_new = func(new_x)

        if f_new < best_f:
            best_x = new_x
            best_f = f_new

    return best_x
