def algorithm(func, dim, lb, ub, budget, rng):
    best = None
    best_fit = float('inf')
    
    for _ in range(budget):
        x = (lb + ub) / 2 * np.ones(dim)
        
        for d in range(dim):
            if rng.random() < 0.5:
                x[d] += (ub - lb) * rng.uniform(-1, 1)
            else:
                x[d] -= (ub - lb) * rng.uniform(0, 1)
            
            # Clip to bounds
            x[d] = max(lb, min(x[d], ub))
        
        fit = func(x)
        
        if fit < best_fit:
            best_fit = fit
            best = x.copy()
    
    return best
