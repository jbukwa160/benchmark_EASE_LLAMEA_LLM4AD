def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_f = float('inf')
    
    for _ in range(budget):
        x = np.zeros(dim)
        for i in range(dim):
            x[i] = (ub - lb) * rng.uniform(0, 1) + lb
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
        
        step_size = (ub - lb) / np.sqrt(_ + 1)
        gradient = np.zeros(dim)
        for i in range(dim):
            epsilon = rng.uniform(-1, 1)
            x_epsilon = x.copy()
            x_epsilon[i] += epsilon * step_size
            f_epsilon = func(x_epsilon)
            
            gradient[i] = (f_epsilon - f) / epsilon
        
        if best_x is not None:
            for i in range(dim):
                if np.abs(gradient[i]) < 1e-3 and np.abs(best_x[i]) > 0.01 * (ub - lb):
                    step_size *= 2
                    gradient[i] = 0
                    
                    x_epsilon = best_x.copy()
                    x_epsilon[i] += epsilon * step_size
                    f_epsilon = func(x_epsilon)
                    
                    if f_epsilon < best_f:
                        best_f = f_epsilon
                        best_x = x_epsilon
                        
    return np.clip(best_x, lb, ub)
