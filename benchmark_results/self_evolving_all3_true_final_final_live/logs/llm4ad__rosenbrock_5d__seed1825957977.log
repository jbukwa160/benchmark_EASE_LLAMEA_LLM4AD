def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    x0 = 1 + (ub - 1) * rng.uniform(0, 1, size=dim)
    cma = np.eye(dim)
    damps = 1
    stepsize = 1
    sigma = 10 / dim

    for _ in range(budget):
        y = np.random.multivariate_normal(np.zeros(dim), linalg.cholesky(cma + damps * np.eye(dim)))
        x_new = x0 + stepsize * sigma * y

        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)

        f_new = objective(x_new)
        f_old = func(x0)

        if f_new < f_old:
            x0 = x_new
            cma = (1 - 2 * stepsize) * cma + 2 * stepsize * y @ y.T
            damps = max(0, damps - 2 * stepsize)
            sigma *= np.exp(stepsize)

        else:
            beta = rng.uniform(0, 1)
            if beta < 0.1:
                x0 += stepsize * y

            # Clip candidates to [lb, ub]
            x0 = np.clip(x0, lb, ub)

    return x0
