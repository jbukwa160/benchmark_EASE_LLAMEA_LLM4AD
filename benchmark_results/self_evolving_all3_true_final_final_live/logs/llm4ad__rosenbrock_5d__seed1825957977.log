def algorithm(func, dim, lb, ub, budget, rng):
    x = 5 * np.random.rand(dim) - 5
    T = 1000
    alpha = 0.99
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Simulated Annealing (SA)
        new_x = x + rng.uniform(-1, 1, size=dim) / np.sqrt(np.sum(x**2))
        new_f = func(new_x)
        
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f

        # Differential Evolution (DE)
        v = x + rng.uniform(-1, 1, size=dim) / np.sqrt(np.sum(x**2))
        v[v > ub] = ub
        v[v < lb] = lb
        
        if func(v) < best_f:
            x = v.copy()
            
        # Cooling schedule for SA
        T *= alpha

    return best_x
