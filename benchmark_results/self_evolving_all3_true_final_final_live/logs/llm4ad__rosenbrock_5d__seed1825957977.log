def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    pop = (ub - lb) * rng.rand(pop_size, dim) + lb
    
    # Initialize covariance matrix for CMA-ES
    cov_mat = np.eye(dim)
    
    # Main optimization loop
    for _ in range(budget):
        # Evaluate the population and get fitness values
        fitness = func(pop)
        
        # Compute step size for evolution strategy
        sigma = 0.1
        
        # Update covariance matrix using CMA-ES updates
        cov_mat, mu = cma_update(cov_mat, pop, fitness, sigma)
        
        # Select the best point as the new center of the population
        idx_best = np.argmin(fitness)
        pop_new = (ub - lb) * rng.randn(pop_size, dim) + lb
        
        # Add noise to the selected point and evaluate its neighbors
        for i in range(pop_size):
            noise = sigma * rng.randn(dim)
            pop_new[i] += mu[idx_best] + noise
            
            # Clip candidates to bounds
            pop_new[i] = np.clip(pop_new[i], lb, ub)
        
        # Replace old population with the new one
        pop = pop_new
    
    # Return the best point found
    idx_best = np.argmin(func(pop))
    return pop[idx_best]
