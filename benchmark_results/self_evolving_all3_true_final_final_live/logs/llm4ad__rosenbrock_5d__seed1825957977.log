def algorithm(func, dim, lb, ub, budget, rng):
    def sample(rng, lb, ub):
        return (ub - lb) * rng.uniform(size=dim) + lb

    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    best = sample(rng, lb, ub)
    for _ in range(budget):
        candidate = sample(rng, lb, ub)
        if func(candidate) < func(best):
            best = candidate
        else:
            step_size = 0.1 * (ub - lb)
            new_candidate = best + step_size * rng.normal(size=dim)
            new_candidate = clip(new_candidate, lb, ub)
            if func(new_candidate) < func(best):
                best = new_candidate
    return best
