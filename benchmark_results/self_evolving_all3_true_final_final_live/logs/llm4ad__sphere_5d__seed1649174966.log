def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(clip(best_x))
    temperature = 1.0
    for _ in range(budget):
        y = clip(x + rng.normal(size=dim) * 0.01)
        f_y = func(y)
        if f_y < best_f:
            best_f = f_y
            best_x = y.copy()
        acceptance_prob = np.exp((best_f - f_y) / temperature)
        if rng.uniform() < acceptance_prob:
            x = y.copy()
        temperature *= 0.99999
    return best_x
