def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.array(rng.uniform(lb, ub, size=dim))
    f_best = func(clip(x_best))

    for _ in range(budget - 1):
        s = np.sqrt(np.sum((x_best - lb) ** 2)) / dim
        step_size = (ub - lb) * rng.uniform(0.01, 0.1)
        step_size *= np.exp(-s)

        x_new = clip(x_best + rng.normal(size=dim) * step_size)
        f_new = func(x_new)

        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
