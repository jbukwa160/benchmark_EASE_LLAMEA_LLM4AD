def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    pop_size = 50
    sigma = 1.0
    mu = 1 / pop_size * np.ones(pop_size)
    cov = np.eye(pop_size)
    for i in range(budget):
        x = rng.randn(pop_size, dim) * sigma + lb
        f = func(x)
        if any(f_i < f_best for f_i in f):
            idx = np.argmin(f)
            if f[idx] < f_best:
                x_best = x[idx]
                f_best = f[idx]
        cov_new = 3 / (4 - dim) * cov + mu[:, None] @ mu[:, None].T
        cov = 0.5 * (cov + np.linalg.inv(cov_new))
        sigma *= np.sqrt(np.trace(cov) / pop_size)
    return x_best
