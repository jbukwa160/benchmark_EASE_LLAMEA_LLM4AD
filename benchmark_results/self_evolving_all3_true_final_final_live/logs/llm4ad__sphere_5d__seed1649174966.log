def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 10 * (ub - lb)**2
    alpha = 0.9
    best_x = x.copy()
    best_y = func(x)

    for _ in range(budget):
        y = func(x)
        if y < best_y:
            best_y = y
            best_x = x.copy()

        dx = np.random.uniform(-1, 1, size=dim) * (ub - lb) / 10
        dx = np.clip(dx + x, lb, ub)

        dy = func(dx)
        Delta = dy - y

        if Delta < 0 or rng.rand() < np.exp(-Delta / T):
            x = dx.copy()

        T *= alpha

    return best_x
