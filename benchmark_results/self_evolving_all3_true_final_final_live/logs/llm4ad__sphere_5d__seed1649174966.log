def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    sigma = 1.0
    pc = rng.rand(dim)
    cum_pc = np.cumsum(pc)
    p_best = x.copy()

    for _ in range(budget):
        y = func(clip(x))
        if y < func(clip(p_best)):
            p_best = x.copy()
        
        z = sigma * (pc + 1e-8)[:, None] * rng.randn(dim)
        x_new = clip(x + z)
        y_new = func(x_new)

        delta = x_new - x
        if y_new < y:
            x = x_new
            v = delta / np.linalg.norm(delta)
            H = (v @ v.T) * sigma**2 / (1 + 1e-8)
            C += H
            sigma *= np.exp(-0.5 * rng.randn()**2)
        else:
            z = sigma * pc[:, None] * rng.randn(dim)
            x_new = clip(x + z)
            y_new = func(x_new)

            delta = x_new - x
            if y_new < y:
                x = x_new
                v = delta / np.linalg.norm(delta)
                H = (v @ v.T) * sigma**2 / (1 + 1e-8)
                C += H
                sigma *= np.exp(-0.5 * rng.randn()**2)

    return p_best
