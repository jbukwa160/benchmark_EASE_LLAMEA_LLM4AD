def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    T = 1e2 * np.max(np.abs(ub - lb))
    alpha = 0.99

    for _ in range(budget):
        y = x + rng.normal(size=x.shape) * 0.01
        z = clip(y)

        f_y = func(z)
        f_x = func(x)

        if f_y < f_x:
            x = z
        else:
            delta_f = f_y - f_x

            if np.exp(-delta_f / T) > rng.random():
                x = z

        T *= alpha

    return clip(x)
