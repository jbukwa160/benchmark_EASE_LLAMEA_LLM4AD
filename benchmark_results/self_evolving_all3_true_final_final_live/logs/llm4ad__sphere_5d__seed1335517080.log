def algorithm(func, dim, lb, ub, budget, rng):
    def clipped_func(x):
        return np.sum(np.clip(x, lb, ub)**2)

    init = 1e-3 * (ub - lb) + lb
    result = minimize(clipped_func, init, method="SLSQP", bounds=[(lb, ub)]*dim)
    return result.x
