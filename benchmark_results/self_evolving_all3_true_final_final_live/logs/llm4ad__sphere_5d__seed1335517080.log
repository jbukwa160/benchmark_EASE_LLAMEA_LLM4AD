def algorithm(func, dim, lb, ub, budget, rng):
    best_x = rng.uniform(lb, ub, size=dim)
    best_y = func(best_x)

    for _ in range(budget):
        x = best_x + rng.uniform(-1e-3, 1e-3, size=dim)
        x = np.clip(x, lb, ub)
        y = func(x)

        if y < best_y:
            best_x = x
            best_y = y

    return best_x
