def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    t = 1.0
    T_initial = 10000
    alpha = 0.99
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        new_x = x.copy() + rng.uniform(-1, 1, size=dim)
        new_x = np.clip(new_x, lb, ub)

        new_f = func(new_x)

        delta = new_f - best_f

        if delta < 0:
            x = new_x
            best_x = new_x
            best_f = new_f
        else:
            prob = np.exp(-delta / t)
            if rng.uniform(0, 1) < prob:
                x = new_x

        t *= alpha
        t = max(t, 0.00001)

    return best_x
