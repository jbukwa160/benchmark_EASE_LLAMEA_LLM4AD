def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    strategy = 'rand1exp'
    sigma = 0.5
    mu = 0.2
    
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    for i in range(budget):
        # initialization
        population = rng.uniform(lb, ub, (pop_size, dim))
        
        # DE-based search
        candidate_pool = []
        for _ in range(pop_size):
            ind1, ind2, ind3 = np.random.choice(range(pop_size), 3, replace=False)
            candidate = population[ind1] + sigma * rng.uniform(-1, 1, (dim,))
            candidate_pool.append(candidate)
        
        # CMA-ES adaptation
        if len(candidate_pool) > 0:
            x_mean = np.mean(np.array(candidate_pool), axis=0)
            cov = np.cov(np.array(candidate_pool).T)
            population[:] = x_mean + rng.multivariate_normal(mean=x_mean, cov=cov, size=pop_size)
        
        # evaluate and update
        for candidate in population:
            f_candidate = func(candidate)
            if f_candidate < f_best:
                f_best = f_candidate
                x_best = candidate
        
        # clip to bounds
        x_best = np.clip(x_best, lb, ub)
        
    return x_best
