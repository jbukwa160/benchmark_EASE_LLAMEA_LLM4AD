def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.zeros(dim)
    best_x = np.copy(x)
    best_y = func(x)

    for _ in range(budget):
        v = np.random.uniform(lb, ub, size=dim) + np.random.normal(size=dim)
        y = func(clip(v))
        if y < best_y:
            best_x = np.copy(v)
            best_y = y
        elif rng.random() < 0.5: # accept worse solution with probability 0.5
            v += np.random.uniform(-1, 1, size=dim) * 0.01 * (best_x - x)
            v = clip(v)
            y = func(v)
            if y < best_y:
                best_x = np.copy(v)
                best_y = y

    return best_x
