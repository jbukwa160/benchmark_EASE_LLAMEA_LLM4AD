def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    mu = 1.0 / (ub - lb)
    sigma = 0.5 * (ub - lb)

    population = np.random.uniform(lb, ub, size=(pop_size, dim))
    cost = np.zeros(pop_size)

    for _ in range(budget):
        for i in range(pop_size):
            mutation = rng.normal(0, sigma)
            candidate = population[i] + mu * mutation
            candidate = np.clip(candidate, lb, ub)
            candidate_cost = func(candidate)
            if candidate_cost < cost[i]:
                population[i] = candidate
                cost[i] = candidate_cost

        for i in range(pop_size):
            best_candidate = population[np.argmin(cost)]
            mutation1 = rng.normal(0, sigma)
            mutation2 = rng.normal(0, sigma)
            mutation3 = rng.normal(0, sigma)
            candidate = best_candidate + mu * (mutation1 * population[i] + mutation2 * np.random.uniform(lb, ub) + mutation3 * np.random.uniform(lb, ub))
            candidate = np.clip(candidate, lb, ub)
            candidate_cost = func(candidate)
            if candidate_cost < cost[i]:
                population[i] = candidate
                cost[i] = candidate_cost

    best_idx = np.argmin(cost)
    return population[best_idx]
