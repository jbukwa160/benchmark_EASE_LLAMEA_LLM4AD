def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    T0 = 10 * (ub - lb)
    alpha = 0.99
    cooling_rate = 0.9995
    best_x = x.copy()
    best_y = func(x)

    for t in range(budget):
        y = func(x)
        if y < best_y:
            best_y = y
            best_x = x.copy()

        delta = np.random.uniform(-1, 1, size=dim)
        delta[delta < lb - x] = lb - x[delta < lb - x]
        delta[delta > ub - x] = ub - x[delta > ub - x]

        new_x = x + delta
        new_y = func(new_x)

        if rng.uniform(0, 1) < np.exp((best_y - new_y) / T0):
            x = new_x

        T0 *= cooling_rate
        if T0 < 1e-6:
            break

    return best_x
