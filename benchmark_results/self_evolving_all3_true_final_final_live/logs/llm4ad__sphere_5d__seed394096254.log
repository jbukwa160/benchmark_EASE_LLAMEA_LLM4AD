def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_x = rng.uniform(lb, ub, size=dim)
    best_fval = func(best_x)

    for _ in range(budget):
        x = clip(rng.normal(loc=best_x, scale=0.1, size=dim))
        fval = func(x)
        if fval < best_fval:
            best_fval = fval
            best_x = x

    return best_x
