def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        while True:
            delta = (ub - lb) * rng.uniform(size=dim)
            candidate = x + delta
            candidate = np.clip(candidate, lb, ub)

            if func(candidate) < best_f:
                x = candidate.copy()
                best_x = candidate.copy()
                best_f = func(candidate)
                break

    return best_x
