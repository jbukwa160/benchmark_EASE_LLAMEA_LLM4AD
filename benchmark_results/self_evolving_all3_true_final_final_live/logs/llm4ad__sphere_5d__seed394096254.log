def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(dim, population_size):
        return rng.uniform(lb, ub, (population_size, dim))

    def calculate_fitness(population):
        return [func(individual) for individual in population]

    def pca_reduction(data, n_components):
        from sklearn.decomposition import PCA
        pca = PCA(n_components=n_components)
        return pca.fit_transform(data)

    def sa_step(current_solution, current_fitness, temperature, step_size):
        candidate = current_solution + rng.normal(0, step_size, dim)
        clipped_candidate = clip_candidate(candidate)
        new_fitness = func(clipped_candidate)
        if new_fitness < current_fitness:
            return clipped_candidate, new_fitness
        else:
            probability = np.exp((current_fitness - new_fitness) / temperature)
            if rng.random() < probability:
                return clipped_candidate, new_fitness
            else:
                return current_solution, current_fitness

    def nelder_mead_step(population):
        best_individual = population[np.argmin(calculate_fitness(population))]
        centroid = np.mean(population, axis=0)
        reflection = 2 * best_individual - centroid
        reflection = clip_candidate(reflection)
        new_fitness = func(reflection)
        if new_fitness < calculate_fitness(population)[np.argmin(calculate_fitness(population))]:
            return reflection, new_fitness
        else:
            expansion = 1.5 * (best_individual - centroid) + centroid
            expansion = clip_candidate(expansion)
            new_fitness = func(expansion)
            if new_fitness < new_fitness:
                return expansion, new_fitness
            contraction = best_individual + np.sign(best_individual - centroid) * 0.5 * (best_individual - centroid)
            contraction = clip_candidate(contraction)
            new_fitness = func(contraction)
            if new_fitness < new_fitness:
                return contraction, new_fitness
        return best_individual, calculate_fitness(population)[np.argmin(calculate_fitness(population))]

    initial_population = generate_initial_population(dim, 1000)
    for _ in range(budget):
        population = pca_reduction(initial_population, dim // 2)
        fitness = calculate_fitness(population)
        initial_solution, initial_fitness = nelder_mead_step(population)

        temperature = 10.0
        step_size = 1.0

        solution, fitness = sa_step(initial_solution, initial_fitness, temperature, step_size)

    return clip_candidate(solution)
