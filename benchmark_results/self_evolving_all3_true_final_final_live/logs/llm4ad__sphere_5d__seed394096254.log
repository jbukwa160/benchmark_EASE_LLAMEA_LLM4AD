def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x0 = clip(rng.uniform(size=dim) * (ub - lb) + lb)
    sigma = 1.0
    D = np.eye(dim)
    mean = x0

    for _ in range(budget):
        N = budget
        y = func(clip(mean))

        if len(x0.shape) == 1:
            z = rng.normal(size=(N, dim))
        else:
            z = rng.normal(size=x0.shape)

        z = clip(z * sigma + mean[:, np.newaxis])
        x = clip(z)
        f_x = func(x)

        if y < f_x:
            mean = (1 - 1/N) * mean + 1/N * x
            D = (1 - 1/N) * D + 1/N * np.outer(x - mean, x - mean)
            sigma *= np.exp(-0.5 / N * norm(np.linalg.solve(D, x - mean)))
        else:
            D += 1/N * np.outer(x - mean, x - mean)

    return mean
