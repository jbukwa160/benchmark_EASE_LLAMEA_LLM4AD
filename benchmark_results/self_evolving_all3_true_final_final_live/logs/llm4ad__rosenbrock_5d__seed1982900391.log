def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(size=dim) * (ub - lb) + lb
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        s = rng.normal(size=dim)
        d = np.linalg.norm(s) ** 2 / dim
        
        if rng.random() < 0.5:
            s *= (ub - lb) * rng.uniform(size=dim)
        
        x_try = best_x + d * s
        x_try = np.clip(x_try, lb, ub)
        
        f_try = func(x_try)
        
        if f_try < best_f:
            best_f = f_try
            best_x = x_try
    
    return best_x
