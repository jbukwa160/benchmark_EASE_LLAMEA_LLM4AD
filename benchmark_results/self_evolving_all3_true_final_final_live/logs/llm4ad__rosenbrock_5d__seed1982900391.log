def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(candidates):
        return func(candidates)

    def prune(population, fitnesses, top_k):
        indices = np.argsort(fitnesses)[:top_k]
        return population[indices], fitnesses[indices]

    def learn_rate(iteration, max_iter):
        return 1 / (iteration + 1) if iteration < max_iter else 0

    # Initialisation
    N = int(np.power(budget, 1/dim))
    population_size = int(N**0.5)
    population = np.random.uniform(lb, ub, size=(population_size, dim))

    for t in range(population_size):
        candidate = clip(population[t])
        fitness = evaluate(candidate)

    for iteration in range(budget - population_size):
        # Differential Evolution
        for i in range(population_size):
            r1, r2, r3 = rng.randint(0, population_size-1), rng.randint(0, population_size-1), rng.randint(0, population_size-1)
            while r1 == i or r2 == i or r3 == i:
                r1, r2, r3 = rng.randint(0, population_size-1), rng.randint(0, population_size-1), rng.randint(0, population_size-1)

            candidate = clip(population[i] + learn_rate(iteration, budget) * (population[r1] - 2*population[r2] + population[r3]))

        # Probabilistic Pruning
        fitnesses = evaluate(np.array([clip(candidate) for candidate in population]))
        top_k = int(population_size * 0.2)
        population, fitnesses = prune(population, fitnesses, top_k)

    return clip(population[np.argmin(fitnesses)])
