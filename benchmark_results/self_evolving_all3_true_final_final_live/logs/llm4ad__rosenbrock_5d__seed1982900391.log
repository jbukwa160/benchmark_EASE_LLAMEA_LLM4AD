def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    x = np.array([np.random.uniform(lb, ub) for _ in range(n)])
    T0 = 1000 * (ub - lb)
    alpha = 0.99
    k = 0

    while k < budget:
        y = x + rng.normal(0, 1, n)
        y = np.clip(y, lb, ub)

        delta = func(y) - func(x)
        if delta < 0 or (np.random.rand() < np.exp(-delta / T0)):
            x = y
            k += 1

        if T0 > 1e-6:
            T0 *= alpha

    return x
