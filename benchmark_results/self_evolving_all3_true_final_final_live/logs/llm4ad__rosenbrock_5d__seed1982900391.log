def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(x, best, fbest):
        v = best + 0.1 * (x - best)
        return v

    def crossover(u, x):
        y = u
        for i in range(dim):
            if rng.random() < 0.9:
                y[i] = u[i]
            else:
                y[i] = x[i]
        return y

    population_size = int(1e3)
    population = np.random.uniform(lb, ub, (population_size, dim))
    best_x = None
    fbest = 1e10

    for i in range(budget):
        fitness = [func(x) for x in population]
        best_idx = np.argmin(fitness)
        if fitness[best_idx] < fbest:
            fbest = fitness[best_idx]
            best_x = population[best_idx]

        for j in range(population_size):
            idxs = rng.choice([k for k in range(population_size) if k != j], 3, replace=False)
            u = mutate(population[jdxs], population[idxs[0]], fbest)
            v = crossover(u, population[j])
            population[j] = np.clip(v, lb, ub)

    return best_x
