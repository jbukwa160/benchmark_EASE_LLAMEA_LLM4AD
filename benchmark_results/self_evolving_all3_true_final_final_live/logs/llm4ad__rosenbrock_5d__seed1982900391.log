def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x), x

    best_x = np.random.uniform(lb, ub, size=dim)
    best_y = evaluate(best_x)[0]

    current_x = np.random.uniform(lb, ub, size=dim)
    T = 100.0
    c1 = 0.8
    c2 = 0.2

    for _ in range(budget):
        new_x = current_x + rng.normal(size=dim) * (ub - lb) / np.sqrt(_ + 1)
        new_y, new_x = evaluate(new_x)

        delta = new_y - best_y
        if delta < 0:
            best_y = new_y
            best_x = new_x

        T *= c2

        if rng.rand() < np.exp(-delta / T):
            current_x = new_x

    return best_x
