def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_noise(lower, upper, rng):
        return lower + (upper - lower) * rng.uniform(0, 1)

    def covariance_matrix(candidates):
        cov = np.zeros((dim, dim))
        for i in range(dim):
            mean_i = np.mean(candidates[:, i])
            for j in range(i+1, dim):
                mean_j = np.mean(candidates[:, j])
                cov[i, j] = (candidates[:, i] - mean_i) * (candidates[:, j] - mean_j)
                cov[j, i] = cov[i, j]
        return cov

    def adaptive_search(candidates, lb, ub):
        dim = len(candidates[0])
        num_parents = int(0.2 * len(candidates))
        parents = np.array(sorted(candidates, key=lambda x: func(x), reverse=True)[:num_parents])
        new_candidates = []
        for i in range(len(parents)):
            for j in range(dim):
                candidate = parents[i].copy()
                if rng.random() < 0.5:
                    candidate[j] += gaussian_noise(lb[j], ub[j], rng)
                else:
                    candidate[j] -= gaussian_noise(lb[j], ub[j], rng)
                new_candidates.append(candidate)
        return np.array(new_candidates)

    def clip_candidates(candidates, lb, ub):
        clipped_candidates = []
        for candidate in candidates:
            clipped_candidate = [max(min(x, ub), lb) for x in candidate]
            clipped_candidates.append(clipped_candidate)
        return np.array(clipped_candidates)

    current_best = None
    budget_used = 0
    candidates = [[gaussian_noise(lb[i], ub[i], rng) for i in range(dim)] for _ in range(100)]
    while budget_used < budget:
        new_candidates = adaptive_search(candidates, lb, ub)
        clipped_new_candidates = clip_candidates(new_candidates, lb, ub)
        all_candidates = np.vstack((candidates, clipped_new_candidates))
        best_candidate = sorted(all_candidates, key=lambda x: func(x), reverse=True)[0]
        if current_best is None or func(best_candidate) < func(current_best):
            current_best = best_candidate
        candidates = all_candidates[np.argmin([func(candidate) for candidate in candidates])]
        budget_used += 1

    return np.array(current_best)
