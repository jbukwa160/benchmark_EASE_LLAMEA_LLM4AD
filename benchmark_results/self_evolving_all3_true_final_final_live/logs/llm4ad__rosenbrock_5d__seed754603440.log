def algorithm(func, dim, lb, ub, budget, rng):
    def grad(x):
        return 2 * np.concatenate([100*(x[i+1]-x[i]**2)*(-400*x[i]) + 2*(x[i]-1) for i in range(dim-1)] + [2*(x[-1]-1)])

    x_best = np.array(rng.uniform(lb, ub, size=dim))
    f_best = func(x_best)

    for _ in range(budget):
        mutant = []
        for i in range(dim):
            p1, p2, p3 = rng.choice(dim, 3, replace=False)
            if p1 == i:
                p1 += 1
            elif p1 > i:
                p1 -= 1
            if p2 == i:
                p2 += 1
            elif p2 > i:
                p2 -= 1
            if p3 == i:
                p3 += 1
            elif p3 > i:
                p3 -= 1

            mutant.append(x_best[p1] + rng.uniform(-1, 1) * (x_best[p2] - x_best[p3]))

        mutant = np.array(mutant)
        mutant = lb + (ub - lb) * rng.uniform(size=dim)

        for i in range(dim):
            if rng.random() < 0.5:
                mutant[i] = x_best[i] + rng.uniform(-1, 1) * (mutant[i] - x_best[i])

        # Gradient-based update
        new_mutant = mutant + 0.01 * grad(mutant)
        new_mutant = lb + (ub - lb) * rng.uniform(size=dim)

        f_new = func(new_mutant)
        if f_new < f_best:
            x_best, f_best = new_mutant, f_new

    return x_best
