def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.maximum(np.minimum(x, ub), lb)

    def sa(x0, T0, alpha, steps):
        x = x0.copy()
        for _ in range(steps):
            y = x + rng.normal(size=x.shape)
            y = clip(y, lb, ub)
            delta = func(y) - func(x)
            if delta < 0 or np.random.rand() * np.exp(-delta/T0) > np.random.rand():
                T0 *= alpha
                x = y
        return x

    def de(x0, bounds, steps):
        x = x0.copy()
        for _ in range(steps):
            y1 = clip(x + rng.normal(size=x.shape), lb, ub)
            y2 = clip(y1 + rng.uniform(-1, 1, size=y1.shape) * (ub - lb), lb, ub)
            delta = func(y2) - func(x)
            if delta < 0:
                x = y2
        return x

    x = rng.uniform(size=dim)
    while budget > 0:
        x_sa = sa(x, 1.0, 0.99, int(0.5 * budget))
        x_de = de(x_sa, (lb, ub), int(budget / 2))
        if func(x_de) < func(x):
            x = x_de
        else:
            x = clip(x + rng.normal(size=x.shape), lb, ub)
        budget -= 1

    return x
