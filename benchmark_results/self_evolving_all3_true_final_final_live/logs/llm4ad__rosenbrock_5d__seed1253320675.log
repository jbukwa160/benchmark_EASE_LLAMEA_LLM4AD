def algorithm(func, dim, lb, ub, budget, rng):
    def bounded(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = bounded(x)
        return func(x), 1

    pop_size = int(np.sqrt(budget))
    sigma = 0.5
    mu = np.zeros(dim)
    C = np.eye(dim) * (np.prod(ub - lb)) / dim

    for i in range(pop_size, budget):
        y = mu + rng.normal(size=dim) * sigma
        f, _ = evaluate(y)

        if rng.rand() < 0.1:
            mu += 0.01 * np.dot(np.linalg.solve(C, mu - y), C)

        elif f < func(mu):
            mu = y

        else:
            v = y - mu
            C += 0.5 * (v[:, None] @ v[None, :])

    return mu
