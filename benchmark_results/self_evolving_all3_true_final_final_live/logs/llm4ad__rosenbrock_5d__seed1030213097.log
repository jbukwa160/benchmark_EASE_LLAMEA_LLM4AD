def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best = func(x)

    for _ in range(budget - 1):
        p = rng.choice(dim, size=2, replace=False)
        y = x.copy()
        for i in [p[0], p[1]]:
            y[i] += rng.normal(0, 1e-3)
            if lb <= y[i] <= ub:  # clip to bounds
                continue
            y[i] = np.clip(y[i], lb, ub)

        f_y = func(y)
        if f_y < best:
            best = f_y
            x = y

    return x
