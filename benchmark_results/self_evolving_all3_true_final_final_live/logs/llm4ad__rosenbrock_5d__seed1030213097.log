def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def candidate(x):
        new_x = x + rng.normal(0, 1, size=(dim,))
        return clip(new_x)

    def evaluate(x):
        return func(x)

    current_best = None
    best_score = float('inf')

    T = 100.0

    for t in range(budget):
        x_current = np.random.uniform(lb, ub, size=(dim,))
        score_current = evaluate(x_current)
        
        if score_current < best_score:
            best_score = score_current
            current_best = x_current
        
        for _ in range(10):
            x_candidate = candidate(current_best)
            score_candidate = evaluate(x_candidate)
            
            delta = score_candidate - score_current
            
            if delta <= 0 or rng.rand() < np.exp(-delta/T):
                current_best = x_candidate
                score_current = score_candidate
        
        T *= 0.99

    return current_best
