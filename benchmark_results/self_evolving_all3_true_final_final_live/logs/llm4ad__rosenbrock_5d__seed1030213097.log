def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(best_x)
    
    for _ in range(budget):
        x_new = np.clip(np.random.normal(loc=best_x, scale=0.5), a_min=lb, a_max=ub)
        
        f_new = func(x_new)
        
        if f_new < best_f:
            best_f = f_new
            best_x = x_new
            
    # Local gradient descent to refine the solution
    step_size = 1e-4
    
    for _ in range(100):
        grad = np.zeros(dim)
        for i in range(dim):
            eps = np.zeros(dim)
            eps[i] = 1e-6
            grad[i] = (func(best_x + eps) - func(best_x)) / eps[i]
        
        best_x -= step_size * grad
        
    return best_x
