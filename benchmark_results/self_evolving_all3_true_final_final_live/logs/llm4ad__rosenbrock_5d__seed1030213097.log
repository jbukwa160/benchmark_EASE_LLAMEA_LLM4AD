def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(budget, dim, lb, ub):
        return np.array([uniform.rvs(low=lb, high=ub, size=dim) for _ in range(budget)])

    def evaluate_candidate(x):
        return func(x)

    best_solution = None
    best_fitness = float('inf')

    initial_population = generate_initial_population(budget, dim, lb, ub)
    population = initial_population

    temperature = 100.0
    cooling_rate = 0.99
    sigma = 1.5 * (ub - lb) / np.sqrt(dim)

    for i in range(2 * budget):
        if best_solution is not None:
            current_solution = population[np.random.choice(range(budget), p=np.exp(-(evaluate_candidate(population) - evaluate_candidate(best_solution)) / temperature))]
            next_solution = current_solution + np.random.normal(loc=0, scale=sigma, size=dim)
            next_solution = np.clip(next_solution, lb, ub)

            if evaluate_candidate(next_solution) < evaluate_candidate(current_solution):
                population[i % budget] = next_solution
            else:
                if np.random.rand() < np.exp((evaluate_candidate(current_solution) - evaluate_candidate(next_solution)) / temperature):
                    population[i % budget] = next_solution

        current_population = population[:budget]
        sorted_indices = np.argsort(evaluate_candidate(current_population))
        current_population = current_population[sorted_indices]

        best_solution = current_population[0]
        best_fitness = evaluate_candidate(best_solution)

        if i >= 2 * budget - 1:
            break

        temperature *= cooling_rate
        sigma /= (1 + 1 / (i + 1))

    return np.array([best_solution])
