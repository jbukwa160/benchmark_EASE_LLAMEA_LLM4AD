def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 1.0
    mu = rng.rand(dim)
    cov = np.eye(dim) * 1000.0
    n_evals = 0

    while n_evals < budget:
        z = rng.randn(dim)
        y = np.dot(np.linalg.cholesky(cov), z) / np.sqrt(dim)

        for i in range(10):
            x_new = mu + sigma * y
            x_new = np.clip(x_new, lb, ub)

            f_new = func(x_new)
            n_evals += 1

            if f_new < func(mu):
                mu = x_new
                cov = (1 - 2 / (n_evals + 10)) * cov + (1 / (n_evals + 10)) * np.outer(y, y)

        y_cg = np.zeros(dim)
        r = mu

        for i in range(100):
            grad = np.zeros(dim)
            x = r
            x = np.clip(x, lb, ub)
            f_x = func(x)

            for j in range(dim):
                eps = 1e-6 * (ub - lb) / 2.0
                dx = eps * np.eye(dim)[j]
                x_plus_dx = x + dx

                grad[j] = (func(x_plus_dx) - f_x) / eps

            Ap = np.dot(cov, y_cg)

            if i == 0 or np.linalg.norm(grad - np.dot(Ap, r)) < 1e-6:
                break

            alpha = 1.0
            x_new = r + alpha * grad
            x_new = np.clip(x_new, lb, ub)
            f_new = func(x_new)

            n_evals += 1

            if f_new < func(r):
                mu = x_new
                cov = (1 - 2 / (n_evals + 10)) * cov + (1 / (n_evals + 10)) * np.outer(y_cg, y_cg)
                r = x_new
                Ap = np.dot(cov, y_cg)

            else:
                alpha /= 2.0

        sigma *= 1 - 2 / (n_evals + 100)

    return mu
