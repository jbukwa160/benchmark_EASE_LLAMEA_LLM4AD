def algorithm(func, dim, lb, ub, budget, rng):
    n = int(budget / 100)
    
    x_best = np.random.uniform(lb, ub, (1, dim))
    f_best = func(x_best[0])
    
    population_size = 10
    pop = np.empty((population_size, dim), dtype=np.float32)
    for i in range(population_size):
        pop[i] = np.random.uniform(lb, ub, (1, dim))[0]
        
    for _ in range(n):
        pop_next = np.zeros_like(pop)
        
        for i in range(population_size):
            y_best = x_best.copy()
            for j in range(dim):
                rand_idx = rng.randint(0, population_size - 1)
                if rng.random() < 0.5:
                    if rng.uniform(0, 1) > 0.1 + (i / population_size):
                        pop_next[i, j] = np.clip(pop[rand_idx, j] + 
                                                rng.uniform(-1, 1) * (pop[rand_idx, j] - x_best[0, j]), lb, ub)
                else:
                    pop_next[i, j] = pop[i, j]
                    
            if func(pop_next[i]) < f_best:
                y_best = pop_next[i]
                f_best = func(y_best)
                
        for i in range(population_size):
            z = np.zeros((1, dim))
            for j in range(dim):
                p = rng.uniform(0, 1)
                if p < 0.05 + (i / population_size):
                    q = np.random.choice(range(population_size), size=3, replace=False)
                    z[0, j] = np.clip(np.mean([pop[q[0], j], pop[q[1], j], pop[q[2], j]]), lb, ub)
                else:
                    z[0, j] = pop[i, j]
                    
            if func(z) < f_best:
                y_best = z
                f_best = func(y_best)
                
        x_best = y_best
        
    return np.array([x_best])
