def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for i in range(budget):
        x_new = np.clip(rng.normal(size=dim), a_min=lb, a_max=ub)
        f_new = func(x_new)

        if f_new < f_best:
            for j in range(10):  # perform gradient descent for 10 steps
                grad = np.zeros(dim)
                for k in range(dim):
                    x_try = np.copy(x_new)
                    x_try[k] += 1e-4
                    grad[k] = (func(x_try) - f_new) / 1e-4
                x_new -= 0.01 * grad  # gradient descent step
            x_best = x_new
            f_best = f_new

    return x_best
