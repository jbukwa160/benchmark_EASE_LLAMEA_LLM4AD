def algorithm(func, dim, lb, ub, budget, rng):
    n = 10 + int(np.ceil(1.4 * np.sqrt(dim)))
    mu = n / dim
    weights = np.log(n) - np.log(np.arange(n))
    weights /= weights.sum()
    sigma = 0.1
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)
    for _ in range(budget):
        z = rng.randn(n, dim)
        s2 = rng.uniform(0, 1, n)
        w = weights[s2 < mu] if np.any(s2 < mu) else weights
        x = x_best + sigma * (np.sqrt(w)[:, None] @ z.T).T
        x = np.clip(x, lb, ub)
        f_new = func(x)
        if f_new < f_best:
            f_best = f_new
            x_best = x.copy()
    return x_best
