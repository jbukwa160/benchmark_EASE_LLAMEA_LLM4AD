def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    x = rng.uniform(lb, ub, size=(1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        v = x + 0.5 * rng.normal(size=x.shape) * (best_x - x)
        v = clip(v)
        
        f = func(v)
        
        if f < best_f:
            best_x = v.copy()
            best_f = f
            
        x = x + rng.uniform(0, 1, size=(1, dim)) * (v - x)
        x = clip(x)
    
    return best_x
