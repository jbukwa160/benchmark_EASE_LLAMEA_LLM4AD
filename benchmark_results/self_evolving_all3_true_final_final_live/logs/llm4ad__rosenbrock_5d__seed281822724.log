def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 10
    def generate_candidates(pop_size, rng):
        return np.array([rng.uniform(lb, ub, size=dim) for _ in range(pop_size)])

    def mutate(candidates):
        new_candidates = candidates.copy()
        indices = np.random.choice(dim*pop_size, int(0.2*dim*pop_size), replace=False)
        new_candidates[indices] += rng.normal(size=len(indices))*0.1
        return np.clip(new_candidates, lb, ub)

    def select_best(candidates):
        fitnesses = [func(candidate) for candidate in candidates]
        best_idx = np.argmin(fitnesses)
        return candidates[best_idx], fitnesses[best_idx]

    population = generate_candidates(pop_size, rng)
    for _ in range(budget):
        new_population = mutate(population)
        population, _ = select_best(new_population)

    return population
