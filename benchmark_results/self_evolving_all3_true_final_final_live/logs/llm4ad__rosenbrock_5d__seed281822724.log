def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def objective(x):
        return func(x)

    pop_size = 50
    x0 = rng.uniform(lb, ub, size=(pop_size, dim))
    best_x = x0.copy()
    best_y = float('inf')

    for _ in range(budget):
        # Differential Evolution step
        for i in range(pop_size):
            mutation_idx = rng.choice(pop_size, size=dim, replace=False)
            trial_x = clip(x0[mutation_idx] + 0.1 * (x0[mutation_idx] - x0[rng.choice(pop_size)]))
            if objective(trial_x) < objective(best_x[i]):
                best_x[i] = trial_x
        # Simulated Annealing step
        alpha = 0.99
        for i in range(pop_size):
            trial_x = clip(np.array(best_x[i]) + rng.uniform(-1, 1, size=dim))
            if objective(trial_x) < objective(best_x[i]):
                best_x[i] = trial_x
            else:
                delta_y = objective(best_x[i]) - objective(trial_x)
                if np.random.rand() < np.exp(delta_y):
                    best_x[i] = trial_x

        # Update best solution
        y = min([objective(x) for x in best_x])
        if y < best_y:
            best_y = y
            best_x[np.argmin([objective(x) for x in best_x])] = rng.uniform(lb, ub, size=dim)

    return best_x[np.argmin([objective(x) for x in best_x])]
