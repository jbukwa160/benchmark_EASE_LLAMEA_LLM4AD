def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(xbest, sigma, t):
        return xbest + sigma * np.dot(np.random.randn(dim), np.eye(dim)[:, t % dim])

    def cma_es(xbest, sigma, budget):
        for _ in range(budget // 2):
            candidate = generate_candidate(xbest, sigma, rng.randint(0, int(1e6)))
            candidate = np.clip(candidate, lb, ub)
            if func(candidate) < func(xbest):
                xbest = candidate
                sigma *= 0.9
        return xbest

    def de(xbest, pop_size, sigma, budget):
        for _ in range(budget // 2):
            candidates = [generate_candidate(xbest, sigma, rng.randint(0, int(1e6)))] * (pop_size - 1)
            candidates = np.clip(candidates, lb, ub)
            candidates = np.array([func(candidate) if func(candidate) < func(xbest) else xbest for candidate in candidates])
            if len(set(candidates[:, None] == candidates).sum(axis=0)) > 1:
                xbest = np.mean(candidates[np.random.choice(range(pop_size), size=2, replace=False)], axis=0)
        return xbest

    pop_size = int(budget ** (1/3))
    sigma = 10.0
    xbest = np.array([ub + rng.uniform(0, 1) * (lb - ub) for _ in range(dim)])

    for t in range(int(budget)):
        if t % 5 == 0:
            xbest = cma_es(xbest, sigma, int(budget / 10))
        else:
            xbest = de(xbest, pop_size, sigma, budget)
    return np.clip(xbest, lb, ub)
