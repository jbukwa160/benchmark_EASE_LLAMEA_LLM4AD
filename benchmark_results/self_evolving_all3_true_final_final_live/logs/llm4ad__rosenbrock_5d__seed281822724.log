def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 1.0
    mu = rng.uniform(lb, ub, size=dim)
    step_size = 0.5
    lambda_ = 10
    cov = np.eye(dim)

    best_x = mu.copy()
    best_f = func(mu)

    for i in range(budget):
        if rng.rand() < 0.1:
            sigma *= (1 + 0.2 * rng.randn())
        else:
            sigma *= (1 - 0.05 * rng.randn())

        z = np.random.randn(dim)
        x = mu + step_size * sigma * z
        x = np.clip(x, lb, ub)

        f = func(x)

        if f < best_f:
            best_x = x.copy()
            best_f = f

        y = (x - mu) / sigma
        cov_new = (lambda_ - 1) / lambda_ * cov + 1 / lambda_ * y[:, None] @ y[None, :]
        cov = 0.5 * (cov + cov_new)

    return best_x
