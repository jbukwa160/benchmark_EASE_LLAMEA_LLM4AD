def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(budget):
        if i == 0:
            # initial exploration
            step_size = (ub - lb) / 2.0
            x_new = np.clip(x + rng.normal(0, step_size, size=(dim,)), lb, ub)
            f_new = func(x_new)
            if f_new < best_f:
                best_x = x_new.copy()
                best_f = f_new
        
        # exploitation phase
        grad = np.zeros((dim,))
        for j in range(dim):
            eps = 1e-3 * (ub - lb) / 2.0
            x_try = x.copy()
            x_try[j] += eps
            x_try = np.clip(x_try, lb, ub)
            f_try1 = func(x_try)
            
            x_try = x.copy()
            x_try[j] -= eps
            x_try = np.clip(x_try, lb, ub)
            f_try2 = func(x_try)
            
            grad[j] = (f_try1 - 2 * f_try2) / (2 * eps)
        
        # update step
        step_size = 0.01 * (ub - lb)
        x += step_size * np.clip(grad, -step_size, step_size)
        x = np.clip(x, lb, ub)
        
        # update best solution
        f_new = func(x)
        if f_new < best_f:
            best_x = x.copy()
            best_f = f_new
    
    return best_x
