def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = clip(x)
    best_f = func(clip(x))

    for _ in range(budget - 1):
        sigma = 0.5 * (ub - lb) / np.sqrt(np.log(_ + 2))
        noise = rng.normal(size=dim) * sigma
        candidate = clip(best_x + noise)

        f_candidate = func(candidate)
        if f_candidate < best_f:
            best_f = f_candidate
            best_x = candidate

    return best_x
