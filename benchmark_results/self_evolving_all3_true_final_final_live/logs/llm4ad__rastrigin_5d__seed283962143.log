def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_x = np.zeros(dim)
    best_f = float('inf')
    iters_without_improvement = 0
    max_iters_without_improvement = int(budget * 0.1)
    
    for i in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        f = func(x)
        
        if f < best_f:
            iters_without_improvement = 0
            best_x = x
            best_f = f
        
        elif np.random.rand() < 0.1 and iters_without_improvement < max_iters_without_improvement:
            x = clip(rng.uniform(lb, ub, size=dim) + rng.normal(best_x, scale=0.5))
            f = func(x)
            
            if f < best_f:
                iters_without_improvement = 0
                best_x = x
                best_f = f
        
        iters_without_improvement += 1
    
    return clip(best_x)
