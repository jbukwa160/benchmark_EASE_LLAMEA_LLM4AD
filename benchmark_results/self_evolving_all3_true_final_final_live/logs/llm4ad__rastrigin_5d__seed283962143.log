def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    population_size = 50
    initial_population = np.random.uniform(lb, ub, (population_size, dim))
    
    temperature = 1.0
    cooling_rate = 0.99
    
    for _ in range(budget // 2):
        X = clip(initial_population)
        Y = func(X)
        
        new_population = initial_population.copy()
        for i in range(population_size):
            r1, r2, r3 = rng.choice(population_size, 3, replace=False)
            v = clip(new_population[r1] + 0.5*(new_population[r2] - new_population[r3]))
            new_population[i] = X[rng.randint(0, population_size)] if np.random.rand() < 0.8 else v
        initial_population = new_population
        
        Y_new = func(initial_population)
        
        for i in range(population_size):
            if rng.uniform(0, 1) < np.exp((Y[i] - Y_new[i]) / temperature):
                initial_population[i] = new_population[i]
        
        temperature *= cooling_rate
    
    return clip(initial_population[rng.randint(0, population_size)])
