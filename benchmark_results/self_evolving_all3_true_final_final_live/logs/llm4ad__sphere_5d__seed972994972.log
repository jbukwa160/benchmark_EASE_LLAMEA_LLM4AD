def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    best_candidate = np.zeros(dim)
    best_fitness = float('inf')
    current_candidate = np.array(rng.uniform(lb, ub, size=dim))
    
    for _ in range(budget):
        new_candidate = clip(current_candidate + rng.normal(size=current_candidate.shape) * 0.5)
        new_fitness = func(new_candidate)

        if new_fitness < best_fitness:
            best_candidate = new_candidate
            best_fitness = new_fitness

        if np.random.rand() < 0.01: # random restart every 1% of the budget
            current_candidate = np.array(rng.uniform(lb, ub, size=dim))
        
        else:
            current_candidate = clip(best_candidate + rng.normal(size=current_candidate.shape) * 0.5)
            if np.random.rand() < 0.2: # adapt cooling schedule with a 20% probability
                current_candidate += rng.normal(size=current_candidate.shape) * 0.1

    return best_candidate
