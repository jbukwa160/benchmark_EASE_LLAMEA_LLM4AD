def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(bound(x))
    
    for i in range(1, budget+1):
        # Differential Evolution (DE)
        v = bound(best_x + rng.normal(size=dim, loc=0, scale=1))
        
        # Simulated Annealing (SA) - schedule
        T = 100. / np.log(i + 2)
        
        if rng.uniform(0, 1) < np.exp(-(func(bound(v)) - best_f) / T):
            x = v.copy()
            best_x = x.copy()
            best_f = func(bound(x))
    
    return bound(best_x)
