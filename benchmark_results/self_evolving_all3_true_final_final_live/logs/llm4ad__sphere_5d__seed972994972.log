def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_particles(num_particles, dim):
        particles = rng.uniform(-5.0, 5.0, (num_particles, dim))
        velocities = rng.uniform(-1.0, 1.0, (num_particles, dim))
        return particles, velocities

    num_particles = 100
    num_iterations = budget // num_particles
    num_restarts = 10

    best_particle = np.zeros(dim)
    best_fitness = float('inf')

    for _ in range(num_restarts):
        particles, velocities = generate_initial_particles(num_particles, dim)

        for i in range(num_iterations):
            fitnesses = func(clip(particles))
            best_particle_local = np.argmin(fitnesses)
            if fitnesses[best_particle_local] < best_fitness:
                best_particle = clip(particles[best_particle_local])
                best_fitness = fitnesses[best_particle_local]

            for j in range(num_particles):
                velocities[j] = 0.7298 * velocities[j] + rng.uniform(-4, 4) + \
                    rng.uniform(0, 1) * (best_particle - particles[j]) + \
                    rng.uniform(0, 1) * (particles[best_particle_local] - particles[j])
                particles[j] += velocities[j]

        if best_fitness < float('inf'):
            return clip(best_particle)

    return clip(best_particle)
