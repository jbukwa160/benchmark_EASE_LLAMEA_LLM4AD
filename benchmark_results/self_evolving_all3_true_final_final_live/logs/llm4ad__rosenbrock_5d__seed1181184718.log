def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)
    for _ in range(budget):
        learning_rate = 0.01 / (_ + 1) ** 0.5
        g = np.zeros(dim)
        for i in range(dim):
            grad_i = (func(np.roll(x, -1, axis=1)) - best_f) * (2 * x[0, i] - 2 * x[0, i**2]) if i < dim-1 else func(x) * (2 * x[0, i] - 2 * x[0, i**2])
            g[i] = grad_i
        x -= learning_rate * g
        x = np.clip(x, lb, ub)
        f = func(x)
        if f < best_f:
            best_x = x.copy()
            best_f = f
    return best_x
