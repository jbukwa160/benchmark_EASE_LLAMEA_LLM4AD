def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)
    
    T = 1000.0
    alpha = 1e-6
    
    for i in range(budget):
        r = np.random.normal(0, 5, size=dim) / (i + 2)**0.25
        x_new = x_best + alpha * r
        
        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        
        if f_new < f_best:
            x_best = x_new
            f_best = f_new
            
        T -= 0.001 * (T - 100) / budget
        
        # Probabilistic restart strategy
        if rng.uniform(0, 1) > np.exp((f_new - f_best) / T):
            x_best = np.random.uniform(lb, ub, size=dim)
            f_best = func(x_best)
    
    return x_best
