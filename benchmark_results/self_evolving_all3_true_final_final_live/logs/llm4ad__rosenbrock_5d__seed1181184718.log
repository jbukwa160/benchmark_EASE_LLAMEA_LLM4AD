def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    ngen = budget
    N = 50
    ncands = int(ngen * (D + 1))
    
    x = np.random.uniform(lb, ub, (N, D)).astype(np.float64)
    sigma = 0.5
    best_x = None
    best_fval = np.inf
    
    for gen in range(ngen):
        if best_x is not None:
            fvals = func(x)
            x[np.argsort(fvals)] = x[np.argsort(fvals)][::-1]
            
            for i in range(N):
                x[i] += rng.normal(0, sigma, D)
                x[i] = np.clip(x[i], lb, ub)
                
                if rng.random() < 1 / (gen + 1) and not np.isinf(func(x[i])):
                    fval = func(x[i])
                    if fval < best_fval:
                        best_x = x[i].copy()
                        best_fval = fval
        else:
            fvals = func(x)
            
            for i in range(N):
                if rng.random() < 1 / (gen + 1) and not np.isinf(func(x[i])):
                    fval = func(x[i])
                    if fval < best_fval:
                        best_x = x[i].copy()
                        best_fval = fval
        
        cov = np.cov(x.T)
        mean = np.mean(x, axis=0)
        
        for i in range(N):
            z = rng.normal(0, 1, D)
            y = mean + cov @ z
            y = np.clip(y, lb, ub)
            
            if not np.isinf(func(y)):
                fval = func(y)
                if fval < best_fval:
                    x[i] = y.copy()
        
        sigma *= 0.9
        
    return best_x
