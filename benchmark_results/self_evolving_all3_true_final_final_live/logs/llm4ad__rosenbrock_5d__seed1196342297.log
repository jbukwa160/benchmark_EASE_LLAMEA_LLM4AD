def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.minimum(np.maximum(x, lb), ub)

    D = dim
    N = int(budget / (D + 1))  # Number of iterations
    pop_size = 20 * D
    mu = 0.5
    sigma = 1
    CR = 0.3

    x_best = np.random.uniform(lb, ub, size=(pop_size, D))
    f_best = np.array([func(x) for x in x_best])

    for n in range(N):
        for i in range(pop_size):
            u_i = rng.uniform(0, pop_size - 1)
            while u_i == i:
                u_i = rng.uniform(0, pop_size - 1)

            u_j = rng.uniform(0, pop_size - 1)
            while u_j == i or u_j == u_i:
                u_j = rng.uniform(0, pop_size - 1)

            x_tmp = clip(x_best[i] + mu * (x_best[u_i] - x_best[u_j]), lb, ub)
            f_tmp = func(x_tmp)

            if f_tmp < f_best[i]:
                x_best[i] = x_tmp
                f_best[i] = f_tmp

        for i in range(pop_size):
            c1 = rng.uniform(0, 1)
            c2 = rng.uniform(0, 1)
            x_mut = clip(x_best[i] + sigma * (x_best[u_i] - x_best[c1]), lb, ub)

            if func(x_mut) < CR * f_best[i] + (1 - CR) * func(x_best[c2]):
                x_best[i] = x_mut
                f_best[i] = func(x_mut)

    return x_best[np.argmin(f_best)]
