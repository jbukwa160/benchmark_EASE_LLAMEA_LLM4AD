def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    learning_rate = 0.01
    sigma = 0.1
    temperature = 100.0

    for _ in range(budget):
        delta = rng.normal(size=dim) * sigma
        x_new = x_best + delta

        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        if f_new < f_best:
            x_best = x_new
            f_best = f_new

        # Adaptive learning rate and temperature schedule
        sigma *= 0.99
        learning_rate *= 0.9995
        temperature -= 1

    return x_best
