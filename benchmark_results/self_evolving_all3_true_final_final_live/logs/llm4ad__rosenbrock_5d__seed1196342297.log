def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        for i in range(dim):
            x_ = x.copy()
            z = rng.normal(size=(1, 1)) * 0.1
            x_[..., i] += z
            
            f = func(clip(x_))
            if f < best_f:
                best_x = x_.copy()
                best_f = f
        
        # adaptive mutation strategy
        alpha = np.exp(-i/budget)
        for j in range(dim):
            z = rng.normal(size=(1, 1)) * (ub - lb) * alpha
            x[..., j] += z
            
            f = func(clip(x))
            if f < best_f:
                best_x = x.copy()
                best_f = f
                
    return clip(best_x)
