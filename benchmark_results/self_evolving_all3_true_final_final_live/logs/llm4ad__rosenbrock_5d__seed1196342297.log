def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        e = rng.normal(size=dim)
        step_size = 0.1 * np.linalg.norm(e) / dim
        new_x = x + step_size * e

        # Clip to bounds
        new_x = np.clip(new_x, lb, ub)

        new_f = func(new_x)
        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f

        # Acceptance probability
        beta = 1.0 - (best_f - new_f) / (func(x + step_size * e) - func(x))
        if rng.uniform() < np.exp(beta):
            x = new_x.copy()

    return best_x
