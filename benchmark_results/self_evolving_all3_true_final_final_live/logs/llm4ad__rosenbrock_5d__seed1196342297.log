def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        y = x + 0.1 * (ub - lb) * rng.randn(dim,)
        z = clip(y)
        
        f_y = func(z)
        f_z = func(clip(x + 0.1 * (z - x)))
        
        if f_z < f_y:
            x, y = y, x
            best_x, best_f = x.copy(), func(x)
        elif f_z < best_f:
            best_x, best_f = z.copy(), func(z)
    
    return best_x
