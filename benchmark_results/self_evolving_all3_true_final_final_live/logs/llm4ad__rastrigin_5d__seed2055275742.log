def algorithm(func, dim, lb, ub, budget, rng):
    def generate_individual():
        return rng.uniform(lb, ub, size=dim)

    def evaluate(individual):
        return func(individual)

    population_size = 100
    max_iter = budget // population_size

    best_solution = None
    for _ in range(max_iter):
        population = [generate_individual() for _ in range(population_size)]
        scores = np.array([evaluate(individual) for individual in population])

        idx_sorted = np.argsort(scores)
        top_scores = scores[idx_sorted]
        top_solutions = population[idx_sorted]

        new_population = []
        for i in range(population_size // 2):
            parent1, parent2 = rng.choice(top_solutions[:int(0.8 * population_size)], size=2, replace=False)
            child = (parent1 + parent2) / 2
            new_population.append(child)
            new_population.append(parent1)

        # Local search for top individuals
        for i in range(int(0.8 * population_size)):
            individual = top_solutions[i]
            candidate = np.clip(individual + rng.normal(size=dim, loc=0, scale=0.5), lb, ub)
            score_candidate = evaluate(candidate)

            if score_candidate < top_scores[i]:
                new_population.append(candidate)
                top_scores[i] = score_candidate

        population = new_population
        scores = np.array([evaluate(individual) for individual in population])

        idx_sorted = np.argsort(scores)
        top_solutions = population[idx_sorted]

        # Update best solution
        if top_scores[0] < evaluate(top_solutions[0]):
            best_solution = top_solutions[0]
        else:
            best_solution = top_solutions[0]

    return np.array(best_solution)
