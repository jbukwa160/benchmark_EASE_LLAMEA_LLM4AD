    pop_size = 20 * dim
    max_iter = int(budget / (pop_size * 10))
    sigma0 = 1.0
    rho_cma = 0.5

    x_best = np.zeros(dim)
    f_best = float('inf')

    for i in range(max_iter):
        if rng.random() < 0.1:
            # CMA-ES
            pop = clip(rng.randn(pop_size, dim) * sigma0 + x_best)
            f_pop = func(pop)

            n_scores = np.argsort(f_pop)[:int(0.2 * pop_size)]
            pop[n_scores] = x_best

            score_mean, score_var = np.mean(f_pop[n_scores]), np.var(f_pop[n_scores])
            if score_mean < f_best:
                x_best, f_best = pop[np.argmin(f_pop)], min(f_pop)

        else:
            # Differential Evolution
