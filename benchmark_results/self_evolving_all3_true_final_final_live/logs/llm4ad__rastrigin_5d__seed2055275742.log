def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    best_x = np.zeros(dim)
    best_f = float('inf')
    n_restart = 10
    cma_best_f = [float('inf')] * n_restart

    for i in range(n_restart):
        pop_size = int(budget / n_restart)
        mu = rng.uniform(size=pop_size)
        sigma = 1.0
        cma_count = 0
        while True:
            for j in range(pop_size):
                x = mu + rng.normal(size=dim) * sigma
                f = evaluate(x)
                if f < best_f:
                    best_x, best_f = x, f

            if best_f < cma_best_f[i]:
                cma_best_f[i] = best_f
            else:
                break

            c = 1 / (cma_count + 1)
            sigma_new = sigma * np.exp(c * rng.uniform(-1, 1))
            mu_new = mu + rng.normal(size=dim) * sigma_new**2
            mu = mu * (1 - c) + mu_new * c

            cma_count += 1
            if cma_count > budget:
                break

    return best_x
