def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 20
    max_iter = int(budget / (pop_size * dim))
    current_best = np.zeros(dim)
    for _ in range(max_iter):
        population = np.random.uniform(lb, ub, size=(pop_size, dim))
        for i in range(pop_size):
            x = population[i]
            if func(x) < func(current_best):
                current_best = x
        for i in range(pop_size):
            x = population[i] + 0.1 * rng.normal(size=dim)
            x = np.clip(x, lb, ub)
            population[i] = x
    return current_best
