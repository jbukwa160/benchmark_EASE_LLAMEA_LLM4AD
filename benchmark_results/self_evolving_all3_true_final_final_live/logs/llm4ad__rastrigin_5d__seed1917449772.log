def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)
    candidate_count = 0
    temperature = 1.0

    for _ in range(budget):
        for i in range(dim):
            v = clip(rng.normal(loc=x_best[i], scale=0.1, size=1))
            x = x_best.copy()
            x[i] = v
            f = func(x)
            candidate_count += 1

            if f < f_best:
                f_best = f
                x_best = x

        u = rng.uniform(0, 1, size=dim)
        for i in range(dim):
            v = clip(rng.normal(loc=x_best[i], scale=temperature, size=1))
            x = x_best.copy()
            x[i] = v
            f = func(x)

            if f < f_best:
                f_best = f
                x_best = x

        temperature *= 0.99  # annealing schedule
        candidate_count = 0

    return x_best
