def algorithm(func, dim, lb, ub, budget, rng):
    N = 50
    D = np.array([np.random.uniform(lb, ub) for _ in range(dim)])
    T = 1000
    alpha = 0.9
    beta = 1e-6
    best = D.copy()
    
    for t in range(budget):
        for i in range(N):
            C = D.copy()
            np.random.shuffle(C)
            
            V = lb + (ub - lb) * rng.uniform(0, 1, dim)
            F = 0.5
            
            for j in range(dim):
                V[j] += F * (C[j] - D[j])
                
            if func(V) < func(best):
                best = V.copy()
        
        if t % T == 0:
            r = np.exp(-t / T)
            for i in range(N):
                C = D.copy()
                np.random.shuffle(C)
                V = lb + (ub - lb) * rng.uniform(0, 1, dim)
                
                if func(V) < func(best) or np.random.rand() < r:
                    best = V.copy()
                    
        D += rng.normal(0, 1e-2, dim) / N
        for i in range(dim):
            if lb <= D[i] + 1e-3 <= ub:
                D[i] += np.sign(D[i] - best[i]) * alpha * (D[i] - best[i])**beta
                
    return best
