def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x), x

    best_x = np.zeros(dim)
    best_f = float('inf')
    pop_size = 5
    sigma = 1.0
    mu = rng.uniform(lb, ub, size=(pop_size, dim))
    iteration = 0

    while iteration < budget:
        iteration += 1
        f, x = evaluate(mu)
        if f < best_f:
            best_f = f
            best_x = x

        cov = np.cov(mu.T) + 1e-8 * np.eye(dim)
        sigma *= np.sqrt(np.linalg.det(cov))
        cov_inv = np.linalg.inv(cov)

        for i in range(pop_size):
            z = rng.multivariate_normal(np.zeros(dim), cov_inv, size=(pop_size,))
            new_x = mu[i] + sigma * z
            f, _ = evaluate(new_x)
            if f < best_f:
                mu[i] = new_x

        # Adaptive population size
        if iteration % 10 == 0:
            pop_size = int(np.sqrt(pop_size) * np.exp(0.01 * iteration))

    return best_x
