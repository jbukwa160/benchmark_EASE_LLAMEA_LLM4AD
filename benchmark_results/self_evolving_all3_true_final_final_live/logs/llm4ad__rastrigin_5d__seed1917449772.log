def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(mean, sigma):
        noise = (rng.rand(dim) * 2 - 1) * sigma
        candidate = mean + noise
        return clip(candidate)

    def evaluate_candidate(candidate):
        return func(candidate)

    mean = rng.uniform(lb, ub, size=dim)
    sigma = np.finfo(float).eps

    for i in range(budget):
        candidate = generate_candidate(mean, sigma)
        value = evaluate_candidate(candidate)

        if value < evaluate_candidate(mean):
            mean = candidate
            sigma *= 1.001 + rng.uniform(-0.01, 0.01)
        else:
            sigma /= 1.001 + rng.uniform(-0.01, 0.01)

    return mean
