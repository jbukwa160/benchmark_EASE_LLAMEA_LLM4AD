def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for i in range(budget):
        temp = 1.0 / (i + 1)  # Cooling schedule
        sigma = rng.uniform(0.1, 1.0) * np.ones(dim)  # Random step size

        x_candidate = clip(x_best + sigma * rng.normal(size=dim))
        f_candidate = func(x_candidate)

        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate

        else:
            prob = np.exp((f_best - f_candidate) / temp)
            if rng.uniform(0, 1) < prob:
                x_best = x_candidate
                f_best = f_candidate

    return x_best
