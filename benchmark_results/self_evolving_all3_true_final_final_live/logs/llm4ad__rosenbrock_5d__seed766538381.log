def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    T = 10.0 * (ub - lb)
    for i in range(budget):
        f_x = func(x)
        y = x.copy()
        for j in range(dim):
            noise = rng.normal(0, 1e-2, size=dim)
            y[j] += noise
            y[j] = clip(y[j])
            f_y = func(y)
            if f_y < f_x:
                x = y
                f_x = f_y
        if T > 1e-6 and rng.uniform(0, 1) < np.exp((f_x - func(x)) / T):
            x = clip(x + rng.normal(0, 0.1, size=dim))
        else:
            T *= 0.99
    return x
