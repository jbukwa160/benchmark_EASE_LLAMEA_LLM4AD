def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        sigma = (ub - lb) / 2.0
        new_x = rng.normal(loc=x, scale=sigma, size=(1, dim)).flatten()
        new_x = np.clip(new_x, lb, ub)
        
        if func(new_x) < best_f:
            best_x = new_x.copy()
            best_f = func(new_x)

        x = rng.choice([x, best_x], p=[0.9, 0.1])
        x = np.clip(x, lb, ub)

    return best_x
