def algorithm(func, dim, lb, ub, budget, rng):
    def cma_de(x_best, y_best, sigma, pop_size, dim):
        x = np.random.normal(size=(pop_size, dim), loc=y_best, scale=sigma)
        for _ in range(budget):
            f_x = func(x)
            y = x[np.argmin(f_x)]
            if np.min(f_x) < func(y_best):
                y_best = y
                sigma *= 1.01
            else:
                sigma /= 1.01
            idx = rng.choice(pop_size, size=pop_size-1, replace=False)
            x[idx] = np.random.normal(size=(pop_size-1, dim), loc=y_best, scale=sigma)
        return y_best

    def init_pop(dim):
        return np.clip(rng.uniform(lb, ub, size=(100, dim)), lb, ub)

    pop = init_pop(dim)
    best = cma_de(np.mean(pop, axis=0), np.mean(pop, axis=0), 1.5, 30, dim)
    return np.clip(best, lb, ub)
