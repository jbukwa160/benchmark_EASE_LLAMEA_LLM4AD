def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget - 1):
        y = x + 0.5 * rng.truncated('norm', loc=0, scale=1).sample((1, dim))
        y = np.clip(y, lb, ub)
        
        f = func(y)
        
        if f < best_f:
            best_x = y.copy()
            best_f = f
            
        if _ % 10 == 0:  # every 10 iterations
            delta = 0.1 * rng.truncated('norm', loc=0, scale=1).sample((1, dim))
            x += delta
            x = np.clip(x, lb, ub)
            
    return best_x
