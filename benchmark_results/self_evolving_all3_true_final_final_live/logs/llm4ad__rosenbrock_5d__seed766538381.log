def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(budget):
        population = rng.uniform(lb, ub, (budget, dim))
        for i in range(1, len(population)):
            mutation = rng.normal(size=dim)
            population[i] += 0.01 * mutation
        return population

    def evaluate_candidates(candidates):
        scores = func(candidates)
        return np.array(scores)

    def simulated_annealing(population, func, dim, lb, ub, budget):
        best_solution = population[0]
        T = 1e5
        cooling_rate = 0.99
        for _ in range(budget):
            solution = rng.choice(population)
            score = func(solution)
            new_score = score + rng.uniform(-T, T)
            if new_score < score:
                solution += (solution - best_solution) * (new_score - score) / np.abs(new_score - score)
            elif np.random.rand() < np.exp((score - new_score) / T):
                solution += (solution - best_solution) * (new_score - score) / np.abs(new_score - score)
            if func(solution) < func(best_solution):
                best_solution = solution
            population[0] = clip(best_solution)
        return best_solution

    def gradient_descent(population, func, dim, lb, ub, budget):
        best_solution = population[0]
        learning_rate = 1e-3
        for _ in range(budget):
            gradient = np.zeros(dim)
            for i in range(1, len(population)):
                solution = population[i]
                score = func(solution)
                gradient += (solution - best_solution) * (score - func(best_solution))
            gradient /= len(population) - 1
            new_solution = clip(best_solution + learning_rate * gradient)
            if func(new_solution) < func(best_solution):
                best_solution = new_solution
            population[0] = best_solution
        return best_solution

    population = generate_initial_population(budget)
    score_population = evaluate_candidates(population)

    for _ in range(10):  # Run SA for 10 iterations
        solution = simulated_annealing(population, func, dim, lb, ub, budget // 10)
        population[0] = clip(solution)

    return clip(population[0])
