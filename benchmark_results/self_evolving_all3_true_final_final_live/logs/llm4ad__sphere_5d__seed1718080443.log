def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    T = 1e3
    alpha = 0.99
    gamma = 1e-4
    for _ in range(budget):
        T *= alpha
        y = x + (ub - lb) * rng.rand(dim)
        y = np.clip(y, lb, ub)
        d = func(y) - func(x)
        if d < 0 or rng.rand() < np.exp(-d / (T * gamma)):
            x = y
    return x
