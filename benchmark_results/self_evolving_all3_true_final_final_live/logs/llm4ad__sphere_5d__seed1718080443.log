def algorithm(func, dim, lb, ub, budget, rng):
    best_x = rng.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for _ in range(budget):
        if _ % 100 == 0:
            grid_step = (ub - lb) / np.ceil(np.sqrt(_ + 1))
            for i in range(dim):
                x_grid_i = rng.uniform(lb, ub, size=_ // 100)
                x_grid = best_x.copy()
                x_grid[i] = x_grid_i
                f_grid = func(x_grid)
                if f_grid < best_f:
                    best_f = f_grid
                    best_x = x_grid

        grid_step = (ub - lb) / np.ceil(np.sqrt(_ + 1))
        for i in range(dim):
            x_rand_i = rng.uniform(lb, ub, size=_ // 100)
            x_rand = best_x.copy()
            x_rand[i] = x_rand_i
            f_rand = func(x_rand)
            if f_rand < best_f:
                best_f = f_rand
                best_x = x_rand

    return best_x
