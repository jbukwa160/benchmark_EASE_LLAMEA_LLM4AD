def algorithm(func, dim, lb, ub, budget, rng):
    num_samples = int(np.ceil(budget ** (1 / dim)))
    samples = []
    
    for i in range(num_samples):
        for j in range(num_samples):
            for k in range(num_samples):
                for l in range(num_samples):
                    for m in range(num_samples):
                        x = np.array([lb + rng.rand() * (ub - lb) for _ in range(dim)])
                        samples.append(x)
    
    samples = [np.clip(sample, a_min=lb, a_max=ub) for sample in samples]
    costs = [func(sample) for sample in samples]
    
    best_sample_idx = np.argmin(costs)
    best_sample = np.array(samples[best_sample_idx])
    
    return best_sample
