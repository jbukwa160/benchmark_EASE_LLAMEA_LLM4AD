def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def perturb(x):
        return x + rng.uniform(-1.0, 1.0, size=dim)

    population_size = int(1e4)
    initial_population = rng.uniform(lb, ub, size=(population_size, dim))
    temperature = 1000
    cooling_rate = 0.99

    for _ in range(budget):
        new_population = np.copy(initial_population)
        for i in range(population_size):
            new_individual = perturb(initial_population[i])
            if func(new_individual) < func(initial_population[i]):
                new_population[i] = new_individual
            else:
                delta = func(new_population[i]) - func(initial_population[i])
                if rng.uniform(0, 1) < np.exp(-delta / temperature):
                    new_population[i] = new_individual
        initial_population = clip(new_population)
        temperature *= cooling_rate

    best_individual = initial_population[np.argmin(func(initial_population))]
    return best_individual
