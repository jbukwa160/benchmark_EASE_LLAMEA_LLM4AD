def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        new_x = x + 0.1 * (ub - lb) * rng.normal(size=dim)
        new_x = np.clip(new_x, lb, ub)

        new_f = func(new_x)

        if new_f < best_f:
            best_f = new_f
            best_x = new_x

        alpha = 0.01 * (ub - lb)**2
        x += alpha * rng.normal(size=dim)
        x = np.clip(x, lb, ub)

    return best_x
