def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    x = np.random.uniform(lb, ub, size=dim)
    distribution = {'mu': 0, 'sigma': 1.0}
    archive = [x]
    for _ in range(budget):
        candidates = []
        for _ in range(4 * dim):
            new_x = np.clip(x + np.random.normal(size=x.shape) * distribution['sigma'] + distribution['mu'], lb, ub)
            candidates.append(new_x)
        candidates = np.array(candidates)
        candidates = clip(candidates)
        f_candidates = func(candidates)

        best_candidate_idx = np.argmin(f_candidates)
        new_best_x = candidates[best_candidate_idx]

        distribution['sigma'] *= 0.5 if np.mean(np.log(f_candidates)) > 10 else 1.2
        x = new_best_x

        archive.append(x)
    return clip(np.array(archive).mean(axis=0))
