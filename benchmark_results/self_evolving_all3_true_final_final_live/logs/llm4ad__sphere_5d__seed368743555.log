def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    x_best = np.random.uniform(lb, ub, size=(dim,))
    f_best = func(clip(x_best))
    temperature = 1.0

    for _ in range(budget):
        x_candidate = clip(x_best + rng.normal(size=(dim,), loc=0.0, scale=2.0))
        f_candidate = func(x_candidate)

        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate

        alpha = 1 - _ / budget
        temperature *= max(0.0001, 1 - alpha ** (1 + 10 * _ / budget))

        if rng.random() < np.exp((f_best - f_candidate) / temperature):
            x_best = x_candidate
            f_best = f_candidate

    return clip(x_best)
