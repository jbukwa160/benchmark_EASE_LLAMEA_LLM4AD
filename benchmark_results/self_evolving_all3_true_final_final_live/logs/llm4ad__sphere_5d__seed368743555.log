def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = np.zeros(dim)
    best_val = float('inf')
    
    for i in range(budget):
        new_sol = np.clip(rng.normal(loc=best_sol, scale=1.0, size=dim), a_min=lb, a_max=ub)
        
        val = func(new_sol)
        
        if val < best_val:
            best_sol = new_sol
            best_val = val
            
    return best_sol
