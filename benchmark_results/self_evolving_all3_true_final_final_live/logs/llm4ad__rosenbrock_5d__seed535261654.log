def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    x0 = rng.uniform(lb, ub, size=dim)
    x_best = clip(x0.copy())

    for _ in range(budget):
        # Differential Evolution step
        y = clip(x0 + rng.uniform(-1, 1, size=dim))

        # Simulated Annealing step (acceptance probability)
        p_accept = np.exp(-(func(y) - func(x_best)) / rng.uniform(0.01, 0.1))
        if rng.rand() < p_accept:
            x_best = clip(y.copy())

        # Differential Evolution step
        y = clip(x_best + rng.uniform(-1, 1, size=dim))

        # Simulated Annealing step (acceptance probability)
        p_accept = np.exp(-(func(y) - func(x_best)) / rng.uniform(0.01, 0.1))
        if rng.rand() < p_accept:
            x_best = clip(y.copy())

    return x_best
