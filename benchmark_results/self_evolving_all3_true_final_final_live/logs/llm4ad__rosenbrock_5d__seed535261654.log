def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    x_best = np.random.uniform(lb, ub, size=(dim,))
    f_best = evaluate(x_best)

    T = 100.0
    alpha = 0.9

    for i in range(budget):
        n = rng.choice(dim, size=4, replace=False)
        x_trial = x_best + alpha * (x_best[n] - x_best) / np.linalg.norm(x_best[n] - x_best)

        f_trial = evaluate(x_trial)

        if f_trial < f_best:
            x_best = x_trial
            f_best = f_trial

        if rng.rand() < np.exp((f_best - f_trial) / T):
            x_best = (x_best + x_trial) / 2.0

        T *= alpha

    return x_best
