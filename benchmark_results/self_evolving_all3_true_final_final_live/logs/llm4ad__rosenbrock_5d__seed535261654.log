def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Generate offspring
        x1 = x + 0.5 * rng.normal(size=dim)
        x2 = x - 0.5 * rng.normal(size=dim)
        
        f1 = func(clip(x1, lb, ub))
        f2 = func(clip(x2, lb, ub))

        # Update best solution
        if f1 < best_f:
            best_x = x1.copy()
            best_f = f1

        if f2 < best_f:
            best_x = x2.copy()
            best_f = f2

        # Adaptive gradient descent with learning rate adjustment
        x = (0.8 * x + 0.2 * rng.normal(size=dim)) / np.mean([np.exp(-best_f), 1])

    return clip(best_x, lb, ub)
