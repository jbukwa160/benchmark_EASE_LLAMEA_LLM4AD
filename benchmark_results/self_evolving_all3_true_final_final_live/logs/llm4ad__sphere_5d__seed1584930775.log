def algorithm(func, dim, lb, ub, budget, rng):
    best_x = -np.inf * np.ones(dim)
    best_f = np.inf
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
            
        # Generate a set of new candidate solutions by perturbing the current best solution
        candidates = np.clip(best_x + rng.uniform(-1, 1, size=(dim, budget // dim)), lb, ub)
        
        for cand in candidates:
            f = func(cand)
            
            if f < best_f:
                best_f = f
                best_x = cand
                
    return best_x
