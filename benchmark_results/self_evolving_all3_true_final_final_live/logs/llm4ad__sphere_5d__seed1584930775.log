def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf
    sigma = 1.0
    mu = 1.0 / (2 * dim)
    c_c = 1.0 + 2.0 / (dim + 1.0)
    c_1 = 0.5
    c_m = 2.0

    for _ in range(budget):
        z = np.random.randn(dim)
        x_new = rng.uniform(lb, ub, size=dim) + sigma * mu * z
        f_new = func(x_new)

        if f_new < x_best:
            x_best = f_new
            x_best_candidate = x_new

        sigma *= 1.0 + c_c / (dim + np.sqrt(2 * dim * np.log(rng.random())))
        mu += c_1 * (x_new - rng.uniform(lb, ub, size=dim)) / sigma**2
        sigma = np.maximum(sigma, 0.5)

    return x_best_candidate
