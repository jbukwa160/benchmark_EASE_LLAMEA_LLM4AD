def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_population(pop_size):
        return np.array([clip(rng.uniform(lb, ub, size=dim)) for _ in range(pop_size)])

    def evaluate_population(population):
        return [func(ind) for ind in population]

    def update_covariance(sigma, population, weights):
        mu = np.average(population, axis=0, weights=weights)
        cov = np.cov(population.T, aweights=weights)
        return sigma * (cov + np.eye(dim) * 1e-8)

    def adapt_strategy(cov, sigma):
        return cov / (np.linalg.norm(cov) + 1e-8), sigma

    population_size = int(budget ** 0.5)
    weights = np.array([1.0] * population_size)
    mean = np.zeros(dim)
    sigma = 10
    covariance = np.eye(dim)

    for _ in range(int(budget / population_size)):
        new_population = generate_population(population_size)
        fitnesses = evaluate_population(new_population)
        indices = np.argsort(fitnesses)[:int(0.1 * population_size)]
        weights = np.array([0.9 if i in indices else 0.1 for i in range(population_size)])
        mean += (np.array(new_population[indices]) - mean) / len(indices)
        covariance, sigma = adapt_strategy(covariance, sigma)

    return clip(mean)
