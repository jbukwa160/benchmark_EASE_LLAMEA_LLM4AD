def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_candidate = rng.uniform(lb, ub, size=dim)
        f_candidate = func(x_candidate)
        
        if f_candidate < f_best:
            f_best = f_candidate
            x_best = x_candidate

        # Local optimization phase using Gradient Descent (GD)
        for _ in range(dim):
            e = np.zeros_like(x_best)
            e[_] = 1.0
            step_size = rng.uniform(0.01, 0.1)

            x_new = x_best + step_size * e
            x_new = np.clip(x_new, lb, ub)

            if func(x_new) < f_best:
                f_best = func(x_new)
                x_best = x_new

    return x_best
