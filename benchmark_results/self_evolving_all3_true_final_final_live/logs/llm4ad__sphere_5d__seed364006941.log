def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def adaptive_lr(best_found):
        if best_found < 1e-6:
            return 0.001
        else:
            return 0.01 / (1 + np.sqrt(np.sum(func(clip(x)) for x in rng.uniform(lb, ub, (100, dim)))))

    best_candidate = np.zeros(dim)
    best_value = float('inf')
    learning_rate = adaptive_lr(best_candidate)

    for _ in range(budget):
        candidate = best_candidate + learning_rate * rng.normal(size=dim)
        candidate = clip(candidate)
        value = func(candidate)

        if value < best_value:
            best_candidate = candidate
            best_value = value

        learning_rate = adaptive_lr(best_candidate)

    return best_candidate
