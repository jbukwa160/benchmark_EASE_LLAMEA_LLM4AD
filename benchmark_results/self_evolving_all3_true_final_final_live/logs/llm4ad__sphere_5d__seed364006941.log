def algorithm(func, dim, lb, ub, budget, rng):
    num_cand = 1
    cand_dim = [0] * dim
    
    for i in range(budget):
        if num_cand < (i + 1) ** 2:
            num_cand = (i + 1) ** 2
        
        for _ in range(num_cand - len(cand_dim)):
            cand = rng.uniform(lb, ub, dim)
            cand_dim.append(cand)
        
        scores = np.array([func(c) for c in cand_dim])
        idx = np.argsort(scores)[:len(cand_dim)//2]
        cand_dim = [cand_dim[i] for i in idx]
        
    best_cand = min(cand_dim, key=func)
    
    return np.array(best_cand)
