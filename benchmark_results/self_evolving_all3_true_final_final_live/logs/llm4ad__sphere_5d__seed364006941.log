def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    mu = 1e-3 * (ub - lb)
    sigma = 0.5 * (ub - lb)
    N = 50
    M = int(budget / N)
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for m in range(M):
        x_candidates = np.clip(sigma * rng.randn(N, dim) + clip(mu * x_best), lb, ub)
        fs = [func(x) for x in x_candidates]
        idx = np.argmin(fs)
        if fs[idx] < f_best:
            x_best = x_candidates[idx]
            f_best = fs[idx]

    return x_best
