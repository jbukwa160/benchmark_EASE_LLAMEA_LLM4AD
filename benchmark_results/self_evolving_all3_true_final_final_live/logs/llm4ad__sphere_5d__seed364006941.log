def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        step_size = 1.0 / (np.sqrt(_ + 1) * np.sqrt(budget))
        dx = rng.uniform(-step_size, step_size, size=dim)
        x_new = x + dx
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new

        x = x_new

    return best_x
