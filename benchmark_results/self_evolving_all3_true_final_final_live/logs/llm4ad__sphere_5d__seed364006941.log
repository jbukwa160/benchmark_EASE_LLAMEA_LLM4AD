def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    current = (np.random.uniform(lb, ub, dim) if rng is None else rng.randint(ub-lb, size=dim)) + 0.5
    temperature = 1.0

    for _ in range(budget):
        trial = current + np.random.normal(size=dim)
        trial = clip(trial)

        delta = func(trial) - func(current)

        if delta < 0 or (np.random.rand() < np.exp(-delta/temperature)):
            current = trial
            temperature *= 0.999

    return current
