def algorithm(func, dim, lb, ub, budget, rng):
    def mutate(x, sigma):
        if rng.rand() < 0.1:
            return x + rng.randn(dim) * sigma
        else:
            return x

    def crossover(x1, x2):
        alpha = 0.5 * (x1 + x2)
        beta = 0.4 * (x2 - x1)
        if rng.rand() < 0.5:
            beta *= -1
        return alpha + beta

    sigma = 10 / np.sqrt(dim)

    x = lb + rng.uniform(size=dim) * (ub - lb)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        v = mutate(crossover(x, mutate(best_x, sigma)), sigma)
        v = np.clip(v, lb, ub)
        fv = func(v)
        if fv < best_f:
            best_f = fv
            best_x = v.copy()

    return best_x
