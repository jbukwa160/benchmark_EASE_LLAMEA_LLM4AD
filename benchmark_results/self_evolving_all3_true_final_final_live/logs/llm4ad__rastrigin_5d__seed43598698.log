def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    n_particles = 10
    n_iterations = budget // n_particles
    temperature = 1000.0
    cooling_rate = 0.99

    particles = rng.uniform(lb, ub, size=(n_particles, dim))
    fitness_values = [func(clip(particle)) for particle in particles]

    for iteration in range(n_iterations):
        for i in range(n_particles):
            # Differential Evolution step
            j, k, l = np.random.choice(range(n_particles), replace=False, size=3)
            mutant = clip(particles[j] + 0.5 * (particles[k] - particles[l]))
            fitness_mutant = func(clip(mutant))

            if fitness_mutant < fitness_values[i]:
                particles[i] = mutant
                fitness_values[i] = fitness_mutant

        # Simulated Annealing step
        for i in range(n_particles):
            j, k = np.random.choice(range(n_particles), replace=False, size=2)
            mutant = clip(particles[j] + temperature * (particles[k] - particles[i]))
            fitness_mutant = func(clip(mutant))

            if fitness_mutant < fitness_values[i]:
                particles[i] = mutant
                fitness_values[i] = fitness_mutant

        temperature *= cooling_rate

    best_particle_index = np.argmax(fitness_values)
    return clip(particles[best_particle_index])
