def algorithm(func, dim, lb, ub, budget, rng):
    x_best = 0.5 * (ub + lb) + rng.randn(dim)
    f_best = func(x_best)
    sigma = 1.0
    T = 10000.0
    alpha = 0.8

    for i in range(budget):
        x_candidate = x_best + np.random.normal(0, sigma, dim)
        x_candidate = np.clip(x_candidate, lb, ub)

        f_candidate = func(x_candidate)
        
        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate

        acceptance_rate = 1 - (f_candidate - f_best) / T

        if np.random.rand() > acceptance_rate:
            sigma *= alpha

    return x_best
