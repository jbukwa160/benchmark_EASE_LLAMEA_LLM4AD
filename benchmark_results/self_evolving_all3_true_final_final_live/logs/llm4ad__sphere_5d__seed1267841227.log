def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.uniform(size=dim) + lb
    best_x = x.copy()
    best_y = func(x)
    T = 1000.0
    alpha = 0.01
    
    for i in range(budget):
        y = func(x)
        
        if y < best_y:
            best_x = x.copy()
            best_y = y
        
        dx = np.clip(rng.normal(size=dim), -1, 1) * (ub - lb) / 10
        dy = func(x + dx) - y
        
        if dy <= 0 or rng.uniform() < np.exp(-dy/T):
            x += dx
            
        T *= max(0.99, 1 - i/budget)
        
        # GD step
        if i % 100 == 0 and T > 10:
            g = func(x + alpha * dx) - y
            while g <= 0 or rng.uniform() < np.exp(-g/T):
                x += alpha * dx
                g = func(x + alpha * dx) - y
    
    return best_x
