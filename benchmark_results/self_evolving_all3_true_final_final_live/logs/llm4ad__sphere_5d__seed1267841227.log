def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    candidates = qmc.LatinHypercubeSample(dim)(budget)
    candidates = [clip(candidate) for candidate in candidates]

    best_candidate = np.zeros(dim)
    best_value = float('inf')

    for i in range(budget):
        if rng.random() < 0.1:
            new_candidate = clip(rng.uniform(lb, ub, size=dim))
        else:
            new_candidate = candidates[i]

        value = func(new_candidate)

        if value < best_value:
            best_value = value
            best_candidate = new_candidate

    return np.array(best_candidate)
