def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    n = 20  # population size
    m = 1  # number of offspring generated per iteration
    p = 0.5  # initial crossover probability
    F = 1.0  # initial mutation factor

    pop = rng.uniform(lb, ub, (n, dim))
    best = np.inf

    for i in range(budget):
        offsprings = []
        for j in range(m):
            idx1 = rng.randint(n)
            idx2 = rng.randint(n)
            while idx1 == idx2:
                idx2 = rng.randint(n)

            candidate = clip(pop[idx1] + F * (pop[idx2] - pop[idx1]), lb, ub)
            offsprings.append(candidate)

        for j in range(m):
            idx = rng.randint(n)
            ridx = rng.randint(5)  # choose one dimension randomly
            candidate = clip(pop[idx] + p * (offsprings[j][ridx] - pop[idx][ridx]), lb, ub)
            offsprings[j][ridx] = candidate

        for j in range(n):
            idx = rng.randint(m)
            if func(offsprings[idx]) < func(pop[j]):
                pop[j] = offsprings[idx]
                if func(pop[j]) < best:
                    best = func(pop[j])

        F *= 0.95  # decrease mutation factor
        p += 0.1 / (n + i)  # increase crossover probability

    return np.array([np.min(best)])
