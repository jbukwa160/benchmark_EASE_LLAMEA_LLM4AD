def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([1 + (ub - 1) * rng.rand() for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(budget):
        g = np.zeros(dim)
        
        # Estimate gradient
        eps = 1e-3
        for j in range(dim):
            x_plus_eps = x.copy()
            x_plus_eps[j] += eps
            
            f_plus_eps = func(x_plus_eps)
            g[j] = (f_plus_eps - best_f) / eps
            
            x_minus_eps = x.copy()
            x_minus_eps[j] -= eps
            
            f_minus_eps = func(x_minus_eps)
            g[j] += (best_f - f_minus_eps) / eps
        
        # Update step-size
        s = 0.1 + (ub - lb) * rng.rand()
        
        # Move along gradient direction
        x_new = x + s * g
        
        # Clip to bounds
        x_new = np.clip(x_new, lb, ub)
        
        # Evaluate new point and update best solution if needed
        f_new = func(x_new)
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new
            
        x = x_new
    
    return best_x
