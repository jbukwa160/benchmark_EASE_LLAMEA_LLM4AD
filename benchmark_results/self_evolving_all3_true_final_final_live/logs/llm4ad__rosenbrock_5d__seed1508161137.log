def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    num_parents = int(pop_size * 0.2)
    mutation_rate = 0.1
    sigma = 0.5

    def generate_individual():
        return rng.uniform(lb, ub, size=dim)

    def mutate(x):
        x_mutated = x.copy()
        for i in range(dim):
            if rng.random() < mutation_rate:
                x_mutated[i] += rng.normal(0, sigma)
                x_mutated[i] = np.clip(x_mutated[i], lb, ub)
        return x_mutated

    def evaluate_population(population):
        fitnesses = [func(individual) for individual in population]
        return np.array(fitnesses)

    population = [generate_individual() for _ in range(pop_size)]

    for i in range(budget):
        fitnesses = evaluate_population(population)
        parents = np.argsort(fitnesses)[:num_parents]

        new_population = []
        for j, parent_idx in enumerate(parents):
            individual = mutate(population[parent_idx])
            new_population.append(individual)

        population = new_population

    return population[np.argmin(evaluate_population(population))]
