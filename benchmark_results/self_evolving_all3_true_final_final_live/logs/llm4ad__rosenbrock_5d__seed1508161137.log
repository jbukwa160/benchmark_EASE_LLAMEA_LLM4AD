def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def polynomial_mutation(solution, sigma, dim):
        mutated_solution = solution.copy()
        for i in range(dim):
            if rng.uniform(0, 1) < 0.01:
                mutated_solution[i] += rng.normal(0, sigma)
                mutated_solution[i] = np.clip(mutated_solution[i], lb, ub)
        return mutated_solution

    def simulated_annealing(func, solution, temperature, budget):
        for _ in range(budget):
            candidate = polynomial_mutation(solution, temperature * 1e-2, dim)
            new_value = func(candidate)
            delta = new_value - func(solution)
            if rng.uniform(0, 1) < np.exp(-delta / temperature):
                solution = candidate
        return solution

    lower_bound = lb + (ub - lb) / 10
    upper_bound = ub - (ub - lb) / 10

    solution = (rng.uniform(lower_bound, upper_bound) for _ in range(dim))
    solution = np.array(list(solution))

    temperature = rng.uniform(1e-3, 1e-2)

    best_solution = simulated_annealing(func, solution, temperature, budget * 100)
    return clip(best_solution)
