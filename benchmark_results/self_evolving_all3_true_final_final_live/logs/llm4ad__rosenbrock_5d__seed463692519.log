def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lower, upper):
        return np.clip(candidate, lower, upper)

    def generate_candidate(mean, sigma):
        candidate = mean + sigma * np.random.randn(dim)
        return clip(candidate, lb, ub)

    mean = np.zeros(dim)
    step_size = 0.5
    population_size = 50
    num_parents = int(population_size * 0.1)

    for _ in range(budget):
        candidates = [generate_candidate(mean, step_size) for _ in range(population_size)]
        fitnesses = [func(candidate) for candidate in candidates]

        sorted_indices = np.argsort(fitnesses)
        selected_candidates = [candidates[i] for i in sorted_indices[:num_parents]]

        mean = np.mean(np.array(selected_candidates), axis=0)

    best_candidate = generate_candidate(mean, step_size)
    return best_candidate
