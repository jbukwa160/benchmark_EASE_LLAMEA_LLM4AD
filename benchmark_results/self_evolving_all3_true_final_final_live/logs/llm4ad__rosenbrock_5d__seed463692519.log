def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    x0 = np.array([1] * dim)
    bounds = [(lb, ub) for _ in range(dim)]

    result = minimize(objective, x0, method="SLSQP", bounds=bounds, options={"maxiter": budget})

    best_x = result.x
    return best_x
