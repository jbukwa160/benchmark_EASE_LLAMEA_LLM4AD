def algorithm(func, dim, lb, ub, budget, rng):
    def grad(x):
        return 2 * np.sum(200 * x[1:] * (x[:-1]**2 - x[1:]) + (x[:-1] - 1))

    def clip(x):
        return np.clip(x, lb, ub)

    init = rng.uniform(lb, ub, size=dim)
    best_x = init
    best_f = func(init)

    for _ in range(budget):
        # Random Search
        x_rand = rng.uniform(lb, ub, size=dim)
        f_rand = func(x_rand)
        if f_rand < best_f:
            best_x = clip(x_rand)
            best_f = f_rand

        # Quasi-Newton Method
        grad_best = grad(clip(best_x))
        step_size = 0.1
        x_new = best_x + step_size * np.array([grad_best / 2 ** i for i in range(dim)])
        x_new = clip(x_new)
        f_new = func(x_new)

        if f_new < best_f:
            best_x = x_new
            best_f = f_new

    return best_x
