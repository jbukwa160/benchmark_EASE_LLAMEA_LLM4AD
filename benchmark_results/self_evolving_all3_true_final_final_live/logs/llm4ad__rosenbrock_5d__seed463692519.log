def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    F = 0.5
    CR = 0.9
    
    x_best = np.random.uniform(lb, ub, (1, dim))
    f_best = func(x_best)
    
    for i in range(budget):
        offspring = np.zeros((pop_size, dim))
        
        for j in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size, 3), rng.randint(0, pop_size, 3)
            
            while r1 == j or r2 == j or r3 == j:
                r1, r2, r3 = rng.randint(0, pop_size, 3)
                
            x_off = np.copy(x_best)
            
            for k in range(dim):
                u = F * (x_best[r1, k] - x_best[j, k]) + x_best[j, k]
                l = x_best[j, k] - F * abs(x_best[r2, k] - x_best[r3, k])
                if rng.random() < CR or func([u]) < func([l]):
                    x_off[k] = u
                else:
                    x_off[k] = l
            
            offspring[j] = np.clip(x_off, lb, ub)
        
        f_offspring = [func(off) for off in offspring]
        
        if min(f_offspring) <= f_best:
            f_best = min(f_offspring)
            x_best = np.copy(offspring[f_offspring.index(min(f_offspring))])
    
    return np.clip(x_best, lb, ub)
