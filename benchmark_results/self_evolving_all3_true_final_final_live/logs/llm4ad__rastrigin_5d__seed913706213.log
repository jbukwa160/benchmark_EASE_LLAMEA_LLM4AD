def algorithm(func, dim, lb, ub, budget, rng):
    def get_bounds():
        return (lb + 1e-6, ub - 1e-6)  # avoid division by zero and precision errors

    def generate_initial_population(size, bounds):
        pop = rng.uniform(bounds[0], bounds[1], size=(size, dim))
        return pop

    def calculate_objective(pop, func):
        obj_values = np.zeros(size)
        for i in range(size):
            obj_values[i] = func(pop[i])
        return obj_values

    def differential_evolution(pop, bounds, f, n_pop, n_offspring=50, cr=0.5, mut=0.1, learning_factor=0.2):
        offsprings = np.zeros((n_offspring, dim))
        for i in range(n_offspring):
            trial_individual = pop[rng.randint(0, n_pop), :]
            differences = pop - trial_individual[:, None]
            rand_idx = rng.choice(n_pop, size=n_pop-1, replace=False)
            trial_individual[:n_pop-1] += cr * differences[rand_idx, :] + mut * rng.uniform(bounds[0], bounds[1], (n_pop-1, dim))
            offsprings[i] = np.clip(trial_individual, bounds[0], bounds[1])
        return offsprings

    def particle_swarm_optimization(pop, bounds, f, n_iter, c1=2.0, c2=2.0, w=0.7):
        for _ in range(n_iter):
            velocities = np.zeros((size, dim))
            for i in range(size):
                velocities[i] = w * velocities[i] + c1 * rng.uniform(0, 1) * (pop[i] - pop[rng.randint(0, size)]) \
                                + c2 * rng.uniform(0, 1) * (pop[i] - pop[rng.randint(0, size)])
                pop[i] = np.clip(pop[i] + velocities[i], bounds[0], bounds[1])
            obj_values = calculate_objective(pop, f)
        return pop

    def hybrid_algorithm(pop, bounds, f, n_iter):
        for _ in range(n_iter):
            offsprings = differential_evolution(pop, bounds, f, size, 50, 0.5, 0.1, 0.2)
            obj_values_offspring = calculate_objective(offsprings, f)
            idx_best = np.argmax(obj_values_offspring)
            if obj_values_offspring[idx_best] < np.min(obj_values):
                pop[:] = offsprings[idx_best]
        return pop

    size = budget // (10 * dim)  # adjust population size based on dimension
    bounds = get_bounds()
    pop = generate_initial_population(size, bounds)
    best_individual = pop[np.argmin(calculate_objective(pop, func))]
    for _ in range(int(budget / size)):
        new_pop = hybrid_algorithm(pop, bounds, func, int(budget / size))
        best_individual = np.clip(np.minimum(best_individual, new_pop[np.argmin(calculate_objective(new_pop, func))]), bounds[0], bounds[1])
    return best_individual
