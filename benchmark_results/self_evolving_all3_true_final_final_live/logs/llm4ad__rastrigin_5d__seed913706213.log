def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def objective(params):
        params = clip(params)
        return func(params)

    best_params = None
    best_value = np.inf

    for i in range(budget):
        grid_size = int(np.floor(np.power(dim, 1/3)))
        if i == 0:
            grid = np.linspace(lb, ub, grid_size)
            params_grid = np.meshgrid(*[grid]*dim, indexing='ij')
            candidates = np.vstack([param for param in np.array(params_grid).T])
        else:
            candidates = rng.uniform(lb, ub, size=(grid_size**dim, dim))

        values = [objective(param) for param in candidates]
        indices = np.argsort(values)[:int(np.floor(np.power(dim, 1/3)))]

        if i == 0:
            best_params = candidates[indices[0]]
            best_value = values[indices[0]]

        perturbations = rng.uniform(-1e-2, 1e-2, size=(grid_size**dim, dim))
        new_candidates = candidates + perturbations
        new_values = [objective(param) for param in new_candidates]

        if np.mean(new_values) < best_value:
            best_params = new_candidates[np.argmin(new_values)]
            best_value = np.min(new_values)

    return best_params
