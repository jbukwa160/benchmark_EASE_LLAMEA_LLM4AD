def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    def generate_initial_population(size, dim, lb, ub):
        return (ub - lb) * rng.random((size, dim)) + lb

    def differential_evolution(population, func, dim, lb, ub, budget):
        for _ in range(budget // 2):
            population = np.concatenate([
                clip(population),
                np.array([func(p) for p in population])
            ], axis=1)
        
        indices = rng.permutation(population.shape[0])[:int(population.shape[0] * 0.2)]
        population = population[indices]
        
        mutation_rate = 0.5
        mutation_index = int(dim * 0.2)
        
        for i in range(int(population.shape[0] * 0.8)):
            x1, x2, x3 = np.random.permutation(population[i, :mutation_index]), population[i, :mutation_index], population[(i+1) % population.shape[0], :mutation_index]
            v = mutation_rate * (x1 - 2*x2 + x3)
            population[i, :mutation_index] += v
        
        return population

    def nelder_mead(population, func, dim, lb, ub):
        for _ in range(budget // 4):
            fitness = np.array([func(p) for p in population])
            
            centroid = np.mean(population, axis=0)
            if func(centroid) < np.min(fitness):
                population = np.concatenate([
                    clip(population),
                    [centroid]
                ], axis=0)
            
            sorted_indices = np.argsort(fitness)
            simplex_vertices = []
            for i in range(dim + 1):
                vertex = centroid
                vertex[sorted_indices[i]] += 2 * (population[sorted_indices[i], sorted_indices[i]] - centroid)[sorted_indices[i]]
                simplex_vertices.append(clip(vertex))
            
            centroid = np.mean(population, axis=0)
            if func(np.mean(simplex_vertices, axis=0)) < np.min(fitness):
                population = np.concatenate([
                    clip(population),
                    [np.mean(simplex_vertices, axis=0)]
                ], axis=0)
        
        return population
    
    initial_population = generate_initial_population(50, dim, lb, ub)
    population = differential_evolution(initial_population, func, dim, lb, ub, budget // 2)
    population = nelder_mead(population, func, dim, lb, ub)
    
    return np.min(population[:, -1])
