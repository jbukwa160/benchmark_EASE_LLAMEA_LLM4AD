def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(dim, lb, ub, rng):
        return rng.uniform(lb, ub, size=(budget, dim))

    def calculate_fitness(x, func, dim):
        return func(np.array([x]).T)

    def adaptive_crossover_rate(population_fitnesses, best_fitness):
        avg_fitness = np.mean(population_fitnesses)
        std_dev = np.std(population_fitnesses)
        if std_dev == 0:
            return 1.0
        else:
            return (best_fitness - avg_fitness) / std_dev

    def adaptive_mutation_rate(best_fitness, population_fitnesses):
        avg_fitness = np.mean(population_fitnesses)
        std_dev = np.std(population_fitnesses)
        if std_dev == 0:
            return 1.0
        else:
            return (best_fitness - avg_fitness) / std_dev

    population = generate_initial_population(dim, lb, ub, rng)

    for _ in range(budget):
        population_fitnesses = calculate_fitness(population, func, dim)
        best_idx = np.argmin(population_fitnesses)
        best_x = population[best_idx]

        crossover_rate = adaptive_crossover_rate(population_fitnesses, population_fitnesses[best_idx])
        mutation_rate = adaptive_mutation_rate(population_fitnesses[best_idx], population_fitnesses)

        for i in range(budget):
            if i == best_idx:
                continue
            r1, r2, r3 = rng.randint(0, budget, size=3)
            while r1 == i or r2 == i or r3 == i or r1 == best_idx or r2 == best_idx or r3 == best_idx:
                r1, r2, r3 = rng.randint(0, budget, size=3)

            crossover_x = (best_x + population[r1]) / 2.0
            mutation_x = crossover_x + mutation_rate * (population[r2] - population[r3])

            clipped_x = np.clip(mutation_x, lb, ub)
            new_population = np.array([clipped_x])
            new_population_fitness = calculate_fitness(clipped_x, func, dim)

            if new_population_fitness < population_fitnesses[i]:
                population[i] = new_population
                population_fitnesses[i] = new_population_fitness

    best_idx = np.argmin(population_fitnesses)
    return population[best_idx]
