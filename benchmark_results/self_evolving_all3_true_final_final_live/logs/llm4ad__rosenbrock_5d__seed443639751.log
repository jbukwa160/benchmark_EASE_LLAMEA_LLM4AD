def algorithm(func, dim, lb, ub, budget, rng):
    def f(params):
        params = np.clip(params, lb, ub)
        return func(params)

    x_best = np.random.uniform(lb, ub, (1, dim))
    cma = np.eye(dim) * 0.5
    sigma = 1.0
    mu = 0.75

    for _ in range(budget):
        x_candidates = np.random.multivariate_normal(x_best.flatten(), sigma**2 * cma)
        f_values = [f(candidate) for candidate in x_candidates]
        
        if rng is not None:
            order = np.argsort(f_values)[rng]
        else:
            order = np.argsort(f_values)
        
        best_candidate = x_candidates[order[0]]
        
        if f(best_candidate) < f(x_best):
            x_best = best_candidate
            cma = (1 - mu) * cma + mu * np.outer((best_candidate - x_best), (best_candidate - x_best))
            sigma *= 0.5

    return x_best
