def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x_best = rng.uniform(lb, ub, size=dim)
    for _ in range(budget):
        # Generate a new candidate by applying a differencing operation
        diff_idx = rng.choice(dim, size=2, replace=False)
        idx1, idx2 = diff_idx[0], diff_idx[1]
        x_new = clip(x_best.copy())
        if rng.rand() < 0.5:
            # Apply addition difference
            x_new[idx2] += x_new[idx1] - lb
        else:
            # Apply subtraction difference
            x_new[idx2] -= x_new[idx1] - ub

        # Evaluate the new candidate and update the best solution if necessary
        fx_new = func(x_new)
        if fx_new < func(clip(x_best)):
            x_best = x_new
    return clip(x_best)
