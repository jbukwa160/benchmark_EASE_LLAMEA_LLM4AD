def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([0.5 * (ub + lb)] * dim)
    best_x = x.copy()
    best_f = func(x)
    
    num_improvements = 0
    
    for _ in range(budget):
        new_x = x + rng.normal(size=dim) * 0.1
        new_x = np.clip(new_x, lb, ub)
        
        delta_f = func(new_x) - best_f
        
        if delta_f < 0:
            num_improvements += 1
            x = new_x.copy()
            best_x = new_x.copy()
            best_f = func(new_x)
        else:
            probability = np.exp(-num_improvements / (budget * 10))
            if rng.uniform() > probability:
                x = new_x.copy()
    
    return best_x
