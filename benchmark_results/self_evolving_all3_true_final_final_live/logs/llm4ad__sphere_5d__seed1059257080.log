def algorithm(func, dim, lb, ub, budget, rng):
    n = len(dim)
    x_best = 1e10 * np.ones(n)
    t = 0.5
    for _ in range(budget):
        x_rand = ub + (lb - ub) * rng.rand(n)
        x_new = x_best - (x_best - x_rand) / (t ** _)
        if func(x_new) < func(x_best):
            x_best = x_new
        t *= 0.9999
    return np.clip(x_best, lb, ub)
