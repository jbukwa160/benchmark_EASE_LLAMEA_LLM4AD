def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    D = 1e-8 * rng.uniform(0, 1)
    mu = np.zeros(n)
    sigma = 10
    lambda_ = 5
    step_size = 0.2

    for _ in range(budget):
        x = mu + sigma * np.random.randn(n) / np.sqrt(np.sum(np.square(rng.uniform(0, 1, n))))
        x = np.clip(x, lb, ub)

        f_x = func(x)
        if f_x < func(mu):
            mu = x
            sigma *= (1 - step_size)
            D = 10 * rng.uniform(0, 1) + 1e-8

    return mu
