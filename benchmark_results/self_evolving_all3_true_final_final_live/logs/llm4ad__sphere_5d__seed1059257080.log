def algorithm(func, dim, lb, ub, budget, rng):
    N = 50  # population size
    D = dim  # problem dimensionality
    F = 0.5  # mutation factor
    CR = 0.9  # crossover rate

    x_best = np.array([lb] * D)  # initialize best solution with lower bound
    f_best = func(x_best)

    for _ in range(budget):
        x = np.zeros((N, D))
        for i in range(N):
            for d in range(D):
                if rng.random() < CR:
                    x_i1 = lb + (ub - lb) * rng.uniform()
                    x[i, d] = x_best[d] + F * (x_i1 - x_best[d])
                else:
                    x[i, d] = x_best[d]
            x[i] = np.clip(x[i], a_min=lb, a_max=ub)

        f_x = func(x)
        idx = np.argmin(f_x)
        if f_x[idx] < f_best:
            f_best = f_x[idx]
            x_best = x[idx]

    return x_best
