def algorithm(func, dim, lb, ub, budget, rng):
    def sample_x():
        return [rng.uniform(lb[i], ub[i]) for i in range(dim)]

    x = sample_x()
    best_x = x
    best_f = func(x)

    for _ in range(budget - 1):
        # Explore: Randomly sample a new point with probability 0.2
        if rng.random() < 0.2:
            x_new = sample_x()
        # Exploit: Select the best point found so far with probability 0.8
        else:
            x_new = [x[i] + rng.uniform(-1, 1) for i in range(dim)]

        # Clip candidates to [lb, ub]
        x_new = [max(lb[i], min(ub[i], x_new[i])) for i in range(dim)]
        f_new = func(x_new)

        if f_new < best_f:
            best_x = x_new
            best_f = f_new

        # Adaptive step size: Increase or decrease the step size based on the gradient
        grad = [(x_new[i+1] - x_new[i]**2) * 200 + (x_new[i] - 1) for i in range(dim-1)]
        if rng.random() < 0.5:
            alpha = 0.9
        else:
            alpha = 1.1

        # Update the current point
        x = [x[i] + alpha * grad[i] for i in range(dim)]

    return np.array(best_x)
