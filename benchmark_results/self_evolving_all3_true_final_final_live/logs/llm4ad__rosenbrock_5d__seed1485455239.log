def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(params):
        x = np.array([np.random.uniform(lb[i], ub[i]) for i in range(dim)])
        return params + x

    def evaluate(candidate):
        candidate = [max(min(c, ub[i]), lb[i]) for i, c in enumerate(candidate)]
        return func(candidate)

    best_candidate = None
    budget_left = budget

    def sample_candidate(rng):
        return np.array([np.random.uniform(lb[i], ub[i]) for i in range(dim)])

    cma = rng.get_state()[1][0]
    step_size = 1.0 / dim
    population_size = int(budget * (budget - 1) / 2 + 1)
    candidates = [generate_candidate(sample_candidate(rng)) for _ in range(population_size)]

    while budget_left > 0 and not np.allclose(cma, rng.get_state()[1][0]):
        budget_left -= 1
        fitnesses = [evaluate(candidate) for candidate in candidates]
        mean_fitness = np.mean(fitnesses)
        sigma = step_size / (np.sqrt(np.std(fitnesses)) + 1e-6)
        indices = np.argsort(fitnesses)
        sorted_candidates = [candidates[i] for i in indices]

        if best_candidate is None or fitnesses[0] < evaluate(best_candidate):
            best_candidate = sorted_candidates[0]
        
        cma = rng.get_state()[1][0]
        for i in range(population_size - 1):
            parent1 = np.random.choice(sorted_candidates[:i+1], p=np.array(fitnesses[:i+1])/np.sum(np.array(fitnesses[:i+1])))
            parent2 = np.random.choice(sorted_candidates[:i+1], p=np.array(fitnesses[:i+1])/np.sum(np.array(fitnesses[:i+1])))
            child = (parent1 + parent2) / 2
            child += np.random.normal(0, sigma, dim)
            candidates[i] = generate_candidate(child)

    if best_candidate is None:
        return np.array([ub[0]])
    
    return best_candidate
