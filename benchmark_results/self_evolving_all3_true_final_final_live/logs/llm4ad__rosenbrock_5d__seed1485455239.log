def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        if rng.random() < 0.1:
            # Perform local gradient descent
            df = np.zeros(dim)
            for i in range(dim - 1):
                step_size = 0.01 * (x[i+1] - x[i]**2)**2 + 0.02 * (1 - x[i])**2
                df[i] -= 400 * (x[i+1] - x[i]**4) * (x[i+1] - x[i]**2)
                df[i+1] += 200 * (x[i+1] - x[i]**2)**2
            step = np.array(df) / np.linalg.norm(df)
            x -= step * step_size

        else:
            # Perform stochastic search
            i = rng.choice(dim, size=1)[0]
            if rng.random() < 0.5:
                delta = (rng.uniform(-1, 1)) ** (1/rng.randint(2, 6))
                x[i] += delta * (ub - lb)
            else:
                x[i] -= np.sqrt(rng.uniform(0, 1)) * (x[i] - lb)

        best_f_new = func(x)
        if best_f_new < best_f:
            best_x = x.copy()
            best_f = best_f_new

        x = clip(x, lb, ub)

    return best_x
