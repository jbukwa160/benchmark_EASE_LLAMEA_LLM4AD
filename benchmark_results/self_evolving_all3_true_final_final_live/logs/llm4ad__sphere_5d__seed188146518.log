def algorithm(func, dim, lb, ub, budget, rng):
    x = (rng.rand(dim) * 2 - 1) * (ub - lb) + lb
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        i = np.random.randint(0, dim)
        p = np.random.uniform(lb[i], ub[i])
        
        new_x = x.copy()
        new_x[i] = p
        
        new_f = func(new_x)
        
        if new_f < best_f:
            best_x = new_x
            best_f = new_f
    
    return best_x
