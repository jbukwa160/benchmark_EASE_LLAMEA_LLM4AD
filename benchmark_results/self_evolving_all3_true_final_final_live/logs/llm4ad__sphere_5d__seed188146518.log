def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    T = 1.0
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        new_x = x + rng.normal(size=dim) * 0.01
        new_x = clip_candidate(new_x)
        new_f = func(new_x)

        if new_f < best_f:
            best_f = new_f
            best_x = new_x.copy()

        delta_f = new_f - best_f
        if delta_f < 0 or np.random.rand() < np.exp(-delta_f / T):
            x = new_x

        T *= 0.99999  # Cooling schedule

    return best_x
