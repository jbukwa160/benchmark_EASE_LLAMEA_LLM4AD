def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(clip(x_best))

    T0 = 100.0
    alpha = 0.99

    for i in range(budget):
        x_current = clip(x_best + (ub - lb) * rng.randn(dim))
        f_current = func(x_current)

        if f_current < f_best:
            x_best = x_current
            f_best = f_current

        T = max(T0 * alpha ** i, 1e-6)
        if rng.rand() < np.exp((f_best - f_current) / T):
            x_best = (x_best + x_current) / 2.0
            f_best = func(clip(x_best))

    return clip(x_best)
