def algorithm(func, dim, lb, ub, budget, rng):
    def surrogate(x):
        return np.mean([func(x_i) for x_i in x])

    init_x = [ub + (ub - lb) * rng.random() for _ in range(dim)]
    best_x = init_x.copy()
    best_f = func(best_x)

    gp_model = {}
    gp_model['x'] = []
    gp_model['y'] = []

    for t in range(budget):
        x_gp = np.array([np.concatenate((gp_model['x'][i][:t], [None]*(dim-len(gp_model['x'][i]) + (i == 0))), axis=0) for i in range(len(gp_model['x']))])

        K = np.zeros((len(x_gp), len(x_gp)))
        for i in range(len(x_gp)):
            K[i, i] = 1e-3
            if x_gp[i].any():
                for j in range(i + 1, len(x_gp)):
                    gp_model['x'][i] = np.array(gp_model['x'][i])
                    gp_model['x'][j] = np.array(gp_model['x'][j])
                    K[i, j] = np.dot(gp_model['x'][i], gp_model['x'][j]) + 1e-3
                    K[j, i] = K[i, j]

        alpha = np.linalg.solve(K, -np.array([gp_model['y'][i] for i in range(len(x_gp))]))

        x_new = []
        y_new = []

        if len(gp_model['x']) == 0:
            x_new.append(ub + (ub - lb) * rng.random())
            y_new.append(func(np.array(x_new[-1])))
        else:
            mu, sigma = np.mean(alpha), np.std(alpha)
            for i in range(len(best_x)):
                K_i = [K[j, i] if j < len(gp_model['x']) else 0 for j in range(len(gp_model['x']))]
                x_gp_new = [gp_model['x'][j] + mu * K_j / np.linalg.det(K) if j < len(gp_model['x']) and K_j > 1e-3 else None for j, K_j in enumerate(K_i)]
                x_gp_new = [x for x in x_gp_new if x is not None]
                y_gp_new = gp_model['y'][i] + np.dot(alpha[i], K_i)

                if len(x_gp_new) > 0:
                    mu_new = surrogate(np.array(x_gp_new))
                    sigma_new = np.std(y_gp_new)
                    pi = (mu_new - best_f) / (3 * sigma_new + 1e-6)
                    u = rng.uniform(0, 1)

                    if u < pi or len(gp_model['x']) == 0:
                        x_gp_new_i = ub + (ub - lb) * rng.random()
                        while np.any(np.array(x_gp_new) == x_gp_new_i):
                            x_gp_new_i = ub + (ub - lb) * rng.random()

                        x_new.append(x_gp_new_i)
                        y_new.append(func(np.array(x_gp_new_i)))

        if len(y_new) > 0:
            best_f, best_x = min(zip(y_new, x_new), key=lambda pair: pair[0])
            gp_model['x'].append(best_x)
            gp_model['y'].append(best_f)

    return np.array(best_x)
