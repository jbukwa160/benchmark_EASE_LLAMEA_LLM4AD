def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x)

    def gradient(x):
        eps = 1e-4 * np.ones_like(x)
        grad = np.zeros_like(x)
        for i in range(len(x)):
            x_try = clip(x + eps * rng.normal(size=x.shape))
            x_try2 = clip(x - eps * rng.normal(size=x.shape))
            grad[i] = (evaluate(x_try) - evaluate(x_try2)) / (2 * eps)
        return grad

    def differential_evolution(x0, dim):
        population_size = 20
        pop = np.array([clip(rng.uniform(lb, ub, size=dim)) for _ in range(population_size)])
        best_x = x0
        best_f = evaluate(best_x)

        for _ in range(budget // 2):
            parents = np.array(sorted(pop, key=lambda x: evaluate(x), reverse=True)[:population_size//2])
            offsprings = []
            for i in range(len(parents)):
                p1, p2, p3 = parents[i], parents[(i+1)%len(parents)], rng.choice(population_size)
                v = clip(p1 + 0.5 * (p2 - p3))
                offsprings.append(v)
                offsprings.append(clip(p1 + 0.5 * (p2 - p1)))
            pop = np.array(offsprings + [clip(rng.uniform(lb, ub, size=dim)) for _ in range(population_size-len(offsprings))])
            best_x, best_f = min([(x, evaluate(x)) for x in pop], key=lambda x: x[1])

        return best_x

    def gradient_descent(x0):
        learning_rate = 0.01
        for _ in range(budget // 2):
            grad = gradient(x0)
            x0 -= learning_rate * grad

        return x0

    pop = differential_evolution(np.zeros(dim), dim)
    best_x = gradient_descent(pop)

    return best_x
