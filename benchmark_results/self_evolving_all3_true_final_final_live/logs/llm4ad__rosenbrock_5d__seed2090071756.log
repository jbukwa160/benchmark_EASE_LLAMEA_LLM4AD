def algorithm(func, dim, lb, ub, budget, rng):
    def func_wrapper(x):
        return func(x)

    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    def sample_gaussian(mean, cov):
        return mean + rng.normal(size=dim) @ np.linalg.cholesky(cov)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = np.copy(x)
    best_func_value = func_wrapper(best_x)

    step_size = 1
    learning_rate = 0.01

    for _ in range(budget):
        candidates = [clip_candidate(sample_gaussian(x, np.eye(dim)*step_size**2)) 
                      for _ in range(100)]
        
        values = [func_wrapper(candidate) for candidate in candidates]
        
        new_x = np.mean(candidates[np.argsort(values)[:5]], axis=0)
        
        if func_wrapper(new_x) < best_func_value:
            step_size *= (1 - learning_rate)
            x = np.copy(new_x)
            best_x = np.copy(x)
            best_func_value = func_wrapper(best_x)

    return best_x
