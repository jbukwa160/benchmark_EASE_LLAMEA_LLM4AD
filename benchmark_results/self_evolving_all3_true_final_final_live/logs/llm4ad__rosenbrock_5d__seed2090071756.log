def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    num_particles = 20
    w = 0.5  # inertia coefficient
    c1 = 2.05  # cognitive coefficient
    c2 = 2.05  # social coefficient

    particles = rng.uniform(lb, ub, (num_particles, dim))
    velocities = np.zeros((num_particles, dim))

    best_positions = np.copy(particles)
    best_values = np.array([func(clip(position)) for position in particles])

    for _ in range(budget):
        for i in range(num_particles):
            r1 = rng.uniform(0, 1)
            r2 = rng.uniform(0, 1)

            velocities[i] += w * (velocities[i] - c1 * r1 * (particles[i] - best_positions[i]) -
                                  c2 * r2 * (particles[i] - clip(best_positions[np.argmax([func(clip(position)) for position in particles])])))

            particles[i] += velocities[i]

        for i in range(num_particles):
            if func(clip(particles[i])) < best_values[i]:
                best_values[i] = func(clip(particles[i]))
                best_positions[i] = np.copy(particles[i])

    return clip(best_positions[np.argmin(best_values)])
