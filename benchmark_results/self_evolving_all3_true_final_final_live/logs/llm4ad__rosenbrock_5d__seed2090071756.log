def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    lr0 = 1.0 / (np.sqrt(2 * dim))
    lr = lr0
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        g = np.zeros(dim)
        for i in range(dim):
            x_new = x.copy()
            x_new[i] += 1e-6
            g[i] = (func(x_new) - best_f) / 1e-6

        d = rng.normal(size=dim, loc=0.0, scale=lr)
        step_size = lr * np.sqrt(np.dot(d, g))
        x += step_size * d / np.linalg.norm(d)

        # clip to bounds
        x = np.clip(x, lb, ub)

        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x.copy()

        lr *= 0.99

    return best_x
