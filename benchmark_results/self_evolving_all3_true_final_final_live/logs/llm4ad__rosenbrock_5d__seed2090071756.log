def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    current = np.random.uniform(lb, ub, size=dim)
    best = current.copy()
    for _ in range(budget):
        new = current + 0.1 * (rng.rand(dim) - 0.5)
        new = clip(new)
        if func(new) < func(best):
            best = new
        elif rng.rand() < np.exp((func(current) - func(new)) / 100):
            current = new
    return best
