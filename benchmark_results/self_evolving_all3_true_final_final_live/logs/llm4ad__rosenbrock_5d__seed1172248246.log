def algorithm(func, dim, lb, ub, budget, rng):
    def quantum_pso(x0, bounds, c1=1.5, c2=1.5, w=0.8, omega=0.4):
        x = np.copy(x0)
        v = np.random.uniform(-omega, omega, size=x.shape)
        best_x = np.copy(x)
        best_f = func(x)
        
        for _ in range(budget):
            for i in range(len(x)):
                r1 = rng.rand()
                r2 = rng.rand()
                x_new = w * x + c1 * r1 * (best_x - x) + c2 * r2 * (v - w * x)
                v[i] = 0.8 * v[i] + np.sqrt(0.5 - rng.rand()) * (x_new[i] - x[i])
                
                if func(x_new) < best_f:
                    best_x = np.copy(x_new)
                    best_f = func(x_new)
                    
                x[i] = np.clip(x_new[i], lb, ub)
            yield best_x
    
    def evolution_strategy(parents, bounds, sigma=0.1):
        children = np.empty_like(parents)
        for i in range(len(parents)):
            noise = rng.normal(size=len(parents[0]))
            child = parents[i] + sigma * noise
            child = np.clip(child, lb, ub)
            children[i] = child
            
        return children
    
    x0 = np.random.uniform(lb, ub, size=dim)
    best_x = None
    
    for x in quantum_pso(x0, (lb, ub)):
        if best_x is None or func(x) < func(best_x):
            best_x = x
            
    for _ in range(budget // 2):
        parents = evolution_strategy([best_x], (lb, ub), sigma=0.1)
        best_x = np.copy(parents[0])
        
        for x in quantum_pso(best_x, (lb, ub)):
            if func(x) < func(best_x):
                best_x = x
                
    return best_x
