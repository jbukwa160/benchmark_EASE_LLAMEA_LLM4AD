def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    population = rng.uniform(lb, ub, size=(budget, dim))
    best_fitness = float('inf')
    best_candidate = None

    for _ in range(budget):
        parents = population[np.argsort([func(clip(x)) for x in population])[:int(0.2*budget)]]
        for i in range(int(0.8*budget)):
            child = np.array(parents[i])
            for j in range(dim):
                u, v, w = rng.choice(population), rng.choice(population), rng.choice(population)
                delta = clip(u[j] + 0.5*(v[j]-u[j]) + rng.uniform(-1, 1)*(w[j]-u[j]))
                child[j] = np.clip(delta + 0.9*child[j], lb, ub)
            population[i] = child
        best_idx = np.argmin([func(clip(x)) for x in population])
        if func(clip(population[best_idx])) < best_fitness:
            best_fitness = func(clip(population[best_idx]))
            best_candidate = clip(population[best_idx])

    return best_candidate
