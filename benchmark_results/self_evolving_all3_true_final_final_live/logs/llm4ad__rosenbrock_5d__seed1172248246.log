def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 1e6
    alpha = 0.99
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        f_x = func(x)
        if f_x < best_f:
            best_f = f_x
            best_x = x.copy()

        dx = rng.normal(size=dim, loc=0.0, scale=T / (T + 1))
        new_x = x + 0.01 * np.clip(dx, -5, 5)

        if func(new_x) < f_x:
            T *= alpha
            x = new_x.copy()
        else:
            u = rng.uniform(0, 1)
            if np.exp((f_x - func(new_x)) / T) > u:
                T *= alpha
                x = new_x.copy()

    return best_x
