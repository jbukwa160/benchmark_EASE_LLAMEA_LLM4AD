def algorithm(func, dim, lb, ub, budget, rng):
    candidates = np.random.uniform(lb, ub, (budget, dim))
    for i in range(budget - 1):
        new_candidate = np.copy(candidates[i])
        for j in range(dim):
            new_candidate[j] += rng.normal(0, 0.5)
            new_candidate[j] = max(lb, min(new_candidate[j], ub))
        if func(new_candidate) < func(candidates[i + 1]):
            candidates[i + 1] = new_candidate
    return np.min(np.array([candidates[i] for i in range(budget) if func(candidates[i]) == np.inf]), axis=0)
