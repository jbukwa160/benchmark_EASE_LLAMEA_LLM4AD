def algorithm(func, dim, lb, ub, budget, rng):
    D = np.prod([ub[i] - lb[i] for i in range(dim)])
    
    def gp_mean(x):
        return np.zeros_like(x)
        
    def gp_var(x):
        return 1e-8 + np.ones_like(x) ** 2
        
    def gp_sample(x):
        mean = gp_mean(x)
        var = gp_var(x)
        return mean + rng.uniform(0, 1) * np.sqrt(var)

    best = None
    for _ in range(budget):
        x_new = []
        for d in range(dim):
            x_d = (ub[d] - lb[d]) * rng.uniform(0, 1) + lb[d]
            x_new.append(x_d)
        x_new = np.array(x_new)

        y_new = func(x_new)
        
        gp_mean = [gp_mean(x) for x in x_new]
        gp_var = [gp_var(x) for x in x_new]

        if best is None or y_new < min(best):
            best = y_new

        gp_mean = np.array(gp_mean)
        gp_var = np.array(gp_var)

        new_gp_mean = []
        new_gp_var = []
        
        for i in range(dim):
            mu1 = gp_mean[i]
            sigma1 = gp_var[i] ** 0.5
            mu2 = gp_mean[(i + 1) % dim]
            sigma2 = gp_var[(i + 1) % dim] ** 0.5
            
            if rng.uniform(0, 1) < 0.5:
                new_gp_mean.append(mu1)
                new_gp_var.append(sigma1 ** 2)
            else:
                new_gp_mean.append(mu2 + sigma2 * (x_new[(i + 1) % dim] - mu1) / sigma1)
                new_gp_var.append(sigma2 ** 2 + sigma1 ** 2)

        gp_mean = np.array(new_gp_mean)
        gp_var = np.array(new_gp_var)

    return best
