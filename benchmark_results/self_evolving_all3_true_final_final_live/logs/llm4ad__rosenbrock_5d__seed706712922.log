def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_step_size(step_size):
        a = 1.0 / (2 * np.sqrt(2) * step_size)
        return a + 1e-4 * rng.uniform(-1, 1)

    def mutation(std_dev):
        offspring = np.copy(population)
        for i in range(dim):
            if rng.random() < 0.5:
                offspring[i] += gaussian_step_size(std_dev) * rng.normal(0, 1)
            else:
                offspring[i] -= gaussian_step_size(std_dev) * rng.normal(0, 1)
        return np.clip(offspring, lb, ub)

    def adaptation(population):
        mean = np.mean(population, axis=0)
        std_dev = np.std(population, axis=0)
        return mean, std_dev

    dim = int(dim)
    population_size = 50
    population = rng.uniform(lb, ub, (population_size, dim))
    mean, std_dev = adaptation(population)

    for i in range(budget):
        offspring = mutation(std_dev)
        fitness = np.array([func(offspring[j]) for j in range(population_size)])
        idx_best = np.argmin(fitness)
        new_mean = 0.9 * mean + 0.1 * offspring[idx_best]
        new_std_dev = 0.8 * std_dev + 0.2 * np.std(offspring, axis=0)

        if i % 10 == 0:
            population_size += 5
            population_size = min(population_size, budget // 10)
            population = rng.uniform(lb, ub, (population_size, dim))
            mean, std_dev = adaptation(population)

        mean, std_dev = new_mean, np.maximum(new_std_dev, 1e-8)
        population[idx_best] = offspring[idx_best]

    best_solution = np.argmin(np.array([func(offspring) for offspring in population]))
    return population[best_solution]
