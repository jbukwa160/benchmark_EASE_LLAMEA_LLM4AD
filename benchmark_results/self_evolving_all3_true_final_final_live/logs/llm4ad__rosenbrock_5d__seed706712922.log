def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    x = np.random.uniform(lb, ub, size=dim)
    sigma = 1.0
    mu = np.zeros(dim)
    cmu = np.eye(dim) * 1e-4

    for i in range(budget):
        z = rng.randn(dim)
        v = mu + sigma * np.dot(cmu, z)

        clipped_v = np.clip(v, lb, ub)
        f_value = objective(clipped_v)

        x = clipped_v
        if i % 10 == 0:
            cmu = (1 - 2 * 1e-4) * cmu + 1e-4 * np.outer(z, z)

        if f_value < objective(x):
            mu = x

    return mu
