def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def fitness(x):
        return func(x)

    x = np.random.uniform(lb, ub, size=dim)
    sigma = 0.5 * (ub - lb) / np.sqrt(dim)
    best_x = x.copy()
    best_fitness = float('inf')

    for _ in range(budget):
        offspring = np.zeros((2*dim, dim))
        for i in range(2*dim):
            z = rng.normal(size=dim)
            offspring[i] = clip(x + sigma * z)

        fitness_values = np.array([fitness(offspring[i]) for i in range(2*dim)])

        best_fitness_index = np.argmin(fitness_values)
        if fitness_values[best_fitness_index] < best_fitness:
            best_fitness = fitness_values[best_fitness_index]
            best_x = offspring[best_fitness_index].copy()

        sigma *= 0.5
        x = clip(np.mean(offspring, axis=0))

    return best_x
