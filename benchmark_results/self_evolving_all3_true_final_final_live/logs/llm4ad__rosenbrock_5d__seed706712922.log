def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    temp = 1.0
    alpha = 0.99
    beta = 1.4

    for _ in range(budget):
        v = rng.normal(size=dim)
        v = clip(x + beta * v)

        if func(v) < func(x):
            x = v
        else:
            temp *= alpha
            if rng.uniform() < np.exp(-func(v) / temp):
                x = v

    return clip(x)
