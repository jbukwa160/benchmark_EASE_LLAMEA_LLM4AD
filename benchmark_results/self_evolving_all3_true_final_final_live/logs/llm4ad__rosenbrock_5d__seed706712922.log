def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    for _ in range(budget // dim):
        x = np.random.uniform(lb, ub, size=dim)
        f = func(clip(x))

        if rng.rand() < 0.1:  # restarts
            best_x = np.random.uniform(lb, ub, size=dim)
            best_f = func(best_x)

        if f < best_f:
            best_x = x
            best_f = f

    return clip(best_x)
