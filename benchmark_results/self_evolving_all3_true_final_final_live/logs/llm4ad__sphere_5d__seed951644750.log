def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    max_iter = int(budget / (dim * pop_size))
    c1 = 2
    c2 = 2
    w = 0.7
    m = np.zeros((pop_size, dim))
    v = np.random.uniform(lb, ub, size=(pop_size, dim))
    
    for _ in range(max_iter):
        for i in range(pop_size):
            r1 = rng.randint(0, pop_size)
            r2 = rng.randint(0, pop_size)
            while r1 == i or r1 == r2:
                r1 = rng.randint(0, pop_size)
            while r2 == i or r2 == r1:
                r2 = rng.randint(0, pop_size)
            
            u = v[r1] + c1 * (v[r1] - m[r1]) + c2 * (v[r2] - m[r2])
            u = w * m[i] + 0.5 * (u - m[i])
            v[i] = np.clip(u, lb, ub)
        
        for i in range(pop_size):
            f_m = func(v[i])
            if f_m < func(m[i]):
                m[i] = v[i]
    
    return m[np.argmin([func(x) for x in m])]
