def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        # Generate a new candidate by perturbing the best solution
        x_new = x_best + 0.1 * (ub - lb) * rng.randn(dim)

        # Clip the candidate to the bounds
        x_new = np.clip(x_new, lb, ub)

        # Evaluate the new candidate and update the best if necessary
        f_new = func(x_new)
        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
