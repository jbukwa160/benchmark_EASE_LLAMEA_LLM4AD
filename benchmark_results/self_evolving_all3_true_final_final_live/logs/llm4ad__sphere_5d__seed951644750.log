def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = np.copy(x)

    for _ in range(budget):
        candidate = np.clip(np.array(rng.uniform(lb, ub, size=dim)), lb, ub)
        if func(candidate) < func(best_x):
            best_x = candidate
        candidate += rng.normal(size=dim) * 0.1
        candidate = np.clip(candidate, lb, ub)
        if func(candidate) < func(best_x):
            best_x = candidate

    return best_x
