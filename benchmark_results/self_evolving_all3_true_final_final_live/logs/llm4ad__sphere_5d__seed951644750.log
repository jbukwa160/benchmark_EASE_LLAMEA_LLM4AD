def algorithm(func, dim, lb, ub, budget, rng):
    def wrapper(x):
        return -func(x)

    bounds = [(lb[i], ub[i]) for i in range(dim)]
    result = differential_evolution(wrapper, bounds, maxiter=budget)
    best_x = np.clip(result.x, lb, ub)
    return best_x
