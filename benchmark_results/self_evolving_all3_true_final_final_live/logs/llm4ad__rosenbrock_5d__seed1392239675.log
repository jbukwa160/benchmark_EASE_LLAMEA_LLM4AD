def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    learning_rate = 0.01
    best_x = x.copy()
    
    for _ in range(budget):
        g = np.zeros(dim)
        
        for i in range(dim-1):
            grad = 2 * 100 * (x[i+1] - x[i]**2) * (2*x[i]*100 + 1) if i == 0 else 2 * 100 * (x[i+1] - x[i]**2)
            g[i] = grad
            g[i+1] = -200 * (x[i+1] - x[i]**2)**2
        
        g *= learning_rate
        
        noise = rng.normal(size=dim, scale=0.01)
        new_x = x + g + noise
        
        clip_x = np.clip(new_x, lb, ub)
        
        if func(clip_x) < func(best_x):
            best_x = clip_x
            
        x = clip_x
    
    return best_x
