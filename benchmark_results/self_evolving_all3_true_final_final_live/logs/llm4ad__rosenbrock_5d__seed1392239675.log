def algorithm(func, dim, lb, ub, budget, rng):
    n = len(dim)
    x_best = np.random.uniform(lb, ub, size=n)
    best_val = func(x_best)

    for _ in range(budget):
        x_new = x_best + rng.normal(0, 1e-2, size=n) * rng.uniform(-1, 1, size=n)
        x_new = np.clip(x_new, lb, ub)
        
        val_new = func(x_new)
        
        if val_new < best_val:
            best_val = val_new
            x_best = x_new

    return x_best
