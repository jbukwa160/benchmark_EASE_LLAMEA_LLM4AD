def algorithm(func, dim, lb, ub, budget, rng):
    x = lb + (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        s = 0.1 * (func(best_x) / np.mean(func(np.clip(x, lb, ub)) ** 2)) ** 0.5
        e = rng.uniform(-s, s)
        y = x + e

        # Apply bounds to candidate
        for i in range(dim):
            if y[i] < lb:
                y[i] = lb
            elif y[i] > ub:
                y[i] = ub

        f_y = func(y)
        if f_y < best_f:
            best_x = y.copy()
            best_f = f_y

        # Random walk component with step size adaptation
        s += 0.01 * (func(best_x) / np.mean(func(np.clip(x, lb, ub)) ** 2))
        e = rng.uniform(-s, s)
        z = x + e

        for i in range(dim):
            if z[i] < lb:
                z[i] = lb
            elif z[i] > ub:
                z[i] = ub

        f_z = func(z)
        if f_z < best_f and np.random.rand() < 0.1:
            x = z.copy()

    return best_x
