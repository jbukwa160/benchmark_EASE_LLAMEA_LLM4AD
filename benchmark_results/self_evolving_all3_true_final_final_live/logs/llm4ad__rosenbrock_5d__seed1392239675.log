def algorithm(func, dim, lb, ub, budget, rng):
    if budget < dim:
        raise ValueError("Budget must be greater than or equal to dimensionality")

    step_size = (ub - lb) / budget
    candidates = []
    for i in range(budget):
        candidate = np.zeros(dim)
        for j in range(dim):
            candidate[j] = lb + (i // (budget // dim)) * step_size + (j % (budget // dim)) * step_size / (budget // dim)
        candidates.append(candidate)

    best_candidate = None
    best_value = float('inf')
    for candidate in candidates:
        value = func(candidate)
        if value < best_value:
            best_value = value
            best_candidate = candidate

    return np.clip(best_candidate, lb, ub)
