def algorithm(func, dim, lb, ub, budget, rng):
    init_points = 1000 // dim
    max_evals_per_point = 10 * dim
    
    best_x = None
    best_f = float('inf')
    
    for _ in range(init_points):
        x = (ub - lb) * rng.rand(dim) + lb
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
            
    for i in range(budget // max_evals_per_point):
        for j in range(max_evals_per_point):
            x = (ub - lb) * rng.rand(dim) + lb
            f = func(x)
            
            if f < best_f:
                best_f = f
                best_x = x
                
    return np.clip(best_x, lb, ub)
