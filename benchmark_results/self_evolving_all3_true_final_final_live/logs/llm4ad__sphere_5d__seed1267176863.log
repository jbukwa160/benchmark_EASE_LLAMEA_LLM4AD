def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = 2 * (ub - lb) * rng.rand(dim) + (lb + ub) / 2
    step_size = 10.0
    best_x = clip(x)
    best_f = func(best_x)
    for _ in range(budget):
        new_x = x + step_size * rng.randn(dim)
        new_x = clip(new_x)
        new_f = func(new_x)
        if new_f < best_f:
            best_x, best_f = new_x, new_f
        step_size *= 0.99
        x = new_x
    return best_x
