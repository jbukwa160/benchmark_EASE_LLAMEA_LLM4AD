def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    for _ in range(budget):
        g = 2 * (x - func(x))
        step_size = max(1e-5, min(10.0, np.linalg.norm(g) / np.sqrt(dim)))
        x -= step_size * g
        x = np.clip(x, lb, ub)
        if func(x) < func(best_x):
            best_x = x.copy()
    return best_x
