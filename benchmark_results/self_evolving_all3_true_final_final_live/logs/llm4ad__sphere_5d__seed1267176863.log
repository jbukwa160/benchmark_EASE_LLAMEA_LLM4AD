def algorithm(func, dim, lb, ub, budget, rng):
    x = 5 * (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget - 1):
        step_size = max(0.01, np.sqrt(np.prod((ub - lb) ** 2)) / (_ + 1))
        new_x = x + step_size * rng.randn(dim)
        new_x = np.clip(new_x, lb, ub)

        if func(new_x) < best_f:
            best_f = func(new_x)
            best_x = new_x.copy()

        x = new_x

    return best_x
