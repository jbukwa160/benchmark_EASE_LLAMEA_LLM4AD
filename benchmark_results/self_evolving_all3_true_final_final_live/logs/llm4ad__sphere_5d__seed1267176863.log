def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.clip(candidate, lb, ub)

    current = rng.uniform(lb, ub, size=dim)
    temperature = 1e3
    best_solution = current.copy()
    best_value = func(current)

    for _ in range(budget):
        candidate = clip_candidate(current + rng.normal(0, 2e-2, size=dim))
        new_value = func(candidate)

        if new_value < best_value:
            best_solution = candidate
            best_value = new_value

        delta = new_value - best_value
        probability = np.exp(-delta / temperature)
        if rng.uniform(0, 1) < probability:
            current = candidate
            temperature *= 0.99

    return best_solution
