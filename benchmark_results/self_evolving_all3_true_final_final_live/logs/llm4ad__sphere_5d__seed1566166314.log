def algorithm(func, dim, lb, ub, budget, rng):
    D = np.zeros((budget, dim))
    Y = np.empty(budget)
    
    for i in range(1, budget+1):
        # Initial guess
        if i == 1:
            x = (ub + lb) / 2 * np.ones(dim)
        else:
            # Gaussian Process regression
            mean, var = gp_regression(D[:i-1], Y[:i-1])
            
            # Expected Improvement acquisition function
            def expected_improvement(x):
                mu, sigma = func(x), np.sqrt(var(np.atleast_2d(x)))
                return (mu - min(Y[:i-1])) * norm.cdf((mu - min(Y[:i-1]) + 1e-6) / sigma) + sigma * norm.pdf((mu - min(Y[:i-1]) + 1e-6) / sigma)
            
            # Acquisition function maximisation
            x = rng.uniform(lb, ub, size=dim)
            best_x = x.copy()
            best_y = expected_improvement(x)
            
            for _ in range(1000):
                x = rng.uniform(lb, ub, size=dim)
                y = expected_improvement(x)
                
                if y > best_y:
                    best_x = x
                    best_y = y
            
            # Clip candidate to bounds
            best_x = np.clip(best_x, lb, ub)
        
        D[i-1] = best_x
        Y[i-1] = func(best_x)
    
    return D[np.argmin(Y)]
