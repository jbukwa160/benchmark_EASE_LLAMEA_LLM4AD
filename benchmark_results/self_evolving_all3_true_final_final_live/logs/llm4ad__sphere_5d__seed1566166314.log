def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    for i in range(budget):
        x_new = rng.uniform(lb, ub, size=dim)
        f_new = func(x_new)
        if f_new < x_best[-1]:
            x_best = x_new
    return x_best
