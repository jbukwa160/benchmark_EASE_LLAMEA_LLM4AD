def algorithm(func, dim, lb, ub, budget, rng):
    D = len(dim)
    n_params = 2 * D + 1
    mu = np.zeros(n_params) if rng is None else rng.rand(n_params)
    sigma = [10.0] * (D + 1)

    for i in range(1, D + 1):
        sigma[i] *= mu[i]

    for _ in range(budget):
        offspring = []
        for _ in range(D):
            new_mu = np.copy(mu[:D])
            noise = rng.randn(D)
            for i in range(D):
                new_mu[i] += noise[i] * sigma[i]
                new_mu[i] = np.clip(new_mu[i], lb, ub)

            z = np.random.normal(0, 1, D)
            new_lambda = mu[D:]
            for i in range(D, n_params):
                new_lambda[i - D] += np.dot(z, mu[:i - D]) / sigma[i - D]

            new_x = mu[:D]
            for i in range(n_params):
                new_x[i % D] += new_mu[i % D] * (new_lambda[i] + 1)

            offspring.append(new_x)

        cov = np.cov(np.array(offspring).T)
        cho, lower = cho_factor(cov)
        mean_offspring = np.mean(np.array(offspring), axis=0)

        x_star = np.zeros(n_params)
        for i in range(D):
            z = np.dot(cho_solve((cho, lower), rng.randn(D))[:D], cov[i, :D])
            x_star[i] = mu[i] + (mean_offspring[i] - mu[i]) / sigma[i] * z

        x_star[D:] = 0
        for i in range(n_params):
            x_star[i % D] = np.clip(x_star[i % D], lb, ub)

        new_sigma = np.zeros(D + 1)
        for i in range(D, n_params):
            new_sigma[i - D] += x_star[i]

        mu[:D] = mean_offspring
        mu[D:] = new_sigma

    return mu[:D]
