def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    def objective(x):
        x = clip(x)
        return func(x)

    n_dim, n_gen = dim, int(budget / (dim + 1))
    mean, cov = np.zeros(n_dim), np.eye(n_dim) * 0.5
    step_size, cum_step = 1.0, 0.0

    for _ in range(n_gen):
        sigma = 10 ** (cum_step / budget)
        dist = rng.normal(size=(int(budget / n_gen), n_dim))
        x_candidates = mean + sigma * np.dot(dist, cov)

        fitness = [objective(x) for x in x_candidates]
        idx_best = np.argmin(fitness)

        if fitness[idx_best] < objective(mean):
            mean, cov, step_size = x_candidates[idx_best], 0.5 * cov, 0.9 * step_size
            cum_step += 1

    return clip(mean)
