def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_f = float('inf')
    
    for _ in range(budget // (dim + 1)):
        x = np.random.uniform(lb, ub, size=dim)
        
        for t in range(1, budget):
            new_x = x + rng.normal(size=dim) * 0.01
            new_x = np.clip(new_x, lb, ub)
            
            f_new = func(new_x)
            alpha = 0.9 if f_new < best_f else 1.0
            
            if f_new < best_f:
                best_f = f_new
                best_x = new_x
                
            if rng.random() < np.exp((best_f - f_new) / (alpha ** t)):
                x = new_x
                
    return best_x
