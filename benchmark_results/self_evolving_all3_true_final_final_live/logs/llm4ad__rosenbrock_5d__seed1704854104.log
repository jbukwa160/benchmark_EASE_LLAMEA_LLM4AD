def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.array([0.5 * (ub + lb)] * dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_cand = np.clip(rng.uniform(size=dim, low=lb, high=ub), a_min=lb, a_max=ub)
        f_cand = func(x_cand)
        
        if f_cand < f_best:
            x_best = x_cand
            f_best = f_cand

    return x_best
