def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget - 1):
        uncertainties = [0.0] * dim
        for i in range(dim):
            new_x = clip(x.copy())
            new_x[i] += rng.uniform(-5, 5) / (1 + np.abs(new_x[i]))
            f = func(new_x)
            if f < best_f:
                best_x = new_x
                best_f = f
            uncertainties[i] = np.abs(f - func(clip(new_x + rng.normal(size=dim))))
        
        idx = np.argmax(uncertainties)
        x[idx] += rng.uniform(-5, 5) / (1 + np.abs(x[idx]))
    
    return best_x
