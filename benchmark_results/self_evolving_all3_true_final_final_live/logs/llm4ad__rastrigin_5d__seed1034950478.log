def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        v = rng.normal(size=dim)
        u = np.clip(best_x + 0.5 * rng.normal() + 0.3 * np.dot(v, best_x), lb, ub)
        f_u = func(u)
        
        if f_u < best_f:
            best_f = f_u
            best_x = u.copy()
            
        for i in range(dim):
            v = np.delete(v, rng.choice(range(dim)))
            u_i = clip(best_x + 0.5 * v[i] + 0.3 * (best_x[i] - u[i]))
            f_u_i = func(u_i)
            
            if f_u_i < best_f:
                best_f = f_u_i
                best_x = u_i.copy()
                
    return best_x
