def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population():
        population = np.random.uniform(lb, ub, (budget, dim))
        fitness = np.array([func(individual) for individual in population])
        return population, fitness

    def differential_evolution(population, fitness):
        def crossover(parent1, parent2):
            child = (parent1 + parent2) / 2
            return child

        def mutation(child, mu):
            child += np.random.normal(0, mu)
            return child

        for i in range(budget):
            parent1, parent2, child = population[np.random.choice(range(budget), size=3, replace=False)]
            child = crossover(parent1, parent2)
            child = mutation(child, rng.rand() * 10 + 1)
            child = clip(child)
            fitness_child = func(child)
            if fitness_child < fitness[i]:
                population[i] = child
                fitness[i] = fitness_child

    def novel_adaptive_mutation(population, fitness):
        for i in range(budget):
            mu = np.mean(np.abs(population[i] - population))
            child = population[i]
            child += np.random.normal(0, mu * rng.rand())
            child = clip(child)
            fitness_child = func(child)
            if fitness_child < fitness[i]:
                population[i] = child
                fitness[i] = fitness_child

    def hybrid_algorithm():
        population, fitness = generate_initial_population()
        for _ in range(budget):
            differential_evolution(population, fitness)
            novel_adaptive_mutation(population, fitness)

    best_individual = None
    best_fitness = np.inf
    for i in range(budget):
        individual = rng.rand(dim)
        individual = clip(individual)
        fitness_individual = func(individual)
        if fitness_individual < best_fitness:
            best_individual = individual
            best_fitness = fitness_individual

    return best_individual
