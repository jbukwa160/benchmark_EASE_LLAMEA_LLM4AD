def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def sample():
        return rng.uniform(lb, ub, size=dim)

    def evaluate(x):
        x = clip(x)
        return func(x)

    best_x = None
    best_f = float('inf')
    restarts = 0

    while budget > 0 and restarts < 5:
        population_size = min(100, budget // 10)
        sigma = (ub - lb) / 3.0
        mu = np.zeros(dim)

        for _ in range(population_size):
            x = sample()
            f = evaluate(x)
            if f < best_f:
                best_x = x
                best_f = f

        def update_sigma(f_mean, f_std):
            sigma *= (f_mean / 1.0) ** 0.1 * np.exp(-0.5)

        def select_parents():
            population_size = min(100, budget // 10)
            scores = evaluate(np.array([sample() for _ in range(population_size)]))
            indices = rng.choice(population_size, size=population_size, replace=False, p=np.exp(scores - scores.max()))
            parents = [clip(sample()) for _ in indices]
            return np.mean(scores), np.std(scores), np.mean(parents, axis=0)

        f_mean, f_std, mu = select_parents()
        update_sigma(f_mean, f_std)
        sigma = min(sigma, (ub - lb) / 2.0)
        budget -= population_size

        def generate_offspring(mu, sigma):
            return clip(mu + rng.normal(0, sigma, size=(population_size, dim)))

        offspring = generate_offspring(mu, sigma)

        for i in range(population_size):
            if evaluate(offspring[i]) < best_f:
                best_x = offspring[i]
                best_f = evaluate(best_x)

        restarts += 1

    return best_x
