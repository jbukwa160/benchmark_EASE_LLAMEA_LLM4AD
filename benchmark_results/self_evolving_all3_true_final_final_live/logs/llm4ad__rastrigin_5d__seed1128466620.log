def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    D = np.random.uniform(-1, 1, (dim,))
    pop = [clip(D + np.random.normal(0, 0.5, (dim,)), lb, ub)]
    
    for i in range(budget - 1):
        F = random.uniform(0.1, 2)
        CR = rng.rand()
        
        children = []
        for j in range(len(pop)):
            child = pop[j] + F * np.random.normal(0, 1, (dim,))
            child = clip(child, lb, ub)
            
            if rng.rand() < CR:
                idxs = list(range(dim))
                random.shuffle(idxs)
                
                for k in range(dim):
                    if rng.rand() < 0.5:
                        child[k] = pop[j][idxs[k]]
                    
            children.append(child)
        
        pop.extend(children)
        
        scores = [func(clip(x, lb, ub)) for x in pop]
        idxs = np.argsort(scores)[:len(pop) - len(scores)]
        pop = [pop[i] for i in idxs]
    
    return min(pop, key=func)
