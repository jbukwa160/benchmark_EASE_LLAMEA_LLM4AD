def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    for _ in range(budget):
        step_size = 0.5 / (1 + _ / budget) * 2 * (ub - lb)
        candidate = lb + (ub - lb) * rng.uniform(0, 1, size=dim)
        new_value = func(candidate)
        if new_value < x_best[-np.inf]:
            x_best = candidate
        elif new_value > x_best[0] and rng.rand() < np.exp(new_value - x_best[0]):
            x_best = candidate
        else:
            candidate = lb + (ub - lb) * (candidate - lb)
            while candidate.dot(candidate) <= 0.1:
                candidate = candidate + step_size * rng.randn(dim)
                candidate = lb + (ub - lb) * np.clip(candidate, lb, ub)
    return x_best
