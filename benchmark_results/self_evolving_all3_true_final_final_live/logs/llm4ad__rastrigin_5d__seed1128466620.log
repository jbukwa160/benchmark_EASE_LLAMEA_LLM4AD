def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        return func(clip(x))

    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x
    best_f = evaluate(x)
    temp = 1.0

    for _ in range(budget):
        v = rng.normal(size=x.shape) + x
        f_v = evaluate(v)

        if f_v < best_f:
            best_x = v
            best_f = f_v
        else:
            delta = f_v - best_f
            prob = np.exp(-delta / temp)
            if rng.uniform(0, 1) < prob:
                x = v

        temp *= 0.99999  # cooling schedule

    return best_x
