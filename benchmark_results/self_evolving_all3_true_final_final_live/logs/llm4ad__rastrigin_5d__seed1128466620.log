def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        return func(clip(x))

    n = len(rng)
    population_size = 10 * dim
    step_sizes = [1.0] * dim

    for _ in range(budget):
        # Random search to get initial population and adjust step sizes
        candidates = rng.randint(-5, 6, size=(population_size, dim))
        fitnesses = np.array([evaluate(x) for x in candidates])

        # Update step sizes based on the worst individual's distance from the best
        distances = np.linalg.norm(candidates[np.argmax(fitnesses)] - candidates, axis=1)
        for i in range(dim):
            step_sizes[i] *= 0.99 if np.mean(distances) < 5 else 1.01

        # CMA-ES adaptation
        for _ in range(population_size):
            candidate = rng.normal(size=(dim,))
            candidate += candidates[np.argmax(fitnesses)]
            for i in range(dim):
                candidate[i] *= step_sizes[i]
            fitness = evaluate(candidate)
            if fitness < np.min(fitnesses):
                candidates[np.argmin(fitnesses)] = candidate
                fitnesses[np.argmin(fitnesses)] = fitness

        # Restart search when no improvement is made for 5 consecutive iterations
        if (np.max(fitnesses) - np.min(fitnesses)) / evaluate(np.zeros(dim)) < 0.01:
            candidates = rng.randint(-5, 6, size=(population_size, dim))
            fitnesses = np.array([evaluate(x) for x in candidates])

    return clip(candidates[np.argmin(fitnesses)])
