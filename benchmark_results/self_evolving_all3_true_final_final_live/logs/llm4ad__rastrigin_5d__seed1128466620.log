def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        return func(x)

    best_x = rng.uniform(lb, ub, size=dim)
    best_f = float('inf')

    for _ in range(budget):
        a = rng.choice(np.arange(dim), p=rng.dirichlet(np.ones(dim)))
        u = clip(best_x + 0.5 * (ub - lb) * rng.randn(dim))
        v = clip(u + 0.5 * (ub - lb) * rng.randn(dim))
        f_u = evaluate(clip(v - a * (v - u)))
        f_v = evaluate(clip(v - a * (v - u)))

        if min(f_u, f_v) < best_f:
            best_f = min(f_u, f_v)
            best_x = clip((v - a * (v - u)) if f_u < f_v else (u - a * (u - v)))

    return best_x
