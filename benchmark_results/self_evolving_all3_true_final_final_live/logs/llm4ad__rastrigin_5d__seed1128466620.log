def algorithm(func, dim, lb, ub, budget, rng):
    def accept(candidate, current, T):
        if func(candidate) < func(current):
            return True
        else:
            delta = func(current) - func(candidate)
            return np.exp(-delta / (T + 1e-7)) > rng.random()

    def step(current, sigma, dim, lb, ub, budget):
        candidate = current + sigma * np.random.normal(size=dim)
        for i in range(dim):
            if candidate[i] < lb:
                candidate[i] = lb
            elif candidate[i] > ub:
                candidate[i] = ub
        return candidate

    def adapt(sigma, dim, T, budget):
        cov = np.eye(dim) * 1e-7
        for _ in range(int(budget / dim)):
            i = rng.randint(0, dim)
            j = rng.randint(0, dim)
            if i != j:
                delta_cov = np.outer(np.random.normal(size=dim), np.random.normal(size=dim))
                cov += delta_cov
        sigma *= np.sqrt((np.diag(cov) + 1e-7) / (T + 1e-7))
        return sigma, cov

    current = rng.uniform(lb, ub, size=dim)
    best = current.copy()
    budget -= dim
    T = 1000.0
    sigma = 10.0
    cov = np.eye(dim) * 1e-7

    for _ in range(int(budget)):
        sigma, cov = adapt(sigma, dim, T, int(budget))
        candidate = step(current, sigma, dim, lb, ub, int(budget))
        if accept(candidate, best, T):
            current = candidate
            if func(candidate) < func(best):
                best = candidate.copy()
        else:
            T *= 0.99

    return np.array(best)
