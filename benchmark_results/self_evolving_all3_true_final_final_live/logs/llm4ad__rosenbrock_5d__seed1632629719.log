def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    max_iter = int(budget / (dim * pop_size))
    sigma = 0.5
    T = 100.0
    cooling_rate = 0.9
    
    x = np.random.uniform(lb, ub, (pop_size, dim))
    f_x = func(x)
    
    for _ in range(max_iter):
        for i in range(pop_size):
            v = rng.normal(0, sigma, dim)
            u = x[i] + v
            u[~np.isfinite(u)] = 0  # clip to avoid NaNs
            
            # bound the candidate solution
            u = np.clip(u, lb, ub)
            
            f_u = func(u)
            if f_u < f_x[i]:
                x[i], f_x[i] = u, f_u
                
        for i in range(pop_size):
            T *= cooling_rate
            v = rng.normal(0, sigma / T, dim)
            u = x[i] + v
            
            # bound the candidate solution
            u = np.clip(u, lb, ub)
            
            f_u = func(u)
            if f_u < f_x[i]:
                x[i], f_x[i] = u, f_u
                
    best_idx = np.argmin(f_x)
    return x[best_idx]
