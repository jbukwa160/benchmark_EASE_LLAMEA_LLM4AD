def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidate(x):
        return np.clip(x, a_min=lb, a_max=ub)

    # Initialize population and temperatures
    pop = np.random.uniform(lb, ub, (50, dim))
    temps = np.array([1e6] * 50)
    
    for _ in range(budget):
        # Selection
        fitnesses = [func(get_candidate(x)) for x in pop]
        min_fitness = np.min(fitnesses)
        
        # Differential Evolution (DE) step
        if rng.uniform(0, 1) < 0.5:
            idx = np.random.choice(50, size=4, replace=False)
            new_pop = pop[idx] + 0.7 * (pop[idx[1:]] - pop[idx[:-1]])
            for i in range(len(pop)):
                if rng.uniform(0, 1) < 0.05:
                    new_pop[i] = np.random.uniform(lb, ub, dim)
        else:
            # Simulated Annealing (SA) step
            idx = np.argmin(fitnesses)
            for i in range(len(pop)):
                if rng.uniform(0, 1) < 0.2 * temps[idx]:
                    new_pop[i] = pop[i] + rng.normal(loc=0, scale=0.5, size=dim)
        
        # Update population and temperatures
        pop = get_candidate(new_pop)
        fitnesses = [func(get_candidate(x)) for x in pop]
        min_fitness_new = np.min(fitnesses)
        if min_fitness_new < min_fitness:
            idx_min = np.argmin(fitnesses)
            temps[idx] = 0.8 * temps[idx]
            temp = rng.uniform(0, 1e6)
            while rng.uniform(0, 1) > np.exp((min_fitness - min_fitness_new) / temp):
                temp *= 0.9
                idx_min = np.random.choice(len(pop))
                pop[idx_min] = get_candidate(pop[idx_min])
                fitnesses[idx_min] = func(get_candidate(pop[idx_min]))
        else:
            temps /= 1.001
            
    return np.argmin(fitnesses)
