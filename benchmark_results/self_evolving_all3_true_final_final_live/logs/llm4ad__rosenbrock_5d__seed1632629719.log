def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=(dim,))
    T = 1.0
    alpha = 0.99
    mutation_prob = 0.01
    step_size = 0.1
    iteration = 0

    while iteration < budget:
        iteration += 1
        y = x.copy()
        for i in range(dim):
            if rng.random() < mutation_prob:
                delta = rng.uniform(-step_size, step_size)
                y[i] = clip(y[i] + delta)
        
        f_x = func(x)
        f_y = func(clip(y))
        if f_y < f_x:
            x = y
        else:
            acceptance_prob = np.exp((f_x - f_y) / T)
            if rng.random() < acceptance_prob:
                x = y
            else:
                T *= alpha
        
    return clip(x)
