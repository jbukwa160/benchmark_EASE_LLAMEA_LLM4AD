def algorithm(func, dim, lb, ub, budget, rng):
    def wrapper(x):
        return func(x)

    pop_size = int(np.sqrt(budget))
    x = rng.uniform(lb, ub, (pop_size, dim))

    for _ in range(budget):
        y = x.copy()
        for i in range(pop_size):
            idx = rng.randint(0, pop_size)
            v = x[idx] + 0.5 * (rng.normal(size=dim) - rng.uniform(-1, 1, size=dim))
            v = np.clip(v, lb, ub)
            y[i] = wrapper(y[i]) < wrapper(v) and v or y[i]

        for i in range(pop_size):
            if rng.random() < 0.05:
                idx = rng.randint(0, pop_size)
                x[i] = x[idx] + 0.1 * (rng.normal(size=dim) - rng.uniform(-1, 1, size=dim))
                x[i] = np.clip(x[i], lb, ub)

        x = np.clip(x, lb, ub)

    return x[np.argmin([wrapper(x_) for x_ in x])][0]
