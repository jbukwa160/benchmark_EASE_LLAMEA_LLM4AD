def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    for i in range(budget):
        step_size = 2 / (i + 1) * rng.uniform(0.01, 5.0)
        x_new = x_best + np.multiply(rng.randn(dim), step_size)
        x_new = np.clip(x_new, lb, ub)
        f_new = func(x_new)
        if f_new < f_best:
            x_best = x_new
            f_best = f_new
    return x_best
