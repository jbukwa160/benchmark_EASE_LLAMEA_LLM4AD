def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    x_best = clip(x.copy())
    f_x_best = func(clip(x_best))

    for _ in range(budget - 1):
        v = rng.normal(size=dim)
        while True:
            u = rng.uniform(0, dim)
            idx = np.arange(dim)[u < (rng.uniform(0, 1) * dim)]
            if all(np.abs(idx - np.arange(dim)) != i for i in range(dim)):
                break

        v[idx] += x_best[idx]
        f_v = func(clip(v))

        cr = rng.uniform(0, 1)
        if f_v < (cr * f_x_best) + ((1 - cr) * rng.uniform(lb, ub)):
            x_best = clip(v.copy())
            f_x_best = func(clip(x_best))

    return x_best
