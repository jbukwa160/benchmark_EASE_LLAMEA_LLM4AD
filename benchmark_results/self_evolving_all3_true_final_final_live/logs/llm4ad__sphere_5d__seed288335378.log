def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    for i in range(budget):
        x = (ub - lb) * rng.rand(dim) + lb
        f_x = func(x)
        if f_x < func(x_best):
            x_best = x
    return x_best
