def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.maximum(np.minimum(candidate, ub), lb)

    x = 5 * np.random.rand(dim) - 5  # Initialize with random values between lb and ub
    best_x = x.copy()
    best_f = func(x)
    
    T = 100.0  # Initial temperature for SA
    alpha = 0.99  # Cooling rate
    
    for _ in range(budget):
        y = clip(x + 1e-6 * (ub - lb) * rng.standard_normal(dim), lb, ub)
        
        if func(y) < best_f:
            best_f = func(y)
            best_x = y.copy()
        
        delta = func(y) - best_f
        if delta < 0 or np.random.rand() < np.exp(-delta / T):
            x = y
            
        T *= alpha
        
    return best_x
