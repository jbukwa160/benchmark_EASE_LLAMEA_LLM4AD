def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = clip(rng.normal(0, 10, size=dim))
    lambda_ = min(int(budget / (func(x) + 1e-8)), 100)
    mean = x
    cov = np.eye(dim) * 5
    success_count = 0

    for _ in range(budget):
        offspring = np.random.multivariate_normal(mean, cov, size=lambda_)
        offspring = clip(offspring)

        fitness = func(offspring)
        indices = np.argsort(fitness)[:int(lambda_/2)]

        new_mean = mean + (offspring[indices] - mean) / lambda_
        if sum(fitness[indices]) < sum(func(new_mean + 0.1 * np.random.normal(0, cov[np.eye(dim), :, :]))):
            success_count += 1
            mean = new_mean
            cov = cov * 2

        if success_count >= int(lambda_/5):
            lambda_ *= 2
            success_count = 0

    return clip(mean)
