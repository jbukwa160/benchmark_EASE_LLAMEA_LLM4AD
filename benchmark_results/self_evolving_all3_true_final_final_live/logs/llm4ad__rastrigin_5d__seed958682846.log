def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    pop_size = 50
    x0 = (ub - lb) * rng.rand(pop_size, dim) + lb
    best_x = x0[0]
    best_f = objective(best_x)
    
    for i in range(budget // pop_size):
        v = np.zeros((pop_size, dim))
        for j in range(pop_size):
            # DE part
            r1, r2, r3 = rng.randint(0, pop_size, 3)
            while r1 == j or r2 == j or r3 == j:
                r1, r2, r3 = rng.randint(0, pop_size, 3)
            v[j] = x0[r1] + 0.5 * (x0[r2] - x0[r3]) / np.linalg.norm(x0[r2] - x0[r3])

        # SA part
        T = 100.0
        for j in range(pop_size):
            if rng.rand() < np.exp((best_f - objective(v[j])) / T):
                v[j] = x0[rng.randint(0, pop_size)]
        
        x0 = v
        best_f_new = np.inf
        for j in range(pop_size):
            f_new = objective(x0[j])
            if f_new < best_f_new:
                best_f_new = f_new
                best_x = x0[j]
    
    return best_x
