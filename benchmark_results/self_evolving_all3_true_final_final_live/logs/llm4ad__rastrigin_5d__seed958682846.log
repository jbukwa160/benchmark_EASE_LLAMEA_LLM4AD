def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.minimum(np.maximum(x, lb), ub)

    def local_optimize(x, func, lb, ub, rng):
        learning_rate = 0.01
        for _ in range(100):
            x_new = x + learning_rate * (x - 2 * rng.randn(dim))
            x_new = clip(x_new, lb, ub)
            if func(x_new) < func(x):
                x = x_new
        return x

    def differential_evolution(func, bounds, n_pop=50, n_gen=100, f_mut=0.5, f_crossover=0.9, rng=rng):
        pop = [rng.uniform(bounds[i][0], bounds[i][1]) for i in range(dim)]
        best = pop[np.argmin([func(x) for x in pop])]
        for _ in range(n_gen):
            mutant = [best + f_mut * (x - best) if rng.random() < 0.5 else x for x in pop]
            crossover = [(1-f_crossover)*x[0] + f_crossover*mutant[i][0] for i, x in enumerate(pop)]
            new_pop = [(2*c - x) if rng.random() < 0.5 else c for c, x in zip(crossover, pop)]
            new_pop = [clip(x, bounds[i][0], bounds[i][1]) for i, x in enumerate(new_pop)]
            best_new = np.argmin([func(x) for x in new_pop])
            if func(new_pop[best_new]) < func(best):
                best = new_pop[best_new]
        return best

    population_size = 10 * dim
    bounds = [(lb, ub)] * dim
    pop = [rng.uniform(lb, ub) for _ in range(population_size)]
    for i in range(budget):
        offspring = differential_evolution(func, bounds, rng=rng)
        local_best = local_optimize(offspring, func, lb, ub, rng)
        if func(local_best) < func(np.array(pop[np.argmin([func(x) for x in pop])])):
            pop[np.argmin([func(x) for x in pop])] = local_best
    return np.array(pop[np.argmin([func(x) for x in pop])])
