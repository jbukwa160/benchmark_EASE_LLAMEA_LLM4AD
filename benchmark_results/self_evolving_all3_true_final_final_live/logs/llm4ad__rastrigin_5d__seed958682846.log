def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    T = 1.0
    alpha = 0.99
    sigma = 5.0

    for _ in range(budget):
        new_x = best_x + rng.normal(size=(dim,))
        new_x = np.clip(new_x, lb, ub)
        
        new_f = func(new_x)

        if new_f < best_f:
            best_f = new_f
            best_x = new_x
        elif np.exp((best_f - new_f) / T) > rng.random():
            best_f = new_f
            best_x = new_x

        T *= alpha
        sigma -= 0.001

    return best_x
