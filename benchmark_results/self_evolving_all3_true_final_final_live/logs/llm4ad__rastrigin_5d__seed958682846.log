def algorithm(func, dim, lb, ub, budget, rng):
    def clip(cand, lb, ub):
        return np.clip(cand, a_min=lb, a_max=ub)

    x = rng.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        v = rng.normal(size=x.shape)
        u = clip(x + 0.5 * v, lb, ub)
        f = func(u)
        
        if f < best_f:
            best_f = f
            best_x = u
            
        alpha = np.exp(-1e-3 * _ / budget)  # annealing schedule
        if rng.uniform(0, 1) < alpha and not np.array_equal(x, best_x):
            x = (best_x + rng.uniform(0, 1, size=x.shape)) / 2
            
    return best_x
