def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    F = 1.5
    CR = 0.9
    
    x = rng.uniform(lb, ub, (pop_size, dim))
    
    for i in range(budget):
        y = np.array([func(x[j]) for j in range(pop_size)])
        
        p = np.argmin(y)
        best = x[p]
        
        for j in range(pop_size):
            u, v, w = rng.choice(range(pop_size), 3, replace=False)
            
            if rng.rand() < CR or func(x[u]) != func(best):
                z = x[j] + F * (x[v] - x[w])
                
                if func(z) < y[j]:
                    x[j] = z
                    y[j] = func(z)
        
        x = np.clip(x, lb, ub)
    
    return best
