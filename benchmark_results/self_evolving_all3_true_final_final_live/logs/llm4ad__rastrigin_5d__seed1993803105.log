def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def polynomial_mutation(candidate, sigma):
        noise = rng.uniform(-1, 1, size=dim) * sigma + 1
        return candidate * noise

    current_best = np.array([0.5] * dim)
    best_fitness = func(current_best)

    for _ in range(budget):
        candidate = clip(polynomial_mutation(clip(rng.uniform(lb, ub, size=dim)), 0.2))
        fitness = func(candidate)

        if fitness < best_fitness:
            current_best = candidate
            best_fitness = fitness

    return current_best
