def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_y = func(x)
    
    for _ in range(budget):
        y = func(clip(x + 0.1 * rng.normal(size=dim)))
        
        if y < best_y:
            best_y = y
            best_x = x.copy()
            
        alpha = np.exp(-_ / budget)
        x = (1 - alpha) * clip(best_x) + alpha * clip(rng.normal(size=(dim,)))
    
    return best_x
