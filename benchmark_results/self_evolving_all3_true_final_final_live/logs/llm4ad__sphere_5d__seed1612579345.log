def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    min_value = func(x)

    for _ in range(budget):
        new_x = x + rng.normal(size=dim) * 0.01
        new_x = np.clip(new_x, lb, ub)
        
        if func(new_x) < min_value:
            min_value = func(new_x)
            best_x = new_x.copy()
            
        elif rng.uniform(0, 1) > np.exp((min_value - func(new_x)) / 100):
            min_value = func(new_x)
            best_x = new_x.copy()

        x = best_x

    return best_x
