def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_y = float('inf')
    
    learn_rate = 1.0
    noise_std = 0.5
    
    for _ in range(budget // 10 + 1):
        x = np.zeros(dim)
        
        for i in range(dim):
            if rng.rand() < 0.2:  # 20% chance of restart
                x[i] = lb + (ub - lb) * rng.rand()
            else:
                x[i] += learn_rate * (rng.randn() * noise_std)
                x[i] = np.clip(x[i], lb, ub)
        
        y = func(x)
        
        if y < best_y:
            best_y = y
            best_x = x.copy()
        
        learn_rate *= 0.999
        
    return best_x
