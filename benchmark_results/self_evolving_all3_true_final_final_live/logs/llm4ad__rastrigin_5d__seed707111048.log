def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop = rng.uniform(lb, ub, (budget, dim))
    best_x = np.zeros(dim)
    best_y = float('inf')

    for _ in range(budget):
        y = func(clip(pop))
        if y < best_y:
            best_y = y
            best_x = clip(pop)

        z = pop.copy()
        for i in range(dim):
            mask = np.random.choice([True, False], size=dim, p=[0.5, 0.5])
            idx = np.where(mask)[0]
            if len(idx) > 1:
                x_idx = np.setdiff1d(np.arange(dim), i)
                u = rng.uniform(-10, 10, size=(len(x_idx)))
                z[idx, x_idx] += u
                z[i] += (ub - lb) * rng.uniform(0, 1)
        pop = clip(z)

    return best_x
