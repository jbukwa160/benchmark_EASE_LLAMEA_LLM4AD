def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    def generate_initial_population(dim, population_size, lb, ub, rng):
        return rng.uniform(lb, ub, (population_size, dim))

    def calculate_objective_value(candidate, func):
        return func(candidate)

    def differential_evolution(population, func, bounds, budget, rng):
        for _ in range(budget):
            z = np.random.choice(population)
            u = population[np.random.choice(len(population), replace=False)]
            v = population[np.random.choice(len(population), replace=False)]
            y = clip(z + 0.5 * (u - v), bounds[0], bounds[1])
            if calculate_objective_value(y, func) < calculate_objective_value(z, func):
                population[np.argmax(calculate_objective_value(p, func) for p in population)] = y
        return np.array(population).argmin(axis=0)

    def simulated_annealing(initial_guess, func, bounds, budget, rng):
        temperature = 1.0
        current_best = initial_guess
        best_solution = current_best
        for _ in range(budget):
            new_candidate = clip(current_best + np.random.uniform(-1, 1, dim), bounds[0], bounds[1])
            if calculate_objective_value(new_candidate, func) < calculate_objective_value(current_best, func):
                current_best = new_candidate
            elif rng.random() < np.exp((calculate_objective_value(current_best, func) - calculate_objective_value(new_candidate, func)) / temperature):
                current_best = new_candidate
            if calculate_objective_value(current_best, func) < calculate_objective_value(best_solution, func):
                best_solution = current_best
            temperature *= 0.99
        return best_solution

    population_size = int(np.ceil(budget ** (1 / dim)))
    initial_population = generate_initial_population(dim, population_size, lb, ub, rng)
    differential_evolution_population = differential_evolution(initial_population, func, [lb] * dim + [ub] * dim, budget // 2, rng)
    simulated_annealing_solution = simulated_annealing(differential_evolution_population, func, [lb] * dim + [ub] * dim, budget - (budget // 2), rng)

    return simulated_annealing_solution
