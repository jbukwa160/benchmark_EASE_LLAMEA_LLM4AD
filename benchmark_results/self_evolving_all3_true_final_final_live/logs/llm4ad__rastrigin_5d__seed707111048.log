def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def rastrigin(x):
        f = 10 * dim + np.sum((x ** 2 - 10 * np.cos(2 * np.pi * x))[:dim])
        return f

    best_x = rng.uniform(lb, ub, size=dim)
    best_f = rastrigin(best_x)

    for _ in range(budget):
        y = clip(rng.normal(best_x, 0.5), lb, ub)
        z = clip(y + rng.normal(0, 1), lb, ub)
        f_y = rastrigin(y)
        f_z = rastrigion(z)
        if f_z < best_f:
            best_x = z
            best_f = f_z
        elif f_y < best_f:
            alpha = erfinv((rng.random() * 2 - 1) / np.sqrt(2))
            beta = rng.uniform(-1, 1)
            gamma = rng.uniform(-1, 1)
            y_prime = clip(best_x + alpha * (z - best_x) + beta * (y - z) + gamma * (best_x - y), lb, ub)
            f_y_prime = rastrigin(y_prime)
            if f_y_prime < best_f:
                best_x = y_prime
                best_f = f_y_prime

    return best_x
