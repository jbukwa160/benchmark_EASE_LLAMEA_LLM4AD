def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def gaussian_process(x):
        mean = 0
        std_dev = 1
        kernel_params = {'sigma_f': 1, 'lengthscale': 1}
        cov = std_dev**2 * np.exp(-np.sum((x[:, None] - x[None, :])**2 / (2 * kernel_params['lengthscale']**2)))
        return mean + np.random.multivariate_normal(np.zeros(dim), cov)

    def expected_improvement(x, best):
        gp_pred = gaussian_process(x)
        std_dev = 1
        kernel_params = {'sigma_f': 1, 'lengthscale': 1}
        cov = std_dev**2 * np.exp(-np.sum((x[:, None] - x[None, :])**2 / (2 * kernel_params['lengthscale']**2)))
        ei = gp_pred - best + 1.96 * std_dev
        return ei

    dim = int(dim)
    pop_size = 100
    mu = 0.5 * (ub - lb) + rng.uniform(0, 1, size=(pop_size, dim)) * (lb - ub)
    sigma = 2.38 * (ub - lb) / np.sqrt(pop_size)

    for _ in range(budget):
        X = clip(mu + rng.normal(size=(pop_size, dim), loc=0, scale=sigma))
        Y = func(X)
        best_idx = np.argmin(Y)
        mu = clip(X[best_idx] + 0.5 * sigma * (X - X[best_idx]).T.dot(np.linalg.solve((X[:, None] - X[None, :])**2 / (2 * sigma**2), (Y[best_idx] - Y).reshape(-1, 1))))
        sigma *= 0.9

    return clip(mu)
