def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    sigma_init = 5.0
    sigma_decay = 0.9999
    cr = 1.0
    f = lambda x: func(x)
    
    x_best = -np.inf * np.ones(dim)
    y_best = None
    
    for _ in range(budget):
        pop = rng.uniform(lb, ub, (pop_size, dim))
        
        # DE part
        v1 = pop[rng.randint(0, pop_size), :]
        v2 = pop[rng.randint(0, pop_size), :]
        v3 = pop[rng.randint(0, pop_size), :]
        
        x_new = v1 + cr * (v2 - v3)
        
        # CMA-ES part
        sigma = max(sigma_init * sigma_decay ** (_ / 10000), 1e-6)
        x_new += rng.normal(size=(dim,), loc=0, scale=sigma)
        
        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)
        
        fx_new = f(x_new)
        
        if fx_new < f(x_best):
            x_best = x_new
            y_best = pop[rng.randint(0, pop_size), :]
    
    return x_best
