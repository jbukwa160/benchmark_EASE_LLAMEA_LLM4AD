def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_evals = 0
    x_best = lb + (ub - lb) * rng.uniform(size=D)
    f_best = func(x_best)

    def adapt_step_size(f_mean, sigma):
        rho = 1e-5  # learning rate for the step size adaptation
        return max(0.01, min(sigma * np.exp(-f_mean / D), 10))

    def adapt_learning_rate(f_mean):
        r = 2 - f_mean / (D + 1)
        return min(max(r, 0.1), 100)

    while n_evals < budget:
        n_evals += 1
        for _ in range(50):  # number of generations
            x_new = x_best + rng.normal(size=D) * np.eye(D)
            f_new = func(x_new)
            if f_new < f_best:
                f_best = f_new
                x_best = x_new

            n_evals += 1
            if n_evals >= budget:
                break

        sigma = adapt_step_size(f_best, 0.5)  # initial step size
        lam = int(np.ceil(D ** (D + 4) / (np.pi * np.log(2 * D))))
        c1 = 2 / (D + 1.27)
        cMu = 1 / (D + 1.93)

        for _ in range(lam):
            x_new = x_best + rng.normal(size=D, loc=0, scale=sigma)
            f_new = func(x_new)
            if f_new < f_best:
                f_best = f_new
                x_best = x_new

        sigma *= adapt_learning_rate(f_best)

    # clip best solution to bounds
    return np.clip(x_best, lb, ub)
