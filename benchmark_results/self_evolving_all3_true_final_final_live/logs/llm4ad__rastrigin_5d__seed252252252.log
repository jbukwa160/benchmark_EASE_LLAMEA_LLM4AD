def algorithm(func, dim, lb, ub, budget, rng):
    def bound(x):
        return np.clip(x, lb, ub)

    D = dim
    mu = 1 / (2 * D)  # initial step size
    c_m = 0.1  # polynomial mutation distribution index
    N = int(budget / D)
    x_best = bound(np.random.rand(D))
    f_best = func(x_best)

    for _ in range(N):
        y = np.random.randn(D) + 1
        z = mu * np.exp(np.sum(y**2)) / (D + sum(abs(y)))
        x = x_best + z
        x = bound(x)
        fx = func(x)
        if fx < f_best:
            f_best = fx
            x_best = x

    for _ in range(N):
        x_mut = np.copy(x_best)
        for i in range(D):
            s = np.random.rand()
            if s < c_m / D:
                delta = (ub - lb) * (2 * rng.rand() - 1)**(c_m + 2)
                x_mut[i] += delta
                x_mut = bound(x_mut)
        fx = func(x_mut)
        if fx < f_best:
            f_best = fx
            x_best = x_mut

    return x_best
