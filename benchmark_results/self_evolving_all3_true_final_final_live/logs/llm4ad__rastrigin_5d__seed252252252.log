def algorithm(func, dim, lb, ub, budget, rng):
    n = len(dim)
    D = np.zeros(n) + 1.
    mu = (ub - lb) * rng.uniform(size=n) + lb
    sigma = (ub - lb) / np.sqrt(2.)
    while True:
        for _ in range(int(budget/2)):
            y = mu + sigma * rng.normal(size=n)
            f_y = func(y)
            if f_y < func(mu):
                mu, D, sigma = y, 1., (ub - lb) / np.sqrt(2.)
            D *= 0.5
            mu += (D * rng.normal(size=n)).dot(rng.uniform(-1, 1, size=n))[:n]
        if budget > 0:
            break
    return mu.clip(lb, ub)
