def algorithm(func, dim, lb, ub, budget, rng):
    def clipped_bounds(x):
        return np.clip(x, lb, ub)

    def fitness(x):
        x = clipped_bounds(x)
        return func(x)

    bounds = [(lb, ub) for _ in range(dim)]

    res1 = differential_evolution(fitness, bounds, maxiter=budget//2)
    pop_size = int(0.9 * budget / (budget//2))
    pop = rng.uniform(lb, ub, size=(pop_size, dim))

    for i in range(budget//2):
        best = res1.x
        candidates = np.concatenate((pop, [best]))
        scores = [fitness(x) for x in candidates]
        indices = np.argsort(scores)
        candidates = candidates[indices]

        if len(candidates) > pop_size:
            pop = candidates[:pop_size]

    return clipped_bounds(res1.x)
