def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    sigma = 0.1
    cr = 0.5
    t = 0
    best_x = np.random.uniform(lb, ub, (1, dim))
    best_f = func(best_x)

    while t < budget:
        x = np.random.uniform(lb, ub, (pop_size, dim))

        for i in range(pop_size):
            u = rng.choice(range(pop_size), size=3, replace=False)
            v = x[u]
            w = x[i]

            y = w + sigma * (v - w)

            cr_t = np.random.uniform(0, 1)

            if cr_t < cr:
                z = y
            else:
                z = w

            z = np.clip(z, lb, ub)
            f_z = func(z)

            if f_z < best_f:
                best_x = z
                best_f = f_z

        t += 1
    return best_x
