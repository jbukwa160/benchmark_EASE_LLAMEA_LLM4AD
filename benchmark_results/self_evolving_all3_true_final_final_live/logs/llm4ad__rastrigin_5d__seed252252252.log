def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    for _ in range(budget - 1):
        y = x + rng.randn(dim) * 0.5
        y = np.clip(y, lb, ub)
        if func(y) < func(x):
            x = y
    return x
