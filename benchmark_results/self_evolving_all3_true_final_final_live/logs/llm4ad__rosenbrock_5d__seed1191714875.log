def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.array([0.5] * dim)
    T = 10.0
    alpha = 0.99
    best_x = x.copy()
    best_f = func(clip(x))

    for _ in range(budget):
        new_x = clip(x + rng.uniform(-1, 1, size=dim))
        new_f = func(new_x)

        if new_f < best_f:
            best_f = new_f
            best_x = new_x.copy()

        delta_f = new_f - best_f

        if delta_f <= 0 or np.random.rand() * T > np.exp(-delta_f / (T * alpha)):
            x = new_x

        T *= alpha

    return best_x
