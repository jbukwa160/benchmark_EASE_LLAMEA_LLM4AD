def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([ub + 1e-8 if rng.random() < 0.5 else lb - 1e-8] * dim)
    mu = np.copy(x)
    sigma = 10.0
    lambda_ = 100
    D = 1.0
    cum_sol = [x]
    best_x = x

    for i in range(budget):
        # Sample candidates
        z = rng.normal(size=dim) * sigma / np.sqrt(lambda_)
        x_new = mu + z

        # Clip candidates to bounds
        x_new = np.clip(x_new, lb, ub)

        # Evaluate function value and update best solution
        f_new = func(x_new)
        cum_sol.append(x_new)
        if f_new < func(best_x):
            best_x = x_new

        # Update parameters
        D += 1.0 / (i + 2) ** 2
        sigma *= np.exp(-D / (4 + i))
        mu = (lambda_ * z + mu) / (lambda_ + 1)

    return best_x
