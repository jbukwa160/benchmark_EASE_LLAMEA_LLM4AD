def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(1e4)
    sigma = 0.2
    lr = 1.0
    best_x = None
    best_f = float('inf')

    for i in range(budget):
        x = rng.uniform(lb, ub, size=(pop_size, dim))

        # Adaptive learning rate
        v = np.mean((x - lb) ** 2, axis=1)
        sigma *= (0.9 + 0.1 * lr / (lr + np.std(v)))

        f = func(x)

        idx = np.argsort(f)[:int(pop_size * 0.1)]

        x_new = x[idx]
        x_new += rng.normal(0, sigma, size=(len(idx), dim))

        # Clip candidates to [lb, ub]
        x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)

        idx = np.argsort(f_new)[:int(pop_size * 0.1)]

        x[idx] = x_new[idx]

        if i % 100 == 0:
            print(f'Iteration {i}, Best f: {np.min(f)}')

        idx = np.argmin(f)
        best_x_new = x[idx]
        best_f_new = f[idx]

        if best_f_new < best_f or i == budget - 1:
            best_f = best_f_new
            best_x = best_x_new

    return best_x
