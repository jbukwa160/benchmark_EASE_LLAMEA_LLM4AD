def algorithm(func, dim, lb, ub, budget, rng):
    num_searches = 5
    pop_size = int(budget / (num_searches * dim))
    sigma_schedule = [1, 0.9, 0.7, 0.5, 0.3]
    
    def clip(x):
        return np.clip(x, lb, ub)
    
    def evaluate(individuals):
        fitness = np.zeros((len(individuals),))
        for i in range(len(individuals)):
            fitness[i] = func(clip(individuals[i]))
        return fitness
    
    def simulate_annealing(num_iterations, num_searches, sigma):
        individuals = rng.uniform(lb, ub, (pop_size, dim))
        best_individual = np.zeros((dim,))
        
        for _ in range(num_iterations):
            for i in range(num_searches):
                new_individuals = individuals + rng.normal(0, sigma, (pop_size, dim))
                fitness = evaluate(new_individuals)
                indices = np.argsort(fitness)[:int(pop_size/num_searches)]
                individuals[indices] = new_individuals[indices]
            
            best_fitness = np.min(evaluate(individuals))
            if best_fitness < func(clip(best_individual)):
                best_individual = individuals[np.argmin(evaluate(individuals))]
        
        return best_individual
    
    def run():
        best_individual = np.zeros((dim,))
        for i in range(len(sigma_schedule)):
            individual = simulate_annealing(budget // len(sigma_schedule), num_searches, sigma_schedule[i])
            if func(clip(individual)) < func(clip(best_individual)):
                best_individual = individual
        
        return clip(best_individual)
    
    return run()
