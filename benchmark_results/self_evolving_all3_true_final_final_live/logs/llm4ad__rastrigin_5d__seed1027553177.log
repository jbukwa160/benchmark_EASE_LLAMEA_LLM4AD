def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    sigma = 1.0
    weights = np.array([0.5, 0.3, 0.2])
    
    X = rng.uniform(lb, ub, (pop_size, dim))
    Y = func(X)
    best_x = X[np.argmin(Y)]
    best_y = np.min(Y)
    
    for i in range(budget):
        W = rng.choice(len(weights), pop_size, replace=True, p=weights)
        V = sigma * X[W]
        
        U = 0.5 * (V + X)
        Z = func(U)
        
        idx = np.where(Z < Y)[0]
        if len(idx) > 0:
            Y[idx] = Z[idx]
            X[idx] = U[idx]
            
        idx = np.argmin(Y)
        best_x = X[idx]
        best_y = Y[idx]
        
        X = np.clip(X, lb, ub)
    
    return best_x
