def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    for i in range(1, budget):
        y = x.copy()
        
        # Adaptive mutation
        for j in range(dim):
            if rng.random() < 0.1:
                y[0, j] += np.sign(rng.uniform(-1, 1)) * (ub - lb) * 0.5 * rng.truncexp(1)
                
        # Acceptance criterion
        f = func(y)
        alpha = 0.01
        
        if f < best_f or (f <= best_f and rng.random() < np.exp(-alpha * (best_f - f))):
            x = y.copy()
            best_x = x.copy()
            best_f = f
            
    return best_x
