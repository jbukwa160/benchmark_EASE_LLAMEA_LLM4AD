def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def init_population(rng, dim, n_pop):
        return rng.uniform(lb, ub, (n_pop, dim))

    def evaluate(population):
        return func(clip(population, lb, ub))

    def differential_evolution(population, func_eval, f_target, budget, dim, lb, ub):
        best = population[np.argmin(func_eval)]
        while budget > 0:
            for i in range(len(population)):
                x1, x2, x3, x4, _ = np.random.choice(population.shape[0], size=4, replace=False)
                trial = population[x1] + 0.5 * (population[x2] - population[x3]) + 0.5 * rng.normal(0, 1, dim)
                trial = clip(trial, lb, ub)
                trial_eval = func_eval[x1] + np.sum(rng.uniform(-1, 1, dim) * (trial - population[x1])**2)
                if trial_eval < func_eval[x4]:
                    population[x4] = trial
                    func_eval[x4] = trial_eval
                    best = population[np.argmin(func_eval)]
            budget -= 1
        return best

    def cma_es(population, func_eval, f_target, budget, dim):
        n_pop = len(population)
        mean = np.mean(population, axis=0)
        cov = np.cov(np.transpose(population))
        while budget > 0:
            for i in range(n_pop):
                trial = population[i] + np.random.multivariate_normal(mean, cov * rng.uniform(0, 1))
                trial = clip(trial, lb, ub)
                trial_eval = func_eval[i] + func(trial)
                if trial_eval < f_target:
                    population[i] = trial
                    func_eval[i] = trial_eval
            mean += np.mean(np.array([population[i] - mean for i in range(n_pop)]), axis=0) / n_pop
            cov = (1 - 2/n_pop) * cov + 1/n_pop * np.dot(np.transpose(np.array([population[i] - mean for i in range(n_pop)])**2), np.array([population[i] - mean for i in range(n_pop)]))
            budget -= 1
        return population[np.argmin(func_eval)]

    n_pop = int(np.sqrt(budget)) + 1
    population = init_population(rng, dim, n_pop)
    func_eval = evaluate(population)
    best = differential_evolution(population, func_eval, np.min(func_eval), budget - n_pop, dim, lb, ub)
    return cma_es([best], [func(best)], np.min(func(best)), 1, dim)[0]
