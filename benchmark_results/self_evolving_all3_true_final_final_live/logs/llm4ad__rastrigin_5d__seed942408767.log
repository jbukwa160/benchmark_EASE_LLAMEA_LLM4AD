def algorithm(func, dim, lb, ub, budget, rng):
    n = len(dim)
    D = 10 * n
    x = np.zeros(n)
    T = 1e2
    x_best = x.copy()
    f_best = func(x_best)

    for i in range(budget):
        if rng.uniform(0, 1) < 0.5:
            x_mut = x.copy()
            for j in range(n):
                u = lb + (ub - lb) * rng.uniform(0, 1)
                v = lb + (ub - lb) * rng.uniform(0, 1)
                if func(np.array([u, ] * n)) < func(np.array([v, ] * n)):
                    x_mut[j] = u
            f_mut = func(x_mut)
        else:
            w = np.zeros(n)
            for j in range(n):
                sigma = (ub - lb) / 2
                w[j] = rng.normal(0, sigma)
                x_mut = x + w
                if all(np.isclose(x_mut, lb)) or all(np.isclose(x_mut, ub)):
                    continue
                f_mut = func(x_mut)

        if f_mut < D:
            x = x_mut.copy()
            f_best = min(f_best, f_mut)
            x_best = x.copy()

        # adaptive cooling schedule
        if rng.uniform(0, 1) < np.exp(-(f_best - f_mut) / T):
            x = x_mut.copy()
            T *= 0.99

    return x_best
