def algorithm(func, dim, lb, ub, budget, rng):
    def rastrigin(x):
        return 10 * dim + np.sum([i**2 - 10 * np.cos(2 * np.pi * i) for i in x])

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(best_x)

    temp = 1.0
    t_max = 10000

    for _ in range(budget):
        y = np.clip(x + rng.normal(0, 0.5, size=dim), lb, ub)
        f_y = func(y)
        
        if f_y < best_f:
            x = y.copy()
            best_x = y.copy()
            best_f = f_y
        else:
            delta = f_y - best_f
            
            if rng.random() < np.exp(-delta / temp):
                x = y.copy()
            elif rng.random() < 0.1 and _ > budget * 0.8: # mutation operator
                dx = rng.uniform(-0.5, 0.5, size=dim)
                y = best_x + dx
                f_y = func(y)
                
                if f_y < best_f:
                    x = y.copy()
                    best_x = y.copy()
                    best_f = f_y
        
        temp *= np.exp(-(_ / t_max) * 0.1)

    return best_x
