def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population():
        x = np.random.uniform(lb, ub, (10, dim))
        return x

    def differential_evolution(population, func):
        for _ in range(budget):
            y = population[np.random.choice(range(10))]
            z = population[np.random.choice(range(10))]
            w = population[np.random.choice(range(10), exclude=[np.where(y == z)[0][0], np.where(z == y)[0][0]])]
            u = y + 0.5 * (z - w) / rng.uniform(0, 1)
            u = clip(u)
            f_x = func(u)
            f_y = func(y)
            if f_x < f_y:
                population[np.where(y == z)[0][0]] = u
        return population

    def perturb(solution):
        idx = np.random.choice(dim)
        solution[idx] += rng.uniform(-1, 1)
        solution = clip(solution)
        return solution

    population = generate_initial_population()
    best_solution = differential_evolution(population, func)

    for _ in range(budget // dim):
        for i in range(dim):
            current_best = perturb(best_solution[i])
            f_current_best = func(current_best)
            f_best_solution_i = func(best_solution[i])
            if f_current_best < f_best_solution_i:
                best_solution[i] = current_best

    return best_solution[0]
