def algorithm(func, dim, lb, ub, budget, rng):
    def fitness(x):
        return func(x)

    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def sample_x(rng, dim, lb, ub):
        return rng.uniform(lb, ub, size=dim)

    def cma_es(rng, dim, lb, ub, budget, num_parents=20, mu=0.1, sigma=0.5):
        weights = np.ones(num_parents) / num_parents
        mean_x = sample_x(rng, dim, lb, ub)
        for _ in range(budget):
            x_parents = [sample_x(rng, dim, lb, ub) for _ in range(num_parents)]
            fitness_values = [fitness(clip(x, lb, ub)) for x in x_parents]
            weights = np.array(fitness_values) / sum(fitness_values)
            mean_x = np.sum([x * w for x, w in zip(x_parents, weights)], axis=0)
            sigma = (1 - mu) * sigma + mu * np.mean(np.abs(x_parents[0] - mean_x))
        return clip(mean_x, lb, ub)

    best_x = None
    best_fitness = float('inf')
    for _ in range(budget):
        x_new = cma_es(rng, dim, lb, ub, budget)
        fitness_new = fitness(clip(x_new, lb, ub))
        if fitness_new < best_fitness:
            best_fitness = fitness_new
            best_x = clip(x_new, lb, ub)

    return best_x
