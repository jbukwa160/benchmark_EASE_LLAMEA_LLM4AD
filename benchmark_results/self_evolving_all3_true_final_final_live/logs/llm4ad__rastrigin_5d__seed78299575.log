def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    pop_size = 50
    F = 0.5
    CR = 0.9
    p_best = None
    g_best = None

    for t in range(budget):
        # Initialize population
        if t == 0:
            X = rng.uniform(lb, ub, (pop_size, D))
        else:
            X = np.copy(g_best)

        # Evaluate function and find personal best and global best
        F_x = func(X)
        for i in range(pop_size):
            f_x_i = func(X[i])
            if p_best is None or f_x_i < p_best.f_x:
                p_best = {'x': X[i], 'f_x': f_x_i}
            if g_best is None or f_x_i < g_best.f_x:
                g_best = {'x': X[i], 'f_x': f_x_i}

        # Differential Evolution
        Y = np.copy(X)
        for i in range(pop_size):
            r1, r2, r3 = rng.randint(0, pop_size, 3)
            while r1 == i or r2 == i or r3 == i:
                r1, r2, r3 = rng.randint(0, pop_size, 3)
            Y[i] = X[r1] + F * (X[r2] - X[r3])

        # Mutation strategy
        M = rng.uniform(-ub, ub, D)
        for i in range(pop_size):
            if rng.rand() < CR:
                Y[i] += M

        # Local search refinement
        for i in range(pop_size):
            Y_i = np.copy(Y[i])
            while True:
                s = rng.choice(D)
                Y_i[s] += rng.uniform(-1, 1) * (ub - lb)
                if not (lb <= Y_i[s] <= ub):
                    break
                f_x_i = func(Y_i)
                if f_x_i < g_best.f_x:
                    g_best.x = np.copy(Y_i)
                    g_best.f_x = f_x_i

        # Update population and budget
        X = Y.clip(lb, ub)

    return p_best['x']
