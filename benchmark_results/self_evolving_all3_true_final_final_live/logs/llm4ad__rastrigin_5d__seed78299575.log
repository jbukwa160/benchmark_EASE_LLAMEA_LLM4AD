def algorithm(func, dim, lb, ub, budget, rng):
    def cooled_schedule(t, T0, alpha):
        return T0 * (1 - alpha)**t

    def simulated_annealing(x, t, func, lb, ub):
        T = cooled_schedule(t, 100, 0.999)
        if np.random.rand() < np.exp((func(x) - func(current_best)) / T):
            current_best = x
        return current_best

    best_solution = np.zeros(dim)
    current_best = np.zeros(dim)
    for t in range(budget):
        for _ in range(rng):
            x = current_best + 0.5 * (ub - lb) * (np.random.rand(dim) - 0.5)
            x = np.clip(x, lb, ub)
            current_best = simulated_annealing(x, t, func, lb, ub)
        if func(current_best) < func(best_solution):
            best_solution = current_best
    return best_solution
