def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    T = 1e10
    k_max = int(budget / (dim * 50))
    
    for k in range(k_max):
        for i in range(50):
            x = lb + (ub - lb) * rng.rand(dim)
            fx = func(x)
            
            if fx < f_best:
                f_best = fx
                x_best = x
                
            p_accept = np.exp(-0.1 * (f_best - fx))
            r = rng.rand()
            if r < p_accept / (1 + p_accept):
                f_best = fx
                x_best = x
            
        T *= 0.9999
    
    return x_best
