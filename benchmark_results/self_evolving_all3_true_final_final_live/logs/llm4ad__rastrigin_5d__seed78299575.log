def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    current_best = None
    step_size = (ub - lb) / 10.0

    for _ in range(budget):
        # Create a grid of candidate points with the current step size
        candidates = np.array([np.linspace(lb, ub, num=20) for _ in range(dim)])

        # Clip candidates to [lb, ub]
        candidates = clip(candidates)

        # Evaluate each candidate point and store its fitness value
        fitness_values = func(candidates)

        # Find the best candidate point (with the lowest fitness value)
        best_candidate = np.argmin(fitness_values)
        best_fitness_value = fitness_values[best_candidate]

        if current_best is None or best_fitness_value < current_best['fitness']:
            current_best = {'candidate': candidates[best_candidate], 'fitness': best_fitness_value}

        # Adaptively adjust the step size based on the success of previous iterations
        if rng.rand() > 0.9:
            step_size *= 1 + (rng.rand() - 0.5) * 0.1

    return current_best['candidate']
