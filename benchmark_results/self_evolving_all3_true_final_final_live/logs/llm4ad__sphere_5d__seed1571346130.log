def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(dim, lower_bound, upper_bound, rng):
        return (upper_bound - lower_bound) * rng.rand((1, dim)) + lower_bound

    def differential_evolution(population, func, dim, bounds, budget, rng):
        for _ in range(budget):
            for i in range(len(population)):
                trial = population[i] + 0.5 * (rng.rand(dim) - 0.5)
                trial = clip(trial)
                trial_fitness = func(trial)
                if trial_fitness < func(population[i]):
                    population[i] = trial
        return population

    def particle_swarm_optimization(population, func, dim, bounds, budget, rng):
        for _ in range(budget):
            for i in range(len(population)):
                v = 2 * rng.rand(dim) - 1
                x_new = population[i] + v
                x_new = clip(x_new)
                if func(x_new) < func(population[i]):
                    population[i] = x_new
        return population

    initial_population = generate_initial_population(dim, lb, ub, rng)

    # Run DE for 10 iterations
    de_population = differential_evolution(initial_population, func, dim, (lb, ub), int(budget * 0.1), rng)
    
    # Run PSO for the remaining budget
    psso_population = particle_swarm_optimization(de_population, func, dim, (lb, ub), int(budget * 0.9), rng)

    return np.array([min(psso_population, key=func)])
