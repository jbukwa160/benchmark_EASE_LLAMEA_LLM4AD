def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def mutate(x):
        p = np.random.uniform(size=dim)
        v = (ub - lb) * p + lb
        return x + 0.1 * v

    x = clip(np.zeros(dim))
    T = 100
    cooling_rate = 0.99
    for t in range(budget):
        y = mutate(x)
        fy = func(y)
        fx = func(x)
        
        delta = fy - fx
        
        if delta < 0 or np.random.rand() < np.exp(-delta / T):
            x = clip(y)
        
        T *= cooling_rate
    return x
