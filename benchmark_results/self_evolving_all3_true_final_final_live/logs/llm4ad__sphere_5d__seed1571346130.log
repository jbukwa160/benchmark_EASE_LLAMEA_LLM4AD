def algorithm(func, dim, lb, ub, budget, rng):
    def posterior_samples(gp, X, y, num_samples):
        mean, var = gp.predict(X, return_std=True)
        samples = []
        for i in range(num_samples):
            noise = np.sqrt(var) * rng.normal(0, 1)
            sample = mean + noise
            samples.append(sample)
        return np.array(samples)

    def sample_gp(gp, X, num_samples):
        samples = posterior_samples(gp, X, y, num_samples)
        return np.mean(samples, axis=0)

    def acquisition_function(X, gp, bounds, budget):
        mean, std = gp.predict(X, return_std=True)
        prob = (ub - lb) / 2
        return -mean + std * norm.cdf(prob)

    def initialize_gp():
        X_init = np.random.uniform(lb, ub, size=(10, dim))
        y_init = func(X_init)
        gp = GaussianProcessRegressor(kernel=1.0 * RBF(1.0), n_restarts_optimizer=9)
        gp.fit(X_init.reshape(-1, dim), y_init)
        return gp

    def optimize(gp, bounds, budget):
        X_gp = np.linspace(bounds[0], bounds[1], 100).reshape(-1, 1)
        X_gp = np.tile(X_gp, (dim, 1)).T
        for i in range(budget):
            mean, std = gp.predict(X_gp, return_std=True)
            idx = np.argmax(acquisition_function(X_gp, gp, bounds, budget))
            if acquisition_function(X_gp[idx], gp, bounds, budget) > -1e-6:
                X_new = X_gp[idx].reshape(1, dim)
                y_new = func(X_new)
                gp.fit(np.vstack((X_init.reshape(-1, dim), X_new)), np.hstack((y_init, y_new)))
                X_init = np.vstack((X_init, X_new))
                y_init = np.hstack((y_init, y_new))

    def evaluate(gp):
        X_final = sample_gp(gp, X_gp, 1000)
        return func(X_final)

    gp = initialize_gp()
    optimize(gp, [lb, ub], budget)
    best_x = sample_gp(gp, X_gp, 1)
    return best_x
