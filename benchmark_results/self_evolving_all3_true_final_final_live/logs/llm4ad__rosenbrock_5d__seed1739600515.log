def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        v = np.copy(x_best) + 0.5 * (np.random.uniform(-1, 1, size=dim)) + 0.5 * (x_best - np.random.uniform(lb, ub, size=dim))
        u = np.copy(v)
        for i in range(dim):
            if rng.rand() < 0.5:
                u[i] = v[(i-1)%dim]
            else:
                u[i] = x_best[i]

        f_u = func(np.clip(u, lb, ub))
        if f_u < f_best:
            x_best = u
            f_best = f_u

    return np.clip(x_best, lb, ub)
