def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate():
        return [rng.uniform(lb, ub) for _ in range(dim)]

    def clip_candidate(candidate):
        return tuple(np.clip(x, lb, ub) for x in candidate)

    current_solution = tuple(lb + 0.5 * (ub - lb) * rng.uniform(0, 1) for _ in range(dim))
    best_solution = current_solution
    best_value = func(*current_solution)
    candidates = [generate_candidate() for _ in range(budget // dim)]

    for i in range(int(np.ceil(budget / dim))):
        new_candidates = []
        for candidate in candidates:
            new_candidate = clip_candidate(candidate)
            new_candidates.append(new_candidate)

        candidate_values = [(func(*new_candidate), new_candidate) for new_candidate in new_candidates]
        current_solution, _ = min(candidate_values, key=lambda x: x[0])

        if func(*current_solution) < best_value:
            best_solution = current_solution
            best_value = func(*current_solution)

        candidates = candidate_values

    return np.array(best_solution)
