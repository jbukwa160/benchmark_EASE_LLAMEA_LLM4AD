def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    def sa_step():
        y = x + 0.1 * (ub - lb) * rng.normal(size=dim)
        y = clip(y)
        f = func(y)
        if f < best_f:
            x = y
            best_x = y.copy()
            best_f = f

    def de_step(x):
        z = np.random.uniform(lb, ub, size=dim)
        z = clip(z)
        a = 0.7 * rng.normal(size=dim) + 1.2
        b = 0.4 * rng.normal(size=dim)
        c = rng.normal(size=dim)
        y = x + a * (z - x) + b * (ub - lb) * c
        y = clip(y)
        return func(y)

    for _ in range(budget):
        if rng.random() < 0.5:
            sa_step()
        else:
            f = de_step(x)
            if f < best_f:
                x = np.zeros(dim)
                x[rng.randint(0, dim)] = 1
                while func(x) >= best_f:
                    x += 0.01 * (ub - lb) * rng.normal(size=dim)

    return best_x
