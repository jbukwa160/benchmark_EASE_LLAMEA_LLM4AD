def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    current_best = evaluate(np.array(rng.uniform(lb, ub, size=dim)))
    population_size = 10 * dim
    temperature = 1e6

    for _ in range(budget):
        new_population = np.empty((population_size, dim))
        for i in range(population_size):
            x = rng.normal(size=dim)
            while evaluate(clip(x)) > current_best:
                x = rng.normal(size=dim)
            new_population[i] = x

        simplex_center = np.mean(new_population, axis=0)
        simplex_vertices = new_population
        for i in range(population_size):
            simplex_vertices[i] += rng.uniform(-1, 1, size=dim)

        while True:
            simplex_vertices = clip(simplex_vertices)
            f_values = evaluate(simplex_vertices)
            f_sorted_indices = np.argsort(f_values)[:population_size]

            if f_values[f_sorted_indices[0]] < current_best:
                current_best = f_values[f_sorted_indices[0]]
                best_solution = simplex_vertices[f_sorted_indices[0]]

            # Cooling schedule
            temperature *= 0.99

            # Nelder-Mead Simplex
            centroid = np.mean(simplex_vertices, axis=0)
            d = 2 * (centroid - simplex_center)

            if evaluate(clip(simplex_center + d)) < current_best:
                best_solution = clip(simplex_center + d)

            # Refine local search around the best solution
            x = rng.uniform(size=dim)
            while np.linalg.norm(x) > 0.1:
                x = rng.uniform(size=dim)

            if evaluate(clip(best_solution + x)) < current_best:
                current_best = evaluate(clip(best_solution + x))
                best_solution += x

            # Refine local search around the vertices of the simplex
            for i in range(population_size):
                d = 2 * (simplex_vertices[i] - simplex_center)
                if evaluate(clip(simplex_center + d)) < current_best:
                    current_best = evaluate(clip(simplex_center + d))
                    best_solution = clip(simplex_center + d)

        # Reduce temperature if no improvement is made
        for i in range(population_size):
            x = rng.uniform(size=dim)
            while np.linalg.norm(x) > 0.1:
                x = rng.normal(size=dim)
            if evaluate(clip(best_solution + x)) < current_best:
                current_best = evaluate(clip(best_solution + x))
                best_solution += x

    return best_solution
