def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    T = 1000.0
    sigma = 10.0 / dim
    best_x = x.copy()
    best_y = func(x)

    for _ in range(budget):
        y = func(x)
        if y < best_y:
            best_y = y
            best_x = x.copy()

        candidate1 = x + rng.normal(size=dim) * sigma
        candidate2 = clip(candidate1)
        candidate3 = x + rng.uniform(-sigma, sigma, size=dim)

        for i in range(dim):
            candidate4 = x.copy()
            candidate4[i] = np.random.choice([candidate2[i], candidate3[i]])
            candidate4 = clip(candidate4)
            y = func(candidate4)
            if y < best_y:
                best_y = y
                best_x = candidate4

        T *= 0.99

    return best_x
