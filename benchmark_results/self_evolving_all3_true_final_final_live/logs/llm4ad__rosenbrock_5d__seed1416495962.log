def algorithm(func, dim, lb, ub, budget, rng):
    def simplex_search(x0, func, dim, lb, ub, maxiter=100):
        x = [np.copy(x0)]
        for _ in range(maxiter):
            y = np.copy(x[-1])
            for i in range(dim):
                yi = np.copy(y)
                yi[i] += 0.01
                if yi[i] > ub:
                    yi[i] = ub
                elif yi[i] < lb:
                    yi[i] = lb
                yi = func(yi) - func(x[-1])
                x.append(yi)
            x.sort()
            if np.abs(func(x[0]) - func(x[-1])) < 1e-6:
                break
        return x[0]

    def de_search(x0, func, dim, lb, ub, maxiter=100):
        pop = [np.random.uniform(lb, ub, dim) for _ in range(50)]
        best = func(np.array([simplex_search(pop[0], func, dim, lb, ub)]))
        for _ in range(maxiter):
            for i in range(len(pop)):
                v = np.copy(pop[i])
                idx = np.random.choice(range(dim), 2)
                v[idx] += np.random.uniform(-1, 1) * (ub - lb)
                if v[idx[0]] > ub:
                    v[idx[0]] = ub
                elif v[idx[0]] < lb:
                    v[idx[0]] = lb
                if v[idx[1]] > ub:
                    v[idx[1]] = ub
                elif v[idx[1]] < lb:
                    v[idx[1]] = lb
                f_new = func(v)
                if f_new < best:
                    best = f_new
                    pop[i] = v
        return np.array([simplex_search(pop[np.argmin(np.array(func(pop)))], func, dim, lb, ub)])

    x0 = rng.uniform(lb, ub, dim)
    for i in range(budget):
        x1 = de_search(x0, func, dim, lb, ub)
        if func(x1) < func(x0):
            x0 = x1
    return x0
