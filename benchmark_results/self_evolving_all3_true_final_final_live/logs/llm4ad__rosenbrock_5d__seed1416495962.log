def algorithm(func, dim, lb, ub, budget, rng):
    def bounds_check(x):
        return np.clip(x, lb, ub)

    n = len(lb)
    x = rng.uniform(size=n) * (ub - lb) + lb
    T0 = 1.0
    alpha = 0.99
    T = T0

    for _ in range(budget):
        f = func(bounds_check(x))
        new_x = bounds_check(rng.normal(loc=x, scale=0.2 * (ub - lb)))
        new_f = func(bounds_check(new_x))

        if new_f < f:
            x = new_x
        else:
            delta = new_f - f
            p = np.exp(-delta / T)
            if rng.uniform(0, 1) < p:
                x = new_x

        T *= alpha

    return bounds_check(x)
