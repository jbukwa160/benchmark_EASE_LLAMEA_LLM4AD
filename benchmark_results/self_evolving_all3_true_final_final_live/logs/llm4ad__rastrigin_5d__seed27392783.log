def algorithm(func, dim, lb, ub, budget, rng):
    x = np.array([rng.uniform(lb, ub) for _ in range(dim)])
    best_x = x.copy()
    best_f = func(x)
    
    step_size = 1.0
    
    for _ in range(budget):
        for i in range(dim):
            # Clip to bounds
            new_x_i = np.clip(best_x[i] + rng.uniform(-step_size, step_size), lb, ub)
            x[i] = new_x_i
            
            # Evaluate function at new point
            f_new = func(x)
            
            if f_new < best_f:
                best_x = x.copy()
                best_f = f_new
                
        # Reduce step size by a factor of 0.9 for next iteration
        step_size *= 0.9
        
    return best_x
