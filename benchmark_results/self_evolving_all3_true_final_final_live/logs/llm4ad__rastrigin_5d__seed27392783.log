def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    T = 10.0 * (ub - lb) / dim
    alpha = 0.99
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        new_x = x + rng.normal(0, 1, size=dim) * T / np.sqrt(i + 1)
        new_x = np.clip(new_x, lb, ub)

        f_new = func(new_x)
        if f_new < best_f:
            best_f = f_new
            best_x = new_x

        delta_f = f_new - best_f
        if delta_f > 0 and rng.uniform(0, 1) < np.exp(-delta_f / T):
            x = new_x

        T *= alpha

    return best_x
