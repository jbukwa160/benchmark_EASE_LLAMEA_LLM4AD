def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate):
        return np.maximum(np.minimum(candidate, ub), lb)

    def evaluate(candidate):
        candidate = clip_candidate(candidate)
        return func(candidate)

    def simulated_annealing(current_solution, temperature, cooling_rate):
        for _ in range(budget):
            new_solution = current_solution + rng.normal(0, 1, size=dim) * (ub - lb) / 2
            new_solution = clip_candidate(new_solution)
            delta = evaluate(new_solution) - evaluate(current_solution)
            if delta < 0 or np.random.rand() < np.exp(-delta / temperature):
                current_solution = new_solution
            temperature *= cooling_rate
        return current_solution

    def conjugate_gradient_descent(initial_solution, budget):
        solution = initial_solution
        for _ in range(budget):
            direction = rng.normal(0, 1, size=dim)
            step_size = 1 / np.linalg.norm(direction) * (ub - lb) / 2
            new_solution = solution + direction * step_size
            new_solution = clip_candidate(new_solution)
            if evaluate(new_solution) < evaluate(solution):
                solution = new_solution
        return solution

    initial_solution = rng.uniform(lb, ub, size=dim)
    global_solution = simulated_annealing(initial_solution, 1, 0.99)
    local_solution = conjugate_gradient_descent(global_solution, budget // 2)
    return local_solution
