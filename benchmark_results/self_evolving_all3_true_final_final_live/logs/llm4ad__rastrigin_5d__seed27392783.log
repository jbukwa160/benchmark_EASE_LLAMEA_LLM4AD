def algorithm(func, dim, lb, ub, budget, rng):
    def gp_model(params, X_train, Y_train):
        from GPy.core import Param
        from GPy.models import GPRegression
        model = GPRegression(X_train, Y_train)
        model.kern.input_dim = dim
        model.kern.lengthscale.constrain_positive("log")
        model.optimize()
        return model

    def modified_ei(model, x_new):
        mu, var = model.predict(x_new.reshape(1,-1))
        if var < 0:
            var = np.finfo(np.float64).eps
        if mu >= 0:
            return (func(x_new) - mu) / np.sqrt(var)
        else:
            return func(x_new) - mu

    def bayesian_optimisation(func, dim, lb, ub, budget):
        X_train = rng.uniform(lb, ub, size=(100, dim))
        Y_train = func(X_train)

        model = gp_model(None, X_train, Y_train)

        best_x = None
        for t in range(budget):
            x_new = np.zeros((1,dim))

            if t == 0:
                x_new[0] = rng.uniform(lb, ub)
            else:
                x_new[0] = rng.choice(X_train.shape[0], p=np.exp(-model.log_marginal_likelihood()))

            ei = modified_ei(model, x_new)

            if ei > 0 or t == 0:
                X_train = np.vstack((X_train, x_new))
                Y_train = np.append(Y_train, func(x_new))

                model.update_model()

                best_x = X_train[np.argmin(Y_train)]

        return best_x

    best_x = bayesian_optimisation(func, dim, lb, ub, budget)
    return best_x
