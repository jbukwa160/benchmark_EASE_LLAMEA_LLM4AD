def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate, lb, ub):
        return np.clip(candidate, a_min=lb, a_max=ub)

    def generate_initial_population(pop_size, dim, lb, ub):
        return [clip(rng.uniform(lb, ub, size=dim), lb, ub) for _ in range(pop_size)]

    def calculate_fitness(x):
        return func(x)

    pop_size = 50
    initial_pop = generate_initial_population(pop_size, dim, lb, ub)
    temperature = 100.0

    for i in range(budget):
        if rng.random() < 0.1:
            # Simulated Annealing step
            current_best = np.inf
            current_best_x = None
            for _ in range(10):
                new_x = clip(initial_pop[rng.randint(0, pop_size)], lb, ub)
                new_fitness = calculate_fitness(new_x)
                if new_fitness < current_best:
                    current_best = new_fitness
                    current_best_x = new_x
            initial_pop[rng.randint(0, pop_size)] = current_best_x

        # Differential Evolution step
        for j in range(pop_size):
            x1, x2, x3 = rng.choice(initial_pop, size=3, replace=False)
            mutant_vector = 0.5 * (x2 - x3) + clip(rng.uniform(lb, ub, size=dim), lb, ub)
            trial_x = initial_pop[j] + 0.1 * (mutant_vector - initial_pop[j])
            trial_x = clip(trial_x, lb, ub)
            trial_fitness = calculate_fitness(trial_x)
            if trial_fitness < calculate_fitness(initial_pop[j]):
                initial_pop[j] = trial_x

        # Update temperature
        temperature *= 0.99

    return np.array(min(initial_pop, key=calculate_fitness))
