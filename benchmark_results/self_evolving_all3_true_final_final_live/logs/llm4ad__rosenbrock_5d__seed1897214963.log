def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, (dim,))
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        sigma = 0.1 * (ub - lb)
        prop_x = x + rng.normal(size=(dim,), loc=0., scale=sigma)
        prop_x = np.clip(prop_x, lb, ub)  # Clip to bounds

        prop_f = func(prop_x)

        if prop_f < best_f:
            best_f = prop_f
            best_x = prop_x.copy()

        x = rng.choice([best_x, prop_x], size=1)[0]  # Randomly select between the two

    return best_x
