def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        x = np.clip(x, lb, ub)
        return func(x)

    def adapt_cma(x, cma, stepsize, stepsize_adaptation, learning_rate):
        y = 0.5 * (x + stepsize * np.random.normal(size=dim))
        z = 0.5 * (x - stepsize * np.random.normal(size=dim))
        cma += (learning_rate * (np.outer(y - x, z - x) - cma / (1 + stepsize_adaptation)))
        return cma

    def sample(cov):
        return rng.randn(dim) @ np.linalg.cholesky(cov)

    def sample_stepsize():
        return 10 ** (rng.uniform(-3, 2))

    dim = int(dim)
    budget = int(budget)
    lb = float(lb)
    ub = float(ub)
    cma = np.eye(dim)
    stepsize_adaptation = rng.uniform(1e-6, 0.05)
    learning_rate = rng.uniform(0.01, 0.1)

    best_x = None
    best_y = float('inf')

    for i in range(budget):
        x = sample(cma) * sample_stepsize() + np.ones(dim) if i == 0 else sample(cma)
        y = evaluate(x)

        cma = adapt_cma(x, cma, sample_stepsize(), stepsize_adaptation, learning_rate)

        if y < best_y:
            best_y = y
            best_x = x

    return best_x
