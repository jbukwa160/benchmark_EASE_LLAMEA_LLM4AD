def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(solution, rng):
        candidate = solution + (ub - lb) * rng.rand(dim)
        return clip(candidate)

    def nelder_mead_simplex(solution, func, dim, lb, ub, budget):
        simplex_size = 10
        candidate = solution
        for _ in range(budget):
            new_candidates = np.array([generate_candidate(candidate, rng) for _ in range(simplex_size)])
            new_func_values = [func(new_candidate) for new_candidate in new_candidates]
            indices = np.argsort(new_func_values)
            if new_func_values[indices[-1]] < new_func_values[indices[0]]:
                candidate = new_candidates[indices[-1]]
        return candidate

    def simulated_annealing(solution, func, dim, lb, ub, budget):
        initial_temperature = 100
        cooling_rate = 0.99
        temperature = initial_temperature
        for _ in range(budget):
            candidate = generate_candidate(solution, rng)
            delta = func(candidate) - func(solution)
            if delta < 0:
                solution = candidate
            elif np.random.rand() < np.exp(-delta / temperature):
                solution = candidate
            temperature *= cooling_rate

    solution = (ub + lb) * rng.rand(dim)
    for _ in range(budget // 2):
        simulated_annealing(solution, func, dim, lb, ub, budget // 4)
    return nelder_mead_simplex(solution, func, dim, lb, ub, budget - budget // 2)
