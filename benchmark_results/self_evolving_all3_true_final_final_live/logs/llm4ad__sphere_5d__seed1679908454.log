def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    sigma0 = 1.0
    c_cov = 2 / (dim + 3)
    c_sigma = 0.1
    max_iter = int(budget)
    
    x_mean = np.zeros(dim)
    cov_mat = np.eye(dim) * 1e-6
    
    for _ in range(max_iter):
        if rng.rand() < 0.5:
            step_size = sigma0 * (1 + c_sigma * rng.randn())
        else:
            step_size = np.sqrt(np.diag(cov_mat))
        
        x_new = x_mean + np.dot(step_size, rng.multivariate_normal(mean=np.zeros(dim), cov=cov_mat))
        x_new = np.clip(x_new, lb, ub)
        
        f_new = func(x_new)
        if f_new < func(x_mean):
            x_mean = x_new
            cov_mat *= c_cov
            
    return x_mean
