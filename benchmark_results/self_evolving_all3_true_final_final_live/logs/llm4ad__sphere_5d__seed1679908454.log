def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget - 1):
        sigma = (ub - lb) / 2
        step = rng.normal(size=dim) * sigma
        new_x = np.clip(x + step, lb, ub)
        
        f = func(new_x)
        if f < best_f:
            best_f = f
            best_x = new_x.copy()
        
        x = new_x

    return best_x
