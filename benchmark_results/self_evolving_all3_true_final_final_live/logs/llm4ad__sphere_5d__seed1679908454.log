def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x.copy()

        s = 1 / (1 + rng.uniform(0, 1))
        for i in range(dim):
            dx = np.zeros(dim)
            dx[i] = rng.uniform(-s, s) if lb <= x[i] <= ub else (x[i] - lb) * rng.uniform(0, 1) if x[i] < lb else (ub - x[i]) * rng.uniform(0, 1)
            x = x + dx

        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)

    return best_x
