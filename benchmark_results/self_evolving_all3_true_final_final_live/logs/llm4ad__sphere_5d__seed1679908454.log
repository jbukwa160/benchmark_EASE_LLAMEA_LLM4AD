def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.random(dim) + lb
    sigma = 0.1
    mean = np.mean(x)
    std_dev = np.std(x)
    
    for _ in range(budget):
        candidates = []
        for _ in range(16): # number of samples to draw from the current distribution
            sample = (ub - lb) * rng.normal(mean, sigma) + lb
            candidates.append(sample)
        
        best_candidate = min(candidates, key=func)
        x = best_candidate
        mean = np.mean(x)
        std_dev = np.std(x)
    
    return x
