def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    pop = rng.uniform(lb, ub, size=(budget, dim))
    best_candidate = None

    for t in range(budget):
        fit_pop = func(pop[t])
        fit_best_candidate = func(clip(pop[t]))

        if fit_best_candidate < np.min(fit_pop) or (best_candidate is not None and fit_best_candidate < func(best_candidate)):
            best_candidate = clip(pop[t])

        if rng.random() < 0.1:
            mutated = pop[t] + 0.5 * rng.uniform(-1, 1, size=dim)
            mutated = clip(mutated)
            pop[t] = np.where(rng.random(size=dim) < 0.7, mutated, pop[t])

    return best_candidate
