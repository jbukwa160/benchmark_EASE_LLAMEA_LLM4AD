def algorithm(func, dim, lb, ub, budget, rng):
    def uniform(rng):
        return np.random.uniform(lb, ub, size=(1, dim))

    def crossover(x1, x2, F):
        x = np.zeros_like(x1)
        for i in range(dim):
            if rng.rand() < 0.5:
                x[i] = x1[i] + F * (x2[i] - x1[i])
            else:
                x[i] = x2[i]
        return x

    def hybrid_de(func, x, lb, ub, budget, rng):
        best_x = x
        best_f = func(x)
        for i in range(budget):
            v = uniform(rng) * (ub - lb) + lb
            F = 0.5 + 0.3 * np.sin(10 * np.pi * rng.rand())
            u = crossover(v, best_x, F)
            while True:
                f = func(u)
                if f < best_f:
                    best_x = u
                    best_f = f
                    break
                elif budget - i > 1000 and rng.rand() < 0.1:
                    v = uniform(rng) * (ub - lb) + lb
                    F = 0.5 + 0.3 * np.sin(10 * np.pi * rng.rand())
                    u = crossover(v, best_x, F)
                else:
                    break
            x = best_x
        return x

    x = uniform(rng)
    for i in range(budget):
        x = hybrid_de(func, x, lb, ub, budget - i, rng)
    return np.clip(x, lb, ub)
