def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)
    step_size = 1.0
    perturb_prob = 0.01

    for _ in range(budget):
        if rng.random() < perturb_prob:
            x_perturbed = clip(best_x + np.random.normal(0, step_size, size=dim), lb, ub)
            f_perturbed = func(x_perturbed)
            if f_perturbed < best_f:
                best_x = x_perturbed
                best_f = f_perturbed

        x_next = clip(best_x + np.random.normal(0, step_size, size=dim), lb, ub)
        f_next = func(x_next)

        if f_next < best_f:
            best_x = x_next
            best_f = f_next

    return best_x
