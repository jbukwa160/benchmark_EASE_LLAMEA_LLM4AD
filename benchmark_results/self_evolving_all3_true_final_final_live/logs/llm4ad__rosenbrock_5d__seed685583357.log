def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x0 = rng.uniform(lb, ub, size=dim)
    best_x = clip(x0.copy())
    best_f = func(clip(best_x))

    for _ in range(budget):
        n = rng.choice(dim, size=3, replace=False) + np.arange(dim)
        n = [x if i == 0 else (n[i] - n[0]) // abs(n[i] - n[0]) + dim % abs(n[i] - n[0])
             for i, x in enumerate(n)]
        u = clip(best_x + rng.uniform(-1, 1, size=dim))
        f = func(clip(u))

        if f < best_f:
            best_f = f
            best_x = u.copy()
        elif np.random.rand() < 0.5 and _ > budget // 2:
            for i in range(dim):
                u[i] = clip(best_x[i] + rng.uniform(-1, 1))
                if func(clip(u)) < best_f:
                    best_f = func(clip(u))
                    best_x = u.copy()

    return best_x
