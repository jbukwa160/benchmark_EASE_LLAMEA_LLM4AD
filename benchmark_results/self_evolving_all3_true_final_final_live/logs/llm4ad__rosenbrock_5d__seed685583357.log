def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        step_size = 1 / (1 + _ * (_ - 1) * 0.001)
        new_x = x + step_size * rng.uniform(-1, 1, size=dim)
        new_x = np.clip(new_x, lb, ub)

        new_f = func(new_x)
        
        if new_f < best_f:
            best_x = new_x
            best_f = new_f

        alpha = (new_f - best_f) / (func(x) - best_f)
        x = best_x + alpha * rng.uniform(-1, 1, size=dim)
        x = np.clip(x, lb, ub)

    return best_x
