def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_candidate(current_solution, rng):
        candidate = current_solution + rng.uniform(-1, 1, size=dim)
        return clip(candidate)

    def evaluate(solution):
        return func(solution)

    best_solution = np.random.uniform(lb, ub, size=dim)
    best_score = float('inf')
    current_solution = best_solution
    current_score = evaluate(current_solution)
    if current_score < best_score:
        best_score = current_score

    temperature = 1.0
    num_restarts = 0
    while True:
        for _ in range(budget // dim):
            candidate = generate_candidate(current_solution, rng)
            candidate_score = evaluate(candidate)

            if candidate_score < best_score:
                best_solution = candidate
                best_score = candidate_score

            # Simulated Annealing logic
            delta = candidate_score - current_score
            if delta <= 0 or np.random.rand() < np.exp(-delta / temperature):
                current_solution = candidate
                current_score = candidate_score
        num_restarts += 1

        # Adaptive temperature schedule and restarts
        temperature *= 0.99
        if num_restarts > 5:
            current_solution = best_solution.copy()
            num_restarts = 0
        if temperature < 1e-3 or (num_restarts == 5 and evaluate(current_solution) == best_score):
            break

    return best_solution
