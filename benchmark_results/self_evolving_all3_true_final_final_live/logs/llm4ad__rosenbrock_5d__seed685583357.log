def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(1, dim))
    T = 1000
    beta = 0.99
    best_x = x.copy()
    while budget > 0:
        budget -= 1
        new_x = x + np.exp(-T) * rng.randn(1, dim)
        new_x = np.clip(new_x, lb, ub).astype(np.float32)
        f_new = func(new_x)
        f_best = func(best_x)
        if f_new < f_best:
            best_x = new_x.copy()
        elif rng.uniform(0, 1) < np.exp(-(f_new - f_best) / T):
            x = new_x.copy()
        T *= beta
    return best_x[0]
