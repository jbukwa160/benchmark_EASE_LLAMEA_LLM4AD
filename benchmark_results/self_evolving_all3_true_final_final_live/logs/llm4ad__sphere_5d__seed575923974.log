def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    x = clip(rng.uniform(lb, ub, size=dim))
    y = func(x)
    best_x = x.copy()
    best_y = y

    for _ in range(budget - 1):
        lambda_ = 0.5 * (2 + np.sqrt(2)) ** 2
        mu = int(lambda_)
        sigma_best = np.std(best_x)
        step_size = 0.25 / (sigma_best + 1e-8)

        for _ in range(mu):
            z = clip(best_x + rng.normal(size=dim) * step_size)
            y = func(z)
            if y < best_y:
                best_x = z
                best_y = y

    return best_x
