def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def get_candidate(solution, step_size):
        candidate = solution + (rng.uniform(-1, 1, size=dim) * step_size)
        return clip(candidate)

    temperature = 1000
    step_size = 5
    current_solution = np.zeros(dim)
    best_solution = np.zeros(dim)
    current_fitness = func(current_solution)
    best_fitness = current_fitness

    for _ in range(budget):
        candidate = get_candidate(current_solution, step_size)
        candidate_fitness = func(candidate)

        if candidate_fitness < best_fitness:
            best_solution = candidate
            best_fitness = candidate_fitness

        if np.random.rand() < np.exp((current_fitness - candidate_fitness) / temperature):
            current_solution = candidate
            current_fitness = candidate_fitness

        temperature *= 0.99
        step_size *= 0.9995

    return best_solution
