def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.maximum(np.minimum(x, ub), lb)

    def generate_candidate(mean, sigma, num_vars):
        candidate = mean + sigma * rng.randn(num_vars)
        return clip(candidate)

    def acceptance_probability(new_fitness, current_fitness, temperature):
        if new_fitness < current_fitness:
            return 1.0
        else:
            return np.exp((current_fitness - new_fitness) / temperature)

    num_dims = dim
    budget_remaining = budget
    mean = np.zeros(num_dims)
    sigma = 5.0
    temperature = 10.0

    best_candidate = generate_candidate(mean, sigma, num_dims)
    best_fitness = func(best_candidate)

    while budget_remaining > 0:
        candidate = generate_candidate(mean, sigma, num_dims)
        fitness = func(candidate)

        if rng.rand() < acceptance_probability(fitness, best_fitness, temperature):
            mean += (candidate - mean) / np.sqrt(budget_remaining + 1)
            best_candidate = candidate
            best_fitness = fitness

        budget_remaining -= 1
        temperature *= 0.9999

    return best_candidate
