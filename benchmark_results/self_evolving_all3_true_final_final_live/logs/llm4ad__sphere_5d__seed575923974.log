def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = None
    best_val = float('inf')
    
    for _ in range(budget):
        x = lb + (ub - lb) * rng.rand(dim)
        
        while True:
            val = func(x)
            
            if val < best_val:
                best_sol = x
                best_val = val
                
            if np.all(np.abs(func(x) - best_val) / func(x) < 1e-6):
                break
            
            alpha = 0.99 * rng.uniform(0.01, 1)
            x += alpha * (ub - lb) * rng.randn(dim)
            
            # Clip candidates to [lb, ub]
            x = np.clip(x, lb, ub)
    
    return best_sol
