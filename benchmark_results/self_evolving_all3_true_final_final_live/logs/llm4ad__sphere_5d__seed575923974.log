def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(-5, 5, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        x_new = rng.uniform(lb, ub, size=dim)
        f_new = func(x_new)
        
        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return np.clip(x_best, lb, ub)
