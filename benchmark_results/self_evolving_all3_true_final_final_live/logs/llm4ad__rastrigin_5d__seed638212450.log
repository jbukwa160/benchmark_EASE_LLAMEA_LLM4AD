def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(clip(x))

    T = 10.0 * (ub - lb) ** 2
    n_iter = int(budget / dim)
    for _ in range(n_iter):
        new_x = clip(rng.normal(size=dim, loc=x, scale=T))
        new_f = func(new_x)

        if new_f < best_f:
            x = new_x
            best_x = new_x
            best_f = new_f

        T *= 0.99

    return best_x
