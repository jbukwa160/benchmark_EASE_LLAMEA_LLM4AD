def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(dim, pop_size):
        population = rng.uniform(lb, ub, size=(pop_size, dim))
        return clip(population)

    def differential_evolution(func, x0, bounds, mut, strat, max_iter, pop_size=50, cr=0.9):
        population = x0
        for _ in range(max_iter):
            mutated_population = np.copy(population)
            for i in range(pop_size):
                u, v, w = rng.choice(pop_size, size=3, replace=False)
                if strat == 'rand1exp':
                    f = 0.5 * (rng.rand() - 1) * mut
                elif strat == 'best/2exp':
                    f = mut / 2
                mutated_population[i] += f * (population[u] - population[v]) + cr * (population[w] - population[i])
            mutated_population = clip(mutated_population)
            fit = np.array([func(x) for x in mutated_population])
            indices = np.argsort(fit)
            population = mutated_population[indices[:pop_size]]
        return population[np.argmin(np.array([func(x) for x in population]))]

    pop_size = 10
    max_iter = budget // pop_size
    init_pop = generate_initial_population(dim, pop_size)

    best_solution = differential_evolution(func, init_pop, [(lb, ub)]*dim, 0.1, 'rand1exp', max_iter)
    return clip(best_solution)
