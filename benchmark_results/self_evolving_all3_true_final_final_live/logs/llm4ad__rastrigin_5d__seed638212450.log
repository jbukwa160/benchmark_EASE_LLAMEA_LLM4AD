def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    n = int(np.ceil(budget ** (1 / dim)))
    step_size = 2 * (ub - lb) / n
    best_x = np.random.uniform(lb, ub, size=dim)
    best_y = evaluate(best_x)

    for _ in range(1, budget):
        x = np.random.uniform(lb, ub, size=dim)
        y = evaluate(x)

        if rng.random() < 0.5:
            step_size *= (best_y - y) / abs(best_y - y + 1e-6) ** 2
        else:
            step_size *= (y - best_y) / abs(y - best_y + 1e-6) ** 2

        x = np.clip(best_x + rng.uniform(-step_size, step_size, size=dim), lb, ub)
        y = evaluate(x)

        if y < best_y:
            best_x = x
            best_y = y

    return best_x
