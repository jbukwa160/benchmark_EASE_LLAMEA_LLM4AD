def algorithm(func, dim, lb, ub, budget, rng):
    n = int(np.sqrt(budget))
    x_best = -np.ones(dim)
    f_best = 1e10
    
    for i in range(1, n+1):
        mean = (ub + lb) / 2
        cov = np.eye(dim)
        
        # CMA-ES step
        population_size = int(budget * 0.9 / (i**2))
        x = rng.normal(mean, 5, (population_size, dim))
        y = func(x).reshape(-1)
        x[y < f_best] = mean
        
        # ADE step
        v = np.zeros((dim,))
        for j in range(population_size):
            z = rng.uniform(-1, 1, (dim,))
            w = x[j] + 0.5*z + v
            w = np.clip(w, lb, ub)
            y_w = func(w)
            
            # Acceptance criterion
            if rng.random() < 0.1 and y_w < f_best:
                f_best = y_w
                x_best = w
                
        cov += (x - mean).T @ (x - mean) / population_size
        
    return x_best
