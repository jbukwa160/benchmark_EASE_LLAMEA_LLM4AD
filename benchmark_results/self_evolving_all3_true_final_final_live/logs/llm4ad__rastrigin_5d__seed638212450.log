def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        u = rng.uniform(0, 1, size=dim)
        v = rng.uniform(0, 1, size=dim)
        z = np.where(u < 0.5, x + 0.5 * (ub - lb) * v, best_x + 0.5 * (ub - lb) * v)

        # Clip to boundaries
        z = np.clip(z, lb, ub)

        f_z = func(z)
        
        if f_z < best_f:
            best_f = f_z
            best_x = z.copy()

    return best_x
