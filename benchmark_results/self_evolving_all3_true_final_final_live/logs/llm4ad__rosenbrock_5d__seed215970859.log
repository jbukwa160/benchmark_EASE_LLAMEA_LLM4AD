def algorithm(func, dim, lb, ub, budget, rng):
    def clipped_bounds(x):
        return np.clip(x, lb, ub)

    def objective(x):
        return func(clipped_bounds(x))

    bounds = [(lb, ub) for _ in range(dim)]
    result = differential_evolution(objective, bounds, maxiter=budget)
    best_x = result.x
    best_f = result.fun

    simplex_bounds = [(-5, 10), (-5, 10)] * dim
    def nelder_mead(x):
        return func(clipped_bounds(x))

    result_nelder_mead = differential_evolution(nelder_mead, simplex_bounds, maxiter=budget)
    best_x_nm = result_nelder_mead.x
    best_f_nm = result_nelder_mead.fun

    if best_f > best_f_nm:
        best_x = best_x_nm
        best_f = best_f_nm

    return clipped_bounds(best_x)
