def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    mu = np.random.uniform(lb, ub, size=(budget, dim))
    lambda_ = int(np.sqrt(budget))

    sigma = 0.5 * (ub - lb)
    c1 = 1 + 2 / (dim + 3.0)
    c2 = 2 / ((dim + 4) ** 2)

    p_sum = np.zeros(dim)
    pc = np.zeros((lambda_, dim))
    psigma = np.ones(lambda_)
    sum_sigma = 0
    p_wsum = np.zeros(lambda_)

    for t in range(budget):
        p_sum[:] = np.mean(pc, axis=0)
        if t > 1:
            sum_sigma += sigma

        if t == 0 or np.random.rand() < c2 * (sigma / sum_sigma) ** 2:
            pc[:, :] = mu + np.sqrt(sum_sigma) * rng.randn(lambda_, dim)

        for i in range(lambda_):
            p_wsum[i] = 1
            for j in range(t):
                if np.random.rand() < c1 * (sigma / sum_sigma) ** 2:
                    p_wsum[i] *= np.exp(-c1 * (pc[i, :] - pc[j, :]) ** 2 / (2 * sigma ** 2))
            p_wsum[i] /= np.sum(p_wsum)

        for i in range(lambda_):
            psigma[i] = f(pc[i, :])

        c_mean = 0
        for i in range(lambda_):
            c_mean += p_wsum[i] * pc[i, :]
        mu[:] = c_mean

        sigma *= np.exp((1 - (f(mu) / sum_sigma)) / (dim + 2.0))

        if t % 100 == 0:
            print(f"Budget: {t+1}, Function Value: {f(mu)}")

    return mu
