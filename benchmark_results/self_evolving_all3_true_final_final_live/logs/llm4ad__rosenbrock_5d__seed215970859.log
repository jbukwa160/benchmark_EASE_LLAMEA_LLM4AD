def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x), None  # No gradients needed

    pop_size = int(np.sqrt(budget)) + 1
    population = np.random.uniform(lb, ub, (pop_size, dim))

    for _ in range(budget):
        x_best, y_best, f_best = population[0], evaluate(population[0])[0], float('inf')
        for i in range(1, pop_size):
            mutation = rng.normal(size=dim)
            crossover = 0.5 + rng.uniform(-1, 1) / (i+1)
            new_x = clip(population[i] + crossover * population[0] + (1-crossover) * (population[i] + mutation))
            f_new, _ = evaluate(new_x)

            if f_new < f_best:
                x_best, y_best, f_best = new_x, evaluate(new_x), f_new

        population = np.concatenate([
            clip(population),
            clip(x_best + rng.normal(size=(pop_size-1, dim)))
        ])

    return x_best
