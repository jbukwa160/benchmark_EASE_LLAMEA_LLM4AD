def algorithm(func, dim, lb, ub, budget, rng):
    def objective(x):
        return func(x)

    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = float('inf')

    for t in range(1, budget + 1):
        # Differential Evolution
        candidate = x + rng * (np.random.uniform(-1, 1, size=dim) * np.abs(x - np.random.uniform(lb, ub, size=dim)) +
                              np.random.uniform(-1, 1, size=dim) * np.abs(np.random.uniform(lb, ub, size=dim) - x))
        candidate = np.clip(candidate, lb, ub)

        # Simulated Annealing
        candidate_f = objective(candidate)
        if candidate_f < best_f:
            best_x = candidate.copy()
            best_f = candidate_f

    return best_x
