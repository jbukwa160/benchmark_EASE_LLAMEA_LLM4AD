def algorithm(func, dim, lb, ub, budget, rng):
    def func_vec(x):
        return np.array([func(x[i]) for i in range(len(x))])

    x = np.random.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func_vec(x)
    n_iter = 0
    sigma = 2.0

    while n_iter < budget:
        y = np.clip(best_x + rng.normal(size=(1, dim)), lb, ub)
        f_y = func_vec(y)
        delta = np.mean(f_y - best_f)

        if delta > 0 or rng.random() < np.exp(-delta / sigma):
            x = y
            best_x = x.copy()
            best_f = f_y

        n_iter += 1
        sigma *= 0.99  # decay the step size

    A = cho_factor(np.cov(best_x.T))
    b = -np.linalg.solve(A, np.mean(best_x, axis=0) - lb)
    s = rng.normal(size=(1, dim))

    for _ in range(budget):
        s = np.clip(s * 2 + b, -5.0, 5.0)
        x = best_x + sigma * s
        f_x = func_vec(x)

        if np.mean(f_x) < np.mean(best_f):
            best_x = x.copy()
            best_f = f_x

    return best_x[0]
