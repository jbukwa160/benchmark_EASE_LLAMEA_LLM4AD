def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(dim,))
    
    for _ in range(budget):
        # Generate new candidate
        new_x = x + rng.uniform(-1, 1, size=(dim,))
        
        # Clip to bounds
        new_x = np.clip(new_x, lb, ub)
        
        # Evaluate function value of new candidate
        f_new = func(new_x)
        f_current = func(x)
        
        if f_new < f_current:
            x = new_x
    
    return x
