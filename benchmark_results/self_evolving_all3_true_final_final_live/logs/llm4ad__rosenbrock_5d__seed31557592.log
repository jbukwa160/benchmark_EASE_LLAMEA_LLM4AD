def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        return func(x)

    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = evaluate(x_best)

    N = 1
    while True:
        # Sample a new candidate point using the current surrogate model
        mu = np.zeros(dim)
        for i in range(dim):
            sigma2_i = (ub - lb)**2 / N + x_best[i]**2 * (ub - lb)**2
            z = norm.ppf(rng.rand())
            x_new_i = z * np.sqrt(sigma2_i) + x_best[i]
            mu[i] = x_new_i

        # Clip candidate to bounds
        x_new = lb + (ub - lb) * rng.uniform(size=dim)
        for i in range(dim):
            if abs(x_new[i] - mu[i]) > 1e-6:
                x_new[i] = mu[i]

        f_new = evaluate(x_new)

        # Update the surrogate model
        N += 1

        # Update best solution
        if f_new < f_best:
            x_best = x_new
            f_best = f_new

        budget -= 1
        if budget == 0:
            break

    return x_best
