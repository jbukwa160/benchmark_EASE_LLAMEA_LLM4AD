def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(clip(x_best))

    for _ in range(budget-1):
        std_dev = 0.5 * (ub - lb) / rng.randint(2, 10 + 1)
        sigma = 1 if rng.random() < 0.5 else -1

        x_new = clip(x_best + np.zeros(dim) + sigma * rng.normal(loc=0, scale=std_dev, size=dim))

        f_new = func(clip(x_new))
        
        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
