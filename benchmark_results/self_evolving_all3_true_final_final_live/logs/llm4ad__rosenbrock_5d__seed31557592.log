def algorithm(func, dim, lb, ub, budget, rng):
    T = 1000.0
    alpha = 0.99
    sigma = 1.0
    p_accept = 0.5
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    for _ in range(budget):
        while True:
            x_try = x_best + sigma * (ub - lb) * rng.randn(dim)
            if np.all(x_try >= lb) and np.all(x_try <= ub):
                break
        f_try = func(x_try)
        
        delta_f = f_try - f_best
        
        if delta_f < 0:
            x_best = x_try
            f_best = f_try
            p_accept = max(0.01, min(p_accept * np.exp(-delta_f / T), 1))
        else:
            u = rng.rand()
            if u < p_accept * np.exp(-delta_f / T):
                x_best = x_try
                f_best = f_try
        
        sigma *= alpha
        T *= alpha
        
    return x_best
