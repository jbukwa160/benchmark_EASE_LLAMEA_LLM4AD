def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = rng.uniform(lb, ub, (dim+1, budget))
    f_best = float('inf')
    best_x = None
    m = 0.5

    for i in range(1, budget):
        a, b, c = rng.choice(budget, size=3, replace=False)
        x_t = D[:, a] + m * (D[:, b] - 2*D[:, c])
        x_t = clip(x_t)

        f_x = func(x_t[:dim])

        if f_x < f_best:
            f_best = f_x
            best_x = x_t[:dim]

        if i % 10 == 0 or i == budget-1:
            m *= np.exp(rng.uniform(-1e-2, 1e-2))

    return best_x
