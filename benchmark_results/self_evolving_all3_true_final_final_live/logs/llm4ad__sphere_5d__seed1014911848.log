def algorithm(func, dim, lb, ub, budget, rng):
    D = len(dim)
    X_init = 0.5 * (ub + lb) + rng.uniform(size=(budget, D)) * (ub - lb)
    X_best = None
    y_best = np.inf
    
    for i in range(budget):
        X = X_init[i]
        
        # Clip candidates to [lb, ub]
        X = np.clip(X, a_min=lb, a_max=ub)
        
        y = func(X)
        
        if y < y_best:
            y_best = y
            X_best = X
            
    return X_best
