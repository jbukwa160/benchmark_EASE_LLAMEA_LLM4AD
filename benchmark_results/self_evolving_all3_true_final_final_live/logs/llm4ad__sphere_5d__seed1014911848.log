def algorithm(func, dim, lb, ub, budget, rng):
    def acquisition(x):
        mu = gp.predict(x[None, :], eval_MCMC=False)
        sigma = gp.predict(x[None, :], eval_MCMC=False, full_cov=True)[:, 0, 0]
        return (func(x) - mu) / np.sqrt(sigma**2 + 1e-6)

    D = dim
    best_x = rng.uniform(lb, ub, size=D)
    best_y = func(best_x)
    gp = None

    for _ in range(budget):
        if gp is None or rng.rand() < 0.5:
            X = np.array([best_x])
            Y = np.array([best_y])
            kernel = 1 + rng.uniform(0, 2) * (np.random.randn(D))
            gp = GaussianProcessRegressor(kernel=kernel * RBF(length_scale=rng.uniform(1e-3, 5.0)),
                                          nugget=rng.uniform(1e-6, 1e-4))
        else:
            X = np.vstack((X, best_x))
            Y = np.hstack((Y, best_y))

        gp.fit(X, Y)

        x_new = rng.multivariate_normal(np.zeros(D), gp.covariance_)
        while not lb <= x_new <= ub:  # Clip candidates to [lb, ub]
            x_new = rng.multivariate_normal(np.zeros(D), gp.covariance_)

        y_new = func(x_new)
        if y_new < best_y:
            best_x = x_new
            best_y = y_new

    return best_x
