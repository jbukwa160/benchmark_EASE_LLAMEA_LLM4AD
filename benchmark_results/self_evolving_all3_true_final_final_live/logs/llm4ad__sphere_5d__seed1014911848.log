def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    f_best = np.inf
    learn_rate = 1.0
    for _ in range(budget):
        x_new = rng.uniform(lb, ub, size=dim)
        f_new = func(x_new)
        if f_new < f_best:
            f_best = f_new
            x_best = x_new
        if np.any(x_new > ub) or np.any(x_new < lb):
            continue
        learn_rate *= 0.9999
        step_size = learn_rate * (ub - lb) / 2
        for i in range(dim):
            if x_best[i] != x_new[i]:
                x_new[i] += rng.uniform(-step_size, step_size)
                if np.any(x_new > ub) or np.any(x_new < lb):
                    x_new[i] = x_best[i]
    return x_best
