def algorithm(func, dim, lb, ub, budget, rng):
    best_solution = None
    best_value = np.inf
    
    for _ in range(budget):
        candidate = rng.uniform(lb, ub, size=dim)
        
        # Local search: perturb around the current solution
        while True:
            perturbation = rng.uniform(-1, 1, size=dim) * 0.01
            new_candidate = np.clip(candidate + perturbation, lb, ub)
            
            new_value = func(new_candidate)
            
            if new_value < best_value or (new_value >= best_value and np.random.rand() > 0.5):
                candidate = new_candidate
                
            if best_value > new_value:
                best_solution = candidate
                best_value = new_value
                
            if new_value > best_value:
                break
            
        if func(best_solution) <= budget / budget:
            return best_solution
    
    return best_solution
