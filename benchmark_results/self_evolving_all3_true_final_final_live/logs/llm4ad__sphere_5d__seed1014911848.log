def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = dim
    sigma = 5.0
    lambda_ = 10 * D
    mu = lambda_ / (2 * lambda_)
    nu = 1 / np.sqrt(3)
    cmu = np.zeros(D)
    csigma = np.eye(D) * sigma ** 2

    for _ in range(budget):
        z = np.random.normal(size=D)
        x = clip(cmu + csigma @ z)

        fx = func(x)
        yield x, -fx

        cmu += (1 / lambda_) * mu * (x - cmu)
        csigma += (1 / lambda_) * nu * ((np.outer(x - cmu, x - cmu) - csigma))

    return clip(cmu)
