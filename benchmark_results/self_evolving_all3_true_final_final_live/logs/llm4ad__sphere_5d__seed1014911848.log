def algorithm(func, dim, lb, ub, budget, rng):
    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for i in range(1, budget+1):
        for j in range(dim):
            x_candidate = x_best.copy()
            x_candidate[j] += rng.normal(scale=0.01, loc=0)
            if np.any(np.logical_or(x_candidate < lb, x_candidate > ub)):
                x_candidate[rng.choice(dim)] = rng.uniform(lb, ub)

        f_candidate = func(x_candidate)
        if f_candidate <= f_best:
            x_best = x_candidate
            f_best = f_candidate

    return x_best
