def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(pop_size, dim, lb, ub):
        return rng.uniform(lb, ub, (pop_size, dim))

    def differential_evolution(population, func, dim, lb, ub, budget):
        mutation_rate = 0.9
        crossover_rate = 0.5
        while budget > 0:
            population_new = np.copy(population)
            for i in range(len(population)):
                mutated_individual = np.copy(population[np.random.choice(range(len(population)), replace=False)])
                for j in range(dim):
                    if rng.random() < mutation_rate:
                        mutated_individual[j] += (ub - lb) * rng.uniform(-1, 1)
                mutated_individual = clip(mutated_individual, lb, ub)
                trial_individual = crossover(population[i], mutated_individual, crossover_rate)
                trial_individual = func(trial_individual)
                if trial_individual < population_new[i]:
                    population_new[i] = trial_individual
            population = population_new
            budget -= 1
        return population

    def simplex_search(population, func, dim, lb, ub):
        def centroid(individuals):
            return np.mean(individuals, axis=0)

        def reflection(centroid, individual, lb, ub):
            reflection_point = centroid + 2 * (individual - centroid)
            reflection_point = clip(reflection_point, lb, ub)
            return reflection_point

        def contraction(reflection_point, centroid, individual, lb, ub):
            contraction_point = centroid + (ub - lb) / 3 * (reflection_point - centroid)
            contraction_point = clip(contraction_point, lb, ub)
            return contraction_point

        population_new = np.copy(population)
        for i in range(len(population)):
            individuals = np.delete(population, i, axis=0)
            centroid_individual = centroid(individuals)
            reflection_point = reflection(centroid_individual, population[i], lb, ub)
            trial_individual = func(reflection_point)
            if trial_individual < population[i]:
                population_new[i] = trial_individual
        return population_new

    def crossover(population1, population2, crossover_rate):
        new_population = np.copy(population1)
        for i in range(len(new_population)):
            for j in range(dim):
                if rng.random() < crossover_rate:
                    new_population[i, j] = population2[j]
        return new_population

    def clip(individual, lb, ub):
        return np.clip(individual, a_min=lb, a_max=ub)

    pop_size = 100
    population = generate_initial_population(pop_size, dim, lb, ub)
    for _ in range(10):
        population = differential_evolution(population, func, dim, lb, ub, budget // 10)
        population = simplex_search(population, func, dim, lb, ub)

    best_individual = np.min(population, axis=0)
    return best_individual
