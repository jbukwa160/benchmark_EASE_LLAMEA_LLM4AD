        fs = [func(x) for x in population]
        
        # Clip candidates to [lb, ub]
        for i in range(num_population):
            population[i] = np.clip(population[i], lb, ub)
            fs[i] = func(population[i])
            
        # Sort and select the top 5 candidates
        sorted_idx = np.argsort(fs)[:num_population//2]
        population = [population[i] for i in sorted_idx]
        fs = [fs[i] for i in sorted_idx]
        
