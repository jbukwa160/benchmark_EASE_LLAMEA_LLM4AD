def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        for i in range(dim):
            learning_rate = 0.1 / (i + 1) * rng.uniform(0.5, 1.5)
            new_x = np.copy(x)
            new_x[i] += learning_rate * (func(new_x[:i]) - func(new_x[:i-1])) * (x[i] - x[i-1]**2)**2
            new_x = np.clip(new_x, lb, ub)
            if func(new_x) < best_f:
                best_x = new_x
                best_f = func(new_x)

        x = np.copy(best_x)

    return best_x
