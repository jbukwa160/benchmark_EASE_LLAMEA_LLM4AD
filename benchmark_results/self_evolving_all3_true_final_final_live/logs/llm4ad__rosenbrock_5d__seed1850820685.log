        return np.log(x)
    
    def inv_log(x):
        return np.exp(x)
    
    def sigmoid(x):
        return expit(x)
    
    def adapt_cov(cov, stepsize):
        cov = (cov + stepsize * np.outer(np.random.randn(dim), np.random.randn(dim))) / 2
        cov = (cov + cov.T) / 2  # Symmetrize
        cov[range(dim), range(dim)] += 1e-6  # Regularization
        return cov
    
    def sample_gaussian(cov, mean):
        z = np.random.randn(dim)
        return mean + np.sqrt(np.diag(cov)).dot(z) / np.linalg.norm(z)
    
    x0 = (ub - lb) * rng.rand(dim) + lb
    cov = 1e-4 * np.eye(dim)
