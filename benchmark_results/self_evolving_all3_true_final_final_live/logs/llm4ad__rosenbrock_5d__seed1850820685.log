def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x)

    x_best = np.random.uniform(lb, ub, size=(1, dim))
    y_best = evaluate(clip(x_best))

    for _ in range(budget):
        distribution = rng.normal(loc=x_best, scale=1e-2, size=(1000, dim))
        for i in range(distribution.shape[0]):
            distribution[i] = clip(distribution[i])
        
        scores = np.array([evaluate(clip(candidate)) for candidate in distribution])

        x_new = np.mean(distribution[scores.argmin()], axis=0)
        x_best = (1 - 0.01) * x_best + 0.01 * x_new
        y_best = evaluate(clip(x_best))

    return x_best
