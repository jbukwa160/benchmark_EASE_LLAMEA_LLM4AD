def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = 10 ** (-6)
    T0 = 1e9
    cooling_rate = 0.99
    T = T0
    best_x = rng.uniform(lb, ub, size=dim)
    best_fval = func(best_x)
    
    for _ in range(budget):
        x = clip(rng.normal(loc=best_x, scale=D, size=dim))
        
        if rng.random() < np.exp(-(func(x) - best_fval) / T):
            best_x = x
            best_fval = func(x)
        
        T *= cooling_rate
        
    return best_x
