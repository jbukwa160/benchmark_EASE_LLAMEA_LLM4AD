def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    D = dim
    pop_size = int(budget / (D + 2))
    max_gen = budget // pop_size

    for _ in range(max_gen):
        population = np.random.uniform(lb, ub, (pop_size, D))
        for i in range(pop_size):
            population[i] = clip(population[i], lb, ub)

        F = 0.5 + 0.3 * rng.random()
        CR = 0.1 + 0.4 * rng.random()

        while True:
            offspring_population = np.copy(population)
            for i in range(pop_size):
                idx1, idx2, idx3 = rng.sample(range(pop_size), 3)
                trial = population[idx1] + F * (population[idx2] - population[idx3])
                trial = clip(trial, lb, ub)

                if (rng.random() < CR or
                    np.linalg.norm(trial - population[idx1]) > np.linalg.norm(population[idx1] - offspring_population[i])):
                    offspring_population[i] = trial

            fvals_offspring = func(offspring_population)
            fvals_population = func(population)

            if np.any(fvals_offspring < fvals_population):
                population = np.copy(offspring_population)
            else:
                break

        best_idx = np.argmin(func(population))
        if func(clip(population[best_idx], lb, ub)) < func(clip(population[rng.randint(0, pop_size - 1)], lb, ub)):
            population[rng.randint(0, pop_size - 1)] = clip(population[best_idx], lb, ub)

    return clip(population[np.argmin(func(population))], lb, ub)
