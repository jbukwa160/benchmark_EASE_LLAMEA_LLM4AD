def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    N = 20
    alpha = 1.5
    eta = 0.3
    max_iter = budget // (pop_size * N)
    archive = []

    def clip(x):
        return np.clip(x, lb, ub)

    def differential_evolution_step(pop, best):
        while True:
            candidates = pop + alpha * rng.uniform(-1, 1, size=(pop_size, dim))[:, None]
            candidates += eta * (candidates - pop)
            clipped_candidates = clip(candidates)
            fitnesses = [func(clipped_candidates[i]) for i in range(pop_size)]
            if np.argmin(fitnesses) != np.argmax([f(x=best) for x in clipped_candidates]):
                break
        return clipped_candidates[np.argmin(fitnesses)]

    def genetic_algorithm_step(pop):
        offspring = pop + rng.uniform(-1, 1, size=(pop_size, dim))
        clipped_offspring = clip(offspring)
        fitnesses = [func(clipped_offspring[i]) for i in range(pop_size)]
        best_idx = np.argmin(fitnesses)
        archive.append(pop[best_idx])
        return clipped_offspring[np.argmin(fitnesses)]

    pop = rng.uniform(lb, ub, size=(pop_size, dim))
    for _ in range(max_iter):
        for _ in range(N):
            pop = differential_evolution_step(pop, np.min(archive, key=lambda x: func(x)))
        pop = genetic_algorithm_step(pop)
    return np.min(archive, key=func)
