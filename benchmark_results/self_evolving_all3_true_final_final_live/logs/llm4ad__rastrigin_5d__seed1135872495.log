def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    x = rng.uniform(low=lb, high=ub, size=(dim,))
    x_best = x.copy()
    f_best = func(x)
    
    cma = [1] * dim
    sigma = 0.5
    
    k = 0
    while k < budget:
        z = np.dot(np.diag(cma), rng.normal(size=(dim,)))
        trial = clip(x + sigma * z)
        
        f_trial = func(trial)
        
        if f_trial < f_best:
            x_best = trial.copy()
            f_best = f_trial
            cma = [x / f_best for x in cma]
            sigma *= 0.5
        
        k += 1
    
    return x_best
