def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.zeros(dim)
    best_x = x.copy()
    best_f = func(x)
    
    T = 1.0
    a = 0.9
    
    for _ in range(budget):
        for i in range(dim):
            new_x = clip(x + rng.uniform(-1, 1) * (ub - lb))
            new_f = func(new_x)

            if new_f < best_f:
                best_f = new_f
                best_x = new_x.copy()
                
            delta = new_f - best_f
            if delta > 0 or np.random.rand() < np.exp(-delta / T):
                x = new_x
                
        T *= a

    return best_x
