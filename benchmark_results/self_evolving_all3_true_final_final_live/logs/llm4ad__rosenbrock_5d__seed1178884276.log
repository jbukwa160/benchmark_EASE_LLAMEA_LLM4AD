def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.array([1.0] * dim)
    best_x = np.copy(x)
    best_f = func(x)

    sigma_init = 0.5
    sigma = sigma_init

    t = 0
    while t < budget:
        if rng.random() < 0.01:
            x_prime = x + rng.normal(0, sigma, dim)
            x_prime = clip(x_prime)
            f_prime = func(x_prime)

            if f_prime < best_f:
                best_x = np.copy(x_prime)
                best_f = f_prime

        else:
            x_prime = x + rng.normal(0, sigma, dim)
            x_prime = clip(x_prime)

            alpha = 1.1
            beta = 2
            while True:
                if func(x_prime) < func(x):
                    x = np.copy(x_prime)
                    t += 1
                    break
                elif rng.random() > np.exp((func(x_prime) - func(x)) / (alpha * sigma**2)):
                    break
                else:
                    sigma *= beta

        t += 1

    return best_x
