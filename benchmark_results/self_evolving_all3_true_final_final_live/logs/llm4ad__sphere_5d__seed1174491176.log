def algorithm(func, dim, lb, ub, budget, rng):
    n = len(rng)
    x_best = -np.inf * np.ones(dim)
    best_f = np.inf
    T = 1000  # Initial temperature
    alpha = 0.99  # Cooling rate

    for _ in range(budget):
        x_rand = lb + (ub - lb) * rng[:dim]
        f_rand = func(x_rand)

        if f_rand < best_f:
            best_f = f_rand
            x_best = x_rand

        delta = best_f - f_rand
        T_new = max(T * alpha, 1e-6)
        p_accept = np.exp(-delta / T_new)

        if rng[dim] < p_accept or delta == 0:
            x_rand = x_best + (ub - lb) * (rng[:dim] - 0.5)
            x_rand = np.clip(x_rand, lb, ub)
            f_rand = func(x_rand)

            if f_rand < best_f:
                best_f = f_rand
                x_best = x_rand

        T *= alpha

    return x_best
