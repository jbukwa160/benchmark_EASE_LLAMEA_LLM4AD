def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    n = len(rng)
    current_solution = rng * (ub - lb) + lb
    best_solution = current_solution.copy()
    temperature = 1.0

    for _ in range(budget):
        new_solution = current_solution.copy()
        for i in range(n):
            if rng[i] < 0.5:
                new_solution[i] += np.random.uniform(-temperature, temperature) * (ub - lb)
            else:
                new_solution[i] -= np.random.uniform(0, temperature) * (ub - lb)
        new_solution = clip(new_solution)

        delta = func(new_solution) - func(current_solution)
        if delta < 0 or rng < np.exp(-delta / temperature):
            current_solution = new_solution
            best_solution = new_solution.copy()
            temperature *= 0.99

    return best_solution
