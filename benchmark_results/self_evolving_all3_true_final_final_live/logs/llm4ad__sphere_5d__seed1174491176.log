def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, (dim,))
    t = 1.0
    step_size = 2.0 * (ub - lb) / np.sqrt(dim)
    while budget > 0:
        y = x + np.random.uniform(-step_size, step_size, (dim,))
        for i in range(dim):
            if y[i] < lb:
                y[i] = lb
            elif y[i] > ub:
                y[i] = ub
        f_x = func(x)
        f_y = func(y)
        
        if f_y <= f_x:
            x = y
        else:
            delta = f_x - f_y
            probability = np.exp(-delta / (t * rng.uniform(0, 1)))
            if rng.random() < probability:
                x = y
        
        t *= 0.99
        budget -= 1
    
    return x
