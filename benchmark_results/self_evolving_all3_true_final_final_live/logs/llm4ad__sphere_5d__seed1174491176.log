def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    n_iter = 0
    while n_iter < budget:
        x = np.random.uniform(lb, ub, size=dim)
        f = func(x)

        if f < best_f:
            best_x = x
            best_f = f

        # Local refinement
        for i in range(dim):
            step_size = 0.1 * (ub - lb) / rng.rand()
            new_x = best_x.copy()
            new_x[i] += step_size
            new_x = np.clip(new_x, lb, ub)
            f_new = func(new_x)

            if f_new < best_f:
                best_x = new_x
                best_f = f_new

        n_iter += 1

    return best_x
