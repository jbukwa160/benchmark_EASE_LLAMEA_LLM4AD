def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    num_restarts = 0
    iterations_without_progress = 0
    
    while True:
        x = rng.uniform(lb, ub, size=dim)
        f = func(x)
        
        if f < best_f:
            best_x = x
            best_f = f
            iterations_without_progress = 0
            
        num_restarts += 1
        
        if num_restarts > budget // dim or iterations_without_progress >= int(0.9 * budget):
            break
        
        iterations_without_progress += 1
    
    return best_x
