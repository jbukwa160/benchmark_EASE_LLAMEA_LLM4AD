def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 1000
    pop = rng.uniform(lb, ub, (pop_size, dim))
    
    for _ in range(budget):
        scores = func(pop)
        best_idx = np.argmin(scores)
        best_candidate = pop[best_idx]
        
        new_pop = np.copy(pop)
        for i in range(1, pop_size):
            idx1, idx2 = rng.randint(i), rng.randint(dim)
            child = new_pop[i].copy()
            child[idx1] += 0.01 * (pop[best_idx, idx1] - new_pop[i, idx1])
            child[idx2] += 0.01 * (pop[best_idx, idx2] - new_pop[i, idx2])
            child = np.clip(child, lb, ub)
            new_pop[i] = child
            
        pop = new_pop
        
    return best_candidate
