def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        f = func(x)
        
        if f < best_f:
            best_f = f
            best_x = x
            
        # early stopping criterion based on improvement in objective function values
        if (best_f - f) / np.abs(best_f + 1e-8) < 0.01:
            break
    
    return best_x
