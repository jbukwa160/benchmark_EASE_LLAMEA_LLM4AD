def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    def evaluate(x):
        x = clip(x)
        return func(x)

    population_size = 10
    pop = rng.uniform(lb, ub, (population_size, dim))

    best = None
    for _ in range(budget):
        new_pop = np.zeros((population_size, dim))
        for i in range(population_size):
            r1 = rng.randint(0, population_size)
            r2 = rng.randint(0, population_size)
            while r2 == r1:
                r2 = rng.randint(0, population_size)

            u = 0.5 * (pop[r1] + pop[r2]) - pop[i]
            new_pop[i] = pop[i] + 0.7 * u
        for i in range(population_size):
            if evaluate(new_pop[i]) < evaluate(pop[i]):
                pop[i] = new_pop[i]

        best_candidate = np.argmin([evaluate(x) for x in pop])
        if best is None or evaluate(pop[best_candidate]) < evaluate(best):
            best = pop[best_candidate]

    return best
