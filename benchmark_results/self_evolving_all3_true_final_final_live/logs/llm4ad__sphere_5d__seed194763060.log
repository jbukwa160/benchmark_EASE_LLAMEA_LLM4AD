def algorithm(func, dim, lb, ub, budget, rng):
    best_x = rng.uniform(lb, ub, size=dim)
    best_f = func(best_x)

    T = 1e6
    alpha = 0.99
    for _ in range(budget):
        x_new = rng.uniform(lb, ub, size=dim)
        f_new = func(x_new)

        delta = f_new - best_f
        if delta < 0:
            best_x = x_new
            best_f = f_new

        elif rng.rand() < np.exp(-delta / T):
            best_x = x_new
            best_f = f_new

        T *= alpha

    return best_x
