def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, a_min=lb, a_max=ub)

    def fitness(x):
        return func(x)

    pop_size = 10
    sigma = 5.0
    lambda_ = int(budget / (dim * pop_size))
    mu = 1

    x_best = clip(rng.uniform(lb, ub, size=(pop_size, dim)))
    for _ in range(lambda_):
        y = np.clip(x_best + rng.normal(size=x_best.shape) * sigma, a_min=lb, a_max=ub)
        f_values = [fitness(y[i]) for i in range(pop_size)]
        idx = np.argsort(f_values)[:mu]
        x_new = clip(np.array([y[i] for i in idx]))
        sigma *= 1 + 0.01 * (np.mean(f_values) - func(x_best))
        x_best = x_new
    return x_best[np.argmin(f_values)]
