def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(x)

    best_x = rng.uniform(lb, ub, size=dim)
    best_f = f(best_x)

    T = 1.0
    alpha = 0.99
    t = 0

    while t < budget:
        for _ in range(10000):
            x_new = np.clip(rng.normal(loc=best_x, scale=0.01) if rng.uniform() > 0.5 else best_x + rng.uniform(lb, ub - best_x),
                            lb, ub)
            f_new = f(x_new)

            if f_new < best_f:
                best_x = x_new
                best_f = f_new

            elif np.exp(-(f_new - best_f) / T) > rng.uniform():
                best_x = x_new
                best_f = f_new

        T *= alpha
        t += 1

    return best_x
