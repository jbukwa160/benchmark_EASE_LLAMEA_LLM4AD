def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    N = 1000
    lambda_ = int(np.sqrt(dim))
    mu = lambda_ / 2

    f_history = [best_f]
    x_history = [x]

    for i in range(budget):
        x_new = np.zeros((N, dim))

        for j in range(N):
            sigma = 1.0
            if len(f_history) >= 10 and np.std(f_history[-10:]) < 1e-3:
                sigma *= 0.5

            noise = rng.normal(size=dim)
            x_new[j] = clip(x + (sigma * (mu ** 2)) * np.dot(np.linalg.inv(np.cov(np.vstack((noise, x)), rowvar=False)), noise))

        f_new = func(clip(x_new))
        idx = np.argsort(f_new)

        for j in range(N):
            if f_new[j] < best_f:
                x = x_new[idx[j]].copy()
                best_x = x.copy()
                best_f = f_new[j]
                f_history.append(best_f)
                x_history.append(x)

    return best_x
