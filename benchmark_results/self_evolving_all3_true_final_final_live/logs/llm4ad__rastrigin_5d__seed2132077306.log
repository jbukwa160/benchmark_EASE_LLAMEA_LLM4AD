def algorithm(func, dim, lb, ub, budget, rng):
    def get_init_x(dim, lb, ub, rng):
        return lb + rng.uniform(0, 1, size=dim) * (ub - lb)

    init_x = get_init_x(dim, lb, ub, rng)
    best_x = init_x.copy()
    best_fx = func(init_x)

    alpha = 0.9
    sigma = 5.0

    for _ in range(budget):
        x_candidate = np.clip(best_x + rng.normal(0, sigma, size=dim), lb, ub)
        fx_candidate = func(x_candidate)
        
        if fx_candidate < best_fx:
            best_x = x_candidate.copy()
            best_fx = fx_candidate
        
        elif rng.uniform(0, 1) > np.exp((best_fx - fx_candidate) / alpha):
            best_x = x_candidate.copy()
            best_fx = fx_candidate

    return best_x
