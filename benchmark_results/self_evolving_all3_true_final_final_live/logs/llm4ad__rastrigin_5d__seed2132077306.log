def algorithm(func, dim, lb, ub, budget, rng):
    best_x = None
    best_f = float('inf')
    cma_step_size = 1e-3
    n_restart = 5
    restart_budget = int(budget / n_restart)
    iteration = 0
    
    for _ in range(n_restart):
        x = np.zeros(dim) + (ub - lb) * rng.uniform(size=dim)
        
        cma_sigma = cma_step_size
        cma_mu = np.zeros(dim)
        cma_cov = np.eye(dim) * cma_sigma ** 2
        
        while iteration < restart_budget:
            x_try = np.random.multivariate_normal(cma_mu, cma_cov, size=1)[0]
            x_try = (x_try - lb) / (ub - lb) * (ub - lb) + lb
            f_try = func(x_try)
            
            if f_try < best_f:
                best_x = x_try
                best_f = f_try
                
            iteration += 1
            
            # update step size and distribution
            delta = x_try - x
            cma_mu += (cma_sigma ** 2) * np.dot(cma_cov, delta)
            cma_cov += (1 + 2 * cma_step_size) * np.outer(delta, delta) - (cma_step_size ** 2) * cma_cov
            
        x = best_x
        iteration = 0
        
    return best_x
