def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_params = 2 * D + 1
    sigma = 10.0
    lambda_ = int(budget / (n_params * 4))
    mu = np.zeros(D)
    cov = np.eye(D) * sigma**2
    x_best = None

    for i in range(budget):
        x = rng.randn(D) + mu
        x = np.clip(x, lb, ub)

        fitness = func(x)
        if x_best is None or fitness < func(x_best):
            x_best = x.copy()

        y = func(x + 0.1 * cov.dot(rng.randn(D)))
        z = func(x - 0.1 * cov.dot(rng.randn(D)))

        if y < fitness and y < func(x_best):
            x = x + 0.1 * cov.dot(rng.randn(D))
            x = np.clip(x, lb, ub)
        elif z < fitness and z < func(x_best):
            x = x - 0.1 * cov.dot(rng.randn(D))
            x = np.clip(x, lb, ub)

        r = rng.uniform(-1, 1, D)
        a = (y - fitness) / (y - z)
        c = 1 + 2 * a**2
        s = sigma / np.sqrt(c)

        mu = mu + s * cov.dot(r) * (y - fitness)

        if i > budget // 10:
            cov_inv = np.linalg.inv(cov)
            for d in range(D):
                s_d = s * np.sqrt(np.diag(cov)[d])
                c_d = cov_inv[d, d]
                r_d = rng.uniform(-1, 1)
                mu[d] += s_d * (c_d - 1) * r_d
                cov[d, d] *= (1 + (c_d - 1)**2 * r_d**2)

    return x_best
