def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Random Search step
        new_x = rng.uniform(lb, ub, size=dim)
        new_f = func(new_x)

        if new_f < best_f:
            best_x = new_x.copy()
            best_f = new_f

        # Gradient Descent step
        g = np.zeros(dim)
        for i in range(dim):
            dx = 1e-4 * rng.choice([-1, 1])
            x_new = (x + dx * np.eye(dim)[i]) % (ub - lb) + lb
            g[i] = (func(x_new) - func(x)) / dx

        # Gradient Descent update
        step_size = 0.01
        x -= step_size * g

        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)

    return best_x
