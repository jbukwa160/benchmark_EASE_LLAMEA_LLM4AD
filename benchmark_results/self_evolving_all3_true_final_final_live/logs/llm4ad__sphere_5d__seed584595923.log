def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        new_x = rng.uniform(lb, ub, size=dim)
        new_f = func(new_x)

        if new_f < best_f:
            best_f = new_f
            best_x = new_x

        alpha = 0.1 # learning rate
        x = x + alpha * (new_x - x) / np.linalg.norm(new_x - x)
        x = np.clip(x, lb, ub)

    return best_x
