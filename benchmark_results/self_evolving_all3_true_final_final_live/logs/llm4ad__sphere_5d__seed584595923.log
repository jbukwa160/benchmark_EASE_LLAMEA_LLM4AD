def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = rng.normal(size=dim)
    best = func(clip(x))
    pop_size = 10 * dim + 5
    sigma = 0.1

    for _ in range(budget):
        y = rng.normal(size=(pop_size, dim), loc=x, scale=sigma)
        y = clip(y)
        f_y = np.array([func(clip(y_i)) for y_i in y])
        idx = np.argsort(f_y)[:dim]
        x = np.mean(y[idx], axis=0)

    return x
