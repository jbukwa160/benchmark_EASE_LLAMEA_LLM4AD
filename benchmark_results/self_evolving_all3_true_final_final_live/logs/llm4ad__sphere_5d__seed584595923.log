def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, (1, dim))
    best_x = x.copy()
    best_f = func(x)
    step_size = 1.0
    accepted = True
    
    for _ in range(budget):
        if not accepted:
            # reject current candidate and decrease step size
            step_size *= 0.9
        
        new_x = x + rng.uniform(-step_size, step_size, (1, dim))
        
        # clip to bounds
        new_x = np.clip(new_x, lb, ub)
        
        f_new = func(new_x)
        
        if f_new < best_f:
            accepted = True
            best_f = f_new
            best_x = new_x.copy()
            
            # increase step size if accepted
            step_size *= 1.1
            
        else:
            accepted = rng.rand() < np.exp((best_f - f_new) / step_size)
    
    return best_x[0]
