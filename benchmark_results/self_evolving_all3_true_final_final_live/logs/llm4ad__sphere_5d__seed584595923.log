def algorithm(func, dim, lb, ub, budget, rng):
    n = len(rng)
    x_best = np.array([0.] * dim)
    f_best = float('inf')
    
    for i in range(budget):
        x_cand = x_best + 2 * (rng[i % n] - 0.5) * (ub - lb)
        f_cand = func(x_cand)
        
        if f_cand < f_best:
            f_best = f_cand
            x_best = x_cand
            
    return np.clip(x_best, a_min=lb, a_max=ub)
