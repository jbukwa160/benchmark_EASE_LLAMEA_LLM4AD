def algorithm(func, dim, lb, ub, budget, rng):
    T = 1000.0  # initial temperature
    alpha = 0.99  # cooling rate
    x = np.zeros(dim)
    f_x = func(x)

    for _ in range(budget):
        i = rng.randint(0, dim)
        s = np.copy(x)
        s[i] += rng.uniform(-1, 1)
        s = np.clip(s, lb, ub)
        f_s = func(s)

        if f_s < f_x:
            x = s
            f_x = f_s

        elif rng.rand() < np.exp((f_x - f_s) / T):
            x = s
            f_x = f_s

        T *= alpha

    return x
