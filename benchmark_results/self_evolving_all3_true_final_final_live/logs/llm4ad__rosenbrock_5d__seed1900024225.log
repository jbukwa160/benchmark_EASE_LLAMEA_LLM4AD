def algorithm(func, dim, lb, ub, budget, rng):
    def f(x):
        return func(np.array(x))
    
    x = rng.uniform(lb, ub, size=dim)
    T = 10.
    alpha = 0.99
    
    for _ in range(budget):
        new_x = np.copy(x) + rng.normal(size=dim)
        
        # Clip candidates to [lb, ub]
        new_x = np.clip(new_x, lb, ub)
        
        delta_f = f(new_x) - f(x)
        
        if delta_f < 0 or (rng.rand() < np.exp(-delta_f / T)):
            x = new_x
            T *= alpha
            
    return x
