def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x), x

    pop_size = 10 * dim + 5
    sigma = 0.1
    lambda_ = int(pop_size / 2)
    mu = pop_size - lambda_
    c = 1 / (4 + np.sqrt(2 * mu))
    weights = np.array([c if i < mu else 1 for i in range(pop_size)])

    x = rng.uniform(lb, ub, size=dim)

    best_x = evaluate(x)[1]
    best_f = evaluate(x)[0]

    for _ in range(budget):
        y = np.zeros((lambda_, dim))
        for i in range(lambda_):
            n = rng.normal(size=dim)
            trial_x = clip(best_x + sigma * n)
            trial_f, trial_x = evaluate(trial_x)
            if trial_f < best_f:
                best_f = trial_f
                best_x = trial_x

            y[i] = np.array(trial_x)

        D = y - best_x
        C = (D @ D.T) / lambda_
        s = np.dot(C, rng.normal(size=dim)) + np.eye(dim)
        x = best_x + sigma * np.dot(s, weights)

    return best_x
