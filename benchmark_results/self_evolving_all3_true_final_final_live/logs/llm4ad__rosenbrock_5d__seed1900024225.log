def algorithm(func, dim, lb, ub, budget, rng):
    n = 10 * dim
    D = rng.uniform(lb, ub, (n + 1, dim))
    x_best = D[0]
    y_best = func(D[0])
    
    for i in range(1, n + 1):
        gp = GaussianProcessRegressor(kernel=1.0 * RBF(length_scale=1.0), random_state=rng)
        gp.fit(D[:i], func(D[:i]))
        
        x_next = D[i-1] + np.dot(np.linalg.inv(np.dot(gp.kernel_.get_params()[0].diag, np.ones((dim, dim))) + np.eye(dim)), 
                               (gp.mean_(D[i-1]) - y_best))
        x_next = x_next.clip(lb, ub)
        
        D[i] = x_next
        y_next = func(x_next)
        
        if y_next < y_best:
            x_best = x_next
            y_best = y_next
            
    return x_best
