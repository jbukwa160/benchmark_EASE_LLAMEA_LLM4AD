def algorithm(func, dim, lb, ub, budget, rng):
    def rosenbrock(x):
        return func(x)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_val = rosenbrock(x)

    cma_params = {
        'mu': 10,
        'sigma': 0.1,
        'step_size': 0.01,
        'max_iter_without_improvement': 5
    }
    cma_sigma = cma_params['sigma']

    for i in range(budget):
        x_new, cma_sigma = cma_step(x, rosenbrock, dim, cma_params, cma_sigma)
        if rosenbrock(x_new) < best_val:
            best_x = x_new
            best_val = rosenbrock(x_new)

        # SA part: perturb the current solution with probability 0.01
        if rng.uniform(0, 1) < 0.01:
            x_perturbed = x.copy() + rng.normal(0, cma_sigma, size=dim)
            x_perturbed = np.clip(x_perturbed, lb, ub)

            val_perturbed = rosenbrock(x_perturbed)

            if val_perturbed < best_val:
                best_x = x_perturbed
                best_val = val_perturbed

    return best_x
