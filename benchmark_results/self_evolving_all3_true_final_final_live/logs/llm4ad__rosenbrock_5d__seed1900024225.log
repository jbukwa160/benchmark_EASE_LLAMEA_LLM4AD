def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidates(x_best, sigma):
        x = np.clip(x_best + sigma * rng.randn(dim), lb, ub)
        return x

    def update_sigma(sigma, t, c1, c2, progress):
        return max(c1 * sigma, min(c2 * sigma, (progress / (t + 1)) ** 0.5))

    def func_wrapper(x):
        return np.sum(func(x))

    x_best = rng.uniform(lb, ub, size=dim)
    sigma = 1
    t = 0
    progress = float('inf')

    while t < budget:
        candidates = get_candidates(x_best, sigma)
        f_values = func_wrapper(candidates)
        idxs = np.argsort(f_values)[:2]

        if f_values[idxs[0]] > f_values[idxs[1]]:
            x_best = candidates[idxs[1]]
            progress = max(progress, f_values[idxs[1]])
        else:
            progress = max(progress, f_values[idxs[0]])

        sigma = update_sigma(sigma, t, 1.5, 2.4, progress)
        t += 1

    return x_best
