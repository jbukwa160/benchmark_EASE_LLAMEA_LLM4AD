def algorithm(func, dim, lb, ub, budget, rng):
    def get_candidates(population_size, mean, std_dev):
        return mean + std_dev * rng.randn(population_size, dim)

    def mutate(candidate, mutation_rate):
        mask = (rng.rand(dim) < mutation_rate)
        candidate[mask] += rng.uniform(-1, 1, size=np.sum(mask))
        return np.clip(candidate, lb, ub)

    def select_best(population, budget):
        scores = [func(x) for x in population]
        indices = np.argsort(scores)[:budget]
        return population[indices], scores[indices]

    best_candidate = get_candidates(1, 0.0, 1.0)
    best_score = func(best_candidate)

    for _ in range(budget - 1):
        candidates = get_candidates(100, 0.0, 1.0)
        candidates = np.clip(candidates, lb, ub)
        mutated_candidates = [mutate(x, 0.01) for x in candidates]
        population, scores = select_best(mutated_candidates, budget)

        if func(population[0]) < best_score:
            best_candidate = population[0]
            best_score = scores[0]

    return best_candidate
