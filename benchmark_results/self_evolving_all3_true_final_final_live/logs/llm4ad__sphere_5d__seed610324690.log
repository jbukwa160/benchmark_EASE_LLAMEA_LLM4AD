def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    current_best = func(x)
    
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)
    
    for _ in range(budget):
        new_x = rng.uniform(lb, ub, size=(dim,))
        if func(clip(new_x)) < current_best:
            x = clip(new_x)
            current_best = func(x)
        
        alpha = 0.99
        T = 10000
        t = _ / budget * T
        new_T = alpha ** t * T
        
        if rng.uniform(0, 1) < np.exp((current_best - func(clip(new_x))) / new_T):
            x = clip(new_x)
            current_best = func(x)
    
    return x
