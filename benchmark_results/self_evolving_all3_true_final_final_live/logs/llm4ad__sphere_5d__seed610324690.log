def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    for _ in range(budget):
        dx = (ub - lb) * (rng.rand(dim) - 0.5)
        candidate = x + dx
        clipped_candidate = np.clip(candidate, lb, ub)
        f_val = func(clipped_candidate)
        if f_val < func(x):
            x = clipped_candidate
    return x
