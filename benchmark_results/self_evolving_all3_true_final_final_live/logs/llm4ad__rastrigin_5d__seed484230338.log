def algorithm(func, dim, lb, ub, budget, rng):
    D = dim
    n_workers = 1000 // D
    mu = int(np.sqrt(n_workers * D))
    sigma_init = (ub - lb) / np.sqrt(D)
    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    for i in range(budget):
        x_new = x_best.copy()
        for j in range(mu):
            z_j = rng.randn(dim)
            sigma = 0.5 * (sigma_init + np.exp(rng.uniform(-3, 3)))
            x_new[j] += sigma * z_j
            x_new[j] = np.clip(x_new[j], lb, ub)

        f_new = func(x_new)
        if f_new < f_best:
            x_best = x_new.copy()
            f_best = f_new

    return x_best
