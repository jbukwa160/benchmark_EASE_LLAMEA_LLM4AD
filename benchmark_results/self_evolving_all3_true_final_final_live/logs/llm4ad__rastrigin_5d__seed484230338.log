def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = lb + (ub - lb) * rng.rand(dim)
    f_best = func(x_best)

    for i in range(budget):
        z = clip(x_best + 0.1 * rng.randn(dim))
        u = clip(x_best + 0.5 * rng.randn(dim) + 0.5 * rng.standard_cauchy(dim))
        x_candidate = (z + u + x_best) / 3

        f_candidate = func(clip(x_candidate))
        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate

    return x_best
