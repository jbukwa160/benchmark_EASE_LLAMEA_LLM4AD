def algorithm(func, dim, lb, ub, budget, rng):
    def get_initial_solution(dim, rng):
        return rng.uniform(lb, ub, size=dim)

    def get_cma_solution(solution, budget):
        cma_sigma = 1.0 / (10 ** -6 + budget)
        for _ in range(budget):
            solution += np.dot(np.eye(dim), rng.normal(size=(dim, dim))) * cma_sigma
        return solution

    def get_de_solution(solution, solution2, lb, ub):
        v = rng.uniform(-1.0, 1.0, size=dim)
        candidate = solution + v * (solution - solution2) / np.linalg.norm(solution - solution2)
        return np.clip(candidate, lb, ub)

    def get_best_solution(candidate, best_solution, func):
        if func(candidate) < func(best_solution):
            return candidate
        else:
            return best_solution

    initial_solution = get_initial_solution(dim, rng)
    cma_solution = get_cma_solution(initial_solution, budget // 2)
    de_solution1 = get_de_solution(cma_solution, initial_solution, lb, ub)
    de_solution2 = get_de_solution(de_solution1, cma_solution, lb, ub)

    best_solution = get_best_solution(de_solution1, get_best_solution(de_solution2, initial_solution, func), func)
    return best_solution
