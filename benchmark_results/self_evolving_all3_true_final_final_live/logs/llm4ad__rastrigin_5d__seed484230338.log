def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.minimum(np.maximum(x, lb), ub)

    x_best = np.zeros(dim)
    f_best = float('inf')

    for i in range(budget):
        x_candidate = np.array([rng.uniform(lb, ub) for _ in range(dim)])
        x_candidate = clip(x_candidate)
        
        f_candidate = func(x_candidate)
        
        if f_candidate < f_best:
            f_best = f_candidate
            x_best = x_candidate

        # adaptive restarts
        if i % (budget // 10) == 0 and budget // 10 > 1:
            y = rng.uniform(lb, ub, size=(dim,))
            y = clip(y)
            
            while func(y) < f_best:
                y = rng.uniform(lb, ub, size=(dim,))
                y = clip(y)

    return x_best
