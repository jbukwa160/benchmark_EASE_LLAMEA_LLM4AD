def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 10.0
    lambda_ = int(budget / (dim * 2))
    mu = lambda_ // 2
    x_mean = np.zeros(dim)
    x_best = np.zeros(dim)
    f_best = np.inf

    for _ in range(lambda_):
        # Initialize population
        x = rng.uniform(lb, ub, size=(lambda_, dim))

        for i in range(budget):
            # Evaluate function values
            f = func(x)

            # Update best solution
            idx = np.argmin(f)
            if f[idx] < f_best:
                f_best = f[idx]
                x_best = x[idx]

            # CMA-ES update
            delta = x - x_mean
            cov = np.cov(delta, rowvar=False)

            # Update mean and step size
            x_mean += (delta[idx] / sigma**2) * (f_best - func(x_mean))
            sigma *= 0.99

            # Clip candidates to [lb, ub]
            x = np.clip(x, lb, ub)
        else:
            # Restart CMA-ES if convergence criterion is met
            x_mean = np.zeros(dim)
            sigma = 10.0
            x = rng.uniform(lb, ub, size=(lambda_, dim))

    return x_best
