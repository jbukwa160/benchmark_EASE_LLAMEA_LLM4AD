def algorithm(func, dim, lb, ub, budget, rng):
    def clipped(x):
        return np.clip(x, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(clipped(x_best))
    
    for i in range(1, budget+1):
        sigma = 0.5 / (np.sqrt(i) + 2)
        z = rng.normal(size=(dim,))
        x_new = clipped(x_best + sigma * z)
        
        f_new = func(clipped(x_new))
        
        if f_new < f_best:
            x_best = x_new
            f_best = f_new
    
    return x_best
