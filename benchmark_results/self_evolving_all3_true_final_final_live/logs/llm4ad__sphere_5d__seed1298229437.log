def algorithm(func, dim, lb, ub, budget, rng):
    init = (ub - lb) * rng.rand(dim) + lb
    best = init.copy()
    
    for _ in range(budget):
        candidate = best.copy()
        idx = rng.choice(dim)
        candidate[idx] += (ub - lb) * (2 * rng.rand() - 1)
        candidate = np.clip(candidate, lb, ub)
        
        if func(candidate) < func(best):
            best = candidate
    
    return best
