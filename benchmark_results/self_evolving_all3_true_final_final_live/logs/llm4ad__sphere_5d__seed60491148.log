def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def objective(x):
        x = clip(x)
        return func(x)

    bounds = [(lb[i], ub[i]) for i in range(dim)]

    pop_size = int(budget ** 0.5)
    max_iter = budget // pop_size
    best_x = np.zeros(dim)
    best_f = float('inf')

    for _ in range(max_iter):
        if rng.random() < 0.1:  # restart DE with probability 10%
            de_best_x, de_best_f = de_search(func, dim, bounds, pop_size, max_iter, budget // (max_iter + 1))
            best_x = np.copy(de_best_x)
            best_f = min(best_f, de_best_f)

        else:  # use CMA-ES
            cma_best_x, cma_best_f = cma_search(func, dim, bounds, pop_size, max_iter, budget // (max_iter + 1))
            if cma_best_f < best_f:
                best_x = np.copy(cma_best_x)
                best_f = min(best_f, cma_best_f)

    return best_x
