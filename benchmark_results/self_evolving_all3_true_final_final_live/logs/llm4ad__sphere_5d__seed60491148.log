def algorithm(func, dim, lb, ub, budget, rng):
    def sample(bounds):
        return [rng.uniform(lb[i], ub[i]) for i in range(dim)]

    x_best = None
    f_best = float('inf')

    gp_model = {'X': [], 'y': []}

    for _ in range(budget):
        x_new = sample([(lb[i], ub[i]) for i in range(dim)])

        if x_new not in gp_model['X']:
            y_new = func(x_new)

            gp_model['X'].append(np.array(x_new))
            gp_model['y'].append(y_new)
        else:
            y_new = gp_model['y'][gp_model['X'].index(x_new)]

        # Acq function: mean + std * (1 - 2*rand) * exp(-beta * (func - mean)^2)
        x_mean, x_std, func_mean, func_std = gp_model
        beta = 10.0

        def acq_func(x):
            return func_mean(np.array(x)) + np.exp(-beta * ((func(np.array(x)) - func_mean(np.array(x)))**2))

        # Acquisition function maximization using random search
        x_acq_best = None
        f_acq_best = float('-inf')
        for _ in range(100):
            x_try = sample([(lb[i], ub[i]) for i in range(dim)])
            f_try = acq_func(x_try)
            if f_try > f_acq_best:
                f_acq_best = f_try
                x_acq_best = x_try

        # Update best solution
        if y_new < f_best or (y_new == f_best and func(np.array(x_new)) != func(np.array(x_best))):
            f_best = y_new
            x_best = x_new

    return np.array(x_best)
