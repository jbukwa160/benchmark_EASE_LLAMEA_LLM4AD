def algorithm(func, dim, lb, ub, budget, rng):
    def generate_candidate(current_x):
        return rng.uniform(lb, ub, size=dim)

    def accept_new_solution(new_x, current_x, T):
        delta = func(new_x) - func(current_x)
        if delta < 0 or rng.rand() < np.exp(-delta / T):
            return new_x
        else:
            return current_x

    x = generate_candidate(np.zeros(dim))
    T = 1.0  # initial temperature

    for i in range(budget):
        new_x = accept_new_solution(generate_candidate(x), x, T)
        if func(new_x) < func(x):
            x = new_x
            if rng.rand() < 0.5:  # reduce temperature with probability 1/2
                T *= 0.99  # exponential cooling schedule

    return x
