def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(clip(x_best))

    step_size = 5.0
    for _ in range(budget - 1):
        x_candidate = clip(rng.normal(loc=x_best, scale=step_size, size=dim))
        f_candidate = func(x_candidate)

        if f_candidate < f_best:
            x_best = x_candidate
            f_best = f_candidate

        # Adaptively adjust the step size
        step_size *= 0.9 if f_candidate > f_best else 1.1

    return x_best
