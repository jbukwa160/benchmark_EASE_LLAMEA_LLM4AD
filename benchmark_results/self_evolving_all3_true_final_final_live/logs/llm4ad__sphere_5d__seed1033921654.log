def algorithm(func, dim, lb, ub, budget, rng):
    sigma = 5.0
    T = 100.0
    x_best = -np.ones(dim)
    f_best = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        
        if np.any(x < lb) or np.any(x > ub):
            continue
        
        f = func(x)
        
        if f < f_best:
            f_best = f
            x_best = x.copy()
        
        alpha = 0.99
        sigma *= alpha
        T *= alpha
        
        y = rng.normal(loc=x, scale=sigma, size=dim)
        
        if np.any(y < lb) or np.any(y > ub):
            continue
        
        fy = func(y)
        
        if np.random.rand() < np.exp((f - fy) / T):
            x = y.copy()
    
    return x_best
