def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(pop_size, dim):
        return rng.uniform(lb, ub, size=(pop_size, dim))

    def evaluate_candidates(candidates, func, lb, ub):
        scores = np.zeros((candidates.shape[0]))
        for i in range(len(scores)):
            candidate = candidates[i]
            score = 0
            for j in range(dim):
                score += (candidate[j] - 10 * np.cos(2 * np.pi * candidate[j])) ** 2 - 10
            scores[i] = score + 10 * dim
        return scores

    def differential_evolution(candidates, func, lb, ub, f, cr):
        n_candidates, _ = candidates.shape
        selected_indices = rng.choice(n_candidates, size=n_candidates, replace=False)
        selected_candidates = candidates[selected_indices]
        offspring = np.zeros((n_candidates, dim))
        for i in range(n_candidates):
            donor_index = (i + 1) % n_candidates
            if rng.random() < cr:
                donor = selected_candidates[donor_index]
                for j in range(dim):
                    u = rng.uniform(0, 1)
                    if u <= cr or rng.random() < f:
                        offspring[i][j] = donor[j] + u * (candidates[i][j] - donor[j])
            else:
                offspring[i] = selected_candidates[donor_index]
        return evaluate_candidates(offspring, func, lb, ub)

    def random_search(candidates, func, lb, ub):
        scores = evaluate_candidates(candidates, func, lb, ub)
        best_candidate_idx = np.argmax(scores)
        best_candidate_score = scores[best_candidate_idx]
        for _ in range(budget // 10):
            new_candidate = rng.uniform(lb, ub, size=(1, dim))
            new_candidate_score = evaluate_candidates(new_candidate, func, lb, ub)[0]
            if new_candidate_score < best_candidate_score:
                best_candidate_idx = np.argmax([new_candidate_score, best_candidate_score])
                best_candidate_score = [new_candidate_score, best_candidate_score][best_candidate_idx]
        return candidates[best_candidate_idx]

    pop_size = 100
    n_generations = budget // (pop_size * dim)

    initial_population = generate_initial_population(pop_size, dim)
    scores = evaluate_candidates(initial_population, func, lb, ub)
    best_candidate_idx = np.argmax(scores)
    best_candidate_score = scores[best_candidate_idx]

    for generation in range(n_generations):
        candidates_scores = differential_evolution(initial_population, func, lb, ub, 0.5, 0.9)

        best_differential_offspring_idx = np.argmin(candidates_scores)
        best_differential_offspring_score = candidates_scores[best_differential_offspring_idx]

        if best_differential_offspring_score < best_candidate_score:
            initial_population = np.zeros((pop_size, dim))
            for i in range(pop_size):
                initial_population[i] = rng.uniform(lb, ub, size=(1, dim))

        scores = evaluate_candidates(initial_population, func, lb, ub)
        best_candidate_idx = np.argmin(scores)
        best_candidate_score = scores[best_candidate_idx]

    return initial_population[best_candidate_idx]
