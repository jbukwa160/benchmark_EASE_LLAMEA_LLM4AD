def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def f(x):
        return func(x)

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = f(clip(x_best))

    def de_step(pop_size, mutation_factor, crossover_rate):
        population = rng.uniform(lb, ub, size=(pop_size, dim))
        for _ in range(budget):
            x_new = np.copy(clip(population[np.random.randint(pop_size)] + 
                                 mutation_factor * (population[np.random.randint(pop_size)] - population[np.random.randint(pop_size)]) + 
                                 crossover_rate * (x_best - population[np.random.randint(pop_size)])))
            if f(x_new) < f_best:
                x_best = x_new
                f_best = f(clip(x_new))
        return clip(x_best)

    def sa_step(temperature, cooling_rate):
        x_new = np.copy(rng.uniform(lb, ub, size=dim))
        for _ in range(budget):
            if rng.random() < np.exp((f(clip(x_new)) - f_best) / temperature):
                x_best = clip(x_new)
                f_best = f(clip(x_best))
            temperature *= cooling_rate
        return clip(x_best)

    pop_size = int(np.ceil(dim ** 0.5)) + 1
    mutation_factor = 2 * (ub - lb) / np.sqrt(dim)
    crossover_rate = 1 / dim

    for _ in range(budget):
        if rng.random() < 0.7: # exploration phase
            x_best = de_step(pop_size, mutation_factor, crossover_rate)
        else: # exploitation phase
            temperature = 10 * (ub - lb) ** 2
            cooling_rate = 0.99
            x_best = sa_step(temperature, cooling_rate)

    return clip(x_best)
