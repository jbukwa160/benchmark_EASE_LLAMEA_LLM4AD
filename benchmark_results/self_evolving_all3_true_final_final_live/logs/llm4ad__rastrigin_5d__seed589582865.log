def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(size):
        return rng.uniform(lb, ub, size=(size, dim))

    def differential_mutation(candidates, best_candidate, alpha=1.0, gamma=1.0):
        n = candidates.shape[0]
        new_candidates = np.zeros((n, dim))
        for i in range(n):
            r1 = rng.choice(n, p=np.ones(n)/n)
            r2 = rng.choice(n, p=np.ones(n)/n)
            while r1 == i or r1 == r2:
                r1 = rng.choice(n, p=np.ones(n)/n)
            r3 = rng.choice(n, p=np.ones(n)/n)
            while r3 == i or r3 == r1 or r3 == r2:
                r3 = rng.choice(n, p=np.ones(n)/n)
            new_candidates[i] = candidates[r1] + alpha * (candidates[r2] - candidates[r3]) + gamma * (best_candidate - candidates[r1])
        return clip(new_candidates)

    def crossover(parent1, parent2):
        u = rng.uniform(0, 1)
        child = u * parent1 + (1 - u) * parent2
        return clip(child)

    population_size = 50
    n_generations = budget // population_size

    candidates = generate_initial_population(population_size)
    best_candidate = np.inf
    for _ in range(n_generations):
        new_candidates = differential_mutation(candidates, np.min(np.sum((candidates - best_candidate)**2, axis=1)))
        new_candidates = crossover(new_candidates[0], best_candidate)[:, None]
        candidates = np.vstack([new_candidates, *candidates])
        fitness_values = func(candidates)
        idx = np.argmin(fitness_values)
        if fitness_values[idx] < best_candidate:
            best_candidate = candidates[idx]

    return best_candidate
