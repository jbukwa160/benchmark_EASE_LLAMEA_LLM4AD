def algorithm(func, dim, lb, ub, budget, rng):
    def get_initial_guess(rng):
        return rng.uniform(lb, ub, size=dim)

    def get_neighbour(x, rng):
        noise = rng.uniform(-0.5, 0.5, size=dim)
        return np.clip(x + noise, lb, ub)

    def evaluate(candidate):
        return func(candidate)

    initial_guess = get_initial_guess(rng)
    current_solution = initial_guess
    best_solution = initial_guess

    temperature = budget * (ub - lb) / dim
    cooling_rate = 0.99

    for _ in range(budget):
        neighbour = get_neighbour(current_solution, rng)
        new_fitness = evaluate(neighbour)

        if new_fitness < evaluate(current_solution):
            current_solution = neighbour
            if new_fitness < evaluate(best_solution):
                best_solution = neighbour
        else:
            probability = np.exp((evaluate(current_solution) - new_fitness) / temperature)
            if rng.rand() < probability:
                current_solution = neighbour

        temperature *= cooling_rate

    return best_solution
