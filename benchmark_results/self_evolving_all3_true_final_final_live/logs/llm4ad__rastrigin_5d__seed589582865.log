def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        x = clip(x)
        return func(x), x

    pop_size = 50
    best_x = rng.uniform(lb, ub, size=dim)
    best_f = float('inf')
    temp = 1.0

    for _ in range(budget):
        offspring = np.zeros((pop_size, dim))
        for i in range(pop_size):
            mu = rng.choice(pop_size, size=4, replace=False)
            v = 0.5 * (rng.uniform(-1, 1, size=dim) + best_x[mu])
            offspring[i] = clip(v)

        for x in offspring:
            f, _ = evaluate(x)
            if f < best_f:
                best_f = f
                best_x = x

        temp *= 0.99
        for i in range(pop_size):
            mu = rng.choice(pop_size, size=4, replace=False)
            v = 0.5 * (rng.uniform(-1, 1, size=dim) + best_x[mu])
            f, _ = evaluate(v)
            if np.random.rand() < np.exp((f - best_f) / temp):
                offspring[i] = v

        best_x = clip(best_x)

    return best_x
