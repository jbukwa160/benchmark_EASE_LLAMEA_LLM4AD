def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = np.zeros(dim)
    best_val = np.inf
    
    for _ in range(budget):
        sol = best_sol + (ub - lb) * rng.rand(dim)
        
        # Clip candidates to [lb, ub]
        sol = np.clip(sol, lb, ub)
        
        val = func(sol)
        
        if val < best_val:
            best_val = val
            best_sol = sol
            
    return best_sol
