def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    best = np.zeros(dim)
    for _ in range(budget):
        x = rng.normal(size=dim)
        x = clip(x)
        f_x = func(x)
        
        if f_x < func(best):
            best = x

        # Local search refinement
        for i in range(dim):
            step_size = 0.1 * (ub - lb)
            new_x = best.copy()
            new_x[i] += rng.uniform(-step_size, step_size)
            new_x = clip(new_x)
            f_new_x = func(new_x)

            if f_new_x < f_x:
                x = new_x
                f_x = f_new_x

    return best
