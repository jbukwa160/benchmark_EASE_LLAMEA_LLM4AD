def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget - 1):
        s = rng.rand(dim)
        c = rng.choice([-1, 1])
        delta = clip(c * (ub - lb) * s)
        x_new = x_best + delta
        f_new = func(clip(x_new))
        
        if f_new < f_best:
            x_best = x_new
            f_best = f_new

    return x_best
