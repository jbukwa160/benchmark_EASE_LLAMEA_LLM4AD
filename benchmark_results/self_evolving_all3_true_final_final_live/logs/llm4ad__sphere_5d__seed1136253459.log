def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = rng.uniform(lb, ub, (1, dim))
    f_x_best = func(clip(x_best))

    for i in range(budget):
        sigma = 1.0
        x = np.zeros((1, dim))
        for j in range(dim):
            c = rng.normal(loc=0, scale=sigma)
            x[0, j] = x_best[0, j] + c

        f_x = func(clip(x))
        if f_x < f_x_best:
            f_x_best = f_x
            x_best = x.copy()

        sigma *= 0.99 ** (1 - i / budget)
    return clip(x_best)
