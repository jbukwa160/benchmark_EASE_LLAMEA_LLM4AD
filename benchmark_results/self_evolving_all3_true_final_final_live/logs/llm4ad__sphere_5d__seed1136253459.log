def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        cand_dim = [np.random.choice([0, 1]) for _ in range(dim)]
        cand_x = best_x + (ub - lb) * np.multiply(cand_dim, rng.uniform(-1, 1, size=dim))
        cand_x = np.clip(cand_x, lb, ub)

        cand_f = func(cand_x)
        
        if cand_f < best_f:
            best_f = cand_f
            best_x = cand_x

    return best_x
