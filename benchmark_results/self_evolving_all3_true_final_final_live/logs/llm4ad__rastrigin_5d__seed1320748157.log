def algorithm(func, dim, lb, ub, budget, rng):
    def eval_candidate(x):
        x = np.clip(x, lb, ub)
        return func(x)

    res_de = differential_evolution(eval_candidate, [(lb, ub)]*dim, maxiter=int(budget))
    candidate_best = res_de.x
    best_fitness = func(candidate_best)

    n_search_points = 1000
    for _ in range(int(budget)):
        if rng.rand() < 0.1:
            # Neighborhood Search
            noise_stddev = 0.5 * (ub - lb) / np.sqrt(dim)
            candidate_neighbor = candidate_best + rng.normal(size=dim, scale=noise_stddev)
            candidate_neighbor = np.clip(candidate_neighbor, lb, ub)

            fitness_neighbor = func(candidate_neighbor)
            if fitness_neighbor < best_fitness:
                candidate_best = candidate_neighbor
                best_fitness = fitness_neighbor

        else:
            # CMA-ES
            candidate_new = res_de.x + rng.normal(size=dim) * (ub - lb) / np.sqrt(dim)
            candidate_new = np.clip(candidate_new, lb, ub)

            fitness_new = func(candidate_new)
            if fitness_new < best_fitness:
                candidate_best = candidate_new
                best_fitness = fitness_new

    return candidate_best
