def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        new_x = x + 0.5 * (ub - lb) * np.random.normal(size=dim)
        new_x = np.clip(new_x, lb, ub)

        new_f = func(new_x)

        if new_f < best_f:
            best_f = new_f
            best_x = new_x

        # Global search
        r = rng.rand(dim)
        for i in range(dim):
            new_x_i = best_x[i] + 0.5 * (ub - lb) * np.sign(r[i]) * np.exp(-10)
            new_x_i = np.clip(new_x_i, lb, ub)
            new_f = func(np.array(best_x[:i], dtype=float) + 
                         np.array([new_x_i], dtype=float) + 
                         np.array(best_x[i+1:], dtype=float))

            if new_f < best_f:
                best_f = new_f
