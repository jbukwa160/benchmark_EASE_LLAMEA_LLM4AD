def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x, lb, ub):
        return np.clip(x, lb, ub)

    def grad(x):
        g = np.zeros(dim)
        for i in range(dim):
            g[i] = 2 * x[i] - 4 * np.pi * np.sin(2 * np.pi * x[i])
        return g

    def DE(pop_size=50, F=0.5, CR=0.9):
        X = rng.uniform(lb, ub, (pop_size, dim))
        fit = [func(x) for x in X]
        best_x = X[np.argmin(fit)]
        best_fit = np.min(fit)
        for _ in range(budget // pop_size * 2):
            for i in range(pop_size):
                r1 = rng.choice(range(pop_size), p=[(fit[j] - best_fit) / (fit[i] - best_fit) if j != i else 0.9 for j in range(pop_size)])
                r2 = rng.choice(range(pop_size), p=[(fit[j] - best_fit) / (fit[i] - best_fit) if j != i else 0.9 for j in range(pop_size)])
                x_new = clip(X[r1] + F * (X[r2] - X[i]) + CR * (np.random.rand(dim) - 0.5), lb, ub)
                fit_new = func(x_new)
                if fit_new < best_fit:
                    best_x = x_new
                    best_fit = fit_new
            X = np.concatenate((clip(X, lb, ub), [best_x]), axis=0)
            fit += [func(x) for x in X[pop_size:]]
        return clip(best_x, lb, ub)

    def local_descent(eps=1e-5):
        x = DE()
        while True:
            g = grad(x)
            if np.linalg.norm(g) < eps:
                break
            alpha = 0.1
            step = -alpha * g
            new_x = clip(x + step, lb, ub)
            if func(new_x) < func(x):
                x = new_x
        return x

    return local_descent()
