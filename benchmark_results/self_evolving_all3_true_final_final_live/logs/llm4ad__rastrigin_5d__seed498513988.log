def algorithm(func, dim, lb, ub, budget, rng):
    x = 0.5 * (ub - lb) + lb + (ub - lb) * rng.rand(dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Random exploration
        if rng.rand() < 0.05:
            x = 0.5 * (ub - lb) + lb + (ub - lb) * rng.rand(dim)
        else:
            # Local exploration
            delta = np.zeros(dim)
            for i in range(dim):
                step = rng.uniform(-1, 1)
                delta[i] = step if rng.rand() < 0.5 else -step
                x[i] += delta[i]
                # Clip to bounds
                x[i] = max(lb, min(ub, x[i]))

            f = func(x)

        # Update best solution
        if f < best_f:
            best_x = x.copy()
            best_f = f

    return best_x
