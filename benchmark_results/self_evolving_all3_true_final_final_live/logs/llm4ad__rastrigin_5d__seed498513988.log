def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 100
    x = rng.uniform(lb, ub, (pop_size, dim))
    
    for _ in range(budget):
        f_x = func(x)
        
        # Select best individuals and calculate their fitness
        idx = np.argsort(f_x)[:int(0.2*pop_size)]
        best_x = x[idx]
        best_f_x = f_x[idx]
        
        # Differential evolution mutation
        v = rng.uniform(lb, ub, (1, dim))
        for i in range(pop_size):
            u = v + 0.5*rng.uniform(-1, 1)*(best_x[i%20] - x[i])
            x[i] = u
        
        # Crossover operation
        for i in range(pop_size):
            r1, r2 = rng.choice(20), rng.randint(20)
            cr = rng.random()
            if cr > 0.5:
                x[i] = (1-cr)*x[r1] + cr*best_x[r2]
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
    
    idx = np.argmin(func(x))
    return x[idx]
