def algorithm(func, dim, lb, ub, budget, rng):
    def clip_candidate(candidate, lb, ub):
        return np.clip(candidate, lb, ub)

    n_pop = 50
    n_vars = dim
    n_iter = int(budget / (n_pop * n_vars))
    pop_size = n_pop

    for i in range(n_iter):
        if rng.rand() < 0.1:
            # Restart strategy: replace entire population with random individuals
            pop = np.random.uniform(lb, ub, size=(pop_size, n_vars))
        else:
            # Differential Evolution step
            pop = np.zeros((pop_size, n_vars))

            for j in range(pop_size):
                r1, r2, r3 = rng.randint(0, pop_size, 3)
                if rng.rand() < 0.5:
                    # Mutation strategy: use current solution as target
                    mutant = clip_candidate(pop[j] + rng.uniform(-1, 1) * (pop[r1] - pop[r2]) + rng.uniform(-1, 1) * (pop[r3] - pop[r2]), lb, ub)
                else:
                    # Mutation strategy: use random solution as target
                    mutant = clip_candidate(pop[j] + rng.uniform(-1, 1) * (rng.uniform(lb, ub)), lb, ub)

                # Selection step
                if func(mutant) < func(pop[j]):
                    pop[j] = mutant

        # Check budget and update best solution
        for j in range(pop_size):
            if i * n_pop + j <= budget:
                candidate = clip_candidate(pop[j], lb, ub)
                yield candidate, func(candidate)
