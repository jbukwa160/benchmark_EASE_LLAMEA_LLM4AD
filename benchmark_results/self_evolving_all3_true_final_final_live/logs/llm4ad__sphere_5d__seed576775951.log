def algorithm(func, dim, lb, ub, budget, rng):
    sol = rng.uniform(lb, ub, size=dim)
    best_sol = sol.copy()
    best_val = func(sol)

    for _ in range(budget):
        perturb = rng.uniform(-5.0, 5.0, size=dim)
        cand = sol + perturb
        cand = np.clip(cand, lb, ub)  # Clip candidate to bounds

        cand_val = func(cand)
        if cand_val < best_val:
            best_sol = cand.copy()
            best_val = cand_val

    return best_sol
