def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x_best = -np.inf * np.ones(dim)
    x_curr = clip(rng.uniform(lb, ub, size=dim))
    sigma = 0.5

    for _ in range(budget):
        y = func(x_curr)
        
        if y < x_best[0]:
            x_best = y * np.ones(dim)
            x_best[:dim] = x_curr
            
        if (y - x_best[0]) > 1e-6:
            sigma = 0.5 * sigma
            x_curr += rng.normal(size=dim) * sigma
            
        else:
            sigma *= 1.01

    return clip(x_best[:dim])
