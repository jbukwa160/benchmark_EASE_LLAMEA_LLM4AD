def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    mean = rng.uniform(size=dim)
    sigma = 1.0
    sigma_decay = 0.99
    lambda_ = 10
    pop_size = lambda_

    for i in range(budget):
        variation = np.random.randn(dim) * sigma
        candidates = clip(mean + variation)

        fitness = func(candidates)
        best_candidate = candidates[np.argmin(fitness)]
        mean = (mean * (1 - 1 / (i + 1)) + best_candidate) / (1 + 1 / (i + 1))

        if i > 0:
            sigma *= sigma_decay

    return clip(mean)
