def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def mutation(x):
        sigma = 0.5
        z = rng.randn(dim)
        x_mutated = x + sigma * z
        return clip(x_mutated)

    def selection(x):
        return func(x)

    pop_size = min(budget // dim, 100)
    mu = np.zeros(dim)
    cov = np.eye(dim) / (pop_size ** 2)
    best_x = np.zeros(dim)
    best_f = float('inf')

    for _ in range(pop_size):
        x = mutation(mu)
        f = selection(x)
        if f < best_f:
            best_f = f
            best_x = x

    for i in range(budget - pop_size * dim):
        parents = np.random.choice(pop_size, size=pop_size, replace=False)
        children = []
        for p in parents:
            z = rng.randn(dim)
            x_child = mu + (cov @ z)
            children.append(clip(x_child))
        children = np.array(children)

        f_children = func(children)
        idx = np.argsort(f_children)[: pop_size]
        selected_children = children[idx]

        sigma_new = 0.5 * (
                sum(np.linalg.norm(z) ** 2 for p, z in zip(parents, selected_children - mu)) / (pop_size - 1)
            ) ** 0.5
        cov_new = np.eye(dim) + sigma_new ** 2 / (pop_size ** 2) * np.outer((selected_children - mu).sum(axis=0), (selected_children - mu).sum(axis=0))
        mu_new = mu + sigma_new * ((selected_children - mu).sum(axis=0) / pop_size)

        mu, cov, best_x, best_f = mu_new, cov_new, best_x, min(best_f, np.min(f_children))

    return best_x
