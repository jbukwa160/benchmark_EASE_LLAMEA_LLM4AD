def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def cma_es(x0, sigma, lb, ub, n_gen):
        mu = x0
        sigma *= 2 ** (1/len(n_gen))
        for _ in range(n_gen):
            for i in range(dim):
                covariances = [np.exp(-i * j / len(n_gen)) if i != j else 1 for j in range(len(n_gen))]
                cov_matrix = np.diag(covariances)
                distribution = np.random.multivariate_normal(mu, cov_matrix)
                candidate = clip(distribution + sigma * rng.normal(size=(dim)))
                f_value = func(candidate)
                if f_value < func(mu):
                    mu = candidate
        return mu

    def simulated_annealing(x0, lb, ub, T_init, T_end, budget):
        current_solution = x0
        T = T_init
        for _ in range(budget):
            candidate = rng.uniform(lb, ub, size=(dim))
            f_value_current = func(current_solution)
            f_value_candidate = func(candidate)
            if f_value_candidate < f_value_current:
                current_solution = candidate
            elif np.exp((f_value_current - f_value_candidate) / T) > rng.random():
                current_solution = candidate
            T *= 0.99
        return current_solution

    def hybrid(x0, lb, ub, budget):
        sigma = 5.0
        n_gen = int(budget * 0.8)
        cma_es_result = cma_es(clip(x0), sigma, lb, ub, range(n_gen))
        sa_result = simulated_annealing(cma_es_result, lb, ub, 1000, 10, budget - n_gen)
        return sa_result

    x0 = rng.uniform(lb, ub, size=(dim))
    best_solution = hybrid(x0, lb, ub, budget)
    return best_solution
