def algorithm(func, dim, lb, ub, budget, rng):
    best_sol = np.random.uniform(lb, ub, size=dim)
    min_val = func(best_sol)

    for _ in range(budget):
        i = int(rng.rand() * dim)
        new_sol = np.copy(best_sol)
        new_sol[i] = np.clip(np.random.uniform(lb, ub), lb, ub)
        
        val = func(new_sol)
        if val < min_val:
            best_sol = new_sol
            min_val = val

    return best_sol
