def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def rosenbrock(x):
        return func(x)

    def grad_rosenbrock(x):
        grad = np.zeros(dim)
        for i in range(dim-1):
            grad[i] += 400 * (x[i+1] - x[i]**2)**2
        for i in range(dim):
            grad[i] -= 2 * (1 - x[i])
        return grad

    def local_refine(x, step_size=0.01):
        x_new = clip(x + step_size * np.sign(grad_rosenbrock(x)))
        if rosenbrock(x_new) < rosenbrock(x):
            return x_new
        else:
            return x

    best_x = rng.uniform(lb, ub, size=dim)
    for _ in range(budget):
        candidate = clip(best_x + rng.normal(0, 1, size=dim))
        if rosenbrock(candidate) < rosenbrock(best_x):
            best_x = candidate
        else:
            best_x = local_refine(best_x)

    return best_x
