        return func(x)

    x_best = np.random.uniform(lb, ub, size=dim)
    y_best = evaluate(x_best)

    gp = GaussianProcessRegressor(kernel=RBF(length_scale=1.0), alpha=1e-4)
    X = x_best.reshape(1, -1)
    Y = y_best
    gp.fit(X, Y)

    for _ in range(budget):
        mu, sigma = gp.predict(np.random.uniform(lb, ub, size=(1000, dim)).reshape(-1, dim), return_std=True)
        idx = np.argmax(mu - 2 * sigma)
        x_new = np.random.normal(loc=np.mean([lb, ub], axis=0), scale=sigma[idx] + 1e-6, size=dim)

        # Clip new candidate to bounds
        x_new = np.clip(x_new, lb, ub)

        y_new = evaluate(x_new)
        gp.fit(np.vstack((X, x_new.reshape(1, -1))), np.vstack((Y, y_new)))

        if y_new < y_best:
            x_best = x_new
            y_best = y_new

    return x_best
