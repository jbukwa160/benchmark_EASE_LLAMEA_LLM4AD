def algorithm(func, dim, lb, ub, budget, rng):
    def gaussian_process(x_train, y_train):
        cov = np.zeros((dim, dim))
        for i in range(dim):
            for j in range(i+1, dim):
                cov[i,j] = cov[j,i] = 0.5*np.exp(-np.sum(np.square(x_train[:,i]-x_train[:,j]))/(2*sigma**2))
        return np.linalg.inv(cov)

    def log_likelihood(params):
        x_train = params[:dim]
        y_train = func(x_train)
        sigma = 1 + np.sum(np.abs(x_train-np.mean(x_train, axis=0)))
        cov = gaussian_process(x_train, y_train)
        ll = -0.5*len(y_train)*np.log(2*np.pi) - 0.5*np.log(np.linalg.det(cov)) - 0.5*y_train.T@np.linalg.solve(cov, y_train)
        return ll

    def acquisition(x):
        x_mean, x_var = gp.predict(x[np.newaxis,:], eval_MF=True)
        posterior_ll = log_likelihood(np.concatenate((x, [func(x)])))
        return x_mean[0] - 1.96*np.sqrt(x_var[0]) + (posterior_ll - 10) / budget

    x_init = np.random.uniform(lb, ub, size=(dim,))
    gp = gaussian_process(x_init, func(x_init))
    best_x = x_init.copy()
    best_f = func(best_x)

    for i in range(budget):
        x_proposal = rng.normal(loc=best_x, scale=np.ones(dim)*0.1)
        x_proposal = np.clip(x_proposal, lb, ub)
        acquisition_value = acquisition(x_proposal)
        if acquisition_value > 0:
            best_f_new = func(x_proposal)
            if best_f_new < best_f or rng.uniform(0,1) < (best_f - best_f_new) / (best_f + 1e-7):
                best_x = x_proposal
                best_f = best_f_new

    return best_x
