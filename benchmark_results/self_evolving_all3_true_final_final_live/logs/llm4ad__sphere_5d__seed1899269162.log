def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = np.copy(x)
    best_fx = float('inf')
    
    mu = 0.1
    sigma = 1.5
    
    for _ in range(budget):
        new_x = x + (rng.rand(dim) * 2 - 1) * sigma + mu
        new_x = np.clip(new_x, lb, ub)
        
        new_fx = func(new_x)
        
        if new_fx < best_fx:
            best_x = np.copy(new_x)
            best_fx = new_fx
            
        x = (x + new_x) / 2
        sigma *= 0.9
        
    return best_x
