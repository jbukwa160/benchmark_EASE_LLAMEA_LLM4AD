def algorithm(func, dim, lb, ub, budget, rng):
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    for _ in range(budget):
        for i in range(dim):
            if rng.rand() < 0.1:  # perturbation probability
                dx = rng.uniform(-1, 1)
                new_x = x.copy()
                new_x[i] += dx * (ub - lb) / np.sqrt(dim)
                new_x = np.clip(new_x, lb, ub)
                if func(new_x) < func(best_x):
                    best_x = new_x
        x = best_x.copy()  # update current solution
    return best_x
