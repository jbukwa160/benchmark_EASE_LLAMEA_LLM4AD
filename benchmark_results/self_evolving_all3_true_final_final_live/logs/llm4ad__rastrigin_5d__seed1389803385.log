def algorithm(func, dim, lb, ub, budget, rng):
    def fitness(x):
        return func(x)

    def clip(x):
        return np.clip(x, lb, ub)

    x_best = -np.ones(dim)
    f_best = 1e10

    for _ in range(budget):
        n_candidates = dim * 50
        candidates = rng.uniform(lb, ub, size=(n_candidates, dim))
        f_values = [fitness(clip(c)) for c in candidates]
        x_candidate = candidates[np.argmin(f_values)]

        if fitness(clip(x_candidate)) < f_best:
            f_best = fitness(clip(x_candidate))
            x_best = clip(x_candidate)

        # GP surrogate model
        X_gp = np.vstack([x_best, candidates])
        y_gp = np.array([f_best] + f_values)
        gp_hyperparams = 1e-3 * rng.uniform(size=6)  # lengthscale, signal variance, noise variance, nugget, output scaling, learning rate

        def kernel(x1, x2):
            d = x1 - x2
            l = np.exp(gp_hyperparams[0])
            return gp_hyperparams[1] * np.exp(-np.sum(d**2 / (2*l**2)))

        K_xx = np.zeros((dim+1, dim+1))
        for i in range(dim):
            for j in range(i+1):
                if i == j:
                    K_xx[i, j] = gp_hyperparams[3] + gp_hyperparams[1]
                else:
                    K_xx[i, j] = kernel(X_gp[i, :], X_gp[j, :])
        K_xn = np.zeros((dim+1, n_candidates))
        for i in range(dim+1):
            for j in range(n_candidates):
                if i == dim:
                    K_xn[i, j] = 0
                else:
                    K_xn[i, j] = kernel(X_gp[i, :], candidates[j, :])
        L = np.linalg.cholesky(K_xx)
        alpha = np.linalg.solve(L.T, np.linalg.solve(L, y_gp))

        # CMA-ES
        sigma = 0.5
        mu = np.zeros(dim)
        while True:
            children = rng.multivariate_normal(mu, sigma**2 * np.eye(dim), size=n_candidates)
            f_values = [fitness(clip(c)) for c in children]
            x_child = children[np.argmin(f_values)]

            if fitness(clip(x_child)) < f_best:
                f_best = fitness(clip(x_child))
                x_best = clip(x_child)

            # GP update
            y_gp_new = np.array([f_best] + f_values)
            L_new = np.linalg.cholesky(K_xx + sigma**2 * np.eye(dim+1) / (n_candidates+1))
            alpha_new = np.linalg.solve(L_new.T, np.linalg.solve(L_new, y_gp_new))

            if np.mean(np.abs(alpha_new - alpha)) < 1e-5:
                break

    return x_best
