def algorithm(func, dim, lb, ub, budget, rng):
    n = 0
    x_best = rng.uniform(lb, ub, dim)
    f_best = func(x_best)
    pop_size = 10
    sigma = 1.0
    gamma = 0.01
    lambda_ = np.ceil(pop_size * (dim + 2))
    while n < budget:
        x = rng.normal(loc=x_best, scale=sigma, size=(int(lambda_), dim))
        x[:, x > ub] = ub
        x[:, x < lb] = lb
        f = func(x)
        y = np.argmax(f)
        if f[y] < f_best:
            f_best = f[y]
            x_best = x[y]
        n += 1
        c = (f - f_best) / sigma
        m = np.mean(c, axis=0)
        d = np.diag(1 + (c * c).T @ c / (lambda_ - 1))
        A = rng.normal(loc=np.eye(dim), scale=sigma * d**0.5)
        x_best += sigma ** gamma * A[:, y] * m
        sigma *= 1 + (np.mean(d)) ** 0.2
    return x_best
