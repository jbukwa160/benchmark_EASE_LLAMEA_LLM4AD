def algorithm(func, dim, lb, ub, budget, rng):
    n = 0
    T = 10000
    Tmin = 1
    alpha = 0.99
    x = (ub - lb) * rng.rand(dim) + lb
    best_x = x.copy()
    best_f = func(x)
    
    while n < budget:
        n += 1
        
        # Simulated Annealing
        y = np.clip(x + 0.01 * (ub - lb) * rng.randn(dim), lb, ub)
        
        if func(y) < best_f or rng.rand() < np.exp((best_f - func(y)) / T):
            x = y.copy()
            best_x = x.copy()
            best_f = func(x)
            
        # Adaptive Cooling Schedule
        T *= alpha
        
    return best_x
