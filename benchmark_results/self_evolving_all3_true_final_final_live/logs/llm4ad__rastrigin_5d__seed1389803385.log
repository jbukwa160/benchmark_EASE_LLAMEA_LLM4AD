def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def random_search(pop_size=10):
        candidates = np.random.uniform(lb, ub, (pop_size, dim))
        scores = func(candidates)
        best_candidate = candidates[np.argmax(scores)]
        return best_candidate

    pop_size = 100
    sampling_rate = budget // pop_size

    best_solution = random_search(pop_size)
    for i in range(1, pop_size):
        reduced_sampling_rate = int(sampling_rate * (i / pop_size))
        new_candidates = np.array([clip(rng.uniform(lb, ub, dim)) for _ in range(reduced_sampling_rate)])
        scores = func(new_candidates)
        best_candidate = new_candidates[np.argmax(scores)]
        if func(best_candidate) < func(best_solution):
            best_solution = best_candidate
    return best_solution
