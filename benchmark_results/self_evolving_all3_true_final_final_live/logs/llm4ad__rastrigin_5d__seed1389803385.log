        return np.clip(x, lb, ub)

    pop_size = 50
    pop = np.random.uniform(lb, ub, (pop_size, dim))
    
    for _ in range(budget):
        fit = [func(clip(ind)) for ind in pop]
        
        best_idx = np.argmin(fit)
        best = clip(pop[best_idx])
        
        fit_diff = np.zeros((pop_size,))
        for i in range(pop_size):
            r1, r2, r3 = rng.choice(pop_size, 3, replace=False)
            if r1 != i and r2 != i and r3 != i:
                mutation = 0.5 * (pop[r1] + pop[r3]) - pop[r2]
                fit_diff[i] = np.sum(mutation ** 2) / pop_size
                
        prob = np.exp(-fit_diff)
        cum_prob = np.cumsum(prob)
        
        for i in range(pop_size):
            r = rng.rand()
            if r < prob[i]:
                mutation = 0.5 * (pop[r1] + pop[r3]) - pop[r2]
                pop[i] += 0.7 * mutation + 0.3 * (ub - lb) * rng.randn(dim)
    
    best_idx = np.argmin([func(clip(ind)) for ind in pop])
    return clip(pop[best_idx])
