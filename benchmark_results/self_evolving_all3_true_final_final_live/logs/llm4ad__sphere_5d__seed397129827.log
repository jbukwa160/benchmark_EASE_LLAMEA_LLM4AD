def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        if rng.random() < 0.1:
            # Random Search
            x_new = lb + (ub - lb) * np.array(rng.rand(dim))
        else:
            # Simulated Annealing
            i = rng.randint(0, dim)
            x_new = x.copy()
            delta = rng.uniform(-1, 1)
            x_new[i] += delta
            x_new = np.clip(x_new, lb, ub)

        f_new = func(x_new)
        if f_new < best_f:
            best_x = x_new.copy()
            best_f = f_new

        # Simulated Annealing acceptance criterion
        if rng.random() < np.exp((best_f - f_new) / 100):
            x = x_new.copy()

    return best_x
