def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_y = func(x)
    
    for t in range(1, budget + 1):
        sigma = rng.uniform(0.001, 0.01) / (t ** 0.5)
        
        candidate = np.clip(x + sigma * rng.normal(size=dim), lb, ub)
        y = func(candidate)
        
        if y < best_y:
            x = candidate.copy()
            best_x = x.copy()
            best_y = y
        elif rng.uniform(0) < np.exp((best_y - y) / (t ** 1.5)):
            x = candidate.copy()
    
    return best_x
