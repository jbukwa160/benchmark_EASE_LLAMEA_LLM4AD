def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def evaluate(x):
        return func(clip(x))

    def simulated_annealing(budget, dim, lb, ub, rng):
        T = 10.0
        x = rng.uniform(lb, ub, (1, dim))
        best_x = x.copy()
        for _ in range(int(budget * 0.2)):
            y = clip(x + rng.normal(size=(1, dim)))
            if evaluate(y) < evaluate(x):
                x = y
            elif np.random.rand() < np.exp((evaluate(x) - evaluate(y)) / T):
                x = y
            T *= 0.99
        return x

    def differential_evolution(budget, dim, lb, ub, rng, x0):
        mu = 1.0
        delta = 2.0 * (ub - lb)
        pop_size = int(dim ** 2)
        population = np.random.rand(pop_size, dim) * delta + lb
        for _ in range(int(budget * 0.8)):
            F = rng.uniform(0.5, 1.5)
            C = rng.uniform(0, 1)
            population = clip(population + F * (np.random.rand(pop_size, dim) - C))
            fit = evaluate(population)
            best_idx = np.argmin(fit)
            if fit[best_idx] < evaluate(x0):
                x0 = population[best_idx]
        return x0

    x0 = simulated_annealing(budget, dim, lb, ub, rng)
    return differential_evolution(budget, dim, lb, ub, rng, x0)
