def algorithm(func, dim, lb, ub, budget, rng):
    x_best = -np.inf * np.ones(dim)
    x = rng.uniform(lb, ub, size=dim)

    while budget > 0:
        f_x = func(x)
        
        if f_x < x_best.min():
            x_best = x.copy()
        
        alpha = 1 / (1 + rng.uniform(0, 1))
        x_new = x + alpha * rng.normal(size=dim) * (ub - lb)
        x_new = np.clip(x_new, lb, ub)

        if func(x_new) < f_x:
            x = x_new
        
        budget -= 1
    
    return x_best
