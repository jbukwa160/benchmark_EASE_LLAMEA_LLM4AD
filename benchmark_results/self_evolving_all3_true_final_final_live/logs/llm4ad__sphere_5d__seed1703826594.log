def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def sample(rng, n):
        return rng.uniform(lb, ub, size=(n, dim))

    def distance(pop, pop_best):
        return np.mean(np.linalg.norm(pop - pop_best, axis=1)**2)

    def mutate(pop, dist):
        mu = 0.5
        sigma = np.sqrt(1 / (dim * np.sum(dist)))
        new_pop = pop + rng.normal(loc=mu, scale=sigma, size=(pop.shape[0], dim))
        return clip(new_pop)

    population_size = int(np.ceil(budget ** (1/2)))
    mu = 0.5
    sigma = 1.0

    pop = sample(rng, population_size)
    best = np.min([func(x) for x in pop])
    iteration = 0

    while budget > 0:
        dist = distance(pop, pop[np.argmin([func(x) for x in pop])])

        if dist < 1e-6:
            break

        new_pop = mutate(pop, dist)

        pop_new_scores = [func(x) for x in new_pop]
        idxs = np.argsort(pop_new_scores)[:population_size]

        pop = new_pop[idxs]
        best = np.min([best, min(pop_new_scores)])

        budget -= 1
        iteration += 1

    return pop[np.argmin([func(x) for x in pop])]
