def algorithm(func, dim, lb, ub, budget, rng):
    x_best = np.zeros(dim)
    f_best = float('inf')
    
    for _ in range(budget):
        v = np.random.uniform(lb, ub, size=dim)
        
        # Mutation
        u = np.copy(x_best)
        for i in range(dim):
            if rng.random() < 0.5:
                u[i] += (ub - lb) * rng.uniform(-1, 1)
        
        # Crossover
        v_ = 0.7 * v + 0.3 * x_best
        
        # Selection
        f_v = func(v_)
        f_u = func(u)
        
        if f_v < f_u:
            x_best = np.copy(v_)
            f_best = min(f_best, f_v)
        elif rng.random() > 0.5:
            x_best = np.copy(u)
            f_best = min(f_best, f_u)
    
    return np.clip(x_best, lb, ub)
