def algorithm(func, dim, lb, ub, budget, rng):
    x = np.zeros(dim)
    best_x = x.copy()
    best_f = float('inf')
    
    for _ in range(budget):
        for i in range(dim):
            if rng.rand() < 0.5:
                new_lb = max(lb[i], lb[i] - 1e-6 + rng.uniform(-ub[i], ub[i]))
                x[i] = new_lb
            else:
                new_ub = min(ub[i], ub[i] + 1e-6 + rng.uniform(lb[i], ub[i]))
                x[i] = new_ub
        
        x = np.clip(x, lb, ub)
        
        f = func(x)
        if f < best_f:
            best_f = f
            best_x = x.copy()
    
    return best_x
