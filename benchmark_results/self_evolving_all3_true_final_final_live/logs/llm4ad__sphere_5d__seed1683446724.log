def algorithm(func, dim, lb, ub, budget, rng):
    best_solution = np.array([lb] * dim)
    best_value = float('inf')
    
    for _ in range(budget):
        x = rng.uniform(lb, ub, size=dim)
        value = func(x)
        
        if value < best_value:
            best_value = value
            best_solution = x
            
        step_size = 0.01
        gradient = np.zeros(dim)
        for i in range(10):  # Take a few steps of gradient descent
            grad_x = func(np.array(x) + 1e-6 * np.eye(dim)[i])
            grad_x -= func(x)
            gradient[i] = grad_x / 1e-6
            
            x += step_size * gradient
        
        x = np.clip(x, lb, ub)
        
    return best_solution
