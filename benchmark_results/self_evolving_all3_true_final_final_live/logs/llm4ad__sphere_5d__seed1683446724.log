def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population():
        return rng.uniform(lb, ub, size=(budget, dim))

    def differential_evolution(population):
        mutated_population = population + rng.uniform(-1, 1, size=population.shape)[:, None] * (population - population[rng.randint(0, population.shape[0], size=dim), :])
        return clip(mutated_population)

    def simulated_annealing(population, temperature, step_size):
        new_population = population + rng.uniform(-step_size, step_size, size=population.shape)
        energy_new = func(new_population)
        energy_old = func(population)
        probability = np.exp((energy_old - energy_new) / temperature)
        return population if rng.rand() < probability else new_population

    def optimize():
        population = generate_initial_population()
        for _ in range(budget):
            mutated_population = differential_evolution(population)
            new_population = simulated_annealing(mutated_population, 10 * (ub - lb) / np.log(_ + 2), 0.1 * (ub - lb))
            population = new_population
        return clip(population[np.argmin([func(clip(x)) for x in population])])

    return optimize()
