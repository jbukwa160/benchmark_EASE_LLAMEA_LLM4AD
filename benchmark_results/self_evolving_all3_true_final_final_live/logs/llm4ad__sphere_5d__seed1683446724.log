def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    pop_size = int(np.sqrt(budget))
    x = rng.uniform(lb, ub, (pop_size, dim))
    v = rng.uniform(-1, 1, (pop_size, dim))
    pbest = x.copy()
    gbest = np.zeros(dim)
    
    for t in range(budget):
        for i in range(pop_size):
            r1, r2, r3, r4 = rng.choice(pop_size, replace=False, size=4)
            u = v[i] + 0.5 * (pbest[r1] - x[i]) + 0.5 * (gbest - x[r2])
            u = clip(x[i] + u)
            f_u = func(u)
            if f_u < func(pbest[i]):
                pbest[i] = u
        for i in range(pop_size):
            r1, r2, r3 = rng.choice(pop_size, replace=False, size=3)
            v[i] = 0.5 * (v[i] + 0.5 * (pbest[r1] - x[i]) + 0.5 * (gbest - x[r2])) + \
                   0.5 * (pbest[r3] - x[r1])
        gbest = pbest[np.argmin(np.apply_along_axis(func, 1, pbest))]
    return clip(gbest)
