def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def fitness(x):
        x = clip(x)
        return func(x)

    mean = rng.normal(size=dim)
    sigma = 1.0
    popsize = 10 * dim
    best_x = mean.copy()
    best_fitness = float('inf')

    for _ in range(budget):
        samples = np.random.multivariate_normal(mean, linalg.toeplitz(np.exp(-np.arange(dim)))*sigma**2, size=popsize)
        fitnesses = np.array([fitness(sample) for sample in samples])
        sort_idx = np.argsort(fitnesses)
        mean = (1/popsize) * sum(samples[sort_idx[:popsize//2]])

        if best_fitness > min(fitnesses):
            best_fitness = min(fitnesses)
            best_x = samples[np.argmin(fitnesses)]

    return best_x
