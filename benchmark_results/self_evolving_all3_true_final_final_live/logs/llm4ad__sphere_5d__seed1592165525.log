def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    def generate_initial_population(size, dim):
        x = rng.uniform(low=-5, high=5, size=(size, dim))
        return x

    def de(population, f, dim, lb, ub, budget):
        for _ in range(budget):
            variation = np.zeros((population.shape[0], dim))
            for i in range(population.shape[0]):
                idx = rng.choice(population.shape[0], size=3, replace=False)
                x1, x2, x3 = population[idx]
                variation[i] = 0.5 * (x1 - x2) + 0.5 * (x3 - x1)
            population += 0.01 * variation
            population = clip(population)

    def sa(population, f, dim, lb, ub, budget):
        for _ in range(budget):
            for i in range(population.shape[0]):
                new_x = population[i] + rng.uniform(low=-1, high=1)
                new_x = clip(new_x)
                if f(new_x) < f(population[i]):
                    population[i] = new_x

    initial_population = generate_initial_population(50, dim)
    de(initial_population, func, dim, lb, ub, 1000)
    sa(initial_population, func, dim, lb, ub, 500)

    best_solution = np.argmin(func(initial_population))
    return clip(initial_population[best_solution])
