def algorithm(func, dim, lb, ub, budget, rng):
    best = None
    best_f = float('inf')
    
    for _ in range(budget):
        x = np.random.uniform(lb, ub, size=dim)
        f = func(x)
        
        if f < best_f:
            best_f = f
            best = x.copy()
            
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
        
    return best
