def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(1, dim))
    x_best = x.copy()
    f_best = func(x)

    for _ in range(budget - 1):
        y = x_best + rng.normal(0, 0.2, size=(1, dim)) * (ub - lb)
        y = np.clip(y, lb, ub)
        
        fy = func(y)
        if fy < f_best:
            f_best = fy
            x_best = y

    return x_best
