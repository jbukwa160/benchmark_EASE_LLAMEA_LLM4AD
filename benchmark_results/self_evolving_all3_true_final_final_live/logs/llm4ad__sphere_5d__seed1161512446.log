def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    D = dim
    pop_size = 10 * D
    sigma = 0.5
    lambda_ = pop_size // 2
    mu = (ub - lb) / 2

    x_best = rng.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    cov = np.eye(D) * (ub - lb)**2
    m = D * [0]

    for i in range(budget):
        z = np.random.randn(pop_size, D)
        x = clip(mu + sigma * np.sqrt(cov).dot(z.T))

        f = func(x)
        ids = np.argsort(f)[:lambda_]
        best_f = f[ids[-1]]
        best_x = x[ids[-1]]

        if best_f < f_best:
            f_best = best_f
            x_best = best_x

        z_ids = np.argsort(np.array([func(clip(mu + sigma * (np.sqrt(cov).dot(z_id.T) + m))) for z_id in z]))[:lambda_]
        z = z[z_ids]

        cov += 1 / pop_size * np.outer((x[ids[-1]] - mu), x[ids[-1]] - mu)
        m *= 0.9
        sigma *= 0.99

    return x_best
