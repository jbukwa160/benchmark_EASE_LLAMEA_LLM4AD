def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, a_min=lb, a_max=ub)

    best = None
    for _ in range(budget):
        candidate = np.array([rng.uniform(lb, ub) for _ in range(dim)])
        candidate = clip(candidate)
        
        if func(candidate) < (best is None or func(best)):
            best = candidate
            
        current = candidate.copy()
        while True:
            step_size = 0.1 * (ub - lb)
            current += np.array([rng.uniform(-step_size, step_size) for _ in range(dim)])
            current = clip(current)
            
            if func(current) < func(candidate):
                candidate = current
                
            if rng.uniform(0, 1) > 0.9:
                break
    
    return best
