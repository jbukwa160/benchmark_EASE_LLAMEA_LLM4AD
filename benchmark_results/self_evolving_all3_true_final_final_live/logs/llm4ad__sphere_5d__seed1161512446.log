def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.zeros(dim)
    T = 1e6 / rng.random()
    step_size = 0.01

    for _ in range(budget):
        delta = np.zeros_like(x) + rng.normal(0, 1, size=dim)
        new_x = clip(x + step_size * delta)

        if func(new_x) < func(x):
            x = new_x
        else:
            prob = np.exp((func(x) - func(new_x)) / T)
            if rng.random() < prob:
                x = new_x

        T *= 0.9999

    return x
