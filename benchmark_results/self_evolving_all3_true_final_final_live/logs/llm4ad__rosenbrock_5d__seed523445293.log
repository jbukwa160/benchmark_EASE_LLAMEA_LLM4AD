def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = np.array([1.0]*dim)
    best_x = x.copy()
    best_f = func(x)
    
    step = 5.0
    for _ in range(budget):
        x_perturbed = x + rng.uniform(-step, step, size=dim)
        x_perturbed = clip(x_perturbed)
        
        f_perturbed = func(x_perturbed)
        if f_perturbed < best_f:
            best_x = x_perturbed.copy()
            best_f = f_perturbed
        
        # adaptive step reduction
        if rng.uniform(0, 1) < 0.2 and best_f > 1e-6:  
            step /= 1.5
            
    return clip(best_x)
