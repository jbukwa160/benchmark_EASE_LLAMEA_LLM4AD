def algorithm(func, dim, lb, ub, budget, rng):
    bounds = [(lb[i], ub[i]) for i in range(dim)]
    x_best = np.random.uniform(lb, ub, size=dim)
    f_best = func(x_best)

    for _ in range(budget):
        # One-Half greedy search
        x_greedy = x_best.copy()
        dx = np.zeros(dim)
        for i in range(dim):
            x_prev = x_greedy.copy()
            if rng.rand() < 0.5:
                delta = np.random.uniform(-1, 1)
            else:
                delta = 0
            x_greedy[i] += delta
            f_greedy = func(x_greedy)

            # Acceptance criterion
            if rng.rand() < min(1, (f_best - f_greedy) / (func(x_prev) - f_greedy)):
                dx[i] = delta

        x_next = x_best + 0.5 * dx
        for i in range(dim):
            x_next[i] = max(lb[i], min(ub[i], x_next[i]))
        f_next = func(x_next)

        # Update best solution
        if f_next < f_best:
            x_best = x_next
            f_best = f_next

    return x_best
