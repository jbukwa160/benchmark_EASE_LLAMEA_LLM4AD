def algorithm(func, dim, lb, ub, budget, rng):
    def gp_model(x):
        mu = 0
        for i in range(dim-1):
            mu += 100 * (x[i+1] - x[i]**2)**2 + (1 - x[i])**2
        return mu

    def sample_gp(gp_mean, gp_var, rng=rng):
        sigma = np.sqrt(gp_var)
        eps = rng.normal(loc=0, scale=sigma, size=dim)
        z = gp_mean + eps
        return np.clip(z, lb, ub)

    x = (np.random.rand(dim) * (ub - lb)) + lb
    best_x = x.copy()
    best_f = func(x)

    for i in range(budget):
        new_x = sample_gp(gp_model(best_x), 1e-4)
        new_fx = func(new_x)

        if new_fx < best_f:
            best_x, best_f = new_x, new_fx

        x = np.append(x[1:], new_x).reshape(-1, dim)
        for _ in range(dim):
            gp_mean = gp_model(x[:, :dim-1])
            gp_var = 1e-4
            z = gp_mean + rng.normal(loc=0, scale=np.sqrt(gp_var), size=len(x))
            x[:, _] = np.clip(z, lb, ub)

        if i % (budget // 10) == 0:
            print(f'Iteration {i+1} - Best f: {best_f}')

    return best_x
