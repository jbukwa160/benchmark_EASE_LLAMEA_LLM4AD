def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=(1, dim))
    best_x = x.copy()
    best_f = func(x)
    
    for _ in range(budget):
        # Evolutionary step
        v = rng.normal(size=(1, dim), loc=0.0, scale=1.0)
        v /= np.linalg.norm(v, axis=1)[:, np.newaxis]
        
        # Gradient-based optimization step
        g = np.zeros((1, dim))
        for i in range(dim-1):
            g += 2*100*(x[0, i+1] - x[0, i]**2)*2*x[0, i]*(x[0, i+1] - x[0, i]**2)
            g += 2*(x[0, i] - 1)
        
        # Update parameters
        v = v - 0.5*g / np.linalg.norm(g, axis=1)[:, np.newaxis]
        x += v
        
        # Clip to bounds
        x = np.clip(x, lb, ub)
        
        # Update best solution
        f = func(x)
        if f < best_f:
            best_x = x.copy()
            best_f = f
    
    return best_x[0]
