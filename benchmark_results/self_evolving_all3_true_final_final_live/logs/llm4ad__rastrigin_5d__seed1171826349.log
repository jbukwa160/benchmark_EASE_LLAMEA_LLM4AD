def algorithm(func, dim, lb, ub, budget, rng):
    n = dim
    x = np.random.uniform(lb, ub, size=(n,))
    y = func(x)
    best_x = x.copy()
    best_y = y
    current_temperature = 1.0
    cooling_rate = constants.golden / (10 ** (dim - 3))
    
    for i in range(budget):
        candidate_x = x + np.random.normal(0, 1, size=(n,))
        candidate_x = np.clip(candidate_x, lb, ub)
        
        candidate_y = func(candidate_x)
        
        if candidate_y < y:
            x = candidate_x
            y = candidate_y
        
        delta = candidate_y - y
            
        if delta < 0 or rng.random() < np.exp(-delta / current_temperature):
            x = candidate_x
            y = candidate_y
        
        best_x = np.clip(np.copy(x), lb, ub)
        best_y = func(best_x)
        
        current_temperature *= (1.0 - cooling_rate)
    
    return best_x
