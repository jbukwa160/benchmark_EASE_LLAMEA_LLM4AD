def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def local_search(x0, bounds, budget_local):
        for _ in range(budget_local):
            x = x0 + rng.uniform(-1, 1) * (ub - lb)
            x = clip(x)
            if func(x) < func(x0):
                x0 = x
        return x0

    def differential_evolution(bounds, budget):
        pop_size = int(np.sqrt(budget))
        population = np.random.rand(pop_size, dim) * (ub - lb) + lb
        scores = np.zeros(pop_size)
        for i in range(budget // pop_size):
            for j in range(pop_size):
                a, b, c = rng.choice(pop_size, 3, replace=False)
                mutant = population[a] + rng.uniform(-1, 1) * (population[b] - population[c])
                mutant = clip(mutant)
                score = func(mutant)
                if score < scores[j]:
                    population[j] = mutant
                    scores[j] = score
        best_idx = np.argmax(scores)
        return population[best_idx]

    budget_local = int(budget * 0.1)  # allocate 10% of the budget for local search

    x_best = differential_evolution([lb, ub], budget - budget_local)
    x_best = local_search(x_best, [lb, ub], budget_local)

    return x_best
