def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(candidate):
        return func(candidate)

    def generate_initial_population(size, rng):
        return (ub - lb) * rng.uniform(0, 1, size=(size, dim)) + lb

    def differential_evolution(population, cost, rng):
        n = population.shape[0]
        m = int(n / 2)
        best_candidate = np.copy(population[np.argmin(cost)])
        
        for _ in range(m):
            idx1, idx2, idx3 = rng.choice(n, size=3, replace=False)
            difference = population[idx2] - population[idx1]
            mutation_index = rng.choice(dim)
            mutant = population[idx3] + 0.5 * difference[mutation_index] * (population[idx2] - population[idx1])
            trial = clip(mutant + population[idx2])
            cost_trial = evaluate(trial)
            
            if cost_trial < cost[idx2]:
                population[idx2] = trial
                cost[idx2] = cost_trial
                best_candidate = np.copy(population[np.argmin(cost)])
                
        return population, cost

    def simulated_annealing(best_candidate, temperature, cooling_rate):
        new_candidate = clip(np.clip(best_candidate + rng.uniform(-1, 1, size=dim), lb, ub))
        
        if evaluate(new_candidate) < evaluate(best_candidate):
            best_candidate = np.copy(new_candidate)
            
        elif rng.random() < np.exp((evaluate(best_candidate) - evaluate(new_candidate)) / temperature):
            best_candidate = np.copy(new_candidate)
            
        temperature *= cooling_rate
        
        return best_candidate

    population = generate_initial_population(budget, rng)
    cost = np.zeros(population.shape[0])
    
    for i in range(100): # Run DE 100 times
        population, cost = differential_evolution(population, cost, rng)

    best_candidate = population[np.argmin(cost)]
    temperature = 1.0
    cooling_rate = 0.99

    for _ in range(budget - 100):
        best_candidate = simulated_annealing(best_candidate, temperature, cooling_rate)
        
        if evaluate(best_candidate) < np.min(evaluate(population)):
            population[np.argmin(evaluate(population))] = np.copy(best_candidate)
            
    return population[np.argmin(cost)]
