def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    for _ in range(budget):
        # Probabilistic crossover operator
        if rng.rand() < 0.5:
            # Uniform crossover
            child = clip(0.5 * (x + rng.uniform(lb, ub, size=dim)))
        else:
            # Adaptive iterative crossover
            idx = np.random.choice(dim)
            child = clip(x.copy())
            child[idx] = 0.75 * x[idx] + 0.25 * rng.uniform(lb, ub)

        f_child = func(child)
        if f_child < best_f:
            best_x = child.copy()
            best_f = f_child

        # Update population
        x = rng.uniform(lb, ub, size=dim)

    return best_x
