def algorithm(func, dim, lb, ub, budget, rng):
    def evaluate(x):
        x = np.clip(x, lb, ub)
        return func(x)

    best_x = np.random.uniform(lb, ub, size=dim)
    best_f = evaluate(best_x)

    bm = np.random.normal(size=(1, dim))
    for _ in range(budget):
        # Sample from the RBM
        candidate = best_x + 0.5 * rng.rand(dim) * (ub - lb) + 0.5 * rng.randn(dim)
        
        # Clip to bounds
        candidate = np.clip(candidate, lb, ub)

        # Evaluate and update best if necessary
        candidate_f = evaluate(candidate)
        if candidate_f < best_f:
            best_x = candidate.copy()
            best_f = candidate_f

    return best_x
