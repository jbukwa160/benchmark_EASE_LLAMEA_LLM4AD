def algorithm(func, dim, lb, ub, budget, rng):
    def gp_model(x, y, X_train, Y_train, sigma_f=1e-3):
        from GPy.models import GPRegression
        kernel = GPy.kern.Matern32(input_dim=dim, ARD=True)
        model = GPRegression(X_train, Y_train, kernel=kernel, noise_var=sigma_f)
        model.optimize('bfgs')
        return model.predict(x)

    def simulated_annealing(model, x0, lb, ub, temperature):
        x = np.array(x0)
        current_best = func(x)
        while True:
            proposal_x = rng.normal(loc=x, scale=temperature)
            clip_proposal_x = np.clip(proposal_x, lb, ub)
            proposal_value = func(clip_proposal_x)
            if proposal_value < current_best:
                x = clip_proposal_x
                current_best = proposal_value
            elif np.random.rand() < np.exp((current_best - proposal_value) / temperature):
                x = clip_proposal_x
                current_best = proposal_value
            yield x

    def bayesian_optimization(model, func, lb, ub, budget):
        X_train = []
        Y_train = []
        X = [rng.uniform(lb, ub, dim) for _ in range(budget)]
        for x in X:
            y = func(x)
            X_train.append(x)
            Y_train.append(y)
            model = gp_model(x, y, np.array(X_train), np.array(Y_train))
            best_x, best_y = None, float('inf')
            for i in range(len(X)):
                if len(X_train) > 1:
                    x_new, _ = model.predict(np.atleast_2d(X[i]))
                else:
                    x_new = X[i]
                clip_x_new = np.clip(x_new, lb, ub)
                y_new = func(clip_x_new)
                if y_new < best_y:
                    best_x, best_y = clip_x_new, y_new
            yield best_x

    def hybrid_algorithm(lb, ub, budget):
        x0 = rng.uniform(lb, ub, dim)
        temperature = 10.0
        for _ in range(budget // 2):
            for x in simulated_annealing(gp_model(x0, func(x0), [x0], [func(x0)], sigma_f=1e-3), x0, lb, ub, temperature):
                yield x
            temperature *= 0.9
        X = [rng.uniform(lb, ub, dim) for _ in range(budget // 2)]
        for x in bayesian_optimization(gp_model(X[0], func(X[0]), np.array([X[0]]), np.array([func(X[0])])), func, lb, ub, budget // 2):
            yield x

    best_x = None
    for i, x in enumerate(hybrid_algorithm(lb, ub, budget)):
        if i == 0:
            best_x = x
        elif func(x) < func(best_x):
            best_x = x
    return np.array(best_x)
