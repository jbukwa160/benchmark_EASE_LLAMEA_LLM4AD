def algorithm(func, dim, lb, ub, budget, rng):
    def rosenbrock(x):
        return func(x)

    sigma = 0.5 * (ub - lb)
    lambda_ = int(np.ceil(4 + 3 * np.log(dim)))
    mu = dim
    nfev = 0
    x_best = lb + (ub - lb) * rng.random((1, dim))
    f_best = rosenbrock(x_best)

    for i in range(budget):
        while True:
            y = x_best + sigma * np.dot(np.eye(dim), rng.normal(size=(dim, lambda_)))
            y = np.clip(y, lb, ub)
            f_y = rosenbrock(y)
            nfev += 1
            if f_y < f_best:
                x_best = y
                f_best = f_y
            else:
                break

        sigma *= np.exp(0.5 - (nfev / (dim + 2)) * 0.01)
        lambda_ = int(np.ceil(4 + 3 * np.log(dim)))
        mu = dim

    return x_best
