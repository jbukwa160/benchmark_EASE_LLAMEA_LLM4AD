def algorithm(func, dim, lb, ub, budget, rng):
    x = rng.uniform(lb, ub, size=dim)
    best_x = x.copy()
    best_f = func(x)

    while True:
        for _ in range(budget):
            if func(best_x) == 0.0:
                return best_x

            new_x = x + np.clip(rng.normal(size=dim), -1e-6, 1e-6)
            new_x = np.clip(new_x, lb, ub)

            f_new = func(new_x)

            if f_new < best_f:
                best_x = new_x
                best_f = f_new

        x = best_x.copy()

        # restart the algorithm with a random point
        x = rng.uniform(lb, ub, size=dim)
