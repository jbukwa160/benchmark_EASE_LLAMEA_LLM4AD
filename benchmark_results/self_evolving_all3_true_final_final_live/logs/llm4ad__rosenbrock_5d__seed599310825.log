def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.array([ub] * dim)
    min_f = float('inf')
    
    for _ in range(budget):
        x = np.random.uniform(lb, ub, size=dim)
        
        for i in range(dim - 1):
            step_size = 0.01
            x[i+1] += step_size * (100 * (x[i+1] - x[i]**2))
            x[i] -= step_size * (2 * 100 * (x[i+1] - x[i]**2) * x[i] + 2)
        
        f = func(x)
        
        if f < min_f:
            min_f = f
            best_x = x
        
        # Clip candidates to [lb, ub]
        x = np.clip(x, lb, ub)
    
    return best_x
