def algorithm(func, dim, lb, ub, budget, rng):
    def clip(x):
        return np.clip(x, lb, ub)

    x = clip(rng.uniform(lb, ub, (1, dim)))
    best_x = x.copy()
    best_y = func(x)
    temperature = 10.0

    for _ in range(budget - 1):
        y = func(clip(rng.normal(x, 0.5)))

        if rng.rand() < np.exp(-(y - best_y) / temperature):
            x = clip(y + rng.normal(x, 0.2))
            if y < best_y:
                best_x = x.copy()
                best_y = y

        temperature *= 0.999

    return best_x
