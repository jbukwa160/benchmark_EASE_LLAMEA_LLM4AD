def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = 50
    num_iter = int(budget / (dim * pop_size))
    
    def init_population(rng):
        return lb + (ub - lb) * rng.rand(pop_size, dim)
    
    def evaluate(x):
        f_x = func(x)
        for i in range(dim-1):
            f_x += 100*(x[i+1] - x[i]**2)**2
        return f_x
    
    pop = init_population(rng)
    
    for _ in range(num_iter):
        for i in range(pop_size):
            r1, r2 = rng.choice(pop_size, size=2, replace=False), rng.choice(pop_size, size=2, replace=False)
            if rng.rand() < 0.5:
                c = pop[r2]
            else:
                c = pop[r1]
            
            x_new = pop[i] + rng.uniform(-1, 1) * (c - pop[i])
            x_new = np.clip(x_new, lb, ub)
            
            f_x_new = evaluate(x_new)
            f_x_pop = evaluate(pop[i])
            
            if f_x_new < f_x_pop:
                pop[i] = x_new
                
    best_x = np.argmin([evaluate(x) for x in pop])
    return np.clip(pop[best_x], lb, ub)
