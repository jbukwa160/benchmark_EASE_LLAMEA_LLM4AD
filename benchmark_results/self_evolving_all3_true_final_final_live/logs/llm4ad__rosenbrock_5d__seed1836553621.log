def algorithm(func, dim, lb, ub, budget, rng):
    n = len(rng)
    x_best = lb + (ub - lb) * rng
    best_obj = func(x_best)

    for _ in range(budget):
        i = rng.choice(n)
        x = x_best.copy()
        x[i] += rng.uniform(-0.1, 0.1)
        x = np.clip(x, lb, ub)

        obj = func(x)
        if obj < best_obj:
            best_obj = obj
            x_best = x

    return x_best
