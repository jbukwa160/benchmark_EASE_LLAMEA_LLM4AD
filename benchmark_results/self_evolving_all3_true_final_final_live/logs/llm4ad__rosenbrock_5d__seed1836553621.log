def algorithm(func, dim, lb, ub, budget, rng):
    x = np.random.uniform(lb, ub, size=(dim,))
    best_x = x.copy()
    best_y = func(x)
    step_size = 1e-4
    for _ in range(budget):
        x_new = x + step_size * (np.random.uniform(-1, 1, size=x.shape) / np.linalg.norm(rng, ord=2))
        x_new = np.clip(x_new, lb, ub)
        y_new = func(x_new)
        if y_new < best_y:
            best_x = x_new
            best_y = y_new
        step_size *= 0.99
        x = x_new.copy()
    return best_x
