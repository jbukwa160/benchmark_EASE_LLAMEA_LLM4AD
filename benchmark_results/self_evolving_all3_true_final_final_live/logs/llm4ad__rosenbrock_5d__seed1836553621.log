def algorithm(func, dim, lb, ub, budget, rng):
    def clip(candidate):
        return np.clip(candidate, lb, ub)

    def evaluate(x):
        return func(x)

    def cma_es_step(population_size, sigma, step_size, x_best):
        y = rng.normal(size=(population_size, dim))
        y *= (sigma / np.sqrt(np.sum(y ** 2, axis=1)[:, None]))
        y += x_best[None]
        new_x = clip(x_best + step_size * y)
        return evaluate(new_x)

    def sa_step(temp):
        x_new = clip(x_best + rng.uniform(-temp, temp))
        if evaluate(x_new) < evaluate(x_best):
            x_best = x_new
            return True
        else:
            p = np.exp((evaluate(x_best) - evaluate(x_new)) / (rng.uniform(0, 1) * temp))
            if rng.random() < p:
                x_best = x_new
            return False

    dim = int(dim)
    population_size = 100
    sigma = 0.5
    step_size = 0.05
    temp = 10
    n_iter = budget // (population_size * dim)

    for _ in range(n_iter):
        cma_es_step(population_size, sigma, step_size, x_best)
        sa_step(temp)

    return x_best
