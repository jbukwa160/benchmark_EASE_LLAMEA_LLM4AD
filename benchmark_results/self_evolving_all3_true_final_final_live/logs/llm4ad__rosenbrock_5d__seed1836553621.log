def algorithm(func, dim, lb, ub, budget, rng):
    n = len(lb)
    x = np.random.uniform(lb, ub, size=(1, dim))
    best_x = x.copy()
    best_f = func(x)

    def gaussian_process(x_train, y_train):
        kernel = lambda x, x_: 1 + (x - x_) ** 2
        k_xx = np.array([[kernel(xi, xj) for xi in x_train] for xj in x_train])
        sigma2 = 0.01
        K = sigma2 * np.eye(len(x_train)) + sigma2 * k_xx
        return np.linalg.solve(K, y_train)

    def predict_gp(gp, x_new):
        k_x_new_x_train = [gp[1](x_i) for x_i in x]
        mean = gp[0] + np.dot(k_x_new_x_train, gp[2])
        var = 1 - np.dot(k_x_new_x_train, k_x_new_x_train)
        return mean, var

    def probabilistic_line_search(gp, x, f):
        mean, var = predict_gp(gp, x)
        if var < 0.01:
            return True
        else:
            u = rng.uniform(0, 1)
            z = (f - mean) / np.sqrt(var + 1e-6)
            eps = np.log(2) * np.sqrt(var)
            return u * eps + z < 0

    def sample_gp(gp):
        x_new = x.copy()
        for i in range(n):
            mean, var = predict_gp(gp, x[i])
            x_new[i] += rng.normal(mean, np.sqrt(var))
        return x_new

    gp = [np.zeros(dim), lambda x: 1 + (x - x) ** 2, None]
    for _ in range(budget):
        gp = gaussian_process(x, func(x))
        x_new = sample_gp(gp)
        if probabilistic_line_search(gp, x_new, func(x_new)):
            f_new = func(x_new)
            if f_new < best_f:
                best_x = x_new.copy()
                best_f = f_new
        x = np.vstack((x, x_new))

    return best_x[0]
