def algorithm(func, dim, lb, ub, budget, rng):
    pop_size = int(np.ceil(budget / 10)) # adjust the population size based on budget
    
    x = np.random.uniform(lb, ub, (pop_size, dim))
    
    best_sol = None
    for t in range(int(budget)):
        y = np.zeros((pop_size, dim))
        for i in range(pop_size):
            r1, r2, r3 = rng.choice(pop_size, 3, replace=False)
            if rng.random() < 0.5:
                y[i] = x[r1] + rng.uniform(-1, 1) * (x[r2] - x[r3])
            else:
                y[i] = x[(r1+r2)//2]
        
        # Clip candidates to [lb, ub]
        idx = np.any(y < lb, axis=1) | np.any(y > ub, axis=1)
        if np.any(idx):
            y[idx] = np.clip(y[idx], lb, ub)
        
        # Calculate the fitness of each candidate
        f_y = func(y)
        
        # Update the population and find the best solution
        x = y.copy()
        idx_best = np.argmin(f_y)
        if best_sol is None or f_y[idx_best] < best_sol.f:
            best_sol = {'x': y[idx_best], 'f': f_y[idx_best]}
    
    return best_sol['x']
