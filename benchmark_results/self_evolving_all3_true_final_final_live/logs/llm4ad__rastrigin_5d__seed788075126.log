def algorithm(func, dim, lb, ub, budget, rng):
    def generate_initial_population(dim, bounds, rng):
        return rng.uniform(bounds[0], bounds[1], size=(dim, 10))

    def mutation(candidates, best, dim, sigma, rng):
        mutated_candidates = candidates + rng.normal(size=candidates.shape)
        mutated_candidates = np.clip(mutated_candidates, lb, ub)
        return mutated_candidates

    def crossover(parents, rng):
        children = (parents[0] + parents[1]) / 2
        return np.clip(children, lb, ub)

    def simulated_annealing(candidates, temperature, alpha, best, func):
        for _ in range(1000):  # Number of SA iterations
            i, j = rng.choice(10, size=2, replace=False)
            new_candidate = candidates[:, i]
            mutated_candidate = mutation(new_candidate.reshape(-1, 1), best, dim, temperature * alpha, rng)
            fitness = func(mutated_candidate)
            if fitness < func(best):
                return np.clip(mutated_candidate, lb, ub)
        return best

    def differential_evolution(candidates, bounds, budget, func, rng):
        for _ in range(budget // 10):  # Number of DE generations
            mutated_candidates = mutation(candidates, best, dim, 0.5, rng)
            children = crossover(mutated_candidates, rng)
            fitness = func(children)
            if fitness < func(best):
                return np.clip(children, lb, ub)
        return candidates

    def hybrid_algorithm(bounds, budget, rng):
        initial_population = generate_initial_population(dim, bounds, rng)
        best = np.min(initial_population, axis=0)

        for i in range(budget // 10):  # Number of DE generations
            mutated_candidates = mutation(best.reshape(-1, 1), best, dim, 0.5, rng)
            children = crossover(mutated_candidates, rng)
            fitness = func(children)
            if fitness < func(best):
                best = np.clip(children, lb, ub)

        temperature = 10 * (ub - lb) / dim
        alpha = 0.99
        for _ in range(100):  # Number of SA iterations
            best = simulated_annealing(initial_population[:, rng.choice(10)], temperature, alpha, best, func)
            temperature *= alpha

        return np.clip(best, lb, ub)

    return hybrid_algorithm([lb, ub], budget, rng)
