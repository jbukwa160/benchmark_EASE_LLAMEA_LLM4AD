def algorithm(func, dim, lb, ub, budget, rng):
    best_x = np.zeros(dim)
    best_f = float('inf')
    
    pop_size = 50
    F = 0.5
    
    t = 0
    while t < budget:
        x = rng.uniform(lb, ub, size=(pop_size, dim))
        
        f = func(x)
        
        idx = np.argmin(f)
        if f[idx] < best_f:
            best_x = x[idx]
            best_f = f[idx]
        
        if t > 0.1 * budget and rng.rand() < 0.2:
            pop_size *= 1.5
            F += 0.1
        
        for i in range(pop_size):
            v = np.copy(x[i])
            p = rng.choice(range(pop_size), size=3, replace=False)
            for j in range(dim):
                if rng.rand() < 0.6:
                    v[j] = x[p[0], j] + F * (x[p[1], j] - x[p[2], j])
            
            f = func(v)
            idx = np.argmin(f)
            if f[idx] < best_f and rng.rand() < 0.9:
                x[i] = v
                f[i] = f[idx]
        
        t += 1
    
    return best_x
